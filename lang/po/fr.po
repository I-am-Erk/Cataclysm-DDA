msgid "Tell me about fire station camps."
msgstr ""
"Expliquez-moi les options qui me sont disponibles dans un camp de faction "
"construit sur une caserne de pompiers."

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_FACTION_CAMP.json
msgid "Tell me about evac shelter camps."
msgstr ""
"Expliquez-moi les options qui me sont disponibles dans un camp de faction "
"construit sur un abri d'évacuation."

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_FACTION_CAMP.json
msgid "Tell me about fire lookout tower camps."
msgstr "Parlez-moi des camps de tours de guet."

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_FACTION_CAMP.json
