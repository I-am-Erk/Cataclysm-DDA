msgid_plural "Water Sprites"
msgstr[0] "lutin d'eau"
msgstr[1] "lutins d'eau"
msgstr[2] "lutins d'eau"

#. ~ Description of monster "Water Sprite"
#: data/mods/Xedra_Evolved/monsters/elementals.json
msgid ""
"A mischievous creature made entirely of water, with a vaguely humanoid "
