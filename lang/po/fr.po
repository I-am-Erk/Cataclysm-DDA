msgstr "Un bloc rectangulaire de zinc pur."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous lead ingot"
msgid_plural "enormous lead ingots"
msgstr[0] "lingot de plomb énorme"
msgstr[1] "lingots de plomb énormes"
msgstr[2] "lingots de plomb énormes"

