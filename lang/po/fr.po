#: data/json/snippets/zombie_anatomy.json
msgid ""
"<zombie_humanoid_harvest_bone_general>  "
"<zombie_humanoid_harvest_general_deeper>"
msgstr ""

#. ~ Snippet in category "<zombie_animal_bone_harvest>"
#: data/json/snippets/zombie_anatomy.json
