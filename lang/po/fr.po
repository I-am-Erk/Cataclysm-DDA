#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Hey, can you hear me?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "I think I know what I'm doing."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Don't touch me."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "What's your name?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "I thought you were my friend."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Shut up!  Don't lie to me."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "How do I bring you back?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "They're all gone…"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Why did you leave me?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Oh, there you are."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "…and just where have you been?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "You hungry?  I've got plenty of food."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "You thirsty?  I've got water."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Why would you do that?"
msgstr "Pourquoi voudriez-vous faire cela?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Please don't go."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Don't leave me alone!"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "No way man."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Do you really think so?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Is it really time for that?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Sorry, I can't hear you."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "You've told me already."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "I know!"
msgstr "Je sais!"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Where the hell am I?"
msgstr "Où suis-je donc?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Why are you following me?"
msgstr "Pourquoi est-ce que tu me suis?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "This place is dangerous, we shouldn't be here."
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "That's not true, is it?"
msgstr ""

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Are you hurt?"
msgstr "Vous êtes blessé?"

#. ~ Snippet in category "schizo_self_talk"
#: data/json/snippets/schizophrenia.json
msgid "Tell me where it hurts."
msgstr "Dites-moi où vous avez mal."

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Hey, let's go kill that %1$s!"
msgstr "Eh, allons tuer ce/cette %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Did you see that %1$s!?  Be careful."
msgstr "Vous avez-vu(e) ce/cette %1$s!? Faites attention."

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Look out!  That %1$s is dangerous!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I want to kill that %1$s!"
msgstr "J'ai envie de tuer ce/cette %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s looks like it wants to party."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I think that %1$s wants to talk to you."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s wants to be your friend!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Arrest that %1$s!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s hasn't met it's quota."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s deserves a raise!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "We should give that %1$s a stern talking to."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Maybe we can reason with that %1$s!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s must be pulling the strings…"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Let me kill that %1$s!  Please?"
msgstr "Laissez-moi tuer ce/cette %1$s! S'il vous plaît?"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I need to kill that %1$s!"
msgstr "J'ai besoin de tuer ce/cette %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "I want to watch that %1$s bleed!"
msgstr "Je veux faire saigner ce/cette %1$s!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Wait, that %1$s needs to die!"
msgstr "Attendez, ce/cette %1$s à besoin de creuver!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Go kill that %1$s!  NOW!"
msgstr "Allons tuer ce/cette %1$s! MAINTENANT!"

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "Stop!  Look at that %1$s."
msgstr "Stop! Jetez un œil à ce/cette %1$s."

#. ~ Snippet in category "schizo_weapon_talk_monster"
#: data/json/snippets/schizophrenia.json
#, no-c-format
msgid "That %1$s doesn't deserve to live!"
msgstr "Ce/Cette %1$s ne mérite pas de vivre!"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Hey, you're bleeding."
msgstr "Eh, t'es en train de saigner."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Your wound looks pretty bad."
msgstr "Cette blessure à l'air plutôt grave."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Shouldn't you put a bandage on that?"
msgstr "Vous ne devriez pas mettre un bandage là-dessus?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You look hurt, did I do that?  I'm sorry."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Please don't die!  No one else lets me kill things!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Are you supposed to be bleeding?"
msgstr "Je ne pense pas que vous êtes censé(e) saigner."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You're not going to die are you?"
msgstr "Dites-moi que vous n'êtes pas en train de mourir?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "You're bleeding you know."
msgstr "Vous êtes au courant que vous saignez?"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "That's not jelly on your coat lad, that's blood!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Take out a few more before you bleed to death!"
msgstr ""
"Traînez en quelque-uns de plus dans votre tombe avant de vous vider de sang!"

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Oh God.  Please don't die.  Not now!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "'Tis but a flesh wound."
msgstr "Ceci n'est qu'une égratignure."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Gross, you're bleeding all over me."
msgstr "Beurk, vous êtes en train de saigner partout sur moi."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "Hold fast, you can do this."
msgstr "Restez-calme, vous pouvez vous en sortir."

#. ~ Snippet in category "schizo_weapon_talk_bleeding"
#: data/json/snippets/schizophrenia.json
msgid "When's your next doctor's appointment?"
msgstr ""
"Quand est-ce que vous avez votre prochain rendez-vous chez le médecin?"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Hey, fix me up will ya?"
msgstr "Eh, vous pouvez me réparer?"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I need healing!"
msgstr "J'ai besoin d'attention médicale!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "It hurts all over…"
msgstr "J'ai mal partout…"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "You can put me back together, right?"
msgstr "Vous pouvez me remettre ensemble, non?"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I… I can't move my legs!"
msgstr "Je… J'arrive pas à bouger mes jambes!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Medic!"
msgstr "Médecin!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "You gonna let me die too?!"
msgstr "Vous allez aussi me laisser mourir?!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "No!  I can't die now!"
msgstr "Non! Je ne peut pas mourir maintenant!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "I can still fight, don't replace me!"
msgstr "Je peux encore me battre, ne me remplacez pas!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "They got me!"
msgstr "Ils m'ont eu(e)!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "You're nothing without me, NOTHING!"
msgstr "Vous n'êtes rien sans moi, RIEN!"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "*cough cough* Go on without me…"
msgstr "Continuez sans moi…"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Am I gonna die?"
msgstr "Est-ce que je vais mourir?"

#. ~ Snippet in category "schizo_weapon_talk_damaged"
#: data/json/snippets/schizophrenia.json
msgid "Is anybody here a doctor!?"
msgstr "Quelqu'un est docteur ici!?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Let me kill something already!"
msgstr "Laissez-moi tuer quelque chose!"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "I'm bored."
msgstr "Je m'ennuie."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "What's for dinner?"
msgstr "Qu'est-ce qu'on a pour le dîner?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Wow!  Everything looks so… nevermind."
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "You seriously need friends."
msgstr "Vous avez vraiment besoin de compagnie."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "So, got any hobbies?"
msgstr "Donc… Vous faites quoi de votre temps libre?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "I spy with my little eye… oh right, I don't have eyes."
msgstr ""
"J’espionne avec mon petit œil… Oh ouais j'ai oublié(e), je n'ai pas d'yeux."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Lovely weather we're having, huh?"
msgstr "Beau temps, hein?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "So what if everyone you know is dead, you've still got me, right?"
msgstr ""
"Qui s'en fiche que tout le monde que vous ayez jamais connu(e) soit morts, "
"vous avez toujours moi non?"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Best friends forever!"
msgstr "Meilleurs ami(e)s pour la vie!"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Come on!  What're we doing here?!"
msgstr ""

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "This trip was pointless."
msgstr "Ce voyage était inutile."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "You're gonna die out here."
msgstr "Vous allez mourir là-dehors."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "You're in charge?  We're screwed."
msgstr "Vous êtes responsable? On est fichu(e)s."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "Dang, you look terrible."
msgstr "Wow, vous avez l'air horrible."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "You should take a shower."
msgstr "Vous devriez prendre une douche."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "We should go home, it's not safe here."
msgstr "On devrait rentrer à la maison, cet endroit est dangereux."

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "We're in over our heads!"
msgstr "Nous sommes dépassé(e)s!"

#. ~ Snippet in category "schizo_weapon_talk_misc"
#: data/json/snippets/schizophrenia.json
msgid "There's something following us, I can feel it."
msgstr "Il y a quelque chose qui nous suit, je le sens."

#. ~ Snippet in category "schizo_weapon_talk_misc"
