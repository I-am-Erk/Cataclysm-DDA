msgstr ""

#. ~ Apply message of effect type "Fungal Empathy"
#: data/mods/BombasticPerks/perkdata/empath.json
msgid "You feel like something eats all the sickness inside you."
msgstr ""

#. ~ Name of effect type id "effect_insect"
