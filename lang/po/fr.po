#. ~ Brief name of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "Torso small hardpoint 2"
msgstr "Petit point d'accroche de torse 2"

#. ~ Description of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "This is a mounting point for power supply units and large modules."
msgstr ""

#. ~ Brief name of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "PSU compartment"
msgstr "Compartiment d'ondulateur"

#. ~ Description of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "This is a mounting point for arm armor."
msgstr ""
"Un point d'accroche pour une pièce d'armure conçue pour couvrir les bras."

#. ~ Brief name of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "Arm compartment (Plate)"
msgstr "Compartiments de bras (Blindage)"

