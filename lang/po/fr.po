#: data/mods/Xedra_Evolved/monsters/elementals.json
msgid ""
"A large granivorous rodent with a long bushy tail, often seen darting amid "
"the branches of trees.  A skittish varmint with an expression of unwavering "
"austerity, it is the mortal enemy of cat and dog alike."
msgstr ""

#. ~ Monster name
#: data/mods/Xedra_Evolved/monsters/elementals.json
msgid "vineling"
msgid_plural "vinelings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of monster "vineling"
#: data/mods/Xedra_Evolved/monsters/elementals.json
