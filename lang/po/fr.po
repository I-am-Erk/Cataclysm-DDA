msgstr ""

#. ~ Description of buff "Shii-Cho" in martial art "Knight Training"
#: data/mods/MMA/martialarts.json
msgid ""
"Further training in Shii-Cho improves your ability to combat multiple opponents.\n"
"\n"
"+1 block attempt, +1 blocking effectiveness."
msgstr ""

#. ~ Buff name of martial art "Shii-Cho"
#: data/mods/MMA/martialarts.json
msgid "Master Training"
msgstr ""

#. ~ Description of buff "Shii-Cho" in martial art "Master Training"
#: data/mods/MMA/martialarts.json
