#: data/json/items/tool/science.json
msgid "Mi-go Biotech"
msgid_plural "Mi-go Biotech"
msgstr[0] "Biotechnologie Mi-go"
msgstr[1] "Biotechnologie Mi-go"
msgstr[2] "Biotechnologie Mi-go"

#. ~ Description of "Mi-go Biotech"
#: data/json/items/tool/science.json
msgid "A piece of mi-go biotechnology."
msgstr "Un morceau de biotechnologie mi-go."

