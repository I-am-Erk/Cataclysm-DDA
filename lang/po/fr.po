#: data/mods/Magiclysm/items/vehicle/vehicle_parts.json
msgid ""
"A magically manifested combustion engine.  Despite operating entirely off of"
" mana rather than normal fuel, it otherwise functions exactly as a "
"conventional internal combustion engine."
msgstr ""

