msgid_plural "gravel"
msgstr[0] "gravier"
msgstr[1] "gravier"
msgstr[2] "gravier"

#. ~ Description of "gravel"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of gravel, smaller than pebbles but larger than sand."
msgstr ""
"Une poignée de graviers, plus petits que des cailloux mais plus gros que du "
"sable."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "shredded rubber"
msgid_plural "shredded rubber"
msgstr[0] "caoutchouc déchiqueté"
msgstr[1] "caoutchouc déchiqueté"
msgstr[2] "caoutchouc déchiqueté"

#. ~ Description of "shredded rubber"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of shredded rubber, usable as a mulch now."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "limestone"
msgid_plural "limestone"
msgstr[0] "calcaire"
msgstr[1] "calcaire"
msgstr[2] "calcaire"

#. ~ Description of "limestone"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of small chunks of limestone.  Useful for experiments at science "
"fairs, but pretty useless as ammo.  Maybe something could be crafted from "
"this stuff…"
msgstr ""
"Une poignée de morceaux de calcaire. Utile pour des expériences "
"scientifiques, mais pas pour en faire des munitions. On peut peut-être en "
"faire quelque chose..."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "quicklime"
msgid_plural "quicklime"
msgstr[0] "chaux vive"
msgstr[1] "chaux vive"
msgstr[2] "chaux vive"

#. ~ Description of "quicklime"
#: data/json/items/chemicals_and_resources.json
msgid ""
"The product of burning limestone, this white powder is a crucial ingredient "
"in making cement.  That said, it is also extremely caustic and will cause "
"severe burns to any tissue it comes in contact with.  This property could "
"probably be exploited."
msgstr ""
"Le résultat de la calcination du calcaire, cette poudre blanche est un "
"ingrédient indispensable pour le ciment. La chaux vive est aussi extrêmement"
" corrosive et brûle les tissus qui entrent en contact avec. Cette propriété "
"pourrait être exploitée..."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "slaked lime"
msgid_plural "slaked lime"
msgstr[0] "hydroxyde de calcium"
msgstr[1] "hydroxyde de calcium"
msgstr[2] "hydroxyde de calcium"

#. ~ Description of "slaked lime"
#: data/json/items/chemicals_and_resources.json
msgid ""
" A handful of slaked lime, a white odorless powder with many uses.  Also "
"known as calcium hydroxide."
msgstr ""

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgctxt "material"
msgid "sand"
msgid_plural "sand"
msgstr[0] "sable"
msgstr[1] "sable"
msgstr[2] "sable"

#. ~ Description of "sand"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A handful of New England sand.  If you had a stoked furnace, you could turn "
"it into glass.  Otherwise, it's only good for making cement."
msgstr ""
"Du sable. Avec un four alimenté vous pourriez en faire du verre. Sinon ce "
"n'est bon qu'a en faire du ciment."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "soil"
msgid_plural "soil"
msgstr[0] "terre"
msgstr[1] "terre"
msgstr[2] "terre"

#. ~ Description of "soil"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A pile of loosely-packed, slightly damp loamy soil.  This mixture of sand, "
"silt and clay is ideal for growing plants."
msgstr ""
"Un tas de terreaux argileux légèrement humide. Ce mélange de sable, de limon"
" et d'argile est idéal pour la croissance des plantes."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "limestone shard"
msgid_plural "limestone shards"
msgstr[0] "éclat de calcaire"
msgstr[1] "éclats de calcaire"
msgstr[2] "éclats de calcaire"

#. ~ Description of "limestone shard"
#: data/json/items/chemicals_and_resources.json
msgid ""
"A small shard of limestone.  Pretty flimsy and not much of a weapon, but its"
" alkaline properties may yet find some use."
msgstr ""
"Un petit éclat de calcaire. Fragile et peu fiable en tant qu'arme, mes ses "
"propriétés alcalines pourraient être utiles."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "rock salt"
msgid_plural "rock salt"
msgstr[0] "sel gemme"
msgstr[1] "sels gemme"
msgstr[2] "sels gemme"

#. ~ Description of "rock salt"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of rock salt crystals.  Could be refined into table salt."
msgstr ""
"Une poignée de sels gemme. Il pourrait être transformé en sel de table."

#. ~ density: 3.57–3.76 g/cm3
#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "rhodonite"
msgid_plural "rhodonite"
msgstr[0] "rhodonite"
msgstr[1] "rhodonite"
msgstr[2] "rhodonite"

#. ~ density: 3.57–3.76 g/cm3
#. ~ Description of "rhodonite"
#: data/json/items/chemicals_and_resources.json
