#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"This wooden wall has a hole that lets you shoot and use reach weapons "
"against enemies on the other side.  Highly flammable."
msgstr ""
"Ce mur en bois possède une embrasure vous permettant de tirer ou utiliser "
"des armes contre des ennemis à l'extérieur en offrant une couverture "
"significative. Malheureusement très inflammable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "wooden wall with a wide opening"
msgstr ""

#. ~ Description of terrain "wooden wall with a wide opening"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"This wooden wall previously had an embrasure, but the hole has been smashed "
"wide enough that you can climb through it, rendering it kind of pointless.  "
"Highly flammable."
msgstr ""
"Ce mur en bois possédait auparavant une embrasure, mais le trou à été "
"tellement élargi que n'importe quoi pourrait juste passer à travers, le "
"rendant assez inutile en tant que mur. Malheureusement très inflammable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "log wall with embrasure"
msgstr "mur de rondins avec embrasure"

#. ~ Description of terrain "log wall with embrasure"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"This timber wall has a hole that lets you shoot through and use reach "
"weapons against enemies on the other side, while also protecting you.  Quite"
" flammable."
msgstr ""
"Ce mur en rondins possède une embrasure vous permettant de tirer ou utiliser"
" des armes contre des ennemis à l'extérieur en offrant une couverture "
"significative. Assez inflammable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "log wall with a wide opening"
msgstr ""

#. ~ Description of terrain "log wall with a wide opening"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"This timber wall previously had an embrasure, but now the hole is so big "
"that you can climb through it, rendering it kind of pointless.  Quite "
"flammable."
msgstr ""
"Ce mur en rondins possédait auparavant une embrasure, mais le trou à été "
"tellement élargi que n'importe quoi pourrait juste passer à travers, le "
"rendant assez inutile en tant que mur. Malheureusement très inflammable."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "palisade wall with embrasure"
msgstr "palissade avec embrasure"

#. ~ Description of terrain "palisade wall with embrasure"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together.  This section in particular has an embrasure, so"
" you can shoot or use reach weapons through it while staying safe."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "simple concrete wall with embrasure"
msgstr "mur en béton avec embrasure"

#. ~ Description of terrain "simple concrete wall with embrasure"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"A durable and uniform concrete wall.  This one has an embrasure, so you can "
"shoot or use reach weapons through it while staying safe."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid "reinforced concrete wall with embrasure"
msgstr "mur en béton armé avec embrasure"

#. ~ Description of terrain "reinforced concrete wall with embrasure"
#: data/json/furniture_and_terrain/terrain-embrasures.json
msgid ""
"A section of wall with a nice small hole, letting you shoot your machine gun"
" from the safety of your reinforced bunker."
msgstr ""

