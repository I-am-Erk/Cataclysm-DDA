"void player::ApplyBiojutsuStatic() {\n"
"    blocks_left += 2;\n"
"    set_hit_bonus( get_hit_bonus() + 1 );\n"
"}\n"
"\n"
"+2 block attempts, +1 accuracy."
msgstr ""

