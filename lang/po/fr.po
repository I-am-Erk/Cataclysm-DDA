msgstr[1] "armoises"
msgstr[2] "armoises"

#. ~ Description of "mugwort"
#: data/json/items/comestibles/raw_veggy.json
msgid "A stalk of mugwort.  Smells wonderful."
msgstr "Une tige d'armoise. Ça sent merveilleusement bon."

#. ~ Raw onions probably aren't all that tasty to most people.
#. ~ Item name
#. ~ Plant name of seed "onion seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "onion"
msgid_plural "onions"
msgstr[0] "oignon"
msgstr[1] "oignons"
msgstr[2] "oignons"

#. ~ Raw onions probably aren't all that tasty to most people.
#. ~ Description of "onion"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An aromatic onion used in cooking.  Cutting these up can make your eyes "
"sting!"
msgstr "Un légume utilisé en cuisine. Le couper peut faire pleurer."

#. ~ wild vegetables as a reference
#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "fungal fluid sac"
msgid_plural "fungal fluid sacs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ wild vegetables as a reference
#. ~ Description of "fungal fluid sac"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A fluid bladder from a fungus-based lifeform.  Not very nutritious, but safe"
" to eat."
msgstr ""
"Une poche de fluide issue d'une forme de vie fongique; pas vraiment "
"nutritive mais peut probablement être consommée sans danger."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "raw potato"
msgid_plural "raw potatoes"
msgstr[0] "patate crue"
msgstr[1] "patates crues"
msgstr[2] "patates crues"

#. ~ Description of "raw potato"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A potato, mildly toxic and not very tasty raw.  Delicious and filling when "
"properly cooked."
msgstr ""
"Une pomme de terre, légèrement toxique et désagréable à manger crue mais "
"délicieuse et nourrissante bien cuite."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cooking banana"
msgid_plural "cooking bananas"
msgstr[0] "plantain"
msgstr[1] "plantains"
msgstr[2] "plantains"

#. ~ Description of "cooking banana"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A much less sweet and more starchy relative of the banana; unlike dessert "
"bananas, they usually are eaten cooked rather than raw, and can be processed"
" into flour.  They are a staple food in tropical regions of the world.  Also"
" known as plantains."
msgstr ""
"Un cousin bien moins sucré et plus amylacée de la banane; contrairement à la"
" banane, ceux-ci sont communément consommés cuits ou transformés en farine "
"et sont une denrée essentielle des tropiques."

#. ~ Item name
#. ~ Plant name of seed "pumpkin seeds"
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
