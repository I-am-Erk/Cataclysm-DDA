#: data/json/npcs/robofac/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_guard.json
#: data/mods/No_Hope/necropolis/npcs/NPC_Old_Guard_Soldier.json
msgid "Don't mind me…"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/campus/NPC_campus_guard_generic.json
msgid ""
"Everybody left has to take a turn.  I guess it's fair but not everyone is "
"really suited for beating up zombies or whatever."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/campus/NPC_campus_guard_generic.json
msgid ""
"I'm not even supposed to be here today, I just lost a bet and had to take "
"this shift."
msgstr ""
"Je n'était même pas censé(e) être de garde aujourd'hui, j'ai juste perdu un "
"pari et me suis retrouvé(e) collé(e) avec ce tour."

#. ~ NPC dialogue line
#: data/json/npcs/campus/NPC_campus_guard_generic.json
msgid ""
"I should be resting right now, this is my third straight shift.  Too many "
"people sick or hurt right now."
msgstr ""
"Je devrais être en train de me reposer, ceci est ma troisième garde "
"d'affilé. Nous avons trop de personnes blessées ou malades en ce moment."

#. ~ NPC dialogue line
#: data/json/npcs/campus/NPC_campus_guard_generic.json
msgid ""
"I live for this stuff.  I'm not really big on books, so this is probably "
"what I'm best at here."
msgstr ""
"Je ne me débrouille pas très bien avec les livres, donc je suppose que ceci "
"est le meilleur que je peut apporter à la communauté."

#. ~ Job description of "Guard" NPC class
#: data/json/npcs/campus/generic_class_definitions.json
#: data/json/npcs/refugee_center/surface_staff/generic_class_definitions.json
msgid "I'm on a guard shift."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid ""
"&You see this crazed fellows eyes darting around anxiously, always "
"anticipating impending doom.  Every now and then you can even hear them "
"whimper in fear.  Although they do not seem aggressive, they definitely are "
"out of their mind."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "You need to get to safety!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Awkwardly distance yourself.]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "&They shriek and stumble backwards, as if you just became a threat."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "I'm gonna kill all these <swear> things!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "&They let out a bellowing warcry and wave their stick."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "I'M INVINCIBLE!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "Are you crazy?  Get out of here!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Leave them to their futile fight.]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Like hell I will!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Fuck that, I'm not going out like a coward!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Leave them to their futile fight]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Stand aside citizen, I'll handle this!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Don't worry, I'm with the police<punc>"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid ""
"&The officer scans the area, looking for trouble.  They have a dangerous "
"glint in their eyes."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Back away.]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid ""
"&They are still breathing but unable to move and speak.  You are unsure if "
"they are even fully conscious and yet shudder at the thought of being "
"trapped inside your body."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Leave them to their ultimate fate.]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "No!  I just know it, they are still alive!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "[Let them keep on searching.]"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Have you seen my child?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "I am not leaving without my little one!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/civilians/civilians.json
msgid "Where is my kid?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/civilians/civilians.json
msgid "Your child is likely dead by now and you should get to safety!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Anything to do before I go to sleep?"
msgstr "Quelque chose à faire avant que j'aille dormir?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Wake up!"
msgstr "Debout!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Go back to sleep."
msgstr "Retournez dormir."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"This character was previously put into a suspension state due to an AI bug."
"  If you have reason to believe the problem was fixed, you can wake them up."
"  Do you want to do that now?"
msgstr ""
"Ce personnage a été précédemment mis en état de suspension en raison d'un "
"bug de l'IA. Si vous avez des raisons de croire que le problème a été réglé,"
" vous pouvez le réveiller. Voulez-vous faire ça maintenant ?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "yes, wake up!"
msgstr "Oui, réveillez-vous !"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "no, go back to sleep."
msgstr "non, rendors-toi."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *pshhhttt* I'm reading you boss, over."
msgstr "*pshhhttt* Je vous reçois patron, terminé."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "What is it, friend?"
msgstr "Qu'y a-t-il, mon ami ?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I want to give you some commands for combat."
msgstr "Je veux vous donner quelques ordres pour le combat."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I want to set some miscellaneous rules."
msgstr "Je veux établir quelques règles."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I'd like to know a bit more about your abilities."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "There's something I want you to do."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I just wanted to talk for a bit."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Can you help me understand something?  (HELP/TUTORIAL)"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "I'm going to go my own way for a while."
msgstr "Je vais continuer tout seul un moment."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
" *tshk* Are you serious?  This isn't a cell phone.  Can it wait until we're "
"in the same place?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Sure, what did you want to say?"
msgstr ""

#. ~ Response to NPC dialogue
