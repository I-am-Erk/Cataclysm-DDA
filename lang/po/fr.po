msgid_plural "zaptors"
msgstr[0] "zaptor"
msgstr[1] "zaptors"
msgstr[2] "zaptors"

#. ~ Description of monster "zaptor"
#: data/json/monsters/zed-winged.json
msgid ""
"This small, winged predator darts through the air on three thinly-haired "
"wings that look like stretched human hands.  A jagged spike with a pulsing "
"electrical glow juts out from the point where the wings meet."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "acidic zombie"
msgid_plural "acidic zombies"
msgstr[0] "zombie acidique"
msgstr[1] "zombies acidiques"
msgstr[2] "zombies acidiques"

#. ~ Description of monster "acidic zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"A sickly-looking zombie.  Its skin looks especially thin, with a sticky, "
"yellow fluid flowing through the clearly visible veins."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "corrosive zombie"
msgid_plural "corrosive zombies"
msgstr[0] "zombie corrosif"
msgstr[1] "zombies corrosifs"
msgstr[2] "zombies corrosifs"

#. ~ Description of monster "corrosive zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"This zombie has swollen to immense proportions, but still manages to hold "
"itself together with semi-congealed acid all over its bloated, leathery "
"body.  It moves clumsily, but spits from a large reserve of acid with "
"uncanny accuracy."
msgstr ""

#. ~ Description of special attack of monster "corrosive zombie"
#: data/json/monsters/zed_acid.json
msgid "The corrosive zombie spits a glob of acid!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "spitter zombie"
msgid_plural "spitter zombies"
msgstr[0] "zombie cracheur"
msgstr[1] "zombies cracheurs"
msgstr[2] "zombies cracheurs"

#. ~ Description of monster "spitter zombie"
#: data/json/monsters/zed_acid.json
msgid ""
"A hunched human body with its eyes pushed up into its forehead and drooping "
"cheeks, most of its face is occupied by a puckered mouth.  Its stomach is "
"swollen and nearly translucent, with a sickly yellow tint."
msgstr ""
"Un corps humain recroquevillé avec les yeux enfoncés dans son front, les "
"joues affaissées; la plus grande partie de son visage est occupée par une "
"bouche plissée. Son estomac enflé et presque translucide est d'une couleur "
"jaune blafard."

#. ~ Monster name
#: data/json/monsters/zed_acid.json
msgid "wretched puker"
msgid_plural "wretched pukers"
msgstr[0] "gerbeur pathétique"
msgstr[1] "gerbeurs pathétiques"
msgstr[2] "gerbeurs pathétiques"

#. ~ Description of monster "wretched puker"
#: data/json/monsters/zed_acid.json
msgid ""
"A degenerate corpse, shambling as it walks.  Various pieces of trash and "
"waste materials have melded into the black goo leaking from its skin."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed_acid.json
