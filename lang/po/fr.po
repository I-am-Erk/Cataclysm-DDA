#. ~ Item name
#: data/json/items/ammo.json
msgid "candle wax"
msgid_plural "candle wax"
msgstr[0] "cire de bougie"
msgstr[1] "cire de bougie"
msgstr[2] "cire de bougie"

#. ~ Description of "candle wax"
#: data/json/items/ammo.json
msgid "A solid flammable substance, used to make candles."
