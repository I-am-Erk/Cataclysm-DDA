msgstr "Rien. Parlons d'autre chose."

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_FACTION_CAMP.json
msgid "Never mind, let's talk about other things you can do"
msgstr "Oubliez, parlons des autres choses que vous pouvez faire."

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_FACTION_CAMP.json
