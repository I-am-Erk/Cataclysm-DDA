msgid "Dissolved into the collective."
msgstr ""

#. ~ Memorial message of mutation class "Mycus" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Dissolved into the collective."
msgstr ""

#. ~ Message about the player in an effect
#: data/json/mutations/mutation_eocs.json
msgid "You don't have enough stamina to activate your Bioluminescent Flare."
msgstr ""
"Vous n'avez pas assez d'endurance pour activer votre Torche Bioluminescente."

#. ~ Mutation name
#: data/json/mutations/mutation_item_traits.json
msgid "Well Distributed Gear"
msgstr "Équipement Bien Reparti"

#. ~ Description of mutation "Well Distributed Gear"
#: data/json/mutations/mutation_item_traits.json
msgid ""
"You are wearing equipment that helps to distribute weight allowing you to "
"carry more."
msgstr ""
"Vous portez une ou plusieurs pièces d'équipement vous aidant à mieux "
"distribuer le poids de ce que vous portez et ainsi augmente la limite de ce "
"que vous pouvez porter."

#. ~ Name of body part
#. ~ Heading of body part "gastropod foot"
#: data/json/mutations/mutation_limbs.json
msgid "gastropod foot"
msgstr "pied de gastropode"

#. ~ Accusative name of body part
#: data/json/mutations/mutation_limbs.json
msgctxt "bodypart_accusative"
msgid "gastropod foot"
msgstr "pied de gastropode"

#. ~ Heading of body part "gastropod foot"
#: data/json/mutations/mutation_limbs.json
msgid "gastropod feet"
msgstr "pieds de gastropode"

#. ~ HP bar UI text of body part "gastropod foot"
#: data/json/mutations/mutation_limbs.json
msgid "G. FOOT"
msgstr ""

#. ~ Spell name
#: data/json/mutations/mutation_spells.json
msgid "Blinding Spray"
msgstr "Spray Aveuglant"

#. ~ Description of spell "Blinding Spray"
#: data/json/mutations/mutation_spells.json
msgid "Blinds enemy for a short time."
msgstr "Aveugle un ennemi pour un bref moment."

#. ~ Spell name
#. ~ Mutation name
#: data/json/mutations/mutation_spells.json data/json/mutations/mutations.json
msgid "Slime Spray"
msgstr "Spray de Slime"

#. ~ Description of spell "Slime Spray"
#: data/json/mutations/mutation_spells.json
msgid "Spray slime onto an enemy to slow them down."
msgstr ""

#. ~ Spell name
#. ~ Mutation name
#: data/json/mutations/mutation_spells.json data/json/mutations/mutations.json
msgid "Bioluminescent Flare"
msgstr "Torche Bioluminscente"

#. ~ Description of spell "Bioluminescent Flare"
#: data/json/mutations/mutation_spells.json
msgid ""
"Launches a glob of bioluminescent goo that illuminates the area around it."
msgstr ""

#. ~ Spell name
#: data/json/mutations/mutation_spells.json
msgid "Short Leap"
msgstr "Saut Court"

#. ~ Description of spell "Short Leap"
#. ~ Description of spell "Hare Leap"
#: data/json/mutations/mutation_spells.json
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"You squat down, build up tension in your legs and release.  Launching "
"yourself quite a distance."
msgstr ""

#. ~ Spell name
#. ~ Mutation name
#: data/json/mutations/mutation_spells.json data/json/mutations/mutations.json
msgid "Crushing Leap"
msgstr "Saut Écrasant"

#. ~ Description of spell "Crushing Leap"
#: data/json/mutations/mutation_spells.json
msgid ""
"You squat down, build up tension in your legs and release.  You have the "
"ability to target and land in the way to do maximum damage to any target in "
"your way.  Death from above."
msgstr ""

#. ~ Spell name
#: data/json/mutations/mutation_spells.json
msgid "Talon Leap"
msgstr ""

#. ~ Description of spell "Talon Leap"
#: data/json/mutations/mutation_spells.json
msgid ""
"You jump at your target with your talons up front, attempting to deal "
"devastating damage to your target."
msgstr ""

#. ~ Spell name
#. ~ Mutation name
#: data/json/mutations/mutation_spells.json data/json/mutations/mutations.json
msgid "Pounce"
msgstr "Bondissement"

#. ~ Description of spell "Pounce"
#: data/json/mutations/mutation_spells.json
msgid ""
"You squat down, build up tension in your legs, waggling your tail, then "
"release.  Launching yourself quite a distance."
msgstr ""

#. ~ Martial technique name
#: data/json/mutations/mutation_techs.json
msgid "CHOMP"
msgstr "CHOMP"

#. ~ Message of martial technique "CHOMP"
#: data/json/mutations/mutation_techs.json
#, c-format
msgid "You sting %s with your bug-laden tail"
msgstr ""

#. ~ Message of martial technique "CHOMP"
#: data/json/mutations/mutation_techs.json
#, c-format
msgid "<npcname> stings %s with their bug-laden tail"
msgstr ""

#. ~ Description of mutation "Changing"
#: data/json/mutations/mutations.json
msgid "You shouldn't see this.  This makes you mutate."
msgstr ""
"Vous ne devriez pas pouvoir voire ceci. Ceci est appliqué quand le "
"personnage joueur est en train de muter."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "No Extras"
msgstr "Aucun Trait Additionnel"

#. ~ Description of mutation "No Extras"
#: data/json/mutations/mutations.json
msgid ""
"You don't have any tails, whiskers, horns, or miscellaneous extra bits."
msgstr ""
"Vous ne possédez aucune queues, moustaches, cornes ou tout autre trait "
"additionnel divers."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Arms"
msgstr "Bras Humains"

#. ~ Description of mutation "Human Arms"
#: data/json/mutations/mutations.json
msgid "You have human arms."
msgstr "Vous possédez des bras humains."

#. ~ Description of mutation "Human Blood"
#: data/json/mutations/mutations.json
msgid "You have human blood."
msgstr "Vous avez du sang humain."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Ears"
msgstr "Oreilles Humaines"

#. ~ Description of mutation "Human Ears"
#: data/json/mutations/mutations.json
msgid "You have human ears and hearing."
msgstr "Vous avez des oreilles et une acuité auditive humaines."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Eyes"
msgstr "Yeux Humains"

#. ~ Description of mutation "Human Eyes"
#: data/json/mutations/mutations.json
msgid "You have human eyes."
msgstr "Vous possédez une paire d'yeux humains."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Hands"
msgstr "Mains Humaines"

#. ~ Description of mutation "Human Hands"
#: data/json/mutations/mutations.json
msgid "You have human hands."
msgstr "Vous possédez des mains humaines."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Healing"
msgstr "Guérison Humaine"

#. ~ Description of mutation "Human Healing"
#: data/json/mutations/mutations.json
msgid "You heal as fast as most humans do in this new world."
msgstr ""
"Vous guérissez au même rythme que la plupart des humains de ce nouveau "
"monde."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Legs"
msgstr "Jambes Humaines"

#. ~ Description of mutation "Human Legs"
#: data/json/mutations/mutations.json
msgid "You have human legs."
msgstr "Vous possédez des jambes humaines."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Metabolism"
msgstr "Métabolisme Humain"

#. ~ Description of mutation "Human Metabolism"
#: data/json/mutations/mutations.json
msgid "Your digestive system and cardio health are standard for a human."
msgstr "Votre niveau de cardio et système digestif sont proches de la norme."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Mouth"
msgstr "Bouche Humaine"

#. ~ Description of mutation "Human Mouth"
#: data/json/mutations/mutations.json
msgid "You have a human mouth with human teeth."
msgstr "Vous avez une bouche et dentition humaines."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Voice"
msgstr "Voix Humaine"

#. ~ Description of mutation "Human Voice"
#: data/json/mutations/mutations.json
msgid "Your voice doesn't sound especially abnormal."
msgstr "Votre voix sonne plus ou moins normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Skin"
msgstr "Peau Humaine"

#. ~ Description of mutation "Human Skin"
#: data/json/mutations/mutations.json
msgid "You have human skin and no distinct smell."
msgstr "Vous avez une peau normale et n'émettez aucune odeur distinctive."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Rest"
msgstr "Sommeil Humain"

#. ~ Description of mutation "Human Rest"
#: data/json/mutations/mutations.json
msgid "You sleep a normal amount for a human."
msgstr "Vous dormez autant de temps qu'un humain normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Capabilities"
msgstr "Capacités Humaines"

#. ~ Description of mutation "Human Capabilities"
#: data/json/mutations/mutations.json
msgid "Your capabilities are pretty normal."
msgstr "Vos capacités sont plutôt normales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Mind"
msgstr ""

#. ~ Description of mutation "Human Mind"
#: data/json/mutations/mutations.json
msgid "Your mind and brain chemistry are not mutated."
msgstr "Votre cerveau et sa chimie ne sont pas altérés par des mutations."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human Immunity"
msgstr "Immunité Humaine"

#. ~ Description of mutation "Human Immunity"
#: data/json/mutations/mutations.json
msgid "Your immune system is more or less normal for a human."
msgstr "Votre système immunitaire est plus ou moins normal pour un humain."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Human ACCLIMATIZATION"
msgstr "ACCLIMATISATION Humaine"

#. ~ Description of mutation "Human ACCLIMATIZATION"
#: data/json/mutations/mutations.json
msgid "Your temperature tolerance is more or less normal for a human."
msgstr ""
"Vous êtes capable de tolérer des températures dans la gamme qu'un humain "
"normal peut."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fleet-Footed"
msgstr "Bon coureur"

#. ~ Description of mutation "Fleet-Footed"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You can move more quickly than most, resulting in a 15% speed bonus on sure "
"footing."
msgstr ""
"Vous pouvez vous déplacer plus rapidement que la plupart des autres, ce qui "
"donne un bonus de vitesse de 15% lorsque vous êtes sur pied sûr."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reflex Photophore"
msgstr "Photophore Réflexe"

#. ~ Description of mutation "Reflex Photophore"
#: data/json/mutations/mutations.json
msgid ""
"A photophore has grown from your head.  You can't consciously control it, "
"and it might start to shine in response to your emotions or your "
"physiological state."
msgstr ""
"Un photophore s'est développé sur votre tête. Vous ne pouvez pas le "
"contrôler consciemment et il décide de briller de façon aléatoire en "
"fonction de vos émotions ou de votre état physiologique."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Photophore"
msgstr "Photophore Faible"

#. ~ Description of mutation "Weak Photophore"
#: data/json/mutations/mutations.json
msgid ""
"A photophore has grown from your head; you can make it glow softly.  This "
"will make you very visible in the dark, ideal for attracting a partner "
"during mating season."
msgstr ""
"Un photophore s'est développé sur votre tête, et vous pouvez consciemment le"
" contrôler pour le faire briller consciemment dans le noir, vous rendant "
"très visible et parfait pour attirer un(e) partenaire durant la saison des "
"amours."

#. ~ Message when transforming from mutation  "Weak Photophore" to
#. "BIOLUM1_active"
#. ~ Message when transforming from mutation  "Photophore" to "BIOLUM2_active"
#: data/json/mutations/mutations.json
msgid "Your photophore starts glowing."
msgstr "Votre photophore commence à briller."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Photophore (on)"
msgstr "Photophore Faible (allumé)"

#. ~ Description of mutation "Weak Photophore (on)"
#: data/json/mutations/mutations.json
msgid "Your photophore is glowing softly."
msgstr "Votre photophore brille doucement."

#. ~ Message when transforming from mutation  "Weak Photophore (on)" to
#. "BIOLUM1"
#. ~ Message when transforming from mutation  "Photophore (on)" to "BIOLUM2"
#: data/json/mutations/mutations.json
msgid "Your photophore stops glowing."
msgstr "Votre photophore arrête de briller."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Photophore"
msgstr "Photophore"

#. ~ Description of mutation "Photophore"
#: data/json/mutations/mutations.json
msgid "You can make your photophore glow brightly."
msgstr "Vous pouvez faire briller votre photophore très fort."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Photophore (on)"
msgstr "Photophore (allumé)"

#. ~ Description of mutation "Photophore (on)"
#: data/json/mutations/mutations.json
msgid "You photophore is glowing brightly."
msgstr "Votre photophore brille vigoureusement."

#. ~ Description of mutation "Bioluminescent Flare"
#: data/json/mutations/mutations.json
msgid ""
"You can spit a wad of bioluminescent goo several meters away.  There it will"
" light up it's surroundings until it dissipates."
msgstr ""
"Vous pouvez cracher un globe de salive bioluminescent dans un rayon de "
"quelque mètres et ainsi illuminer l'endroit ou elle atterri jusqu'à ce que "
"celle-ci se dissipe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Normal Human"
msgstr "Humain Normal"

#. ~ Description of mutation "Normal Human"
#: data/json/mutations/mutations.json
msgid ""
"You're a normal human; there's nothing wrong with you.  No need to worry."
msgstr ""
"Vous êtes un être humain normal; vous êtes totalement normal. Il n'y a "
"aucune raison de s'inquiéter."

#. ~ Trigger message of mutation "Normal Human"
#: data/json/mutations/mutations.json
msgid "Everything is terrible and this makes you so ANGRY!"
msgstr ""

#. ~ Message when transforming from mutation  "Normal Human" to "HYDE"
#: data/json/mutations/mutations.json
msgid "The anger overtakes you!"
msgstr "La haine prends contrôle de vos actions!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Violent Monster"
msgstr "Monstre Violent"

#. ~ Description of mutation "Violent Monster"
#: data/json/mutations/mutations.json
msgid "Anger clouds your mind; you can't think straight, but you feel strong."
msgstr ""

#. ~ Trigger message of mutation "Violent Monster"
#: data/json/mutations/mutations.json
msgid "As the morning comes, you return back to normal."
msgstr ""

#. ~ Message when transforming from mutation  "Violent Monster" to "JEKYLL"
#: data/json/mutations/mutations.json
msgid "The anger subsides."
msgstr "La haine s'appaise."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Good Hearing"
msgstr "Ouïe fine"

#. ~ Description of mutation "Good Hearing"
#: data/json/mutations/mutations.json
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr ""
"Votre ouïe est plus performante que la moyenne et vous entendez les sons "
"distants plus facilement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Hearing"
msgstr "Ouïe de Fée"

#. ~ Description of mutation "Fey Hearing"
#: data/json/mutations/mutations.json
msgid ""
"You're not sure the shape of your ears is helping you any; regardless, you "
"have become very sensitive to sounds."
msgstr ""
"Vous n'êtes pas sûr(e) que la nouvelle forme pointue de vos oreilles soit "
"bénéfique pour votre ouïe, mais celle-ci s'est comme même améliorée "
"considérablement."

#. ~ Description of mutation "Inattentive"
#: data/json/mutations/mutations.json
msgid ""
"You never paid attention to your surroundings and specifically to people "
"around you.  You can't judge intent of critters you see."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Outdoorsman"
msgstr "Amateur de plein air"

#. ~ Description of mutation "Outdoorsman"
#: data/json/mutations/mutations.json
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr ""
"Vous êtes habitué aux éléments de la nature. Votre moral sera moins impacté "
"par le fait d'être mouillé."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Indefatigable"
msgstr "Infatigable"

#. ~ Description of mutation "Indefatigable"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to exercise and good diet, or due to a natural propensity to "
"physical endurance, you tire due to physical exertion much less readily than"
" others.  Your cardio fitness and maximum stamina are higher than usual."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyperactive"
msgstr "Hyperactif"

#. ~ Description of mutation "Hyperactive"
#: data/json/mutations/mutations.json
msgid ""
"Your body's efficiency is like that of a tiny furnace, greatly increasing "
"your cardio and stamina."
msgstr ""
"Votre métabolisme est comparable à un four miniature, améliorant votre "
"endurance et votre cardio, mais vous faisant dépenser plus d'énergie."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quick"
msgstr "Rapide"

#. ~ Description of mutation "Quick"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr ""
"Vous êtes simplement rapide ! Vous obtenez un bonus de 10% aux points "
"d'action."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tunnel Fighter"
msgstr "Guerrier Souterrain"

#. ~ Description of mutation "Tunnel Fighter"
#: data/json/mutations/mutations.json
msgid ""
"You know how to fight in cramped tunnels at risk of collapse.  You gain "
"bonuses when fighting underground."
msgstr ""
"Vous savez comment vous battre dans des tunnels risquant constamment de "
"s'éffondrer et ainsi gagner des bonus durant un affrontement souterrain."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Night Raider"
msgstr ""

#. ~ Description of mutation "Night Raider"
#: data/json/mutations/mutations.json
msgid ""
"Your body is one with the night.  You make less noise when the moon is up in"
" the sky, even when you cannot see it."
msgstr ""
"Votre corps ne fait qu'un avec la nuit. Vous produisez moins de son lorsque "
"la lune est haute, même dans le cas où vous ne pouvez pas la voire."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Portal Dependent"
msgstr "Dépendance aux Portails"

#. ~ Description of mutation "Portal Dependent"
#: data/json/mutations/mutations.json
msgid ""
"You feel alien in your own body, as if part of you remained behind with the "
"storm.  You will suffer severely when not exposed to portal storms unless "
"you find a way to anchor yourself to the world again."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stabilized in Reality"
msgstr ""

#. ~ Description of mutation "Stabilized in Reality"
#: data/json/mutations/mutations.json
msgid ""
"You have regained some substance and have stabilized somewhat, if not "
"entirely.  Portal storm withdrawal will not affect you as strongly as "
"before."
msgstr ""

#. ~ Description of mutation "Optimist"
#: data/json/mutations/mutations.json
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, "
"and are generally happier than most people."
msgstr ""
"Vous ne vous laissez pas abattre ! Vous savourez les joies de l'existence, "
"ignorez ses épreuves et êtes généralement plus heureux que la plupart des "
"gens."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Healer"
msgstr "Guérison rapide"

#. ~ Description of mutation "Fast Healer"
#: data/json/mutations/mutations.json
msgid "Your wounds and broken limbs heal quicker than usual."
msgstr "Vos blessures et fractures guérissent plus rapidement que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Eater"
msgstr "Petit appétit"

#. ~ Description of mutation "Light Eater"
#: data/json/mutations/mutations.json
msgid ""
"Your metabolism is a little slower, and you require less food than most."
msgstr ""
"Votre métabolisme est un peu plus lent, vous avez donc besoin d'un peu moins"
" de nourriture que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Accomplished Sleeper"
msgstr "Dormeur accompli"

#. ~ Description of mutation "Accomplished Sleeper"
#: data/json/mutations/mutations.json
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr ""
"Vous n'avez jamais de mal à vous endormir, même dans des situations "
"improbables."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Practiced Sleeper"
msgstr "Dormeur pratiqué"

#. ~ Description of mutation "Practiced Sleeper"
#: data/json/mutations/mutations.json
msgid ""
"Your body's demanding energy needs mean you can fall asleep just about "
"anywhere."
msgstr ""
"Les besoins énergétiques exigeants de votre corps vous permettent de vous "
"endormir à peu près n'importe où."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Earth Sleeper"
msgstr "Dormeur Terrestre"

#. ~ Description of mutation "Earth Sleeper"
#: data/json/mutations/mutations.json
msgid "You always sleep better surrounded by earth."
msgstr "Vous dormez considérablement mieux au milieu de terre découverte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aquatic Sleeper"
msgstr "Dormeur Aquatique"

#. ~ Description of mutation "Aquatic Sleeper"
#: data/json/mutations/mutations.json
msgid "You always sleep better underwater."
msgstr "Vous dormez considérablement mieux sous l'eau."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Resistant"
msgstr "Résistance à la douleur"

#. ~ Description of mutation "Pain Resistant"
#: data/json/mutations/mutations.json
msgid "You have a high tolerance for pain."
msgstr "Vous avez une haute résistance à la douleur."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Night Vision"
msgstr "Nyctalopie"

#. ~ Description of mutation "Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You possess natural night vision, and can see further in the dark than most."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Vous voyez plus loin dans l'obscurité. Ce trait peut s'activer à la demande."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poison Resistant"
msgstr "Résistance au poison"

#. ~ Description of mutation "Poison Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr ""
"Votre système est plutôt tolérant aux poisons et toxines, la plupart vous "
"affecteront donc moins."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Reader"
msgstr "Lecteur rapide"

#. ~ Description of mutation "Fast Reader"
#: data/json/mutations/mutations.json
msgid ""
"You're a quick reader, and can get through books a lot faster than most."
msgstr ""
"Vous lisez rapidement et terminez donc les livres beaucoup plus rapidement "
"que la majorité des gens."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tough Feet"
msgstr "Pieds vigoureux"

#. ~ Description of mutation "Tough Feet"
#: data/json/mutations/mutations.json
msgid ""
"The bottoms of your feet are tough, and you are accustomed to going "
"barefoot.  You receive no movement penalty for not wearing shoes."
msgstr ""
"La plante de vos pieds est très résistante et vous avez l'habitude de "
"marcher nu pieds. Vous n'avez pas de pénalités de mouvement si vous ne "
"portez pas de chaussures."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine Bulk"
msgstr "Masse Bovine"

#. ~ Description of mutation "Bovine Bulk"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh has become dense with fat and muscle.  This makes you harder to "
"take down, but also a poor swimmer."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bull Roids"
msgstr ""

#. ~ Description of mutation "Bull Roids"
#: data/json/mutations/mutations.json
msgid ""
"Your bulk has rendered you a veritable living wall.  Be careful around water"
" though; while you're as sturdy as a rock, you'll sink like one too."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tough"
msgstr "Coriace"

#. ~ Description of mutation "Tough"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr ""
"Il en faut beaucoup pour vous tuer! Vous avez un bonus de 20% à tous vos "
"points de vie."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Durable"
msgstr "Résistant"

#. ~ Description of mutation "Durable"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr ""
"Vous pouvez enlever presque n'importe quoi! Vous obtenez un bonus de 30% sur"
" tous les points de vie."

#. ~ Mutation name
#. ~ Spell name
#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Unbreakable"
msgstr "Incassable"

#. ~ Description of mutation "Unbreakable"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr ""
"Rien ne peut te briser! Vous obtenez un bonus de 40% sur tous les points de "
"vie."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick-Skinned"
msgstr "Peau épaisse"

#. ~ Description of mutation "Thick-Skinned"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is tough.  Cutting and bashing damage is slightly reduced for you."
"  There's a small chance you don't cut yourself on sharp terrain."
msgstr ""
"Votre peau est coriace. Les dégâts contendants et coupants que vous subissez"
" seront légèrement réduits et vous avez une petite chance de ne pas vous "
"couper sur des objets pointus."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Packmule"
msgstr "Organisé"

#. ~ Description of mutation "Packmule"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You pack things very efficiently!  You can retrieve things from containers "
"10% faster."
msgstr ""
"Vous faites vos bagages avec une efficacité impressionnante et pouvez "
"extraire quelque chose d'un contenant 10% plus vite que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Back"
msgstr "Dos musclé"

#. ~ Description of mutation "Strong Back"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr ""
"Vous pouvez porter plus de charge que la moyenne. Votre poids transporté "
"maximal augmente de 35%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Learner"
msgstr "Apprentissage rapide"

#. ~ Description of mutation "Fast Learner"
#: data/json/mutations/mutations.json
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Vous avez un esprit flexible qui vous permet d'apprendre des compétences "
"bien plus vite que les autres personnes. Notez que cela s'applique "
"uniquement à l'expérience des activités que vous pratiquez et non à la "
"lecture."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rigid Table Manners"
msgstr "Manières de Table Rigides"

#. ~ Description of mutation "Rigid Table Manners"
#: data/json/mutations/mutations.json
msgid ""
"You've been taught proper table manners from your early childhood on; now, "
"you can't even think about eating without being seated at a table and taking"
" your time.  Eating without a table and chair frustrates you, but eating "
"like a civilized person gives you a bigger morale bonus."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Stomach"
msgstr "Estomac conciliant"

#. ~ Description of mutation "Strong Stomach"
#: data/json/mutations/mutations.json
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up despite this, you won't suffer any residual nausea."
msgstr ""
"Vous êtes moins susceptible de vomir à cause d'une intoxication alimentaire,"
" de l'alcool, etc. Même si vous vomissez malgré cela, vous ne souffrirez pas"
" de nausée résiduelle après."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stomach Cleanse"
msgstr ""

#. ~ Description of mutation "Stomach Cleanse"
#: data/json/mutations/mutations.json
msgid ""
"You have gained the ability to invert your stomach outside your body to "
"quickly eliminate toxins, and are more likely to throw up from food "
"poisoning, alcohol, etc.  If you throw up because of this, you won't suffer "
"any residual nausea."
msgstr ""
"Vous avez gagné la capacité de rapidement expulser votre estomac hors de "
"votre bouche afin de rapidement éliminer les toxines et poisons que vous "
"pouvez avoir ingérés. Ceci vous rends plus susceptible de vomir à cause "
"d'une intoxication alimentaire, de l'alcool, etc. Du bon côté, vous ne "
"souffrirez d'aucune nausée résiduelle après avoir évacué votre estomac."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Good Memory"
msgstr "Bonne mémoire"

#. ~ Description of mutation "Good Memory"
#: data/json/mutations/mutations.json
msgid ""
"You have an exceptional memory, and find it easy to remember things.  Your "
"skills will erode slightly slower than usual."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deft"
msgstr "Agile"

#. ~ Description of mutation "Deft"
#: data/json/mutations/mutations.json
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr ""
"Même si vous n'êtes pas meilleur au combat de mêlée, vous récupérez mieux "
"après un coup manqué et vous serez capable de tenter une autre attaque plus "
"rapidement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spiritual"
msgstr "Spirituel"

#. ~ Description of mutation "Spiritual"
#: data/json/mutations/mutations.json
msgid ""
"You've always felt that there is more to the world than we can see.  Whether"
" driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr ""
"Vous avez toujours senti que le monde a plus à nous offrir qu'on ne peut le "
"voir. Guidé par des croyances religieuses ou des intérêts philosophiques, "
"vous faites preuve de grandes inspirations en étudiant des textes sacrés ou "
"par des expériences mystiques."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Substance Tolerance"
msgstr "Tolérance aux substances"

#. ~ Description of mutation "Substance Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You can handle intoxicants well.  Their effects clear up more quickly for "
"you."
msgstr ""
"Vous supportez bien les substances toxiques. Leurs effets se résorbent plus "
"vite."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gourmand"
msgstr "Gourmand"

#. ~ Description of mutation "Gourmand"
#: data/json/mutations/mutations.json
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also "
"enjoy food more; delicious food is better for your morale, and you don't "
"mind unsavory meals as much.  Activate to skip prompt for overeating."
msgstr ""
"Vous mangez plus vite et pouvez manger et boire plus que quiconque! Vous "
"appréciez également davantage la nourriture; une nourriture délicieuse est "
"meilleure pour votre moral et vous ne craignez pas autant les repas peu "
"recommandables Activer pour ignorer l'invite de trop manger."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bookworm"
msgstr "Rat de bibliothèque"

#. ~ Description of mutation "Bookworm"
#: data/json/mutations/mutations.json
msgid ""
"There's nothing quite like the smell of a good book!  Books are more fun (or"
" less boring) for you!"
msgstr ""
"Il n'y a rien de mieux que l'odeur d'un bon livre! Les livres sont plus "
"amusants (ou moins ennuyeux) pour vous!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Addiction Resistant"
msgstr "Résistance aux addictions"

#. ~ Description of mutation "Addiction Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr ""
"Que ce soit grâce à une vie de consommation ou à votre volonté, vous devenez"
" moins facilement dépendant à des substances et il vous est plus facile de "
"vous débarrasser de ces addictions."

#. ~ Mutation name
#. ~ Name of effect type id "effect_animal"
#: data/json/mutations/mutations.json
#: data/mods/BombasticPerks/perkdata/empath.json
msgid "Animal Empathy"
msgstr "Empathie des animaux"

#. ~ Description of mutation "Animal Empathy"
#: data/json/mutations/mutations.json
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are"
" less likely to attack.  This only applies to natural animals such as "
"woodland creatures."
msgstr ""
"Les animaux pacifiques ne vous fuiront pas, de plus même les animaux "
"agressifs seront moins susceptibles de vous attaquer. Cela s'applique "
"seulement pour les animaux sauvages comme ceux vivant dans les bois."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Animal Kinship"
msgstr "Affinité Animale"

#. ~ Description of mutation "Animal Kinship"
#: data/json/mutations/mutations.json
msgid ""
"Something about your presence is calming to animals, and they will treat you"
" with innate trust.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Quelque chose rends votre présence calmante pour les animaux que vous "
"rencontrez, et ils vous traiteront avec une confiance instinctuelle. Ceci "
"n'est vrai que pour les animaux normaux, et une monstruosité mutante "
"ignorera ceci complétement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Terrifying"
msgstr "Terrifiant"

#. ~ Description of mutation "Terrifying"
#: data/json/mutations/mutations.json
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr ""
"Quelque chose en vous terrifie les créatures, elles vous fuiront "
"probablement plus."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disease Resistant"
msgstr "Résistance aux maladies"

#. ~ Description of mutation "Disease Resistant"
#: data/json/mutations/mutations.json
msgid ""
"It's very unlikely that you will catch ambient diseases like the cold or "
"flu."
msgstr ""
"Il est très improbable que vous attrapiez des maladies courantes comme un "
"rhume ou la grippe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Adrenaline"
msgstr "Poussée d'adrénaline"

#. ~ Description of mutation "High Adrenaline"
#: data/json/mutations/mutations.json
msgid ""
"If you are in a very dangerous situation, you may experience a temporary "
"rush which increases your speed and strength significantly."
msgstr ""
"Dans des situations très dangereuses, vous pouvez ressentir une poussée "
"d'adrénaline qui augmente significativement votre vitesse et votre force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Combat Adaptation"
msgstr ""

#. ~ Description of mutation "Combat Adaptation"
#: data/json/mutations/mutations.json
msgid ""
"When you are in great danger you may flip a chemical switch in your brain "
"and for a cost in hunger, fatigue, and thirst your nervous system will "
"process things around you slightly faster.  Giving you better reaction times"
" that you can pay for later if you survive."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Less Sleep"
msgstr "Moins de sommeil"

#. ~ Description of mutation "Less Sleep"
#: data/json/mutations/mutations.json
msgid "You need less sleep than the average person."
msgstr "Vous avez besoin de moins de sommeil que la moyenne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Masochist"
msgstr "Masochiste"

#. ~ Description of mutation "Masochist"
#: data/json/mutations/mutations.json
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr ""
"Même si vous souffrez encore des effets négatifs de la douleur, celle-ci "
"vous procure aussi un plaisir unique."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stimulant Psychosis"
msgstr "Psychose liée aux stimulants"

#. ~ Description of mutation "Stimulant Psychosis"
#: data/json/mutations/mutations.json
msgid ""
"You have a unique history with stimulants (like coffee or amphetamines).  "
"You can tolerate a lot more of them without overdosing, but if you indulge "
"too much, you start seeing things…"
msgstr ""

#. ~ Description of mutation "Stylish"
#: data/json/mutations/mutations.json
msgid ""
"Practicality is far less important than style.  Your morale is improved by "
"wearing fashionable and attractive clothing."
msgstr ""
"L'aspect pratique est beaucoup moins important que le style. Même si c'est "
"la fin du monde il est important d'avoir le plus possible la classe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Step"
msgstr "Pas léger"

#. ~ Description of mutation "Light Step"
#: data/json/mutations/mutations.json
msgid ""
"You make less noise while walking.  You're also less likely to set off "
"traps."
msgstr ""
"Vous faites moins de bruit lorsque vous marchez. Cela vous permet également "
"de réduire vos chances de déclencher les pièges."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Robust Genetics"
msgstr "Génétique robuste"

#. ~ Description of mutation "Robust Genetics"
#: data/json/mutations/mutations.json
msgid ""
"Your genetics have rapidly adapted to the chaos of the Cataclysm, and the "
"genetic damage caused by mutations will fade much quicker."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scout"
msgstr "Éclaireur"

#. ~ Description of mutation "Scout"
#: data/json/mutations/mutations.json
msgid ""
"You're an excellent navigator and your ability to recognize distant "
"landmarks is unmatched.  Your sight radius on the overmap extends beyond the"
" normal range."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Topographagnosia"
msgstr "Topographagnosie"

#. ~ Description of mutation "Topographagnosia"
#: data/json/mutations/mutations.json
msgid ""
"Focal brain damage has rendered you incapable of recognizing landmarks and "
"orienting yourself in your surroundings, severely crippling your sight "
"radius on the overmap."
msgstr ""
"Des lésions cérébrales focales vous ont rendu incapable de reconnaître les "
"points de repère et de vous orienter dans votre environnement, ce qui a "
"gravement endommagé votre rayon de vision sur la carte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cannibal"
msgstr "Cannibale"

#. ~ Description of mutation "Cannibal"
#: data/json/mutations/mutations.json
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr ""
"Toute votre vie on vous a privé de vous faire plaisir à cause de vos goûts "
"bizarres. Maintenant c'est la fin du monde et il serait incroyable que "
"quelqu'un vous dise que vous ne pouvez pas manger les gens."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strict Humanitarian"
msgstr ""

#. ~ Description of mutation "Strict Humanitarian"
#: data/json/mutations/mutations.json
msgid ""
"You're convinced that these things that look vaguely human from elsewhere "
"are definitely not people.  Therefore it's okay to eat them, right?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Psychopath"
msgstr "Psychopathe"

#. ~ Description of mutation "Psychopath"
#: data/json/mutations/mutations.json
msgid ""
"You don't experience guilt like others do.  Even when you know your actions "
"are wrong, you just don't care."
msgstr ""
"Vous ne connaissez pas la culpabilité. Même si vous savez que vos actions "
"sont néfastes, vous ne vous en souciez absolument pas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Killer Drive"
msgstr ""

#. ~ Description of mutation "Killer Drive"
#: data/json/mutations/mutations.json
msgid ""
"You derive enjoyment from killing things.  Putting end to life seem to spark"
" some dark satisfaction and thrill, and you crave it every moment."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Martial Arts Training"
msgstr "Entraîné aux arts martiaux"

#. ~ Description of mutation "Martial Arts Training"
#: data/json/mutations/mutations.json
msgid ""
"You have received some martial arts training at a local dojo.  You start "
"with your choice of Karate, Judo, Aikido, Tai Chi, Taekwondo, or Pankration."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Self-Defense Classes"
msgstr "Entraîné à l'auto-défense"

#. ~ Description of mutation "Self-Defense Classes"
#: data/json/mutations/mutations.json
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Boxing, Kickboxing, Capoeira, Krav Maga, Muay Thai, Ninjutsu,"
" Wing Chun, or Zui Quan."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shaolin Adept"
msgstr "Adepte Shaolin"

#. ~ Description of mutation "Shaolin Adept"
#: data/json/mutations/mutations.json
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr ""
"Vous avez étudié les arts des moines Shaolin. Vous démarrez avec l'un de ces"
" cinq styles de combats: Tigre, Grue, Léopard, Serpent ou Dragon."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Melee Weapon Training"
msgstr "Formé au combat rapproché"

#. ~ Description of mutation "Melee Weapon Training"
#: data/json/mutations/mutations.json
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Barbaran Montante, Bōjutsu, Eskrima, Fencing, Fior Di Battaglia, Medieval "
"Swordsmanship, Niten Ichi-Ryu, Pencak Silat, or Sōjutsu."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Competitive Fencer"
msgstr "Escrimeur professionnel"

#. ~ Description of mutation "Competitive Fencer"
#: data/json/mutations/mutations.json
msgid ""
"You were an avid fencer, starting with foil and moving onto saber, then "
"épée.  You competed nationally and dabbled with some of the historical "
"fencing weapons afforded by HEMA's popularity."
msgstr ""
"Vous étiez un(e) escrimeuse avide, commençant avec le fleuret et apprenant "
"le sabre et ensuite l'épée d'escrime. Vous étiez un(e) participant(e) dans "
"les compétitions d'escrime nationales et avez même un bon niveau de "
"connaissance avec les armes d'escrimes historiques que la popularité de "
"l'AMHE vous à permit d'utiliser."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Scent"
msgstr "Faible odeur"

#. ~ Description of mutation "Weak Scent"
#: data/json/mutations/mutations.json
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with "
"more difficulty."
msgstr ""
"Votre odeur est faible. Les animaux qui traquent votre odeur auront plus de "
"difficultés."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Skilled Liar"
msgstr "Bon menteur"

#. ~ Description of mutation "Skilled Liar"
#: data/json/mutations/mutations.json
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr ""
"Vous n'avez aucun scrupule à déformer la vérité. Mentir et bluffer sera plus"
" facile pour vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weight: XS"
msgstr "Embonpoint: XS"

#. ~ Description of mutation "Weight: XS"
#: data/json/mutations/mutations.json
msgid ""
"You lost an awful lot of weight before the Cataclysm.  Whatever the reason, "
"now that food is not always close at hand, your skeletal figure presents an "
"additional danger.  You need to gain weight or die trying."
msgstr ""
"Vous avez perdu(e) beaucoup de poids avant le Cataclysme. Peu importe quelle"
" était la raison, maintenant qu'un minimum de nourriture ne soit pas "
"toujours disponible pour vous garder en vie, votre corps squelettique "
"représente un danger additionnel. Vous avez besoin de gagner du poids ou "
"mourir en essayant."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weight: XXXL"
msgstr "Embonpoint: XXXL"

#. ~ Description of mutation "Weight: XXXL"
#: data/json/mutations/mutations.json
msgid ""
"You gained an awful lot of weight before the Cataclysm.  Whatever the "
"reason, now that mobility is key to survival, your bloated figure presents "
"an additional danger.  You need to lose weight or die trying."
msgstr ""
"Vous avez pris(e) beaucoup de poids avant le Cataclysme. Peu importe quelle "
"était la raison, maintenant que votre mobilité et une clé pour votre survie,"
" votre obésité représente un danger additionnel. Vous avez besoin de perdre "
"du poids ou mourir en essayant."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pretty"
msgstr "Beauté"

#. ~ Description of mutation "Pretty"
#: data/json/mutations/mutations.json
msgid ""
"You are a sight to behold.  People who care about such things will react "
"more kindly to you."
msgstr ""
"Vous êtes un spectacle à voir. Les PNJ qui se soucient de ce genre de choses"
" auront une meilleure impression de vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Knees"
msgstr "Genoux fragiles"

#. ~ Description of mutation "Bad Knees"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Une blessure ou votre âge avancé font que vos genoux ne sont plus aussi "
"forts et flexibles qu'avant. Les terrains accidentés vous ralentiront plus "
"encore."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stiff Knees"
msgstr "Genoux Raides"

#. ~ Description of mutation "Stiff Knees"
#: data/json/mutations/mutations.json
msgid ""
"Your knees never bend.  Period.  Stiff as a metal pole.  Pray that your "
"journey doesn't involve stairs or slightly uneven terrain."
msgstr ""
"Vos genoux sont pratiquement bloqués constamment droits, aussi rigides "
"qu'une barre en métal. Priez que vos voyages n'incluent pas des escaliers ou"
" même juste un sol légèrement irrégulier."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Knees"
msgstr "Genoux Solides"

#. ~ Description of mutation "Strong Knees"
#: data/json/mutations/mutations.json
msgid ""
"Your knees are strong and capable of angles that you couldn't imagine "
"previously.  Moving over rough terrain will slow you down less than normal."
msgstr ""
"Vos genoux sont solides et capable d'articulation à des angles que vous ne "
"pouviez pas imaginer les plier auparavant. Bouger à travers du terrain "
"difficile ou instable vous ralentit moins que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Languorous"
msgstr "Langoureux"

#. ~ Description of mutation "Languorous"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural "
"disinclination to physical endurance, you tire due to physical exertion much"
" more readily than others.  Your total cardio fitness and stamina are lower "
"than normal."
msgstr ""
"Dû à un manque d'exercice et une mauvaise alimentation, ou simplement un "
"déficit d'endurance congénital, vous vous fatiguez très vite après un effort"
" physique. Votre endurance maximale est réduite de 25%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Near-Sighted"
msgstr "Myope"

#. ~ Description of mutation "Near-Sighted"
#: data/json/mutations/mutations.json
msgid ""
"Without glasses, your seeing radius is severely reduced!  However, you are "
"guaranteed to start with a pair of glasses."
msgstr ""
"Sans lunettes, votre rayon de vision est sévèrement réduit! Cependant, vous "
"êtes assuré de commencer avec une paire de lunettes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Healer"
msgstr "Guérison lente"

#. ~ Description of mutation "Slow Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your wounds heal a little slower than most.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 75% of the regular rate."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poor Healer"
msgstr "Guérit mal"

#. ~ Description of mutation "Poor Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your health recovery is severely impaired.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 33% of the regular rate."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Imperceptive Healer"
msgstr "Guérit très mal"

#. ~ Description of mutation "Imperceptive Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Wounds are incredibly dangerous to you, as they barely heal at all.  Your HP"
" whilst asleep, as well as your broken limbs, heal at 10% of the regular "
"rate."
msgstr ""
"Toute blessure et extrêmement dangereuse pour vous, dû au fait que vous ne "
"guérissez pratiquement pas. Votre rythme de guérison pendant votre sommeil "
"et réduit à 10% du rythme de guérison de base."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Irreparable"
msgstr "Irréparable"

#. ~ Description of mutation "Irreparable"
#: data/json/mutations/mutations.json
msgid ""
"Whatever caused the end of the world affected you in a horrible way.  Your "
"wounds will never heal on their own and your broken limbs will never mend."
msgstr ""
"Le Cataclysme à provoquer quelque chose dans votre corp d'extrêmement "
"anormal, vos blessures ne guérissent plus et vos fractures ne se souderont "
"jamais."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Far-Sighted"
msgstr "Hypermétrope"

#. ~ Description of mutation "Far-Sighted"
#: data/json/mutations/mutations.json
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties"
" on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr ""
"Sans lunettes de lecture vous ne pouvez rien lire et souffrez de pénalités "
"sur la précision du combat en mêlée, la fabrication en électronique et la "
"couture. Toutefois vous débutez la partie avec une lunettes de lecture."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heavy Sleeper"
msgstr "Sommeil profond"

#. ~ Description of mutation "Heavy Sleeper"
#: data/json/mutations/mutations.json
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr "Vous dormez profondément. Les bruits vous réveilleront moins."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleepy"
msgstr "Gros dormeur"

#. ~ Description of mutation "Sleepy"
#: data/json/mutations/mutations.json
msgid "You need sleep more often, but still spend most of your time awake."
msgstr ""
"Vous avez besoin de plus de temps de sommeil, mais passez encore la plus "
"grande partie de votre temps éveillé(e)."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assassin Convict"
msgstr "Prisonnier Assassin"

#. ~ Description of mutation "Assassin Convict"
#: data/json/mutations/mutations.json
msgid ""
"You have a target to kill.  Search it, find it, and eliminate whatever it is"
" now."
msgstr ""
"Vous avez une cible à tuer. Cherchez et trouvez-la, et éliminer-la peut "
"importe ce qu'elle est maintenant devenue."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Asthmatic"
msgstr "Asthmatique"

#. ~ Description of mutation "Asthmatic"
#: data/json/mutations/mutations.json
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical"
" limitations.  However, you are guaranteed to start with an inhaler."
msgstr ""
"Vous aurez occasionnellement besoin d'utiliser un inhalateur sans quoi vous "
"souffrirez de limitations physiques importantes. Cependant il est garanti "
"que vous commenciez avec un inhalateur."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Back"
msgstr "Mal de dos"

#. ~ Description of mutation "Bad Back"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You simply cannot carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr ""
"Vous ne pouvez tout simplement pas porter autant que des personnes ayant la "
"même force. Votre poids maximum transporté est réduit de 35%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Temper"
msgstr "Mauvaise humeur"

#. ~ Description of mutation "Bad Temper"
#: data/json/mutations/mutations.json
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes "
"some doing to cheer you up."
msgstr ""
"Les choses ne font que vous rendre mausade. Vous êtes souvent mécontent, et "
"il faut se démener pour vous redonner le sourire."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disorganized"
msgstr "Désorganisé"

#. ~ Description of mutation "Disorganized"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are terrible at organizing and storing your possessions.  You retrieve "
"things from containers 10% slower."
msgstr ""
"Votre capacité d'organization laisse beaucoup à desirer. Votre volume "
"maximal de stockage est réduit de 40%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "Illiterate"
msgstr "Analphabète"

#. ~ Description of mutation "Illiterate"
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr ""
"Vous n'avez jamais appris à lire! Les livres et les ordinateurs vous sont "
"inaccessibles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poor Hearing"
msgstr "Troubles auditifs"

#. ~ Description of mutation "Poor Hearing"
#: data/json/mutations/mutations.json
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr ""
"Votre ouïe est pauvre et vous n'entendrez peut-être pas les bruits discrets "
"ou éloignés."

#. ~ Description of mutation "Deaf"
#: data/json/mutations/mutations.json
msgid ""
"You're not able to hear anything, and as such you're not able to talk to "
"NPCs."
msgstr ""
"Vous ne pouvez rien entendre, ce qui vous rends aussi incapable de parler "
"aux PNJs."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Learner"
msgstr "Apprentissage lent"

#. ~ Description of mutation "Slow Learner"
#: data/json/mutations/mutations.json
msgid ""
"You are slow to grasp new ideas, and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Vous mettez du temps à assimiler de nouveaux concepts et de ce fait apprenez"
" plus lentement que la moyenne. Cela n'impacte que votre apprentissage "
"pratique et votre apprentissage théorique reste normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insomniac"
msgstr "Insomniaque"

#. ~ Description of mutation "Insomniac"
#: data/json/mutations/mutations.json
msgid ""
"You have a hard time falling asleep, even under the best circumstances!"
msgstr ""
"Vous avez du mal à vous endormir, même dans les meilleures conditions!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Meat Intolerance"
msgstr "Intolérance à la viande"

#. ~ Description of mutation "Meat Intolerance"
#. ~ Description of mutation "Herbivorous Ancestry"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but "
"you will suffer morale penalties and obtain less nutrition from it."
msgstr ""
"Vous avez un blockage mental ou biologique qui vous empêche de consommer de "
"la viande. Vous pouvez toujours en ingérer mais la nausée que cela causera "
"fera beaucoup baisser votre moral."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thin-Skinned"
msgstr "Peau fine"

#. ~ Description of mutation "Thin-Skinned"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is fragile.  Cutting and bashing damage is slightly increased for "
"you."
msgstr ""
"Votre peau et fragile, et tout dégâts contendants ou coupants reçus seront "
"légèrement amplifiés."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hates Vegetables"
msgstr "Déteste les légumes"

#. ~ Description of mutation "Hates Vegetables"
#: data/json/mutations/mutations.json
msgid ""
"You have problems with eating vegetables.  It's possible for you to eat "
"them, but you will suffer morale penalties and obtain less nutrition from "
"them."
msgstr ""
"Vous avez un blockage mental ou biologique qui vous empêche de consommer des"
" végétaux. Vous pouvez toujours en ingérer mais la nausée que cela causera "
"fera beaucoup baisser votre moral."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "Hates Books"
msgstr "Déteste les livres"

#. ~ Description of mutation "Hates Books"
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid ""
"Reading is for nerds!  Boring books are more boring, and you can't have fun "
"by reading books."
msgstr ""
"La lecture est pour les nerds! Les livres ennuyeux sont plus ennuyeux et "
"vous ne pouvez pas vous amuser en les lisant des livres."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fructose Intolerance"
msgstr "Intolérance au Fructose"

#. ~ Description of mutation "Fructose Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"Eating fruits always causes your stomach to ache.  It's possible for you to "
"eat them, but you will suffer morale penalties and obtain less nutrition "
"from them."
msgstr ""
"Vous avez un blockage mental ou biologique qui vous empêche de consommer des"
" fruits. Vous pouvez toujours en ingérer mais la nausée que cela causera "
"fera beaucoup baisser votre moral."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lactose Intolerance"
msgstr "Intolérance au lactose"

#. ~ Description of mutation "Lactose Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"You, like 75 percent of the world, cannot tolerate milk or milk based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties and obtain less nutrition from them."
msgstr ""
"Comme 75% de la population mondiale, vous ne tolérez pas les produits "
"laitiers. Il vous est possible de les consommer. mais cela plombera votre "
"moral et vous en obtiendrez moins de nutrition que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Junkfood Intolerance"
msgstr "Intolérance à la malbouffe"

#. ~ Description of mutation "Junkfood Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties and "
"obtain less nutrition from them."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grain Intolerance"
msgstr "Intolérance aux grains"

#. ~ Description of mutation "Grain Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"You have a rare allergy that prevents you from eating wheat.  It's possible "
"for you to eat wheat-based products, but you will suffer morale penalties "
"and obtain less nutrition from them."
msgstr ""
"Vous avez une allergie rare vous empêchant de consommer des produits "
"contenant du gluten.  Il vous est possible de les consommer. mais cela "
"plombera votre moral et vous en obtiendrez moins de nutrition que la "
"normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sweet Tooth"
msgstr "Bec Sucré"

#. ~ Description of mutation "Sweet Tooth"
#: data/json/mutations/mutations.json
msgid ""
"You have a soft spot for processed foods, and gain a morale bonus from "
"eating them."
msgstr ""
"Vous avez un faible pour les aliments transformés et vous obtenez un "
"avantage moral en les consommant."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sugar-Loving"
msgstr "Adore le sucre"

#. ~ Description of mutation "Sugar-Loving"
#: data/json/mutations/mutations.json
msgid ""
"You *adore* the taste of junk food, and find it preferable to everything "
"else!"
msgstr ""
"Vous * adorez * le goût de la malbouffe et le trouvez préférable à tout le "
"reste!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Glass Jaw"
msgstr "Mâchoire de verre"

#. ~ Description of mutation "Glass Jaw"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual.  "
"Your apparent fragility makes you less intimidating."
msgstr ""
"Votre tête n'est pas capable de souffrir beaucoup de dégâts, et ses points "
"de vie sont réduits de 20%. Votre faiblesse est apparente et les animaux et "
"êtres humains sont moins intimidés par vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Forgetful"
msgstr "Mauvaise mémoire"

#. ~ Description of mutation "Forgetful"
#: data/json/mutations/mutations.json
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual."
msgstr ""
"Vous avez des difficultés à vous rappeler des choses. Vos compétences "
"s'éroderont légèrement plus rapidement que normalement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lightweight"
msgstr "Petit buveur"

#. ~ Description of mutation "Lightweight"
#: data/json/mutations/mutations.json
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects"
" of these for longer."
msgstr ""
"L'alcool et la drogue vous montent directement à la tête. Vous souffrez de "
"leurs effets négatifs plus longtemps."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Addictive Personality"
msgstr "Personnalité addictive"

#. ~ Description of mutation "Addictive Personality"
#: data/json/mutations/mutations.json
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr ""
"Vous devenez plus facilement dépendant aux substances et il vous est plus "
"difficile de vous sortir de ces dépendances."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Strong Scent"
msgstr "Forte odeur"

#. ~ Description of mutation "Strong Scent"
#: data/json/mutations/mutations.json
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but "
"animals that track your scent will do so more easily."
msgstr ""
"Votre odeur est particulièrement forte. Cela ne dérange pas les humains mais"
" les animaux qui vous traquent grâce à votre odeur le feront plus "
"facilement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chemical Imbalance"
msgstr "Déséquilibre chimique"

#. ~ Description of mutation "Chemical Imbalance"
#: data/json/mutations/mutations.json
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr ""
"Vous souffrez d'un déséquilibre chimique mineur, qu'il soit mental ou "
"physique. Des changements mineurs de votre chimie interne se manifesteront "
"parfois, comme la faim, le sommeil, les effets des narcotiques, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Animal Discord"
msgstr "Discorde animale"

#. ~ Description of mutation "Animal Discord"
#: data/json/mutations/mutations.json
msgid ""
"Most animals don't like you, and aggressive animals are more likely to "
"attack you.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"La plupart des animaux ne vous aprécient pas, et les plus aggressifs seront "
"plus susceptibles de s'en prendre à vous. Cela ne s'applique qu'aux animaux "
"sauvages tels que ceux des forêts."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prey Animal"
msgstr "Animal de proie"

#. ~ Description of mutation "Prey Animal"
#: data/json/mutations/mutations.json
msgid ""
"Natural animals like dogs and wolves see you as prey, and are liable to "
"attack you on sight."
msgstr ""
"Les animaux naturels comme les chiens et les loups vous considèrent comme "
"une proie et sont susceptibles de vous attaquer à vue."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Reader"
msgstr "Lecteur lent"

#. ~ Description of mutation "Slow Reader"
#: data/json/mutations/mutations.json
msgid ""
"You're a slow reader, and it takes you longer to get through books than "
"most."
msgstr ""
"Vous êtes un lecteur lent, et cela vous prend plus de temps que la majorité "
"pour finir un livre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Kaluptic Psychosis"
msgstr "Psychose Kaluptique"

#. ~ Description of mutation "Kaluptic Psychosis"
#: data/json/mutations/mutations.json
msgid ""
"Ever since the sky first broke, you have felt unwell, your head split by "
"alien thoughts.  You will periodically suffer from delusions, ranging from "
"minor effects to full visual hallucinations.  Some of these effects may be "
"controlled through the use of antipsychotics."
msgstr ""
"Depuis que le ciel s'est brisé pour la première fois, vous vous êtes "
"senti(e) mal, votre cerveau fragmenté par des pensées étranges. Vous "
"souffrez périodiquement de délires allant d'effets mineurs à des "
"hallucinations visuelles complètes. Certains des effets de votre condition "
"peuvent être traités avec l'utilisation de médicaments antipsychotiques."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Narcoleptic"
msgstr "Narcoleptique"

#. ~ Description of mutation "Narcoleptic"
#: data/json/mutations/mutations.json
msgid "You randomly fall asleep without any reason."
msgstr "Vous vous endormez au hasard sans aucune raison."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Clumsy"
msgstr "Maladroit"

#. ~ Description of mutation "Clumsy"
#. ~ Description of mutation "Giant Step"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You make more noise while walking.  You're also more likely to set off "
"traps."
msgstr ""
"Vous faites plus de bruit en marchant. Vous avez également plus de chances "
"de déclencher les pièges."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jittery"
msgstr "Nerveux"

#. ~ Description of mutation "Jittery"
#: data/json/mutations/mutations.json
msgid ""
"When very hungry or under the effects of stimulants, you may find your hands"
" shaking uncontrollably, severely reducing your Dexterity."
msgstr ""
"Lors de moments de grands stress ou de faim intolérable, ou sous l'effet de "
"stimulants, vos mains peuvent trembler de manière incontrôlable, ce qui "
"réduit considérablement votre dextérité."

#. ~ Description of mutation "Hoarder"
#: data/json/mutations/mutations.json
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored)."
"  Xanax can help control this anxiety."
msgstr ""
"Vous ne vous sentez pas bien si vous n'êtes pas chargé au maximum. Vous "
"souffrez de pénalités de moral si vous transportez moins que votre volume "
"maximum (le poids est ignoré). Le Xanax peut aider à contrôler cette "
"anxiété."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Savant"
msgstr "Savant"

#. ~ Description of mutation "Savant"
#: data/json/mutations/mutations.json
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr ""
"Vous avez tendance à vous spécialiser dans une compétence et à être médiocre"
" dans les autres. Vous progressez deux fois moins vite dans toutes vos "
"compétences excepté votre meilleure. Notez que combiner ce trait avec "
"Apprentissage rapide résultera en une vitesse d'apprentissage réduite pour "
"toutes les compétences."

#. ~ Description of mutation "Pacifist"
#: data/json/mutations/mutations.json
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr ""
"L'idée de la violence vous insupporte. Vos compétences de combat "
"augmenteront nettement moins vite, et vous ressentirez plus de culpabilité "
"en tuant."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mood Swings"
msgstr "Sautes d'humeur"

#. ~ Description of mutation "Mood Swings"
#: data/json/mutations/mutations.json
msgid "Your morale will shift up and down at random, often dramatically."
msgstr "Votre moral connaîtra des variations aléatoires, souvent radicales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Footed"
msgstr "Pieds lents"

#. ~ Description of mutation "Slow Footed"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr ""
"Vous vous déplacer plus lentement que la plupart des gens, résultant en une "
"pénalité de vitesse de 15% sur terrain plat."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Stomach"
msgstr "Estomac sensible"

#. ~ Description of mutation "Weak Stomach"
#: data/json/mutations/mutations.json
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr ""
"Vous êtes plus susceptible de vomir d'un empoisonnement alimentaire, à cause"
" de l'alcool, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wool Allergy"
msgstr "Allergique à la laine"

#. ~ Description of mutation "Wool Allergy"
#: data/json/mutations/mutations.json
msgid ""
"You are badly allergic to wool, and cannot wear any clothing made of the "
"substance."
msgstr ""
"Vous êtes fortement allergique à la laine et ne pouvez porter aucun vêtement"
" fabriqué à partir de cette substance."

#. ~ Description of mutation "Vegan"
#: data/json/mutations/mutations.json
msgid ""
"You're very strictly vegan, eating animal products is out of the question, "
"even if it means death.  You also can't bear to wear clothing made of animal"
" products, such as leather or fur."
msgstr ""
"Vous êtes strictement végétalien, manger des produits animaux est hors de "
"question, même si cela pourrait causer votre mort. Vous ne pouvez pas "
"supporter de porter quelque chose fabriqué à partir d'animaux non plus, "
"comme du cuir ou de la fourrure."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Truth Teller"
msgstr "Mauvais menteur"

#. ~ Description of mutation "Truth Teller"
#: data/json/mutations/mutations.json
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr ""
"Lorsque vous essayez de mentir, vous rougissez et bégayez et vos yeux sont "
"fuyants. Mentir et bluffer sera beaucoup plus difficile pour vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ugly"
msgstr "Laideur"

#. ~ Description of mutation "Ugly"
#: data/json/mutations/mutations.json
msgid ""
"You're not much to look at.  People who care about such things will react "
"poorly to you."
msgstr ""
"Vous n'êtes pas agréable à regarder. Les PNJ qui se soucient de ce genre de "
"choses auront une mauvaise impression de vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Albino"
msgstr "Albinos"

#. ~ Description of mutation "Albino"
#: data/json/mutations/mutations.json
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and sunglasses when going out in the "
"sun."
msgstr ""
"Vous manquez de pigmentation de la peau en raison d'un problème génétique. "
"Les coups de soleil sont extrêmement faciles et vous utilisez généralement "
"un parapluie et des lunettes lorsque vous sortez au soleil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Flimsy"
msgstr "Fragile"

#. ~ Description of mutation "Flimsy"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with "
"Glass Jaw."
msgstr ""
"Votre corps est plus fragile que la moyenne. Vos points de vie sont réduits "
"de 25%. Votre faiblesse est apparente et les animaux et êtres humains sont "
"moins intimidés par vous. Cet effet est cumulé avec la mutation Mâchoire de "
"Verre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Frail"
msgstr "Frêle"

#. ~ Description of mutation "Frail"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual.  Your"
" weakness is apparent and makes you less intimidating.  Stacks with Glass "
"Jaw."
msgstr ""
"Votre corps est très fragile. Vos points de vie sont réduits de 50%. Votre "
"faiblesse est apparente et les animaux et êtres humains sont moins intimidés"
" par vous. Cet effet est cumulé avec la mutation Mâchoire de Verre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fragile"
msgstr "Chétif"

#. ~ Description of mutation "Fragile"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with "
"Glass Jaw."
msgstr ""
"Votre corps est extrêmement fragile. Vos points de vie sont réduits de 75%. "
"Votre faiblesse est apparente et les animaux et êtres humains sont moins "
"intimidés par vous. Cet effet est cumulé avec la mutation Mâchoire de Verre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetic Downward Spiral"
msgstr "Spirale génétique descendente"

#. ~ Description of mutation "Genetic Downward Spiral"
#: data/json/mutations/mutations.json
msgid ""
"The events of the Cataclysm have damaged your DNA beyond repair.  You mutate"
" frequently, all mutations you receive (from any source) are negative, and "
"your instability is rapidly growing out of control."
msgstr ""
"Les événements du cataclysme ont endommagé votre ADN de manière irréparable."
" Vous mutez fréquemment et toutes les mutations que vous recevez (de "
"n'importe quelle source) sont négatives, et votre instabilité génétique est "
"en train de rapidement s’accélérer hors de contrôle."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jaundice"
msgstr "Jaunisse"

#. ~ Description of mutation "Jaundice"
#: data/json/mutations/mutations.json
msgid ""
"It's subtle, but your skin has definitely taken on a sickly yellow-green "
"hue."
msgstr ""
"C'est subtil, mais la couleur de votre peau a définitivement pris une "
"tournure jaune-verdâtre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Goosebumps"
msgstr "Chair de Poule"

#. ~ Description of mutation "Goosebumps"
#: data/json/mutations/mutations.json
msgid ""
"You have goosebumps that never seem to go away.  Are they getting bigger?"
msgstr ""
"Vous avez une chair de poule permanente, et vous jureriez que beaucoup de "
"vos poils hérissés sont devenus plus gros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rashy Skin"
msgstr "Peau Démangeante"

#. ~ Description of mutation "Rashy Skin"
#: data/json/mutations/mutations.json
msgid ""
"You've developed a persistent skin rash.  Sometimes it's fine, other times "
"it itches like hell."
msgstr ""
"De larges portions de votre peau sont couvertes d'un éruption cutanée "
"particulièrement persistante. Parfois tout va bien, et parfois cela vous "
"démange atrocement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hirsute"
msgstr "Peau Hirsute"

#. ~ Description of mutation "Hirsute"
#: data/json/mutations/mutations.json
msgid ""
"Your body hair is growing in thicker than it used to.  It's almost like "
"you're going through a second puberty or something."
msgstr ""
"Vous avez plus de pilosité que vous vous rappelez avoir eu(e). Vous avez "
"presque l'impression d'entrer dans une période de seconde puberté."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Peeling Skin"
msgstr "Peau Pelante"

#. ~ Description of mutation "Peeling Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin keeps peeling in big flakes, like you're recovering from a bad "
"sunburn.  Oddly, it doesn't hurt at all."
msgstr ""
"Votre peau n'arrête pas de peler en larges plaques comme si vous étiez en "
"train de guérir d'un coup de soleil particulièrement intense. Bizarrement, "
"ceci ne vous cause aucun inconfort."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smooth Skin"
msgstr "Peau Lisse"

#. ~ Description of mutation "Smooth Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has lost some of its color and taken on a smooth, papery texture."
"  This slightly reduces wet effects, but also makes you a little more "
"vulnerable to cuts and scrapes."
msgstr ""
"Votre peau à perdu de la couleur et sa texture s'est transformée en quelque "
"chose de lisse et papyracé. Ceci réduit un peu les effets négatifs de "
"l'humidité, mais vous rends un peu plus vulnérables aux coupures."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Night Vision"
msgstr "Vision nocturne"

#. ~ Description of mutation "High Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Vous voyez extrêmement bien dans l'obscurité! Activer pour basculer "
"l'affichage des zones nocturnes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Full Night Vision"
msgstr "Infravision"

#. ~ Description of mutation "Full Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Vous voyez dans l'obscurité comme si vous portiez des jumelles de vision "
"nocturne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Eyes"
msgstr "Yeux de céphalopode"

#. ~ Description of mutation "Cephalopod Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes still bulge, yet your pupils look different somehow.  Water "
"doesn't seem to cause any trouble at all, though."
msgstr ""
"Vos yeux continuent de gonfler, mais vos pupilles ont un aspect différent. "
"L'eau ne semble toutefois pas causer de problèmes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Man's Best Friend"
msgstr "Meilleur Ami de l'Homme"

#. ~ Description of mutation "Man's Best Friend"
#: data/json/mutations/mutations.json
msgid ""
"Man's oldest and most well known friends are all Lupines.  Somehow you've "
"mutated something that reminds other survivors of your more domestic "
"relatives.  A softer edge around the eyes, maybe."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Vision"
msgstr "Vision de céphalopode"

#. ~ Description of mutation "Cephalopod Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Votre cerveau a rattrapé vos yeux. Vous pouvez voir beaucoup mieux dans le "
"noir, mais la lumière du soleil semble beaucoup plus brillante maintenant. "
"Activer pour activer ou désactiver les zones visibles par la NV."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Eyes"
msgstr "Yeux extra-lucides"

#. ~ Description of mutation "Fey Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have turned… green.  It's tough to tell the exact shade, as it "
"seems to shift.  The effect is… pleasant."
msgstr ""
"Vos yeux sont devenus… verts. La teinte exacte semble varier. L'effet est..."
" plaisant à regarder."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Vision"
msgstr "Vision extra-lucide"

#. ~ Description of mutation "Fey Vision"
#: data/json/mutations/mutations.json
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr ""
"Les ombres ne semblent plus aussi sombre qu'avant. Activez la pour voir dans"
" les zones sombres."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Nightsight"
msgstr "Vue de nuit extra-lucide"

#. ~ Description of mutation "Fey Nightsight"
#: data/json/mutations/mutations.json
msgid ""
"You have great low-light vision now, but it doesn't allow you to perform "
"fine tasks such as crafting and reading in darkness.  Activate to toggle NV-"
"visible areas on or off."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Eyes"
msgstr "Yeux de félin"

#. ~ Description of mutation "Feline Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have mutated; now you have slit pupils, and they glitter in the "
"light, much like a cat's.  This is visually striking, but it isn't helping "
"you see at night."
msgstr ""
"Vos yeux ont mutés, vos pupilles se sont transformées en fentes, le tout "
"brillant dans le noir un peu comme ceux d'un chat. Ceci est à la fois "
"bizarre et attrayant, mais ne vous aide pas vraiment à voir mieux la nuit."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Vision"
msgstr "Vision féline"

#. ~ Description of mutation "Feline Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see "
"pretty well at night.  Activate to toggle NV-visible areas on or off."
msgstr ""
"Vos nerfs optiques et votre cerveau améliorent vos yeux. Vous voyez mieux la"
" nuit. Activez pour voir dans les zones sombres."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Vision"
msgstr "Vision Ursine"

#. ~ Description of mutation "Ursine Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"Vos pupilles sont fines. Vous voyez mieux dans le noir mais cela vous rend "
"myope à la lumière. Des lunettes pourraient aider. Activez pour voir dans "
"les zones sombres."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Avian Eyes"
msgstr "Yeux aviaires"

#. ~ Description of mutation "Avian Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr ""
"Votre vision est devenue particulièrement perçante. Vous soupçonnez que vous"
" puissiez détecter des zombies bien plus loin.  Perception +4."

#. ~ Description of mutation "Infrared Vision"
#: data/json/mutations/mutations.json
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr ""
"Vos yeux ont muté pour capter les radiations dans le spectre infrarouge."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Eyes"
msgstr "Yeux de reptile"

#. ~ Description of mutation "Reptilian Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect "
"your vision."
msgstr ""
"Vos yeux ont muté, avec un iris brillant et une pupille fendue semblable à "
"celle d'un lézard. C'est frappant visuellement, mais cela ne semble pas "
"affecter votre vision."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian IR"
msgstr "Infravision reptilienne"

#. ~ Description of mutation "Reptilian IR"
#: data/json/mutations/mutations.json
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, "
"allowing you to see in the infrared spectrum."
msgstr ""
"Vos nerfs optiques et votre cerveau ont muté pour rattraper vos yeux, vous "
"permettant de voir dans le spectre infrarouge."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Fast Healer"
msgstr "Guérison très rapide"

#. ~ Description of mutation "Very Fast Healer"
#: data/json/mutations/mutations.json
msgid "Your wounds and broken limbs heal very quickly."
msgstr "Votre blessures et fractures se rétablissent très rapidement."

#. ~ Mutation name
#. ~ Name of effect type id "flask_regeneration"
#: data/json/mutations/mutations.json data/mods/Magiclysm/effects/effects.json
msgid "Regeneration"
msgstr "Regénération"

#. ~ Description of mutation "Regeneration"
#: data/json/mutations/mutations.json
msgid "Your flesh regenerates and your limbs mend incredibly quickly."
msgstr ""
"Votre chair se regénère et vos membres se rétablissent à une vitesse "
"incroyable. "

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Healing"
msgstr "Guérison reptilienne"

#. ~ Description of mutation "Reptilian Healing"
#: data/json/mutations/mutations.json
msgid ""
"Your broken limbs mend themselves without significant difficulty in addition"
" to your already-quick healing.  You do not require splints for broken "
"limbs."
msgstr ""
"Vos membres cassés se ressoudent sans difficultés significatives en plus de "
"votre guérison déjà accélérée. Vous n'avez pas d'utiliser des attelles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Little Sleep"
msgstr "Très peu de sommeil"

#. ~ Description of mutation "Very Little Sleep"
#: data/json/mutations/mutations.json
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr ""
"Vous dormez rarement. Mais quand vous dormez, vous avez besoin de très peu "
"de sommeil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tireless"
msgstr "Infatigable"

#. ~ Description of mutation "Tireless"
#: data/json/mutations/mutations.json
msgid "You defend the realm all night and all day."
msgstr "Vous défendez le royaume jour et nuit."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fangs"
msgstr "Crocs"

#. ~ Description of mutation "Fangs"
#: data/json/mutations/mutations.json
msgid ""
"Your teeth have grown into two-inch-long fangs, allowing you to make an "
"extra attack when conditions favor it."
msgstr ""
"Vos canines sont devenues de longs crocs, vous permettant des attaques "
"supplémentaires quand la situation le permet."

#. ~ Message when player with mutation "Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You sink your fangs into %s!"
msgstr "Vos crocs s'enfoncent dans la chair du/de la %s!"

#. ~ Message when NPC with mutation "Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s sinks their fangs into %2$s!"
msgstr "%1$s enfonce ses crocs dans le/la %2$s!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Incisors"
msgstr "Incisives"

#. ~ Description of mutation "Incisors"
#: data/json/mutations/mutations.json
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr ""

#. ~ Message when player with mutation "Incisors" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite into %s with your ratlike incisors!"
msgstr "Vous mordez le/la %s avec vos incisives de rongeur!"

#. ~ Message when NPC with mutation "Incisors" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s with their ratlike incisors!"
msgstr "%1$s mord le/la %2$s avec ses incisives de rongeur!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nictitating Membrane"
msgstr "Membrane Nictitante"

#. ~ Description of mutation "Nictitating Membrane"
#: data/json/mutations/mutations.json
msgid ""
"You have a set of clear lenses which lower over your eyes while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr ""
"Vous avez une paire de lentilles translucides capables de couvrir vos yeux "
"lorsque vous êtes sous l'eau, vous permettant de voir comme si vous portiez "
"des lunettes de plongée. Réduits un peu les effets négatifs de l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Frog Eyes"
msgstr "Yeux de Grenouille"

#. ~ Description of mutation "Frog Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes bulge noticeably out of your face, and you are able to move them "
"much more freely than before.  You can see movement and close objects "
"clearly, but you have trouble picking up distant details in the light.  "
"Instead of eyelids they are covered by a translucent, protective membrane "
"that blocks irritants and water.  It allows you to sleep with your eyes "
"open!  Activate to cause the approach of hostile creatures to wake you up."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gills"
msgstr "Branchies"

#. ~ Description of mutation "Gills"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe "
"underwater.  Slightly increases wet benefits."
msgstr ""
"Vous avez des branchies au niveau du cou qui vous permettent de respirer "
"sous l'eau. Cela augmente légèrement les bénéfices en étant mouillé."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Gills"
msgstr "Branchies de Céphalopode"

#. ~ Description of mutation "Cephalopod Gills"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr ""
"Vous avez des branchie qui s'étalent de votre cou jusqu'à derrière vos "
"oreilles. Elles vous permettent de respirer sous l'eau et augmentent "
"légèrement les bénéfices en étant mouillé."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Flesh"
msgstr "Chair Mycellaire"

#. ~ Description of mutation "Mycus Flesh"
#: data/json/mutations/mutations.json
msgid ""
"We have begun adapting local physiology to Mycus physical structure, greatly"
" reducing wet effects."
msgstr ""
"Nous avons commencé à adapter la physiologie locale à la structure du Mycus,"
" réduisant grandement les effets néfastes de l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Fireproofing"
msgstr ""

#. ~ Description of mutation "Mycus Fireproofing"
#: data/json/mutations/mutations.json
msgid ""
"We have spliced the dense, amphibole fibers from Mycus core towers with the "
"resilient, adaptive flesh of local physiology.  This reduces our speed by a "
"moderate amount, but provides powerful armor across our body, nullifies wet "
"effects, and provides complete protection from fire."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycogenesis"
msgstr "Mycogenèse"

#. ~ Description of mutation "Mycogenesis"
#: data/json/mutations/mutations.json
msgid ""
"Local physiology has been fully incorporated with that of Mycus silicate "
"fibers.  In addition to benefits conferred by previous developments, we may "
"join with Mycus fibers beneath us - sleeping on top of fungal areas places "
"us into a dormant state, which spreads spores around us as we sleep and "
"revitalizes our body much more quickly than regular sleep."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sparse Scales"
msgstr "Écailles Parsemées"

#. ~ Description of mutation "Sparse Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has toughened and grown thin, flexible scales in some places, "
"acting as natural armor."
msgstr ""
"Votre peau s'est endurcie et des écailles éparses, fines et flexibles ont "
"commencées à pousser dessus, ceci vous servant d'armure naturelle, "
"principalement contre les coupures."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scales"
msgstr "Écailles"

#. ~ Description of mutation "Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has toughened further and your scales have grown to cover most of "
"your body.  Somewhat reduces wet effects."
msgstr ""
"Votre peau s'est encore plus endurcie et est maintenant plus ou moins "
"totalement couverte d'écailles. Réduit un peu les effets négatifs de "
"l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick Scales"
msgstr "Écailles épaisses"

#. ~ Description of mutation "Thick Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has grown thick and leathery and a set of heavy green scales has "
"grown to cover most of your body, acting as natural armor.  Further, bony "
"scutes cover your extremities, offering additional protection there.  While "
"difficult to penetrate, it also limits your flexibility.  Greatly reduces "
"wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleek Scales"
msgstr "Écailles lisses"

#. ~ Description of mutation "Sleek Scales"
#: data/json/mutations/mutations.json
msgid ""
"A set of very flexible and slick scales has grown to cover your toughened "
"skin.  These act as decent natural armor, improve your ability to swim, and "
"make you difficult to grab.  Mostly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Bones"
msgstr "Os légers"

#. ~ Description of mutation "Light Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt "
"a little more."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feathers"
msgstr "Plumes"

#. ~ Description of mutation "Feathers"
#: data/json/mutations/mutations.json
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Down"
msgstr "Duvet"

#. ~ Description of mutation "Down"
#: data/json/mutations/mutations.json
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lightly Furred"
msgstr "Légère fourrure"

#. ~ Description of mutation "Lightly Furred"
#: data/json/mutations/mutations.json
msgid ""
"Light fur has grown to cover your entire body, providing marginal protection"
" against attacks and slight protection from cold."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Furry"
msgstr "Fourrure"

#. ~ Description of mutation "Furry"
#: data/json/mutations/mutations.json
msgid ""
"Thick black fur has grown to cover your entire body, providing minor "
"protection against attacks, and considerable protection from cold."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shaggy Fur"
msgstr "Fourrure épaisse"

#. ~ Description of mutation "Shaggy Fur"
#. ~ Description of mutation "Wooly Fur"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"Your fur has grown out and thickened, providing great protection from "
"attacks as well as considerable insulation."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gray Fur"
msgstr "Fourrure grise"

#. ~ Description of mutation "Gray Fur"
#: data/json/mutations/mutations.json
msgid ""
"Dense gray fur has grown to cover your entire body, providing noticeable "
"protection against attacks, and considerable protection from cold."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleek Fur"
msgstr "Fourrure soyeuse"

#. ~ Description of mutation "Sleek Fur"
#: data/json/mutations/mutations.json
msgid ""
"You've grown sleek fur, providing minor protection against attacks, and some"
" protection from cold."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lynx Fur"
msgstr "Fourrure de lynx"

#. ~ Description of mutation "Lynx Fur"
#: data/json/mutations/mutations.json
msgid ""
"Your fur has grown out significantly around your cheeks and neck, providing "
"excellent protection from attacks."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jumbled Skin"
msgstr "Peau Chaotique"

#. ~ Description of mutation "Jumbled Skin"
#: data/json/mutations/mutations.json
msgid "Your skin has mutated into an amalgamation of fur and scales."
msgstr ""
"Votre peau s'est transformée en une amalgamation de fourrure et d'écailles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Patchwork Skin"
msgstr "Peau Mosaïque"

#. ~ Description of mutation "Patchwork Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has mutated into an amalgamation of thickened fur, scales, and "
"more."
msgstr ""
"Votre peau s'est transformée en une amalgamation de fourrure et d'écailles "
"épaisses, ainsi que d'autres choses moins discernables."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Patchwork Armor"
msgstr "Armure Mosaïque"

#. ~ Description of mutation "Patchwork Armor"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has warped into a highly protective but inconsistent medley of "
"chitin, scales, fur, bone, and even something close to Kevlar."
msgstr ""
"Votre peau a mutée en un mélange complexe et inconsistent de chitine, "
"d'écailles, de fourrure, de plaques ossifiées et meme d'un tissu analogue au"
" Kevlar."

#. ~ Description of mutation "Epicuticle"
#: data/json/mutations/mutations.json
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It "
"provides decent physical protection.  Slightly reduces wet effects."
msgstr ""
"Votre peau est maintenant une couche fine et flexible de chitine. Cette "
"nouvelle carapace vous protège assez bien. Vous êtes maintenant moins "
"affecté par les malus appliqués quand vous êtes humide."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Epicuticle (Molted)"
msgstr ""

#. ~ Description of mutation "Epicuticle (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  Newly "
"molted, it feels a little tender, but it's still tough and leathery."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chitin Carapace"
msgstr "Carapace en Chitine"

#. ~ Description of mutation "Chitin Carapace"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides"
" considerable physical protection, and make your punches hit a little "
"harder.  Somewhat reduces wet effects."
msgstr ""
"Vous êtes recouvert d'une couche de carapace en chitine, similaire a celle "
"protégeant un insecte. Être couvert d'un couche d’exosquelette vous rends "
"beaucoup plus resistant au dégâts, mais aussi rends vos coups de poing plus "
"forts. Vous êtes maintenant moins affecté par les malus appliqués quand vous"
" êtes humide. "

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chitin Carapace (Molted)"
msgstr ""

#. ~ Description of mutation "Chitin Carapace (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"You've recently molted, and your chitin exoskeleton is still soft and "
"vulnerable."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sclerotin Plate"
msgstr "Armure en plaques de Sclérotine"

#. ~ Description of mutation "Sclerotin Plate"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a sclerotin exoskeleton, akin to an organic suit of platemail."
"  It provides excellent physical protection and makes your punches hit "
"harder, but reduces your Dexterity by 1 and encumbers all body parts but "
"your eyes and mouth.  Greatly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sclerotin Plate (Molted)"
msgstr ""

#. ~ Description of mutation "Sclerotin Plate (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"Your exoskeleton bears thick plates of chitin which have not fully "
"sclerotized.  They won't provide good protection until they've had time to "
"harden."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crustacean Carapace"
msgstr ""

#. ~ Description of mutation "Crustacean Carapace"
#: data/json/mutations/mutations.json
msgid ""
"Your body is covered with a thick, near impenetrable, vividly-colored "
"carapace.  It provides unmatched physical protection and even some "
"protection from corrosive chemicals, but reduces your dexterity by 2 and "
"encumbers all body parts except your eyes.  Greatly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crustacean Carapace (Molted)"
msgstr ""

#. ~ Description of mutation "Crustacean Carapace (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"You're covered in a great chitin carapace which reduces your Dexterity by 1,"
" however it has recently molted and will offer poor protection until it has "
"time to harden.  Greatly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hairy Chitin"
msgstr "Chitine Poilue"

#. ~ Description of mutation "Hairy Chitin"
#: data/json/mutations/mutations.json
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Furred Chitin"
msgstr ""

#. ~ Description of mutation "Furred Chitin"
#: data/json/mutations/mutations.json
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Furred Plate"
msgstr ""

#. ~ Description of mutation "Furred Plate"
#: data/json/mutations/mutations.json
msgid ""
"Your thick exoskeleton boasts a fine coat of hairs that put feline whiskers "
"to shame."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Urticating Hairs"
msgstr "Poils Urticants"

#. ~ Description of mutation "Urticating Hairs"
#: data/json/mutations/mutations.json
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an"
" irritating spot; it doesn't carry your venom but it will be distracting."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Giant Pincer"
msgstr ""

#. ~ Description of mutation "Giant Pincer"
#: data/json/mutations/mutations.json
msgid ""
"Instead of your right hand, you now have a giant claw resembling ones found "
"on crabs.  It encumbers you greatly, but you can use it in melee combat to "
"deal massive damage."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spines"
msgstr "Épines"

#. ~ Description of mutation "Spines"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes"
" a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr ""
"Votre corps est recouvert de petites épines. Si vos ennemies vous touchent à"
" mains nues sur une partie de votre corps qui n'est pas couverte d'un "
"vêtement, ils recevront quelques dommages."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quills"
msgstr "Piquants"

#. ~ Description of mutation "Quills"
#: data/json/mutations/mutations.json
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive significant damage."
msgstr ""
"Votre corps est couvert de gros piquants. Chaque fois qu'un adversaire non "
"armé frappe une partie de votre corps qui n'est pas recouverte par un "
"vêtement, il subit des dommages importants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assault Barbs"
msgstr "Dards Projetables"

#. ~ Description of mutation "Assault Barbs"
#: data/json/mutations/mutations.json
msgid ""
"Some of the quills on your arms have become quite loose.  By flinging your "
"arms, you can fire off these quills as projectiles."
msgstr ""

#. ~ Message when firing ranged attack with mutation "Assault Barbs"
#: data/json/mutations/mutations.json
msgid "You fire off some of your quills."
msgstr "Vous expulsez quelque uns de vos piquants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Phelloderm"
msgstr "Phelloderme"

#. ~ Description of mutation "Phelloderm"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides armor and helps you retain moisture, resulting in less thirst.  "
"Greatly decreases wet penalties."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Protective Bark"
msgstr "Écorce Protectrice"

#. ~ Description of mutation "Protective Bark"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"powerful armor and makes you nearly waterproof."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Distributed)"
msgstr "Écorce Mouvante (Distribuée)"

#. ~ Description of mutation "Shifting Bark (Distributed)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently spread evenly."
"  Activate to better protect your torso, at the cost of other areas."
msgstr ""
"Votre écorce mouvante peut être adaptée en différentes configurations pour "
"vous protéger de différentes manières. Activez-la pour la consolider sur "
"votre torse au détriment d'autres sections de votre corps."

#. ~ Message when transforming from mutation  "Shifting Bark (Distributed)" to
#. "BARK2_b"
#. ~ Message when transforming from mutation  "Shifting Bark (Consolidated)"
#. to "BARK2_c"
#. ~ Message when transforming from mutation  "Shifting Bark (Latticed)" to
#. "BARK2_a"
#: data/json/mutations/mutations.json
msgid "Your bark ripples across your body, repositioning at a cellular level."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Consolidated)"
msgstr "Écorce Mouvante (Consolidée)"

#. ~ Description of mutation "Shifting Bark (Consolidated)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently consolidated "
"on your torso.  Activate to shift your bark into a lattice, increasing bulk "
"but providing better protection for the entire body."
msgstr ""
"Votre écorce mouvante peut être adaptée en différentes configurations pour "
"vous protéger de différentes manières. Activez-la pour la transformer en un "
"treillis de lamelles la rendant plus encombrante mais protégeant l'entièreté"
" de votre corps."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Latticed)"
msgstr "Écorce Mouvante (Laminée)"

#. ~ Description of mutation "Shifting Bark (Latticed)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently expanded into "
"a sturdy lattice.  Activate to collapse the lattice, returning to an evenly "
"distributed form."
msgstr ""
"Votre écorce mouvante peut être adaptée en différentes configurations pour "
"vous protéger de différentes manières. Activez-la pour réarranger le "
"treillis en une couche d'écorce plus fine et légère protégeant tout votre "
"corps."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thorns"
msgstr "Epines"

#. ~ Description of mutation "Thorns"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr ""
"Votre peau est couverte de petites épines en bois. Chaque fois qu'un "
"adversaire non armé frappe une partie de votre corps qui n'est pas "
"recouverte de vêtements, il subit des dommages mineurs. Vos coups de poing "
"peuvent également infliger des dégâts supplémentaires."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leaves"
msgstr "Feuilles"

#. ~ Description of mutation "Leaves"
#: data/json/mutations/mutations.json
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from"
" being physically striking, these provide you with a minor amount of "
"nutrients while in sunlight when your head is uncovered.  Slightly reduces "
"wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lush Leaves"
msgstr "Feuilles Luxuriantes"

#. ~ Description of mutation "Lush Leaves"
#: data/json/mutations/mutations.json
msgid ""
"Your leaves have grown in size and prominence, with additional leaves "
"sprouting along your arms.  While your arms and head are uncovered, you will"
" photosynthesize nutrients while in sunlight.  Reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Verdant Leaves"
msgstr "Feuilles Verdoyantes"

#. ~ Description of mutation "Verdant Leaves"
#: data/json/mutations/mutations.json
msgid ""
"Your leaves are vibrant, large, and green, and have become a major source of"
" nutrients for your body.  Whenever your arms and head are uncovered you "
"will gain a large amount of nutrients by standing in the sunlight.  Reduces "
"wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Transpiration"
msgstr "Transpiration"

#. ~ Description of mutation "Transpiration"
#: data/json/mutations/mutations.json
msgid ""
"You body has begun moving nutrients via the evaporation of water.  This "
"increases your thirst when it's hot, but reduces it when it's cold."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Flowering"
msgstr "Floraison"

#. ~ Description of mutation "Flowering"
#: data/json/mutations/mutations.json
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rosebuds"
msgstr "Boutons de Rose"

#. ~ Description of mutation "Rosebuds"
#: data/json/mutations/mutations.json
msgid ""
"The top of your head is blooming with rosebuds.  They're eye catching, and "
"have a strong fragrance that makes you pleasant to be around."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Spores"
msgstr "Spores de Mycus"

#. ~ Description of mutation "Mycus Spores"
#: data/json/mutations/mutations.json
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr ""
"Nous avons développés des sacs de spores locaux. Le Mycus doit prospérer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Sporogenesis"
msgstr "Sporogenèse Mycellaire"

#. ~ Description of mutation "Mycus Sporogenesis"
#: data/json/mutations/mutations.json
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local spore sacs remain quiescent, until local"
" guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Blossoms"
msgstr "Fleurs de Mycus"

#. ~ Description of mutation "Mycus Blossoms"
#: data/json/mutations/mutations.json
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr ""
"Nous avons développées des floraisons locales. Le Mycus doit prospérer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Bloom"
msgstr "Floraison de Mycus"

#. ~ Description of mutation "Mycus Bloom"
#: data/json/mutations/mutations.json
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Provenance"
msgstr "Provenance Mycellaire"

#. ~ Description of mutation "Mycus Provenance"
#: data/json/mutations/mutations.json
msgid ""
"Local spore sacs and blossoms have merged into a single, symbiotic form.  "
"Acting as one, they germinate together to cement rapid growth across a large"
" area according to local guidance.  The Mycus must grow."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Long Fingernails"
msgstr "Ongles longs"

#. ~ Description of mutation "Long Fingernails"
#: data/json/mutations/mutations.json
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Vos ongles sont longs et aiguisés. Si vous ne portez pas de gant, vos "
"attaques avec les poings infligeront un dommage mineur de coupe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Claws"
msgstr "Griffes"

#. ~ Description of mutation "Claws"
#: data/json/mutations/mutations.json
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Vous avez des griffes au bout des doigts. Si vous ne portez pas de gants, "
"vos attaques non armées infligent des dégâts de coupe minimes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gnarled Claws"
msgstr ""

#. ~ Description of mutation "Gnarled Claws"
#: data/json/mutations/mutations.json
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "Vos griffes sont devenues plus dures et légèrement noueuses."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stainless Claws"
msgstr "Griffes inox"

#. ~ Description of mutation "Stainless Claws"
#: data/json/mutations/mutations.json
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  "
"They might as well be made of stainless steel."
msgstr ""
"Vos pattes sont des os, des muscles et des griffes avec une fine couche de "
"peau et de fourrure. Ils pourraient aussi bien être en acier inoxydable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Retractable Claws"
msgstr "Griffes rétractables"

#. ~ Description of mutation "Retractable Claws"
#: data/json/mutations/mutations.json
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them "
"as desired.  Gloves will still get in the way, though."
msgstr ""
"Vous avez des griffes au bout des doigts que vous pouvez étendre ou "
"rétracter à votre guise. Les gants continueront cependant à gêner."

#. ~ Message when transforming from mutation  "Retractable Claws" to
#. "CLAWS_RETRACT_active"
#: data/json/mutations/mutations.json
msgid "You extend your claws."
msgstr "Vous étendez vos griffes!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extended Claws"
msgstr "Griffes Sorties"

#. ~ Description of mutation "Extended Claws"
#: data/json/mutations/mutations.json
msgid "Sharp claws are extending from the end of your fingers."
msgstr ""

#. ~ Message when transforming from mutation  "Extended Claws" to
#. "CLAWS_RETRACT"
#: data/json/mutations/mutations.json
msgid "You retract your claws."
msgstr "Vous rétractez vos griffes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Rakes"
msgstr "Rateaux tentacules"

#. ~ Description of mutation "Tentacle Rakes"
#: data/json/mutations/mutations.json
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr ""
"Vos tentacules supérieurs ont pris de l'ampleur, avec des râteaux aux "
"extrémités munis de crochets. Ils sont assez vicieux, mais ne conviennent "
"vraiment pas pour une manipulation fine."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ink Glands"
msgstr "Poches du Noir"

#. ~ Description of mutation "Ink Glands"
#: data/json/mutations/mutations.json
msgid ""
"Several ink glands have grown onto your torso.  They can be used to spray "
"defensive ink and blind an attacker in an emergency, as long as the torso "
"isn't covered."
msgstr ""

#. ~ Description of mutation "Slime Spray"
#: data/json/mutations/mutations.json
msgid ""
"You exude slime from your pores.  You can spread that slime on an opponent "
"in melee range."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bulging Reservoir"
msgstr "Réservoir Gonflé"

#. ~ Description of mutation "Bulging Reservoir"
#: data/json/mutations/mutations.json
msgid ""
"You develop a reservoir of fluids that bulges out of your abdomen.  Your "
"body has adapted to containing extra liquids in event of shortfalls."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bombadier Beetle Blast"
msgstr ""

#. ~ Description of mutation "Bombadier Beetle Blast"
#: data/json/mutations/mutations.json
msgid ""
"You have an ability to spray boiling water on your enemies at melee "
"distance.  This will drastically increase your thirst.  Without an extra "
"reservoir you would quickly dehydrate yourself."
msgstr ""

#. ~ Message when player with mutation "Bombadier Beetle Blast" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You spray %s with a boiling chemical mixture!"
msgstr ""

#. ~ Message when NPC with mutation "Bombadier Beetle Blast" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s sprays %2$s with a boiling chemical mixture!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Large Talons"
msgstr "Grandes serres"

#. ~ Description of mutation "Large Talons"
#. ~ Description of mutation "Demon Claws"
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, "
"you find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent wearing gloves."
msgstr ""
"Vos index sont devenus d'énormes serres. Après un peu de pratique, vous "
"constatez que cela n’affecte pas votre dextérité, mais permet une attaque "
"mortelle sans arme. Ils empêchent également de porter des gants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radiogenic"
msgstr "Radiogénique"

#. ~ Description of mutation "Radiogenic"
#: data/json/mutations/mutations.json
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr ""
"Votre système s'est adapté aux radiations. Les radiations sont converties en"
" points de vie, vous soignant lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radiophile"
msgstr "Radiophile"

#. ~ Description of mutation "Radiophile"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh has developed a unique reaction to radiation that lets you sense "
"when ambient radiation is abnormally high.  Turn off to ignore messages."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Carrier"
msgstr "Porteur de Marloss"

#. ~ Description of mutation "Marloss Carrier"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and… sap?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Vessel"
msgstr ""

#. ~ Description of mutation "Marloss Vessel"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and… sap?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Vector"
msgstr "vecteur de Marloss"

#. ~ Description of mutation "Marloss Vector"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and "
"you have a strong desire to eat some seeds and berries."
msgstr ""
"Depuis que vous avez mangé cette gelée de Marloss, vous ne pouvez pas vous "
"arrêter de penser à cela et vous avez un fort désir de manger des graines et"
" des baies."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Rejection"
msgstr "réjection de Marloss"

#. ~ Description of mutation "Marloss Rejection"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr ""
"Depuis que vous avez eu cette réaction mortelle face à cette camelote de "
"Marloss, vous ne pouvez supporter l'idée de la manger à nouveau!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mutagenic Aversion"
msgstr "Aversion mutagène"

#. ~ Description of mutation "Mutagenic Aversion"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr ""
"Depuis que vous avez eu cette réaction mortelle face à ces substances "
"mutagènes et purifiantes, vous ne pouvez plus supporter l'idée de les "
"utiliser à nouveau!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Pheromones"
msgstr "Phéromones d'insectes"

#. ~ Description of mutation "Insect Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of insects.  Insects will attack you much less."
msgstr ""
"Votre corps produit des phéromones de bas niveau, vous identifiant comme un "
"ami de nombreuses espèces d'insectes. Les insectes vous attaqueront beaucoup"
" moins."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amphibian Pheromones"
msgstr "Phéromones Amphibiennes"

#. ~ Description of mutation "Amphibian Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of amphibian.  Amphibians will attack you much less."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mammal Pheromones"
msgstr "Phéromones de mammifères"

#. ~ Description of mutation "Mammal Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones which put mammals at ease.  They "
"will be less likely to attack or flee from you."
msgstr ""
"Votre corps produit des phéromones de bas niveau qui mettent les mammifères "
"à l'aise. Ils seront moins susceptibles de vous attaquer ou de vous fuir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disease Immune"
msgstr "Immunité aux maladies"

#. ~ Description of mutation "Disease Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr ""
"Vous êtes tout simplement immunisé contre les maladies. Vous n'attraperez "
"jamais de maladie ambiante."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Infection Resistant"
msgstr "Résistance aux infections"

#. ~ Description of mutation "Infection Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Your immune system is particularly good at resisting infections.  You have "
"an increased chance for bad wounds and infections to heal on their own, and "
"only suffer reduced penalties from them."
msgstr ""
"Votre système immunitaire résiste particulièrement bien aux infections. Vous"
" avez une chance accrue pour que les blessures graves et les infections "
"guérissent d'elles-mêmes et ne subissez que des peines réduites."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Infection Immune"
msgstr "Immunité aux Infections"

#. ~ Description of mutation "Infection Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will "
"never become infected."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Identity"
msgstr "Identité Mycelienne"

#. ~ Description of mutation "Mycus Identity"
#: data/json/mutations/mutations.json
msgid ""
"We have synchronized our local physiology with that of the Mycus.  Any "
"spores we may encounter will not attempt to germinate inside the local "
"system, and we may traverse Mycus biospheres easily, as native bioforms "
"shift shape to accommodate us."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Parasite Immune"
msgstr "Immunité aux Parasites"

#. ~ Description of mutation "Parasite Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Venomous"
msgstr "Venin"

#. ~ Description of mutation "Venomous"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr ""
"Votre corps produit un venin puissant. Les attaques coupantes ou "
"poignardages provenant de mutations ont une chance d'empoisonner votre "
"cible."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strongly Venomous"
msgstr "Venin puissant"

#. ~ Description of mutation "Strongly Venomous"
#: data/json/mutations/mutations.json
msgid ""
"Your venom has become particularly strong.  You're confident that your bites"
" or other cutting/stabbing natural attacks will take your target down "
"quickly."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slime Hands"
msgstr "Mains Muqueuses"

#. ~ Description of mutation "Slime Hands"
#: data/json/mutations/mutations.json
msgid ""
"The skin on your hands is now a mucous membrane that produces a thick, acrid"
" slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr ""
"La peau de vos mains s'est transformée en une membrane muqueuse produisant "
"des excrétions épaisses et âcres. Des attaques utilisant vos mains "
"découvertes produiront des dégâts acides mineurs. Améliore légèrement les "
"bénéfices d'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stretchy Limbs"
msgstr "Membres Élastiques"

#. ~ Description of mutation "Stretchy Limbs"
#: data/json/mutations/mutations.json
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr ""
"Vos membres sont plus souples et élastiques que la normale, vous donnant un "
"+1 à votre Dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rubbery Limbs"
msgstr "Membres en Caoutchouc"

#. ~ Description of mutation "Rubbery Limbs"
#: data/json/mutations/mutations.json
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr ""
"Vous membres sont beaucoup plus souples et élastique que ceux d'un humain "
"pathétique, vous donnant un +3 à votre Dextérité et un -2 à votre Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pseudolimbs"
msgstr "Pseudopodes"

#. ~ Description of mutation "Pseudolimbs"
#: data/json/mutations/mutations.json
msgid ""
"Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."
msgstr ""
"Vos membres ressemblent maintenant à des pseudopodes et peuvent se déformer "
"à volonté, vous donnant un +4 à votre Dextérité et un -4 à votre Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Muscle Consolidation"
msgstr "Consolidation Musculaire"

#. ~ Description of mutation "Muscle Consolidation"
#: data/json/mutations/mutations.json
msgid ""
"Your extremities have gained strength but lost fine motor skills.  -1 "
"Dexterity +2 Strength."
msgstr ""
"Vos extrémités ont gagnées en force mais perdu en motricité fine, vous "
"donnant un +2 à votre Force et un -1 à votre Dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rasping Tongue"
msgstr "Langue Râpeuse"

#. ~ Description of mutation "Rasping Tongue"
#: data/json/mutations/mutations.json
msgid ""
"You've developed an extremely long and mobile tongue capped with teeth.  You"
" may use it to attack your enemies and pull them towards you."
msgstr ""
"Votre langue a mutée en un appendice extrêmement long et mobile doté de "
"structures ressemblant à des dents, vous donnant la possibilité de "
"l'utiliser comme un grappin pour tirer vos ennemis vers vous."

#. ~ Message when player with mutation "Rasping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your rasping tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Rasping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their rasping tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Harpoon Tongue"
msgstr "Langue Harpon"

#. ~ Description of mutation "Harpoon Tongue"
#: data/json/mutations/mutations.json
msgid ""
"Your tongue has increased its length and mobility.  You may use it to pull "
"your enemies towards you."
msgstr ""

#. ~ Message when player with mutation "Harpoon Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You stab into %s with your harpoon tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Harpoon Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stabs into %2$s with their harpoon tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Compound Eyes"
msgstr "Yeux composés"

#. ~ Description of mutation "Compound Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"Perception by 2 whenever you aren't wearing eyewear."
msgstr ""
"Vos yeux ont des facettes, comme celles d'un insecte, vous donnant un +2 à "
"votre perception, mais uniquement si vous ne portez rien sur vos yeux."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Padded Feet"
msgstr "Pieds capitonnés"

#. ~ Description of mutation "Padded Feet"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and even receive a 10% bonus when moving "
"barefoot.  Also, your steps are significantly quieter, as added tissue "
"dampens the noise."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Legs"
msgstr ""

#. ~ Description of mutation "Strong Legs"
#: data/json/mutations/mutations.json
msgid "Your legs have gained muscle mass to propel you across any terrain."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Digitigrade Legs"
msgstr ""

#. ~ Description of mutation "Digitigrade Legs"
#: data/json/mutations/mutations.json
msgid ""
"The heels of your feet have shifted up off the ground in a rather "
"animalistic fashion, reducing your carry weight limit and preventing you "
"from wearing shoes.  These hind feet are a bad match for human arms, but "
"could pair well with matching forepaws."
msgstr ""

#. ~ Trigger message of mutation "Digitigrade Legs"
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid "You drop down on all fours."
msgstr "Vous vous mettez à quatre pattes."

#. ~ Trigger message of mutation "Digitigrade Legs"
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid "You rise up to walk on your hind feet."
msgstr "Vous vous levez pour marcher sur vos pattes arrières."

#. ~ Description of mutation "Pounce"
#: data/json/mutations/mutations.json
msgid ""
"You've gained a strong ability to leap a short distance from a standing "
"position with little preparation time."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leaping Legs"
msgstr ""

#. ~ Description of mutation "Leaping Legs"
#: data/json/mutations/mutations.json
msgid "You've gained a strong ability to leap from a standing position."
msgstr ""

#. ~ Description of mutation "Crushing Leap"
#: data/json/mutations/mutations.json
msgid ""
"You've gained a strong ability to leap a significant distance from a "
"standing position and crush whatever you land on."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toe Talons"
msgstr "Orteils Serres"

#. ~ Description of mutation "Toe Talons"
#: data/json/mutations/mutations.json
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big"
" toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent wearing footgear."
msgstr ""

#. ~ Message when player with mutation "Toe Talons" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You slash %s with one of your talons!"
msgstr ""

#. ~ Message when NPC with mutation "Toe Talons" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s slashes %2$s with one of their talons!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Avian Legs"
msgstr "Jambes Aviaires"

#. ~ Description of mutation "Avian Legs"
#: data/json/mutations/mutations.json
msgid ""
"Your legs and feet have become bird-like.  Instead of toes you now have "
"three long talons at the front and one at the back, ending in wicked claws "
"and preventing you from wearing shoes.  Fortunately they don't impede your "
"movement."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hooves"
msgstr "Sabots"

#. ~ Description of mutation "Hooves"
#: data/json/mutations/mutations.json
msgid ""
"Your feet have fused into hooves.  This allows you to perform a powerful "
"kicking attack, provides natural armor, and removes the need to wear shoes; "
"however, you cannot wear normal shoes.  Reduces wet effects."
msgstr ""

#. ~ Message when player with mutation "Hooves" attacks
#. ~ Message when player with mutation "Demon Hooves" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
#, c-format
msgid "You kick %s with your hooves!"
msgstr ""

#. ~ Message when NPC with mutation "Hooves" attacks
#. ~ Message when NPC with mutation "Demon Hooves" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
#, c-format
msgid "%1$s kicks %2$s with their hooves!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Alcohol Metabolism"
msgstr "Métabolisation Alcoolique"

#. ~ Description of mutation "Alcohol Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed "
"the ability to metabolize alcohol as a food source."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean Fortitude"
msgstr "Fortitude Souterraine"

#. ~ Description of mutation "Subterranean Fortitude"
#: data/json/mutations/mutations.json
msgid "The aches and pains of living underground don't bother you as much."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean Build"
msgstr "Carrure Souterraine"

#. ~ Description of mutation "Subterranean Build"
#: data/json/mutations/mutations.json
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading mobility for muscle mass.  (+2 Strength, -2 "
"Dexterity)"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saprovore"
msgstr "Saprophyte"

#. ~ Description of mutation "Saprovore"
#: data/json/mutations/mutations.json
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr ""
"Votre système digestif est spécialisé pour vous permettre de consommer des "
"matériaux en décomposition. Vous pouvez manger la nourriture avariée pour "
"une nutrition plus faible qu'ordinaire."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saprophage"
msgstr "Saprophage"

#. ~ Description of mutation "Saprophage"
#: data/json/mutations/mutations.json
msgid ""
"You prefer to sustain your nutritional needs using your roots and direct "
"nutrient extraction/synthesis.  Your human parts still need the raw caloric "
"bulk of 'food' to keep them going, though, and you handle it a lot easier if"
" it's had time to… age a little."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gizzard"
msgstr "Gésier"

#. ~ Description of mutation "Gizzard"
#: data/json/mutations/mutations.json
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Feeder"
msgstr ""

#. ~ Description of mutation "Mycus Feeder"
#: data/json/mutations/mutations.json
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us.  We may locate sources of sustenance in "
"close proximity to Mycus core towers, and in forested areas that the Mycus "
"has grown into."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ruminant"
msgstr "Ruminant"

#. ~ Description of mutation "Ruminant"
#: data/json/mutations/mutations.json
msgid ""
"Your digestive system is capable of digesting cellulose and other rough "
"plant material.  You can eat underbrush and shrubs by activating this, "
"standing over your target, and pressing E."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grazer"
msgstr "Brouteur"

#. ~ Description of mutation "Grazer"
#: data/json/mutations/mutations.json
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from "
"grass as well as underbrush and shrubs.  Eat either one by activating this, "
"standing over your target, and pressing E."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Intestinal Fortitude"
msgstr "Fortitude Intestinale"

#. ~ Description of mutation "Intestinal Fortitude"
#: data/json/mutations/mutations.json
msgid ""
"Your guts have developed the ability to handle the toxic elements of mutated"
" flesh.  Mostly."
msgstr ""
"Votre système digestif s'est adapté à isoler et neutraliser la plupart des "
"toxines présentes dans la viande issue de mutants, rendant ce genre de repas"
" beaucoup moins toxique pour vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Eater Of The Dead"
msgstr "Mangeur de morts"

#. ~ Description of mutation "Eater Of The Dead"
#: data/json/mutations/mutations.json
msgid ""
"Your digestion has evolved further.  In addition to mutated meat, you can "
"also stomach the tainted and long-dead flesh of zombies… if you can stand "
"the taste, of course."
msgstr ""
"Votre système digestif s'est amélioré encore plus, la chair de mutant n'est "
"dorénavant plus un problème pour vous et votre estomac en acier est même "
"capable de digérer la chair putréfiée de zombies... cela ne changeant pas le"
" fait qu'elle reste répugnante."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Burrowing"
msgstr "Fouisseur"

#. ~ Description of mutation "Burrowing"
#: data/json/mutations/mutations.json
msgid ""
"Your dextrous paws and long teeth allow you to dig through dirt and rubble "
"with ease."
msgstr ""

#. ~ Description of mutation "Burrowing"
#: data/json/mutations/mutations.json
msgid "Your tough paws allow you to dig through dirt and rubble with ease."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saber Teeth"
msgstr "Dents de Sabre"

#. ~ Description of mutation "Saber Teeth"
#: data/json/mutations/mutations.json
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat… but leave nasty wounds "
"when you bite."
msgstr ""

#. ~ Message when player with mutation "Saber Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your saber teeth!"
msgstr ""

#. ~ Message when NPC with mutation "Saber Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their saber teeth!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyper-Metabolism"
msgstr "Hypermétabolisme"

#. ~ Description of mutation "Hyper-Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"Your particular metabolism allows you to burn calories at a prodigious rate "
"to regenerate tissues in a matter of minutes; this is, however, a very "
"wasteful process.  Activate to start healing."
msgstr ""

#. ~ Message when transforming from mutation  "Hyper-Metabolism" to
#. "EATHEALTH_active"
#: data/json/mutations/mutations.json
msgid "Your hyper-metabolism starts burning up calories."
msgstr "Votre hypermétabolisme commence à brûler des calories."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyper-Metabolism: burning"
msgstr "Hypermétabolisme: activé"

#. ~ Description of mutation "Hyper-Metabolism: burning"
#: data/json/mutations/mutations.json
msgid "You're burning calories like crazy to heal your wounds."
msgstr ""
"Vous êtes en train de brûler des calories à un rythme effréné pour soigner "
"vos blessures."

#. ~ Message when transforming from mutation  "Hyper-Metabolism: burning" to
#. "EATHEALTH"
#: data/json/mutations/mutations.json
msgid "Your hyper-metabolism slows down."
msgstr "Votre hypermétabolisme ralentit."

#. ~ Mutation name
#. ~ Mutation class name
#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
msgid "Horns"
msgstr "Cornes"

#. ~ Description of mutation "Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack, but prevent the use of most rigid headwear."
msgstr ""

#. ~ Message when player with mutation "Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You headbutt %s with your horns!"
msgstr ""

#. ~ Message when NPC with mutation "Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s headbutts %2$s with their horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Curled Horns"
msgstr "Cornes bouclées"

#. ~ Description of mutation "Curled Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent wearing any headwear."
msgstr ""

#. ~ Message when player with mutation "Curled Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You headbutt %s with your curled horns!"
msgstr ""

#. ~ Message when NPC with mutation "Curled Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s headbutts %2$s with their curled horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pointed Horns"
msgstr "Cornes Pointues"

#. ~ Description of mutation "Pointed Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent wearing "
"headwear that is not made of fabric."
msgstr ""

#. ~ Message when player with mutation "Pointed Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You stab %s with your pointed horns!"
msgstr ""

#. ~ Message when NPC with mutation "Pointed Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stabs %2$s with their pointed horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antlers"
msgstr "Ramure"

#. ~ Description of mutation "Antlers"
#: data/json/mutations/mutations.json
msgid ""
"You have a huge rack of antlers, like those of a moose.  They allow you to "
"make a weak headbutt attack, but prevent wearing headwear that is not made "
"of fabric."
msgstr ""

#. ~ Message when player with mutation "Antlers" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You butt %s with your antlers!"
msgstr ""

#. ~ Message when NPC with mutation "Antlers" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s butts %2$s with their antlers!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antennae"
msgstr "Antennes"

#. ~ Description of mutation "Antennae"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent wearing headwear that is not made of fabric."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Road-Runner"
msgstr "Coureur de route"

#. ~ Description of mutation "Road-Runner"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat"
" surfaces."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stubby Tail"
msgstr "Queue Tronquée"

#. ~ Description of mutation "Stubby Tail"
#: data/json/mutations/mutations.json
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr ""
"Vous possédez une toute petite queue similaire à celle d'un lapin et n'ayant"
" aucun effet."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tail Fin"
msgstr "Nageoire Caudale"

#. ~ Description of mutation "Tail Fin"
#: data/json/mutations/mutations.json
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr ""
"Vous avez une queue munie d'une nagoire vous permettant de nager plus vite, "
"mais vous empêche d'enfiler des vêtements rigides sur la partie inférieure "
"de votre corps. Augmente légèrement les bonus d'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Long Tail"
msgstr "Longue Queue"

#. ~ Description of mutation "Long Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-"
"fabric pants."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cattle Tail"
msgstr "Queue Bovine"

#. ~ Description of mutation "Cattle Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail with a tuft on the end.  You find yourself "
"instinctively swatting away flies with it, though it's not as effective at "
"balancing you as you'd like.  Prevents wearing non-fabric pants."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Tail"
msgstr "Queue de Rongeur"

#. ~ Description of mutation "Rodent Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick Tail"
msgstr "Queue Épaisse"

#. ~ Description of mutation "Thick Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but "
"also makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr ""

#. ~ Message when player with mutation "Thick Tail" attacks
#. ~ Message when player with mutation "Short Dragon Tail" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You whap %s with your tail!"
msgstr ""

#. ~ Message when NPC with mutation "Thick Tail" attacks
#. ~ Message when NPC with mutation "Short Dragon Tail" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s whaps %2$s with their tail!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dromeosaur Muzzle"
msgstr "Gueule de Droméosaure"

#. ~ Description of mutation "Dromeosaur Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face has drastically mutated, with the bones of your jaws having "
"extended forth into a long, tapered snout.  The palate of your mouth is "
"considerably vaulted, with curved, serrated teeth lining your saurian maw "
"and reptilian scales covering your muzzle’s exterior.  While paleobiology "
"has evidently not evolved with mouth gear in mind (making such items "
"unwearable), the bite wounds you can now inflict promise the ferocity of "
"long-dead beasts."
msgstr ""

#. ~ Message when player with mutation "Dromeosaur Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You dart your head and snap at %s!"
msgstr ""

#. ~ Message when NPC with mutation "Dromeosaur Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s darts their head and snaps at %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Raptor Tail"
msgstr "Queue de Raptor"

#. ~ Description of mutation "Raptor Tail"
#: data/json/mutations/mutations.json
msgid ""
"Formed from a network of interlocking bones, a long tail has mutated from "
"the base of your spine, with ossified tendons assisting in keeping the limb "
"stiff and rigid.  A plume of lengthy feathers sprouts from the reptilian "
"flesh along your new tail, drawing the eye.  While it is useless in combat "
"and prevents you from wearing non-fabric pants, you find it’s pretty handy "
"for maintaining your balance."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fluffy Tail"
msgstr "Queue Touffue"

#. ~ Description of mutation "Fluffy Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric "
"pants."
msgstr ""
"Vous avez une longue queue à poils duveteux. Elle améliore grandement votre "
"équilibre, rendant votre capacité d'esquive beaucoup plus élevée. Empêche de"
" porter des pantalons non tissés."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spiked Tail"
msgstr "Queue Épineuse"

#. ~ Description of mutation "Spiked Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail that ends in a vicious stinger.  It does not improve "
"your balance at all, but allows for a powerful piercing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""

#. ~ Message when player with mutation "Spiked Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You sting %s with your tail!"
msgstr ""

#. ~ Message when NPC with mutation "Spiked Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stings %2$s with their tail!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Club Tail"
msgstr "Massue Caudale"

#. ~ Description of mutation "Club Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""

#. ~ Message when player with mutation "Club Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You club %s with your tail!"
msgstr "Vous frappez %s avec votre queue!"

#. ~ Message when NPC with mutation "Club Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s clubs %2$s with their tail!"
msgstr "%1$s frappe %2$s avec sa queue!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hibernation"
msgstr "Hibernation"

#. ~ Description of mutation "Hibernation"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr ""
"Vous avez développé la capacité d’emmagasiner des calories pour ensuite "
"ralentir votre métabolisme pour dormir à travers les temps maigres."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Resilient"
msgstr "Tenace"

#. ~ Description of mutation "Resilient"
#. ~ Description of mutation "Immovable"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus"
" to all hit points.  Stacks with Tough, etc."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solidly Built"
msgstr "Solidement Bâti"

#. ~ Description of mutation "Solidly Built"
#. ~ Description of mutation "Unstoppable"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "TAAANK"
msgstr "TAAANK"

#. ~ Description of mutation "TAAANK"
#. ~ Description of mutation "Meatshield"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr ""
"Vous pouvez simplement endurer les dégâts infligés par la majorité de ce que"
" le Cataclysme peut vous envoyer. Vos HP sont augmentés par 40%, ce "
"pourcentage s'ajoutant avec les pourcentages acquis par d'autre sources."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Recovery"
msgstr ""

#. ~ Description of mutation "Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain slightly faster than normal."
msgstr ""
"Vous vous remettez un peu plus rapidement de la douleur que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quick Pain Recovery"
msgstr ""

#. ~ Description of mutation "Quick Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain faster than normal."
msgstr "Vous vous remettez plus rapidement de la douleur que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Quick Pain Recovery"
msgstr ""

#. ~ Description of mutation "Very Quick Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain much faster than normal."
msgstr ""
"Vous vous remettez beaucoup plus rapidement de la douleur que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Junkie"
msgstr "Accro à la douleur"

#. ~ Description of mutation "Pain Junkie"
#: data/json/mutations/mutations.json
msgid ""
"You've developed a serious appetite for pain, and take pride in your scars."
msgstr ""
"Vous avez développé un goût pour la douleur, et vos cicatrices vous "
"remplissent d'orgueil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cenobite"
msgstr "Cénobite"

#. ~ Description of mutation "Cenobite"
#: data/json/mutations/mutations.json
msgid "You positively adore pain, in all its varied forms."
msgstr "Vous adorez la douleur dans ses formes infiniment variées."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deadened"
msgstr "Insensibilisé"

#. ~ Description of mutation "Deadened"
#: data/json/mutations/mutations.json
msgid ""
"Nothing hurts anymore.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr ""
"Plus rien ne vous fait mal. Les morsures vous chatouillent un peu et les "
"blessures profondes gratte un peu, mais c'est tout."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Sensitive"
msgstr "Sensible à la douleur"

#. ~ Description of mutation "Pain Sensitive"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"For some reason, things always seem to hurt you more.  Pain dealt to you is "
"increased by 25%."
msgstr ""
"Pour une raison quelconque, tout vous fait plus mal que la normale, "
"accroissant de 25% d'intensité la douleur que vous recevez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyperalgesia"
msgstr "Hyperalgésie"

#. ~ Description of mutation "Hyperalgesia"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body experiences pain out of proportion to the physical causes.  Pain "
"dealt to you is increased by 50%."
msgstr ""
"Votre corps ressent la douleur hors de proportion avec ce qui la cause, "
"accroissant de 50% d'intensité la douleur que vous recevez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Hyperalgesia"
msgstr "Hyperalgésie Aiguë"

#. ~ Description of mutation "Extreme Hyperalgesia"
#: data/json/mutations/mutations.json
msgid ""
"Your body reacts cripplingly to any source of pain.  Pain dealt to you is "
"doubled."
msgstr ""
"Votre corps est absolument paralysé par la moindre source de douleur, "
"doublant la douleur que vous recevez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Culler"
msgstr "Darwiniste"

#. ~ Description of mutation "Culler"
#: data/json/mutations/mutations.json
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die"
" anyway, you preserve resources for those better able to survive.  You are "
"less bothered by the deaths of others: their own weakness invited these "
"fates upon them."
msgstr ""

#. ~ Mutation name
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Appears in the refugee center as a trader.
#. ~ Snippet in category "<top_name>"
#. ~ Used to pick a random family name.  List taken from the top 500 most
#. common names here: https://forebears.io/united-
#. states/massachusetts/surnames
#: data/json/mutations/mutations.json data/json/npcs/classes.json
#: data/json/npcs/godco/classes.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_hunter.json
#: data/mods/MindOverMatter/snippets/snippets_random_names.json
msgid "Hunter"
msgstr "Chasseur"

#. ~ Description of mutation "Hunter"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has a lot more in common with a predatory animal than a human, "
"making it easier to control misplaced reactions to the death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easier to learn and "
"maintain."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Predator"
msgstr "Prédateur"

#. ~ Description of mutation "Predator"
#: data/json/mutations/mutations.json
msgid ""
"You consider yourself something other than human and no longer empathize "
"with them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Apex Predator"
msgstr "Prédateur Ultime"

#. ~ Description of mutation "Apex Predator"
#: data/json/mutations/mutations.json
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top of the food chain.  You can effortlessly master and maintain combat "
"skills, but your critical thinking has atrophied further."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sapiovore"
msgstr "Sapiovore"

#. ~ Description of mutation "Sapiovore"
#: data/json/mutations/mutations.json
msgid "The hairless apes make as good eating as any other meat."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pack Hunter"
msgstr "Chasseur de Meute"

#. ~ Description of mutation "Pack Hunter"
#: data/json/mutations/mutations.json
msgid ""
"Puny as they may seem, a hunter needs a pack, and some of those hairless "
"bipeds may yet prove some worth.  You continue to gain combat skills at an "
"elevated rate, and maintain a level of critical thinking that supports "
"cooperation."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Defender"
msgstr ""

#. ~ Description of mutation "Mycus Defender"
#: data/json/mutations/mutations.json
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this task"
" - our fibers will grow strong and resilient when such threats present "
"themselves to us."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bird Wings"
msgstr "Ailes d'oiseau"

#. ~ Description of mutation "Bird Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large, feathered wings.  Your body is too heavy to be "
"able to fly, but you can use them to slow your descent during a fall, and "
"will not take falling damage under any circumstances."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Wings"
msgstr "Ailes d'insecte"

#. ~ Description of mutation "Insect Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large, translucent wings.  They are too small to lift "
"you, but are powerful enough to greatly speed your movement, with some "
"effort and noise."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mouth Tentacles"
msgstr "Bouche tentacules"

#. ~ Description of mutation "Mouth Tentacles"
#. ~ Description of mutation "Facial Tentacles"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr ""
"Un ensemble de tentacules entoure votre bouche. Elles vous permettent de "
"manger deux fois plus vite. Diminue légèrement les pénalités humides."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mandibles"
msgstr "Mandibules"

#. ~ Description of mutation "Mandibles"
#: data/json/mutations/mutations.json
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you"
" to eat faster and provide a slicing unarmed attack.  Slightly reduces wet "
"effects."
msgstr ""

#. ~ Message when player with mutation "Mandibles" attacks
#. ~ Message when player with mutation "Folding Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite %s with your fangs!"
msgstr ""

#. ~ Message when NPC with mutation "Mandibles" attacks
#. ~ Message when NPC with mutation "Folding Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s with their fangs!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Folding Fangs"
msgstr "Crocs Repliables"

#. ~ Description of mutation "Folding Fangs"
#: data/json/mutations/mutations.json
msgid ""
"You have developed deadly extensible fangs, allowing you to bite quickly or "
"ensure your venom goes home, as desired."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crab Legs"
msgstr ""

#. ~ Description of mutation "Crab Legs"
#: data/json/mutations/mutations.json
msgid ""
"You have four prong-tipped legs, splayed out and articulated like a crab's."
"  They're a little quieter than human feet."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gastropod Foot"
msgstr "Pied de Gastropode"

#. ~ Description of mutation "Gastropod Foot"
#: data/json/mutations/mutations.json
msgid ""
"Your legs have consolidated into a single muscular 'foot' that goes up into "
"your belly.  You move about a fourth of your previous speed and can no "
"longer wear pants or shoes, on the other hand you make significantly less "
"noise.  In addition to being harder to knock down, you can move through "
"sludge-covered surfaces easily."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gastropod Balance"
msgstr "Équilibre de Gastropode"

#. ~ Description of mutation "Gastropod Balance"
#: data/json/mutations/mutations.json
msgid ""
"By pushing your whole 'foot' against the ground you are able to move across "
"rough terrain without losing your 'footing'.  You're also able to cling to "
"the ground underwater, allowing you to move along the bottom more easily."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mucus Secretion"
msgstr "Sécrétion Muqueuse"

#. ~ Description of mutation "Mucus Secretion"
#: data/json/mutations/mutations.json
msgid ""
"You once had a significant other call you slimy, now you exemplify that.  It"
" covers everything you come into contact with but now you can move through "
"slime you didn't create with ease."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acidic Secretion"
msgstr "Sécrétion Caustique"

#. ~ Description of mutation "Acidic Secretion"
#: data/json/mutations/mutations.json
msgid ""
"Your mucus has developed an acidic component that seems to soften your prey "
"up."
msgstr "Votre mucus est maintenant assez acide pour pré-digérer vos proies."

#. ~ Message when player with mutation "Acidic Secretion" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You smear slime on %s!"
msgstr ""

#. ~ Message when NPC with mutation "Acidic Secretion" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s smears slime on %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snail Trail"
msgstr "Traînée de Bave"

#. ~ Description of mutation "Snail Trail"
#: data/json/mutations/mutations.json
msgid ""
"You've developed some ability to control your slime emissions.  As a result "
"of this you can leave trails of slime anywhere you walk."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Canine Ears"
msgstr "Oreilles Canines"

#. ~ Description of mutation "Canine Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have extended into long, pointed ones, like those of a canine.  "
"They enhance your hearing, allowing you to hear at greater distances."
msgstr ""
"Vos oreilles sont longues et pointues, comme celles des chiens. Elles "
"améliorent votre capacité auditive, vous permettant d'entendre des bruits "
"plus distants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lupine Ears"
msgstr "Oreilles de Loup"

#. ~ Description of mutation "Lupine Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your hearing has evolved further and is now on par with that of wolves.  You"
" can hear things significantly farther away."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Ears"
msgstr "Oreilles de Félin"

#. ~ Description of mutation "Feline Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr ""
"Vos oreilles sont longues et pointues, comme celles des chats. Elles "
"améliorent votre capacité auditive, vous permettant d'entendre des bruits "
"plus distants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Ears"
msgstr "Oreilles d'Ours"

#. ~ Description of mutation "Ursine Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can"
" hear things a little farther away."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pointed Ears"
msgstr "Oreilles Pointues"

#. ~ Description of mutation "Pointed Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Ears"
msgstr "Oreilles de Rongeur"

#. ~ Description of mutation "Rodent Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears are huge, round, and gray!  They're rather fascinating, and help "
"you hear from a much greater distance."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Walker"
msgstr "Marcheur des Toiles"

#. ~ Description of mutation "Web Walker"
#: data/json/mutations/mutations.json
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr ""
"Votre corps sécrète des petites particules chimiques qui vous permettent de "
"résister à l'effet collant des toiles. Marcher à travers les toiles "
"d'araignées ne vous fait plus rien."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Spinner"
msgstr "Tissage de Toile"

#. ~ Description of mutation "Web Spinner"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Weaver"
msgstr "Tisseur de toile"

#. ~ Description of mutation "Web Weaver"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the necessary anatomy and techniques to control your web-"
"generation.  Activate this to start or stop weaving webs."
msgstr ""
"Tu as développé l'anatomie et les techniques nécessaires pout contrôler ta "
"génération de toile. Active ça pour lancer ou arrêter de tisser des toiles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Diver"
msgstr ""

#. ~ Description of mutation "Web Diver"
#: data/json/mutations/mutations.json
msgid ""
"Your webbing is strong enough to support your weight.  Activate to rappel "
"down any drop you encounter, at the cost of nutrition."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rope Webs"
msgstr ""

#. ~ Description of mutation "Rope Webs"
#: data/json/mutations/mutations.json
msgid ""
"With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr ""
"Avec des filières comme celle-ci, qui a besoin de corde? Activez cette "
"mutation pour tisser une corde en soie."

#. ~ Message when spawning item "rope_30" with mutation "Rope Webs"
#: data/json/mutations/mutations.json
msgid "You spin a rope from your silk."
msgstr "Vous tissez une corde avec votre soie."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Whiskers"
msgstr "Vibrisses"

#. ~ Description of mutation "Whiskers"
#: data/json/mutations/mutations.json
msgid ""
"You have a handsome set of whiskers around your mouth.  These make you more "
"aware of vibrations in the air, and improve your ability to dodge very "
"slightly."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wiry Whiskers"
msgstr "Vibrisses de Rongeur"

#. ~ Description of mutation "Wiry Whiskers"
#: data/json/mutations/mutations.json
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fat Deposits"
msgstr "Dépôts de Graisse"

#. ~ Description of mutation "Fat Deposits"
#: data/json/mutations/mutations.json
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Inconveniently Large"
msgstr "Inconfortablement Large"

#. ~ Description of mutation "Inconveniently Large"
#. ~ Description of mutation "Elephantine"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Large"
msgstr "Large"

#. ~ Description of mutation "Large"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Freakishly Huge"
msgstr "Monstrueusement Large"

#. ~ Description of mutation "Freakishly Huge"
#. ~ Description of mutation "Freakishly Gigantic"
#. ~ Description of mutation "Freakish Draconic Maturity"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit"
" into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr ""
"Votre corps s'est encore élargie, jusque au point ou vous ne pouvez plus "
"rentrer dans des véhicules normaux ou enfiler des vêtements conçus pour un "
"être humain moyen. La majorité de votre nouvelle masse est musculaire, vous "
"donnant un +4 à votre Force, mais cela ne l'empêche pas d'être encombrante "
"et pénible."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Huge"
msgstr "Énorme"

#. ~ Description of mutation "Huge"
#. ~ Description of mutation "Gigantic"
#. ~ Description of mutation "Draconic Maturity"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who"
" needs pathetic human cars?  Strength +4."
msgstr ""
"Votre système cardiovasculaire a enfin rattrapé votre dévelopement "
"musculaire, qui a besoin d'un véhicule lorsque vous pouvez les rattraper? "
"Votre Force est augmentée par 4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong"
msgstr "Fort"

#. ~ Description of mutation "Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are a little stronger.  +1 Strength."
msgstr ""
"Vos muscles sont un peu plus puissants que la moyenne, vous donnant un +1 à "
"votre Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Strong"
msgstr "Très fort"

#. ~ Description of mutation "Very Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are stronger.  +2 Strength."
msgstr ""
"Vos muscles sont plus puissants que la moyenne, vous donnant un +2 à votre "
"Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Strong"
msgstr "Extrêmement fort"

#. ~ Description of mutation "Extremely Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are much stronger.  +4 Strength."
msgstr ""
"Vos muscles sont beaucoup plus puissants que la moyenne, vous donnant un +4 "
"à votre Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Strong"
msgstr "Incroyablement fort"

#. ~ Description of mutation "Insanely Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are noticeably bulging.  +7 Strength."
msgstr ""
"Vos muscles sont devenus tellement massifs que vous pouvez les voir gonfler "
"même à travers vos vêtements, vous donnant +7 à votre Force."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Strength"
msgstr "Primauté de Force"

#. ~ Description of mutation "Prime Strength"
#: data/json/mutations/mutations.json
msgid "Your muscles are perfectly developed."
msgstr "Vos muscles sont parfaitement développés."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dextrous"
msgstr "Adroit"

#. ~ Description of mutation "Dextrous"
#: data/json/mutations/mutations.json
msgid "You are a little nimbler.  +1 Dexterity."
msgstr ""
"Vous êtes un peu plus flexible que la moyenne, vous donnant un +1 à votre "
"Dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Dextrous"
msgstr "Très adroit"

#. ~ Description of mutation "Very Dextrous"
#: data/json/mutations/mutations.json
msgid "You are nimbler.  +2 Dexterity."
msgstr ""
"Vous êtes plus flexible que la moyenne, vous donnant un +2 à votre "
"Dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Dextrous"
msgstr "Extrêmement adroit"

#. ~ Description of mutation "Extremely Dextrous"
#: data/json/mutations/mutations.json
msgid "You are nimble and quick.  +4 Dexterity."
msgstr ""
"Vous êtes beaucoup plus rapide et agile que la normale, vous donnant un "
"bonus de +4 à votre dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Dextrous"
msgstr "Incroyablement adroit"

#. ~ Description of mutation "Insanely Dextrous"
#: data/json/mutations/mutations.json
msgid "You are much nimbler than before.  +7 Dexterity."
msgstr ""
"Vous êtes plus agile et dextre que ce qui devrait être physiquement "
"possible, vous donnant un bonus de +7 à votre dextérité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Dexterity"
msgstr "Primauté de Dextérité"

#. ~ Description of mutation "Prime Dexterity"
#: data/json/mutations/mutations.json
msgid "You're perfectly coordinated."
msgstr "Vous êtes parfaitement coordonné(e)."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smart"
msgstr "Intelligent"

#. ~ Description of mutation "Smart"
#: data/json/mutations/mutations.json
msgid "You are a little smarter.  +1 Intelligence."
msgstr ""
"Vous êtes un peu plus intelligent(e) que la moyenne, mais rien "
"d'extraordinaire, vous donnant un bonus de +1 à votre intelligence."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Smart"
msgstr "Très intelligent"

#. ~ Description of mutation "Very Smart"
#: data/json/mutations/mutations.json
msgid "You are smarter.  +2 Intelligence."
msgstr ""
"Vous êtes plus intelligent(e) que la moyenne, vous donnant un bonus de +2 à "
"votre intelligence."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Smart"
msgstr "Extrêmement intelligent"

#. ~ Description of mutation "Extremely Smart"
#: data/json/mutations/mutations.json
msgid ""
"You are much smarter, and your skull bulges slightly.  +4 Intelligence."
msgstr ""
"Vous êtes beaucoup plus intelligent(e) que la normale, et votre crâne est "
"légèrement enflé, vous donnant un bonus de +4 à votre intelligence."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Smart"
msgstr "Incroyablement intelligent"

#. ~ Description of mutation "Insanely Smart"
#: data/json/mutations/mutations.json
msgid ""
"Your skull bulges noticeably due to your impressive brain.  +7 Intelligence."
msgstr ""
"Votre crâne est visiblement gonflé, une conséquence de votre cerveau aux "
"capacités ahurissantes, vous donnant un bonus de +7 à votre intelligence."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Intelligence"
msgstr "Primauté d'Intelligence"

#. ~ Description of mutation "Prime Intelligence"
#: data/json/mutations/mutations.json
msgid ""
"You understand almost everything about which you think, with minimal effort."
msgstr ""
"Vous comprenez pratiquement tout ce que y arrive autour de vous avec un "
"effort minimal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Distributed Neurology"
msgstr "Neurologie Distribuée"

#. ~ Description of mutation "Distributed Neurology"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Perceptive"
msgstr "Perceptif"

#. ~ Description of mutation "Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are a little keener.  +1 Perception."
msgstr ""
"Vos sens sont un petit peu plus aiguisés que la moyenne, vous donnant un +1 "
"à votre Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Perceptive"
msgstr "Très perceptif"

#. ~ Description of mutation "Very Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are keener.  +2 Perception."
msgstr ""
"Vos sens sont beaucoup plus aiguisés que la moyenne, vous donnant un +2 à "
"votre Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Perceptive"
msgstr "Extrêmement perceptif"

#. ~ Description of mutation "Extremely Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are much keener.  +4 Perception."
msgstr ""
"Vos sens sont extrêmement plus aiguisés que la moyenne, vous donnant un +4 à"
" votre Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Perceptive"
msgstr "Incroyablement perceptif"

#. ~ Description of mutation "Insanely Perceptive"
#: data/json/mutations/mutations.json
msgid "You can sense things you never imagined.  +7 Perception."
msgstr ""
"Vos sens sont déraisonnablement aiguisés, vous donnant un +7 à votre "
"Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Perception"
msgstr "Primauté de Perception"

#. ~ Description of mutation "Prime Perception"
#: data/json/mutations/mutations.json
msgid "Your senses are keenly honed."
msgstr "Vos sens sont aiguisés au-delà de la moyenne humaine pathétique."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sensory Disintegration"
msgstr "Désintégration Sensorielle"

#. ~ Description of mutation "Sensory Disintegration"
#: data/json/mutations/mutations.json
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr ""
"Vos organes sensoriels se déplacent partout, des yeux s'étendent et se "
"rétractent, des tubes auditifs migrent autour de votre corps, et le moins "
"est dit de votre odorat et goût, le mieux. Votre monde est tellement confus!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Distributed Senses"
msgstr "Sens Distribués"

#. ~ Description of mutation "Distributed Senses"
#: data/json/mutations/mutations.json
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slimewave"
msgstr "Vague de Slime"

#. ~ Description of mutation "Slimewave"
#: data/json/mutations/mutations.json
msgid ""
"You can communicate with your extant mass without physical contact, "
"absorbing knowledge from nearby friendly slime."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Little"
msgstr "Petit"

#. ~ Description of mutation "Little"
#: data/json/mutations/mutations.json
msgid ""
"You've noticeably shrunk in size.  You're able to move with increased "
"litheness, but your smaller stature prevents you from carrying as much."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tiny"
msgstr "Miniscule"

#. ~ Description of mutation "Tiny"
#: data/json/mutations/mutations.json
msgid ""
"You're only half as tall as you used to be!  The weight of things you once "
"found easy to carry is now unbearable, clothes are now twice as encumbering "
"for you unless you refit them (since you're half their size), and your hit "
"points are heavily reduced.  However, your movement is silent, and your "
"dodge skill is a little higher."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Unassuming"
msgstr "Modeste"

#. ~ Description of mutation "Unassuming"
#: data/json/mutations/mutations.json
msgid ""
"You've mastered your tiny form!  Item encumbrance and carry weight penalties"
" are reduced, and you've learned to use your increased nimbleness to offset "
"your reduced capacity to absorb damage."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crafty"
msgstr ""

#. ~ Description of mutation "Crafty"
#: data/json/mutations/mutations.json
msgid ""
"By making the most of your small stature, you can avoid the notice of all "
"but the most perceptive creatures, and your speed is greatly increased."
msgstr ""
"En utilisant bien votre petite stature, vous êtes capable d'éviter d'être "
"repéré(e) par la plupart des créatures, et votre vitesse est grandement "
"accrue."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Metallassomaiphile"
msgstr "Metallassomaiphile"

#. ~ Description of mutation "Metallassomaiphile"
#: data/json/mutations/mutations.json
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Head Bumps"
msgstr "Bosses à la tête"

#. ~ Description of mutation "Head Bumps"
#: data/json/mutations/mutations.json
msgid "You have a pair of bumps on your skull."
msgstr "Vous avez deux bosses sur votre crâne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slit Nostrils"
msgstr "Narines étroites"

#. ~ Description of mutation "Slit Nostrils"
#: data/json/mutations/mutations.json
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a lizard-"
"like appearance.  This makes breathing slightly difficult and increases "
"mouth encumbrance by 10."
msgstr ""
"Vous avez un nez plat et vos narines ne sont que des fentes fines, ceci "
"donne à votre visage une apparence reptilienne et rends votre respiration "
"légèrement plus difficile ainsi qu'augmente par 10 votre encombrement de "
"bouche."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Forked Tongue"
msgstr "Langue fourchue"

#. ~ Description of mutation "Forked Tongue"
#: data/json/mutations/mutations.json
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr "Vorte langue est fourchue, comme les reptiles. Cela n'a pas d'effet."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lolling Tongue"
msgstr "Langue Pendante"

#. ~ Description of mutation "Lolling Tongue"
#: data/json/mutations/mutations.json
msgid ""
"Your tongue has lengthened and often extends far beyond your mouth.  This "
"has no effect."
msgstr ""
"Votre langue s'est allongée et pends naturellement bien au delà de votre "
"bouche. Ceci n'a aucun effet."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Whipping Tongue"
msgstr "Langue Fouettante"

#. ~ Description of mutation "Whipping Tongue"
#: data/json/mutations/mutations.json
msgid ""
"You've developed an extremely long and mobile tongue.  You may use it to "
"attack your enemies and pull them towards you."
msgstr ""
"Votre langue a mutée en un appendice extrêmement long et mobile, vous "
"donnant la possibilité de l'utiliser comme arme mais aussi comme grappin "
"pour tirer vos ennemis vers vous."

#. ~ Message when player with mutation "Whipping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You swipe %s with your tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Whipping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s swipes %2$s with their tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bulging Eyes"
msgstr "Yeux Protubérants"

#. ~ Description of mutation "Bulging Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr ""
"Vos yeux sont gonflés et s'étendent plusieurs centimètres plus loin que le "
"reste de votre visage. Ceci n'a aucun effet sur votre vision."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Intermediate Eyestalks"
msgstr "Ommatophores Intermédiaires"

#. ~ Description of mutation "Intermediate Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes barely protrude from your head on tentacles, preventing the use of"
" any rigid eyewear.  On the plus side, you can have additional awareness, "
"but sometimes your vision goes wonky as your brain tries to process the new "
"angles.  Perception +1"
msgstr ""
"Vos yeux protubèrent de votre crâne par quelque centimètres sur des "
"tentacules, vous empêchant de porter des lunettes ou masques humains. Du bon"
" côté des choses, vous êtes capable de voire à un plus grand angle, même si "
"de temps à autre votre cerveau peine à interpréter les nouveaux angles et "
"votre vision se trouble. Ceci vous accorde un bonus de +1 en Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Eyestalks"
msgstr "Ommatophores"

#. ~ Description of mutation "Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes protrude from your head on flexible tentacles, preventing the use "
"of any eyewear.  On the plus side, you can see in two directions at once, "
"and they automatically retract to reduce damage.  Perception +2"
msgstr ""
"Vos yeux protubèrent bien au delà de votre tête sur des tentacules "
"préhensibles et flexibles, vous empêchant de porter des lunettes ou masques "
"humaines. Du bon côté des choses, vous pouvez voire dans deux directions en "
"même temps et vos nouveaux organes visuels se rétractent automatiquement en "
"cas de danger. Ceci vous accorde un bonus de +1 en Perception."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rigid Eyestalks"
msgstr "Ommatophores Rigides"

#. ~ Description of mutation "Rigid Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"You have compound eyes on rigid stalks that can fold back against your head "
"to protect them from danger.  This gives you better all-around vision and "
"allows you to see underwater, but interferes with eyewear.  Perception +1"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mouth Flaps"
msgstr "Bajoues"

#. ~ Description of mutation "Mouth Flaps"
#. ~ Description of mutation "Mouth Tendrils"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your"
" eating, but are unpleasant to look at."
msgstr ""
"Des bourrelets et bajoues étranges cernent votre bouche, n'obstruant rien "
"lors-ce que vous mangez, mais définitivement peu agréable à regarder."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wing Stubs"
msgstr "Petites Ailes"

#. ~ Description of mutation "Wing Stubs"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades."
"  They can be wiggled at will, but are useless."
msgstr ""
"Vous possédez une paire de moignons d'ailes saillant de vos omoplates. Vous "
"pouvez les trémousser à volonté, mais elle ne servent pas à grand chose."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bat Wings"
msgstr "Ailes de chauve-souris"

#. ~ Description of mutation "Bat Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large, leathery wings.  You can move them a little, but "
"they are useless, and in fact put you off balance, reducing your ability to "
"dodge slightly."
msgstr ""
"Vous possédez une paire d'ailes rappelant celles d'une chauve souris. Vous "
"pouvez les agiter un peu, mais elles sont plus ou moins inutiles, pire, leur"
" effet sur votre centre de gravité rend vos esquives un peu plus difficiles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Butterfly Wings"
msgstr "Ailes de papillon"

#. ~ Description of mutation "Butterfly Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a very large pair of brightly-colored, very beautiful wings.  They "
"can't lift you, and they make balancing tricky, but they certainly catch air"
" and attention!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pale Skin"
msgstr "Peau pâle"

#. ~ Description of mutation "Pale Skin"
#: data/json/mutations/mutations.json
msgid "Your skin is rather pale."
msgstr "Votre peau est plutôt pâle."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spots"
msgstr "Tâches"

#. ~ Description of mutation "Spots"
#: data/json/mutations/mutations.json
msgid "Your skin is covered in a pattern of red spots."
msgstr "Votre peau est couverte de points rouges."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smelly"
msgstr "Malodorant"

#. ~ Description of mutation "Smelly"
#: data/json/mutations/mutations.json
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr ""
"Votre odeur corporelle est repoussante. Les ennemis capable de vous sentir "
"le feront de plus loin, et ceci n'améliorera pas votre popularité auprès de "
"vos congénères."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deformed"
msgstr "Déformation"

#. ~ Description of mutation "Deformed"
#: data/json/mutations/mutations.json
msgid ""
"You're slightly deformed.  Some people will react badly to your appearance."
msgstr ""
"Votre physique est légèrement déformé, et ceci peut être un problème lors de"
" vos interactions sociales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Badly Deformed"
msgstr "Déformation sérieuse"

#. ~ Description of mutation "Badly Deformed"
#: data/json/mutations/mutations.json
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction"
" to your appearance."
msgstr ""
"Quelque chose dans votre apparence vous rend très difficile à regarder dans "
"les yeux. Votre aspect repoussant vous causera beaucoup de problèmes lors de"
" vos interactions sociales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grotesque"
msgstr "Grotesque"

#. ~ Description of mutation "Grotesque"
#: data/json/mutations/mutations.json
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr ""
"Votre visage est nauséeux à regarder. La plupart des personnes que vous "
"rencontrerez ne voudront pas vous parler plus longtemps que le nécessaire "
"absolu."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Beautiful"
msgstr "Beau"

#. ~ Description of mutation "Beautiful"
#: data/json/mutations/mutations.json
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr ""
"Vous faites tourner les têtes ou que vous alliez. Beaucoup de personnes vous"
" traiteront mieux simplement à cause de votre apparence, et ceci vous aidera"
" lors de vos interactions sociales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Beautiful"
msgstr "Très beau"

#. ~ Description of mutation "Very Beautiful"
#: data/json/mutations/mutations.json
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks,"
" and most people will trust you immediately."
msgstr ""
"Votre beauté est étourdissante, la plupart des personnes que vous "
"rencontrerez vous traiteront mieux simplement à cause de votre apparence, et"
" ceci vous aidera beaucoup lors de vos interactions sociales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Glorious"
msgstr "Splendide"

#. ~ Description of mutation "Glorious"
#: data/json/mutations/mutations.json
msgid ""
"You are incredibly beautiful.  People cannot help themselves due to your "
"charms, and will do whatever they can to please you."
msgstr ""
"Votre beauté est tellement écrasante que pratiquement toute personne que "
"vous rencontrerez vous traiteront beaucoup mieux simplement à cause de votre"
" apparence, ceci vous permettra pratiquement de rendre toute autre personne "
"votre servant(e) avec quelques mots."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snout"
msgstr "Museau"

#. ~ Description of mutation "Snout"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaw have begun… changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr ""
"Votre visage et votre mâchoire sont maintenant visiblement mutants. Un "
"masque normal ou un casque intégral vous va toujours, mais votre apparence "
"est devenue visiblement inhumaine."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine Snout"
msgstr "Museau Bovin"

#. ~ Description of mutation "Bovine Snout"
#: data/json/mutations/mutations.json
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but prevents wearing mouthgear."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lupine Muzzle"
msgstr "Museau de loup"

#. ~ Description of mutation "Lupine Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents wearing mouthgear."
msgstr ""

#. ~ Message when player with mutation "Lupine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You nip at %s!"
msgstr ""

#. ~ Message when NPC with mutation "Lupine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s nips and harries %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Muzzle"
msgstr "Museau d'ours"

#. ~ Description of mutation "Ursine Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents wearing mouthgear."
msgstr ""

#. ~ Message when player with mutation "Ursine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite %s!"
msgstr "Vous mordez le/la %s!"

#. ~ Message when NPC with mutation "Ursine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s!"
msgstr "%1$s mords le/la %2$s!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Muzzle"
msgstr "Museau de rat"

#. ~ Description of mutation "Rodent Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaw have extended, giving you an alert and attentive "
"appearance."
msgstr ""
"Votre tête et votre mâchoire se sont allongées, vous donnant un air alerte "
"et attentif."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Muzzle"
msgstr "Mâchoire Reptilienne"

#. ~ Description of mutation "Reptilian Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They"
" look NASTY--as do the bite wounds they can inflict--but prevent wearing "
"mouthgear."
msgstr ""
"Le bas de votre visage et vos mâchoires ont pris l'apparence d'une gueule "
"d'alligator en miniature, vous permettant d'infliger des blessures aussi "
"hideuses que l'impression que celle-ci donne lorsque vous vous regardez dans"
" un miroir. Il va sans dire que vous ne pouvez plus porter des objets sur "
"votre bouche ou tête n'étant pas adaptés à votre nouvelle apparence."

#. ~ Message when player with mutation "Reptilian Muzzle" attacks
#. ~ Message when player with mutation "Scaled Mouth" attacks
#. ~ Message when player with mutation "Black Dragon Maw" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You bite a chunk out of %s!"
msgstr "Vous mordez et arrachez un morceau du/de la %s!"

#. ~ Message when NPC with mutation "Reptilian Muzzle" attacks
#. ~ Message when NPC with mutation "Scaled Mouth" attacks
#. ~ Message when NPC with mutation "Black Dragon Maw" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s bites a chunk out of %2$s!"
msgstr "%1$s mords et arrache un morceau du/de la %2$s!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wide Mouth"
msgstr "Bouche Béante"

#. ~ Description of mutation "Wide Mouth"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaws have widened like a frogs.  It looks hideous but it "
"allows you to eat food whole."
msgstr ""
"Votre visage et votre mâchoire se sont élargis jusqu'à ressembler à ceux "
"d'une grenouille. Ceci ne vous rend pas très agréable à regarder mais vous "
"permet aussi d'avaler votre nourriture en une seule bouchée."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Proboscis"
msgstr "Trompe"

#. ~ Description of mutation "Proboscis"
#: data/json/mutations/mutations.json
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr ""
"Vous vous êtes débarrassé(e) de cette bouche terriblement imprécise et "
"maintenant aspirez votre nourriture comme une personne civilisée le ferait. "
"Macher était terriblement fatiguant de toute façon."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hollow Bones"
msgstr "Os Creux"

#. ~ Description of mutation "Hollow Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also"
" frail; you can carry 40% less, and bashing attacks injure you more."
msgstr ""
"Vos os sont creux, ce qui rends votre corps très léger et vous permets "
"d'attaquer et bouger 20% plus vite, mais ceci les rends aussi fragiles, "
"réduisant par 40% le poids maximum que vous pouvez porter, et les attaques "
"contondantes vous font plus de dégâts que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dense Bones"
msgstr "Os Denses"

#. ~ Description of mutation "Dense Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your bones are particularly dense and durable.  Your tougher frame grants 5%"
" more HP and 15% more carry capacity plus bashing attacks injure you less, "
"but your higher weight makes attacking and moving 5% slower.  Also, dodging "
"and swimming are harder."
msgstr ""
"Votre squelette est particulièrement dense et solide. Ceci augmente par 5% "
"vos PVs, et par 15% le poids maximum que vous pouvez porter, et les attaques"
" contondantes vous font moins de dégâts, mais le poids en plus vous fait "
"attaquer et bouger 5% moins vite, et rends l'esquive et la nage plus "
"difficile."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nausea"
msgstr "Nauséeux"

#. ~ Description of mutation "Nausea"
#: data/json/mutations/mutations.json
msgid ""
"You feel nauseated almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr ""
"Vous vous sentez presque constamment nauséeux/nauséeuse, et les "
"intoxications alimentaires, l'alcool et autres substances vous font vomir "
"plus facilement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vomitous"
msgstr "Très nauséeux"

#. ~ Description of mutation "Vomitous"
#: data/json/mutations/mutations.json
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand,"
" too."
msgstr ""
"Vous avez un trouble digestif majeur. Bien que cela vous fasse souvent "
"vomir, vous avez découvert que vous pouvez également déclencher votre "
"réflexe de vomissement à la demande."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Persistence Hunter"
msgstr ""

#. ~ Description of mutation "Persistence Hunter"
#: data/json/mutations/mutations.json
msgid ""
"You can pursue prey for miles and miles at a variety of paces until they "
"stop from exhaustion."
msgstr ""
"Vous pouvez poursuivre vos proies sur des kilomètres jusqu'à ce que celles-"
"ci soient trop fatiguées pour se défendre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Persistence Hunter"
msgstr ""

#. ~ Description of mutation "Extreme Persistence Hunter"
#: data/json/mutations/mutations.json
msgid ""
"You can pursue prey for days until they literally die from exhaustion.  It's"
" too bad zombies don't fatigue either."
msgstr ""
"Vous pouvez poursuivre vos proies pendant des jours jusqu'à ce que celles-ci"
" s'écroulent d'épuisement. Dommage que les zombies ne se fatiguent pas non "
"plus."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Metabolism"
msgstr "Métabolisme rapide"

#. ~ Description of mutation "Fast Metabolism"
#. ~ Description of mutation "Constant Eater"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You require more food than most people, but recover stamina slightly faster."
msgstr ""
"Vous avez besoin de plus de nourriture que la plupart des gens, mais "
"récupérez votre endurance un peu plus vite."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rapid Metabolism"
msgstr "Métabolisme rapide"

#. ~ Description of mutation "Rapid Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You require more resources than most, but heal more rapidly as well.  "
"Provides weak regeneration even when not asleep."
msgstr ""
"Vous avez besoin de plus de ressources que la plupart des gens, mais vous "
"guérissez également plus rapidement. Fournit une régénération faible même "
"lorsque pas endormi."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Fast Metabolism"
msgstr "Métabolisme très rapide"

#. ~ Description of mutation "Very Fast Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You need about twice as much food as the average human to maintain your "
"expanded cardiovascular and respiratory systems.  On the plus side, it "
"doesn't take you much time to recover from any strenuous activity."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Metabolism"
msgstr "Métabolisme Extrême"

#. ~ Description of mutation "Extreme Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You consume three times as much food as the average human to maintain your "
"truly superhuman endurance."
msgstr ""
"Vous consommez trois fois plus de nourriture qu'un humain moyen pour "
"maintenir votre endurance vraiment surhumaine."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "High Thirst"
msgstr "Déshydratation rapide"

#. ~ Description of mutation "High Thirst"
#: data/json/mutations/mutations.json
msgid "Your body dries out easily; you need to drink more water."
msgstr "Votre corps à besoin d'être hydraté plus souvent."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Thirsty"
msgstr "Déshydratation très rapide"

#. ~ Description of mutation "Very Thirsty"
#. ~ Description of mutation "Giant Thirst"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr ""
"Ugh, déjà en manque d'eau? Vous avez besoin d'environ deux fois plus de "
"fluides qu'un humain moyen."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Thirsty"
msgstr "Déshydratation extrêmement rapide"

#. ~ Description of mutation "Extremely Thirsty"
#: data/json/mutations/mutations.json
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr ""
"Vous vous déshydratez très rapidement, et il vous faut presque trois fois "
"plus à boire que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Metabolic Rehydration"
msgstr "Réhydratation Métabolique"

#. ~ Description of mutation "Metabolic Rehydration"
#: data/json/mutations/mutations.json
msgid ""
"Your body gets everything it needs from the food that you eat!  You no "
"longer need hydration from fluids."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Heavy Sleeper"
msgstr "Sommeil Très Profond"

#. ~ Description of mutation "Very Heavy Sleeper"
#: data/json/mutations/mutations.json
msgid "You could probably sleep through a firefight."
msgstr "Vous pourriez probablement dormir au milieu d'une fusillade."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Sleepy"
msgstr "Très somnolent"

#. ~ Description of mutation "Very Sleepy"
#: data/json/mutations/mutations.json
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half of "
"your time in or around a bed."
msgstr ""

#. ~ Mutation name
#. ~ Spell name
#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Weakening"
msgstr "Affaiblissement"

#. ~ Description of mutation "Weakening"
#: data/json/mutations/mutations.json
msgid ""
"You feel as though you are slowly weakening and your body heals slower."
msgstr ""
"Vous avez l'impression de faiblir lentement et votre corps guérit plus "
"lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deterioration"
msgstr "Détérioration"

#. ~ Description of mutation "Deterioration"
#: data/json/mutations/mutations.json
msgid "Your body is very slowly wasting away."
msgstr "Vous dépérissez très lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disintegration"
msgstr "Désintégration"

#. ~ Description of mutation "Disintegration"
#: data/json/mutations/mutations.json
msgid "Your body is slowly wasting away!"
msgstr "Vous dépérissez lentement!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solar Sensitivity"
msgstr "Sensibilité au soleil"

#. ~ Description of mutation "Solar Sensitivity"
#: data/json/mutations/mutations.json
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr "Votre peau ne peut pas supporter les UV au point d'être brulée."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sores"
msgstr "Plaies"

#. ~ Description of mutation "Sores"
#: data/json/mutations/mutations.json
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr ""
"Vos extrémintés sont couvertes de plaies douloureuses. La douleur est "
"accentuée sous des vêtements."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Sensitive"
msgstr "Sensibilité à la lumière"

#. ~ Description of mutation "Light Sensitive"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr ""
"La lumière du soleil vous est pénible. Si vous êtes à l'extérieur et que le "
"temps est ensoleillé, toutes vos stats ont une pénalité de -1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Light Sensitive"
msgstr "Importante sensibilité à la lumière"

#. ~ Description of mutation "Very Light Sensitive"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr ""
"La lumière du soleil vous est très pénible. Si vous êtes à l'extérieur en "
"journée, toutes vos stats ont une pénalité de -1; -2 si le temps est "
"ensoleillé."

#. ~ Description of mutation "Troglobite"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Webbed Hands"
msgstr "Mains Entoilées"

#. ~ Description of mutation "Webbed Hands"
#: data/json/mutations/mutations.json
msgid ""
"Your hands are heavily webbed, reducing your Dexterity by 1 and causing "
"problems with gloves.  However, you can swim much faster.  Slightly "
"decreases wet penalties."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Webbed Feet"
msgstr "Pieds Palmés"

#. ~ Description of mutation "Webbed Feet"
#: data/json/mutations/mutations.json
msgid ""
"Your feet are heavily webbed, allowing you to swim faster if you aren't "
"wearing footwear."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Paws"
msgstr "Pattes"

#. ~ Description of mutation "Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better and bear weight well, "
"allowing you to move on all fours when crouching and unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Broad Paws"
msgstr "Pattes Larges"

#. ~ Description of mutation "Broad Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your paws are much larger now.  Manual dexterity is difficult: permanent "
"hand encumbrance of 20, serious problems crafting, and no gloves.  In "
"return, though, you can swim better and move on all fours when crouching and"
" unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Beak"
msgstr "Bec"

#. ~ Description of mutation "Beak"
#: data/json/mutations/mutations.json
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr ""
"Vous avez un bec en guise de bouche. Vous pouvez l'utilisez pour becqueter "
"vos ennemies, mais vous ne pouvez porter aucun vêtement sur votre bouche. "
"Cela réduit un peu les effets néfastes en étant mouillé."

#. ~ Message when player with mutation "Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You peck %s!"
msgstr "Vous picorez le/la %s!"

#. ~ Message when NPC with mutation "Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s pecks %2$s!"
msgstr "%1$s picore le/la %2$s!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Woodpecker Beak"
msgstr "Bec de Pivert"

#. ~ Description of mutation "Woodpecker Beak"
#: data/json/mutations/mutations.json
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr ""
"Picorer vos proies est devenu votre routine quotidienne. Cela réduit un peu "
"les effets néfastes en étant mouillé."

#. ~ Message when player with mutation "Woodpecker Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You jackhammer into %s with your beak!"
msgstr ""

#. ~ Message when NPC with mutation "Woodpecker Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s jackhammer into %2$s with their beak!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hummingbird Beak"
msgstr "Bec de Colibri"

#. ~ Description of mutation "Hummingbird Beak"
#: data/json/mutations/mutations.json
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr ""
"Même si votre bec n'est pas adapté pour picorer, les fleurs sont par contre "
"une bonne source d'énergie. Examinez les pour vous nourrir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetically Unstable"
msgstr "Instabilité Génétique"

#. ~ Description of mutation "Genetically Unstable"
#: data/json/mutations/mutations.json
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr ""
"Votre ADN a été endommagé de telle manière que vous développez des mutations"
" continuellement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Catastrophic Mutation"
msgstr "Mutation Catastrophique"

#. ~ Description of mutation "Catastrophic Mutation"
#: data/json/mutations/mutations.json
msgid ""
"Exposure to portal storms and related phenomena causes you to mutate in a "
"mostly predictable fashion."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetic Chaos"
msgstr "Chaos Génétique"

#. ~ Description of mutation "Genetic Chaos"
#: data/json/mutations/mutations.json
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr ""
"Votre corps change très rapidement, sans intervention volontaire consciente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Minor Radioactivity"
msgstr "Radioactivité mineure"

#. ~ Description of mutation "Minor Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr ""
"Votre corps est devenu faiblement radioactif! Vous émettez continuellement "
"de faibles niveaux de radiations, en partie absorbés par vous, et le restant"
" contaminant le monde autour de vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radioactivity"
msgstr "Radioactivité"

#. ~ Description of mutation "Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr ""
"Votre corps est devenu radioactif! Vous émettez continuellement des niveaux "
"de radiation modérés, en partie absorbés par vous, et le restant contaminant"
" le monde autour de vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Severe Radioactivity"
msgstr "Radioactivité Élevée"

#. ~ Description of mutation "Severe Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr ""
"Votre corps est devenu très radioactif! Vous émettez continuellement de "
"niveaux de radiation extrêmes, en partie absorbés par vous, et le restant "
"contaminant le monde autour de vous."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slimy"
msgstr "Visqueux"

#. ~ Description of mutation "Slimy"
#: data/json/mutations/mutations.json
msgid ""
"Your body is coated with a fine slime.  Protects from long-term effects of "
"acid, though not short-term ones.  Greatly increases wet benefits."
msgstr ""
"Votre corps et recouvert d'une fine couche de liquide visqueux vous "
"protégeant des effets à long terme des acides, mais malheureusement pas ceux"
" à court terme. Améliore grandement les bénéfices d'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Viscous"
msgstr "Gluant"

#. ~ Description of mutation "Viscous"
#: data/json/mutations/mutations.json
msgid ""
"Your body's slime output has become sticky and gel-like.  Somewhat protects "
"from acid.  Greatly increases wet benefits."
msgstr ""
"Le liquide recouvrant votre corps est devenu collant et se comporte presque "
"comme de la gelée. Ceci vous protège un peu contre l'acide et améliore "
"grandement les bénéfices de l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amorphous Body"
msgstr "Corps Amorphe"

#. ~ Description of mutation "Amorphous Body"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem "
"to be moving around, and your leg-equivalents flow comfortably - if a little"
" slower than your old meat-legs."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Omnicellular"
msgstr "Monocellulaire"

#. ~ Description of mutation "Omnicellular"
#: data/json/mutations/mutations.json
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr ""
"Votre corps est plus ou moins une seul cellule omniprésente capable "
"d'altérer sa forme selon les besoins du moment."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Herbivore"
msgstr "Herbivore"

#. ~ Description of mutation "Herbivore"
#: data/json/mutations/mutations.json
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr ""
"La capacité de votre corps à digérer de la viande est sévèrement amoindrie. "
"Manger de la viande a une bonne chance de vous faire vomir; si vous ne "
"vomissez pas, la valeur nutritionnelle sera grandement réduite."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carnivore"
msgstr "Carnivore"

#. ~ Description of mutation "Carnivore"
#: data/json/mutations/mutations.json
msgid ""
"Your body's ability to digest fruits, vegetables, grains and nuts is "
"severely hampered.  You cannot eat anything besides meat."
msgstr ""
"La capacité de votre corps à digérer des fruits, des légumes et des céréales"
" est sévèrement amoindrie. Vous ne pouvez manger rien d'autre que de la "
"viande."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Ponderous"
msgstr "Pondéreux"

#. ~ Description of mutation "Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr "Vos muscles sont globalement lents. Vous bougez 10% plus lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Ponderous"
msgstr "Très pondéreux"

#. ~ Description of mutation "Very Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr "Vos muscles sont plutôt lents. Vous bougez 20% plus lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Ponderous"
msgstr "Extrêmement pondéreux"

#. ~ Description of mutation "Extremely Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr "Vos muscles sont très lents. Vous bougez 30% plus lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sunlight Dependent"
msgstr "Accro au Soleil"

#. ~ Description of mutation "Sunlight Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in"
" speed when in shade, and a 10% drop in speed when in the dark."
msgstr ""
"Vous vous sentez mou si vous n'êtes pas exposé au soleil. Vous souffrez "
"d'une perte de 5% de vitesse à l'ombre et 10% dans le noir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vines"
msgstr "Lianes"

#. ~ Description of mutation "Vines"
#: data/json/mutations/mutations.json
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're"
" bulky, and get in the way."
msgstr ""
"Plusieurs lianes lourdes et encombrantes ont commencées à germer autour de "
"vos épaules."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vine Limbs"
msgstr "Lianes Préhensiles"

#. ~ Description of mutation "Vine Limbs"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr ""
"Vous êtes maintenant capable de contrôler vos lianes, celles-ci font de bon "
"fouets et vous pouvez même les utiliser pour descendre d'un étage sans avoir"
" besoin d'escalier, mais les perdre ou les déconnecter fait VRAIMENT mal."

#. ~ Message when player with mutation "Vine Limbs" attacks
#. ~ Message when player with mutation "Vine Sprouter" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You lash %s with one of your vines!"
msgstr "Vous fouettez le/la %s avec l'une de vos lianes!"

#. ~ Message when NPC with mutation "Vine Limbs" attacks
#. ~ Message when NPC with mutation "Vine Sprouter" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s lashes %2$s with one of their vines!"
msgstr "%1$s fouette le/la %2$s avec l'une de ses lianes!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vine Sprouter"
msgstr "Lianes Amovibles"

#. ~ Description of mutation "Vine Sprouter"
#: data/json/mutations/mutations.json
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr ""
"Vous avez maintenant un contrôle complet sur vos lianes, et vous pouvez en "
"détacher et en repousser plus ou moins quand vous voulez."

#. ~ Message when spawning item "vine_30" with mutation "Vine Sprouter"
#: data/json/mutations/mutations.json
msgid "You detach a vine from your body."
msgstr "Vous détachez une liane de votre corps."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hair Roots"
msgstr "Racines Crâniales"

#. ~ Description of mutation "Hair Roots"
#: data/json/mutations/mutations.json
msgid ""
"Roots have started growing from your leaf-like hair.  They don't seem to do "
"much."
msgstr ""
"Des racines ont commencées à pousser de vos cheveux, celles-ci n'ont pas "
"vraiment l'air d'être utile à grand chose."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toe Roots"
msgstr "Racines Plantaires"

#. ~ Description of mutation "Toe Roots"
#: data/json/mutations/mutations.json
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr ""
"Vos orteils frétillent, et vous ne comprenez pas pourquoi est-ce que vous "
"portez ses trucs sur vos pieds, enlevez-les, ils sont dans le chemin."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Roots"
msgstr "Racines"

#. ~ Description of mutation "Roots"
#. ~ The idea is that you, for lack of a better term, plant yourself.
#. Crafting and digging don't count because they presume a certain amount of
#. movement during the task.  The handheld game does count.
#: data/json/mutations/mutations.json
msgid ""
"It's about time you started developing a root system.  When reading, "
"fishing, waiting, or otherwise being stationary for a while on diggable "
"terrain, you'll extract nutrients and water from the soil."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rooter"
msgstr "Enraciné"

#. ~ Description of mutation "Rooter"
#: data/json/mutations/mutations.json
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients "
"and water whenever on diggable terrain, but move more slowly."
msgstr ""
"Vous avez du mal à ne pas vous enraciner quand vous le pouvez. Vous extrayez"
" des nutriments et de l'eau chaque fois que vous vous trouvez sur un terrain"
" cultivable, mais vous vous déplacez plus lentement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chloromorphosis"
msgstr "Chloromorphose"

#. ~ Description of mutation "Chloromorphosis"
#: data/json/mutations/mutations.json
msgid ""
"Every inch of your skin is packed with chlorophyll and you have strong "
"roots.  Sleeping on diggable soil will satisfy any hunger or thirst you "
"might have.  Activate this mutation to force yourself to sleep until "
"nightfall."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycorrhizal Communion"
msgstr "Communion Racinaire."

#. ~ Description of mutation "Mycorrhizal Communion"
#: data/json/mutations/mutations.json
msgid ""
"You have gained the ability to commune with trees and comprehend their "
"ancient wisdom.  Activate next to a tree to gradually gain overmap vision "
"through connected forests."
msgstr ""
"Vous avez obtenu la capacité de communier avec les arbres et comprendre leur"
" sagesse ancienne. Activez cette mutation près d'un arbre pour obtenir des "
"informations sur votre carte à travers les forêts y étant connectées."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heat Dependent"
msgstr "Dépendant de la Chaleur"

#. ~ Description of mutation "Heat Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  This sluggishness"
" helps you conserve energy, however."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Heat Dependent"
msgstr "Très Dépendant de la Chaleur"

#. ~ Description of mutation "Very Heat Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C), but your "
"slow metabolism requires much less energy."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cold Blooded"
msgstr "Sang Froid"

#. ~ Description of mutation "Cold Blooded"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C), resulting in less "
"calorie usage."
msgstr ""
"Votre métabolisme est similaire à celui d'un animal à sang froid, vous avez "
"maintenant besoin de chaleur pour vous aidez à bouger. Vous perdez 1% de "
"votre vitesse pour chaque 1.1°C (2°F) en dessous de 18.3°C (65°F). Ceci a "
"pour avantage de réduire vos besoins caloriques."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ectothermic"
msgstr "Ectotherme"

#. ~ Description of mutation "Ectothermic"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  You eat much "
"less than you otherwise would."
msgstr ""
"Votre métabolisme est maintenant similaire à celui d'un animal à sang froid."
" Votre vitesse diminue ou augmente pour chaque 1.1°C (2°F) en dessous ou au "
"dessus de 18.3°C (65°F). Ceci à toute de même pour avantage de dépenser "
"moins d'énergie et limiter l'apport nutritionnel dont vous avez besoin."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Growling Voice"
msgstr "Voix qui Gronde"

#. ~ Description of mutation "Growling Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr ""
"Votre voix est plus rude. Convaincre les PNJ sera plus difficile mais les "
"menacer sera plus aisé."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Croaking Voice"
msgstr "Voix Croassante"

#. ~ Description of mutation "Croaking Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a low, croaking voice, like an aged grandparent.  Persuading NPCs "
"will be easier, but threatening them will be more difficult."
msgstr ""
"Vous avez une croassement dans votre voix lui rendant une impression de "
"senior. Cet air d'expérience rend la persuasion de PNJ un peu plus facile, "
"mais les intimider est rendu plus difficile."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snarling Voice"
msgstr "Voix Hargneuse"

#. ~ Description of mutation "Snarling Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr ""
"Votre voix présente une intonation particulièrement menaçante. Convaincre "
"les PNJ sera quasiment impossible, mais les menacer sera nettement plus "
"facile."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hissing Voice"
msgstr "Voix Sifflante"

#. ~ Description of mutation "Hissing Voice"
#: data/json/mutations/mutations.json
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr ""
"Vous sifflez en parlant. Convaincre les PNJ sera plus difficile, mais les "
"menacer plus aisé."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Screeching Voice"
msgstr ""

#. ~ Description of mutation "Screeching Voice"
#: data/json/mutations/mutations.json
msgid ""
"Your voice sounds like a bird trying to imitate a human.  Persuading NPCs "
"will be more difficult, but threatening them will be easier."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shouter"
msgstr "Crieur"

#. ~ Description of mutation "Shouter"
#: data/json/mutations/mutations.json
msgid "You occasionally shout uncontrollably."
msgstr "Vous criez de temps en temps de manière incontrôlable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Screamer"
msgstr "Hurleur"

#. ~ Description of mutation "Screamer"
#: data/json/mutations/mutations.json
msgid "You sometimes scream uncontrollably."
msgstr "Vous hurlez de temps en temps de manière incontrôlable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Howler"
msgstr "Hurleur strident"

#. ~ Description of mutation "Howler"
#: data/json/mutations/mutations.json
msgid "You frequently let out a piercing howl."
msgstr "Vous laissez échapper un hurlement perçant à intervalle régulier."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feathered Arms"
msgstr "Bras Plumés"

#. ~ Description of mutation "Feathered Arms"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have grown vibrantly-colored feathers.  They effectively "
"waterproof your arms and take the edge off hits, but really get in the way."
"  They're simply too small to help you in the air."
msgstr ""
"Vos bras sont couverts de jolies plumes colorés. Elles protègent de "
"l'humidité et des coups, mais sont très encombrantes. Elles sont trop "
"petites pour vous faire voler."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Limbs"
msgstr "Membres d'Insecte"

#. ~ Description of mutation "Insect Limbs"
#: data/json/mutations/mutations.json
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more or less uncontrollably, making you feel rather larval."
msgstr ""
"Une paire de bras a *finalement* germé de votre torse. Ils bougent d'une "
"manière plutôt incontrôlée, ce qui vous donne l'impression d'être une larve."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Arms"
msgstr "Bras d'Insecte"

#. ~ Description of mutation "Insect Arms"
#: data/json/mutations/mutations.json
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr ""
"C'est bon d'avoir tout vos bras. Même s'ils sont trop fins pour bloquer ou "
"donne un coup de poing, vous pouvez les plier sous vos vêtements si besoin."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid Limbs"
msgstr "Membres d'Araignée"

#. ~ Description of mutation "Arachnid Limbs"
#: data/json/mutations/mutations.json
msgid ""
"There's the last two limbs you were expecting.  Unfortunately, you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr ""
"Voilà les deux membres que vous attendiez. Malheureusement vous ne pouvez "
"pas la coordonner pour l'instant, donc ils sont pas mal encombrants."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid Arms"
msgstr "Bras d'Araignée"

#. ~ Description of mutation "Arachnid Arms"
#: data/json/mutations/mutations.json
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' "
"things.  They probably aren't worth concealing."
msgstr ""
"Vous avez quatre jolis membres munis de ces 'mains' et 'pieds' mutés. Il "
"serait dommage de s'en priver."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Arms"
msgstr "Bras Tentacules"

#. ~ Description of mutation "Tentacle Arms"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  Somewhat decreases wet penalties."
msgstr ""
"Vos bras se sont métamorphosés en tentacules, rendant l'utilisation de gants"
" impossible, vous donnant un +1 à votre Dextérité, un encombrement à vos "
"mains permanent de 30. Réduis légèrement les effets négatifs de l'humidité."

#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You slap %s with one of your tentacles!"
msgstr "Vous fouettez le/la %s avec l'une de vos tentacules! "

#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s slaps %2$s with one of their tentacles!"
msgstr "%1$s fouette le/la %2$s avec l'une de ses tentacules!"

#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You rake %s with one of your tentacles!"
msgstr "Vous râpez le/la %s avec l'une de vos tentacules!"

#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s rakes %2$s with one of their tentacles!"
msgstr "%1$s râpe le/la %2$s avec l'une de ses tentacules!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "4 Tentacles"
msgstr "4 Tentacules"

#. ~ Description of mutation "4 Tentacles"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into four tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 3 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Vos bras se sont métamorphosés en 4 tentacules, rendant l'utilisation de "
"gants impossible, vous donnant un +1 à votre Dextérité, un encombrement à "
"vos mains permanent de 30. Vous pouvez maintenant attaquer quatre fois avec "
"vos nouveaux appendices. Réduis légèrement les effets négatifs de "
"l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "8 Tentacles"
msgstr "8 Tentacules"

#. ~ Description of mutation "8 Tentacles"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into eight tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Vos bras se sont métamorphosés en 8 tentacules, rendant l'utilisation de "
"gants impossible, vous donnant un +1 à votre Dextérité, un encombrement à "
"vos mains permanent de 30. Vous pouvez maintenant attaquer huit fois avec "
"vos nouveaux appendices. Réduis légèrement les effets négatifs de "
"l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shell"
msgstr "Coquille"

#. ~ Description of mutation "Shell"
#: data/json/mutations/mutations.json
msgid ""
"You have grown a thick shell over your torso, providing excellent armor, but"
" you cannot wear anything on your torso.  Somewhat reduces wet effects."
msgstr ""
"Une coquille s'est développée sur votre torse, ce qui vous procure une "
"excellente armure. Son espace vide vous procure également 16 emplacements de"
" stockage, mais vous ne pouvez rien porter sur votre torse. Elle vous isole "
"un peu de l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Roomy Shell"
msgstr "Grande Coquille"

#. ~ Description of mutation "Roomy Shell"
#: data/json/mutations/mutations.json
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--"
"your whole body.  Activate to pull your head and limbs into your shell, "
"trading mobility and vision for warmth and shelter."
msgstr ""
"Votre coquille est tellement grande que vous pouvez y rentrer tout votre "
"corps. Activez la pour y rentrer votre tête et vos membres. Vous n'y verrez "
"plus ni ne pourrez bouger mais vous aurez chaud, serez protégé et abrité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nacreous Shell"
msgstr "Carapace Nacrée"

#. ~ Description of mutation "Nacreous Shell"
#: data/json/mutations/mutations.json
msgid ""
"Your protective shell has developed increased strength and hardness and a "
"mother of pearl sheen."
msgstr ""
"Votre coquille s'est endurcie, maintenant recouverte d'une couche de nacre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leg Tentacles"
msgstr "Jambes Tentacules"

#. ~ Description of mutation "Leg Tentacles"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on"
" land by 20%, makes your movement silent, increases your swimming speed and "
"reduces wet penalties, but you can't use footwear any more."
msgstr ""
"Vos jambes se sont transformées en six tentacules. Cela bien sûr rend "
"l'utilisation de chaussures impossible, diminue votre vitesse au sol de 20%,"
" rend vos mouvements silencieux, augmente votre vitesse de nage, et réduit "
"les pénalités dues à l'humidité."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Bracing"
msgstr "Ventouses de Tentacule"

#. ~ Description of mutation "Tentacle Bracing"
#: data/json/mutations/mutations.json
msgid ""
"Your lower tentacles have developed suckers, perfect for walking along lake "
"beds and ocean floors.  They make land movement marginally more tiring, do a"
" good job of keeping you set in place."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scuttle"
msgstr ""

#. ~ Description of mutation "Scuttle"
#: data/json/mutations/mutations.json
msgid ""
"Your hook-shaped feet curl inward to grip the ground, allowing you to easily"
" walk along the bottom when you're underwater.  They're also a bit quicker "
"at climbing over obstacles, even on dry land."
msgstr ""

#. ~ Description of mutation "Lizard"
#: data/json/mutations/mutations.json
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr ""

#. ~ Description of mutation "Gastropod"
#: data/json/mutations/mutations.json
msgid ""
"You feel bad for all the creatures that don't carry their home on their "
"backs."
msgstr ""
"Vous avez de la peine pour toute les choses vivant sans une maison sur leur "
"dos."

#. ~ Description of mutation "Bird"
#: data/json/mutations/mutations.json
msgid ""
"You're sure you'll fly someday.  In the meantime, there are still nests to "
"build."
msgstr ""
"Vous avez la certitude que vous serez capable de voler un jour, en "
"attendant, vous avez des nids à construire."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aquatic"
msgstr "Aquatique"

#. ~ Description of mutation "Aquatic"
#: data/json/mutations/mutations.json
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And"
" enjoy.  What was that about a surface?"
msgstr ""
"Quatre-vingt-dix pourcents de la planète son les vôtres à apprécier, "
"explorer et coloniser. Pourquoi est-ce que la surface vous manquerait?"

#. ~ Description of mutation "Beast"
#: data/json/mutations/mutations.json
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr ""

#. ~ Description of mutation "Feline"
#: data/json/mutations/mutations.json
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wolf"
msgstr "Loup"

#. ~ Description of mutation "Wolf"
#: data/json/mutations/mutations.json
msgid "You're the perfect candidate to lead a pack."
msgstr "Vous êtes le candidat parfait pour chef de meute."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bear"
msgstr "Ours"

#. ~ Description of mutation "Bear"
#: data/json/mutations/mutations.json
msgid "So the humans died; what's the worry?  Now they won't ruin the woods."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine"
msgstr "Bovin"

#. ~ Description of mutation "Bovine"
#: data/json/mutations/mutations.json
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr ""

#. ~ Description of mutation "Insect"
#: data/json/mutations/mutations.json
msgid ""
"It would be good to be a queen, having workers constantly servicing your "
"every need… but how would you keep them in line?"
msgstr ""

#. ~ Description of mutation "Plant"
#: data/json/mutations/mutations.json
msgid ""
"Well, you still have those other walking flowers--and the mushrooms, too--to"
" deal with.  But you'll manage."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aqueous"
msgstr "Aqueux"

#. ~ Description of mutation "Aqueous"
#: data/json/mutations/mutations.json
msgid ""
"What was that old advertisement?  'Paint the planet'?  That might be a good "
"long-term goal, but for now…"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean"
msgstr "Souterrain"

#. ~ Description of mutation "Subterranean"
#: data/json/mutations/mutations.json
msgid ""
"Not much point to rebuilding up in that horribly bright, roofless wasteland."
"  Now that you've become accustomed to your new digs, there's the beginning "
"of a great empire right here, underground."
msgstr ""

#. ~ Description of mutation "Cephalopod"
#: data/json/mutations/mutations.json
msgid ""
"Strange aeons, true, but Death seems to be slacking, and you are doing just "
"fine."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid"
msgstr "Arachnide"

#. ~ Description of mutation "Arachnid"
#: data/json/mutations/mutations.json
msgid "Well, maybe you'll just have to make your own worldwide web."
msgstr ""
"Peut être que vous allez devoir remplacer l'internet avec une autre toile "
"mondiale?"

#. ~ Mutation name
#. ~ Name suffix of an NPC
#. ~ A rural holdout survivor living in a barn or a forest or something, all
#. by themselves.  At some point this NPC should get special dialogue.
#. ~ A survivor who sometimes visits the refugee center.
#. ~ Name of an NPC class
#. ~ A wandering survivor, a pretty tough and capable dude.  Represents an NPC
#. version of a person much like the player.
#. ~ A random scavenger visiting the refugee center to check it out, just like
#. you.
#: data/json/mutations/mutations.json data/json/npcs/holdouts/rural.json
#: data/json/npcs/random_encounters/john_bailey.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_visiting_scavenger.json
#: data/mods/Aftershock/npcs/Backgrounds/BG_traits_afs.json
msgid "Survivor"
msgstr "Survivant"

#. ~ Description of mutation "Survivor"
#: data/json/mutations/mutations.json
msgid ""
"Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prototype"
msgstr "Prototype"

#. ~ Description of mutation "Prototype"
#: data/json/mutations/mutations.json
msgid "After all those experiments, what's a few more, hmm?"
msgstr ""
"Sûrement une ou deux expériences de plus après toutes les précédentes ne "
"serait pas de trop?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime"
msgstr ""

#. ~ Description of mutation "Prime"
#: data/json/mutations/mutations.json
msgid "You're the perfect candidate to tidy this mess."
msgstr "Vous êtes la personne parfaite pour nettoyer tout ce désordre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey"
msgstr "Fée"

#. ~ Description of mutation "Fey"
#: data/json/mutations/mutations.json
msgid ""
"You are the tree under which humankind will shelter during these dark times."
msgstr ""
"Vous êtes l'arbre sous lequel l'humanité s'abritera durant ces jours noirs."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chaos"
msgstr "Chaos"

#. ~ Description of mutation "Chaos"
#: data/json/mutations/mutations.json
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens."
msgstr ""
"Vous n'êtes plus capable de définir ce que vous êtes, tout et en même temps "
"rien, comme si vous n'étiez pas censé(e) exister du tout, mais vous existez,"
" et vous êtes une force inarrêtable, peu importe ce qui peut arriver."

#. ~ Description of mutation "Raptor"
#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr ""
"Une chance de revenir de non pas une, mais DEUX extinctions de masse. Vous "
"avez la certitude que vous allez bien vous en sortir."

#. ~ Description of mutation "Batrachian"
#: data/json/mutations/mutations.json
msgid "A perfect ambush predator, if only there were less competition."
msgstr ""
"Vous êtes un prédateur d'ambuche parfait, si seulement il y avait moins de "
"compétition ces jours-ci."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Diminutive"
msgstr "Minuscule"

#. ~ Description of mutation "Diminutive"
#: data/json/mutations/mutations.json
msgid ""
"So much food, everywhere!  And nobody's even guarding it anymore!  These are"
" good times."
msgstr ""
"Tellement de nourriture partout! Et personne pour vous empêcher de la "
"prendre! Des beaux jours s'annoncent."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Gateway"
msgstr ""

#. ~ Description of mutation "Marloss Gateway"
#: data/json/mutations/mutations.json
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr ""

#. ~ Description of mutation "Mycus"
#: data/json/mutations/mutations.json
msgid "We are the Mycus."
msgstr "Nous sommes le Mycus"

#. ~ Description of mutation "Crustacean"
#: data/json/mutations/mutations.json
msgid "Who needs skin when you can have a hard carapace?"
msgstr "Qui aurait besoin d'une peau au lieu d'une carapace solide?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acidproof"
msgstr "Résistant à l'acide"

#. ~ Description of mutation "Acidproof"
#: data/json/mutations/mutations.json
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "Votre peau a acquis une résistance contre les substances corrosives."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acid Blood"
msgstr "Sang Acide"

#. ~ Description of mutation "Acid Blood"
#: data/json/mutations/mutations.json
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pyromaniac"
msgstr "Pyromane"

#. ~ Description of mutation "Pyromaniac"
#: data/json/mutations/mutations.json
msgid ""
"You have an unhealthy obsession with fire, and you get anxious if you don't "
"light them every now and then or stand near them often.  However, you gain a"
" mood bonus from doing so."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amphibious"
msgstr "Amphibien"

#. ~ Description of mutation "Amphibious"
#: data/json/mutations/mutations.json
msgid ""
"You're as comfortable in water as on land, and your body has adapted around "
"that fact.  Your base swimming speed is greatly increased, and weight will "
"hinder you much less while swimming."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lidless Eyes"
msgstr "Yeux sans Paupières"

#. ~ Description of mutation "Lidless Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Like a true fish, your eyes lack eyelids, and are instead covered by a "
"translucent, protective membrane that blocks irritants and water, and "
"provides minor armor.  It also allows you to sleep with your eyes open!  "
"Activate to cause the approach of hostile creatures to wake you up."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aqueous Repose"
msgstr "Calme Aquatique"

#. ~ Description of mutation "Aqueous Repose"
#: data/json/mutations/mutations.json
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there.  You can also eat underwater, though you can't drink."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toxic Flesh"
msgstr "Chair Toxique"

#. ~ Description of mutation "Toxic Flesh"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh is highly poisonous, and creatures that bite you will receive a "
"nasty surprise."
msgstr ""
"Votre chair est hautement toxique, et toute créature ayant la mauvaise idée "
"de vous mordre le regrettera amèrement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Freshwater Osmosis"
msgstr "Osmose en Eau Douce"

#. ~ Description of mutation "Freshwater Osmosis"
#: data/json/mutations/mutations.json
msgid ""
"Your gills and skin are highly permeable to moisture, and you can hydrate "
"your body through osmosis.  While submerged in fresh water, any thirst you "
"might have will be slaked."
msgstr ""
"Vos branchies et votre peau sont hautement perméables, et il est possible "
"pour vous de vous hydrater par osmose. Vous êtes capable d'étancher votre "
"soif en vous submergeant dans de l'eau douce."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Electroreceptors"
msgstr "Electrorécepteurs"

#. ~ Description of mutation "Electroreceptors"
#: data/json/mutations/mutations.json
msgid ""
"A network of jelly-filled electroreceptors, like that of a shark, have grown"
" throughout your face and nose.  They are very sensitive to magnetic fields,"
" allowing you to see robots and creatures charged with electricity through "
"walls, but being shocked will seriously mess you up."
msgstr ""
"Un réseau d'électrorécepteurs remplie de gelée, similaire aux ampoules de "
"Lorenzini de requins, s'est formé à travers votre visage et nez. Ces "
"ampoules sont très sensibles aux champs magnétiques, et il vous est "
"maintenant possible de détecter tout ennemi robotique ou capable d'émettre "
"de l'électricité dans les environs, avec pour défaut le fait que vous faire "
"électrocuter est maintenant extrêmement douloureux."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shark Teeth"
msgstr "Dents de Requin"

#. ~ Description of mutation "Shark Teeth"
#: data/json/mutations/mutations.json
msgid ""
"Your teeth have grown incredibly sharp, and have calcified even further.  In"
" addition to letting you eat much faster, you can use them as a lethal "
"natural weapon, as long as your anatomy favors it.  They also grow very "
"fast, and you harmlessly shed them more or less at random."
msgstr ""

#. ~ Message when player with mutation "Shark Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your teeth!"
msgstr ""

#. ~ Message when NPC with mutation "Shark Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their teeth!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Police Officer"
msgstr "Officier de police"

#. ~ Description of mutation "Police Officer"
#. ~ Description of mutation "SWAT Officer"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "SWAT Officer"
msgstr "Officier du SWAT"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Churl"
msgstr "Rustre"

#. ~ Description of mutation "Churl"
#: data/json/mutations/mutations.json
msgid ""
"Thou art a lewede man, a lowly cowherd, though where thi catel been thou "
"hast not ynn certain."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Police Detective"
msgstr "Détective"

#. ~ Description of mutation "Police Detective"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn law enforcement investigator, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"your shield means anything now is another question."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "US Marshal"
msgstr "Marshal Américain"

#. ~ Description of mutation "US Marshal"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn Federal marshal, with nationwide jurisdiction and the "
"authority of the United States of America."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hub 01 Ancillary"
msgstr "Auxiliaire d'Hub 01"

#. ~ Description of mutation "Hub 01 Ancillary"
#: data/json/mutations/mutations.json
msgid ""
"You are known to be a capable and resourceful mercenary at the employ of Hub"
" 01."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "True Foodperson"
msgstr ""

#. ~ Description of mutation "True Foodperson"
#: data/json/mutations/mutations.json
msgid ""
"You are the true Foodperson, some might think Foodperson is just a mascot, "
"but you know better.  You are Foodperson, the mask has become your face; you"
" are real, and the only thing standing between this world and oblivion is "
"you."
msgstr ""

#. ~ Description of mutation "MD"
#: data/json/mutations/mutations.json
msgid ""
"You were just through with the administrative formalities for your residency"
" when the Cataclysm struck.  \"Your\" hospital was overrun and evacuated, "
"but there's always work for a good doctor."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Skater"
msgstr "Skateur"

#. ~ Description of mutation "Skater"
#: data/json/mutations/mutations.json
msgid ""
"You are skilled in maneuvering on skates.  You suffer lower penalties to "
"dodging and are less likely to fall down if hit in melee combat while you're"
" wearing rollerskates or rollerblades."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Martial Artist"
msgstr "Experte en arts martiaux"

#. ~ Description of mutation "Martial Artist"
#: data/json/mutations/mutations.json
msgid ""
"You were shaping up to be a pretty decent student of the martial arts before"
" the Cataclysm struck.  Time to see just how good you really are."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Black Belt"
msgstr "Ceinture Noire"

#. ~ Description of mutation "Black Belt"
#: data/json/mutations/mutations.json
msgid ""
"You were competitive at national levels, and had considered teaching your "
"art.  Defending against the entire town may still be a challenge, though."
msgstr ""
"Vous étiez en compétition au niveau national, et souhaitiez enseignez votre "
"art. Vous défendre contre une ville entière reste un défi par contre."

#. ~ Description of mutation "Pugilist"
#: data/json/mutations/mutations.json
msgid ""
"You are experienced in the Sweet Science of boxing.  You could've had a shot"
" at a local boxing tournament, if the Cataclysm hadn't screwed that up."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Kickboxer"
msgstr ""

#. ~ Description of mutation "Kickboxer"
#: data/json/mutations/mutations.json
msgid ""
"You have some training in the art of kickboxing.  It's just boxing with "
"kicks, right?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Autodoc Specialist"
msgstr "Spécialiste de l'Autodoc"

#. ~ Description of mutation "Autodoc Specialist"
#: data/json/mutations/mutations.json
msgid ""
"You're trained in proper operation of the Autodoc, an advanced machine used "
"for surgical procedures.  Operations involving it will be moderately more "
"likely to succeed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dungeon Master"
msgstr "Maître de Donjon"

#. ~ Description of mutation "Dungeon Master"
#: data/json/mutations/mutations.json
msgid ""
"Weeks spent picking through manuals and researching topics you aren't versed"
" in has taught you to find what you need to know more quickly.  You read "
"slightly faster, and suffer no reading time penalty for books too complex "
"for you to easily understand."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Brandy"
msgstr "Porte du Brandy"

#. ~ Description of mutation "Carries Brandy"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries brandy!"
msgstr "Ce Barman porte maintenant du brandy!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Rum"
msgstr "Porte du Rhum"

#. ~ Description of mutation "Carries Rum"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries rum!"
msgstr "Ce Barman porte maintenant du rhum!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Whiskey"
msgstr "Porte du Whisky"

#. ~ Description of mutation "Carries Whiskey"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries whiskey!"
msgstr "Ce Barman porte maintenant du whisky!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 1 Companion Missions"
msgstr ""

#. ~ Description of mutation "Has Level 1 Companion Missions"
#: data/json/mutations/mutations.json
msgid "New mission options have become available!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 1 Construction Built"
msgstr ""

#. ~ Description of mutation "Has Level 1 Construction Built"
#. ~ Description of mutation "Has Level 2 Construction Built"
#: data/json/mutations/mutations.json
msgid "New options may have become available!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 2 Construction Built"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Starting NPC"
msgstr "PNJ de Départ"

#. ~ Description of mutation "Starting NPC"
#: data/json/mutations/mutations.json
msgid "Marker for starting NPCs"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Static NPC"
msgstr "PNJ Statique"

#. ~ Description of mutation "Static NPC"
#: data/json/mutations/mutations.json
msgid "Marker for static NPCs"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hallucination"
msgstr "Hallucination"

#. ~ Description of mutation "Hallucination"
#: data/json/mutations/mutations.json
msgid ""
"NPC trait that makes them be hallucination.  It is a bug if you have it."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ignores Sounds"
msgstr ""

#. ~ Description of mutation "Ignores Sounds"
#: data/json/mutations/mutations.json
msgid ""
"NPC ignores sounds and does not investigate them.  If you see this, it's is "
"a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Will Not Bash"
msgstr ""

#. ~ Description of mutation "Will Not Bash"
#: data/json/mutations/mutations.json
msgid "NPC will not bash to reach things.  If you see this, it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Returns to Start POS"
msgstr ""

#. ~ Description of mutation "Returns to Start POS"
#: data/json/mutations/mutations.json
msgid "NPC will return to its spawn position on idle."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assign Random Mission"
msgstr ""

#. ~ Description of mutation "Assign Random Mission"
#: data/json/mutations/mutations.json
msgid ""
"This is an AI tag to give a static NPC a random mission.  If you see this, "
"it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assign Random Nomove Mission"
msgstr ""

#. ~ Description of mutation "Assign Random Nomove Mission"
#: data/json/mutations/mutations.json
msgid ""
"This is an AI tag to give a static NPC a random mission that doesn't involve"
" them following you.  If you see this, it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Tail"
msgstr "Queue de Débugage"

#. ~ Description of mutation "Debug Tail"
#: data/json/mutations/mutations.json
msgid "Gain a tail bodypart."
msgstr "Vous ajoute une queue comme nouveau membre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug No Torso"
msgstr "Manque de Torse de Débugage"

#. ~ Description of mutation "Debug No Torso"
#: data/json/mutations/mutations.json
msgid "They said college costs an arm and a leg, they sure weren't kidding!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Big Head"
msgstr ""

#. ~ Description of mutation "Debug Big Head"
#: data/json/mutations/mutations.json
msgid "They said college what make me smart, this is a lot to lug around!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Night Vision"
msgstr "Vision Nocturne de Débugage"

#. ~ Description of mutation "Debug Night Vision"
#. ~ Description of mutation "Debug Clairvoyance"
#: data/json/mutations/mutations.json
msgid "You can clearly see that this is for dev purposes only."
msgstr ""
"Vous pouvez clairement \"voir\" (hehe) que ceci est seulement sensé être "
"utilisé dans le processus de développement et débugage."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Clairvoyance"
msgstr "Clairvoyance de Débugage"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Clairvoyance Super"
msgstr "Super Clairvoyance de Débugage"

#. ~ Description of mutation "Debug Clairvoyance Super"
#: data/json/mutations/mutations.json
msgid "You can see all the bugs with this one."
msgstr "Vous pouvez voir tout les bugs avec ce pouvoir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Invisibility"
msgstr "Invisibilité de Débugage"

#. ~ Description of mutation "Debug Invisibility"
#: data/json/mutations/mutations.json
msgid "If you see this, you'd best be debugging something."
msgstr "Vous ne devriez voir ceci que si vous êtes en train de débuguer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Life Support"
msgstr "Soutien de Vie de Débugage"

#. ~ Description of mutation "Debug Life Support"
#: data/json/mutations/mutations.json
msgid ""
"Holds hunger, thirst, and fatigue stable.  You can debug all year long with "
"this one!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Cardio"
msgstr "Endurance de Débugage"

#. ~ Description of mutation "Debug Cardio"
#: data/json/mutations/mutations.json
msgid "You can run, but you'll never run out of breath."
msgstr "Vous pouvez maintenant courir sans jamais vous essouffler."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug 9000 HP"
msgstr "9000 PV de Débugage"

#. ~ Description of mutation "Debug 9000 HP"
#: data/json/mutations/mutations.json
msgid "If you need to survive the deadliest bug attacks."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Regeneration"
msgstr ""

#. ~ Description of mutation "Debug Regeneration"
#: data/json/mutations/mutations.json
msgid "Heal yourself from this stupid bug attacks."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Deodorizer"
msgstr "Déodorant de Débugage"

#. ~ Description of mutation "Debug Deodorizer"
#: data/json/mutations/mutations.json
msgid "Smell that bug?  Smell's certainly not coming from you!"
msgstr ""
"Vous sentez cette odeur de bug? Elle ne vient certainement pas de vous!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Silent Walk"
msgstr "Marche Silencieuse de Débugage"

#. ~ Description of mutation "Debug Silent Walk"
#: data/json/mutations/mutations.json
msgid "Be vewwy vewwy quiet.  We're hunting bugs."
msgstr ""
"Soyyyyeeezzz vraimmmeeennnt vraimmmeeennt silencieux,   ou les bugs qu'on "
"traque pourraient s'enfuir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Mana"
msgstr ""

#. ~ Description of mutation "Debug Mana"
#: data/json/mutations/mutations.json
msgid "To cast bug killing spells.  Also increase the cast speed of spells."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug HVAC"
msgstr "CVC de Débugage"

#. ~ Description of mutation "Debug HVAC"
#: data/json/mutations/mutations.json
msgid "Temperature and weather won't bug you."
msgstr ""
"Vous êtes maintenant parfaitement chauffé(e), ventilé(e) et climatisé(e)."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Invincibility"
msgstr "Invisibilité de Débugage"

#. ~ Description of mutation "Debug Invincibility"
#: data/json/mutations/mutations.json
msgid "Bug-repellent forcefield."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Hammerspace"
msgstr ""

#. ~ Description of mutation "Debug Hammerspace"
#: data/json/mutations/mutations.json
msgid ""
"Crafting and construction requirements bugger off with this one.  Apply with"
" care."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Crafting Virtuoso"
msgstr ""

#. ~ Description of mutation "Debug Crafting Virtuoso"
#: data/json/mutations/mutations.json
msgid "Crafting failures won't bug you any more."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Crafting Speed"
msgstr ""

#. ~ Description of mutation "Debug Crafting Speed"
#: data/json/mutations/mutations.json
msgid "Craft the bug out 50 times faster."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Mind Control"
msgstr ""

#. ~ Description of mutation "Debug Mind Control"
#: data/json/mutations/mutations.json
msgid "Mind the bugs, would you kindly?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Bionic Installation"
msgstr ""

#. ~ Description of mutation "Debug Bionic Installation"
#: data/json/mutations/mutations.json
msgid "Lets you instantly install torsion ratchets for your eight legs."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Speed"
msgstr ""

#. ~ Description of mutation "Debug Speed"
#: data/json/mutations/mutations.json
msgid "With this, you'll be fixing those bugs faster than ever!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Squeamish"
msgstr "Délicat"

#. ~ Description of mutation "Squeamish"
#: data/json/mutations/mutations.json
msgid ""
"You can't even think about putting filthy clothes on yourself, especially "
"from zombies' corpses."
msgstr ""
"Vous ne songez même pas à porter des vêtements crasseux sur vous, surtout "
"s'ils viennent de corps de zombies."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bee"
msgstr "Abeille"

#. ~ Description of mutation "Bee"
#: data/json/mutations/mutations.json
msgid ""
"NPC trait that makes monsters see it as a bee.  It is a bug (heh) if you "
"have it."
msgstr ""
"Trait d'un NPC faisant voir les monstres comme des abailles. C'est un bug "
"(eheh) si vous l'avez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus friend"
msgstr "Ami du Mycus"

#. ~ Description of mutation "Mycus friend"
#: data/json/mutations/mutations.json
msgid "NPC trait that makes fungaloid monsters see this NPC as a friend."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mute"
msgstr "Muet"

#. ~ Description of mutation "Mute"
#: data/json/mutations/mutations.json
msgid "Trait that makes it impossible to say anything."
msgstr "Vous êtes muet."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nomad"
msgstr "Nomade"

#. ~ Description of mutation "Nomad"
#: data/json/mutations/mutations.json
msgid ""
"You're too adventurous for your own good.  The more time you spend "
"somewhere, the unhappier it makes you to be there."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antsy"
msgstr ""

#. ~ Description of mutation "Antsy"
#: data/json/mutations/mutations.json
msgid ""
"You can't bear to stay still for long.  Your morale will suffer unless you "
"constantly explore new territory."
msgstr ""
"Vous ne pouvez simplement pas rester au même endroit de façon prolongée. "
"Votre moral se détériorera si vous n'explorez pas des nouvelles terres "
"régulièrement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Restless"
msgstr ""

#. ~ Description of mutation "Restless"
#: data/json/mutations/mutations.json
msgid ""
"Spending any amount of time in familiar places makes you miserable.  Must.  "
"Keep.  Moving."
msgstr ""
"Ne pas bouger constamment vous rends totalement misérable. Vous avez un "
"besoin indomptable d'explorer des endroits inconnus. "

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wayfarer"
msgstr "Amaxophobe"

#. ~ Description of mutation "Wayfarer"
#: data/json/mutations/mutations.json
msgid ""
"Whether from personal choice or childhood trauma, traveling with vehicles is"
" off-limits to you, even if your life depended on it."
msgstr ""
"Que ce soit dû à un choix personnel ou un traumatisme d'enfance, vous "
"n'arrivez pas à vous forcer à voyager dans des véhicules même si votre vie "
"en dépend."

#. ~ Description of mutation "Brawler"
#: data/json/mutations/mutations.json
msgid ""
"Whether from personal choice or childhood trauma, using ranged weapons is "
"off-limits to you, even if your life depended on it."
msgstr ""
"Que ce soit dû à un choix personnel ou un traumatisme d'enfance, vous "
"refusez totalement d'utiliser des armes à distance même si votre vie en "
"dépend."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Reflexes"
msgstr "Réflexes Rapides"

#. ~ Description of mutation "Fast Reflexes"
#: data/json/mutations/mutations.json
msgid "You have fast reflexes, allowing you to dodge attacks more easily."
msgstr ""
"Vous avez des réflexes rapides vous permettant d'esquiver des attaques plus "
"facilement."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lagomorph"
msgstr "Lagomorphe"

#. ~ Description of mutation "Lagomorph"
#: data/json/mutations/mutations.json
msgid ""
"You really want to eat some carrots.  Welcome to the Lagomorpha family."
msgstr ""
"Vous avez vraiment envie de manger des carottes. Bienvenue dans la famille "
"Lagomorpha."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Ears"
msgstr "Oreilles de Lapin"

#. ~ Description of mutation "Rabbit Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have grown into tall, flexible and pretty rabbit ears.  They're "
"are slender and enhance your hearing beyond the normal range."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Tail"
msgstr "Queue de Lapin"

#. ~ Description of mutation "Rabbit Tail"
#: data/json/mutations/mutations.json
msgid ""
"Your stubby tail has become fuzzy and more round.  It looks adorable, but "
"doesn't seem to serve another purpose beyond that."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Fur"
msgstr "Fourrure de Lapin"

#. ~ Description of mutation "Rabbit Fur"
#: data/json/mutations/mutations.json
msgid ""
"Your fur keeps you covered in winter, maintaining heat and allowing you to "
"better tolerate cold temperatures."
msgstr ""
"Votre fourrure est conçue pour vous maintenir au chaud durant l'hiver, vous "
"permettant de tolérer des températures plus froides qu'auparavant."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Feet"
msgstr "Pied de Lapin"

#. ~ Description of mutation "Rabbit Feet"
#: data/json/mutations/mutations.json
msgid ""
"Your feet have grown into strong and large rabbit feet.  This makes your "
"kicks pack a little more oomph.  Emphasis on little.  It also offers some "
"warmth, and the lucky part is but superstition.  The downside is you are "
"unable to wear shoes."
msgstr ""

#. ~ Message when player with mutation "Rabbit Feet" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You kick %s with your large feet!"
msgstr "Vous assenez un coup à %s avec vos gros pieds!"

#. ~ Message when NPC with mutation "Rabbit Feet" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s kicks %2$s with their large feet!"
msgstr "%1$s assène un coup à %2$s avec ses gros pieds!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Nose"
msgstr "Nez de Lapin"

#. ~ Description of mutation "Rabbit Nose"
#: data/json/mutations/mutations.json
msgid ""
"Your nose has morphed into a cute bunny nose, along with the snout.  It's "
"extremely twitchy too."
msgstr ""
"Votre nez s'est transformé en une mignonne petite truffe de lapin qui "
"n'arrête pas de se trémousser."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Little Paws"
msgstr "Petites Pattes"

#. ~ Description of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your hands have elongated and look a bit more like paws.  It makes fine "
"manipulation a little more difficult, but you can still probably manage.  "
"Plus, they allow you to move on all fours when crouching and unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hunted"
msgstr "Chassé"

#. ~ Description of mutation "Hunted"
#: data/json/mutations/mutations.json
msgid ""
"Since the start of the Cataclysm, something has been hunting you "
"relentlessly.  You can outrun it, but it always seems to find you "
"eventually.  The only escape is for one of you to die."
msgstr ""

#. ~ Description of mutation "Numb"
#: data/json/mutations/mutations.json
msgid "Your ability to feel or express emotion has been greatly hampered."
msgstr ""
"Votre capacité à ressentir ou exprimer toute émotion est très limitée."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Booming Voice"
msgstr "Voix Tonitruante"

#. ~ Description of mutation "Booming Voice"
#: data/json/mutations/mutations.json
msgid ""
"You know how to project your voice.  You are able to shout much louder than "
"the average person."
msgstr ""
"Vous savez comment projeter votre voix. Vous êtes capable de crier beaucoup "
"plus fort que la normale."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Flexibility"
msgstr "Souplesse Féline"

#. ~ Description of mutation "Feline Flexibility"
#: data/json/mutations/mutations.json
msgid ""
"Your muscles, joints, and the movement center of your brain have changed "
"internally somewhat, allowing you to traverse obstacles with ease."
msgstr ""
"Vos muscles, articulations, et l'architecture de votre cerveau ont "
"légèrement changés à l'intérieur, vous permettant de traverser les obstacles"
" et terrains difficiles avec aisance."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hates Water"
msgstr "Hydrophobique"

#. ~ Description of mutation "Hates Water"
#: data/json/mutations/mutations.json
msgid ""
"You really hate getting your fur all wet.  This increases morale penalties "
"for being wet, and you will get them even when wearing appropriate clothing."
msgstr ""
"Vous n'aimez pas du tout mouiller votre fourrure. Ceci augment les pénalités"
" de moral subies lorsque vous êtes mouillé(e), et vous les subirez même "
"lorsque vous portez des vêtements limitant ceci."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Imitation Carnivore"
msgstr "Carnivore d'Imitation"

#. ~ Description of mutation "Imitation Carnivore"
#: data/json/mutations/mutations.json
msgid ""
"Fake mutation to allow post-threshold Ursine mutants access to mutations "
"normally gated behind Carnivore.  This is not meant to be visible in-game."
msgstr ""
"Mutation factice pour permettre aux mutants Ursins ayant passé le palier "
"d'accéder aux mutations normalement bloquées derrière la mutation Carnivore."
" Ceci n'est pas censé être normalement visible."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Resilient Physiology"
msgstr "Physiologie Résiliente"

#. ~ Description of mutation "Resilient Physiology"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is well-adapted to resist trauma.  20% bonus to all hit points.  "
"Stacks with Tough, etc."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solid Physiology"
msgstr "Physiologie Robuste"

#. ~ Description of mutation "Solid Physiology"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is extremely well-adapted to resist trauma.  30% bonus to all hit "
"points.  Stacks with Tough, etc."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tainted Shadow"
msgstr "Ombre Corrompue"

#. ~ Description of mutation "Tainted Shadow"
#: data/json/mutations/mutations.json
msgid "You shouldn't see this.  This makes you spawn tainted shadows."
msgstr ""
"Vous ne devriez pas pouvoir voire ceci. Ceci est appliqué à votre personnage"
" pour invoquer des ombres corrompues"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nyctophobia"
msgstr "Nyctophobie"

#. ~ Description of mutation "Nyctophobia"
#: data/json/mutations/mutations.json
msgid ""
"You are terribly afraid of the dark.  You refuse to enter very dark areas.  "
"If you somehow still happen to stay in dark areas, you suffer from various "
"detrimental mental and physical effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cold Tolerance"
msgstr "Tolérance au Froid"

#. ~ Description of mutation "Cold Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You fare better than most in colder climates and are less bothered by lower "
"temperatures.  Note that while you are slightly less prone to developing "
"frostbite as a result, you aren't any better at dealing with the symptoms."
msgstr ""
"Vous vous débrouillez mieux dans les climats froids et êtes moins gêné(e) "
"par les temperatures basses. Bien que ceci veut dire que vous êtes moins "
"susceptible aux engelures, ceci ne vous aide en aucun cas à surmonter les "
"symptômes de celles-ci."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Cold Tolerance"
msgstr "Haute Tolérance au Froid"

#. ~ Description of mutation "High Cold Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You are now even less bothered by the cold and it is harder for you to "
"freeze or to even get chilly.  When you do though, it'll hit just as hard as"
" it did before."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heat Tolerance"
msgstr "Tolérance à la Chaleur"

#. ~ Description of mutation "Heat Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You fare better than most in warmer climates and are less bothered by hotter"
" temperatures.  Note that while you'll sweat a little less in close "
"proximity to a fire as a result, burns will still hurt just as much."
msgstr ""
"Vous vous débrouillez mieux dans les climats chauds et êtes moins gêné(e) "
"par les temperatures élevées. Bien que ceci veut dire que vous suez moins et"
" êtes moins susceptible aux coups de chaleur, ceci ne vous aide en aucun cas"
" à surmonter les symptômes de ceux-ci."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Heat Tolerance"
msgstr "Haute Tolérance à la Chaleur"

#. ~ Description of mutation "High Heat Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You are now even less bothered by the heat and it is harder for you to "
"overheat or even sweat.  When you do though, it'll hit just as hard as it "
"did before."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Colorful Skin"
msgstr "Peau Colorée"

#. ~ Description of mutation "Colorful Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered in shifting patterns of dots, lines, and swirls.  This "
"is outside of your control and does not help your stealth.  In fact, it "
"makes you more noticeable."
msgstr ""
"Votre peau est couverte de motifs changeants consistant de points, lignes et"
" courbes. Ceci est totalement hors de votre contrôle et n'aide vraiment pas "
"lorsque vous essayez de vous cacher."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Camouflage Skin"
msgstr "Peau Caméléon"

#. ~ Description of mutation "Camouflage Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your can change your skin patterns to match your environment, somewhat "
"increasing your stealthiness."
msgstr ""
"Vous êtes capable de changer l'apparence de votre peau pour imiter votre "
"environnement, ceci vous rendant beaucoup plus difficile à remarquer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Mind"
msgstr "Mental Céphalopode"

#. ~ Description of mutation "Cephalopod Mind"
#: data/json/mutations/mutations.json
msgid ""
"Your mind has been altered in such a way that you now find it very difficult"
" to understand humans.  Your capability to persuade and lie to them suffers "
"slightly, even if it is mitigated by your intelligence.  In addition, while "
"you find it much easier to learn by doing now, the plasticity of your psyche"
" means you forget skills much faster."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Highly Vain"
msgstr ""

#. ~ Description of mutation "Highly Vain"
#: data/json/mutations/mutations.json
msgid ""
"You know you're beautiful, and the world deserves to know it too.  You "
"prefer to show off your stunningly good looks to the world and will be "
"unhappy if you cover up your face."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Picky Eater"
msgstr ""

#. ~ Description of mutation "Picky Eater"
#: data/json/mutations/mutations.json
msgid ""
"You're a very picky eater.  You refuse to eat any food that tastes bad "
"unless you're starving."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Superiority Complex"
msgstr ""

#. ~ Description of mutation "Superiority Complex"
#: data/json/mutations/mutations.json
msgid ""
"You can't stand to prostrate yourself before your lessers and hate it when "
"they don't immediately do what you say.  Persuasion is much more difficult, "
"but you're better at lying and intimidating."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/vitfrified_trait.json
msgid "Comfortably Fluid"
msgstr ""

#. ~ Description of mutation "Comfortably Fluid"
#: data/json/mutations/vitfrified_trait.json
msgid ""
"You can hear your heartbeat in your ears, feel the blood sloshing around in "
"your veins.  The uneven hitches in your breath, the aches in your joints, "
"the rumbling of your stomach.  It's nasty and messy and ugly.  And you are "
"extremely grateful for that."
msgstr ""

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Confused 1"
msgstr "Survivant : Éberlué 1"

#. ~ Description of mutation "Survivor: Confused 1"
#. ~ Description of mutation "Survivor: No Past 1"
#. ~ Description of mutation "Survivor: No Past 2"
#. ~ Description of mutation "Survivor: No Past 3"
#. ~ Description of mutation "Survivor: No Past 4"
#. ~ Description of mutation "Survivor: No Past 5"
#. ~ Description of mutation "Survivor: Religious 1"
#. ~ Description of mutation "Survivor: Religious 2"
#. ~ Description of mutation "Survivor: Dreamer 1"
#. ~ Description of mutation "Survivor: Wedding 1"
#. ~ Description of mutation "Survivor: Evacuee 1"
#. ~ Description of mutation "Survivor: Evacuee 2"
#. ~ Description of mutation "Survivor: Evacuee 3"
#. ~ Description of mutation "Survivor: Evacuee 4"
#. ~ Description of mutation "Survivor: Evacuee 5"
#. ~ Description of mutation "Survivor: Evacuee 6"
#. ~ Description of mutation "Survivor: FEMA Evacuee 1"
#. ~ Description of mutation "Survivor: Left for Dead 1"
#. ~ Description of mutation "Survivor: Left for Dead 2"
#. ~ Description of mutation "Survivor: Left for Dead 3"
#. ~ Description of mutation "Survivor Story"
#: data/json/npcs/BG_traits.json
msgid "This NPC could tell you about how they survived the Cataclysm."
msgstr ""

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: No Past 1"
msgstr "Survivant : Aucun Passé 1"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: No Past 2"
msgstr "Survivant : Aucun Passé 2"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: No Past 3"
msgstr "Survivant : Aucun Passé 3"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: No Past 4"
msgstr "Survivant : Aucun Passé 4"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: No Past 5"
msgstr "Survivant : Aucun Passé 5"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Religious 1"
msgstr "Survivant: Religieux 1"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Religious 2"
msgstr "Survivant: Religieux 2"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Dreamer 1"
msgstr "Survivant: Rêveur 1"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Wedding 1"
msgstr "Survivant: Marriage 1"

#. ~ Mutation name
#: data/json/npcs/BG_traits.json
msgid "Survivor: Evacuee 1"
msgstr "Survivant: Évacué 1"

