msgid_plural "firefighter zombies"
msgstr[0] "pompier zombifié"
msgstr[1] "pompiers zombifiés"
msgstr[2] "pompiers zombifiés"

#. ~ Description of monster "firefighter zombie"
#: data/json/monsters/zed-classic.json
msgid ""
"A decaying human body clad in tattered firefighting gear.  It staggers "
"aimlessly, reeking of smoke and decay.  Its protective mask prevents it from"
" attempting to bite you."
msgstr ""

#. ~ Monster name
#: data/json/monsters/zed-classic.json
