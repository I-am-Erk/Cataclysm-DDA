msgstr "Des visions de forêts inconnues habitent vos pensées."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "You picture yourself as one branch among many."
msgstr "Vous vous visualisez comme une branche parmi une multitude."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
msgid "New knowledge blooms within you."
msgstr "Un nouveau savoir fleuri en vous."

#. ~ Snippet in category "tree_communion"
#: data/json/snippets/snippets.json
