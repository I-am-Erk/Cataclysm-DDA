#. ~ Description of a pocket in item "exosuit frame"
#: data/mods/Aftershock/items/armor/exosuit/exosuit_frame.json
msgid "This is a mounting point for helmet plating."
msgstr ""
"Un point d'accroche pour une pièce d'armure conçue pour couvrir la tête."

