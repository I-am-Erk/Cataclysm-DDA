#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/NPC_BEMS.json
msgid "the pill pusher"
msgstr ""

#. ~ Unique name of an NPC
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/NPC_BEMS.json
msgid "the traumatized traveler"
msgstr ""

#. ~ Unique name of an NPC
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/NPC_BEMS.json
msgid "the shady mercenary"
