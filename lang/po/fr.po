msgid_plural "scale urchins"
msgstr[0] "oursin à écailles"
msgstr[1] "oursins à écailles"
msgstr[2] "oursins à écailles"

#. ~ Description of monster "scale urchin"
#: data/mods/TropiCataclysm/monsters/tropical_nether.json
