msgstr "Vous ressentez vos blessures commencer à se refermer."

#. ~ Decay message of effect type "Nether Empathy"
#: data/mods/BombasticPerks/perkdata/empath.json
msgid "Your regeneration ceases."
msgstr "Votre régénération cesse."

#. ~ Name of effect type id "effect_fungus"
#: data/mods/BombasticPerks/perkdata/empath.json
