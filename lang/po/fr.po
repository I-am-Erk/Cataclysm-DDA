msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/elemental_mutations.json
msgid "mannequin skin"
msgstr "peau de mannequin"

#. ~ Description of mutation "mannequin skin"
#: data/mods/Xedra_Evolved/mutations/elemental_mutations.json
msgid ""
"Your skin has turned the color of antique dolls.  Your skin is now a "
"pearlescent white.  This has no gameplay effects."
msgstr ""

#. ~ Description of mutation "latex skin"
#: data/mods/Xedra_Evolved/mutations/elemental_mutations.json
msgid ""
"Your skin has become latex like.  It provides some additional protection and"
" attractiveness but heals at a much slower rate."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/elemental_mutations.json
msgid "sylph skin"
msgstr ""

#. ~ Description of mutation "sylph skin"
#: data/mods/Xedra_Evolved/mutations/elemental_mutations.json
msgid ""
"Your skin has turned the rolling grey of the clouds.  Your skin is now an "
