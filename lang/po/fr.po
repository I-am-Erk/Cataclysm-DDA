msgstr "Un petit buisson plein de cacahuètes craquantes."

#. ~ Description of terrain "peanut bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small peanut bush that's fruitless."
msgstr "Un petit buisson dépourvu des cacahuètes poussant normalement dessus."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blueberry bush"
msgstr "myrtillier"

#. ~ Description of terrain "blueberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of sweet blueberries."
msgstr "Un petit buisson rempli de myrtilles sucrées."

#. ~ Description of terrain "blueberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blueberry bush that's fruitless."
msgstr "Un petit buisson dépourvu des myrtilles poussant normalement dessus."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "strawberry bush"
msgstr "fraisier"

#. ~ Description of terrain "strawberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of juicy strawberries."
msgstr "Un petit buisson plein de fraises juteuses."

#. ~ Description of terrain "strawberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small strawberry bush that's fruitless."
msgstr "Un petit buisson dépourvu des fraises poussant normalement dessus."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "blackberry bush"
msgstr "mûrier"

#. ~ Description of terrain "blackberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr "Un petit buisson plein de mûres délicieuses. Attention aux épines!"

#. ~ Description of terrain "blackberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "huckleberry bush"
msgstr "buisson d'airelle"

#. ~ Description of terrain "huckleberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of huckleberries, often mistaken for blueberries."
msgstr ""

#. ~ Description of terrain "huckleberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small huckleberry bush that's fruitless."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "raspberry bush"
msgstr "framboisier"

#. ~ Description of terrain "raspberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr ""

#. ~ Description of terrain "raspberry bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "grape bush"
msgstr "vigne"

#. ~ Description of terrain "grape bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A bush of a different species invaded by grape vines."
msgstr ""

#. ~ Description of terrain "grape bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A bush of a different species invaded by grape vines, but they're fruitless."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "rose bush"
msgstr "rosier"

#. ~ Description of terrain "rose bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""

#. ~ Description of terrain "rose bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "hydrangea bush"
msgstr "buisson d'hortensias"

#. ~ Description of terrain "hydrangea bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A dense bush of fragrant blue hydrangeas."
msgstr ""

#. ~ Description of terrain "hydrangea bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A fat hydrangea bush that currently has no blooms."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "lilac bush"
msgstr "buisson de lilas"

#. ~ Description of terrain "lilac bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide bush of bright pinkish-purple lilacs."
msgstr ""

#. ~ Description of terrain "lilac bush"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A wide lilac bush that currently has no blooms."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree trunk"
msgstr "tronc"

#. ~ Description of terrain "tree trunk"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into "
"logs with the right tool."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tree stump"
msgstr "souche d'arbre"

#. ~ Description of terrain "tree stump"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A tree stump, a remnant of a tree that has been cut down."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "woodchips"
msgstr "copeaux de bois"

#. ~ Description of terrain "woodchips"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""

#. ~ Terrain name
#. ~ Item name
#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
msgid "grass"
msgid_plural "grasses"
msgstr[0] "herbe"
msgstr[1] "herbe"
msgstr[2] "herbe"

#. ~ Description of terrain "grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a"
" patch of dirt."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "white grass"
msgstr "herbe blanche"

#. ~ Description of terrain "white grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of Kentucky bluegrass covered in white latex-based paint, with neat "
"lines designed for recreational sports."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "long grass"
msgstr "herbes longues"

#. ~ Description of terrain "long grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of long, shaggy grass about shin high."
msgstr ""
"Une zone d'herbes longues et broussailleuses arrivant un peu en dessous du "
"genou."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tall grass"
msgstr "hautes herbes"

#. ~ Description of terrain "tall grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of tall grass about head high."
msgstr "Une zone d'herbes hautes arrivant à hauteur de tête."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead grass"
msgstr "herbe morte"

#. ~ Description of terrain "dead grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of long, shaggy grass that hasn't been cut recently."
msgstr ""
"Une zone d'herbes longues et broussailleuses ayant fanées pour une raison ou"
" une autre."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf green"
msgstr "green de golf"

#. ~ Description of terrain "golf green"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of grass mowed very short and neat."
msgstr "Une zone d'herbe verte ayant été coupée très courte et régulièrement."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain.json
msgid "alien grass"
msgstr "herbe étrange"

#. ~ Description of terrain "alien grass"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of something that almost looks like grass.  The blades are serrated "
"and move on their own."
msgstr ""
"Une zone d'un organisme ayant presque l'air d'être de l'herbe, les brins "
"remuent de leur propre volonté et ont l'air coupants et dentelés."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "golf hole"
msgstr "trou de golf"

#. ~ Description of terrain "golf hole"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A small plastic cup embedded in an area of very short, neat grass."
msgstr ""
"Un trou en plastique ayant été inséré au milieu d'une section d'herbe verte "
"ayant été coupée très courte et régulièrement."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "young bamboo shoots"
msgstr "jeunes pousses de bambou"

#. ~ Description of terrain "young bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of young bamboo shoots about ankle high.  Many shoots are just "
"barely pushing above the ground."
msgstr ""
"Une zone de jeunes pousses de bambou arrivant au niveau de la cheville, la "
"plupart émergeant juste du sol."

#. ~ Description of terrain "young bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"An area of young bamboo shoots about ankle high.  The smallest shoots have "
"already been harvested."
msgstr ""
"Une zone de jeunes pousses de bambou arrivant au niveau de la cheville. Les "
"plus petites pousses ont déjà été récoltées."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "long bamboo shoots"
msgstr "longues pousses de bambou"

#. ~ Description of terrain "long bamboo shoots"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of long bamboo shoots about shin high."
msgstr ""
"Une zone de longues pousses de bambou arrivant un peu en dessous du genou."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "tall bamboo"
msgstr "bambou"

#. ~ Description of terrain "tall bamboo"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "A tall bamboo thicket about head high."
msgstr "Un bosquet épais de bambou arrivant à hauteur de tête."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "dead bamboo"
msgstr "bambou mort"

#. ~ Description of terrain "dead bamboo"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "An area of long, brown, dead bamboo shoots covered in white fungus."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "fern"
msgstr "fougère"

#. ~ Description of terrain "fern"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr ""

#. ~ Description of terrain "fern"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern.  All"
" of the curled shoots have been harvested."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-flora.json
msgid "mushroom colony"
msgstr ""

#. ~ Description of terrain "mushroom colony"
#: data/json/furniture_and_terrain/terrain-flora.json
msgid ""
"A large pile of organic matter which has molded over with fungus.  The caps "
"of many mundane mushrooms spring from the top, you can even recognise some."
"  The fungi growing here don't seem edible, though."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid "Marloss bush"
msgstr "buisson de Marloss"

#. ~ Description of terrain "Marloss bush"
#: data/json/furniture_and_terrain/terrain-fungal.json
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""

