#: data/mods/desert_region/desert_mammal.json
msgid "bush elephant"
msgid_plural "bush elephants"
msgstr[0] "éléphant de savane"
msgstr[1] "éléphants de savane"
msgstr[2] "éléphants de savane"

#. ~ Description of monster "bush elephant"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
#: data/mods/desert_region/desert_mammal.json
msgid ""
"The African Bush Elephant is a massive terrestrial animal with two long "
"tusks protruding from its mouth.  Elephantry is on the rise since the "
"Cataclysm."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "jaguar"
msgid_plural "jaguars"
msgstr[0] "jaguar"
msgstr[1] "jaguars"
msgstr[2] "jaguars"

#. ~ Description of monster "jaguar"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"The largest native feline in the Americas.  With the advent of the Cataclysm"
" these spotted felines have recovered some territory."
msgstr ""
"Le plus grand félin des Amériques, le Cataclysme a permis à ces prédateurs "
"féroces de regagner beaucoup de leur territoire."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "spectacled bear"
msgid_plural "spectacled bears"
msgstr[0] "ours à lunettes"
msgstr[1] "ours à lunettes"
msgstr[2] "ours à lunettes"

#. ~ Description of monster "spectacled bear"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"The Andean bear, sometimes called spectacled bear is the only bear species "
"native to South America.  It lives in a very diverse array of ecosystems on "
"low to high altitudes."
msgstr ""
"L'ours des Andes, cet espèce d'ursidé aussi appelée ours à lunettes est la "
"seule espèce d'ours native d'Amérique du Sud, son territoire s'étendant à "
"travers une grande diversité d'écosystèmes."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "spectacled bear cub"
msgid_plural "spectacled bear cubs"
msgstr[0] "ourson à lunettes"
msgstr[1] "oursons à lunettes"
msgstr[2] "oursons à lunettes"

#. ~ Description of monster "spectacled bear cub"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A juvenile spectacled bear.  Its mother could be nearby, better not to mess "
"around it."
msgstr ""
"Un ours à lunettes juvénile. Sa mère pourrait être dans les environs, ce "
"serait probablement une bonne idée de ne pas l'irriter."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "ocelot"
msgid_plural "ocelots"
msgstr[0] "ocelot"
msgstr[1] "ocelots"
msgstr[2] "ocelots"

#. ~ Description of monster "ocelot"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A widespread medium sized feline known for its spotted and streaked fur.  It"
" can be found as north as the southern US and even the Caribbean."
msgstr ""
"Un félin tâché et rayé un peu plus grand qu'un chat domestique natif "
"d'Amérique du Sud, mais aussi présent dans les Caraïbes et même le sud des "
"États-Unis."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "tapir calf"
msgid_plural "tapir calfs"
msgstr[0] "bébé tapir"
msgstr[1] "bébés tapir"
msgstr[2] "bébés tapir"

#. ~ Description of monster "tapir calf"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A baby tapir.  Unlike the adults, tapir calves are born with spots and "
"streaks on their fur for camouflage."
msgstr ""
"Un tapir nouveau-né. Contrairement aux adultes, ils naissent avec un pelage "
"couvert de tâches et de rayures servant à mieux se camoufler qu'il perdent "
"progressivement durant leur croissance."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "tapir"
msgid_plural "tapirs"
msgstr[0] "tapir"
msgstr[1] "tapirs"
msgstr[2] "tapirs"

#. ~ Description of monster "tapir"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A medium to large herbivore distantly related to the Rhinoceros.  It is both"
" a capable runner and swimmer in order to evade predators."
msgstr ""
"Un herbivore de taille moyenne et cousin distant du terrifiant rhinocéros. "
"Bien qu'il ne possède pas le taille, le poids ou la corne de son parent, il "
"reste assez bon à la nage et à la course pour échapper à ses prédateurs."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "camel"
msgid_plural "camels"
msgstr[0] "chameau"
msgstr[1] "chameaux"
msgstr[2] "chameaux"

#. ~ Description of monster "camel"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A large herbivore introduced from the old world via zoos and private owners."
"  Ironically, camels were once native to North America in distant times."
msgstr ""
"Un grand herbivore introduit en Amérique par les zoos et les propriétaires "
"privés, ceci étant ironique dû au fait que les camélidés ont évolué en "
"Amérique du Nord."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "coati"
msgid_plural "coatis"
msgstr[0] "coati"
msgstr[1] "coatis"
msgstr[2] "coatis"

#. ~ Description of monster "coati"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A relative of the raccoon, coatis can be easily distinguished by their long "
"noses and sometimes ringed tails.  They live as north as Arizona, and form "
"large family groups."
msgstr ""
"Un cousin du raton-laveur, le coatis est facilement reconnaissable grâce à "
"son long museau et sa queue souvent rayée. Ils vivent à travers l'Amérique "
"du Sud, Centrale et celle du Nord jusqu'à l'Arizona en larges groupes "
"familiaux."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "bush dog"
msgid_plural "bush dogs"
msgstr[0] "chien des buissons"
msgstr[1] "chiens des buissons"
msgstr[2] "chiens des buissons"

#. ~ Description of monster "bush dog"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A small and elusive canid native to South and Central America.  It is "
"harmless to humans but their packs can take on prey several times their "
"size."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "coipo"
msgid_plural "coipos"
msgstr[0] "ragondin"
msgstr[1] "ragondins"
msgstr[2] "ragondins"

#. ~ Description of monster "coipo"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A big rodent similar in shape to a beaver.  In the past it was hunted and "
"raised for its fur."
msgstr ""
"Un large rongeur ayant un air de famille avec le castor, et ayant aussi été "
"chassé et élevé pour sa fourrure."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "baby capybara"
msgid_plural "baby capybaras"
msgstr[0] "bébé capybara"
msgstr[1] "bébés capybara"
msgstr[2] "bébés capybara"

#. ~ Description of monster "baby capybara"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A baby capybara.  Like most rodents they are born by the numbers as they "
"usually get eaten early in their lives by many predators."
msgstr ""
"Un bébé capybara. Comme la plupart des rongeurs ceux-ci naissent "
"généralement en grands nombres dû à leur haute mortalité à la merci de leurs"
" nombreux prédateurs."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "capybara"
msgid_plural "capybaras"
msgstr[0] "capybara"
msgstr[1] "capybaras"
msgstr[2] "capybaras"

#. ~ Description of monster "capybara"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"The largest rodent in the world.  Capybaras are pretty chill aquatic "
"herbivores that roam around wetlands and rivers in South America."
msgstr ""
"Le plus gros rongeur au monde. Les capybaras sont des herbivores aquatiques "
"plutôt paisibles parcourant principalement les terres humides et rivières de"
" l'Amérique du Sud, mais ayant une large présence internationale dû à leur "
"popularité dans les zoos. "

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "hippopotamus"
msgid_plural "hippopotamus"
msgstr[0] "hippopotame"
msgstr[1] "hippopotames"
msgstr[2] "hippopotames"

#. ~ Description of monster "hippopotamus"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A massive and aggressive aquatic mammal.  Hippos originate from Africa but "
"were brought to the Americas by zoos and particularly eccentric criminals."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "peccari piglet"
msgid_plural "peccari piglets"
msgstr[0] "cochonnet de pécari"
msgstr[1] "cochonnets de pécari"
msgstr[2] "cochonnets de pécari"

#. ~ Description of monster "peccari piglet"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"The small offspring of a peccari.  Much like true boar piglets, this one has"
" a mottled fur as camouflage."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid "peccari"
msgid_plural "peccaris"
msgstr[0] "pécari"
msgstr[1] "pécaris"
msgstr[2] "pécaris"

#. ~ Description of monster "peccari"
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
msgid ""
"A small furred omnivore native to the American continent.  Despite looking "
"like a boar it is not directly related to them or their domestic brethren."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_mammal.json
