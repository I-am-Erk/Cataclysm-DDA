msgstr "Parce que j'ai un détonateur thermique entre les mains!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "Parce que je suis ton ami!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
