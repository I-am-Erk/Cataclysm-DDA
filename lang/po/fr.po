#. ~ Profession name for male
#: data/json/professions.json data/mods/innawood/professions.json
msgctxt "profession_male"
msgid "Miner"
msgstr "Mineur"

#. ~ Description of profession "Miner" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You're a miner, not a minor!  Your canteen is dry, your jackhammer is out of"
" gas, and you're on your last pair of batteries for your mining helmet…"
msgstr ""
"Vous êtes un mineur, pas un mineur! Votre gourde est vide, votre marteau-"
"piqueur est à plat, et votre lampe de casque est sur sa dernière paire de "
"batteries..."

