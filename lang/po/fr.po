#. ~ Description of MOD "Innawood"
#: data/mods/innawood/modinfo.json
msgid ""
"An untouched land that mankind has yet to reach.  Disables most traces of "
"civilization for that 'innawood' experience."
msgstr ""

#. ~ Profession name for male
#: data/mods/innawood/professions.json
msgctxt "profession_male"
msgid "Goat Man"
msgstr ""

#. ~ Description of profession "Goat Man" for male
#: data/mods/innawood/professions.json
msgctxt "prof_desc_male"
msgid ""
"Nobody around?  Oh well, it doesn't matter.  Your beloved goats are all you "
"need!"
msgstr ""

