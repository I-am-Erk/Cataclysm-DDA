msgstr[1] "morceaux de cassitérite"
msgstr[2] "morceaux de cassitérite"

#. ~ One liter, roughly 6.26 grams per cubic centimeter.
#. ~ Description of "chunk of cassiterite"
#: data/mods/innawood/mining/items/ore.json
msgid ""
"A large chunk of cassiterite, an ore of tin.  It only needs to be smelted "
"into a usable form."
msgstr ""

#. ~ One liter, roughly 7.6 grams per cubic centimeter.
#. ~ Item name
#: data/mods/innawood/mining/items/ore.json
msgid "chunk of galena"
