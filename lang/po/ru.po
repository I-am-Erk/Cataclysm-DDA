msgstr "ЭЙ, ЗОМБИ!"

#: lang/json/snippet_from_json.py
msgid "GET OVER HERE!"
msgstr "ПОДХОДИТЕ ПОБЛИЖЕ!"

#: lang/json/snippet_from_json.py
