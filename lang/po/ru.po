msgstr ""
"Вы не можете залезть сюда — над вами нет рельефа, который бы смог выдержать "
"ваш вес."

#: src/game.cpp
msgid "You can't go down here!"
msgstr "Вы не можете здесь спуститься!"

#: src/game.cpp
msgid "You can't go up here!"
msgstr "Вы не можете здесь подняться!"

#: src/game.cpp
msgid "You can't drag things up and down stairs."
msgstr "Вы не можете двигать предметы по лестнице."

#: src/game.cpp
#, c-format
msgid "You try to use the stairs.  Suddenly you are blocked by a %s!"
msgstr "Вы пытаетесь двигаться по лестнице, но %s вам не позволяет!"

