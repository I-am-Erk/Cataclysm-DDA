#: lang/json/MONSTER_from_json.py
msgid "giant scorpion"
msgid_plural "giant scorpions"
msgstr[0] "гигантский скорпион"
msgstr[1] "гигантских скорпиона"
msgstr[2] "гигантских скорпионов"
msgstr[3] "гигантские скорпионы"

#. ~ Description for giant scorpion
#: lang/json/MONSTER_from_json.py
msgid ""
"A menacing arachnid with a second set of pedipalps, clacking rabidly as an "
