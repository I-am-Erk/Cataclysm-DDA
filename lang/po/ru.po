msgstr[1] "таблетки берлинской лазури"
msgstr[2] "таблеток берлинской лазури"
msgstr[3] "таблетки берлинской лазури"

#. ~ Use action activation_message for Prussian blue tablet.
#: lang/json/COMESTIBLE_from_json.py
