#: src/addiction.cpp
msgid ""
"Perception - 1;   Intelligence - 1;\n"
"Anxiety, nausea, hallucinations, and general malaise."
msgstr ""
"Восприятие -1; Интеллект — 1;\n"
"Беспокойство, тошнота, галлюцинации и общее недомогание."

