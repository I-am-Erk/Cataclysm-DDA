msgid_plural "acid dart volleys"
msgstr[0] "очередь кислотных дротиков"
msgstr[1] "очереди кислотных дротиков"
msgstr[2] "очередей кислотных дротиков"
msgstr[3] "очереди кислотных дротиков"

#: lang/json/gun_from_json.py
