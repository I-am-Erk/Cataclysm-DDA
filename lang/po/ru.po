msgstr "Вы на секунду останавливаетесь, чтобы отдышаться."

#: src/player_activity.cpp
msgid "You struggle to continue.  Keep trying?"
msgstr "Вам трудно продолжать. Пытаться дальше?"

#: src/player_activity.cpp
msgid "Continue after a break."
msgstr "Продолжить после перерыва."

#: src/player_activity.cpp
msgid "Finish it."
msgstr "Закончить задачу."

#: src/player_display.cpp
