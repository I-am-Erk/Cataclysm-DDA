#. ~ Message for SPELL '{'str': 'spice pain'}'
#: lang/json/SPELL_from_json.py
msgid "Spicy!"
msgstr "Остро!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Vortex"
msgstr "Артефакт- Вихрь"

#. ~ Description for Artifact Vortex
#: lang/json/SPELL_from_json.py
msgid "Summon Vortexes"
msgstr "Призвать вихри"

#. ~ Message for SPELL '{'str': 'Artifact Vortex'}'
#: lang/json/SPELL_from_json.py
msgid "Space twists and deforms around you."
msgstr "Пространство вокруг вас искажается и деформируется."

#: lang/json/SPELL_from_json.py
msgid "Artifact Call of Tindalos"
msgstr "Артефакт - Зов Тиндалоса"

#. ~ Description for Artifact Call of Tindalos
#: lang/json/SPELL_from_json.py
msgid "Summon hostile hounds of tindalos"
msgstr "Призывает гончих Тиндалоса"

#. ~ Message for SPELL '{'str': 'Artifact Call of Tindalos'}'
#: lang/json/SPELL_from_json.py
msgid ""
"The world unravels into geometric shapes, and between the chaos you spot a "
"horrid prowling beast."
msgstr ""
"Мир распадается на геометрические формы, и в окружающем хаосе ваш взгляд "
"выхватывает ужасного крадущегося зверя."

#: lang/json/SPELL_from_json.py
msgid "Artifact Force Pull"
msgstr "Артефакт-  Рывок силы"

#. ~ Description for Artifact Force Pull
#: lang/json/SPELL_from_json.py
msgid "Pull objects."
msgstr "Притягивает объекты."

#. ~ Message for SPELL '{'str': 'Artifact Force Pull'}'
#: lang/json/SPELL_from_json.py
msgid "An unnatural implosion sends objects flying."
msgstr "Неестественный взрыв отправляет объекты в полет."

#: lang/json/SPELL_from_json.py
msgid "Artifact Teleportitis"
msgstr "Артефакт - Телепортит"

#. ~ Description for Artifact Teleportitis
#: lang/json/SPELL_from_json.py
msgid "Causes you to teleport uncontrollably."
msgstr "Вызывает неуправляемую телепортацию."

#. ~ Message for SPELL '{'str': 'Artifact Teleportitis'}'
#: lang/json/SPELL_from_json.py
msgid ""
"The world loses coherence, with images of nearby places forming and "
"disappearing around you."
msgstr ""
"Мир теряет связность, образы близлежащих мест формируются и исчезают вокруг "
"вас."

#: lang/json/SPELL_from_json.py
msgid "Artifact Slow"
msgstr "Артефакт - Замедление"

#. ~ Description for Artifact Slow
#: lang/json/SPELL_from_json.py
msgid "Slows you for a few turns."
msgstr "Замедляет вас на несколько ходов."

#. ~ Message for SPELL '{'str': 'Artifact Slow'}'
#: lang/json/SPELL_from_json.py
msgid "The world shifts blue, and reality accelerates around you."
msgstr "Мир становится голубоватым, и реальность вокруг вас ускоряется."

#: lang/json/SPELL_from_json.py
msgid "Artifact Time Stop"
msgstr "Артефакт - Остановка времени"

#. ~ Description for Artifact Time Stop
#: lang/json/SPELL_from_json.py
msgid "Grants you a few turns of super speed."
msgstr "Дарит вам несколько ходов сверхскорости."

#. ~ Message for SPELL '{'str': 'Artifact Time Stop'}'
#: lang/json/SPELL_from_json.py
msgid "Stale golden light floods the world, and reality stands still."
msgstr "Затхлый золотой свет заливает мир, а реальность застывает на месте."

#: lang/json/SPELL_from_json.py
msgid "Artifact Darkness"
msgstr "Артефакт - Тьма"

#. ~ Description for Artifact Darkness
#: lang/json/SPELL_from_json.py
msgid "Grants you the Darkness effect"
msgstr "Дарует вам эффект Тьмы."

#. ~ Message for SPELL '{'str': 'Artifact Darkness'}'
#: lang/json/SPELL_from_json.py
msgid "Persistent shadows invade your field of view."
msgstr "Настойчивые тени вторгаются в ваше поле зрения."

#: lang/json/SPELL_from_json.py
msgid "Artifact Hurtall"
msgstr "Артефакт - Повредить всем"

#. ~ Description for Artifact Hurtall
#: lang/json/SPELL_from_json.py
msgid "Hurts you for random damage"
msgstr "Наносит вам случайный урон."

#. ~ Message for SPELL '{'str': 'Artifact Hurtall'}'
#: lang/json/SPELL_from_json.py
msgid "You feel hollow inside."
msgstr "У вас возникает чувство пустоты внутри."

#: lang/json/SPELL_from_json.py
msgid "Artifact Adrenaline"
msgstr "Артефакт - Адреналин"

#. ~ Description for Artifact Adrenaline
#: lang/json/SPELL_from_json.py
msgid "Causes a surge of adrenaline to flow throughout your body."
msgstr "Вызывает выброс адреналина в вашем теле."

#. ~ Message for SPELL '{'str': 'Artifact Adrenaline'}'
#: lang/json/SPELL_from_json.py
msgid "You're filled with a roaring energy!"
msgstr "Вы наполнены ревущей энергией!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Blood"
msgstr "Артефакт - Кровь"

#. ~ Description for Artifact Blood
#: lang/json/SPELL_from_json.py
msgid "Causes blood to leak from nearby terrain."
msgstr "Вызывает кровь, сочащуюся из ближайшего участка местности."

#. ~ Message for SPELL '{'str': 'Artifact Blood'}'
#: lang/json/SPELL_from_json.py
msgid "Blood soaks out of the ground and walls."
msgstr "Кровь просачивается из стен и земли."

#: lang/json/SPELL_from_json.py
msgid "Artifact Heal"
msgstr "Артефакт - Исцеление"

#. ~ Description for Artifact Heal
#: lang/json/SPELL_from_json.py
msgid "Will heal injuries all over your body."
msgstr "Исцелит травмы вашего тела."

#. ~ Message for SPELL '{'str': 'Artifact Heal'}'
#: lang/json/SPELL_from_json.py
msgid "You feel healed."
msgstr "Вы подлечились."

#: lang/json/SPELL_from_json.py
msgid "Artifact Confused"
msgstr "Артефакт - Смятение"

#. ~ Description for Artifact Confused
#: lang/json/SPELL_from_json.py
msgid "Causes nearby enemies to become confused."
msgstr "Приводит ближайших противников в замешательство."

#: lang/json/SPELL_from_json.py
msgid "Artifact Pain"
msgstr "Артефакт - Боль"

#. ~ Description for Artifact Pain
#: lang/json/SPELL_from_json.py
msgid "Owchie that hurts."
msgstr "Охчёрт было больно."

#. ~ Message for SPELL '{'str': 'Artifact Pain'}'
#: lang/json/SPELL_from_json.py
msgid "You're wracked with pain!"
msgstr "Вас ломает от боли!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Teleport"
msgstr "Артефакт - Телепортация"

#. ~ Description for Artifact Teleport
#: lang/json/SPELL_from_json.py
msgid "Randomly teleports you a short distance."
msgstr "Телепортирует вас на короткое расстояние в случайном направлении."

#. ~ Message for SPELL '{'str': 'Artifact Teleport'}'
#: lang/json/SPELL_from_json.py
msgid "You teleport!"
msgstr "Вы телепортируетесь!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Attention"
msgstr "Артефакт - Внимание"

#. ~ Description for Artifact Attention
#: lang/json/SPELL_from_json.py
msgid ""
"You're not quite sure what you did, but something is watching you for it."
msgstr "Вы не уверены, что именно сделали, но привлекли чьё-то внимание."

#. ~ Message for SPELL '{'str': 'Artifact Attention'}'
#: lang/json/SPELL_from_json.py
msgid "You feel like your action has attracted attention."
msgstr "Вы чувствуете, что ваши действия привлекли внимание!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Teleglow"
msgstr "Артефакт - Телесвет"

#. ~ Description for Artifact Teleglow
#: lang/json/SPELL_from_json.py
msgid "DO YOU HEAR THE VOICES TOO?"
msgstr "ТЫ ТОЖЕ СЛЫШИШЬ ГОЛОСА?"

#. ~ Message for SPELL '{'str': 'Artifact Teleglow'}'
#: lang/json/SPELL_from_json.py
msgid "You feel unhinged."
msgstr "Вы ощущаете утрату чувства реальности."

#: lang/json/SPELL_from_json.py
msgid "Artifact Vomit"
msgstr "Артефакт - Рвота"

#. ~ Description for Artifact Vomit
#: lang/json/SPELL_from_json.py
msgid "Causes the caster to vomit."
msgstr "Вызывает рвоту у активирующего."

#. ~ Message for SPELL '{'str': 'Artifact Vomit'}'
#: lang/json/SPELL_from_json.py
msgid "A wave of nausea passes through you!"
msgstr "Вас охватывает приступ тошноты!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Shadows"
msgstr "Артефакт - Тени"

#. ~ Description for Artifact Shadows
#: lang/json/SPELL_from_json.py
msgid "Summons shadows"
msgstr "Вызывает тени."

#. ~ Message for SPELL '{'str': 'Artifact Shadows'}'
#: lang/json/SPELL_from_json.py
msgid "Shadows form around you."
msgstr "Вас окружили тени."

#: lang/json/SPELL_from_json.py
msgid "Artifact Stamina Empty"
msgstr "Артефакт - Опустошение сил"

#. ~ Description for Artifact Stamina Empty
#: lang/json/SPELL_from_json.py
msgid "does a variable amount of stamina damage"
msgstr "Убирает случайное количество запаса сил."

#. ~ Message for SPELL '{'str': 'Artifact Stamina Empty'}'
#: lang/json/SPELL_from_json.py
msgid "Your body feels like jelly."
msgstr "Вы чувствуете себя амёбой."

#: lang/json/SPELL_from_json.py
msgid "Artifact Radiation"
msgstr "Артефакт - Радиация"

#. ~ Description for Artifact Radiation
#: lang/json/SPELL_from_json.py
msgid "causes radiation"
msgstr "Вызывает облучение."

#. ~ Message for SPELL '{'str': 'Artifact Radiation'}'
#: lang/json/SPELL_from_json.py
msgid "Horrible gases are emitted!"
msgstr "Произошёл выброс ужасающего газа!"

#. ~ Description for Artifact Hurtall
#: lang/json/SPELL_from_json.py
msgid "Hurts all monsters within your view distance"
msgstr "Повреждает всех монстров в дальности вашего обзора."

#: lang/json/SPELL_from_json.py
msgid "Artifact Acidball"
msgstr "Артефакт - Кислотный шар"

#. ~ Description for Artifact Acidball
#: lang/json/SPELL_from_json.py
msgid "fires an acidball"
msgstr "Запускает шар кислоты."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Pet"
msgstr "Питомец"

#. ~ Description for Pet
#: lang/json/SPELL_from_json.py
