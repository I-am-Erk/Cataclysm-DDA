msgstr[2] "приготовленное жирное мясо"
msgstr[3] "приготовленное жирное мясо"

#. ~ Description for cooked fatty meat
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"This is a chunk of freshly cooked fatty meat.  Although absent of vitamins, "
"it is very filling and delightfully greasy."
msgstr ""
"Кусок свежеприготовленного жирного мяса. Несмотря на отсутствие витаминов, "
"он очень сытный и восхитительно жирный."

