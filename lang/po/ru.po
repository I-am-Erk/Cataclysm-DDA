msgid_plural "fast draw holsters"
msgstr[0] "«быстрая» кобура"
msgstr[1] "«быстрые» кобуры"
msgstr[2] "«быстрых» кобур"
msgstr[3] "«быстрые» кобуры"

#. ~ Description for fast draw holster
#: lang/json/ARMOR_from_json.py
