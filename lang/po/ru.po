#: lang/json/recipe_from_json.py
msgid "water well"
msgstr "колодец"

#: lang/json/recipe_from_json.py
msgid "Let's set up a radio tower to improve our recruitment efforts."
msgstr "Давайте установим радиовышку, чтобы было легче искать сторонников."

#: lang/json/recipe_from_json.py
msgid ""
"We should dig some pits for palisade segments to block entrances to camp."
msgstr ""
