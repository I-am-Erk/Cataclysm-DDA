msgstr[3] "кавалерийские сабли"

#. ~ Description for cavalry saber
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheaply-made replica of a curved sword associated with "
"cavalry, from the Early Modern period onwards."
msgstr ""
"Тупая и дешёвая подделка изогнутого кавалерийского меча периода раннего "
"Нового времени и позже."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
