msgstr[3] "вместительные рюкзаки"

#. ~ Description for high-volume rucksack
#: lang/json/ARMOR_from_json.py
msgid ""
"Also known as a \"bigpack\", this rucksack is prized by pack rats but may "
"lead to a bad back."
msgstr "Этот рюкзак ценят барахольщики, но от него можно надорвать спину."

#: lang/json/ARMOR_from_json.py
msgid "bindle"
msgid_plural "bindles"
