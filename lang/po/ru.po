msgid "Successfully removed %s."
msgstr "Успешно удален КБМ (%s)."

#: src/bionics.cpp
#, c-format
msgid "The %s's anesthesia kit looks empty."
msgstr "У оперирующего (%s) кончился набор для анестезии."

#: src/bionics.cpp
msgid ""
"You feel a tiny pricking sensation in your right arm, and lose all sensation"
" before abruptly blacking out."
msgstr ""
"Вы чувствуете небольшой укольчик в правую руку, а затем внезапно теряете "
"сознание."

#: src/bionics.cpp
#, c-format
msgid ""
"The %1$s gently inserts a syringe into %2$s's arm and starts injecting "
"something while holding them down."
msgstr ""
"%1$s аккуратно придерживает пациента (%2$s) и что-то вводит ему в вену."

#: src/bionics.cpp
#, c-format
msgid "You fall asleep and %1$s starts operating."
msgstr "Вы засыпаете, а %1$s начинает операцию."

#: src/bionics.cpp
#, c-format
msgid "%1$s falls asleep and %2$s starts operating."
msgstr "%1$s засыпает, а %2$s начинает операцию."

#: src/bionics.cpp
#, c-format
msgid "%s's parts are jiggled back into their familiar places."
msgstr "Части тела пациента (%s) встали обратно на свои места."

#: src/bionics.cpp
msgid "/!\\ CBM is highly contaminated. /!\\"
msgstr "/!\\ КБМ сильно загрязнён. /!\\"

#: src/bionics.cpp
msgid "CBM is filthy."
msgstr "КБМ грязный."

#: src/bionics.cpp
msgid "/!\\ CBM is not sterile. /!\\ Please use autoclave to sterilize."
msgstr ""
"/!\\ КБМ не стерильный. /!\\ Пожалуйста, используйте автоклав для "
"стерилизации."

#: src/bionics.cpp
msgid "CBM is not sterile."
msgstr "КБМ нестерильный."

#: src/bionics.cpp
msgid "CBM already deployed.  Please reset to factory state."
msgstr "КБМ уже развёрнут. Пожалуйста, верните его в заводское состояние."

#: src/bionics.cpp
msgid "CBM is already installed."
msgstr "КБМ уже установлен."

#: src/bionics.cpp
msgid "CBM not compatible with patient's body."
msgstr "КБМ несовместим с пациентом."

#: src/bionics.cpp
msgid "No base version installed."
msgstr "Базовая версия не установлена."

#: src/bionics.cpp
msgid "Superior version installed."
msgstr "Установлена улучшенная версия"

#: src/bionics.cpp
msgid "CBM not compatible with patient."
msgstr "КБМ несовместим с пациентом."

#: src/bionics.cpp
msgid "Max power capacity already reached."
msgstr "Уже достигнута максимальная энергоёмкость."

#: src/bionics.cpp
#, c-format
msgid ""
"Installing this bionic will remove the conflicting traits: %s.  Continue "
"anyway?"
msgstr ""
"Установка это бионического модуля удалит конфликтующую черту: %s. Продолжить"
" в любом случае?"

#. ~ <Body part name>: <number of slots> more slot(s) needed.
#: src/bionics.cpp
#, c-format
msgid ""
"\n"
"%s: %i more slot(s) needed."
msgstr ""
"\n"
"%s: требуется ещё %i слот (а, ов)."

#: src/bionics.cpp
#, c-format
msgid "Not enough space for bionic installation!%s"
msgstr "Не хватает места для установки бионики!%s"

#: src/bionics.cpp
msgid "Are you sure you wish to install the selected bionic?"
msgstr "Вы уверены, что хотите установить выбранную бионику?"

#: src/bionics.cpp
#, c-format
msgid ""
"WARNING: %i percent chance of failure that may result in damage, pain, or a "
"faulty installation!  Continue anyway?"
msgstr ""
"ВНИМАНИЕ: %i-процентный шанс повреждений, боли или неудачной установки! Всё "
"равно продолжить?"

#. ~ %1$s - name of the bionic to be upgraded (inferior), %2$s - name of the
#. upgraded bionic (superior).
#: src/bionics.cpp
#, c-format
msgid "Successfully upgraded %1$s to %2$s."
msgstr "Успешное улучшение бионики «%1$s» до «%2$s»."

#. ~ %s - name of the bionic.
#: src/bionics.cpp
#, c-format
msgid "Successfully installed %s."
msgstr "Успешно установлен КБМ (%s)."

#: src/bionics.cpp
msgid "The installation is a failure."
msgstr "Установка провалилась."

#. ~"Complications" is USian medical-speak for "unintended damage from a
#. medical procedure".
#: src/bionics.cpp
#, c-format
msgid "%s training helps to minimize the complications."
msgstr "Опыт оперирующего (%s)_ помогает снизить риск осложнений."

#: src/bionics.cpp
msgid "The installation fails without incident."
msgstr "Установка провалилась без последствий."

#: src/bionics.cpp
msgid "The installation is faulty!"
msgstr "Во время установки произошла ошибка!"

