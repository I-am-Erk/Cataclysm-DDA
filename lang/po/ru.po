msgstr[2] "дори"
msgstr[3] "дори"

#. ~ Description for dory
#: lang/json/GENERIC_from_json.py
msgid "A well-made spear with a bronze head, Greek in origin."
msgstr ""
"Добротно сделанное копьё с бронзовым наконечником древнегреческого "
"происхождения."

#: lang/json/GENERIC_from_json.py
