msgstr[1] "тактических подсумка"
msgstr[2] "тактических подсумков"
msgstr[3] "тактические подсумки"

#. ~ Description for tactical dump pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"An expandable pouch secured with straps.  Provides a bit of extra storage "
"with minimal encumbrance."
msgstr ""
"Раскрывающийся подсумок с лямками. Позволяет хранить больше предметов, не "
"мешая двигаться."

#: lang/json/ARMOR_from_json.py
msgid "fanny pack"
msgid_plural "fanny packs"
msgstr[0] "поясная сумка"
