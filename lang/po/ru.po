msgstr "%1$s хлещет своим щупальцем по вам (%2$s)!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s snaps its tentacle at <npcname>'s %2$s!"
msgstr "%1$s хлещет своим щупальцем по NPC (<npcname> - %2$s)!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's tentacle lashes out at you without doing any damage."
msgstr "%1$s бьёт по вам щупальцами, не нанося никакого урона."

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's tentacle lashes out at <npcname> without doing any damage."
msgstr "%1$s бьёт по NPC (<npcname>) щупальцами, не нанося никакого урона."

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head shoots out, and its teeth sink into your %2$s!"
msgstr "Голова (%1$s) выстреливает вперёд, и зубы погружаются в вас (%2$s)!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head shoots out, and its teeth sink into <npcname>'s %2$s!"
msgstr ""
"Голова (%1$s) выстреливает вперёд, и зубы погружаются в NPC (<npcname> - "
"%2$s)!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s's head hits your %2$s, but glances off your armor!"
msgstr ""
"Голова (%1$s) попадает в вашу часть тела (%2$s), но соскальзывает по броне!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head hits <npcname>'s %2$s, but glances off their armor!"
msgstr ""
"Голова (%1$s) попадает в NPC (<npcname> - %2$s), но соскальзывает по броне!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts its arms at you, and its claws pierce your %2$s!"
msgstr ""
"%1$s выбрасывает свою руку в вашу сторону, и когти пронзают вас (%2$s)!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid ""
"The %1$s thrusts its arms at <npcname>, and its claws pierce their %2$s!"
msgstr ""
"%1$s выбрасывает свою руку в вашу сторону, и когти пронзают NPC (<npcname> -"
" %2$s)!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's arms hit your %2$s, but they glance off your armor!"
msgstr ""
"Рука существа (%1$s) попадает в вашу часть тела (%2$s), но соскальзывает по "
"броне!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's arms hit <npcname>'s %2$s, but they glance off their armor!"
msgstr ""
"Голова (%1$s) попадает в NPC (<npcname> - %2$s), но соскальзывает по броне!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts a claw at your %2$s, slashing it!"
msgstr "%1$s выбрасывает клешню по вам (%2$s), оставляя порез!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts a claw at <npcname>'s %2$s, slashing it!"
msgstr "%1$s выбрасывает клешню по NPC (<npcname> - %2$s), оставляя порез!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s thrusts a claw at your %2$s, but glances off your armor!"
msgstr "%1$s выбрасывает клешню  по вам (%2$s), но соскальзывает по броне!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s thrusts a claw at <npcname>'s %2$s, but glances off armor!"
msgstr ""
"%1$s выбрасывает клешню по NPC (<npcname> - %2$s), но соскальзывает по "
"броне!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s slashes at your neck, cutting your throat!"
msgstr "%s режет вашу шею, разрезая глотку!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s slashes at <npcname>'s neck, cutting their throat!"
msgstr "%1$s режет шею NPC (<npcname>), разрезая глотку!"

