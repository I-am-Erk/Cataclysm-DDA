#: lang/json/snippet_from_json.py
msgid "\"IT'S BURIED!  THE TEMPLE IS BURIED!\""
msgstr "«ПОД ЗЕМЛЁЙ! ХРАМ ПОД ЗЕМЛЁЙ!»"

#: lang/json/snippet_from_json.py
