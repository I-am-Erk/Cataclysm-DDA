msgstr[3] "бионические черепные пушки"

#: lang/json/gun_from_json.py
msgid "Bionic one-shot subdermal .40 pistol integrated with your head."
msgstr ""
"Бионическая однозарядная подкожная пушка калибра .40, встроенная в череп."

#: lang/json/gun_from_json.py
