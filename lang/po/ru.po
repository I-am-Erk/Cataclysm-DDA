#: src/iuse.cpp
#, c-format
msgid "Your radiation level: %d mSv (%d mSv from items)"
msgstr "Ваш уровень радиации: %d мЗв (%d мЗв от предметов)"

#: src/iuse.cpp
#, c-format
msgid "%s's radiation level: %d mSv (%d mSv from items)"
msgstr "У %s уровень радиации: %d мЗв (%d мЗв от предметов)"

