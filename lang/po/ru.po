#. ~ Description for violin case
#: lang/json/ARMOR_from_json.py
msgid ""
"Useful to carry your precious musical instrument around protected from any "
"harm."
msgstr ""
"Используется для безопасной переноски вашего драгоценного музыкального "
"инструмента."

#: lang/json/ARMOR_from_json.py
msgid "daypack"
