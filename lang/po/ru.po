msgstr[0] "продолговатое устройство"
msgstr[1] "продолговатых устройства"
msgstr[2] "продолговатых устройств"
msgstr[3] "продолговатые устройства"

#. ~ Description for oblong device
#: lang/json/GENERIC_from_json.py
msgid ""
"Perfectly smooth, cool to the touch, and a dull blue-grey colour, this looks"
