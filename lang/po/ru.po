msgid_plural "Force Shield"
msgstr[0] "Силовой щит"
msgstr[1] "Силовых щита"
msgstr[2] "Силовых щитов"
msgstr[3] "Силовые щиты"

#. ~ Description for {'str_sp': 'Force Shield'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A shield of pure force that protects you from most types of physical damage."
msgstr ""
"Щит чистой силы, который защищает вас от большинства видов физического "
"урона."

#: lang/json/ARMOR_from_json.py lang/json/SPELL_from_json.py
msgid "Soul Burn"
msgid_plural "Soul Burns"
msgstr[0] "Ожог души"
msgstr[1] "Ожога души"
msgstr[2] "Ожогов души"
msgstr[3] "Ожоги души"

#. ~ Description for Soul Burn
#: lang/json/ARMOR_from_json.py
msgid ""
"A little of your soul has been burned away, leaving you in a weakened state."
"  The soul heals quickly, so rest for now."
msgstr ""
"Небольшая часть вашей души выгорела, оставляя вас в ослабленном состоянии. "
"Душа быстро исцеляется, так что подумайте о небольшом отдыхе."

