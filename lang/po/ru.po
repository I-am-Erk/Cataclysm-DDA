msgstr ""
"На этом магическом камешке эмблема молнии и грозовых туч. Он нужен "
"повелителям бурь, чтобы влить магию в своё искусство."

#: lang/json/TOOL_from_json.py
msgid "Druid rune"
msgid_plural "Druid runes"
msgstr[0] "Друидическая руна"
msgstr[1] "Друидические руны"
msgstr[2] "Друидических рун"
msgstr[3] "Друидические руны"

#. ~ Description for Druid rune
#: lang/json/TOOL_from_json.py
msgid ""
"This magical pebble has an insignia of nature and trees on it.  It is "
