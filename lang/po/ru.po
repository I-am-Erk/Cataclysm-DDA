#. ~ Description for fur sleeping bag
#: lang/json/ARMOR_from_json.py
msgid "A large sleeping bag lined with fur.  Who needs a tent?"
msgstr ""
"Большой спальный мешок с меховой подкладкой. Кому вообще нужны палатки?"

#: lang/json/ARMOR_from_json.py
msgid "rolled fur sleeping bag"
