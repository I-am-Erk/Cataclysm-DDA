msgstr[1] "прогулочных рюкзака"
msgstr[2] "прогулочных рюкзаков"
msgstr[3] "прогулочные рюкзаки"

#. ~ Description for daypack
#: lang/json/ARMOR_from_json.py
msgid ""
"An ultralight nylon backpack intended for one-day hiking trips.  Waterproof,"
" slim, and spacious."
msgstr ""
"Очень лёгкий нейлоновый рюкзачок для однодневных походов. Водонепроницаемый,"
" удобный и вместительный."

#: lang/json/ARMOR_from_json.py
