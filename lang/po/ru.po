msgstr[2] "портфелей"
msgstr[3] "портфели"

#. ~ Description for briefcase
#: lang/json/ARMOR_from_json.py
msgid "Useful for carrying money, documents, or smuggled goods."
msgstr "В нём удобно переносить деньги, документы и контрабанду."

#: lang/json/ARMOR_from_json.py
