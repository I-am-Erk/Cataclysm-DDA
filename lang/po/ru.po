msgstr[1] "кровоостанавливающих порошка"
msgstr[2] "кровоостанавливающих порошков"
msgstr[3] "кровоостанавливающий порошок"

#. ~ Description for {'str_sp': 'hemostatic powder'}
#: lang/json/COMESTIBLE_from_json.py
