msgstr[1] "листа наждачной бумаги"
msgstr[2] "листов наждачной бумаги"
msgstr[3] "листы наждачной бумаги"

#. ~ Description for sandpaper
#: lang/json/TOOL_from_json.py
msgid ""
"A sheet of rough paper.  It is commonly used in metalworking and carpentry."
msgstr ""
"Лист бумаги с абразивным покрытием. Используется в металлообработке и "
"столярном деле."

#: lang/json/TOOL_from_json.py
msgid "draw plate"
msgid_plural "draw plates"
msgstr[0] "волока"
msgstr[1] "волоки"
msgstr[2] "волок"
msgstr[3] "волоки"

#. ~ Description for draw plate
#: lang/json/TOOL_from_json.py
msgid ""
"A piece of metal with holes of varying size drilled into it.  Used as part "
"of wire drawing."
msgstr ""
"Кусок металла с просверленными отверстиями разного размера. Используется как"
" часть процесса волочения проволоки."

#: lang/json/TOOL_from_json.py
msgid "compressed air horn"
msgid_plural "compressed air horns"
msgstr[0] "гудок со сжатым воздухом"
msgstr[1] "гудка со сжатым воздухом"
msgstr[2] "гудков со сжатым воздухом"
msgstr[3] "гудок со сжатым воздухом"

#. ~ Use action noise_message for compressed air horn.
#: lang/json/TOOL_from_json.py
msgid "HOOOOONK!"
msgstr "«ГГУУУУУУУ!»"

#. ~ Use action use_message for compressed air horn.
#: lang/json/TOOL_from_json.py
msgid "You honk your airhorn."
msgstr "Вы гудите в гудок."

#. ~ Description for compressed air horn
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small can of compressed air attached to a plastic horn.  Pressing "
"the button on top causes it to emit a loud honking sound."
msgstr ""
"Небольшой баллон со сжатым воздухом и гудком. По нажатию кнопки издаёт "
"громкий звук."

#: lang/json/TOOL_from_json.py
msgid "alarm clock"
msgid_plural "alarm clocks"
msgstr[0] "будильник"
msgstr[1] "будильника"
msgstr[2] "будильников"
msgstr[3] "будильники"

#. ~ Description for alarm clock
#: lang/json/TOOL_from_json.py
msgid ""
"A wind-up alarm clock.  Though the noise it makes is unpleasant to wake up "
"to, it's always good to get an early start to your day.  Can also be "
"disassembled into some useful parts."
msgstr ""
"Заводной будильник. Несмотря на то, что его звук неприятен для пробуждения, "
"всегда полезно пораньше начать свой день. Можно разобрать, чтобы получить "
"полезные детали."

#: lang/json/TOOL_from_json.py
msgid "can of butane"
msgid_plural "cans of butane"
msgstr[0] "канистра бутана"
msgstr[1] "канистры бутана"
msgstr[2] "канистр бутана"
msgstr[3] "канистры бутана"

#. ~ Description for can of butane
#: lang/json/TOOL_from_json.py
msgid ""
"A typical can of butane that you would normally use to fill a lighter.  It "
"could be useful as a fuel, but also as a solvent or chemical reagent."
msgstr ""
"Обычная канистра бутана, которой можно заправить зажигалку. Можно "
"использовать в качестве топлива, а также растворителя или химического "
"реагента."

#: lang/json/TOOL_from_json.py
msgid "cow bell"
msgid_plural "cow bells"
msgstr[0] "коровий колокольчик"
msgstr[1] "коровьих колокольчика"
msgstr[2] "коровьих колокольчиков"
msgstr[3] "коровьи колокольчики"

#. ~ Description for cow bell
#: lang/json/TOOL_from_json.py
msgid "A brass cow bell.  You feel like you need more of it."
msgstr "Латунный коровий колокольчик. Вам кажется, что нужно найти еще таких."

#: lang/json/TOOL_from_json.py
msgid "dab pen"
msgid_plural "dab pens"
