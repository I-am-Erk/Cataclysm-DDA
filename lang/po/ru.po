msgstr[3] "копии «Современный кожевник»"

#. ~ Description for The Modern Tanner
#: lang/json/BOOK_from_json.py
msgid ""
"An in-depth and easy to read guide that details a very modern take on the "
"ancient art of leather tanning."
msgstr ""
"Всестороннее и лёгкое для чтения руководство, описывающее современный взгляд"
" на древнее искусство дубления кож."

#: lang/json/BOOK_from_json.py
msgid "PE050 \"Alpha\": Preliminary Report"
