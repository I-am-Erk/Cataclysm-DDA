#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart but you dodge it."
msgstr "%s выстреливает в вас дротиком, но вы уворачиваетесь от него!"

#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart into you!"
msgstr "%s выстреливает в вас дротиком!"

#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart at you, but misses!"
msgstr "%s выстреливает в вас дротиком, но промахивается!"

#: src/monattack.cpp
