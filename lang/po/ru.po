#, c-format
msgid "Press [<color_yellow>%s</color>] to show previous stage(s)."
msgstr "Нажмите [<color_yellow>%s</color>] для показа прошлого этапа(ов)."

#: src/construction.cpp
#, c-format
msgid "Press [<color_yellow>%s</color>] to show next stage(s)."
msgstr "Нажмите [<color_yellow>%s</color>] для показа следующего этапа(ов)."

#: src/construction.cpp
#, c-format
msgid "Press [<color_red>%s</color>] to clear filter."
msgstr "Нажмите [<color_red>%s</color>], чтобы сбросить фильтр"

