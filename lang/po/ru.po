msgid_plural "acid dart guns"
msgstr[0] "ружьё с кислотными дротиками"
msgstr[1] "ружья с кислотными дротиками"
msgstr[2] "ружей с кислотными дротиками"
msgstr[3] "ружья с кислотными дротиками"

#: lang/json/gun_from_json.py
