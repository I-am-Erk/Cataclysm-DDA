msgstr "Превращает цель в питомца."

#: lang/json/SPELL_from_json.py
msgid "Artifact Flies Buzz"
msgstr "Артефакт - Мухи"

#. ~ Description for Artifact Flies Buzz
#: lang/json/SPELL_from_json.py
msgid "Flies buzz around you"
msgstr "Вокруг вас зажужжат мухи."

#. ~ Message for SPELL '{'str': 'Artifact Flies Buzz'}'
#: lang/json/SPELL_from_json.py
msgid "Flies buzz around you."
msgstr "Вокруг вас жужжат мухи."

#: lang/json/SPELL_from_json.py
msgid "Artifact Summon Flies"
msgstr "Артефакт - Вызвать мух"

#. ~ Description for Artifact Summon Flies
#: lang/json/SPELL_from_json.py
msgid "Summons some flies"
msgstr "Вызывает мух."

#. ~ Message for SPELL '{'str': 'Artifact Summon Flies'}'
#: lang/json/SPELL_from_json.py
msgid "Giant flies appear!"
msgstr "Появились гигантские мухи!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Summon Bees"
msgstr "Артефакт - Вызвать пчёл"

#. ~ Description for Artifact Summon Bees
#. ~ Message for SPELL '{'str': 'Artifact Summon Bees'}'
#: lang/json/SPELL_from_json.py
msgid "Giant bees appear!"
msgstr "Появились гигантские пчёлы!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Summon Wasps"
msgstr "Артефакт - Вызвать ос"

#. ~ Description for Artifact Summon Wasps
#: lang/json/SPELL_from_json.py
msgid "Summons some wasps"
msgstr "Вызывает ос."

#. ~ Message for SPELL '{'str': 'Artifact Summon Wasps'}'
#: lang/json/SPELL_from_json.py
msgid "Giant wasps appear!"
msgstr "Появились гигантские осы!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Bugs"
msgstr "Артефакт - Насекомые"

#. ~ Description for Artifact Bugs
#: lang/json/SPELL_from_json.py
msgid "Summon some bugs."
msgstr "Вызывает насекомых."

#: lang/json/SPELL_from_json.py
msgid "Artifact Noise"
msgstr "Артефакт - Шум"

#. ~ Description for Artifact Noise
#: lang/json/SPELL_from_json.py
msgid "Makes a noise at your location"
msgstr "Создаёт шум в месте вашего положения."

#. ~ description for the sound of spell '{'str': 'Artifact Noise'}'
#: lang/json/SPELL_from_json.py
msgid "a deafening boom"
msgstr "оглушительный взрыв"

#. ~ Message for SPELL '{'str': 'Artifact Noise'}'
#: lang/json/SPELL_from_json.py
msgid "You hear a deafening boom from your location!"
msgstr "Вы слышите оглушительный взрыв из того места, где находитесь!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Light"
msgstr "Артефакт - Свет"

#. ~ Description for Artifact Light
#: lang/json/SPELL_from_json.py
msgid "Makes some light."
msgstr "Создаёт немного света."

#. ~ Message for SPELL '{'str': 'Artifact Light'}'
#: lang/json/SPELL_from_json.py
msgid "You glow brightly!"
msgstr "Вы ярко светитесь!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Dim"
msgstr "Артефакт - Сумерки"

#. ~ Description for Artifact Dim
#: lang/json/SPELL_from_json.py
msgid "Darkens the sky."
msgstr "Затемняет небо."

#. ~ Message for SPELL '{'str': 'Artifact Dim'}'
#: lang/json/SPELL_from_json.py
msgid "The sky starts to dim."
msgstr "Небо начинает темнеть."

#: lang/json/SPELL_from_json.py
msgid "Artifact Dimensional Fatigue"
msgstr "Артефакт - Пространственная слабина"

#. ~ Description for Artifact Dimensional Fatigue
#: lang/json/SPELL_from_json.py
msgid "Creates some dimensional fatigue at a random point within range"
msgstr ""
"Вызывает ослабление пространства в случайной точке в пределах зоны действия."

#: lang/json/SPELL_from_json.py
msgid "Artifact Fireball"
msgstr "Артефакт - Огненный шар"

#. ~ Description for Artifact Fireball
#: lang/json/SPELL_from_json.py
msgid "Causes an explosion at the target"
msgstr "Создаёт взрыв в указанной точке."

#: lang/json/SPELL_from_json.py
msgid "Artifact Flash"
msgstr "Артефакт - Вспышка"

#. ~ Description for Artifact Flash
#: lang/json/SPELL_from_json.py
msgid "Causes a flashbang at the target"
msgstr "Создаёт эффект светошумовой гранаты в указанной точке."

#: lang/json/SPELL_from_json.py
msgid "Artifact Paralyze"
msgstr "Артефакт - Паралич"

#. ~ Description for Artifact Paralyze
#: lang/json/SPELL_from_json.py
msgid "Paralyzes you for a second or two"
msgstr "Парализует вас на пару секунд."

#. ~ Message for SPELL '{'str': 'Artifact Paralyze'}'
#: lang/json/SPELL_from_json.py
msgid "You're paralyzed!"
msgstr "Вы парализованы!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Map"
msgstr "Артефакт - Карта"

#. ~ Description for Artifact Map
#: lang/json/SPELL_from_json.py
msgid "Reveals an area around you on the overmap"
msgstr "Раскрывает глобальную карту вокруг вас."

#. ~ Message for SPELL '{'str': 'Artifact Map'}'
#: lang/json/SPELL_from_json.py
msgid "You have a vision of the surrounding area…"
msgstr "У вас появилось знание об окружающей территории…"

#: lang/json/SPELL_from_json.py
msgid "Artifact Firestorm"
msgstr "Артефакт - Огненная буря"

#. ~ Description for Artifact Firestorm
#: lang/json/SPELL_from_json.py
msgid "Calls a firestorm around you"
msgstr "Вызывает огненную бурю вокруг вас."

#. ~ Message for SPELL '{'str': 'Artifact Firestorm'}'
#: lang/json/SPELL_from_json.py
msgid "Fire rains down around you!"
msgstr "Вокруг вас идёт огненный дождь!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Fun"
msgstr "Артефакт - Веселье"

#. ~ Description for Artifact Fun
#: lang/json/SPELL_from_json.py
msgid "Makes you feel pretty good"
msgstr "Поднимает вам настроение."

#. ~ Message for SPELL '{'str': 'Artifact Fun'}'
