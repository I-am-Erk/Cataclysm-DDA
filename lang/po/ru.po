#, c-format
msgid "Melee and thrown attack movement point cost: <color_white>%+d</color>\n"
msgstr ""
"Стоимость очков движения атак ближнего боя и метания: "
"<color_white>%+d</color>\n"

#: src/player_display.cpp
#, c-format
