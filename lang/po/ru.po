msgstr "Слияние кода!"

#: src/iuse.cpp
msgid "BUGFIXES!"
msgstr "БАГФИКСЫ!"

#: src/iuse.cpp
msgid "BUFFS!"
msgstr "БАФФЫ!"

#: src/iuse.cpp
msgid "NERFS!"
msgstr "НЕРФЫ!"

#: src/iuse.cpp
