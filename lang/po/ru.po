msgstr[1] "псевдо огненные пушки"
msgstr[2] "псевдо огненных пушек"
msgstr[3] "псевдо огненные пушки"

#: lang/json/gun_from_json.py
msgid ""
"Fires an explosive bolt of fiery energy.  If you're seeing this, it's a bug."
msgstr "Выпускает огненный заряд. Если вы видите это - это баг."

#: lang/json/gun_from_json.py
