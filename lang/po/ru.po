msgstr[1] "котомки"
msgstr[2] "котомок"
msgstr[3] "котомки"

#. ~ Description for bindle
#: lang/json/ARMOR_from_json.py
msgid ""
"You're ready for a trip down some train tracks.  Also known as a hobo stick."
msgstr ""
"Теперь вы готовы к путешествию по железной дороге. Также известна как палка "
"бродяги."

#: lang/json/ARMOR_from_json.py
