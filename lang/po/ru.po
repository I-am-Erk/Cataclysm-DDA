msgstr "Ваше оборудование (%s) затихает."

#: src/iuse.cpp
msgid "combat chainsaw"
msgstr "боевая бензопила"

#: src/iuse.cpp
msgid "Your combat chainsaw growls."
msgstr "рычание вашей боевой бензопилы."

#: src/iuse.cpp
msgid "electric combat chainsaw"
msgstr "боевая электропила"

#: src/iuse.cpp
