msgid "Your hands start shaking… you need some painkillers."
msgstr "Ваши руки начинают трястись… Вы нуждаетесь в болеутоляющих."

#: src/addiction.cpp
msgid "You feel anxious.  You need your painkillers!"
msgstr "У вас приступ тревожности. Вам нужно болеутоляющее!"

