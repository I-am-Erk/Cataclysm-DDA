#. ~ Name for scenario 'Scavenger' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Scavenger"
msgstr "Добытчик"

#. ~ Name for scenario 'Scavenger' for a female character
#: lang/json/scenario_from_json.py
