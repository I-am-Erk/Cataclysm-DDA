msgstr "Бункер добытчиков"

#. ~ Name for scenario 'Lost Faith' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Lost Faith"
msgstr "Потерявший веру"

#. ~ Name for scenario 'Lost Faith' for a female character
#: lang/json/scenario_from_json.py
