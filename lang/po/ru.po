#: lang/json/TOOL_from_json.py
msgid "leather journal"
msgid_plural "leather journals"
msgstr[0] "журнал в кожаной обложке"
msgstr[1] "журнала в кожаной обложке"
msgstr[2] "журналов в кожаной обложке"
msgstr[3] "журналы в кожаной обложке"

#. ~ Description for leather journal
#: lang/json/TOOL_from_json.py
msgid ""
"A leather-back journal for preserving notes and maps, has a strap to keep "
"loose pages contained."
msgstr ""
"Журнал с кожаной обложкой для хранения заметок и карт, имеет ремешок для "
"хранения незакрепленных страниц."

#: lang/json/TOOL_from_json.py
