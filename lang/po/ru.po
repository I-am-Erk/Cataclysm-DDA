msgstr[2] "пенных пушек"
msgstr[3] "пенные пушки"

#: lang/json/gun_from_json.py
msgid ""
"A stubby industrial tool used to shoot expanding foam.  Using it as a weapon"
" might require some creative thinking."
msgstr ""
"Короткий промышленный инструмент для применения расширяющейся пены. "
"Использовать его в качестве оружия можно только при помощи творческого "
"мышления."

#: lang/json/gun_from_json.py
