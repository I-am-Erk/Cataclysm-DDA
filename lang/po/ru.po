msgstr[2] "гексогено-песочных бомб"
msgstr[3] "гексогено-песочные бомбы"

#. ~ Use action msg for RDX sand bomb.
#: lang/json/TOOL_from_json.py
msgid "You light the fuse on the sand bomb.  Throw it!"
msgstr "Вы поджигаете фитиль песочной бомбы. Бросайте её!"

#. ~ Description for RDX sand bomb
#: lang/json/TOOL_from_json.py
msgid ""
"This is a steel pipe, containing a mixture of RDX and sand, the former "
"propelling the latter into a deadly mist of vicious shrapnel.  Use this item"
" to light the fuse."
msgstr ""
"Стальная труба, содержащая смесь гексогена и песка, образующая смертоносное "
"облако ужасающей шрапнели. Активируйте, чтобы зажечь фитиль."

#: lang/json/TOOL_from_json.py
msgid "active RDX sand bomb"
msgid_plural "active RDX sand bombs"
