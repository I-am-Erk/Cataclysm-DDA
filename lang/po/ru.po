msgstr[1] "рапиры"
msgstr[2] "рапир"
msgstr[3] "рапиры"

#. ~ Description for rapier
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a blunted, cheap replica of a thin sword with an ornate handguard.  "
"It looks like the preferred weapon of gentlemen and swashbucklers.  Light "
"and quick, it makes any battle a stylish battle."
msgstr ""
"Тупая и дешёвая подделка меча со штыкообразным клинком и эфесом сложной "
"формы. Любимое оружие джентльменов и пиратов. Лёгкая и быстрая, она делает "
"любую битву стильной."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
#: lang/json/TOOL_from_json.py
