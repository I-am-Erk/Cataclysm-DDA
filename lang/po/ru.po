msgstr[0] "линейный плазменный резак"
msgstr[1] "линейных плазменных резака"
msgstr[2] "линейных плазменных резаков"
msgstr[3] "линейные плазменные резаки"

#: lang/json/gun_from_json.py
msgid ""
"Experimental high power cutting tool under development in C.R.I.T R&D.  It "
"fires plasma in a wide line for slicing into dense materials."
msgstr ""
"Экспериментальный режущий инструмент высокой мощности, разработанный НИОКР "
"К.Р.И.Т. Он испускает широкий фронт чрезвычайно горячей плазмы, способной "
"рассекать плотные материалы."

#: lang/json/gun_from_json.py
