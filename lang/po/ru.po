#: lang/json/recipe_from_json.py lang/json/terrain_from_json.py
msgid "root cellar"
msgstr "погреб"

#: lang/json/recipe_from_json.py
msgid ""
"Digging a well will give us easy access to water and allow us to send out "
"combat patrols or scouts."
msgstr ""
"Колодец даст нам лёгкий доступ к воде и позволит высылать патрули и "
