msgstr "густой инсектицидный туман"

#: lang/json/field_type_from_json.py
msgid "smoke vent"
msgstr "дым из вытяжки"

#: lang/json/field_type_from_json.py
msgid "mechanical fluid splatter"
msgstr "брызги технической жидкости"

#: lang/json/field_type_from_json.py
msgid "mechanical fluid stain"
msgstr "пятно от технической жидкости"

#: lang/json/field_type_from_json.py
