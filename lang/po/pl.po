msgstr[0] "torebka do autoklawu"
msgstr[1] "torebki do autoklawu"
msgstr[2] "torebek do autoklawu"
msgstr[3] "torebki do autoklawu"

#. ~ Description for autoclave pouch
#: lang/json/AMMO_from_json.py
msgid ""
"This is a medical device that bears the approval of the FDA (Food and Drug "
"Administration).  If used properly, these pouches can keep things sterile "
"indefinitely."
msgstr ""
"To urządzenie medyczne jest zatwierdzone przez FDA (Administracja Żywności i"
" Leków). Przy prawidłowym stosowaniu, woreczki mogą utrzymywać sterylność w "
"nieskończoność."

