#: lang/json/TOOL_from_json.py
msgid ""
"A lightweight handheld cordless circular saw.  Spins a circular blade fast "
"enough to cut wood, zombies, or in an emergency, pizza.  The blade, while "
"effective in combat, is hard to hit with due to its small size."
msgstr ""
"Lekka ręczna bezprzewodowa piła tarczowa. Rozkręca okrągłe ostrze na tyle "
"prędko by ciąć drewno, zombiaki, i w sytuacjach awaryjnych pizzę. Ostrzem "
"piły, pomimo że to dobra broń w walce, ciężko trafić z uwagi na jego mały "
"rozmiar."

#: lang/json/TOOL_from_json.py
msgid "circular saw (on)"
msgid_plural "circular saws (on)"
msgstr[0] "piła tarczowa (wł.)"
msgstr[1] "piła tarczowa (wł.)"
msgstr[2] "piła tarczowa (wł.)"
msgstr[3] "piła tarczowa (wł.)"

