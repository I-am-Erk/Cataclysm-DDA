msgstr "< Naciśnij %s by filtrować, %s by zresetować >"

#: src/messages.cpp
#, c-format
msgid ""
"<color_light_gray>The default is to search the entire message log.  Use message-types as prefixes followed by (:) to filter more specific.\n"
"Valid message-type values are:</color> %s\n"
"\n"
"<color_white>Examples:</color>\n"
"  <color_light_green>good</color><color_white>:mutation\n"
"  :you pick up: 1</color>\n"
"  <color_light_red>bad</color><color_white>:</color>\n"
"\n"
msgstr ""
"<color_light_gray>Domyślnie szuka w całym logo wiadomości. Użyj typów wiadomości jako prefiksy zakończone (:) by filtr był bardziej szczegółowy.\n"
"Poprawne wartości typów wiadomości to:</color> %s\n"
"\n"
"<color_white>Przykłady:</color>\n"
"  <color_light_green>dobra</color><color_white>:mutacja\n"
"  :podnosisz: 1</color>\n"
"  <color_light_red>zła</color><color_white>:</color>\n"
"\n"

