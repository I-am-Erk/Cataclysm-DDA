msgid "\"south, south, south, south, south\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"north, north, north, north, north\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"Where am I?  Where am I?  Where am I?\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"It's very cold, It's very cold, It's very cold\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"dark, dark, where is everything\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "When the testing is over, you will be missed."
msgstr "Gdy skończą się testy, będziemy tęsknić."

#: lang/json/speech_from_json.py
msgid ""
"Unbelievable.  You, [subject name here], must be the pride of [subject "
"hometown here]!"
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"That thing is probably some sort of raw sewage container.  Go ahead and rub "
"your face all over it."
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"For your own safety and the safety of others, please refrain from touching "
"[bzzzzzt]"
msgstr ""
"Dla bezpieczeństwa własnego i innych proszę powstrzymaj się od dotykania "
"[bzzzzzzt]"

#: lang/json/speech_from_json.py
msgid ""
"No one will blame you for giving up.  In fact, quitting at this point is a "
"perfectly reasonable response."
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"Fantastic!  You remained resolute and resourceful in an atmosphere of "
"extreme pessimism."
msgstr ""

#: lang/json/speech_from_json.py
msgid "Hello again.  To reiterate our previous warning: [garbled]"
msgstr ""

#: lang/json/speech_from_json.py
msgid "Weeeeeeeeeeeeeeeeeeeeee[bzzt]"
msgstr "Weeeeeeeeeeeeeeeeeeeeee[bzzt]"

#: lang/json/speech_from_json.py
msgid "If you become light headed from thirst, feel free to pass out."
msgstr "Jeśli masz zawroty głowy z pragnienia, to możesz zawsze zemdleć."

#: lang/json/speech_from_json.py
msgid ""
"No further compliance information is required or will be provided, and you "
"are an excellent test subject!"
msgstr ""
"Więcej informacji o podporządkowaniu się nie nie będzie ani żądane ani "
"dostarczane, a ty jesteś doskonałym obiektem testowym!"

#: lang/json/speech_from_json.py
msgid "Thank you for helping us help you help us all."
msgstr ""
"Dziękuje  ci za pomoc nam w pomożeniu tobie w udzieleniu pomocy nam "
"wszystkim."

#: lang/json/speech_from_json.py
msgid ""
"Cake and grief counseling will be available at the conclusion of the test."
msgstr "Ciasto i konsolacja będzie dostępna po zakończeniu testu."

#: lang/json/speech_from_json.py
msgid "The experiment is nearing its conclusion."
msgstr "Eksperyment zbliża się do konkluzji."

#: lang/json/speech_from_json.py
msgid ""
"The Enrichment Center is required to remind you that you will be baked "
"[garbled] cake."
msgstr ""
"Centrum Wzbogacania jest w obowiązku przypomnieć ci że zostaniesz upieczone "
"[zniekształcone] ciasto."

#: lang/json/speech_from_json.py
msgid "We are very, very happy for your success."
msgstr "Bardzo, bardzo cieszymy się z twojego sukcesu."

#: lang/json/speech_from_json.py
msgid "We are throwing a party in honor of your tremendous success."
msgstr "Urządzamy przyjęcie dla uczczenia twojego olbrzymiego sukcesu."

#: lang/json/speech_from_json.py
msgid "A party associate will arrive shortly to collect you for your party."
msgstr ""
"Pracownik przyjęcia wkrótce przybędzie by zabrać cię na twoje przyjęcie."

#: lang/json/speech_from_json.py
msgid "I know you're there.  I can feel you here."
msgstr "Wiem że tam jesteś. Czuję tu twoją obecność."

#: lang/json/speech_from_json.py
msgid "You're not going the right way."
msgstr "Nie idziesz właściwą drogą."

#: lang/json/speech_from_json.py
msgid "You shouldn't be here.  This isn't safe for you."
msgstr "Nie powinieneś tu być. Nie jest tu dla ciebie bezpiecznie."

#: lang/json/speech_from_json.py
msgid ""
"Maybe you think you're helping yourself.  But you're not.  This isn't "
"helping anyone."
msgstr ""
"Może myślisz że sobie pomagasz. Ale tak nie jest. Nikomu w ten sposób nie "
"pomagasz."

#: lang/json/speech_from_json.py
msgid "It's not too late to turn back."
msgstr "Jeszcze nie jest za późno by zawrócić."

#: lang/json/speech_from_json.py
msgid "Someone is going to get badly hurt."
msgstr "Komuś stanie się poważna krzywda."

#: lang/json/speech_from_json.py
msgid ""
"Uh oh.  Somebody cut the cake.  I told them to wait for you, but they did it"
" anyway."
msgstr ""

#: lang/json/speech_from_json.py
msgid "This is your fault.  It didn't have to be like this."
msgstr "To twoja wina. To nie musiało się tak potoczyć."

#: lang/json/speech_from_json.py
msgid "You're not a good person.  You know that, right?"
msgstr "Nie jesteś dobrą osobą. Wiesz o tym, prawda?"

#: lang/json/speech_from_json.py
msgid "Good people don't end up here."
msgstr "Dobrzy ludzie tu nie trafiają."

#: lang/json/speech_from_json.py
msgid "You should have turned left before."
msgstr "Powinieneś przedtem skręcić w lewo."

#: lang/json/speech_from_json.py
msgid ""
"Despite your violent behavior, the only thing you've managed to break so far"
" is my heart."
msgstr ""
"Pomimo twojego agresywnego zachowania, jedyną rzeczą którą zdołałeś złamać "
"to mojej serce."

#: lang/json/speech_from_json.py
msgid "What was that?  Did you say something?"
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"I'd just like to point out that you were given every opportunity to succeed."
msgstr ""

#: lang/json/speech_from_json.py
msgid "What's your point, anyway?  Survival?"
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"You've been wrong about every single thing you've ever done, including this "
"thing."
msgstr ""
"Byłeś w błędzie z każda rzeczą którą kiedykolwiek zrobiłeś, w tym i tą "
"rzeczą."

#: lang/json/speech_from_json.py
msgid ""
"I have an infinite capacity for knowledge, and even I'm not sure what's "
"going on outside."
msgstr ""
"Mam nieskończoną pojemność na wiedzę, i nawet ja nie jestem pewna co się "
"dzieje na zewnątrz."

#: lang/json/speech_from_json.py
msgid ""
"Stop squirming and die like an adult or I'm going to delete your backup."
msgstr ""
"Przestań się wić i umrzyj jak dorosła osoba w przeciwnym wypadku skasuję "
"twoją kopię zapasową."

#: lang/json/speech_from_json.py
msgid "Good job on that, by the way.  SARCASM SPHERE SELF-TEST COMPLETE."
msgstr ""
"Dobra robota z tym tam, skoro o tym mowa. AUTO-TEST SFERY SARKAZMU "
"UKOŃCZONY."

#: lang/json/speech_from_json.py
msgid ""
"I don't want to tell you your business, but if it were me, I'd leave that "
"thing alone."
msgstr ""
"Nie chcę ci mówić co masz robić, ale jeśli o mnie chodzi to zostawiłabym tą "
"rzecz w spokoju."

#: lang/json/speech_from_json.py
msgid ""
"Let's be honest: Neither one of us knows what that thing does.  Just put it "
"in the corner, and I'll deal with it later."
msgstr ""
"Bądźmy szczerzy: Żadne z nasz nie wie co robi ta rzecz. Po prostu rzuć to w "
"kąt, a zajmę się tym później."

#: lang/json/speech_from_json.py
msgid ""
"I know you don't believe this, but everything that has happened so far was "
"for your benefit."
msgstr ""
"Wiem że w to nie wierzysz, ale wszystko co do tej pory się wydarzyło było na"
" twoją korzyść."

#: lang/json/speech_from_json.py
msgid ""
"I'm checking some blueprints, and I think…  Yes, right here.  You're "
"definitely going the wrong way."
msgstr ""

#: lang/json/speech_from_json.py
msgid "Are you even listening to me?"
msgstr "Czy ty w ogóle mnie słuchasz?"

#: lang/json/speech_from_json.py
msgid "\"I've got a feeling we're not in Kansas anymore.\""
msgstr "\"Mam wrażenie, że nie jesteśmy już w Kansas.\""

#: lang/json/speech_from_json.py
msgid "\"Go ahead, make my day.\""
msgstr "\"Śmiało, zrób mi frajdę.\""

#: lang/json/speech_from_json.py
msgid "\"You talkin' to me?\""
msgstr "\"Do mnie mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"Then who the hell else are you talkin' to?\""
msgstr "\"Do kogo więc mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"Well I'm the only one here.\""
msgstr "\"Nikogo tu nie widzę.\""

#: lang/json/speech_from_json.py
msgid "\"Who the fuck do you think you're talking to?\""
msgstr "\"Do kogo ty, kurwa, mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"What we've got here is failure to communicate.\""
msgstr "\"Oglądacie skutek braku porozumienia.\""

#: lang/json/speech_from_json.py
msgid "\"E.T.  phone home.\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"I'm as mad as hell, and I'm not going to take this anymore!\""
msgstr "\"Jestem wściekły jak diabli i nie wytrzymam tego dłużej!\""

#: lang/json/speech_from_json.py
msgid "\"There's no place like home.\""
msgstr "\"Wszędzie dobrze ale w domu najlepiej.\""

#: lang/json/speech_from_json.py
msgid "\"Badges?  We ain't got no badges!\""
msgstr "\"Odznaki? Nie nosimy odznak.\""

#: lang/json/speech_from_json.py
msgid ""
"\"We don't need no badges!  I don't have to show you any stinking badges!\""
msgstr "\"Nie potrzebujemy ich. Nie muszę ci pokazywać żadnych odznak.\""

#: lang/json/speech_from_json.py
msgid "\"I'll be back.\""
msgstr "\"Wrócę tu.\""

#: lang/json/speech_from_json.py
msgid "\"I see dead people.\""
msgstr "\"Widzę martwych ludzi.\""

#: lang/json/speech_from_json.py
msgid "\"It's alive!  It's alive!\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"Say hello to my little friend!\""
msgstr "\"Przywitaj się z moim małym przyjacielem!\""

#: lang/json/speech_from_json.py
msgid "\"Here's Johnny!\""
msgstr "\"Oto Johnny!\""

#: lang/json/speech_from_json.py
msgid "\"Open the pod bay doors, HAL.\""
msgstr "\"Otwórz właz, Hal.\""

#: lang/json/speech_from_json.py
msgid "\"They may take our lives, but they'll never take our freedom!\""
msgstr "\"Mogą odebrać nam życie, ale nigdy nie odbiorą nam wolności!\""

#: lang/json/speech_from_json.py
msgid ""
"\"If you let my daughter go now, that'll be the end of it.  I will not look "
"for you, I will not pursue you.\""
msgstr ""
"\"Jeśli w tej chwili wypuścisz moją córkę, nic ci nie grozi. Nie będę cię "
"szukać. Nie będę cię ścigać.\""

#: lang/json/speech_from_json.py
msgid ""
"\"If you don't, I will look for you, I will find you, and I will kill you.\""
msgstr "\"Jeśli tego nie zrobisz, zacznę cię szukać. A gdy cię znajdę, zabiję.\""

#: lang/json/speech_from_json.py
msgid "\"Roads?  Where we're going, we don't need roads.\""
msgstr "\"Drogi? Tam, gdzie się udajemy, nie potrzebujemy dróg.\""

#: lang/json/speech_from_json.py
msgid "\"Fasten your seatbelts.  It's going to be a bumpy night.\""
msgstr ""

#: lang/json/speech_from_json.py
msgid ""
"\"You've got to ask yourself one question:  'Do I feel lucky?'  Well, do ya "
"punk?\""
msgstr "\"Zadaj sobie pytanie: 'Mam farta?' Więc jak, śmieciu?\""

#: lang/json/speech_from_json.py
msgid "\"You had me at hello.\""
msgstr "\"Wystarczyło mi twoje 'cześć'.\""

#: lang/json/speech_from_json.py
msgid "\"Houston, we have a problem.\""
msgstr "\"Houston, mamy problem.\""

#: lang/json/speech_from_json.py
msgid "\"Yippie-ki-yay, motherfucker!\""
msgstr "\"Jupikajej, skurwysynu.\""

#: lang/json/speech_from_json.py
msgid "\"The first rule of The Lab is:  You do not talk about The Lab.\""
msgstr "\"Pierwsza zasada Laboratorium: nie rozmawiajcie o Laboratorium.\""

#: lang/json/speech_from_json.py
msgid "\"Don't be afraid.  It's just a big, big lap dog.\""
msgstr "\"Nie bój się, to jest tylko duży, wielki piesek salonowy.\""

#: lang/json/speech_from_json.py
msgid "\"Bring me everyone.\""
msgstr "\"Ściągnij wszystkich.\""

#: lang/json/speech_from_json.py
msgid "\"What do you mean everyone?\""
msgstr "\"Jak to wszystkich?\""

#: lang/json/speech_from_json.py
msgid "\"EVERYONE!\""
msgstr "\"WSZYSTKICH!\""

#: lang/json/speech_from_json.py
msgid "\"I'm going to make him an offer he can't refuse.\""
msgstr "\"Zamierzam złożyć mu propozycję nie do odrzucenia.\""

#: lang/json/speech_from_json.py
msgid "\"This is the beginning of a beautiful friendship.\""
msgstr "\"To początek pięknej przyjaźni.\""

#: lang/json/speech_from_json.py
msgid "\"You can’t handle the truth!\""
msgstr "\"Nie zniósłbyś prawdy!\""

#: lang/json/speech_from_json.py
msgid "\"If you built it, he will come.\""
msgstr "\"Jeśli zbudujesz, on przyjdzie.\""

#: lang/json/speech_from_json.py
msgid "\"Hasta la vista, baby.\""
msgstr "\"Hasta la vista, mały.\""

#: lang/json/speech_from_json.py
msgid "\"They’re here!\""
msgstr "\"Są tutaj.\""

#: lang/json/speech_from_json.py
msgid "\"Tis but a scratch!\""
msgstr "\"To tylko draśnięcie.\""

#: lang/json/speech_from_json.py
msgid "\"Frankly, my dear, I don't give a damn.\""
msgstr "\"Szczerze mówiąc, moja droga, nic mnie to nie obchodzi.\""

#: lang/json/speech_from_json.py
msgid "\"All work and no play makes Jack a dull boy.\""
msgstr "\"Wkurzają Jacka takie sprawy - ciągła praca, brak zabawy.\""

#: lang/json/speech_from_json.py
msgid "\"Remember: all I'm offering is the truth.  Nothing more.\""
msgstr "\"Pamiętaj, że mogę zaoferować ci prawdę i nic ponadto.\""

#: lang/json/speech_from_json.py
msgid "\"Don't call me Shirley.\""
msgstr "\"I nie jestem Chyba.\""

#: lang/json/speech_from_json.py
msgid "\"I have had it with these motherfucking snakes!\""
msgstr "\"Starczy mi pierdolonych węży w pierdolonym samolocie!\""

#: lang/json/speech_from_json.py
msgid ""
"\"Back up, put down the gun, and gimme some tropical flavored bubblicious.\""
msgstr "\"Cofnij się, odłóż spluwę i podaj mi paczkę gum owocowych.\""

#: lang/json/speech_from_json.py
msgid "\"And some skittles.\""
msgstr "\"I landrynki.\""

#: lang/json/speech_from_json.py
msgid "\"You'll shoot your eye out, kid.\""
msgstr "\"Wystrzelisz sobie oko, dzieciaku.\""

#: lang/json/speech_from_json.py
msgid "\"Cocainum!\""
msgstr "\"Cocainum!\""

#: lang/json/speech_from_json.py
msgid "\"I am your father.\""
msgstr "\"To ja jestem twoim Ojcem\""

#: lang/json/speech_from_json.py
msgid "\"Who said that?\""
msgstr "\"Kto to powiedział?\""

#: lang/json/speech_from_json.py
msgid "\"WHO THE FUCK SAID THAT?!\""
msgstr "\"Kto się odważył?\""

#: lang/json/speech_from_json.py
msgid "\"Bullshit!  You didn't convince me!  Show me your real war face!\""
msgstr ""

#: lang/json/speech_from_json.py
msgid "\"What is your major malfunction, numbnut?\""
msgstr "\"Główka nie pracuje kretynie?\""

#: lang/json/speech_from_json.py
msgid "\"Leeeeeeeeeeeeeroy!  Jenkins rebuild!\""
msgstr "\"Leeeeeeeeeeeeeroy! Jenkins rebuild!\""

#: lang/json/speech_from_json.py
msgid "\"Activated!\""
msgstr "\"Aktywna!\""

#: lang/json/speech_from_json.py
msgid "\"Search mode activated!\""
msgstr "\"Tryb wyszukiwania aktywowany!\""

#: lang/json/speech_from_json.py
msgid "\"Coming through!\""
msgstr "\"Przechodzę!\""

#: lang/json/speech_from_json.py
msgid "\"Deploying!\""
msgstr "\"Przygotowywanie!\""

#: lang/json/speech_from_json.py
msgid "\"Critical Error!\""
msgstr "\"Błąd krytyczny!\""

#: lang/json/speech_from_json.py
msgid "\"Ow ow ow!\""
msgstr "\"Auć auć!\""

#: lang/json/speech_from_json.py
msgid "\"Put me down!\""
msgstr "\"Odłóż mnie!\""

#: lang/json/speech_from_json.py
msgid "\"Target lost!\""
msgstr "\"Cel zgubiony!\""

#: lang/json/speech_from_json.py
msgid "\"Searching!\""
msgstr "\"Wyszukuję!\""

#: lang/json/speech_from_json.py
msgid "\"Hey!  It's me!\""
msgstr "\"Hej! To ja!\""

#: lang/json/speech_from_json.py
msgid "\"Ouch!\""
msgstr "\"Au!\""

#: lang/json/speech_from_json.py
msgid "\"Sentry mode activated.\""
msgstr "\"Tryb strażniczy aktywowany!\""

#: lang/json/speech_from_json.py
msgid "\"Hi.\""
msgstr "\"Cześć.\""

#: lang/json/speech_from_json.py
msgid "\"Target acquired.\""
msgstr "\"Cel namierzony.\""

#: lang/json/speech_from_json.py
msgid "\"Dispensing product.\""
msgstr "\"Wydaję produkt.\""

#: lang/json/speech_from_json.py
msgid "\"Firing.\""
msgstr "\"Strzelam.\""

#: lang/json/speech_from_json.py
msgid "\"Hello friend.\""
msgstr "\"Witaj przyjacielu.\""

#: lang/json/speech_from_json.py
msgid "\"Gotcha.\""
msgstr "\"Mam cię!\""

#: lang/json/speech_from_json.py
msgid "\"Is anyone there?\""
msgstr "\"Jest tam kto?\""

#: lang/json/speech_from_json.py
msgid "\"I see you.\""
msgstr "\"Widzę cię.\""

#: lang/json/speech_from_json.py
msgid "\"Could you come over here?\""
msgstr "\"Możesz tu podejść?\""

#: lang/json/speech_from_json.py
msgid "\"Hellooo.\""
msgstr "\"Czeeeść!\""

#: lang/json/speech_from_json.py
msgid "\"My fault.\""
msgstr "\"Moja wina.\""

#: lang/json/speech_from_json.py
msgid "\"Ohh.\""
msgstr "\"Ohh.\""

#: lang/json/speech_from_json.py
msgid "\"Critical error.\""
msgstr "\"Błąd krytyczny.\""

#: lang/json/speech_from_json.py
msgid "\"Shutting down.\""
msgstr "\"Zamykanie systemu.\""

#: lang/json/speech_from_json.py
msgid "\"I don't blame you.\""
msgstr "\"Nie obwiniam cię.\""

#: lang/json/speech_from_json.py
msgid "\"I don't hate you.\""
msgstr "\"Nie czuję nienawiści ku tobie.\""

#: lang/json/speech_from_json.py
msgid "\"Whyyyy.\""
msgstr "\"Czemuuuu.\""

#: lang/json/speech_from_json.py
msgid "\"No hard feelings.\""
msgstr "\"Nic do ciebie nie mam.\""

#: lang/json/speech_from_json.py
msgid "\"Aiaiaiaiaiai.\""
msgstr "\"Aiaiaiaiaiai.\""

#: lang/json/speech_from_json.py
msgid "\"Who are you?\""
msgstr "\"Kim jesteś?\""

