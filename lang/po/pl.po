msgstr[2] "patyki do rozpalania ognisk"
msgstr[3] "patyki do rozpalania ognisk"

#. ~ Description for camp fire drill
#: lang/json/TOOL_from_json.py
msgid ""
"This stout fire drill is a simple item for starting fires; it is made from "
"two pieces of wood and some string.  Since it is constructed out of simple "
"materials, it's slow and rather difficult to get a fire started using this "
"tool."
msgstr ""
"Prosty solidny przedmiot do rozpalania ognia złożony z dwóch kawałków drewna"
" i sznurka. Ponieważ składa się z tak prostych materiałów, to rozpalenie za "
"jego pomocą ognia jest długie i trudne."

