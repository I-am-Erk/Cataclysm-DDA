#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Shotgun Hunter"
msgstr "Myśliwy - pasjonat strzelb"

#. ~ Profession (male Shotgun Hunter) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Ever since you were a child you loved hunting, and one year you got a "
"shotgun for your birthday.  Why, if the world ended, there's nothing you'd "
"want at your side more than your trusty shotgun.  So, when it did, you made "
"sure to bring it along."
msgstr ""
"Od dziecka uwielbiałeś polowania, a pewnego roku dostałeś strzelbę na "
"urodziny. Dlatego, gdyby świat się skończył, nie chciałbyś mieć po swojej "
"stronie nic bardziej niż zaufaną strzelbę. Więc kiedy to się stało, "
"koniecznie zabrałeś ją ze sobą."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Shotgun Hunter"
msgstr "Myśliwy - pasjonatka strzelb"

#. ~ Profession (female Shotgun Hunter) description
#: lang/json/professions_from_json.py
