msgstr ""

#: lang/json/terrain_from_json.py
msgid "open retractable gate"
msgstr ""

#. ~ Description for open retractable gate
#: lang/json/terrain_from_json.py
msgid ""
"A retractable security gate with a latch system to stay closed.  The latch "
"is undone, so the gate has retracted up."
msgstr ""

