#. ~ Use action not_ready_msg for tanning leather hide.
#: lang/json/TOOL_from_json.py
msgid "The tanning leather hide isn't done yet."
msgstr "Wyprawiana skóra nie jest jeszcze gotowa."

#. ~ Description for tanning leather hide
#: lang/json/TOOL_from_json.py
msgid ""
"A treated animal hide which is undergoing the chemical processes required to"
" become leather.  You will be able to activate it to unroll and make use of "
"it when it is done."
msgstr ""
"Oprawiona skóra zwierzęca, która przechodzi przez proces chemiczny wymagany "
"by stała się skórą użytkową. Będziesz mógł ją aktywować, rozwinąć i użyć gdy"
" się wyprawi."

#: lang/json/TOOL_from_json.py
