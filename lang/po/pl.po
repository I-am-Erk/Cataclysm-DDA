msgstr "SUCHA"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
msgid "MEAT"
msgstr "MIĘSO"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
msgid "VEGGI"
msgstr "WARZYWA"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
msgid "SNACK"
msgstr "PRZEKĄSKI"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
msgid "BREAD"
msgstr "CHLEB"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
msgid "PASTA"
msgstr "MAKARONY"

#. ~ Crafting recipes subcategory of 'FOOD' category
#: lang/json/recipe_category_from_json.py
