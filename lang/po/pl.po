msgstr "Łup: inne"

#. ~ Description for Loot: Other
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for other miscellaneous items."
msgstr "Miejsce na inne niesklasyfikowane przedmioty."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Fuel"
msgstr "Łup: paliwo"

#. ~ Description for Loot: Fuel
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for gasoline, diesel, lamp oil and other substances used as a "
"fuel."
msgstr ""
"Miejsce na benzynę, diesla, olej do lamp i inne substancje używane jako "
"paliwa."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Seeds"
msgstr "Łup: nasiona"

#. ~ Description for Loot: Seeds
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for seeds, stems and similar items."
msgstr "Miejsce na nasiona, sadzonki, itp."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Chemical"
msgstr "Łup: chemia"

#. ~ Description for Loot: Chemical
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for chemicals."
msgstr "Miejsce na chemikalia."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: S.Parts"
msgstr "Łup: c.zamienne"

#. ~ Description for Loot: S.Parts
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for spare parts."
msgstr "Miejsce na części zamienne."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Artifacts"
msgstr "Łup: artefakty"

#. ~ Description for Loot: Artifacts
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for artifacts"
msgstr "Miejsce na artefakty."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Corpses"
msgstr "Łup: zwłoki"

#. ~ Description for Loot: Corpses
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for corpses"
msgstr "Miejsce na zwłoki."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Armor"
msgstr "Łup: zbroje"

#. ~ Description for Loot: Armor
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for armor.  Does include filthy armor if such zone is not "
"specified."
msgstr ""
"Miejsca na zbroje. Uwzględnia brudne zbroje, jeśli strefa na nie nie została"
" wyznaczona."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: F.Armor"
msgstr "Łup: b.zbroja"

#. ~ Description for Loot: F.Armor
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for filthy armor."
msgstr "Miejsce na brudne zbroje."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Wood"
msgstr "Łup: drewno"

#. ~ Description for Loot: Wood
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for firewood and items that can be used as such."
msgstr "Miejsce na drewno opałowe i inne rzeczy, które mogą za nie służyć."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Custom"
msgstr "Łup: własne"

#. ~ Description for Loot: Custom
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for loot with a custom filter that you can modify"
msgstr "Miejsce na łup z własnym filtrem, który możesz modyfikować."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Ignore"
msgstr "Łup: ignoruj"

#. ~ Description for Loot: Ignore
#: lang/json/LOOT_ZONE_from_json.py
msgid "Items inside of this zone are ignored by \"sort out loot\" zone-action."
msgstr "Rzeczy w tej strefie są ignorowane przez akcję strefową \"sortuj łup\"."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Ignore Favorites"
msgstr "Łup: ignoruj ulubione"

#. ~ Description for Loot: Ignore Favorites
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Favorite items inside of this zone are ignored by \"sort out loot\" zone-"
"action."
msgstr ""
"Ulubione przedmioty w tej strefie są ignorowane przez akcję strefową "
"\"sortuj łup\"."

#: lang/json/MOD_INFO_from_json.py src/color.cpp src/color.cpp src/options.cpp
msgid "default"
msgstr "domyślne"

#. ~ Description for default
#: lang/json/MOD_INFO_from_json.py
msgid "contains all the mods recommended by the developers"
msgstr "zawiera wszystkie mody rekomendowane przez twórców"

#: lang/json/MOD_INFO_from_json.py
msgid "Aftershock"
msgstr "Aftershock"

#. ~ Description for Aftershock
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Moving towards a survival horror full conversion mod set in a mostly "
"abandoned extrasolar colony far from Earth hundreds of years from today."
msgstr ""
"Zmierzająca w stronę survival horroru pełna konwersja osadzona w większości "
"opuszczonej pozasłonecznej kolonii z dala od Ziemi, setki lat od dzisiaj."

#: lang/json/MOD_INFO_from_json.py
msgid "Blaze Industries"
msgstr "Blaze Industries"

#. ~ Description for Blaze Industries
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Introduces the fictional corporation Blaze Industries, bringing advanced "
"vehicle modification to the consumer."
msgstr ""
"Załącza fikcyjną korporację Blaze Industries, dostarczającą zaawansowaną "
"modyfikację pojazdów konsumentom."

#: lang/json/MOD_INFO_from_json.py
msgid "C.R.I.T Expansion Mod"
msgstr "Mod rozszerzenie CRIT"

#. ~ Description for C.R.I.T Expansion Mod
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds a plethora of content: professions, guns/mods/weapons, WIP mobs, "
"mutations, MA styles, and some QOL innawoods changes.  Use the readme to see"
" more details!"
msgstr ""
"Dodaje pełno zawartości: zawody, spluwy/modyfikacje/bronie, stwory w wersji "
"roboczej, mutacje, style walki wręcz i wiele ułatwień do życia w lesie. Użyj"
" readme by widzieć więcej szczegółów!"

#: lang/json/MOD_INFO_from_json.py
msgid "Chibi Ultica"
msgstr "Chibi Ultica"

#. ~ Description for Chibi Ultica
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Uses Character, and Monster sprites from MSX with the UlticaShell tileset."
msgstr "Używa sprite'ów postaci i potworów z MSX z kafelkami UlticaShell."

#: lang/json/MOD_INFO_from_json.py
msgid "Crazy Cataclysm"
msgstr "Zwariowany Kataklizm"

#. ~ Description for Crazy Cataclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Want a little crazy in your Cataclysm?  Try this one."
msgstr "Chcesz szczyptę szaleństwa w twoim Kataklizmie? Wypróbuj ten mod."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Skies Above"
msgstr "Dark Skies Above"

#. ~ Description for Dark Skies Above
#: lang/json/MOD_INFO_from_json.py
msgid ""
"A total conversion that shifts the Cataclysm towards an alien occupation "
"survival scenario.  THIS MOD WILL BREAK INTENDED FUNCTIONALITY OF OTHER "
"MODS!  USE OTHER MODS AT YOUR OWN RISK."
msgstr ""
"Pełna konwersja, która kieruje Kataklizm w kierunku przetrwania okupacji "
"obcych. TEN MOD PSUJE ZAMIERZONĄ FUNKCJONALNOŚĆ INNYCH MODÓW! UŻYWAJ INNYCH "
"MODÓW NA WŁASNE RYZYKO."

#: lang/json/MOD_INFO_from_json.py
msgid "DinoMod"
msgstr "DinoMod"

#. ~ Description for DinoMod
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds dinosaurs.  Some rideable, others less friendly.  Life will find a way."
msgstr ""
"Dodaje dinozaury. Na niektórych można jeździć, inne są mniej przyjazne. "
"Życie znajdzie sposób."

#: lang/json/MOD_INFO_from_json.py
msgid "Fuji's Military Profession Pack"
msgstr "Paczka zawodów wojskowych od Fuji'ego"

#. ~ Description for Fuji's Military Profession Pack
#: lang/json/MOD_INFO_from_json.py
msgid "Numerous military themed professions"
msgstr "Wiele zawodów o tle wojskowym."

#: lang/json/MOD_INFO_from_json.py
msgid "Fuji's More Buildings"
msgstr "Więcej budynków od Fuji'ego"

#. ~ Description for Fuji's More Buildings
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds more buildings and more variations to existing buildings.  (Requires "
"More Locations)"
msgstr ""
"Dodaje więcej budynków i więcej wariacji do istniejących budynków (wymaga "
"więcej lokacji)."

#: lang/json/MOD_INFO_from_json.py
msgid "Generic Guns"
msgstr "Uproszczna broń palna"

#. ~ Description for Generic Guns
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Replaces guns and ammo with generic types.  Warning: can cause issues with "
"other gun mods."
msgstr ""
"Podmienia broń palną i amunicję na uproszczone rodzaje. Uwaga: może sprawiać"
" problemy z innymi modami broni palnej."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap"
msgstr "Graficzna mapa główna"

#. ~ Description for Graphical Overmap
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Gives the overmap a graphical overhaul.  Please refer to readme for "
"installation."
msgstr ""
"Daje mapie głównej graficzną przebudowę. Zapoznaj się z readme w celu "
"instalacji."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Fujistruct"
msgstr "Graficzna mapa główna Fujistruct"

#. ~ Description for Graphical Overmap Fujistruct
#: lang/json/MOD_INFO_from_json.py
msgid "Fuji Structures mod support for Graphical Overmap."
msgstr "Wsparcie moda struktur Fuji'ego dla graficznej mapy głównej."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Magiclysm"
msgstr "Graficzna mapa główna Magiclysm"

#. ~ Description for Graphical Overmap Magiclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Magiclysm support for Graphical Overmap."
msgstr "Wsparcie Magiclysm dla graficznej mapy głównej."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap More Locations"
msgstr "Graficzna mapa główna więcej lokacji"

#. ~ Description for Graphical Overmap More Locations
#: lang/json/MOD_INFO_from_json.py
msgid "More Locations mod support for Graphical Overmap."
msgstr "Wsparcie moda więcej lokacji dla graficznej mapy głównej."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Urban Development"
msgstr "Graficzna mapa rozwoju urbanistycznego"

#. ~ Description for Graphical Overmap Urban Development
#: lang/json/MOD_INFO_from_json.py
msgid "Urban Development mod support for Graphical Overmap."
msgstr "Wsparcie moda rozwój urbanistyczny dla graficznej mapy głównej."

#: lang/json/MOD_INFO_from_json.py
msgid "Mythical Martial Arts"
msgstr "Mityczne sztuki walki"

#. ~ Description for Mythical Martial Arts
#: lang/json/MOD_INFO_from_json.py
msgid ""
"A collection of fictional, mythologically inspired or otherwise unrealistic "
"martial arts."
msgstr ""
"Zbiór fikcyjnych, inspirowanych mitologią lub w inny sposób "
"nierealistycznych sztuk walki."

#: lang/json/MOD_INFO_from_json.py
msgid "Magiclysm"
msgstr "Magiclysm"

#. ~ Description for Magiclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Cataclysm but with magic spells!"
msgstr "Kataklizm, ale z magicznymi zaklęciami!"

#: lang/json/MOD_INFO_from_json.py
msgid "More Locations"
msgstr "Więcej lokacji"

#. ~ Description for More Locations
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds new Z-level buildings and dungeons.  Still unpolished.  Before "
"generating a world, you can remove subfolders to nix unwanted locations."
msgstr ""
"Dodaje nowe z-poziomowe budynki i lochy. Nadal niedoszlifowane. Przed "
"generacją świata, możesz usunąć podfoldery, by wykosić niechciane lokacje."

#: lang/json/MOD_INFO_from_json.py
msgid "Mutant NPCs"
msgstr "Zmutowani NPC"

#. ~ Description for Mutant NPCs
#: lang/json/MOD_INFO_from_json.py
msgid ""
"NPCs wandering the wasteland will occasionally have mutations --- your foes "
"included.  Beware!"
msgstr ""
"NPC przemierzający pustkowie będą czasem mieć mutacje - w tym twoi "
"przeciwnicy. Uważaj!"

#: lang/json/MOD_INFO_from_json.py
msgid "My Sweet Cataclysm"
msgstr "Mój słodki Kataklizm"

#. ~ Description for My Sweet Cataclysm
#: lang/json/MOD_INFO_from_json.py
msgid ""
"In the wake of the Cataclysm, sweets and snacks are coming to life.  You "
"could be one of them and walk through the Cataclysm as a human shaped piece "
"of sugar with your pet necco wafer, or you could just hunt them for some "
"sweet treats."
msgstr ""
"Na początku Kataklizmu, słodycze i przekąski ożywają. Możesz być jedną z "
"nich i przemierzać Kataklizm jako kawałek cukru o ludzkim kształcie wraz z "
"twoim wafelkowym zwierzaczkiem, lub możesz na nie polować dla słodkich "
"przekąsek."

#: lang/json/MOD_INFO_from_json.py
msgid "Beta National Guard Camp"
msgstr "Beta obozu Gwardii Narodowej"

#. ~ Description for Beta National Guard Camp
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Help test the national guard camp before inclusion into the base game.  "
"Provide feedback in the thread under 'The Lab'"
msgstr ""
"Pomóż testować obóz Gwardii Narodowej, zanim zostanie włączony do "
"podstawowej gry. Opisz wrażenia w wątku w sekcji „The Lab”."

#: lang/json/MOD_INFO_from_json.py
msgid "No Fungal Monsters"
msgstr "Bez grzybowych potworów"

#. ~ Description for No Fungal Monsters
#: lang/json/MOD_INFO_from_json.py
msgid "Removes fungal monsters and regions from the game."
msgstr "Usuwa grzybowe potwory i regiony z gry."

#: lang/json/MOD_INFO_from_json.py
msgid "Disable NPC Needs"
msgstr "Wyłącz potrzeby NPC"

#. ~ Description for Disable NPC Needs
#: lang/json/MOD_INFO_from_json.py
msgid "Makes NPCs not require food, water or rest."
msgstr "Sprawia że NPC nie potrzebują jedzenia, wody i odpoczynku."

#: lang/json/MOD_INFO_from_json.py
msgid "No Rail Stations"
msgstr "Bez stacji kolejowych"

#. ~ Description for No Rail Stations
#: lang/json/MOD_INFO_from_json.py
msgid "Removes above-ground rail stations from the game."
msgstr "Usuwa naziemne stacje kolejowe z gry."

#: lang/json/MOD_INFO_from_json.py
msgid "No Monsters"
msgstr "Bez potworów"

#. ~ Description for No Monsters
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Removes all monsters from the game, save for those in the WILDLIFE category."
msgstr ""
"Usuwa wszystkie potwory z gry, oprócz tych z kategorii \"dzikie zwierzęta\"."

#: lang/json/MOD_INFO_from_json.py
msgid "Stats Through Skills"
msgstr "Statystyki przez umiejętności"

#. ~ Description for Stats Through Skills
#: lang/json/MOD_INFO_from_json.py
msgid "Allows stats to raise via skill progression."
msgstr "Pozwala statystykom na rozwój przez progresję umiejętności."

#: lang/json/MOD_INFO_from_json.py
msgid "Urban Development"
msgstr "Rozwój urbanistyczny"

#. ~ Description for Urban Development
#: lang/json/MOD_INFO_from_json.py
msgid "Holder for suburban and urban buildings."
msgstr "Miejsce dla podmiejskich i miejskich budynków."

#: lang/json/MOD_INFO_from_json.py
msgid "Aftershock: Exoplanet"
msgstr "Aftershock: egzoplaneta"

#. ~ Description for Aftershock: Exoplanet
#: lang/json/MOD_INFO_from_json.py
msgid ""
"An experimental implementation of Aftershock's exoplanet region, not "
"recommended for actual playthroughs.  Adds no new content by itself, and "
"requires the main mod to function correctly."
msgstr ""
"Eksperymentalna implementacja regionu egzoplanety w Aftershock, nie polecana"
" do poważnych gier. Samo nie dodaje żadnej nowej zawartości i wymaga "
"głównego moda do działania."

#: lang/json/MOD_INFO_from_json.py
msgid "Alternative Map Key"
msgstr "Alternatywne klucze mapy"

#. ~ Description for Alternative Map Key
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Changes the overmap to be more readable.  Buildings are color coded by type "
"and use initial letter of their names instead of ^v<>."
msgstr ""
"Zmienia mapę główną na bardziej czytelną. Budynki są podzielone "
"kolorystycznie po typie i używają początkowej litery swej nazwy zamiast "
"^v<>."

#: lang/json/MOD_INFO_from_json.py
msgid "Bionic Slots"
msgstr "Sloty bioniczne"

#. ~ Description for Bionic Slots
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Enables the bionic slots system, which limits the number of CBMs you can "
"install in each bodypart."
msgstr ""
"Wprowadza system slotów implantów bionicznych, który ogranicza liczbę KMB "
"jakie możesz zainstalować w każdej części ciała."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Days of the Dead"
msgstr "Dark Days of the Dead"

#. ~ Description for Dark Days of the Dead
#: lang/json/MOD_INFO_from_json.py
msgid ""
"(Formerly Classic Zombies): Only spawn classic zombies (normal zombies and "
"zombie animals) and natural wildlife.  Zombies do not revive and do not need"
" pulping.  This disables certain buildings and map extras.  The long term "
"plan is to make this a classic zombie movie simulator set in the present "
"day.  If you have this mod enabled in experimental, some items may "
"disappear."
msgstr ""
"(Wcześniej Classic Zombies): spawnuje tylko klasyczne zombie (normalne "
"zombie i zwierzęta zombie) oraz naturalne dzikie zwierzęta. Zombie nie "
"wskrzeszają się i nie wymagają miażdżenia. Wyłącza to niektóre budynki i "
"dodatki mapy. Długoterminowy plan to uczynienie tego modu klasycznym "
"symulatorem filmów o zombie osadzonym we współczesności. Jeśli masz ten mod "
"włączony w wersji eksperymentalnej, niektóre przedmioty mogą zniknąć."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Days Ahead"
msgstr "Dark Days Ahead"

#. ~ Description for Dark Days Ahead
#: lang/json/MOD_INFO_from_json.py
msgid "Core content for Cataclysm-DDA"
msgstr "Podstawowa zawartość dla Cataclysm-DDA"

#: lang/json/MOD_INFO_from_json.py
msgid "Desert Region"
msgstr "Region pustynny"

#. ~ Description for Desert Region
#: lang/json/MOD_INFO_from_json.py
msgid "A testbed/WIP mod to showcase regional_map_settings JSON changes."
msgstr ""
"Pole testowe/wersja robocza modu by pokazać zmiany JSON w "
"regional_map_settings."

#: lang/json/MOD_INFO_from_json.py
msgid "Extra Mutated Scenarios"
msgstr "Dodatkowe scenariusze mutacji"

#. ~ Description for Extra Mutated Scenarios
#: lang/json/MOD_INFO_from_json.py
msgid "Extra scenarios with all possible mutation traits and thresholds."
msgstr ""
"Dodatkowe scenariusze ze wszystkimi możliwymi cechami mutacji i progami."

#: lang/json/MOD_INFO_from_json.py
msgid "Bionic Professions"
msgstr "Profesje bioniczne"

#. ~ Description for Bionic Professions
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Numerous bionic starting professions.  Disable for a more real-world "
"experience."
msgstr ""
"Wiele bionicznych startowych zawodów. Wyłącz dla doświadczenia bliższemu "
"prawdziwemu światu."

#: lang/json/MOD_INFO_from_json.py
msgid "Rural-Only Mapgen"
msgstr "Tylko wiejska generacja mapy"

#. ~ Description for Rural-Only Mapgen
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Play in the boonies: nothing but farms, forests, and villages.  Recommended "
"city size set to 1 and spacing set to 8."
msgstr ""
"Graj na wiosze, nic tylko farmy, lasy i osady. Rekomendowane ustawienie "
"wielkości miast na 1 i odstępu na 8."

#: lang/json/MOD_INFO_from_json.py
msgid "sees-player icon, HitButton_iso"
msgstr "Ikonka sees-player, HitButton_iso"

#. ~ Description for sees-player icon, HitButton_iso
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds indicator icon if a creature sees the player.  Designed for the "
"HitButton isometric tileset."
msgstr ""
"Dodaje ikonkę pokazującą jeśli stworzenie widzi gracza. Zaprojektowane dla "
"izometrycznego zestawu kafelków HitButton."

#: lang/json/MOD_INFO_from_json.py
msgid "sees-player icon, retrodays"
msgstr "Ikonka sees-player, retrodays"

#. ~ Description for sees-player icon, retrodays
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds indicator icon if a creature sees the player.  Designed for the "
"retrodays tileset."
msgstr ""
"Dodaje ikonkę pokazującą jeśli stworzenie widzi gracza. Zaprojektowane dla "
"zestawu kafelków retrodays."

#: lang/json/MOD_INFO_from_json.py
msgid "SpeedyDex"
msgstr "SpeedyDex"

#. ~ Description for SpeedyDex
#: lang/json/MOD_INFO_from_json.py
msgid "Higher dex increases your speed."
msgstr "Wyższa zręczność zwiększa twoją szybkość."

#: lang/json/MOD_INFO_from_json.py
msgid "Stats Through Kills"
msgstr "Statystyki poprzez zabicia"

#. ~ Description for Stats Through Kills
#: lang/json/MOD_INFO_from_json.py
msgid "You gain XP from kills that you can spend on increasing your stats."
msgstr ""
"Zabijając zyskujesz doświadczenie, które możesz zużyć na zwiększenie swoich "
"statystyk."

#: lang/json/MONSTER_from_json.py
msgid "huge dragonfly"
msgid_plural "huge dragonflies"
msgstr[0] "olbrzymia ważka"
msgstr[1] "olbrzymie ważki"
msgstr[2] "olbrzymich ważek"
msgstr[3] "olbrzymiej ważki"

#. ~ Description for huge dragonfly
#: lang/json/MONSTER_from_json.py
msgid ""
"A brightly colored, winged mutant dragonfly the size of a cat with sharp "
"fangs."
msgstr ""
"Jaskrawo ubarwiona, uskrzydlona ważka-mutant o wielkości kota z ostrymi "
"kłami."

#: lang/json/MONSTER_from_json.py
msgid "chicken"
msgid_plural "chickens"
msgstr[0] "kurczak"
msgstr[1] "kurczaki"
msgstr[2] "kurczaków"
msgstr[3] "kurczaka"

#. ~ Description for chicken
#: lang/json/MONSTER_from_json.py
msgid ""
"A domesticated descendant of junglefowl, it may still be the most numerous "
"bird in the world.  Before the Cataclysm, it was raised by humans as a "
"source of meat, eggs, and early morning wakeup calls."
msgstr ""
"Udomowiony potomek kura, ptaka z rodziny kurowatych. Może nadal jest "
"najliczniejszym ptakiem na świecie. Przed Kataklizmem hodowany przez ludzi "
"dla mięsa, jaj i porannego piania na pobudkę."

#: lang/json/MONSTER_from_json.py
msgid "grouse"
msgid_plural "grouses"
msgstr[0] "cietrzew"
msgstr[1] "cietrzewie"
msgstr[2] "cietrzewi"
msgstr[3] "cietrzewia"

#. ~ Description for grouse
#: lang/json/MONSTER_from_json.py
msgid ""
"A very common game bird, these creatures remind you of what a wild chicken "
"must have been like."
msgstr ""
"Powszechnie występująca zwierzyna łowna przypominająca ci jak mógł kiedyś "
"wyglądać dziki kurczak."

#: lang/json/MONSTER_from_json.py
msgid "crow"
msgid_plural "crows"
msgstr[0] "wrona"
msgstr[1] "wrony"
msgstr[2] "wron"
msgstr[3] "wrony"

#. ~ Description for crow
#: lang/json/MONSTER_from_json.py
msgid ""
"A small, elegant black bird, famous for its distinctive call.  An "
"intelligent bird, there is a glitter of mischief behind its eyes."
msgstr ""
"Mały, elegancki czarny ptak, znany z charakterystycznego odgłosu krakania. "
"Inteligentne zwierzę, z błyskiem szelmostwa w czarnych oczach."

#: lang/json/MONSTER_from_json.py
msgid "duck"
msgid_plural "ducks"
msgstr[0] "kaczka"
msgstr[1] "kaczki"
msgstr[2] "kaczek"
msgstr[3] "kaczki"

#. ~ Description for duck
#: lang/json/MONSTER_from_json.py
msgid ""
"A mallard duck, often seen around rivers and other bodies of water.  It "
"feeds primarily on insects, seeds, roots, and, pre-Cataclysm, bread scraps."
msgstr ""
"Kaczka krzyżówka, często widywana w pobliżu rzek i innych zbiorników "
"wodnych. Żywi się głównie owadami, nasionami, korzeniami roślin a przed "
"Kataklizmem także okruchami chleba."

#: lang/json/MONSTER_from_json.py
msgid "goose"
msgid_plural "geese"
msgstr[0] "gęś"
msgstr[1] "gęsi"
msgstr[2] "gęsi"
msgstr[3] "gęsi"

#. ~ Description for goose
#: lang/json/MONSTER_from_json.py
msgid "A Canadian goose, a common waterfowl that regrets leaving Canada."
msgstr ""
"Gęś kanadyjska to powszechnie występujący ptak wodny, który żałuje, że "
"opuścił Kanadę."

#: lang/json/MONSTER_from_json.py
msgid "turkey"
msgid_plural "turkeys"
msgstr[0] "indyk"
msgstr[1] "indyki"
msgstr[2] "indyków"
msgstr[3] "indyka"

#. ~ Description for turkey
#: lang/json/MONSTER_from_json.py
msgid ""
"A large and colorful game bird native to the forests of North America.  Its "
"head and beak are covered in fleshy protuberances."
msgstr ""
"Duży i kolorowy ptak łowny, znany z lasów Północnej Ameryki. Jego głowę "
"zdobią czerwone cieliste korale."

#: lang/json/MONSTER_from_json.py
msgid "pheasant"
msgid_plural "pheasants"
msgstr[0] "bażant"
msgstr[1] "bażanty"
msgstr[2] "bażantów"
msgstr[3] "bażanta"

#. ~ Description for pheasant
#: lang/json/MONSTER_from_json.py
msgid ""
"A medium-sized game bird that can have bright feathers depending on the sex "
"and species."
msgstr ""
"Średnich rozmiarów ptak łowny, który w zależności od płci i gatunku posiada "
"barwne upierzenie."

#: lang/json/MONSTER_from_json.py
msgid "cockatrice"
msgid_plural "cockatrices"
msgstr[0] "kokatryks"
msgstr[1] "kokatryksy"
msgstr[2] "kokatryksów"
msgstr[3] "kokatryksa"

#. ~ Description for cockatrice
#: lang/json/MONSTER_from_json.py
msgid ""
"This strange mutant bird gains its name from its odd appearance.  Although "
"its features seem to be becoming more reptilian, it doesn't appear "
"dangerous."
msgstr ""
"Dziwny ptak mutant biorący nazwę z osobliwego wyglądu. Choć jego cechy "
"fizyczne jakoby stawały się bardziej gadzie, to nie wygląda groźnie."

#: lang/json/MONSTER_from_json.py
msgid "yellow chick"
msgid_plural "yellow chicks"
msgstr[0] "żółte pisklę"
msgstr[1] "żółte pisklęta"
msgstr[2] "żółtych piskląt"
msgstr[3] "żółtego pisklęcia"

#. ~ Description for yellow chick
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny yellow and brown chick, it could be from a number of different "
"species."
msgstr ""
"Maciupkie żółtobrązowe pisklę, które może być młodym ptakiem kilku różnych "
"gatunków."

#: lang/json/MONSTER_from_json.py
msgid "brown chick"
msgid_plural "brown chicks"
msgstr[0] "brązowe pisklę"
msgstr[1] "brązowe pisklęta"
msgstr[2] "brązowych piskląt"
msgstr[3] "brązowego pisklęcia"

#: lang/json/MONSTER_from_json.py
msgid "strange chick"
msgid_plural "strange chicks"
msgstr[0] "dziwne pisklę"
msgstr[1] "dziwne pisklęta"
msgstr[2] "dziwnych piskląt"
msgstr[3] "dziwnego pisklęcia"

#. ~ Description for strange chick
#: lang/json/MONSTER_from_json.py
msgid "A strange tiny chick, it could be from a number of different species."
msgstr ""
"Dziwny maciupki pisklak, który może pochodzić z wielu różnych gatunków."

#: lang/json/MONSTER_from_json.py
msgid "waterfowl chick"
msgid_plural "waterfowl chicks"
msgstr[0] "wodne pisklę"
msgstr[1] "wodne pisklęta"
msgstr[2] "wodnych piskąt"
msgstr[3] "wodnego pisklęcia"

#. ~ Description for waterfowl chick
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny yellow and brown waterfowl chick, it could be from a number of "
"different species."
msgstr ""
"Maciupkie żółtobrązowe pisklę, które może być młodym ptakiem wodnym kilku "
"różnych gatunków."

#: lang/json/MONSTER_from_json.py
msgid "oversized crow"
msgid_plural "oversized crows"
msgstr[0] "przerośnięta wrona"
msgstr[1] "przerośnięte wrony"
msgstr[2] "przerośniętych wron"
msgstr[3] "przerośniętej wrony"

#. ~ Description for oversized crow
#: lang/json/MONSTER_from_json.py
msgid ""
"A horrible bird grown three or four times bigger than ought to be possible "
"and sporting a swollen gut that might look comical if it weren't for the "
"razor sharp beak and the madness in its beady eyes."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "bloated corvid"
msgid_plural "bloated corvids"
msgstr[0] "nadęte krukowate"
msgstr[1] "nadęte krukowate"
msgstr[2] "nadętych krukowatych"
msgstr[3] "nadętego krukowatego"

#. ~ Description for bloated corvid
#: lang/json/MONSTER_from_json.py
msgid ""
"This may have once been a crow or a raven, but now it's a deformed "
"monstrosity nearly the size of a man.  It heaves its sable bulk awkwardly "
"along the ground, too overfed on carrion to fly."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "pigeon"
msgid_plural "pigeons"
msgstr[0] "gołąb"
msgstr[1] "gołębie"
msgstr[2] "gołębi"
msgstr[3] "gołębia"

#. ~ Description for pigeon
#: lang/json/MONSTER_from_json.py
msgid ""
"Pigeons are gentle, plump, small-billed birds with a skin saddle (cere) "
"between the bill and forehead.  All pigeons strut about with a "
"characteristic bobbing of the head.  Because of their long wings and "
"powerful flight muscles, they are strong, swift fliers."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "broken cyborg"
msgid_plural "broken cyborgs"
msgstr[0] "zepsuty cyborg"
msgstr[1] "zepsute cyborgi"
msgstr[2] "zepsutych cyborgów"
msgstr[3] "zepsutego cyborga"

#. ~ Description for broken cyborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A robot body with the head of a human.  All kinds of electronic wires and "
"devices are implanted in its head.  Patches of skin look diseased or "
"rotting.  This cyborg moves erratically and has a confused and deranged look"
" in its eyes."
msgstr ""
"Robotyczne ciało z ludzką głową, w której implantowane są różne kable "
"elektryczne i urządzenia. Płaty skóry wyglądają na zakażone i przegniłe. Ten"
" cyborg porusza się nieregularnie a w oczach ma zdezorientowany, obłąkany "
"błysk."

#: lang/json/MONSTER_from_json.py
msgid "prototype cyborg"
msgid_plural "prototype cyborgs"
msgstr[0] "cyborg prototyp"
msgstr[1] "cyborgi prototypy"
msgstr[2] "cyborgów prototypów"
msgstr[3] "cyborga prototypu"

#. ~ Description for prototype cyborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A human fused with a mess of metal parts and wires.  While its eyes are "
"empty, flashes of pain pass across its face reminiscent of the person "
"trapped in this grotesque body.  With enough surgical skills one might be "
"able to give them back some humanity.  If only they cared…"
msgstr ""
"Człowiek złączony z mieszaniną metalowych części i kabli. Choć jego oczy są "
"puste, to skurcze bólu ogarniają jego twarz przypominają o osobie uwięzionej"
" w tym groteskowym ciele. Mając dość chirurgicznych umiejętności, ktoś "
"mógłby być w stanie przywrócić mu nieco człowieczeństwa. Gdyby tylko tego "
"kogoś to obchodziło…"

#: lang/json/MONSTER_from_json.py
msgid "Exodii worker"
msgid_plural "Exodii workers"
msgstr[0] "pracownik Exodii"
msgstr[1] "pracowników Exodii"
msgstr[2] "pracowników Exodii"
msgstr[3] "pracownika Exodii"

#. ~ Description for Exodii worker
#: lang/json/MONSTER_from_json.py
msgid ""
"This is a mostly humanoid robot equipped with various construction tools."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "Exodii quadruped"
msgid_plural "Exodii quadrupeds"
msgstr[0] "czworonóg Exodii"
msgstr[1] "czworonogi Exodii"
msgstr[2] "czworonogów Exodii"
msgstr[3] "czworonoga Exodii"

#. ~ Description for Exodii quadruped
#: lang/json/MONSTER_from_json.py
msgid ""
"This enormous quadrupedal robot seems to be cobbled together from parts, "
"most of them unfamiliar to you.  It moves with a heavy, oddly graceful gait,"
" its footsteps leaving shallow craters behind.  It bristles with an arsenal "
"of weaponry, but doesn't seem in a particular rush to target you."
msgstr ""

#: lang/json/MONSTER_from_json.py lang/json/MONSTER_from_json.py
#: src/monattack.cpp src/monattack.cpp
msgid "a chk!"
msgstr "a czuk!"

#: lang/json/MONSTER_from_json.py
msgid "zomborg"
msgid_plural "zomborgs"
msgstr[0] "zomborg"
msgstr[1] "zomborgi"
msgstr[2] "zomborgów"
msgstr[3] "zomborga"

#. ~ Description for zomborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A mix of dead human and even deader technology, this twisted mess of steel "
"and flesh moves like a puppet in the hands of an angry toddler.  Its robotic"
" components seem to have shut down, and new bands of flesh have wrapped "
"around them, tugging and pulling them in awkward directions.  Bits of "
"metallic skeleton and armor plating jut from its decaying flesh."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "police bot"
msgid_plural "police bots"
msgstr[0] "robot policyjny"
msgstr[1] "roboty policyjne"
msgstr[2] "robotów policyjnych"
msgstr[3] "robota policyjnego"

#. ~ Description for police bot
#: lang/json/MONSTER_from_json.py
msgid ""
"One of the many models of armored law enforcement robots employed shortly "
"before the collapse of civilization.  Solar powered like many other robots, "
"it maintains its programmed pursuit of law and order, propelled on a trio of"
" omni wheels."
msgstr ""
"Jeden z wielu modeli opancerzonych robotów sił porządkowych zatrudnionych na"
" krótko przed upadkiem cywilizacji. Jest zasilany słonecznie jak wiele "
"innych robotów, porusza się na trzech omni kołach, i jest posłuszny swojemu "
"oprogramowaniu nakazującemu mu utrzymywać prawo i porządek."

#: lang/json/MONSTER_from_json.py
msgid "riot control bot"
msgid_plural "riot control bots"
msgstr[0] "robot do kontroli zamieszek"
msgstr[1] "roboty do kontroli zamieszek"
msgstr[2] "robotów do kontroli zamieszek"
msgstr[3] "robota do kontroli zamieszek"

#. ~ Description for riot control bot
#: lang/json/MONSTER_from_json.py
msgid ""
"Nonviolent riot-control bot.  Designed to suppress riots and make mass "
"arrests of those participating.  Though its relaxation gas is by far its "
"best-known weapon, it carries a blinding flash and a low-powered stungun for"
" self-defense--in addition to its supply of electronic handcuffs."
msgstr ""
"Nieagresywny bot do tłumienia zamieszek. Opracowany by tłumić zamieszki i "
"dokonywać masowych aresztowań ich uczestników. Chociaż gaz rozluźniający to "
"jego jak dotąd najbardziej znana broń, to jako dodatek do zapasu "
"elektronicznych kajdanek wyposażony jest też w oślepiający flesz i małej "
"mocy strzelbę do obrony własnej."

#: lang/json/MONSTER_from_json.py
msgid "M16A4 autonomous TALON UGV"
msgid_plural "M16A4 autonomous TALON UGVs"
msgstr[0] "autonomiczny UGV TALON M16A4"
msgstr[1] "autonomiczne UGV TALON M16A4"
msgstr[2] "autonomicznych UGV TALON M16A4"
msgstr[3] "autonomicznego UGV TALON M16A4"

#. ~ Description for M16A4 autonomous TALON UGV
#: lang/json/MONSTER_from_json.py
msgid ""
"A TALON unmanned ground vehicle equipped with an M16A4.  It is a small "
"tracked UGV with an array of motors and sensors covering its weapon mount."
msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "\"Hostile detected.\""
msgstr ""

