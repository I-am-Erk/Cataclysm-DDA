#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Home Mechanic"
msgstr "Domowy mechanik"

#. ~ Profession (male Home Mechanic) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You've always loved cars, and there's nothing like getting under the hood "
"and fixing it yourself.  You've kept hold of some handy tools for the job, "
"and at least now you'll never want for parts."
msgstr ""
"Zawsze kochałeś samochody i nie ma to jak wejść pod maskę i naprawiać je "
"samemu. Zawsze trzymałeś jakieś poręczne narzędzia do pracy, a teraz "
"przynajmniej nigdy nie będziesz potrzebować części."

