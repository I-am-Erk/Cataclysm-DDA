msgstr "Mamy umowę! Zaakceptować wymianę?"

#: src/options.cpp
msgid "General"
msgstr "Ogólne"

#: src/options.cpp
msgid "Interface"
msgstr "Interfejs"

#: src/options.cpp
msgid "Graphics"
msgstr "Grafika"

#: src/options.cpp
msgid "World Defaults"
msgstr "Domyślne świata"

#: src/options.cpp
msgid "Android"
msgstr "Android"

#: src/options.cpp
#, c-format
msgid "Default: %s - Values: %s"
msgstr "Domyślne: %s. Wartości: %s"

#: src/options.cpp
msgid "Default: False"
msgstr "Domyślne: Fałsz"

#: src/options.cpp
msgid "Default: True"
msgstr "Domyślne: Prawda"

#: src/options.cpp
#, c-format
msgid "Default: %d - Min: %d, Max: %d"
msgstr "Domyślne: %d. Minimum: %d, maksimum: %d"

#: src/options.cpp
#, c-format
msgid "Default: %d: %s"
msgstr "Domyślne: %d: %s"

#: src/options.cpp
