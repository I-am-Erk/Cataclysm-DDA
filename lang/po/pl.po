#, c-format
msgid "%s is wasted by %s!"
msgstr "%s zostaje zmieciony przez %s!"

#: src/mission_companion.cpp
#, c-format
msgid "%s dodges %s's attack!"
msgstr "%s unika ataku %s!"

#: src/mission_companion.cpp
msgid "I'm sorry, you don't have enough money."
msgstr "Przykro mi, nie masz wystarczająco dużo pieniędzy."

#: src/mission_companion.cpp
#, c-format
msgid ""
"%s jots your name down on a ledger and yells out to nearby laborers to begin"
" plowing your new field."
msgstr ""
"%s wpisuje twoje imię do rejestru i krzyczy na robotników by zaorali twoje "
"nowe pole."

#: src/mission_companion.cpp
#, c-format
msgid ""
"After counting your money %s directs a nearby laborer to begin constructing "
