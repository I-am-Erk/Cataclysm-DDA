"Trading with %s.\n"
"%s to switch lists, letters to pick items, %s to finalize, %s to quit, %s to get information on an item."
msgstr ""
"Handel z %s.\n"
"%s zmienia listy, literami podnosi się przedmioty, %s finalizuje, %s wychodzi, %s, by uzyskać informacje o przedmiocie."

#: src/npctrade.cpp
#, c-format
msgid "Volume: %s %s, Weight: %.1f %s"
msgstr "Objętość: %s %s, Waga: %.1f %s"

#: src/npctrade.cpp
