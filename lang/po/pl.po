msgid "You can't effectively throw while you're in your shell."
msgstr "Nie możesz efektywnie rzucać, gdy jesteś w swojej skorupie."

#: src/avatar_action.cpp src/handle_action.cpp src/handle_action.cpp
#: src/handle_action.cpp src/iexamine.cpp src/iexamine.cpp src/melee.cpp
