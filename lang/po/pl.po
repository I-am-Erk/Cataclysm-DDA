#: lang/json/fault_from_json.py
msgid "Expired air filter"
msgstr ""

#. ~ description for fault '{'str': 'Expired air filter'}'
#: lang/json/fault_from_json.py
msgid ""
"An expired filter reduces fuel efficiency and increases smoke production."
msgstr "Zużyty filtr redukuje efektywność paliwa i zwiększa produkcję dymu."

#. ~ name of mending method for fault '{'str': 'Expired air filter'}'
#: lang/json/fault_from_json.py
