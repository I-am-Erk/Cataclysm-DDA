#: lang/json/fault_from_json.py
msgid "Active immobiliser"
msgstr ""

#. ~ description for fault '{'str': 'Active immobiliser'}'
#: lang/json/fault_from_json.py
msgid "Prevents starting of the vehicle without the appropriate key."
msgstr "Uniemożliwia uruchomienie silnika bez odpowiedniego klucza."

#. ~ name of mending method for fault '{'str': 'Active immobiliser'}'
#: lang/json/fault_from_json.py
msgid "Deactivate immobiliser"
msgstr ""

#. ~ description for mending method 'Deactivate immobiliser' of fault '{'str':
#. 'Active immobiliser'}'
#: lang/json/fault_from_json.py
msgid ""
"Deactivate the immobiliser that is preventing the vehicle from starting."
msgstr ""

#. ~ success message for mending method 'Deactivate immobiliser' of fault
#. '{'str': 'Active immobiliser'}'
#: lang/json/fault_from_json.py
#, python-format
msgid "You successfully deactivate the immobiliser of the %s."
msgstr ""

#: lang/json/fault_from_json.py
msgid "Faulty diesel pump"
msgstr ""

#. ~ description for fault '{'str': 'Faulty diesel pump'}'
#: lang/json/fault_from_json.py
msgid "Required to pump and pressurize diesel from a vehicles tank."
