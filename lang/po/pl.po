#: src/overmap.cpp src/skill.cpp
msgid "invalid"
msgstr "niepoprawne"

#: src/overmap.cpp
msgid ""
"Unable to place all configured specials, some missions may fail to "
"initialize."
msgstr ""
"Nie udało się umieścić wszystkich skonfigurowanych specjalnych lokacji, "
"niektóre misje mogą się nie znacjonalizować."

#: src/overmap.cpp
#, c-format
msgid ""
"This is automated emergency shelter beacon %d%d.  Supplies, amenities and "
"shelter are stocked."
msgstr ""
"Tu automatyczny nadajnik alarmowy schronu %d%d. Zapasy, wyposażenie i "
"schronienie są zapewnione."

#: src/overmap.cpp
#, c-format
msgid ""
"This is FEMA camp %d%d.  Supplies are limited, please bring supplemental "
"food, water, and bedding.  This is FEMA camp %d%d.  A designated long-term "
"emergency shelter."
msgstr ""
"Tu obóz FEMA %d%d. Zasoby są ograniczone, zabierzcie wodę, żywność i "
"śpiwory. Tu obóz FEMA %d%d. Wyznaczony schron alarmowy długiego okresu."

#: src/overmap_ui.cpp
msgid "Note preview"
msgstr "Podgląd notatki"

#: src/overmap_ui.cpp
msgid "Really delete note?"
msgstr "Na pewno usunąć notatkę?"

#: src/overmap_ui.cpp
msgid "Mark area as dangerous ( to avoid on automove paths? )"
msgstr ""
"Oznacz obszar jako niebezpieczny (by uniknąć ścieżek automatycznego ruchu?)"

#: src/overmap_ui.cpp
msgid "Danger radius in overmap squares? ( 0-20 )"
msgstr "Zasięg zagrożenia w kwadratach mapy głównej? (0-20)"

#: src/overmap_ui.cpp
msgid "Remove dangerous mark?"
msgstr "Usunąć znacznik niebezpieczeństwa?"

#: src/overmap_ui.cpp
#, c-format
