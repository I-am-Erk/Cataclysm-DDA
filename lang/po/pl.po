msgstr[2] "ręczne działo laserowe"
msgstr[3] "ręczne działo laserowe"

#: lang/json/gun_from_json.py
msgid ""
"This is a laser cannon stripped from the barrel of a TX-5LR Cerberus laser "
"turret that has been modified to use UPS power for firing."
msgstr ""
"Działo laserowe wymontowane z lufy wieżyczki laserowej TX-5LR Cerberus, "
"zmodyfikowane by używać do strzałów zasilania z UPS-a."

#: lang/json/gun_from_json.py
