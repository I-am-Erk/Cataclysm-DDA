msgstr ""
"Egyedi szabású, túlméretes, kevlarral páncélozott, textilbetétes kapucni, "
"nagyon könyű és tartós."

#: lang/json/ARMOR_from_json.py
msgid "winter faux fur survivor hood"
msgid_plural "winter faux fur survivor hoods"
msgstr[0] ""
msgstr[1] ""

