msgstr[1] "LW csőhosszabbító"

#: lang/json/gunmod_from_json.py
msgid ""
"A Leadworks built in longer barrel increases the muzzle velocity of a "
"firearm, contributing to both accuracy and damage."
msgstr ""
"A beépített Leadworks hosszabb csőve növeli a lőfegyver torkolati "
"sebességét, így javítja a pontosságát és károkozását."

#: lang/json/gunmod_from_json.py
