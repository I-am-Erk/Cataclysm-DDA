#: lang/json/AMMO_from_json.py
msgid "foreign rifle ammo, ball"
msgid_plural "foreign rifle ammo, ball"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'foreign rifle ammo, ball'}
#: lang/json/AMMO_from_json.py
msgid ""
"Foreign rifle ammo brought by the Exodii, and very common amongst them."
msgstr ""
"Külföldi puskás lőszer, amelyet az Exodii hozott magával, és nálunk nagyon "
"gyakori."

#: lang/json/AMMO_from_json.py
msgid "railgun rifle ammo"
msgid_plural "railgun rifle ammo"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'railgun rifle ammo'}
#: lang/json/AMMO_from_json.py
msgid ""
"Projectile used for a railgun.  It's made of a ferromagnetic metal, probably"
" cobalt."
msgstr ""
"Railgunban használt lövedék.  Ferromágneses fémből, valószínűleg kobaltból "
"készült."

#: lang/json/AMMO_from_json.py
msgid "huge rifle ammo, ball"
msgid_plural "huge rifle ammo, ball"
msgstr[0] "hatalmas karabély lőszer, golyó"
msgstr[1] "hatalmas karabély lőszer, golyó"

#. ~ Description for {'str_sp': 'huge rifle ammo, ball'}
#: lang/json/AMMO_from_json.py
msgid ""
"Huge rifle ammunition like this bridges the gap between light cannons and "
"big game rifles.  It's suitable for taking on light vehicles and other "
"materiel, or hunting extremely large game.  'Ball' is an old term for full "
"metal jacketed bullets which offer reduced fouling, better reliability, and "
"slightly improved penetration compared to plain lead."
msgstr ""
"Az ekkora méretű, hatalmas karabély lőszerek valahol a könnyű tüzérség és a "
"nagyvadak elleni puskák között találhatók. Könnyen páncélozott járművek és "
"egyéb gépek ellen is használható, valamint hatalmas vadakkal szemben is. A "
"golyó a teljesköpenyes lövedékek régies kifejezése, amely kevesebb "
"kormosodással, jobb megbízhatósággal, és némileg jobb átütőképességgel "
"rendelkezett a hagyományos ólomlövedékekhez képest."

#: lang/json/AMMO_from_json.py
msgid "huge rifle ammo, AP"
msgid_plural "huge rifle ammo, AP"
msgstr[0] "hatalmas karabély lőszer, AP"
msgstr[1] "hatalmas karabély lőszer, AP"

#. ~ Description for {'str_sp': 'huge rifle ammo, AP'}
#: lang/json/AMMO_from_json.py
msgid ""
"Huge rifle ammunition like this bridges the gap between light cannons and "
"big game rifles.  It's suitable for taking on light vehicles and other "
"materiel, or hunting extremely large game.  These armor piercing munitions "
"feature tungsten steel penetrators for use against light-skinned vehicles."
msgstr ""
"Az ekkora méretű, hatalmas karabély lőszerek valahol a könnyű tüzérség és a "
"nagyvadak elleni puskák között találhatók. Könnyen páncélozott járművek és "
"egyéb gépek ellen is használható, valamint hatalmas vadakkal szemben is. A "
"páncéltörő variánsokban volfram-acél penetrátorok találhatók a könnyen "
"páncélozott járművel leküzdésére."

#: lang/json/AMMO_from_json.py
