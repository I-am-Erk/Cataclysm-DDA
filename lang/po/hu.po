"A flavorful and filling beer brewed by monks in Belgium.  Best served in a "
"goblet."
msgstr ""
"Belga szerzetesek által főzött ízletes és laktató sör. Serlegben illik "
"felszolgálni."

#: lang/json/COMESTIBLE_from_json.py
msgid "imperial stout"
msgid_plural "imperial stout"
msgstr[0] "imperial stout"
msgstr[1] "imperial stout"

#. ~ Description for {'str_sp': 'imperial stout'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
