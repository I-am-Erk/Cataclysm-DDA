msgid "battery compartment mod"
msgid_plural "battery compartment mods"
msgstr[0] "aksitartó mod"
msgstr[1] "aksitartó mod"

#. ~ Description for battery compartment mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"A battery compartment mod that allows using vehicle batteries and small "
"storage batteries in regular tools."
msgstr ""
"Az aksitartó mod segítségével járművekben tölthető akkumulátort és "
"cserélhető akkumulátort használhatsz a rendes elemes eszközökben."

