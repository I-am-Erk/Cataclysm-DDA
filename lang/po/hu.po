msgstr "Az autodoki meghibásodása rengeted sebzést okoz rajta: <npcname>."

#: src/activity_handlers.cpp
#, c-format
msgid "Your %s is ripped open."
msgstr "A(z) %s széthasad."

#: src/activity_handlers.cpp
#, c-format
