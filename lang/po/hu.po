#: lang/json/AMMO_from_json.py
msgid "5.45x39mm 7N10"
msgid_plural "5.45x39mm 7N10"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': '5.45x39mm 7N10'}
#: lang/json/AMMO_from_json.py
msgid ""
"5.45x39mm 7N10 ammunition with 56gr FMJ bullets.  The 5.45x39mm round was "
"introduced along with the AK-74 in 1974.  It has superior wounding potential"
" to the older 7.62x39mm round and quickly replaced it in Soviet military "
"use."
msgstr ""
"5.45x39mm 7N10 lőszer 56 graines bronzköpenyes (FMJ) lövedékkel. Az "
"5.45x39mm lőszert 1974-ben fejlesztették ki az AK-74-hez. A régebbi "
"7.62x39mm lőszernél jobb a sebzési potenciálja, ezért azt gyorsan leváltotta"
" a szovjetek katonai felhasználásánál."

#: lang/json/AMMO_from_json.py
msgid "5.45x39mm 7N22"
msgid_plural "5.45x39mm 7N22"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': '5.45x39mm 7N22'}
#: lang/json/AMMO_from_json.py
msgid ""
"Armor piercing 5.45x39mm ammunition with 57gr bullets containing a steel "
"penetrator.  Developed in 1998 by the Russian military."
msgstr ""
"Páncéltörő 5.45x39mm lőszer 57 graines, acélpenetrátor lövedékkel. 1998-ban "
"fejlesztette ki az orosz hadsereg."

#: lang/json/AMMO_from_json.py
msgid "5.45x39mm, reloaded"
msgid_plural "5.45x39mm, reloaded"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': '5.45x39mm, reloaded'}
#: lang/json/AMMO_from_json.py
msgid ""
"The 5.45x39mm was the standard ammunition for the AK series from 1974.  Its "
"designers were inspired by the 5.56x45mm NATO cartridge.  This one has been "
"hand-reloaded."
msgstr ""
"Az 5.45x39mm-es töltény volt az 1974. utáni AK sorozatokhoz rendszeresített "
"lövedék. Tervezői az 5.56x45mm NATO munícióból merítettek ihletet. Ezt "
"kézzel újratöltötték."

#: lang/json/AMMO_from_json.py
msgid "5.45x39mm AP, reloaded"
msgid_plural "5.45x39mm AP, reloaded"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': '5.45x39mm AP, reloaded'}
#: lang/json/AMMO_from_json.py
msgid ""
"Armor piercing 5.45x39mm ammunition with hand-reloaded bullets containing a "
"steel penetrator.  Developed in 1998 by the Russian military."
msgstr ""
"Páncéltörő 5.45x39mm lőszer 57 graines, acélpenetrátor lövedékkel. 1998-ban "
"fejlesztette ki az orosz hadsereg."

