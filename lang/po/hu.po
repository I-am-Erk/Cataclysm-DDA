msgstr "A(z) %s készen áll az indulásra."

#: src/activity_handlers.cpp
#, c-format
msgid "The %s's engine fails to start."
msgid_plural "The %s's engines fail to start."
msgstr[0] "A(z) %s motorja nem indul el."
msgstr[1] "A(z) %s egyik motorja sem indul el."

#: src/activity_handlers.cpp src/vehicle_use.cpp src/vehicle_use.cpp
msgid "You let go of the controls."
msgstr "Elengeded a kormányt."

#: src/activity_handlers.cpp
msgid "hissssssssss!"
msgstr "hissssssssss!"

#: src/activity_handlers.cpp
msgid "With a satisfying click, the lock on the safe opens!"
msgstr "A széf zára egy kielégítő kattanással kinyílik!"

#: src/activity_handlers.cpp
