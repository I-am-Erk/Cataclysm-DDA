"A respectable length of wood, just big enough to wrap your hand around.  "
"Makes a decent melee weapon."
msgstr ""

#: lang/json/GENERIC_from_json.py
msgid "long stick"
msgid_plural "long sticks"
msgstr[0] ""
msgstr[1] ""

