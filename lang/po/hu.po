msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head shoots out, and its teeth sink into your %2$s!"
msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
