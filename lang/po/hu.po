#. ~ Description for {'str_sp': '9x18mm RG028'}
#: lang/json/AMMO_from_json.py
msgid ""
"9x18mm Makarov RG028 ammunition.  The RG028 round uses bullets with a "
"hardened steel core to improve armor penetration."
msgstr ""
"9x18mm Makarov RG028 lőszer. Az RG028 keményacélmagos kiépítésével erős "
"páncélátütő képességgel rendelkezik."

#: lang/json/AMMO_from_json.py
