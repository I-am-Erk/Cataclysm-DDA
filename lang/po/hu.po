msgstr "Egy tubus erős pillanatragasztó. Számos kézműves recept használja."

#: lang/json/GENERIC_from_json.py
msgid "bone glue"
msgid_plural "bone glues"
msgstr[0] "csontragasztó"
msgstr[1] "csontragasztó"

#. ~ Description for bone glue
#: lang/json/GENERIC_from_json.py
msgid ""
"Glue made from boiling animal bones.  The adhesive isn't strong enough for "
"heavy-duty usages, but it can be used as a varnish or holding together small"
" items."
msgstr ""
"Állati csontok forralásából készült enyv. A ragasztó nem elég erős a nagy "
"teherbírású feladatokhoz, de lakkozásra, illetve kisebb tárgyak egymáshoz "
"rögzítésére használható."

#: lang/json/GENERIC_from_json.py
msgid "fertilizer"
msgid_plural "fertilizers"
msgstr[0] "műtrágya"
msgstr[1] "műtrágya"

#. ~ Description for fertilizer
#: lang/json/GENERIC_from_json.py
