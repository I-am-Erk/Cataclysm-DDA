msgid_plural "cloaks"
msgstr[0] "palást"
msgstr[1] "palást"

#. ~ Description for cloak
#: lang/json/ARMOR_from_json.py
msgid "A heavy cloak meant to be thrown over your body."
msgstr "Testedre vetett nehéz palást."

#: lang/json/ARMOR_from_json.py
msgid "fur cloak"
msgid_plural "fur cloaks"
msgstr[0] "szőrpalást"
msgstr[1] "szőrpalást"

#. ~ Description for fur cloak
#: lang/json/ARMOR_from_json.py
msgid "A heavy fur cloak meant to be thrown over your body."
msgstr "Testedre vetett nehéz szőrme palást."

#: lang/json/ARMOR_from_json.py
msgid "leather cloak"
msgid_plural "leather cloaks"
msgstr[0] "bőrpalást"
msgstr[1] "bőrpalást"

#. ~ Description for leather cloak
#: lang/json/ARMOR_from_json.py
msgid "A heavy leather cloak meant to be thrown over your body."
msgstr "Testedre vetett nehéz bőrpalást."

#: lang/json/ARMOR_from_json.py
msgid "wool cloak"
msgid_plural "wool cloaks"
msgstr[0] "gyapjúpalást"
msgstr[1] "gyapjúpalást"

#. ~ Description for wool cloak
#: lang/json/ARMOR_from_json.py
msgid "A heavy woolen cloak meant to be thrown over your body."
msgstr "Testedre vetett nehéz gyapjúpalást."

#: lang/json/ARMOR_from_json.py
msgid "Jedi cloak"
msgid_plural "Jedi cloaks"
msgstr[0] "jedi palást"
msgstr[1] "jedi palást"

#. ~ Description for Jedi cloak
#: lang/json/ARMOR_from_json.py
msgid ""
"Long, flowing robes.  Simple and comfortable to wear.  Be sure to tear it "
"off dramatically before fighting any foes!"
msgstr ""
"Hosszan libegő palást. Egyszerű és kényelmes viselet. Az ellenséges harcok "
"előtt drámaian tépd le magadról!"

#: lang/json/ARMOR_from_json.py
msgid "wool poncho"
msgid_plural "wool ponchos"
msgstr[0] "gyapjú poncsó"
msgstr[1] "gyapjú poncsó"

#. ~ Description for wool poncho
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple wool garment worn over the torso.  Provides a bit of protection."
msgstr "Egyszerű, nyakba akasztható gyapjú ruhadarab. Némi védelmet nyújt."

#: lang/json/ARMOR_from_json.py
msgid "snuggie"
msgid_plural "snuggies"
msgstr[0] "bebújós takaró"
msgstr[1] "bebújós takaró"

#. ~ Description for snuggie
#: lang/json/ARMOR_from_json.py
msgid "Perfect for reading all those books you scavenged."
msgstr "Tökéletes viselet a sok lopott könyv elolvasásához."

#: lang/json/ARMOR_from_json.py
msgid "turnout coat"
msgid_plural "turnout coats"
msgstr[0] "tűzoltókabát"
msgstr[1] "tűzoltókabát"

#. ~ Description for turnout coat
#: lang/json/ARMOR_from_json.py
msgid ""
"A heavy protective coat worn by firefighters.  Highly resistant to heat and "
"flame, it provides excellent protection from injury."
msgstr ""
"Tűzoltók által viselt, nehéz védőkabát. Nagyon jól ellenáll a hőnek és a "
"lángoknak, kiváló védelmet nyújt a sebesülések ellen."

#: lang/json/ARMOR_from_json.py
msgid "cassock"
msgid_plural "cassocks"
msgstr[0] "reverenda"
msgstr[1] "reverenda"

#. ~ Description for cassock
#: lang/json/ARMOR_from_json.py
msgid "A piece of clerical clothing, usually worn by Christian priests."
msgstr ""
"A papok által viselt ruházat egy része, általában keresztény papok hordják."

#: lang/json/ARMOR_from_json.py
msgid "fur coat"
msgid_plural "fur coats"
msgstr[0] "szőrmekabát"
msgstr[1] "szőrmekabát"

#. ~ Description for fur coat
#: lang/json/ARMOR_from_json.py
msgid "A fur coat with a couple small pockets.  Extremely warm."
msgstr "Kicsi zsebes, szőrme kabát. Extrém mértékben meleg."

#: lang/json/ARMOR_from_json.py
msgid "XL fur coat"
msgid_plural "XL fur coats"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "faux fur coat"
msgid_plural "faux fur coats"
msgstr[0] "műszőrme kabát"
msgstr[1] "műszőrme kabát"

#. ~ Description for faux fur coat
#: lang/json/ARMOR_from_json.py
msgid ""
"A garishly-colored faux fur coat with a couple small pockets.  Although not "
"as warm as the natural fur, it gives you some of that unique flair."
msgstr ""
"Rikító színű műszőrme kabát néhány zsebbel. Bár nem olyan meleg, mint a "
"természetes szőrme, ilyet más biztosan nem hord."

#: lang/json/ARMOR_from_json.py
msgid "XL faux fur coat"
msgid_plural "XL faux fur coats"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "sable coat"
msgid_plural "sable coats"
msgstr[0] "cobolyprém kabát"
msgstr[1] "cobolyprém kabát"

#. ~ Description for sable coat
#: lang/json/ARMOR_from_json.py
msgid ""
"A very well-made fur coat, featuring thick panels of sable fur.  Very warm "
"and very good-looking."
msgstr ""
"Egy nagyon jó minőségű bunda, vastag cobolyprémből. Nagyon meleg és nagyon "
"jól nézel ki benne."

#: lang/json/ARMOR_from_json.py
msgid "lab coat"
msgid_plural "lab coats"
msgstr[0] "laborköpeny"
msgstr[1] "laborköpeny"

#. ~ Description for lab coat
#: lang/json/ARMOR_from_json.py
msgid ""
"A long white coat with several large pockets.  Comes with a very nice pocket"
" protector."
msgstr ""
"Hosszú fehér kabát, több nagyméretű zsebbel. Nagyon szép zsebvédő jár hozzá."

#: lang/json/ARMOR_from_json.py
msgid "rain coat"
msgid_plural "rain coats"
msgstr[0] "esőkabát"
msgstr[1] "esőkabát"

#. ~ Description for rain coat
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic coat with a hood and two very large pockets.  Provides protection "
"from rain."
msgstr ""
"Műanyag kabát két nagy zsebbel és kapucnival. Védelmet nyújt az eső ellen."

#: lang/json/ARMOR_from_json.py
msgid "straw cape"
msgid_plural "straw capes"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for straw cape
#: lang/json/ARMOR_from_json.py
msgid ""
"A bulky traditional Japanese raincoat made from straw, which covers the "
"entire body.  Also known as mino."
msgstr ""
"Szalmából készült terjedelmes, hagyományos japán esőkabát, amely az egész "
"testet beborítja.  Mino néven is ismert."

#: lang/json/ARMOR_from_json.py
msgid "gutskin parka"
msgid_plural "gutskin parkas"
msgstr[0] "bélbőr parka"
msgstr[1] "bélbőr parka"

#. ~ Description for gutskin parka
#: lang/json/ARMOR_from_json.py
msgid ""
"An intricately sewn coat of treated and split intestines, prized for its "
"light weight and waterproofness among the indigenous peoples of the arctic."
msgstr ""
"Cserzett és összevart belekből készített kabát, amelyet a sarkvidéken élők "
"könnyű súlya és vízhatlansága miatt kedvelnek."

#: lang/json/ARMOR_from_json.py
msgid "winter coat"
msgid_plural "winter coats"
msgstr[0] "télikabát"
msgstr[1] "télikabát"

#. ~ Description for winter coat
#: lang/json/ARMOR_from_json.py
msgid "A padded coat with deep pockets and a hood.  Very warm."
msgstr "Mély zsebes és kapucnis, vastagon bélelt kabát. Nagyon meleg."

#: lang/json/ARMOR_from_json.py
msgid "duster"
msgid_plural "dusters"
msgstr[0] "duster kabát"
msgstr[1] "duster kabát"

#. ~ Description for duster
#: lang/json/ARMOR_from_json.py
msgid "A rugged full-length duster coat.  Has many pockets for storage."
msgstr "Teljes hosszúságú duster kabát, számos tároló zsebbel."

#: lang/json/ARMOR_from_json.py
msgid "fur duster"
msgid_plural "fur dusters"
msgstr[0] "szőrme duster kabát"
msgstr[1] "szőrme duster kabát"

#. ~ Description for fur duster
#: lang/json/ARMOR_from_json.py
msgid "A thick fur full-length duster.  Has many pockets for storage."
msgstr "Teljes hosszúságú duster kabát szőrből, számos tároló zsebbel."

#: lang/json/ARMOR_from_json.py
msgid "XL fur duster"
msgid_plural "XL fur dusters"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "XL duster"
msgid_plural "XL dusters"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "faux fur duster"
msgid_plural "faux fur dusters"
msgstr[0] "műszőrme duster kabát"
msgstr[1] "műszőrme duster kabát"

#. ~ Description for faux fur duster
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick faux fur duster, falling below your knees.  Has many pockets for "
"storing things."
msgstr "Térdig érő vastag duster kabát műszőrből, számos tároló zsebbel."

#: lang/json/ARMOR_from_json.py
msgid "XL faux fur duster"
msgid_plural "XL faux fur dusters"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "leather duster"
msgid_plural "leather dusters"
msgstr[0] "bőr duster kabát"
msgstr[1] "bőr duster kabát"

#. ~ Description for leather duster
#: lang/json/ARMOR_from_json.py
msgid "A thick leather full-length duster.  Has many pockets for storage."
msgstr "Teljes hosszúságú duster kabát bőrből, számos tároló zsebbel."

#: lang/json/ARMOR_from_json.py
msgid "XL leather duster"
msgid_plural "XL leather dusters"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "survivor duster"
msgid_plural "survivor dusters"
msgstr[0] "túlélő duster kabát"
msgstr[1] "túlélő duster kabát"

#. ~ Description for survivor duster
#: lang/json/ARMOR_from_json.py
msgid ""
"A Kevlar armored custom full-length duster, covered with pouches and "
"pockets.  Comfortable, durable, and great for storage."
msgstr ""
"Kevlarral páncélozott, egyedi készítésű duster kabát, tele zsebbel. "
"Kényelmes, tartós és tárolásra nagyon jó."

#: lang/json/ARMOR_from_json.py
msgid "XL survivor duster"
msgid_plural "XL survivor dusters"
msgstr[0] ""
msgstr[1] ""

#: lang/json/ARMOR_from_json.py
msgid "greatcoat"
msgid_plural "greatcoats"
msgstr[0] "suba"
msgstr[1] "suba"

#. ~ Description for greatcoat
#: lang/json/ARMOR_from_json.py
msgid ""
"A heavy, full-length wool coat.  Cumbersome, but warm and with deep pockets."
msgstr ""
"Nehéz, bokáig érő gyapjúkabát. Ormótlan, de jó meleg és mélyek a zsebei."

#: lang/json/ARMOR_from_json.py
msgid "hakama"
msgid_plural "hakamas"
msgstr[0] "hakama"
msgstr[1] "hakama"

#. ~ Description for hakama
#: lang/json/ARMOR_from_json.py
msgid "Plain black hakama for use in kendo and other martial arts."
msgstr "Jelöletlen fekete hakama kendó és egyéb harcművészetek számára."

#. ~ Description for hakama
#: lang/json/ARMOR_from_json.py
msgid "A flowing, pleated garment which can be worn over a kimono."
msgstr "Egy kimonó felett viselhető hullámzó, rakott ruhadarab."

#: lang/json/ARMOR_from_json.py
msgid "bathrobe"
msgid_plural "bathrobes"
msgstr[0] "fürdőköpeny"
msgstr[1] "fürdőköpeny"

#. ~ Description for bathrobe
#: lang/json/ARMOR_from_json.py
msgid ""
"An outer garment of absorbent, towel-like material traditionally worn to "
"cover one's nakedness to and from the bath.  It makes you wish you had "
"running water to bathe with."
msgstr ""
"Nedvszívó, törülközőszerű anyagból készült felsőruházat, amelyet "
"hagyományosan a fürdőig tartó meztelenség elrejtésére viselnek.  Bárcsak "
"lenne egy kádnyi folyóvized..."

#: lang/json/ARMOR_from_json.py
msgid "army jacket"
msgid_plural "army jacket"
msgstr[0] "military dzseki"
msgstr[1] "military dzseki"

#. ~ Description for {'str_sp': 'army jacket'}
#: lang/json/ARMOR_from_json.py
msgid "A tough jacket with lots of pockets.  Favored by the military."
msgstr "Strapabíró kialakítású, sokzsebes dzseki. A katonák kedvelik."

#: lang/json/ARMOR_from_json.py
msgid "chef's jacket"
msgid_plural "chef's jackets"
msgstr[0] "séf dzseki"
msgstr[1] "séf dzseki"

#. ~ Description for chef's jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"This double-breasted uniform is unusually thick to protect against the heat "
"of the kitchen."
msgstr ""
"Ez a duplamellényes uniformis szokatlanul vastag, hogy a konyha hőhatásai "
"ellen is védelmet nyújtson."

#: lang/json/ARMOR_from_json.py
msgid "emergency jacket"
msgid_plural "emergency jackets"
msgstr[0] "vészhelyzeti dzseki"
msgstr[1] "vészhelyzeti dzseki"

#. ~ Description for emergency jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A bright & cheaply made FEMA-issue windbreaker jacket with a hood.  One "
"size, fits none.  Helps keep you unfrozen & visible for rescuers."
msgstr ""
"Rikító színű, olcsó kivitelű, FEMA által szétosztott kapucnis széldzseki. "
"Egyetlen méretben készült, ami senkire se jó. Segít abban, hogy ne fagyjál "
"szét, amíg megérkezik a segítség."

#: lang/json/ARMOR_from_json.py
msgid "flannel jacket"
msgid_plural "flannel jackets"
msgstr[0] "flaneldzseki"
msgstr[1] "flaneldzseki"

#. ~ Description for flannel jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A jacket made from flannel-style denim, favored by outdoorsy types.  "
"Provides decent protection from cuts."
msgstr ""
"Flanel stílusú farmerszövetből készült favágó dzseki. Egész jól véd a "
"vágásoktól."

#: lang/json/ARMOR_from_json.py
msgid "jean jacket"
msgid_plural "jean jackets"
msgstr[0] "farmerdzseki"
msgstr[1] "farmerdzseki"

#. ~ Description for jean jacket
#: lang/json/ARMOR_from_json.py
msgid "A jacket made from denim.  Provides decent protection from cuts."
msgstr "Farmerszövetből készült kék dzseki. Egész jól véd a vágásoktól."

#: lang/json/ARMOR_from_json.py
msgid ""
"A jacket made from denim.  Provides decent protection from cuts.  This one "
"is haphazardly covered with patches featuring metal band logos."
msgstr ""
"Farmerszövetből készült kék dzseki. Egész jól véd a vágásoktól. Ezen "
"különféle metál zenekarok logói láthatók."

#: lang/json/ARMOR_from_json.py
msgid "leather jacket"
msgid_plural "leather jackets"
msgstr[0] "bőrdzseki"
msgstr[1] "bőrdzseki"

#. ~ Description for leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A jacket made from thick leather.  Cumbersome, but offers excellent "
"protection from cuts."
msgstr ""
"Vastag bőrből készült dzseki. Ormótlan, de nagyon jól véd a vágásoktól."

#: lang/json/ARMOR_from_json.py
msgid "red leather jacket"
msgid_plural "red leather jackets"
msgstr[0] "vörös bőrdzseki"
msgstr[1] "vörös bőrdzseki"

#. ~ Description for red leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A candy-apple-red leather jacket with black strips and shoulder protrusions."
"  It has a number of zippers and snaps in the front."
msgstr ""
"Piros nyalóka színű bőrdzseki fekete csíkokkal és kitömött vállal. Az elején"
" számos cipzár és patent található."

#: lang/json/ARMOR_from_json.py
msgid "light jacket"
msgid_plural "light jackets"
msgstr[0] "átmeneti dzseki"
msgstr[1] "átmeneti dzseki"

#. ~ Description for light jacket
#: lang/json/ARMOR_from_json.py
msgid "A thin cotton jacket with a hood.  Good for brisk weather."
msgstr "Vékony pamutdzseki kapucnival. Szeles időben jól jön."

#: lang/json/ARMOR_from_json.py
msgid "windbreaker"
msgid_plural "windbreakers"
msgstr[0] "nejlon viharkabát"
msgstr[1] "nejlon viharkabát"

#. ~ Description for windbreaker
#: lang/json/ARMOR_from_json.py
msgid ""
"A light synthetic jacket with a hood.  Not very warm, but will keep out the "
"rain."
msgstr "Műszálas köpeny kapucnival. Nem túl meleg, de az esőt kívül tartja."

#: lang/json/ARMOR_from_json.py
msgid "judo gi"
msgid_plural "judo gis"
msgstr[0] "dzsúdó gi"
msgstr[1] "dzsúdó gi"

#. ~ Description for judo gi
#: lang/json/ARMOR_from_json.py
msgid ""
"Plain white judo gi.  Thick and a little stiff, it gives minor protection "
"from cuts and punches."
msgstr ""
"Jelöletlen fehér dzsúdó gi. Vastag és egy kicsit merev, vajmi kevés védelmet"
" nyújt a vágások és az ütések ellen."

#: lang/json/ARMOR_from_json.py
msgid "karate gi"
msgid_plural "karate gis"
msgstr[0] "karate gi"
msgstr[1] "karate gi"

#. ~ Description for karate gi
#: lang/json/ARMOR_from_json.py
msgid ""
"Plain white karate gi.  Loose and flowing, it offers little protection, and "
"little encumbrance."
msgstr ""
"Jelöletlen fehér karate gi. Laza és hajlékony, kevés védelmet nyújt és csak "
"egy picit ormótlan."

#: lang/json/ARMOR_from_json.py
msgid "kariginu"
msgid_plural "kariginus"
msgstr[0] "kariginu"
msgstr[1] "kariginu"

#. ~ Description for kariginu
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, ankle-length Shinto robe with several layers and very wide "
"sleeves."
msgstr ""
"Hagyományos, bokáig érő sintó köpeny számos réteggel és nagyon széles "
"ujjakkal."

#: lang/json/ARMOR_from_json.py
msgid "kasaya"
msgid_plural "kasayas"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for kasaya
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, ankle-length Buddhist robe, stitched together from three "
"pieces of traditional saffron dyed cloth."
msgstr ""
"Hagyományos, bokáig érő buddhista köntös, amelyet három darab, hagyományosan"
" sáfrányból festett kendőből varrtak."

#: lang/json/ARMOR_from_json.py
msgid "keikogi"
msgid_plural "keikogis"
msgstr[0] "keikogi"
msgstr[1] "keikogi"

#. ~ Description for keikogi
#: lang/json/ARMOR_from_json.py
msgid "Plain white keikogi for use in martial arts."
msgstr "Jelöletlen fehér keikogi harcművészetek számára."

#: lang/json/ARMOR_from_json.py
msgid "kimono"
msgid_plural "kimono"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'kimono'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, ankle-length Japanese robe, wrapped around the body with a "
"sash."
msgstr ""
"Hagyományos, bokáig érő japán köntös, amelyet a test köré egy széles "
"selyemövvel rögzítenek."

#: lang/json/ARMOR_from_json.py
msgid "yukata"
msgid_plural "yukatas"
msgstr[0] "jukata"
msgstr[1] "jukata"

#. ~ Description for yukata
#: lang/json/ARMOR_from_json.py
msgid ""
"An easy-to-wear, breezy robe secured with a sash.  Essentially Japanese "
"pajamas.  Great for summer nights."
msgstr ""
"Selyemövvel zárható, könnyen hordható, szellős köpeny - gyakorlatilag egy "
"japán pizsama. Nyári éjszakákra nagyszerű."

#: lang/json/ARMOR_from_json.py
msgid "haori"
msgid_plural "haoris"
msgstr[0] "haori"
msgstr[1] "haori"

#. ~ Description for haori
#: lang/json/ARMOR_from_json.py
msgid ""
"A loose coat with wide sleeves that is worn unfastened over a kimono.  It is"
" jet black with sparse, tasteful golden embroidery."
msgstr ""
"Egy kimonó fölött rögzítetlenül viselt, széles ujjú, laza kabát. Éjfekete "
"színű, ízléses arany hímzéssel."

#: lang/json/ARMOR_from_json.py
msgid "kittel"
msgid_plural "kittels"
msgstr[0] "kittel"
msgstr[1] "kittel"

#. ~ Description for kittel
#: lang/json/ARMOR_from_json.py
msgid ""
"A white, knee-length cotton robe, traditionally worn by Jews on special "
"occasions."
msgstr ""
"Fehér, térdig érő pamut köpeny, különleges alkalmakra hagyományos zsidó "
"viselet."

#: lang/json/ARMOR_from_json.py
msgid "peacoat"
msgid_plural "peacoats"
msgstr[0] "matrózkabát"
msgstr[1] "matrózkabát"

#. ~ Description for peacoat
#: lang/json/ARMOR_from_json.py
msgid "A heavy wool coat.  Cumbersome, but warm and with deep pockets."
msgstr "Nehéz gyapjúkabát. Ormótlan, de jó meleg és mélyek a zsebei."

#: lang/json/ARMOR_from_json.py
msgid "robe"
msgid_plural "robes"
msgstr[0] "köpeny"
msgstr[1] "köpeny"

#. ~ Description for robe
#: lang/json/ARMOR_from_json.py
msgid ""
"A loose-fitting outer garment with sleeves, and a mysterious amount of well-"
"hidden pockets."
msgstr ""
"Bő külső ruházat ujjakkal és titokzatos mennyiségű, jól elrejtett zsebekkel."

#: lang/json/ARMOR_from_json.py
msgid "samghati"
msgid_plural "samghatis"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for samghati
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, double layered Buddhist coat, used as an outer cloak for "
"various occasions."
msgstr ""
"Hagyományos, kétrétegű buddhista kabát, amelyet különböző alkalmakkor külső "
"köpenyként használnak."

#: lang/json/ARMOR_from_json.py
msgid "ski jacket"
msgid_plural "ski jackets"
msgstr[0] "sídzseki"
msgstr[1] "sídzseki"

#. ~ Description for ski jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"An insulated, breathable hoodie made for alpine skiing.  Very warm, and with"
" sizable pockets."
msgstr ""
