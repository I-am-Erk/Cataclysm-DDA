#: lang/json/AMMO_from_json.py
msgid ""
"A mesh of string and weights, traditionally used to catch fish, and to "
"entangle opponents in combat."
msgstr ""
"Zsinórokból és súlyokból álló háló, segítségével halat lehet fogni, és "
"közelharcban az ellenfél is belegabalyodhat."

#: lang/json/AMMO_from_json.py
msgid "throwing stick"
msgid_plural "throwing sticks"
msgstr[0] "dobóbot"
msgstr[1] "dobóbot"

