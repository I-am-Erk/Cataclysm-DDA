#: lang/json/TOOL_from_json.py
msgid "tent"
msgid_plural "tents"
msgstr[0] "sátor"
msgstr[1] "sátor"

#. ~ Description for tent
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small personal tent, it's just big enough to fit you comfortably."
msgstr ""
"Ez egy egyszemélyes sátor, éppen elég nagy ahhoz, hogy kényelmesen elférj "
