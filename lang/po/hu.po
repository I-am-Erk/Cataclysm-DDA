msgstr ""

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Corporate Infiltrator"
msgstr "Nagyvállalati kém"

#. ~ Profession (male Corporate Infiltrator) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Before all this, you were an 'independent contractor', a spy and mercenary "
"at the service of megacorporations.  Using highly experimental holographic "
"technology, you once took on impossible jobs one after the other."
msgstr ""
"Korábban egy úgynevezett független beszállító voltál - a megavállalatok "
"megbízásaiból élő zsoldos és kém. Egy rendkívül haladó, kísérleti "
"technológiájú holográfiai technológia segítségével korábban az egyik "
"lehetetlen megbízást teljesítetted a másik után."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Corporate Infiltrator"
msgstr "Nagyvállalati kém"

#. ~ Profession (female Corporate Infiltrator) description
#: lang/json/professions_from_json.py
