msgid "pistol ammo, ball (reloaded)"
msgid_plural "pistol ammo, ball (reloaded)"
msgstr[0] "pisztoly töltény, golyó (újratöltött)"
msgstr[1] "pisztoly töltény, golyó (újratöltött)"

