msgstr[1] "hevenyészett hajvágó készlet"

#. ~ Description for makeshift haircut kit
#: lang/json/TOOL_from_json.py
msgid "This is a kit with tools for cutting hair."
msgstr "Ezzel a készlettel hajat lehet vágni."

#: lang/json/TOOL_from_json.py
