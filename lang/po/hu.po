#: src/activity_handlers.cpp
msgid "You finish reading."
msgstr "Befejezed az olvasást."

#: src/activity_handlers.cpp
msgid "You finish waiting."
msgstr "Befejezed a várakozást."

#: src/activity_handlers.cpp
#, c-format
