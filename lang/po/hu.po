msgstr[0] "inaktív EMP hack"
msgstr[1] "inaktív EMP hack"

#. ~ Use action friendly_msg for inactive EMP hack.
#: lang/json/TOOL_from_json.py
msgid "The EMP hack flies from your hand and surveys the area!"
msgstr "Az EMP hack kirepül a kezedből és felméri a területet!"

#. ~ Use action hostile_msg for inactive EMP hack.
#: lang/json/TOOL_from_json.py
msgid "You misprogram the EMP hack; take cover!"
msgstr "Félreprogramozod az EMP hacket - fedezékbe!"

#. ~ Description for inactive EMP hack
#: lang/json/TOOL_from_json.py
msgid ""
"This is an inactive EMP hack.  EMP hacks are fist-sized robots that fly "
"through the air.  This one contains an EMP grenade and attacks by flying at "
"its target and detonating.  Use this item to reprogram and release the EMP "
"hack.  Electronics and computer skill determines if the targeting matrix is "
"reprogrammed successfully."
msgstr ""
"Ez egy inaktív EMP hack. Az EMP hack egy ökölnyi nagyságú, levegőben repülő "
"robot. Ebben egy EMP gránát található, és úgy támad, hogy az áldozat fölé "
"repülve felrobban. Használd ez a tárgyat az EMP hack átprogramozásához és "
"elengedéséhez. A célfogó mátrix átprogramozásának sikere az elektronikai és "
"az informatikai készségek szintjétől függ."

#: lang/json/TOOL_from_json.py
