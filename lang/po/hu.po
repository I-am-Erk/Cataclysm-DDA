msgstr ""

#: lang/json/TOOL_ARMOR_from_json.py
msgid "light EOD jacket"
msgid_plural "light EOD jackets"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for light EOD jacket
#: lang/json/TOOL_ARMOR_from_json.py
