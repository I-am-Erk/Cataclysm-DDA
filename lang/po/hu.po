#, c-format
msgid "Press [<color_yellow>%s</color>] to view and edit keybindings."
msgstr ""

#: src/construction.cpp src/iexamine.cpp
msgid "It is too dark to construct right now."
msgstr "Most túl sötét van az építéshez..."

#: src/construction.cpp
msgid "You can't build that!"
msgstr "Azt nem lehet megépíteni!"

#: src/construction.cpp
msgid "Construct where?"
msgstr "Hova építed?"

#: src/construction.cpp
msgid ""
"There is already an unfinished construction there, examine it to continue "
"working on it"
msgstr ""
"Ott már van egy befejezetlen építkezés. Az építkezés folytatásához vizsgáld "
"meg."

#: src/construction.cpp
#, c-format
msgid "%s assists you with the work…"
msgstr "%s segít a munkában..."

#: src/construction.cpp
#, c-format
msgid "%s watches you work…"
msgstr "%s nézi, ahogy dolgozol..."

#: src/construction.cpp
#, c-format
msgid "%s finished construction: %s."
msgstr "%s befejezte a(z) %s építését."

#: src/construction.cpp
msgid ""
"You feel relieved after providing last rites for this human being, whose "
"name is lost in the Cataclysm."
msgstr ""
"Megkönnyebbülve érzed magadat, miután feladtad az utolsó kenetet erre az "
"elhunyt embertársadra, akinek a neve elveszett a kataklizmában."

#: src/construction.cpp
msgid "You bury remains of a human, whose name is lost in the Cataclysm."
msgstr ""
"Eltemeted egy embertársad maradványait, akinek a neve elveszett a "
"kataklizmában."

#: src/construction.cpp
#, c-format
msgid ""
"You feel sadness, but also relief after providing last rites for %s, whose "
"name you will keep in your memory."
msgstr ""
"Szomorúsággal ötvözött megkönnyebbülés jár át, miután feladtad %s utolsó "
"kenetét, nevét örökre bevésted az emlékezetedbe."

#: src/construction.cpp
#, c-format
msgid ""
"You bury remains of %s, who joined uncounted masses perished in the "
"Cataclysm."
msgstr ""
"Eltemeted %smaradványait, aki így csatlakozott a kataklizmában életét "
"vesztett megszámolhatatlan embertömeghez."

#: src/construction.cpp
msgid "Inscribe something on the grave?"
msgstr "Írsz valamit a sírra?"

#: src/construction.cpp
msgid ""
"Unfortunately you don't have anything sharp to place an inscription on the "
"grave."
msgstr ""
"Sajnos nincsen nálad semmi hegyes tárgy, hogy a sírra bármit is karcolhass."

#: src/construction.cpp src/veh_interact.cpp
msgid "Enter new vehicle name:"
msgstr "Add meg az új jármű nevét:"

#: src/construction.cpp
#, c-format
msgid "That %s can not be disassembled!"
msgstr "A(z) %s-t nem lehet szétszerelni!"

#: src/construction.cpp
#, c-format
msgid "The %s is disassembled."
msgstr "A(z) %s szét lett szerelve."

#: src/construction.cpp
#, c-format
msgid "That %s can not be disassembled, since there is furniture above it."
msgstr "A(z) %st nem lehet szétszerelni, mivel bútor van rajta."

#: src/construction.cpp
msgid "The rock feels much warmer than normal.  Proceed?"
msgstr "A szikla a szokásosnál sokkal melegebb. Folytatod?"

#: src/construction.cpp
msgid "You just tunneled into lava!"
msgstr "Egyenesen a lávába vágtál járatot!"

#: src/construction.cpp
msgid "You dig into a preexisting space, and improvise a ladder."
msgstr "Egy létező üregbe ásod magadat, és rögtönzött létrát állítasz fel."

#: src/construction.cpp
msgid "You dig a stairway, adding sturdy timbers and a rope for safety."
msgstr ""
"Lépcsőt építesz, a biztonság kedvéért robosztus fagerendákkal támasztod meg "
"és kötéllel biztosítod."

#: src/construction.cpp
msgid "You drill out a passage, heading deeper underground."
msgstr "Utat vágsz magadnak még mélyebbre a föld alá."

#: src/construction.cpp
msgid "The rock overhead feels hot.  You decide *not* to mine magma."
msgstr ""
"A fejed feletti szikla tapintásra forró. Úgy döntesz, hogy ma nem szabadítod"
" magadra a lávát."

#: src/construction.cpp
msgid "The rock above is rather damp.  You decide *not* to mine water."
msgstr ""
"A fejed feletti szikla tapintásra nedves. Úgy döntesz, hogy ma nem fojtod "
"vízbe magad."

#: src/construction.cpp
msgid "You drill out a passage, heading for the surface."
msgstr "A felszín felé utat vágsza magadnak."

#: src/construction.cpp
msgid "After boarding up the window the curtains and curtain rod are left."
msgstr "Az ablak bedeszkázása után feleslegessé vált a karnis és a függöny."

#: src/construction.cpp
msgid "You gather some clay."
msgstr "Összeszedsz valamennyi agyagot."

#: src/construction.cpp
msgid "You gather some sand."
msgstr "Összeszedsz valamennyi homokot."

#: src/construction.cpp
msgid "You gather some materials."
msgstr "Összeszedsz valamennyi anyagot."

#: src/construction.cpp
msgid "You cannot build there!"
msgstr "Oda nem lehet építeni!"

#: src/construction.cpp
msgid "You cannot deconstruct this!"
msgstr "Ezt nem lehet szétszerelni!"

#: src/construction.cpp
msgid "Time to complete: "
msgstr "Befejezéshez szükséges idő: "

#: src/consumption.cpp
msgid "That doesn't look edible."
msgstr "Az nem tűnik ehetőnek."

#: src/consumption.cpp
msgid "That doesn't look edible to you."
msgstr "Az számodra nem tűnik ehetőnek."

#: src/consumption.cpp
msgid "That doesn't look edible in its current form."
msgstr "A jelenlegi formájában nem lehet megenni."

#: src/consumption.cpp
msgid "This is full of dirt after being on the ground."
msgstr "Tele van földdel, miután a talajon volt."

#: src/consumption.cpp src/iuse.cpp src/iuse.cpp src/iuse.cpp
#: src/iuse_actor.cpp src/iuse_actor.cpp
msgid "You can't do that while underwater."
msgstr "Azt víz alatt nem lehet."

#: src/consumption.cpp
msgid "We can't eat that.  It's not right for us."
msgstr "Azt nem ehetjük meg. Nem jó nekünk."

#: src/consumption.cpp
msgid "It's frozen solid.  You must defrost it before you can eat it."
msgstr "Keményre fagyott. Fogyasztás előtt fel kell olvasztani."

#: src/consumption.cpp
msgid "You can't drink it while it's frozen."
msgstr "Fagyasztott állapotában nem lehet meginni."

#: src/consumption.cpp src/game_inventory.cpp
#, c-format
msgid "You need a %s to consume that!"
msgstr "Elfogyasztásához egy %s kell!"

#: src/consumption.cpp
msgid "Ugh, you can't drink that!"
msgstr "Fujj, azt nem lehet meginni!"

#: src/consumption.cpp
msgid "Eww.  Inedible plant stuff!"
msgstr "Fujj, ehetetlen növény!"

#: src/consumption.cpp
msgid "The thought of eating that makes you feel sick."
msgstr "Már annak a gondolatától is felfordul a gyomrod, hogy megedd."

#: src/consumption.cpp
msgid "You can't eat this."
msgstr "Ezt nem tudod megenni."

#: src/consumption.cpp
msgid "That doesn't look useable as fuel."
msgstr ""

#: src/consumption.cpp
#, c-format
msgid "No space to store more %s"
msgstr "Nincs hely több %s eltárolásához"

#: src/consumption.cpp
msgid "This is rotten and smells awful!"
msgstr "Ez rohadt, és rettenetesen büdös!"

#: src/consumption.cpp
msgid "The thought of eating demihuman flesh makes you feel sick."
msgstr ""

#: src/consumption.cpp
msgid "The thought of eating human flesh makes you feel sick."
msgstr ""
"Már annak a gondolatától is felfordul a gyomrod, hogy emberhúst egyél."

#: src/consumption.cpp
msgid "Eating this raw meat probably isn't very healthy."
msgstr ""

#: src/consumption.cpp
msgid "You still feel nauseous and will probably puke it all up again."
msgstr "Émelyegsz, és valószínűleg megint ki fogod hányni."

#: src/consumption.cpp
msgid "Your stomach won't be happy (allergy)."
msgstr "A gyomrod ennek nem fog örülni (allergia)."

#. ~ No, we don't eat "rotten" food. We eat properly aged food, like a normal
#. person.
#. ~ Semantic difference, but greatly facilitates people being proud of their
#. character.
#: src/consumption.cpp
msgid "Your stomach won't be happy (not rotten enough)."
msgstr "A gyomrod ennek nem fog örülni (nem eléggé rohadt)."

#: src/consumption.cpp
msgid "You're full already and will be forcing yourself to eat."
msgstr "Már teljesen jóllaktál, és erőltetni kell a további evést."

#: src/consumption.cpp
msgid "You're full already and will be forcing yourself to drink."
msgstr "Már teljesen jóllaktál, és erőltetni kell a további ivást."

#: src/consumption.cpp
#, c-format
msgid "Eat your %s anyway?"
msgstr "Ennek ellenére megeszed a(z) %st?"

#: src/consumption.cpp
#, c-format
msgid "Drink your %s anyway?"
msgstr "Ennek ellenére megiszod a(z) %st?"

#: src/consumption.cpp
#, c-format
msgid "Consume your %s anyway?"
msgstr "Ennek ellenére elfogyasztod a(z) %st?"

#: src/consumption.cpp
msgid ""
"You've begun stockpiling calories and liquid for hibernation.  You get the "
"feeling that you should prepare for bed, just in case, but… you're hungry "
"again, and you could eat a whole week's worth of food RIGHT NOW."
msgstr ""
"Nekikezdtél a táplálék és a folyadék téli álomhoz való tárolásának. Az az "
"érzésed, hogy inkább aludni kellene... de már megint éhes vagy, és akár egy "
"heti kaját is megtudnál enni, méghozzá MOST, AZONNAL."

#: src/consumption.cpp
#, c-format
msgid "Ick, this %s doesn't taste so good…"
msgstr "Pfúj, ez a(z) %s nem túl jó ízű..."

#: src/consumption.cpp
#, c-format
msgid "Mmm, this %s tastes delicious…"
msgstr "Mmmm, ez a(z) %s nagyon finom..."

#: src/consumption.cpp
#, c-format
msgid "<npcname> assimilates a %s."
msgstr "<npcname> asszimilálja a %st."

#: src/consumption.cpp
#, c-format
msgid "You assimilate your %s."
msgstr "Asszimilálod a %st."

#: src/consumption.cpp
#, c-format
msgid "Ick, this %s (rotten) doesn't taste so good…"
msgstr "Pfúj, ez a(z) %s (rohadt) nem túl jó ízű..."

#: src/consumption.cpp
#, c-format
msgid "You drink your %s (rotten)."
msgstr "Iszol egy rohadt %st."

#: src/consumption.cpp
#, c-format
msgid "<npcname> drinks a %s."
msgstr "<npcname> iszik egy %st."

#: src/consumption.cpp
#, c-format
msgid "You drink your %s."
msgstr "Iszol egy %st."

#: src/consumption.cpp
#, c-format
msgid "You eat your %s (rotten)."
msgstr "Eszel egy rohadt %st."

#: src/consumption.cpp
#, c-format
msgid "<npcname> eats a %s."
msgstr "<npcname> eszik egy %st."

#: src/consumption.cpp
#, c-format
msgid "You eat your %s."
msgstr "Eszel egy %st."

#: src/consumption.cpp
msgid ""
"You try to ignore its mushy texture, but it leaves you with an awful "
"aftertaste."
msgstr ""
"Próbálsz nem figyelni az étel pépes állagára, de borzalmas az utóíze is."

#: src/consumption.cpp
msgid "You can't taste much of anything with this cold."
msgstr "A megfázás miatt nem sok mindennek érzed az ízét."

#: src/consumption.cpp
msgid "You can't taste much of anything with this flu."
msgstr "Az influenza miatt nem sok mindennek érzed az ízét."

#: src/consumption.cpp
msgid "The shadows are getting ever closer."
msgstr "Az árnyékok egyre közelebb kerülnek."

#: src/consumption.cpp
msgid "You have a bad feeling about this."
msgstr "Nagyon rossz előérzeted van."

#: src/consumption.cpp
msgid "A powerful sense of dread comes over you."
msgstr "Erős rettegés fog el."

#: src/consumption.cpp
msgid "Your skin starts crawling."
msgstr "A bőröd alatt valami el kezd mászkálni."

#: src/consumption.cpp
msgid "They're coming to get you."
msgstr "Azért jönnek, hogy kicsináljanak."

#: src/consumption.cpp
msgid "This might've been a bad idea…"
msgstr "Ez egy rossz ötlet volt..."

#: src/consumption.cpp
msgid "You've really done it this time, haven't you?"
msgstr "Na most aztán tényleg bajba kerültél, mi?"

#: src/consumption.cpp
msgid "You have to stay vigilant.  They're always watching…"
msgstr "Ébernek kell maradnod. Azok mindig figyelnek..."

#: src/consumption.cpp
msgid "mistake mistake mistake mistake mistake"
msgstr "baj van baj van baj van baj van baj van"

#: src/consumption.cpp
msgid "Just gotta stay calm, and you'll make it through this."
msgstr "Csak nyugi, és ezt is túl fogod élni."

#: src/consumption.cpp
msgid "You're starting to feel very jumpy."
msgstr "Egyre ijedősebbé válsz."

#: src/consumption.cpp
msgid "Something is twitching at the edge of your vision."
msgstr "A látótered szélén valami vonaglik."

#: src/consumption.cpp
msgid "They know what you've done…"
msgstr "Tudják, hogy mit tettél..."

#: src/consumption.cpp
msgid "You're feeling even more paranoid than usual."
msgstr "Még a szokásosnál is paranoiásabbnak érzed magad."

#: src/consumption.cpp
msgid "You feast upon the human flesh, and in doing so, devour their spirit."
msgstr "Lakomázol az emberi húsból, és eközben befalod a lelkét is."

#: src/consumption.cpp
msgid "You feast upon the human flesh."
msgstr "Lakomázol az emberi húsból."

#: src/consumption.cpp
msgid "You consume the sacred human flesh."
msgstr "Elfogyasztod a szent emberi húst."

#: src/consumption.cpp
msgid "You indulge your shameful hunger."
msgstr "Engedsz a szégyenletes éhséged vonzásának."

#: src/consumption.cpp
msgid "You greedily devour the taboo meat."
msgstr "Mohón felfalod a tabu húst."

#: src/consumption.cpp
msgid "Meh.  You've eaten worse."
msgstr "Eh... ennél ettél már rosszabbat is."

#: src/consumption.cpp
msgid ""
"This is probably going to count against you if there's still an afterlife."
msgstr "Ha létezik túlvilág, akkor ez valószínűleg ott rossz pontnak számít."

#: src/consumption.cpp
msgid "You feel horrible for eating a person."
msgstr "Rettenetesen érzed magadat, mert megettél egy embert."

#: src/consumption.cpp
msgid "As you tear into the raw flesh, you feel satisfied with your meal."
msgstr ""

#: src/consumption.cpp
msgid "Raw flesh doesn't taste all that bad, actually."
msgstr ""

#: src/consumption.cpp
msgid "This doesn't taste very good, but meat is meat."
msgstr ""

#: src/consumption.cpp
msgid "Yuck!  How can anybody eat this stuff?"
msgstr "Fujj! Hogy tudja ezt bárki is megenni?"

#: src/consumption.cpp
msgid "Mmm, junk food."
msgstr "Mmm, junk food."

#: src/consumption.cpp
msgid "When life's got you down, there's always sugar."
msgstr "Amikor semmi sem sikerül, akkor még mindig lehet cukrosat enni."

#: src/consumption.cpp
msgid "They may do what they must… you've already won."
msgstr "Tegyék csak, amit tenniük kell... te már úgyis nyertél."

#: src/consumption.cpp
msgid "Your stomach begins gurgling and you feel bloated and ill."
msgstr "A gyomrod gurgulázik, püffedtnek érzed magad és betegnek."

#: src/consumption.cpp
msgid "You find the sweet taste of honey surprisingly palatable."
msgstr "A méz édes ízét meglepően kellemesnek találod."

#: src/consumption.cpp
msgid "You feast upon the sweet honey."
msgstr "Lakomázol az édes mézből."

#: src/consumption.cpp
msgid "You gorge yourself, preparing to hibernate."
msgstr "Korlátlanul zabálsz, hogy így készülj fel a téli álomra."

#: src/consumption.cpp
msgid ""
"You feel stocked for a day or two.  Got your bed all ready and secured?"
msgstr "Egy-két napra elég ételed van. Megágyaztál?"

#: src/consumption.cpp
msgid ""
"Mmm.  You can still fit some more in… but maybe you should get comfortable "
"and sleep."
msgstr ""
"Hmmm... Még lenne hová tenni a kaját, de talán itt az ideje kényelembe "
"helyezni magadat és aludni."

#: src/consumption.cpp
msgid "That filled a hole!  Time for bed…"
msgstr "Na ez aztán jól esett! Itt az ideje aludni..."

#: src/consumption.cpp
msgid "You feel as though you're going to split open!  In a good way?"
msgstr "Úgy érzed, hogy hamarosan szétrepedsz! De ez olyan jó érzés, nem?"

#. ~ slimespawns have *small voices* which may be the Nice equivalent
#. ~ of the Rat King's ALL CAPS invective.  Probably shared-brain telepathy.
#: src/consumption.cpp
msgid "hey, you look like me!  let's work together!"
msgstr "hé, te úgy nézel ki, mint én! dolgozzunk együtt!"

#: src/consumption.cpp
#, c-format
msgid "Are you sure you want to eat your favorited %s?"
msgstr "Biztosan meg akarod enni a kedvencként megjelölt %st?"

#. ~ %1$i: charge number, %2$s: item name, %3$s: bionics name
#: src/consumption.cpp
#, c-format
msgid "You load %1$i charge of %2$s in your %3$s."
msgid_plural "You load %1$i charges of %2$s in your %3$s."
msgstr[0] "%1$i darab %2$s töltetet helyezel a(z) %3$s-edbe."
msgstr[1] "%1$i darab %2$s töltetet helyezel a(z) %3$s-edbe."

#. ~ %1$i: charge number, %2$s: item name, %3$s: bionics name
#: src/consumption.cpp
#, c-format
msgid "<npcname> load %1$i charge of %2$s in their %3$s."
msgid_plural "<npcname> load %1$i charges of %2$s in their %3$s."
msgstr[0] "<npcname> %1$i darab %2$s töltetet helyez ebbe: %3$s."
msgstr[1] "<npcname> %1$i darab %2$s töltetet helyez ebbe: %3$s."

#: src/consumption.cpp src/iuse_actor.cpp src/player.cpp
msgid "You do not have that item."
msgstr ""

#: src/consumption.cpp
#, c-format
msgid "You can't eat your %s."
msgstr "Nem tudod megenni ezt: %s."

#: src/craft_command.cpp src/crafting.cpp
msgid " (nearby)"
msgstr " (közel)"

#: src/craft_command.cpp
msgid " (person & nearby)"
msgstr " (nálad és közel)"

#: src/craft_command.cpp
#, c-format
msgid ""
"You don't have enough charges to complete the %s.\n"
"Start crafting anyway?"
msgstr ""
"Nincsen nálad elég töltet ahhoz, hogy befejezd a(z) %s összeszerelését.\n"
"Ennek ellenére belekezdesz?"

#: src/craft_command.cpp
msgid "You don't have the required proficiencies to craft this!"
msgstr ""

#: src/craft_command.cpp
msgid ""
"This craft will use rotten components.\n"
"Start crafting anyway?"
msgstr ""
"Ez rohadt alkatrészeket fog használni.\n"
"Biztosan elkezded?"

#: src/craft_command.cpp
msgid "Some components used previously are missing.  Continue?"
msgstr "A korábban használt hozzávalókból valami hiányzik. Folytatod?"

#: src/craft_command.cpp
msgid "Item(s): "
msgstr "Tárgy(ak): "

#: src/craft_command.cpp
msgid "Tool(s): "
msgstr "Szerszám(ok): "

#: src/crafting.cpp
msgid "Your morale is too low to craft such a difficult thing…"
msgstr "Túl rossz a kedved ahhoz, hogy egy ilyen nehéz dolognak nekikezdj..."

#: src/crafting.cpp
msgid "You can't see to craft!"
msgstr "Túl sötét van ahhoz, hogy azt elkészíthesd!"

#: src/crafting.cpp
msgid "Overmap terrain building recipes are not implemented yet!"
msgstr ""
"A nagytérképre építhető tereptárgyak receptjei még nincsenek a játékban!"

#: src/crafting.cpp
msgid "You can no longer see well enough to keep crafting."
msgstr "Már nem látsz eleget ahhoz, hogy folytasd az elkészítést."

#: src/crafting.cpp
#, c-format
msgid ""
"The %s is too large and/or heavy to work on.  You may want to use a "
"workbench or a smaller batch size"
msgstr ""
"A(z) %s túl nagy vagy túl nehéz ahhoz, hogy kézben rakhasd össze. Érdemes "
"lenne talán egy asztalnál elkészíteni, vagy kevesebb darabbal próbálkozni."

#: src/crafting.cpp
msgid "Your morale is too low to continue crafting."
msgstr "Túl alacsony a hangulatod ahhoz, hogy folytasd az összeszerelést."

#: src/crafting.cpp
msgid "You are too frustrated to continue and just give up."
msgstr "A folytatáshoz túl frusztrált vagy, és abbahagyod."

#: src/crafting.cpp
msgid "You can't see well and are working slowly."
msgstr "Nem látsz jól, ezért lassan haladsz."

#: src/crafting.cpp
#, c-format
msgid ""
"The %s is too large and/or heavy to work on comfortably.  You are working "
"slowly."
msgstr ""

#: src/crafting.cpp
msgid "You can't focus and are working slowly."
msgstr "Nem tudsz a munkára fókuszálni, és lassan haladsz."

#: src/crafting.cpp
msgid "Craft something first"
msgstr "Előtte valamit kell készítened."

#: src/crafting.cpp
msgid "You can no longer make that craft!"
msgstr "Azt többé már nem tudod elkészíteni!"

#: src/crafting.cpp
#, c-format
msgid ""
"You don't have anything in which to store %s and may have to pour it out as "
"soon as it is prepared!  Proceed?"
msgstr ""

#: src/crafting.cpp src/pickup.cpp
#, c-format
msgid "Wielding %c - %s"
msgstr "Kézben: %c - %s"

#: src/crafting.cpp src/pickup.cpp
#, c-format
msgid "Wielding - %s"
msgstr "Kézben: %s"

#: src/crafting.cpp
#, c-format
msgctxt "item, furniture"
msgid "You put the %1$s on the %2$s."
msgstr "A(z) %1$st felteszed erre: %2$s."

#: src/crafting.cpp
#, c-format
msgctxt "item, furniture"
msgid "<npcname> puts the %1$s on the %2$s."
msgstr "<npcname> felteszi a(z) %1$st erre: %2$s."

#: src/crafting.cpp
#, c-format
msgctxt "furniture, item"
msgid "Not enough space on the %s. You drop the %s on the ground."
msgstr "A(z) %s felületén nincsen elég hely, ezért a(z) %st a földre ejted."

#: src/crafting.cpp
#, c-format
msgctxt "furniture, item"
msgid "Not enough space on the %s. <npcname> drops the %s on the ground."
msgstr ""
"A(z) %s felületén nincsen elég hely, ezért <npcname> a(z) %st a földre ejti."

#: src/crafting.cpp
#, c-format
msgctxt "item"
msgid "You put the %s on the ground."
msgstr "A(z) %st a talajra helyezed."

#: src/crafting.cpp
#, c-format
msgctxt "item"
msgid "<npcname> puts the %s on the ground."
msgstr "<npcname> a talajra helyezi a(z) %st."

#: src/crafting.cpp
#, c-format
msgctxt "in progress craft"
msgid "What to do with the %s?"
msgstr "Mit szeretnél ezzel tenni: %s?"

#: src/crafting.cpp
#, c-format
msgid "Dispose of your wielded %s and start working."
msgstr "Elteszed a kézben tartott %st és belekezdesz a munkába."

#: src/crafting.cpp
msgid "Put it down and start working."
msgstr "Leteszed a földre, és belekezdesz a munkába."

#: src/crafting.cpp
msgid "Store it in your inventory."
