#: lang/json/ARMOR_from_json.py
msgid "go bag"
msgid_plural "go bags"
msgstr[0] "készenléti zsák"
msgstr[1] "készenléti zsák"

#. ~ Description for go bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge duffel bag with backpack attached, both packed to the gills.  Judging"
" by the feel, a National Guard soldier could have packed this to be ready "
"for deployment.  Activate to unpack and enjoy."
msgstr ""
"Hatalmas sportzsák hozzácsatolt hátizsákkal, tele minden földi jóval. Az "
"összetevők alapján ezt egy nemzetőr katonai csomagolta be, hogy bevetésre "
"készen álljon. Használathoz aktiváld, és élvezd a tartalmát."

#: lang/json/ARMOR_from_json.py
msgid "personal go bag"
msgid_plural "personal go bags"
msgstr[0] "személyes készenléti zsák"
msgstr[1] "személyes készenléti zsák"

#. ~ Description for personal go bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge duffel bag with backpack attached, both packed to the gills.  You "
"have packed this to be ready for deployment.  Activate to unpack and enjoy."
msgstr ""
"Hatalmas sportzsák hozzácsatolt hátizsákkal, tele minden földi jóval. Te "
"csomagoltad be, hogy bevetésre készen álljon. Használathoz aktiváld, és "
"élvezd a tartalmát."

