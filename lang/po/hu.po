msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head hits <npcname>'s %2$s, but glances off their armor!"
msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts its arms at you, and its claws pierce your %2$s!"
msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid ""
"The %1$s thrusts its arms at <npcname>, and its claws pierce their %2$s!"
msgstr ""

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's arms hit your %2$s, but they glance off your armor!"
msgstr ""

