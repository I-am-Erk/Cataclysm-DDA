msgstr "A fehér harcsa (Ameiurus catus) egy széles fejű, apró bajszú hal."

#: lang/json/MONSTER_from_json.py
msgctxt "fish"
msgid "pike"
msgid_plural "pikes"
msgstr[0] "csuka"
msgstr[1] "csuka"

#. ~ Description for pike
#: lang/json/MONSTER_from_json.py
msgid ""
"A northern pike.  Pike can be a pretty aggressive fish, careful around those"
" teeth."
msgstr ""
"A csukák nagyon agresszív halak is tudnak lenni, szóval csak óvatosan "
"azokkal a fogakkal."

#: lang/json/MONSTER_from_json.py
msgid "pickerel"
msgid_plural "pickerels"
msgstr[0] "kis csuka"
msgstr[1] "kis csuka"

#. ~ Description for pickerel
#: lang/json/MONSTER_from_json.py
msgid "A pickerel.  It looks like a pike, but much smaller."
msgstr "A kis csuka olyan, mint a csuka, csak hát ugye kisebb."

#: lang/json/MONSTER_from_json.py
msgid "muskellunge"
msgid_plural "muskellunges"
msgstr[0] "muskellunge"
msgstr[1] "muskellunge"

#. ~ Description for muskellunge
#: lang/json/MONSTER_from_json.py
msgid ""
"A muskellunge.  Closely related to pike, it shares the same aggression and "
"sharp teeth."
msgstr ""
"A muskellunge (Esox masquinongy) egy Észak-Amerikában őshonos csukaféle. "
"Legalább annyira agresszív, és legalább annyira élesek a fogai."

#: lang/json/MONSTER_from_json.py
msgid "white sucker"
msgid_plural "white suckers"
msgstr[0] "fehér bivalyhal"
msgstr[1] "fehér bivalyhal"

