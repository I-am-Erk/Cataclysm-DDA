#: lang/json/COMESTIBLE_from_json.py lang/json/ammunition_type_from_json.py
msgid "raw milk"
msgid_plural "raw milk"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'raw milk'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"This is raw, unhomogenized and unpasteurized milk from a cow.  It couldn't "
"be any fresher unless you drank it straight from the cow, which might upset "
"it.  Depending on your dietary sensibilities, you might want to pasteurize "
"or even boil this before drinking."
msgstr ""
"Ez egy tehén nyers, nem homogenizált, és nem pasztörizált teje. Nem lehet "
"frissebb, hacsak nem egyenesen a tehénből meg nem iszod, ami viszont "
"felháboríthatja. Táplálkozási érzékenységedtől függően ivás előtt érdemes "
"pasztőrözni, vagy akár felforralni."

#: lang/json/COMESTIBLE_from_json.py
msgid "shelf stable milk"
msgid_plural "shelf stable milk"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'shelf stable milk'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"This is milk that has been pasteurized at much higher temperatures than "
"normal.  It tastes slightly different, but, unopened, will last far longer "
"than regular milk."
msgstr ""
"Ezt a tejet a szokásosnál magasabb hőmérsékleten pasztörizáltak. Egy kicsit "
"más az íze, de felnyitás nélkül sokkal tovább marad meg, mint a hagyományos "
"tej."

