msgstr ""
"A fehér sucker (Catostomus commersonii) egy Észak-Amerikában őshonos "
"pontyalakú, áramvonalas testű és kerek szájú hal."

#: lang/json/MONSTER_from_json.py
msgid "carp"
msgid_plural "carps"
msgstr[0] "ponty"
msgstr[1] "ponty"

