msgstr[1] "Beindul a(z) %s összes motorja."

#: src/activity_handlers.cpp
#, c-format
msgid "One of the %s's engines start up."
msgid_plural "Some of the %s's engines start up."
msgstr[0] "Beindul a(z) %s egyik motorja."
msgstr[1] "Beindul a(z) %s néhány motorja."

#: src/activity_handlers.cpp
#, c-format
