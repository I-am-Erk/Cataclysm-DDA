msgstr ""

#. ~ Use action hostile_msg for inactive miner bot.
#: lang/json/TOOL_from_json.py
msgid "The miner bot spins out of control and lunges at you.  Make way!"
msgstr ""

#. ~ Description for inactive miner bot
#: lang/json/TOOL_from_json.py
