#: lang/json/ARMOR_from_json.py
msgid "plug"
msgid_plural "plugs"
msgstr[0] "fül plug"
msgstr[1] "fül plug"

#. ~ Description for plug
#: lang/json/ARMOR_from_json.py
msgid ""
"Those round things people plug into their earlobes as earrings, also called "
"\"ear plug\" or \"ear spool.\"  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Azok a kerek izék, amit az emberek fülbevalóként dugnak a fülcimpájukba. "
"Berakhatod, de semmi hatással sem jár."

#: lang/json/ARMOR_from_json.py
msgid "gold bracelet"
msgid_plural "gold bracelets"
msgstr[0] "arany karperec"
msgstr[1] "arany karperec"

#. ~ Description for gold bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A fancy golden bracelet.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Divatos arany karperec. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold dental grill"
msgid_plural "gold dental grills"
msgstr[0] "arany fogékszer"
msgstr[1] "arany fogékszer"

#. ~ Description for gold dental grill
#: lang/json/ARMOR_from_json.py
msgid ""
"Fake golden teeth, worn over the teeth.  Fits horribly, but looks very "
"shiny."
msgstr ""
"Hamis aranyfog, amit az igazi fogra lehet húzni. Rémesen passzol, de nagyon "
"csillog."

#: lang/json/ARMOR_from_json.py
msgid "pair of gold earrings"
msgid_plural "pairs of gold earrings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for pair of gold earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of shiny gold earrings.  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Csillogó arany fülbevaló. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold hairpin"
msgid_plural "gold hairpins"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for gold hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold hairpin, designed by the rich, for the rich.  You can wear it if you "
"like, but it won't provide any effects."
msgstr ""
"Aranyból készült hajtű, a gazdagoknak a gazdagoktól. Felveheted, ha "
"szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold locket"
msgid_plural "gold lockets"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for gold locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A heart-shaped, gold locket with a frame inside to store photographs or "
"small objects.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Szív formájú arany nyakék, közepén egy kép tárolására alkalmas kerettel. "
"Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold medal"
msgid_plural "gold medals"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for gold medal
#: lang/json/ARMOR_from_json.py
msgid ""
"A medal awarded for achieving first place in some event.  Before everything "
"fell apart, this could be a source of pride for its owner.  Now it's just "
"another shiny bauble."
msgstr ""
"Egy valamiben elért első helyezésért járó érem. Büszkeséget jelenthetett a "
"tulajdonos számára mielőtt minden szétesett. Most már ez csak egy fényes "
"csecsebecse."

#: lang/json/ARMOR_from_json.py
msgid "gold necklace"
msgid_plural "gold necklaces"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for gold necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A shiny, unadorned gold necklace.  You can wear it if you like, but it won't"
" provide any effects."
msgstr ""
"Csillogó, további díszítés nélküli arany nyaklánc. Felveheted, ha szeretnéd,"
" de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold ring"
msgid_plural "gold rings"
msgstr[0] "aranygyűrű"
msgstr[1] "aranygyűrű"

#. ~ Description for gold ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A flashy gold ring.  You can wear it if you like, but it won't provide any "
"effects."
msgstr "Divatos aranygyűrű. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "gold watch"
msgid_plural "gold watches"
msgstr[0] "aranyóra"
msgstr[1] "aranyóra"

#. ~ Description for gold watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold-plated steel self-winding wristwatch, suitable for a retirement "
"present.  Tells the time and looks good."
msgstr ""
"Aranyozott acél, önfelhúzó karóra, a nyugdíjazási ünnepségek obligát "
"kelléke. Az időt mutatja és nagyon csini."

#: lang/json/ARMOR_from_json.py
msgid "tie clip"
msgid_plural "tie clips"
msgstr[0] "nyakkendőtű"
msgstr[1] "nyakkendőtű"

#. ~ Description for tie clip
#: lang/json/ARMOR_from_json.py
msgid ""
"A fancy silver tie clip, a great match for your skinny tie.  You can wear it"
" if you like, but it won't provide any effects."
msgstr ""
"Divatos ezüst nyakkendőtű, jól megy a keskeny nyakkendődhöz. Felveheted, ha "
"szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "silver watch"
msgid_plural "silver watches"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for silver watch
#: lang/json/ARMOR_from_json.py
msgid ""
"An elegant silver watch, crafted from silver-plated stainless steel.  It's "
"much cheaper than other metal watches, and more classy than an ordinary "
"wristwatch."
msgstr ""
"Ezüstözött rozsdamentes acélból készült elegáns ezüst karóra. Sokkal "
"olcsóbb, mint a többi fém óra, és divatosabb, mint egy átlagos karóra."

#: lang/json/ARMOR_from_json.py
msgid "silver bracelet"
msgid_plural "silver bracelets"
msgstr[0] "ezüst karperec"
msgstr[1] "ezüst karperec"

#. ~ Description for silver bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A nice silver bracelet.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Kellemes ezüst karperec. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "pair of silver earrings"
msgid_plural "pairs of silver earrings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for pair of silver earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of beautiful silver earrings.  You can wear it if you like, but it "
"won't provide any effects."
msgstr ""
"Gyönyörű ezüst fülbevaló. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "fancy watch"
msgid_plural "fancy watches"
msgstr[0] "divatos óra"
msgstr[1] "divatos óra"

#. ~ Description for fancy watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A rather large and expensively made wristwatch.  Tells the time in elegantly"
" wrought gold with silver detailing.  It's really the only timepiece "
"suitable for someone of your exquisitely discerning tastes."
msgstr ""
"A meglehetősen nagy és drága karóra. Elegánsan, ezüst betétes kovácsolt "
"arany környezetben mutatja az időt. Az ízlésre valamit is adó ember számára "
"más időmérő eszköz egyszerűen szóba se jöhet."

#: lang/json/ARMOR_from_json.py
msgid "small relic"
msgid_plural "small relics"
msgstr[0] "apró relikvia"
msgstr[1] "apró relikvia"

#. ~ Description for small relic
#: lang/json/ARMOR_from_json.py
msgid ""
"A small relic from a forgotten saint.  As extraordinary as the world has "
"become it may have some power yet."
msgstr ""
"Egy rég feledésbe merült szent apró relikviája. Ha már a világ ennyit "
"megváltozott, még valami haszna is lehet."

#: lang/json/ARMOR_from_json.py
msgid "holy symbol"
msgid_plural "holy symbols"
msgstr[0] "vallásos jelvény"
msgstr[1] "vallásos jelvény"

#. ~ Description for holy symbol
#: lang/json/ARMOR_from_json.py
msgid ""
"A necklace made of fine gold chain bearing the symbol of a forgotten faith."
msgstr "Egy elfeledett hit jelképét hordozó arany nyaklánc."

#: lang/json/ARMOR_from_json.py
msgid "handmade holy symbol"
msgid_plural "handmade holy symbols"
msgstr[0] "kézzel készített vallásos jelvény"
msgstr[1] "kézzel készített vallásos jelvény"

#. ~ Description for handmade holy symbol
#: lang/json/ARMOR_from_json.py
msgid "A simple necklace representing a religious faith."
msgstr "Egy vallásos hitet jelképező egyszerű nyaklánc."

#: lang/json/ARMOR_from_json.py
msgid "jade brooch"
msgid_plural "jade brooches"
msgstr[0] "jáde bross"
msgstr[1] "jáde bross"

#. ~ Description for jade brooch
#: lang/json/ARMOR_from_json.py
msgid ""
"A hand-crafted jade brooch of Oriental origin.  You can wear it if you like,"
" but it won't provide any effects."
msgstr ""
"Távol-keleti származású, kézzel faragott zöld jádeköves bross. Felveheted, "
"ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "pearl collar"
msgid_plural "pearl collars"
msgstr[0] "gyöngy nyaklánc"
msgstr[1] "gyöngy nyaklánc"

#. ~ Description for pearl collar
#: lang/json/ARMOR_from_json.py
msgid ""
"A collar made from round and lustrous pearls, its former owner must be a "
"wealthy individual."
msgstr ""
"Gömbölyű és fényes igazgyöngyökből készült nyaklánc. Az előző tulajdonosa "
"biztosan nagyon gazdag volt."

#: lang/json/ARMOR_from_json.py
msgid "platinum watch"
msgid_plural "platinum watches"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum watch
#: lang/json/ARMOR_from_json.py
msgid ""
"Flex on those gold-watch wearers with the rare, expensive and superior "
"platinum watch.  This one is made from solid platinum."
msgstr ""
"Ezzel a ritka, drága és felsőbbrendű platina karórával izmozhatsz azokon, "
"akiken csak aranyóra van. Ez tömör platinából készült."

#: lang/json/ARMOR_from_json.py
msgid "platinum bracelet"
msgid_plural "platinum bracelets"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A flawless platinum bracelet.  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Hibátlan platina karperec. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "platinum dental grill"
msgid_plural "platinum dental grills"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum dental grill
#: lang/json/ARMOR_from_json.py
msgid ""
"Fake platinum-and-silver teeth.  They may be cheaper than fake gold teeth, "
"but they're much more rare.  Fits horribly, but looks very shiny."
msgstr ""
"Hamis platina-ezüst fogékszer. Lehet, hogy olcsóbb, mint a hamis aranyfog, "
"de sokkal ritkább is. Borzalmasan rosszul illik, de legalább nagyon "
"fényesnek tűnik."

#: lang/json/ARMOR_from_json.py
msgid "pair of platinum earrings"
msgid_plural "pairs of platinum earrings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for pair of platinum earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of plain platinum earrings - if gold is getting boring, just use "
"another rare metal.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Platina fülbevaló. Ha már unod az aranyat, akkor viselj egy másik ritka "
"fémet. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "platinum hairpin"
msgid_plural "platinum hairpins"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"The ultimate in esoteric, metal hair accessories, this hairpin is made from "
"pure platinum.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"A legritkább fém hajkellék, ez tiszta platinából készült. Felveheted, ha "
"szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "platinum locket"
msgid_plural "platinum lockets"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A small, platinum locket for storing photographs or other small objects.  "
"You can wear it if you like, but it won't provide any effects."
msgstr ""
"Kisméretű platina nyakék, kép vagy más egyéb tárolására alkalmas kerettel. "
"Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "platinum necklace"
msgid_plural "platinum necklaces"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A platinum necklace, with a small, empty heart frame hanging from a chain.  "
"You can wear it if you like, but it won't provide any effects."
msgstr ""
"Platinából készült lánc, közepén üres, szív alakú kerettel. Felveheted, ha "
"szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "platinum ring"
msgid_plural "platinum rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for platinum ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A platinum ring, engraved with all manner of swirls and spirals.  You can "
"wear it if you like, but it won't provide any effects."
msgstr ""
"Platinából készült gyűrű, amelybe mindenféle örvényeket és spirálokat "
"gravíroztak. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "engagement ring"
msgid_plural "engagement rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for engagement ring
#: lang/json/ARMOR_from_json.py
msgid ""
"This ring is an intricate gold band, with a small cluster of diamonds set in"
" the center.  Before the world broke down, this ring would've cost a small "
"fortune."
msgstr ""
"Ez a gyűrű egy bonyolult aranyszalag, közepén egy kis gyémántcsoport "
"található. Mielőtt a világ szétesett ez a gyűrű egy kisebb vagyont ért."

#: lang/json/ARMOR_from_json.py
msgid "purity ring"
msgid_plural "purity rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for purity ring
#: lang/json/ARMOR_from_json.py
msgid ""
"Also known as a promise ring, this ring is worn as a sign of chastity.  This"
" one bears the inscription, \"Love is patient.\""
msgstr ""
"Más néven ígéret gyűrű, amelyet a szűziesség jeleként viselnek. Ezen egy "
"felirat olvasható: \"A szerelem türelmes.\""

#: lang/json/ARMOR_from_json.py
msgid "signet ring"
msgid_plural "signet rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for signet ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold and silver ring with a wide stamp attached to the band.  A long time "
"ago, the stamp was legible, but now the pattern is too worn to discern its "
"former use."
msgstr ""
"Széles bélyegzővel ellátott arany és ezüst gyűrű. Réges-régen a bélyegző még"
" olvasható volt, de mostanára a minta túl kopott ahhoz, hogy korábbi "
"használatára lehessen következtetni."

#: lang/json/ARMOR_from_json.py
msgid "wedding ring"
msgid_plural "wedding rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for wedding ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A flawless ring, ensnaring a diamond with twists of pure gold.  It's a "
"constant reminder that the wearer is married."
msgstr ""
"Egy hibátlan gyűrű, amelyen tiszta arany teker körbe egy gyémántot. Ez "
"állandó emlékeztető arra, hogy viselője házas."

#: lang/json/ARMOR_from_json.py
msgid "silver necklace"
msgid_plural "silver necklaces"
msgstr[0] "ezüst nyaklánc"
msgstr[1] "ezüst nyaklánc"

#. ~ Description for silver necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A nice silver necklace.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Kellemes ezüst nyaklánc. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "silver hairpin"
msgid_plural "silver hairpins"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for silver hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"A shiny, silver hairpin with a tiny bee engraved onto it.  You can wear it "
"if you like, but it won't provide any effects."
msgstr ""
"Rézből készült gyűrű, amelybe egy apró méhecskét gravíroztak. Felveheted, ha"
" szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "silver locket"
msgid_plural "silver lockets"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for silver locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A small, silver locket with a frame inside to store photographs or small "
"objects.  You can wear it if you like, but it won't provide any effects."
msgstr ""
"Kisméretű ezüst nyakék, közepén egy kép tárolására alkalmas kerettel. "
"Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "silver medal"
msgid_plural "silver medals"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for silver medal
#: lang/json/ARMOR_from_json.py
msgid ""
"A medal awarded for achieving second place in some event.  Before everything"
" fell apart, this could be a source of pride for its owner.  Now it's just "
"another shiny bauble."
msgstr ""
"Egy valamiben elért második helyezésért járó érem. Büszkeséget jelenthetett "
"a tulajdonos számára mielőtt minden szétesett. Most már ez csak egy fényes "
"csecsebecse."

#: lang/json/ARMOR_from_json.py
msgid "silver ring"
msgid_plural "silver rings"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for silver ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple, silver ring.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Egy egyszerű ezüst gyűrű. Felveheted, ha szeretnéd, de semmi haszna sincs."

#: lang/json/ARMOR_from_json.py
msgid "leather collar"
msgid_plural "leather collars"
msgstr[0] "bőr nyakörv"
msgstr[1] "bőr nyakörv"

#. ~ Description for leather collar
#: lang/json/ARMOR_from_json.py
msgid ""
"A black leather 'collar' with a bell dangling from the front.  Don't worry, "
"the bell is silent."
msgstr ""
"Fekete bőrből készült dekorációs nyakörv. Még egy kis csengettyű is lóg az "
"elején, de ne aggódj, nincs hangja."

#: lang/json/ARMOR_from_json.py
msgid "wrist watch"
msgid_plural "wrist watches"
msgstr[0] "karóra"
msgstr[1] "karóra"

#. ~ Description for wrist watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple wristwatch on a plastic band.  Tells the time and has an alarm "
"clock feature."
msgstr ""
"Egyszerű műanyag pántos karóra. Az időt mutatja és van rajta ébresztő is."

#: lang/json/ARMOR_from_json.py
msgid "radiation badge"
msgid_plural "radiation badges"
msgstr[0] "sugárzásmérő badge"
msgstr[1] "sugárzásmérő badge"

#. ~ Description for radiation badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic badge with an embedded filmstrip.  The filmstrip changes color as "
"it is exposed to radiation.  Wear on your lapel so you can notice if it "
"changes."
msgstr ""
"Műanyag tokba épített filmszalag. A sugárterheléssel a film színe "
"megváltozik. Tűzd a gallérodra, és akkor meglátod, ha megváltozik."

#: lang/json/ARMOR_from_json.py
msgid "badge template"
msgid_plural "badge templates"
msgstr[0] "jelvény sablon"
msgstr[1] "jelvény sablon"

#. ~ Description for badge template
#: lang/json/ARMOR_from_json.py
msgid ""
"This is a template for police/medical badges.  If found in a game, it is a "
"bug."
msgstr ""
"Ez a rendőrségi jelvények sablonja. Ha ezt a játékban látod, az egy bug."

#: lang/json/ARMOR_from_json.py
msgid "cybercop badge"
msgid_plural "cybercop badges"
msgstr[0] "kiberzsaru jelvény"
msgstr[1] "kiberzsaru jelvény"

#. ~ Description for cybercop badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A chromed silver shield identifies the wearer as an authority even the cop-"
"killers couldn't kill."
msgstr ""
"Egy krómozott ezüst pajzs mutatja, hogy a viselője olyan hatalom, akit még a"
" rendőrgyilkosok sem tudnak kicsinálni."

#: lang/json/ARMOR_from_json.py
msgid "deputy badge"
msgid_plural "deputy badges"
msgstr[0] "seriff csillag"
msgstr[1] "seriff csillag"

#. ~ Description for deputy badge
#: lang/json/ARMOR_from_json.py
msgid "A tarnished silver star gives an air of authority to the wearer."
msgstr ""
"Patinás aranycsillag, amely a viselőjének hatalmi allűröket kölcsönöz."

#: lang/json/ARMOR_from_json.py
msgid "detective badge"
msgid_plural "detective badges"
msgstr[0] "detektív jelvény"
msgstr[1] "detektív jelvény"

#. ~ Description for detective badge
#: lang/json/ARMOR_from_json.py
msgid "A tarnished golden shield gives an air of authority to the wearer."
msgstr "Patinás aranypajzs, amely a viselőjének hatalmi allűröket kölcsönöz."

#: lang/json/ARMOR_from_json.py
msgid "marshal badge"
msgid_plural "marshal badges"
msgstr[0] "marsall jelvény"
msgstr[1] "marsall jelvény"

#. ~ Description for marshal badge
#: lang/json/ARMOR_from_json.py
msgid "A bright silver star strikes fear into the eyes of ne'er-do-wells."
msgstr ""
"A csillogó ezüstcsillag láttára megfutamodnak a semmirekellők. Elvileg."

#: lang/json/ARMOR_from_json.py
msgid "SWAT badge"
msgid_plural "SWAT badges"
msgstr[0] "SWAT jelvény"
msgstr[1] "SWAT jelvény"

#. ~ Description for SWAT badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A matte-finish silver shield identifies the wearer as an authority who goes "
"in when the bots just aren't enough."
msgstr ""
"Ezüst színű matt pajzs mutatja, hogy a viselője olyan hatalommal bír, akit "
"akkor küldenek harcba, amikor a robotok is kevésnek bizonyultak."

#: lang/json/ARMOR_from_json.py
msgid "doctor badge"
msgid_plural "doctor badges"
msgstr[0] "orvos jelvény"
msgstr[1] "orvos jelvény"

#. ~ Description for doctor badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic name tag marking the wearer as a real doctor of the medical kind."
msgstr ""
"Egy műanyag névtábla, amely szerint a viselője igazi doktor, az orvosi "
"fajtából."

#: lang/json/ARMOR_from_json.py
msgid "Foodkid badge"
msgid_plural "Foodkid badges"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for Foodkid badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A star shaped badge.  On it, you can read \"Foodkid\" in bold letters.  This"
" is Foodperson's trusty sidekick's badge."
msgstr ""
"Csillag alakú jelvény. Ezen vastag betűkkel olvasható az \"Ételklambó\". Ez "
"az Ételszemély megbízható segédjének jelvénye."

#: lang/json/ARMOR_from_json.py
msgid "pair of fuzzy cat ears"
msgid_plural "pairs of fuzzy cat ears"
msgstr[0] "szőrös macskafül"
msgstr[1] "szőrös macskafül"

#. ~ Description for pair of fuzzy cat ears
#: lang/json/ARMOR_from_json.py
msgid ""
"A fuzzy pair of brownish cat ears on a headband.  It does nothing, but "
"there's no reason not to look good even if no one's looking."
msgstr ""
"Hajráfra erősített, barna szőrös macskafülek. Semmire se jó, de akkor sem "
"kell toprongyosan kinézni, ha amúgy senki se lát."

#: lang/json/ARMOR_from_json.py
msgid "pair of faux fur cat ears"
msgid_plural "pairs of faux fur cat ears"
msgstr[0] "műszőrme macskafül"
msgstr[1] "műszőrme macskafül"

#. ~ Description for pair of faux fur cat ears
#: lang/json/ARMOR_from_json.py
msgid ""
"A fuzzy pair of garishly colored cat ears on a headband.  It does nothing, "
"but there's no reason not to look good even if no one's looking."
msgstr ""
"Hajráfra erősített, rikító színű, műszőrös macskafülek. Semmire se jó, de "
"akkor sem kell toprongyosan kinézni, ha amúgy senki se lát."

#: lang/json/ARMOR_from_json.py
msgid "fuzzy cat tail"
msgid_plural "fuzzy cat tails"
msgstr[0] "szőrös macskafarok"
msgstr[1] "szőrös macskafarok"

#. ~ Description for fuzzy cat tail
#: lang/json/ARMOR_from_json.py
msgid ""
"A fuzzy tawny tail weighted down with tiny beads of plastic.  Sways behind "
"you when you walk."
msgstr ""
"Cirmos szőrös farok, amelyet apró műanyag golyókkal nehezítettek. Járás "
"közben mögötted csóvál."

#: lang/json/ARMOR_from_json.py
msgid "faux fur cat tail"
msgid_plural "faux fur cat tails"
msgstr[0] "műszőrme macskafarok"
msgstr[1] "műszőrme macskafarok"

#. ~ Description for faux fur cat tail
#: lang/json/ARMOR_from_json.py
msgid ""
"A fuzzy garishly colored tail weighted down with tiny beads of plastic.  "
"Sways behind you when you walk."
msgstr ""
