#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Ecoterrorist"
msgstr "エコテロリスト"

#. ~ Profession (male Ecoterrorist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"These bastards were destroying Earth far before the undead came, and mauling"
" those execs was worth the federal charges.  Now, you may have greater "
"priorities than pollution."
msgstr ""
"ゾンビの登場よりずっと以前から地球を破壊しており、その所業は連邦政府から告発される程の酷さでした。この状況では環境破壊よりも優先すべきことがありそうです。"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Ecoterrorist"
msgstr "エコテロリスト"

#. ~ Profession (female Ecoterrorist) description
#: lang/json/professions_from_json.py
