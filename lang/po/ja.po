#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s's arm pierces your %2$s!"
msgstr "%1$sの腕が%2$sに突き刺さりました！"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
