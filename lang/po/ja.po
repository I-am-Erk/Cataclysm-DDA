#: lang/json/GENERIC_from_json.py
msgid "MatheMAX"
msgid_plural "MatheMAX"
msgstr[0] "マスマックス"

#. ~ Description for {'str_sp': 'MatheMAX'}
#: lang/json/GENERIC_from_json.py
