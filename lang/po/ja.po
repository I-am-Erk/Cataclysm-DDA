msgstr[0] "デニムパンツ"

#. ~ Description for {'str_sp': 'denim shorts'}
#: lang/json/ARMOR_from_json.py
msgid "A pair of denim shorts."
msgstr "デニム生地のズボンです。"

#: lang/json/ARMOR_from_json.py
