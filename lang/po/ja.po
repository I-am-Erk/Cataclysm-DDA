msgstr "小型サイズの魚です。"

#: lang/json/MONSTER_from_json.py
msgid "medium fish"
msgid_plural "medium fish"
msgstr[0] "魚(中)"

#. ~ Description for {'str_sp': 'medium fish'}
#: lang/json/MONSTER_from_json.py
