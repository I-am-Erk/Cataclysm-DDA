#: lang/json/SPELL_from_json.py
msgid "Vicious Tentacle"
msgstr "ビシャス・テンタクル"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Grotesque Enhancement"
msgstr "グロテスク・エンハンスメント"

#: lang/json/SPELL_from_json.py
msgid "Acidic Spray"
msgstr "アシディック・スプレー"

#: lang/json/SPELL_from_json.py
msgid "Flesh Pouch"
msgstr "フレッシュ・ポーチ"

#: lang/json/SPELL_from_json.py
msgid "Conjure Bonespear"
msgstr "コンジャー・ボーンスピア"

#: lang/json/SPELL_from_json.py
msgid "Biomancer Rune"
msgstr "バイオマンサー・ルーン"

#. ~ Description for Biomancer Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Biomancers.  You can use the "
"rune as a catalyst for recipes."
msgstr "儀式によってバイオマンサーと波長の合う神秘的な石を創り出します。石はレシピの触媒として利用できます。"

#: lang/json/SPELL_from_json.py
msgid "Paralytic Dart"
msgstr "パラリティック・ダート"

#: lang/json/SPELL_from_json.py
msgid "Visceral Projection"
msgstr "ヴィセラル・プロジェクション"

#: lang/json/SPELL_from_json.py
msgid "Visceral Paralysis"
msgstr "麻痺(副次効果)"

#. ~ Description for Visceral Paralysis
#: lang/json/SPELL_from_json.py
msgid "Paralytic side effect of Projection."
msgstr "ヴィセラル・プロジェクションの麻痺効果です。"

#: lang/json/SPELL_from_json.py
msgid "Visceral Backlash"
msgstr "反動(副次効果)"

#. ~ Description for Visceral Backlash
#: lang/json/SPELL_from_json.py
msgid "Hits the user with side effects too."
msgstr "詠唱者に対する副作用です。"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Coagulant Weave"
msgstr "コアグラント・ウィーヴ"

#: lang/json/SPELL_from_json.py
msgid "Caustic Feedback"
msgstr "酸のフィードバック(副次効果)"

#. ~ Description for Caustic Feedback
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of the Caustic Aura spell."
msgstr "コースティック・オーラの副次的効果です。"

#. ~ description for the sound of spell 'Caustic Feedback'
#: lang/json/SPELL_from_json.py
msgid "acidic sizzle!"
msgstr "ジュッ！"

#: lang/json/SPELL_from_json.py
msgid "Caustic Aura"
msgstr "コースティック・オーラ"

#. ~ Description for Caustic Aura
#: lang/json/SPELL_from_json.py
msgid ""
"This spell suspends acid in a layer around you, corroding melee attackers "
"when struck and enhancing your melee damage."
msgstr "酸の膜を全身に纏います。近接攻撃力が増加し、攻撃してきた敵は酸に蝕まれます。"

#: lang/json/SPELL_from_json.py
msgid "Acid Claw"
msgstr "酸の爪"

#. ~ Description for Acid Claw
#: lang/json/SPELL_from_json.py
msgid ""
"Your claws glow with yellow acid energy, and as you swipe your claw a wave "
"of acid sweeps forth from it."
msgstr "酸性のエネルギーによって黄色く輝く爪を振りかざすと、酸の波が周囲を一掃します。"

#: lang/json/SPELL_from_json.py
msgid "Acid Bite"
msgstr "酸の牙"

#. ~ Description for Acid Bite
#: lang/json/SPELL_from_json.py
msgid "Your maw drips with acid as you make a bite attack."
msgstr "噛み付き攻撃に酸ダメージを付与します。"

#: lang/json/SPELL_from_json.py
msgid "Dragon's Bite"
msgstr "竜の咢"

#. ~ Description for Dragon's Bite
#: lang/json/SPELL_from_json.py
msgid "The bite damage in Acid Bite."
msgstr "酸の牙の噛み付きダメージです。"

#. ~ Description for Black Dragon Shell
#: lang/json/SPELL_from_json.py
msgid ""
"You channel your inner draconic magic to protect yourself from damage and "
"reflect some back as acid damage."
msgstr "内なる竜の魔法によってダメージから身を守り、その一部を酸攻撃として敵に反射します。"

#: lang/json/SPELL_from_json.py
msgid "Black Dragon Shell Retaliation"
msgstr "黒竜の鎧の報復"

#. ~ Description for Black Dragon Shell Retaliation
#: lang/json/SPELL_from_json.py
msgid "Acid burst that punishes attackers."
msgstr "酸の爆発を引き起こして攻撃者に反撃します。"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Terror"
msgstr "竜の咆哮"

#. ~ Description for Dragon Terror
#: lang/json/SPELL_from_json.py
msgid ""
"With an ear piercing roar, you channel the inner power of dragons and strike"
" fear into those who stand before you, slowing their escape from your "
"terror."
msgstr "内なる竜の力を使って耳をつんざく咆哮をあげ、周囲の人々を強い恐怖で満たします。"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Boost"
msgstr "竜の鼓舞"

#. ~ Description for Dragon Boost
#: lang/json/SPELL_from_json.py
msgid ""
"You let out a mighty roar as you infuse yourself with the power of Dragons."
msgstr "轟音をたてて竜の力を高めます。"

#: lang/json/SPELL_from_json.py
msgid "Health recovery"
msgstr "体力回復"

#. ~ Description for Health recovery
#: lang/json/SPELL_from_json.py
msgid "minor health recovery spell associated with Dragon Boost."
msgstr "竜の鼓舞に関連する体力回復呪文です。"

#: lang/json/SPELL_from_json.py
msgid "Stamina recovery"
msgstr "スタミナ回復"

#. ~ Description for Stamina recovery
#: lang/json/SPELL_from_json.py
msgid "minor stamina recovery spell associated with Dragon Boost."
msgstr "竜の鼓舞に関連するスタミナ回復呪文です。"

#: lang/json/SPELL_from_json.py
msgid "Dragon Acid Spit"
msgstr "酸の息吹"

#. ~ Description for Dragon Acid Spit
#: lang/json/SPELL_from_json.py
msgid ""
"You conjur up acidic spittle that you can shoot long distances as you close "
"on your terrified prey."
msgstr "近寄ってきた獲物に酸を吐きかけます。"

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Black Dragon Breath"
msgstr "黒竜の息吹"

#. ~ Description for Black Dragon Breath
#. ~ Description for Black Dragons' Breath
#: lang/json/SPELL_from_json.py
msgid "Spews a line of acid from your mouth."
msgstr "口から一直線上に酸を噴き出します。"

#: lang/json/SPELL_from_json.py
msgid "Crystallize Mana"
msgstr "クリスタライズ・マナ"

#. ~ Description for Crystallize Mana
#: lang/json/SPELL_from_json.py
msgid "Crystallizes mana into solid form"
msgstr "マナを固体化します。"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Mana Fatigue"
msgstr "マナ倦怠感"

#. ~ Description for Mana Fatigue
#: lang/json/SPELL_from_json.py
msgid "Secondary effect of Crystallize Mana"
msgstr "クリスタライズ・マナの呪文の副次効果です。"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dark Sight"
msgstr "ダーク・サイト"

#. ~ Description for Dark Sight
#: lang/json/SPELL_from_json.py
msgid "Gives you the power to see in the dark"
msgstr "暗闇を見通す力を与えます。"

#. ~ Message for SPELL 'Dark Sight'
#: lang/json/SPELL_from_json.py
msgid ""
"Your eyes glow green for a moment.  Now your sight can pierce the darkest "
"shadows."
msgstr "瞳が一瞬緑色に光り、暗黒を見通す力を得ました。"

#: lang/json/SPELL_from_json.py
msgid "Megablast"
msgstr "メガブラスト"

#: lang/json/SPELL_from_json.py
msgid "Magical Light"
msgstr "マジカル・ライト"

#: lang/json/SPELL_from_json.py
msgid "Blinding Flash"
msgstr "ブラインディング・フラッシュ"

#: lang/json/SPELL_from_json.py
msgid "Ethereal Grasp"
msgstr "エーテル・グラスプ"

#: lang/json/SPELL_from_json.py
msgid "Obfuscated Body"
msgstr "オブファスケーテッド・ボディ"

#. ~ Description for Obfuscated Body
#: lang/json/SPELL_from_json.py
msgid ""
"A magical aura distorts light around your body, increasing the amount of "
"attacks you might dodge in a given turn."
msgstr "魔法のオーラが身体の周りの光を歪め、1ターンで回避できる攻撃回数を増加させます。"

#: lang/json/SPELL_from_json.py
msgid "Aura of Protection"
msgstr "オーラ・オブ・プロテクション"

#: lang/json/SPELL_from_json.py
msgid "Translocate Self"
msgstr "トランスロケート・セルフ"

#. ~ Description for Translocate Self
#: lang/json/SPELL_from_json.py
msgid "Translocates the user to an attuned gate."
msgstr "使用者を特定の波長を出すゲートへ転移します。"

#: lang/json/SPELL_from_json.py
msgid "Acid Resistance"
msgstr "アシッド・レジスタンス"

#. ~ Description for Acid Resistance
#. ~ Description for Greater Acid Resistance
#: lang/json/SPELL_from_json.py
msgid "Protects the user from acid."
msgstr "酸から身体を守ります。"

#: lang/json/SPELL_from_json.py
msgid "Greater Acid Resistance"
msgstr "グレーター・アシッド・レジスタンス"

#: lang/json/SPELL_from_json.py
msgid "Template Spell"
msgstr "呪文テンプレート"

#. ~ Description for Template Spell
#: lang/json/SPELL_from_json.py
msgid "This is a template to show off all the available values"
msgstr "利用可能なすべての値を表示するテンプレートです。"

#. ~ Message for SPELL 'Template Spell'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "As you cast %s, your ears pops!"
msgstr "%sを唱えると、耳がツーンとなりました。"

#: lang/json/SPELL_from_json.py
msgid "debug push no aoe"
msgstr "範囲0押し出し(デバッグ専用)"

#. ~ Description for debug push no aoe
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 0"
msgstr "全てのオブジェクトに範囲0の押し出し効果を付与します"

#: lang/json/SPELL_from_json.py
msgid "debug push blast"
msgstr "爆風押し出し(デバッグ専用)"

#. ~ Description for debug push blast
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 3 in a blast pattern"
msgstr "全てのオブジェクトに範囲3の押し出し効果を付与します"

#: lang/json/SPELL_from_json.py
msgid "Spawn Debug Monsters"
msgstr "デバッグモンスター召喚(デバッグ専用)"

#. ~ Description for Spawn Debug Monsters
#: lang/json/SPELL_from_json.py
msgid "Set level to number of monsters spawned."
msgstr "レベルに応じて出現するモンスターの数が増加します。"

#. ~ Message for SPELL 'Spawn Debug Monsters'
