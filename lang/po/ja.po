#: lang/json/ARMOR_from_json.py
msgid "beaded bracelet"
msgid_plural "beaded bracelets"
msgstr[0] "ブレスレット(ビーズ)"

#. ~ Description for beaded bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
