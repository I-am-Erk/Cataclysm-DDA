#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Hobby Handloader"
msgstr "趣味の銃弾製作者"

#. ~ Profession (male Hobby Handloader) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Out of financial concerns and an appreciation for power, you took up "
"handloading for your mighty handgun.  Now that the gunstores are closed, "
"your skills ensure you won't be running out of ammo anytime soon."
msgstr ""
"経済的な懸念と力への信奉から、威力の高いハンドガン用弾薬の手詰めに手を出しました。銃砲店が閉店しているので、弾薬を使い果たしてしまった時にはこの特技が役立ちそうです。"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Hobby Handloader"
msgstr "趣味の銃弾製作者"

#. ~ Profession (female Hobby Handloader) description
#: lang/json/professions_from_json.py
