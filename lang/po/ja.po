#. '{'str': 'Faulty water pump'}'
#: lang/json/fault_from_json.py
#, python-format
msgid "You replace the faulty water pump of the %s."
msgstr "%sの故障したウォーターポンプを交換しました。"

#: lang/json/fault_from_json.py
msgid "Worn drive belt"
msgstr "駆動ベルト摩耗"

#. ~ description for fault '{'str': 'Worn drive belt'}'
#: lang/json/fault_from_json.py
msgid "Required for operation of an attached alternator."
msgstr "オルタネーターとの接続に必要です。"

#. ~ name of mending method for fault '{'str': 'Worn drive belt'}'
#: lang/json/fault_from_json.py
