#: lang/json/ARMOR_from_json.py
msgid "jeans"
msgid_plural "jeans"
msgstr[0] "ジーンズ"

#. ~ Description for {'str_sp': 'jeans'}
#: lang/json/ARMOR_from_json.py
msgid "A pair of blue jeans with two deep pockets."
msgstr "2つの深いポケットが付いた青色のジーンズです。"

#: lang/json/ARMOR_from_json.py
msgid "A pair of black jeans with two deep pockets."
msgstr "2つの深いポケットが付いた黒色のジーンズです。"

#: lang/json/ARMOR_from_json.py
msgid "A pair of black skinny jeans."
msgstr "黒色のスキニージーンズです。"

#: lang/json/ARMOR_from_json.py
msgid "A stylish pair of bleached denim jeans."
msgstr "スタイリッシュなブリーチデニムジーンズです。"

#: lang/json/ARMOR_from_json.py
msgid "A pair of old baggy jeans.  The heels are all ripped up."
msgstr "古びたダブダブのジーンズです。踵の部分が引き裂かれてズタズタになっています。"

#: lang/json/ARMOR_from_json.py
msgid ""
"An old pair of blue jeans.  You are not sure if they are faded through age "
"or stone washed."
msgstr "古びた青色のジーンズです。経年による色褪せなのか古着加工が施されているのか判別できません。"

#: lang/json/ARMOR_from_json.py
msgid "red jeans"
msgid_plural "red jeans"
msgstr[0] "ジーンズ(赤)"

#. ~ Description for {'str_sp': 'red jeans'}
#: lang/json/ARMOR_from_json.py
msgid "A pair of tight-fitting candy-apple-red jeans with two deep pockets."
msgstr "2つの深いポケットが付いた、キャンディアップルレッドのタイトなジーンズです。"

#: lang/json/ARMOR_from_json.py
msgid "kilt"
msgid_plural "kilts"
msgstr[0] "キルト"

#. ~ Description for kilt
#. ~ Description for leather kilt
#: lang/json/ARMOR_from_json.py
msgid "No true Scotsman would leave home without his kilt."
msgstr "真のスコットランド人はキルトを纏わずに外出しないものです。"

#: lang/json/ARMOR_from_json.py
msgid "leather kilt"
msgid_plural "leather kilts"
msgstr[0] "キルト(革)"

#: lang/json/ARMOR_from_json.py
msgid "leggings"
msgid_plural "leggings"
msgstr[0] "レギンス"

#. ~ Description for {'str_sp': 'leggings'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Skin-tight nylon leggings, sometimes used when exercising, that keep your "
"legs nice and warm."
msgstr "運動をする際に着用することがある、ナイロン製の肌に密着するレギンスです。非常に暖かく、脚を包み込んでくれます。"

#: lang/json/ARMOR_from_json.py
msgid "loincloth"
msgid_plural "loincloths"
msgstr[0] "腰巻き"

#. ~ Description for loincloth
#: lang/json/ARMOR_from_json.py
msgid ""
"Rags stitched together and tied into a makeshift loincloth.  Covers your "
"modesty, but not much else."
msgstr "縫合した布を結び合わせた即席の腰巻きです。品位を守ってはくれますが、それだけです。"

#: lang/json/ARMOR_from_json.py
msgid "fur loincloth"
msgid_plural "fur loincloths"
msgstr[0] "腰巻き(毛皮)"

#. ~ Description for fur loincloth
#: lang/json/ARMOR_from_json.py
msgid ""
"A fur pelt tied into a loincloth.  Covers your modesty, but not much else.  "
"Now you are a true barbarian warrior."
msgstr "毛皮を結び合わせた腰巻きです。品位を守ってはくれますが、それだけです。これを身に付ければ、真の蛮族の戦士になれますよ。"

#: lang/json/ARMOR_from_json.py
msgid "leather loincloth"
msgid_plural "leather loincloths"
msgstr[0] "腰巻き(革)"

