msgid_plural "patchwork Lycra clothing parts"
msgstr[0] "partes de roupa de retalhos de Licra"
msgstr[1] "partes de roupa de retalhos de Licra"

#. ~ Description for {'str_sp': 'patchwork Lycra clothing parts'}
#: lang/json/AMMO_from_json.py
msgid ""
"A selection of various clothing parts, sewn together from Lycra patches in a"
