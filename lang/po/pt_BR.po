msgid "Diamond Mind"
msgstr ""

#. ~ Description for martial art '{'str': 'Diamond Mind'}'
#: lang/json/martial_art_from_json.py
msgid ""
"A student of the Diamond Mind discipline has honed their mind to defeat any "
