msgstr ""

#. ~ initiate message for martial art '{'str': 'Scorpion Kung Fu'}'
#: lang/json/martial_art_from_json.py
msgid "You prepare to capture and sting your foes."
msgstr ""

#. ~ initiate message for martial art '{'str': 'Scorpion Kung Fu'}'
#: lang/json/martial_art_from_json.py
#, python-format
msgid "%s assumes a scorpion-like stance."
msgstr ""

#: lang/json/martial_art_from_json.py
