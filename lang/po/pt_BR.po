msgstr[0] "lençol de Kevlar"
msgstr[1] "lençois de Kevlar"

#. ~ Description for Kevlar sheet
#: lang/json/AMMO_from_json.py
msgid ""
"A sheet of Kevlar synthetic fabric, suitable for making cut-resistant, "
"durable clothing.  In this form, unlike rigid plates, it can be stitched."
msgstr ""
"Um lençol de tecido de Kevlar sintético, apropriado para fabricação de "
"roupas resistentes a corte e duráveis. Nesta forma, ao contrário de placas "
"rígidas, pode ser costurado."

#: lang/json/AMMO_from_json.py
msgid "Lycra sheet"
msgid_plural "Lycra sheets"
msgstr[0] "lençol de Licra"
msgstr[1] "lençóis de Licra"

#. ~ Description for Lycra sheet
