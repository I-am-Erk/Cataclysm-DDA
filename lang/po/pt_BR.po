#: lang/json/TOOL_ARMOR_from_json.py
msgid "electric guitar"
msgid_plural "electric guitars"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for electric guitar
#: lang/json/TOOL_ARMOR_from_json.py
