msgstr ""
" kris Esta é uma réplica maçante e barata de um punhal ondulado que "
"vemdosudeste da Ásia."

#: lang/json/GENERIC_from_json.py
msgid "lajatang"
msgid_plural "lajatangs"
msgstr[0] "lajatang"
msgstr[1] "lajatangs"

