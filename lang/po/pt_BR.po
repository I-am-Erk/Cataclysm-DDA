msgstr[1] "munições de rifle enormes, AP (recarregadas)"

#: lang/json/AMMO_from_json.py
msgid "rocket, antipersonnel"
msgid_plural "rocket, antipersonnel"
msgstr[0] "foguete, antipessoal"
msgstr[1] "foguetes, antipessoais"

#. ~ Description for {'str_sp': 'rocket, antipersonnel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A large anti-personnel rocket for a military rocket launcher.  Designed to "
"be highly effective against personnel."
msgstr ""
"Um grande foguete antipessoal para um lança-míssil militar. Desenhado para "
"ser altamente efetivo contra pessoal."

#: lang/json/AMMO_from_json.py
msgid "rocket, multipurpose"
msgid_plural "rocket, multipurpose"
msgstr[0] "foguete, multipropósito"
msgstr[1] "foguetes, multipropósito"

#. ~ Description for {'str_sp': 'rocket, multipurpose'}
#: lang/json/AMMO_from_json.py
msgid ""
"An anti-tank rocket with a high explosive dual purpose warhead for a "
"military rocket launcher.  Designed to be highly effective against vehicles "
"and structures, and retains some effectiveness against personnel."
msgstr ""
"Um foguete anti-tanque com uma ogiva altamente explosiva de propósito duplo "
"para uso em um lança-míssil militar. Desenhado para ser altamente efetivo "
"contra veículos e estruturas, e mantém alguma efetividade contra pessoal."

#: lang/json/AMMO_from_json.py
msgid "rocket, smoke"
msgid_plural "rocket, smoke"
msgstr[0] "foguete, fumaça"
msgstr[1] "foguetes, fumaça"

#. ~ Description for {'str_sp': 'rocket, smoke'}
#: lang/json/AMMO_from_json.py
msgid ""
"A rocket loaded with a smoke warhead for a military rocket launcher.  "
"Commonly used for signaling, target designation, and for screening troop "
"movements."
msgstr ""
"Um foguete carregado com uma ogiva de fumaça para uso em um lança-míssil "
"militar. Comumente utilizada para sinalização, designação de alvo, e "
"rastreamento da movimentação de tropas."

#: lang/json/AMMO_from_json.py
msgid "shotshell, buckshot"
msgid_plural "shotshell, buckshot"
msgstr[0] "cartucho de caçadeira, buckshot"
