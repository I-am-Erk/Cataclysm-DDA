msgid "Ruthlessness"
msgstr ""

#. ~ Description of buff 'Ruthlessness' for martial art 'CRIT Blade-work'
#: lang/json/martial_art_from_json.py
msgid ""
"Additional Stabbing and Cutting damage per stack.  Reduces dodge attempts.  "
"4 stacks max."
msgstr ""

