#. ~ Description of buff 'Toad's Venom' for martial art '{'str': 'Toad Kung
#. Fu'}'
#: lang/json/martial_art_from_json.py
msgid ""
"Your venom is just another lesson about the strength of your iron body.\n"
"\n"
"+2 bash damage.\n"
"Lasts 5 turns."
msgstr ""

#: lang/json/martial_art_from_json.py
msgid "Viper Kung Fu"
msgstr "Víbora Kung Fu"

#. ~ Description for martial art '{'str': 'Viper Kung Fu'}'
#: lang/json/martial_art_from_json.py
