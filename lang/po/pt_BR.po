msgid ""
"A collection of essays by various authors from around the world, including "
"works by Churchill, Mailer, Eco, and Voltaire."
msgstr ""
"Uma coleção de ensaios de vários autores de todo o mundo, incluindo obras de"
" Churchill, Mailer, Eco e Voltaire."

#: lang/json/BOOK_from_json.py
msgid "The Hitchhiker's Guide to the Cataclysm"
msgid_plural "copies of The Hitchhiker's Guide to the Cataclysm"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for The Hitchhiker's Guide to the Cataclysm
#: lang/json/BOOK_from_json.py
msgid ""
"Inscribed on the cover in large, friendly letters, is the message \"Don't "
"Panic\"."
msgstr ""
"Inscrito na capa, em letras grandes e amigáveis, está a mensagem \"Não entre"
" em pânico\"."

#: lang/json/BOOK_from_json.py
msgid "comic book"
msgid_plural "comic books"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for comic book
#: lang/json/BOOK_from_json.py
msgid "A super-hero comic."
msgstr "Quadrinhos sobre super-heróis."

#: lang/json/BOOK_from_json.py
