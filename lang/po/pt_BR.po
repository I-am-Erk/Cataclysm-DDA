#: lang/json/AMMO_from_json.py
msgid "tin powder"
msgid_plural "tin powder"
msgstr[0] "pó de estanho"
msgstr[1] "pó de estanho"

#. ~ Description for {'str_sp': 'tin powder'}
#: lang/json/AMMO_from_json.py
