"Esta é uma lâmpada a óleo. Não fornece muita luz, mas dura muito tempo. "
"Use-a para ligá-la."

#: lang/json/TOOL_from_json.py
msgid "oil lamp"
msgid_plural "oil lamps"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for oil lamp
#: lang/json/TOOL_from_json.py
