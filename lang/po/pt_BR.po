msgstr "…Mas nunca no crepúsculo."

#: lang/json/snippet_from_json.py
msgid "Dave's not here, man."
msgstr "Dave não está aqui, cara."

#: lang/json/snippet_from_json.py
msgid "Man, a cheeseburger sounds SO awesome right now."
msgstr "Cara, um cheeseburger soa tão incrível agora."

#: lang/json/snippet_from_json.py
msgid "Eh… maybe not."
msgstr "Eh... talvez não."

#: lang/json/snippet_from_json.py
msgid "I guess, maybe, without the cheese… yeah."
msgstr "Eu acho que, talvez, sem o queijo... é."

#: lang/json/snippet_from_json.py
