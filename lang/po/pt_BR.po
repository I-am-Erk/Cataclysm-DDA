"espinhos!"

#: lang/json/terrain_from_json.py
msgid "hydrangea bush"
msgstr "arbusto da hortênsia"

#. ~ Description for hydrangea bush
#: lang/json/terrain_from_json.py
msgid "A fat, bush of fragrant blue hydrangeas."
msgstr "Um arbusto gordo de hortênsias azuis perfumadas."

#. ~ Description for hydrangea bush
#: lang/json/terrain_from_json.py
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Um arbusto de hortênsia gorda que atualmente não tem flores."

#: lang/json/terrain_from_json.py
msgid "lilac bush"
msgstr "arbusto lilás"

#. ~ Description for lilac bush
#: lang/json/terrain_from_json.py
msgid "A wide, bush of bright pinkish purple lilacs."
msgstr "Um amplo arbusto de lilases roxos rosados e brilhantes."

#. ~ Description for lilac bush
#: lang/json/terrain_from_json.py
msgid "A wide lilac bush that currently has no blooms."
msgstr "Um grande arbusto lilás que atualmente não tem flores."

#: lang/json/terrain_from_json.py
msgid "tree trunk"
msgstr "tronco de árvore"

#. ~ Description for tree trunk
#: lang/json/terrain_from_json.py
