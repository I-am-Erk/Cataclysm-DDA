#: lang/json/TOOL_from_json.py
msgid "heat cube (torch on)"
msgid_plural "heat cubes (torch on)"
msgstr[0] "cubo de calor (tocha acesa)"
msgstr[1] "cubos de calor (tocha acesa)"

#. ~ Use action msg for heat cube (torch on).
