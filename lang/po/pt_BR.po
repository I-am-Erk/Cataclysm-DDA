"This widespread powertool is often used for removing excess material or "
"polishing surfaces."
msgstr ""

#: lang/json/TOOL_from_json.py
msgid "brick kiln"
msgid_plural "brick kilns"
msgstr[0] "forno de tijolo"
msgstr[1] "fornos de tijolo"

#. ~ Description for brick kiln
#: lang/json/TOOL_from_json.py
