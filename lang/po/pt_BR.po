"value is now greatly diminished."
msgstr ""
"Um metal brilhoso macio. Antes do Cataclisma valia um bom dinheiro mas seu "
"valor diminuiu bastante agora."

#: lang/json/AMMO_from_json.py
msgid "small metal sheet"
msgid_plural "small metal sheets"
