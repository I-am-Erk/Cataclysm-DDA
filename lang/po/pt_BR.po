#: lang/json/AMMO_from_json.py
msgid "fusion pack"
msgid_plural "fusion packs"
msgstr[0] "pacote de fusão"
msgstr[1] "pacotes de fusão"

#. ~ Description for fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil."
msgstr ""
"Em meados do século XXI, as potências militares começaram a estudar armas "
"baseadas em energia. O resultado foi o pacote de fusão padrão, capaz de "
"emitir raios de gás superaquecido próximos à velocidade da luz e sem recuo."

#: lang/json/AMMO_from_json.py
msgid "bootleg fusion pack"
msgid_plural "bootleg fusion packs"
msgstr[0] "pacote de fusão falsificado"
msgstr[1] "pacotes de fusão falsificados"

#. ~ Description for bootleg fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil.  "
"This one has been hand-crafted from spare parts."
msgstr ""
"Em meados do século XXI, as potências militares começaram a procurar armas "
"baseadas em energia. O resultado foi o pacote de fusão padrão, capaz de "
"emitir raios de gás superaquecido a uma velocidade próxima da luz sem recuo."
" Este foi feito a mão a partir de peças de reposição."

#: lang/json/AMMO_from_json.py
msgid "battery"
msgid_plural "battery"
msgstr[0] "bateria"
msgstr[1] "bateria"

#. ~ Description for {'str_sp': 'battery'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some free-floating battery charge.  This can be reloaded into rechargable "
"battery cells, but can never be unloaded."
msgstr ""
"Um pouco de carga de bateria flutuante. Isto pode ser recarregado em células"
" de bateria recarregáveis, mas não poderá jamais ser descarregado."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "butane"
msgid_plural "butane"
msgstr[0] "butano"
msgstr[1] "butano"

#. ~ Description for {'str_sp': 'butane'}
#: lang/json/AMMO_from_json.py
msgid "A common flammable liquid used in lighters."
msgstr "Um líquido inflamável comumente usado em isqueiros."

#: lang/json/AMMO_from_json.py
msgid "aerosol paint"
msgid_plural "aerosol paint"
msgstr[0] "tinta spray"
msgstr[1] "tinta spray"

#. ~ Description for {'str_sp': 'aerosol paint'}
#: lang/json/AMMO_from_json.py
msgid ""
"A paint that comes in a sealed, pressurized container and is released in an "
"aerosol spray when a valve button is depressed."
msgstr ""
"Uma tinta selada em um recipiente pressurizado, liberada em um jato de "
"aerosol quando um botão é apertado."

#: lang/json/AMMO_from_json.py
msgid "permanent ink"
msgid_plural "permanent ink"
msgstr[0] "tinta permanente"
msgstr[1] "tinta permanente"

#. ~ Description for {'str_sp': 'permanent ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"A ink comprises a main carrier solvent, a glyceride, a pyrrolidone, a resin "
"and a colorant, making it water resistant."
msgstr ""
"Uma tinta de escrever composta de solvente, glicerídeo, resina, pirrolidona "
"e pigmento, tornando-a à prova d'água."

#: lang/json/AMMO_from_json.py
msgid "candle wax"
msgid_plural "candle wax"
msgstr[0] "cera de vela"
msgstr[1] "cera de vela"

#. ~ Description for {'str_sp': 'candle wax'}
#: lang/json/AMMO_from_json.py
msgid "A flammable solid substance used to make candles."
msgstr "Uma substância inflamável sólida, usada para fazer velas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "flare pyrotechnic"
msgid_plural "flare pyrotechnic"
msgstr[0] "pirotécnico de sinalizador"
msgstr[1] "pirotécnico de sinalizador"

#. ~ Description for {'str_sp': 'flare pyrotechnic'}
#: lang/json/AMMO_from_json.py
msgid "A pyrotechnic chemical used in flares."
msgstr "Um produto químico pirotécnico usado em sinalizadores."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "match"
msgid_plural "matches"
msgstr[0] "fósforo"
msgstr[1] "fósforos"

#. ~ Description for match
#: lang/json/AMMO_from_json.py
msgid ""
"A small stick with a red part at the end.  Strike it against a matchbook to "
"light it."
msgstr ""
"Um pequeno palito com uma ponta vermelha. Raspe contra uma superfície "
"própria para acender."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "oxygen"
msgid_plural "oxygen"
msgstr[0] "oxigênio"
msgstr[1] "oxigênio"

#. ~ Description for {'str_sp': 'oxygen'}
#: lang/json/AMMO_from_json.py
msgid "Compressed medical oxygen."
msgstr "Oxigênio comprimido de uso médico."

#: lang/json/AMMO_from_json.py
msgid "aluminum foil"
msgid_plural "aluminum foil"
msgstr[0] "papel alumínio"
msgstr[1] "papel alumínio"

#. ~ Description for {'str_sp': 'aluminum foil'}
#: lang/json/AMMO_from_json.py
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr ""
"Uma folha fina de alumínio. Às vezes chamada de 'folha de estanho' por ser "
"fabricada de estanho no passado."

#: lang/json/AMMO_from_json.py
msgid "cent"
msgid_plural "cents"
msgstr[0] "centavo"
msgstr[1] "centavos"

#. ~ Description for cent
#: lang/json/AMMO_from_json.py
msgid "A unit of currency equivalent to 0.01 US dollars."
msgstr "Uma unidade monetária equivalente a 0,01 dólares."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "thread"
msgid_plural "thread"
msgstr[0] "linha"
msgstr[1] "linha"

#. ~ Description for {'str_sp': 'thread'}
#: lang/json/AMMO_from_json.py
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr ""
"Uma pequena quantidade de linha que pode ser usada para reabastecer um kit "
"de costura."

#: lang/json/AMMO_from_json.py
msgid "sinew"
msgid_plural "sinews"
msgstr[0] "tendão"
msgstr[1] "tendões"

#. ~ Description for sinew
#: lang/json/AMMO_from_json.py
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr ""
" Um tendão resistente cortado de um corpo, usável como linha de costura."

#: lang/json/AMMO_from_json.py
msgid "plant fiber"
msgid_plural "plant fibers"
msgstr[0] "fibra de planta"
msgstr[1] "fibras de planta"

#. ~ Description for plant fiber
#: lang/json/AMMO_from_json.py
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr ""
" Fibra fina resistente, feita de uma planta. Pode ser usada como linha de "
"costura."

#: lang/json/AMMO_from_json.py
msgid "yarn"
msgid_plural "yarn"
msgstr[0] "novelo"
msgstr[1] "novelos"

#. ~ Description for {'str_sp': 'yarn'}
#: lang/json/AMMO_from_json.py
msgid "Wool yarn, could be used to knit wool clothing."
msgstr "Novelo de lã, pode ser usado para tricotar roupas de lã."

#: lang/json/AMMO_from_json.py
msgid "soap bar"
msgid_plural "soap bars"
msgstr[0] "barra de sabão"
msgstr[1] "barras de sabão"

#. ~ Description for soap bar
#: lang/json/AMMO_from_json.py
msgid "A cleansing agent made into bars."
msgstr "Um agente de limpeza pessoal feito em barras."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "duct tape"
msgid_plural "duct tape"
msgstr[0] "fita adesiva"
msgstr[1] "fita adesiva"

#. ~ Description for {'str_sp': 'duct tape'}
#: lang/json/AMMO_from_json.py
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Um rolo de uma fita adesiva incrivelmente forte. Seus usos são inúmeros."

#: lang/json/AMMO_from_json.py
msgid "rolling paper"
msgid_plural "rolling papers"
msgstr[0] "papel de enrolar"
msgstr[1] "papéis de enrolar"

#. ~ Description for rolling paper
#: lang/json/AMMO_from_json.py
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "Estas são tiras finas de papel usadas para enrolar cigarros."

#: lang/json/AMMO_from_json.py
msgid "copper wire"
msgid_plural "copper wires"
msgstr[0] "fio de cobre"
msgstr[1] "fios de cobre"

#. ~ Description for copper wire
#: lang/json/AMMO_from_json.py
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr ""
" Cabo de cobre revestido em plástico, do tipo usado em pequenos eletrônicos."

#: lang/json/AMMO_from_json.py
msgid "raw copper wire"
msgid_plural "raw copper wires"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for raw copper wire
#: lang/json/AMMO_from_json.py
msgid "Copper wire ready to be covered with plastic."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "plutonium fuel cell"
msgid_plural "plutonium fuel cells"
msgstr[0] "célula de combustível de plutônio"
msgstr[1] "células de combustível de plutônio"

#. ~ Description for plutonium fuel cell
#: lang/json/AMMO_from_json.py
msgid ""
"This is neither a fuel cell, nor nuclear, but the name stuck.  It uses "
"plutonium-244 as a catalyst to stabilize a complicated nanocompound that can"
" store enormous amounts of power.  Unfortunately it cannot be recharged by "
"conventional means: expended cells had to be sent to a central reprocessing "
"facility that almost certainly doesn't exist anymore."
msgstr ""
"Isto não é uma célula de combustível, nem é nuclear, mas o nome ficou. Usa "
"plutônio-244 como um catalisador para estabilizar um complexo nanocompósito "
"que pode armazenar enormes quantidades de energia. Infelizmente, não pode "
"ser recarregada por meios convencionais: as células esgotadas tinham que ser"
" enviadas para uma instalação de reprocessamento central que quase "
"certamente não existe mais."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "plutonium slurry"
msgid_plural "plutonium slurry"
msgstr[0] "pasta de plutônio"
msgstr[1] "pasta de plutônio"

#. ~ Description for {'str_sp': 'plutonium slurry'}
#. ~ Description for {'str_sp': 'watery plutonium slurry'}
#: lang/json/AMMO_from_json.py
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr ""
" Chorume altamente radioativo. Seria uma boa ideia ficar bem longe disso."

#: lang/json/AMMO_from_json.py
msgid "watery plutonium slurry"
msgid_plural "watery plutonium slurry"
msgstr[0] "pasta aguada de plutônio"
msgstr[1] "pasta aguada de plutônio"

#: lang/json/AMMO_from_json.py lang/json/snippet_from_json.py
msgid "rock"
msgid_plural "rocks"
msgstr[0] "pedra"
msgstr[1] "pedras"

#. ~ Description for rock
#: lang/json/AMMO_from_json.py
msgid ""
"A rock the size of a baseball.  Makes a decent melee weapon, and is also "
"good for throwing at enemies."
msgstr ""
"Uma pedra do tamanho de uma bola de beisebol. Dá uma arma decente e também é"
" boa para atirar nos inimigos."

#: lang/json/AMMO_from_json.py
msgid "pebble"
msgid_plural "pebbles"
msgstr[0] "seixo"
msgstr[1] "seixos"

#. ~ Description for pebble
#: lang/json/AMMO_from_json.py
msgid "A small rock, useful as ammunition for slingshots."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "clay pellet"
msgid_plural "clay pellets"
msgstr[0] "bolinha de argila"
msgstr[1] "bolinhas de argila"

#. ~ Description for clay pellet
#: lang/json/AMMO_from_json.py
msgid "A handful of round projectiles made of clay, useful for slingshots."
msgstr ""
"Um punhado de projéteis redondos feitos de argila, útil para atiradeiras."

#: lang/json/AMMO_from_json.py
msgid "marble"
msgid_plural "marbles"
msgstr[0] "bola de gude"
msgstr[1] "bolas de gude"

#. ~ Description for marble
#: lang/json/AMMO_from_json.py
msgid "A handful of glass marbles, useful as ammunition for slingshots."
msgstr ""
"Um punhado de bolas de gude de vidro, úteis como munição para atiradeiras."

#: lang/json/AMMO_from_json.py
msgid "bearings"
msgid_plural "bearings"
msgstr[0] "rolamento"
msgstr[1] "rolamentos"

#. ~ Description for {'str_sp': 'bearings'}
#: lang/json/AMMO_from_json.py
msgid "A box of ball bearings, useful as ammunition for slingshots."
msgstr "Uma caixa de rolimãs, úteis como munição para atiradeiras."

#: lang/json/AMMO_from_json.py
msgid "BB"
msgid_plural "BBs"
msgstr[0] "BB"
msgstr[1] "BBs"

#. ~ Description for BB
#: lang/json/AMMO_from_json.py
msgid ""
"A box of small steel balls that can be fired from a BB gun.  They deal "
"virtually no damage."
msgstr ""
"Uma caixa de bolinhas de aço que podem ser disparadas de uma arma de "
"brinquedo. Não causam praticamente dano nenhum."

#: lang/json/AMMO_from_json.py
msgid "feather"
msgid_plural "feathers"
msgstr[0] "pena"
msgstr[1] "penas"

#. ~ Description for feather
#: lang/json/AMMO_from_json.py
msgid "Feathers from a bird.  Useful for fletching arrows."
msgstr "Penas de um pássaro. Úteis para emplumar flechas."

#: lang/json/AMMO_from_json.py
msgid "down feather"
msgid_plural "down feathers"
msgstr[0] "pluma"
msgstr[1] "plumas"

#. ~ Description for down feather
#: lang/json/AMMO_from_json.py
msgid "Fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr ""
"Plumas fofas de um pássaro. Útil para fazer roupas de cama aconchegantes."

#: lang/json/AMMO_from_json.py
msgid "120mm HEAT"
msgid_plural "120mm HEAT"
msgstr[0] "120mm HEAT"
msgstr[1] "120mm HEAT"

#. ~ Description for {'str_sp': '120mm HEAT'}
#: lang/json/AMMO_from_json.py
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr "Uma bala de 120mm H.E.A.T. Isso pode estragar o dia de alguém."

#: lang/json/AMMO_from_json.py
msgid "hydrogen canister"
msgid_plural "hydrogen canisters"
msgstr[0] "lata de hidrogênio"
msgstr[1] "latas de hidrogênio"

#. ~ Description for hydrogen canister
#: lang/json/AMMO_from_json.py
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated to plasma."
msgstr ""
"Uma lata de hidrogênio tão comprimido que se tornou sólido. Com o "
"equipamento certo, ele pode ser aquecido até se transformar em plasma."

#: lang/json/AMMO_from_json.py
msgid "mixed smokeless gunpowder"
msgid_plural "mixed smokeless gunpowder"
msgstr[0] "pólvora mista sem combustão"
msgstr[1] "pólvora mista sem combustão"

#. ~ Description for {'str_sp': 'mixed smokeless gunpowder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder, mixed without concern for composition, burn rate "
"or shape.  It has been slightly ground to make its properties more uniform."
"  Only the truly desperate would attempt to reload with this."
msgstr ""
"Pólvora para armamentos, misturada sem que se importasse com a composição, a"
" taxa de queima ou o formato. Ela foi ligeiramente moída para tornar suas "
"propriedades mais uniformes. Somente os verdadeiramente desesperados "
"tentariam recarregar algo com isto."

#: lang/json/AMMO_from_json.py
msgid "smokeless shotgun powder"
msgid_plural "smokeless shotgun powder"
msgstr[0] "pólvora de espingarda sem combustão"
msgstr[1] "pólvora de espingarda sem combustão"

#. ~ Description for {'str_sp': 'smokeless shotgun powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in shotgun shells."
msgstr ""
"Pólvora de qualidade para armamentos, projetada para uso em cartuchos de "
"escopeta."

#: lang/json/AMMO_from_json.py
msgid "smokeless pistol powder"
msgid_plural "smokeless pistol powder"
msgstr[0] "pólvora de pistola sem combustão"
msgstr[1] "pólvora de pistola sem combustão"

#. ~ Description for {'str_sp': 'smokeless pistol powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in pistol ammunition."
msgstr ""
"Pólvora de qualidade para armamentos, projetada para uso em munições de "
"pistola."

#: lang/json/AMMO_from_json.py
msgid "smokeless magnum powder"
msgid_plural "smokeless magnum powder"
msgstr[0] "pólvora de magnum sem combustão"
msgstr[1] "pólvora de magnum sem combustão"

#. ~ Description for {'str_sp': 'smokeless magnum powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder intended for use in magnum pistol ammunition."
msgstr ""
"Pólvora de qualidade para armamentos, projetada para uso em munições de "
"pistolas magnum."

#: lang/json/AMMO_from_json.py
msgid "smokeless rifle powder"
msgid_plural "smokeless rifle powder"
msgstr[0] "pólvora de rifle sem combustão"
msgstr[1] "pólvora de rifle sem combustão"

#. ~ Description for {'str_sp': 'smokeless rifle powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in rifle ammunition."
msgstr ""
"Pólvora de qualidade para armamentos, projetada para uso em munições de "
"rifle."

#: lang/json/AMMO_from_json.py
msgid "smokeless overbore rifle powder"
msgid_plural "smokeless overbore rifle powder"
msgstr[0] "pólvora sem fumaça para rifle"
msgstr[1] "pólvora sem fumaça para rifle"

#. ~ Description for {'str_sp': 'smokeless overbore rifle powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in large rifle ammunition."
msgstr ""
"Pólvora de qualidade para armamentos, projetada para uso em munições de "
"rifles de calibres pesados."

#: lang/json/AMMO_from_json.py
msgid "artillery propellant"
msgid_plural "artillery propellant"
msgstr[0] "propelente de artilharia"
msgstr[1] "propelente de artilharia"

#. ~ Description for {'str_sp': 'artillery propellant'}
#: lang/json/AMMO_from_json.py
msgid ""
"Single base smokeless gunpowder intended for use in artillery propelling "
"charges."
msgstr ""
"Pólvora de base única sem fumaça, projetada para uso em cargas de "
"artilharia."

#: lang/json/AMMO_from_json.py
msgid "oxidizer powder"
msgid_plural "oxidizer powder"
msgstr[0] "pó oxidante"
msgstr[1] "pó oxidante"

#. ~ Description for {'str_sp': 'oxidizer powder'}
#: lang/json/AMMO_from_json.py
msgid "Volatile powdered chemical oxidizer."
msgstr "Oxidante volátil químico em pó."

#: lang/json/AMMO_from_json.py
msgid "lye powder"
msgid_plural "lye powder"
msgstr[0] "soda cáustica em pó"
msgstr[1] "soda cáustica em pó"

#. ~ Description for {'str_sp': 'lye powder'}
#: lang/json/AMMO_from_json.py
msgid "Powdered caustic soda."
msgstr "Soda cáustica em pó."

#: lang/json/AMMO_from_json.py
msgid "shotgun primer"
msgid_plural "shotgun primers"
msgstr[0] "espoleta de espingarda"
msgstr[1] "espoletas de espingarda"

#. ~ Description for shotgun primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a shotgun shell."
msgstr "Espoleta de um cartucho de espingarda."

#: lang/json/AMMO_from_json.py
msgid "small pistol primer"
msgid_plural "small pistol primers"
msgstr[0] "espoleta pequena de pistola"
msgstr[1] "espoletas pequenas de pistola"

#. ~ Description for small pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber pistol round."
msgstr "Espoleta de cartucho de uma pistola de baixo calibre."

#: lang/json/AMMO_from_json.py
msgid "large pistol primer"
msgid_plural "large pistol primers"
msgstr[0] "espoleta grande de pistola"
msgstr[1] "espoletas grandes de pistola"

#. ~ Description for large pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber pistol round."
msgstr "Espoleta de cartucho de uma pistola de alto calibre."

#: lang/json/AMMO_from_json.py
msgid "small rifle primer"
msgid_plural "small rifle primers"
msgstr[0] "espoleta pequena de rifle"
msgstr[1] "espoletas pequenas de rifle"

#. ~ Description for small rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber rifle round."
msgstr "Espoleta para cartucho de um rifle de baixo calibre."

#: lang/json/AMMO_from_json.py
msgid "large rifle primer"
msgid_plural "large rifle primers"
msgstr[0] "espoleta grande de rifle"
msgstr[1] "espoletas grandes de rifle"

#. ~ Description for large rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber rifle round."
msgstr "Espoleta de cartucho de um rifle de alto calibre."

#: lang/json/AMMO_from_json.py
msgid "rubber slug"
msgid_plural "rubber slugs"
msgstr[0] "balaço de borracha"
msgstr[1] "balaços de borracha"

#. ~ Description for rubber slug
#: lang/json/AMMO_from_json.py
msgid ""
"Rubber slugs from a shotgun beanbag round.  You could use them to make new "
"beanbag rounds."
msgstr ""
"Balas de borracha de uma munição não-letal de espingarda. Você pode usar "
"elas para fazer novos cartuchos do mesmo tipo."

#: lang/json/AMMO_from_json.py
msgid "chunk of rubber"
msgid_plural "chunks of rubber"
msgstr[0] "bloco de borracha"
msgstr[1] "blocos de borracha"

#. ~ Description for chunk of rubber
#: lang/json/AMMO_from_json.py
msgid "A chunk of useful rubber, can be molded easily."
msgstr "Um pedaço de borracha útil, que pode ser moldada facilmente."

#: lang/json/AMMO_from_json.py
msgid "copper"
msgid_plural "copper"
msgstr[0] "cobre"
msgstr[1] "cobre"

#. ~ Description for {'str_sp': 'copper'}
#: lang/json/AMMO_from_json.py
msgid ""
"Copper bits.  Could be used to craft something, for example makeshift "
"shotgun shells."
msgstr ""
"Pedaços de cobre. Pode ser usado para fabricar algo, por exemplo munições de"
" espingarda improvisadas."

#: lang/json/AMMO_from_json.py
msgid "medical tape"
msgid_plural "medical tape"
msgstr[0] "fita médica"
msgstr[1] "fita médica"

#. ~ Description for {'str_sp': 'medical tape'}
#: lang/json/AMMO_from_json.py
msgid "A roll of medical tape, similar to duct tape."
msgstr "Um rolo de fita médica, parecido com fita adesiva."

#: lang/json/AMMO_from_json.py
msgid "placeholder ammunition"
msgid_plural "placeholder ammunitions"
msgstr[0] "placeholder de munição"
msgstr[1] "placeholder de munição"

#. ~ Description for placeholder ammunition
#. ~ Description for {'str_sp': 'software'}
#: lang/json/AMMO_from_json.py lang/json/GENERIC_from_json.py
msgid "IF YOU ARE SEEING THIS IT IS A BUG."
msgstr "SE VOCÊ ESTIVER VENDO ISSO, É UM BUG."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "charcoal"
msgid_plural "charcoal"
msgstr[0] "carvão vegetal"
msgstr[1] "carvão vegetal"

#. ~ Description for {'str_sp': 'charcoal'}
#: lang/json/AMMO_from_json.py
msgid ""
"A flammable carbon-based material produced by slowly burning wood.  Utilized"
" in recipes requiring a pure, hot flame.  Can also be used in filters to "
"remove contaminants out of air and water."
msgstr ""
"Material inflamável a base de carbono produzido pela queima lenta da "
"madeira. Utilizado em receitas que requerem uma chama quente e pura. Pode "
"também ser utilizado para remover contaminantes do ar e da água."

#: lang/json/AMMO_from_json.py
msgid "calcium carbide premix"
msgid_plural "calcium carbide premix"
msgstr[0] "pré-mistura de carbeto de cálcio"
msgstr[1] "pré-mistura de carbeto de cálcio"

#. ~ Description for {'str_sp': 'calcium carbide premix'}
#: lang/json/AMMO_from_json.py
msgid ""
"A powdered mixture of coke and lime ready to be smelted into usable calcium "
"carbide in an arc furnace."
msgstr ""
"Uma mistura em pó de coque e cal, pronta para ser transformada em carbeto de"
" cálcio em um forno a arco elétrico."

#: lang/json/AMMO_from_json.py
msgid "coal"
msgid_plural "lumps of coal"
msgstr[0] "pedaço de carvão"
msgstr[1] "pedaços de carvão"

#. ~ Description for coal
#: lang/json/AMMO_from_json.py
msgid ""
"Flammable black chunks of carbon-based material commonly used for cooking "
"and heating."
msgstr ""
" Pedaços pretos inflamáveis de material baseado em carbono, "
"normalmenteutilizado para cozinhar e aquecer."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "albuterol"
msgid_plural "albuterol"
msgstr[0] "albuterol"
msgstr[1] "albuterol"

#. ~ Description for {'str_sp': 'albuterol'}
#: lang/json/AMMO_from_json.py
msgid ""
"A bronchodilator that relaxes muscles in the airways and increases air flow "
"to the lungs."
msgstr ""
"Um bronco-dilatador que relaxa os músculos das vias respiratórias e aumenta "
"o fluxo de ar para os pulmões."

#: lang/json/AMMO_from_json.py
msgid "RA21E medical ampoule"
msgid_plural "RA21E medical ampoules"
msgstr[0] "ampola médica RA21E"
msgstr[1] "ampolas médicas RA21E"

#. ~ Description for RA21E medical ampoule
#: lang/json/AMMO_from_json.py
msgid ""
"A tiny glass vial filled with advanced fast-healing chemicals which can only"
" be activated by a Rivtech jet injector device.  The packaged instructions "
"describe its efficacy in dealing with infections, wounds, intoxications, "
"envenomations, and general tiredness in enthusiastic detail.  A short safety"
" section at the end warn - in much smaller typeface - against using more "
"than two doses per hour."
msgstr ""
"Um pequeno frasco de vidro cheio de químicos de cura rápida avançados que só"
" podem ser ativados por um dispositivo injetor a jato Rivtech. As instruções"
" embaladas descrevem sua eficiência em lidar com infecções, ferimentos, "
"intoxicações, envenenamentos, e cansaço geral em detalhe entusiasmado. Uma "
"curta seção de segurança no fim alerta - em letras muito menores - para não "
"usar mais de duas doses por hora. "

#: lang/json/AMMO_from_json.py
msgid "RA10K stimulant module"
msgid_plural "RA10K stimulant modules"
msgstr[0] "módulo estimulante RA10K"
msgstr[1] "módulos estimulantes RA10K"

#. ~ Description for RA10K stimulant module
#: lang/json/AMMO_from_json.py
msgid ""
"A pressurized multi-chamber glass vial filled with powerful chemical "
"stimulants which can only be activated by a Rivtech stimulant delivery "
"system."
msgstr ""
" Um frasco de vidro de câmara múltipla pressurizado enchido "
"comestimulantesquímicos fortes, podendo ser ativados somente por um "
"sistemainjetor deestimulantes Rivtech."

#: lang/json/AMMO_from_json.py
msgid "rebreather filter cartridge"
msgid_plural "rebreather filter cartridges"
msgstr[0] "cartucho de filtro de rebreather"
msgstr[1] "cartuchos de filtro de rebreather"

#. ~ Description for rebreather filter cartridge
#: lang/json/AMMO_from_json.py
msgid "A replacement filter cartridge for a rebreather."
msgstr "Um cartucho de filtro de reposição para um rebreather."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "filter mask cartridge"
msgid_plural "filter mask cartridges"
msgstr[0] "cartucho de filtro de máscara"
msgstr[1] "cartuchos de filtro de máscara"

#. ~ Description for filter mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Small replacement filter cartridge for air filtration masks."
msgstr ""
" Pequeno cartucho de filtro de reposição para máscaras de filtragem de ar."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "gas mask cartridge"
msgid_plural "gas mask cartridges"
msgstr[0] "cartucho de filtro de máscara de gás"
msgstr[1] "cartuchos de filtro de máscara de gás"

#. ~ Description for gas mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Medium replacement filter cartridge for air filtration masks."
msgstr ""
" Cartucho de filtro tamanho médio de reposição para máscaras de filtragem de"
" ar."

#: lang/json/AMMO_from_json.py
msgid "chemical mask cartridge"
msgid_plural "chemical mask cartridges"
msgstr[0] "cartucho de filtro de máscara química"
msgstr[1] "cartuchos de filtro de máscara química"

#. ~ Description for chemical mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Heavy replacement filter cartridge for air filtration masks."
msgstr ""
" Cartucho de filtro pesado de reposição para máscaras de filtragem de ar."

#: lang/json/AMMO_from_json.py
msgid "nicotine liquid"
msgid_plural "nicotine liquid"
msgstr[0] "líquido de nicotina"
msgstr[1] "líquido de nicotina"

#. ~ Description for {'str_sp': 'nicotine liquid'}
#: lang/json/AMMO_from_json.py
msgid ""
"A liquid that is made up of propylene glycol, vegetable glycerin, "
"flavorings, and nicotine."
msgstr ""
"Um líquido feito de propileno glicol, glicerina vegetal, saborizantes e "
"nicotina."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "fish bait"
msgid_plural "fish bait"
msgstr[0] "isca de peixe"
msgstr[1] "isca de peixe"

#. ~ Description for {'str_sp': 'fish bait'}
#: lang/json/AMMO_from_json.py
msgid "A bait used in traps to lure fish."
msgstr "Uma isca feita para atrair peixes."

#: lang/json/AMMO_from_json.py
msgid "spiked homemade rocket"
msgid_plural "spiked homemade rockets"
msgstr[0] "foguete caseiro com espeto"
msgstr[1] "foguetes caseiros com espetos"

#. ~ Description for spiked homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a spike welded onto a pipe that was "
"filled with improvised rocket fuel.  Horribly inaccurate, as can be expected"
" of this grade of weapon, but packs a fierce punch… if it hits."
msgstr ""
"Um foguete feito à mão, consistindo de um espigão soldado em um cano que foi"
" preenchido com combustível de foguete improvisado. Horrivelmente impreciso,"
" como é de se esperar deste tipo de arma, mas com um impacto devastador... "
"se acertar."

#: lang/json/AMMO_from_json.py
msgid "explosive homemade rocket"
msgid_plural "explosive homemade rockets"
msgstr[0] "foguete caseiro explosivo"
msgstr[1] "foguetes caseiros explosivos"

#. ~ Description for explosive homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a simple explosive warhead attached onto "
"a pipe, filled with improvised rocket fuel.  Not very powerful, but can be "
"made from scratch."
msgstr ""
"Um foguete fabricado à mão, consistindo em uma pequena ogiva explosiva "
"acoplada a um cano, cheio com combustível de foguete improvisado. Não é "
"muito poderoso, mas pode ser feito do zero."

#: lang/json/AMMO_from_json.py
msgid "incendiary homemade rocket"
msgid_plural "incendiary homemade rockets"
msgstr[0] "foguete caseiro incendiário"
msgstr[1] "foguetes caseiros incendiários"

#. ~ Description for incendiary homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a container of flammable gel attached "
"onto a pipe, filled with improvised rocket fuel.  Short-range incendiary - "
"handle with care!"
msgstr ""
"Um foguete feito à mão, consistindo em um recipiente de gel inflamável "
"acoplado a um cano, cheio com combustível de foguete improvisado. "
"Incendiário de curta distância - manuseie com cuidado1"

#: lang/json/AMMO_from_json.py
msgid "unfinished charcoal"
msgid_plural "unfinished charcoal"
msgstr[0] "carvão vegetal incompleto"
msgstr[1] "carvão vegetal incompleto"

#. ~ Description for {'str_sp': 'unfinished charcoal'}
#: lang/json/AMMO_from_json.py
msgid ""
"The result of an interrupted charcoal making process.  Useless, except as "
"fuel in a charcoal kiln."
msgstr ""
" O resultado de uma produção de carvão vegetal interrompida. Inútil, anãoser"
" como combustível para um forno de carvão vegetal."

#: lang/json/AMMO_from_json.py
msgid "unfinished calcium carbide"
msgid_plural "unfinished calcium carbide"
msgstr[0] "carbeto de cálcio incompleto"
msgstr[1] "carbeto de cálcio incompleto"

#. ~ Description for {'str_sp': 'unfinished calcium carbide'}
#: lang/json/AMMO_from_json.py
msgid ""
"The incomplete process of converting coal and lime into calcium carbide.  "
"Useless in this state."
msgstr ""
"O processo incompleto de converter carvão e cal em carbeto de cálcio. Inútil"
" em seu estado atual."

#: lang/json/AMMO_from_json.py
msgid "chain link"
msgid_plural "chain links"
msgstr[0] "elo de corrente"
msgstr[1] "elos de corrente"

#. ~ Description for chain link
#: lang/json/AMMO_from_json.py
msgid "Small metal rings, suitable for constructing chainmail."
msgstr ""
"Pequenos anéis de metal, apropriados para a construção de cota de malha."

#: lang/json/AMMO_from_json.py
msgid "nitrox"
msgid_plural "nitrox"
msgstr[0] "nitrox"
msgstr[1] "nitrox"

#. ~ Description for {'str_sp': 'nitrox'}
#: lang/json/AMMO_from_json.py
msgid "Mixture of oxygen and nitrogen in proportions suitable for diving."
msgstr ""
"Mistura de oxigênio e nitrogênio em proporções próprias para mergulho."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "extinguishing agent"
msgid_plural "extinguishing agent"
msgstr[0] "agente extintor"
msgstr[1] "agente extintor"

#. ~ Description for {'str_sp': 'extinguishing agent'}
#: lang/json/AMMO_from_json.py
msgid "Dry chemical solution effective in extinguishing fires."
msgstr "Solução química seca, útil para extinguir fogos."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "tinder"
msgid_plural "tinder"
msgstr[0] "acendalha"
msgstr[1] "acendalhas"

#. ~ Description for {'str_sp': 'tinder'}
#: lang/json/AMMO_from_json.py
msgid "Flammable material, finely divided for easy combustion."
msgstr ""
"Material inflamável, dividido em pequenas partes para fácil combustão."

#: lang/json/AMMO_from_json.py
msgid "RPG die"
msgid_plural "RPG dice"
msgstr[0] "dado de RPG"
msgstr[1] "dados de RPG"

#. ~ Description for RPG die
#: lang/json/AMMO_from_json.py
msgid "A die used to play various role-playing games."
msgstr "Um dado utilizado para jogar vários jogos de RPG."

#: lang/json/AMMO_from_json.py
msgid "metal RPG die"
msgid_plural "metal RPG dice"
msgstr[0] "dado de metal de RPG"
msgstr[1] "dados de metal de RPG"

#. ~ Description for metal RPG die
#: lang/json/AMMO_from_json.py
msgid "A metal die used to play various role-playing games"
msgstr "Um dado de metal utilizado para jogar vários jogos de RPG."

#: lang/json/AMMO_from_json.py
msgid "bronze"
msgid_plural "bronze"
msgstr[0] "bronze"
msgstr[1] "bronze"

#. ~ Description for {'str_sp': 'bronze'}
#: lang/json/AMMO_from_json.py
msgid "Decent-sized chunks of bronze, for fashioning some old-school items."
msgstr ""
" Pedaços de bronze de um tamanho decente, para confecção de alguns "
"itensàmoda antiga."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "glowstick juice"
msgid_plural "glowstick juice"
msgstr[0] "líquido de bastões de luz"
msgstr[1] "líquido de bastões de luz"

#. ~ Description for {'str_sp': 'glowstick juice'}
#: lang/json/AMMO_from_json.py
msgid ""
"A mix of blue dye, base catalyst, and diphenyl oxalate used in glowsticks."
msgstr ""
"Uma mistura de tinta azul, catalizador, e oxalato de difenil usada em "
"bastões brilhantes sinalizadores."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "graphite"
msgid_plural "graphite"
msgstr[0] "grafite"
msgstr[1] "grafites"

#. ~ Description for {'str_sp': 'graphite'}
#: lang/json/AMMO_from_json.py
msgid ""
"Graphite powder mixed with a clay binder.  Produces grey or black marks that"
" are easily erased, but otherwise resistant to moisture, most chemicals, "
"ultraviolet radiation and natural aging."
msgstr ""
"Pó de grafite misturado com um aglutinante de argila. Produz marcas cinzas "
"ou pretas que são facilmente apagadas, porém resistentes à umidade, maioria "
"dos químicos, radiação ultravioleta e envelhecimento natural."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "black pen ink"
msgid_plural "black pen ink"
msgstr[0] "tinta de caneta preta"
msgstr[1] "tintas de caneta preta"

#. ~ Description for {'str_sp': 'black pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Carbon black pigment infused with polymers, stabilizers and water to help "
"the ink flow properly."
msgstr ""
"Pigmento negro de fumo infundido com polímeros, estabilizantes e água para "
"auxiliar no fluxo de tinta apropriadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "blue pen ink"
msgid_plural "blue pen ink"
msgstr[0] "tinta de caneta azul"
msgstr[1] "tintas de caneta azul"

#. ~ Description for {'str_sp': 'blue pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Prussian blue, crystal violet and phthalocyanine blue pigments infused with "
"polymers, stabilizers and water to help the ink flow properly."
msgstr ""
"Azul prussiano, violeta cristalizada e pigmentos azuls de ftalocianina "
"infundidos com polímeros, estabilizantes e água para auxiliar no fluxo de "
"tinta apropriadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "green pen ink"
msgid_plural "green pen ink"
msgstr[0] "tinta de caneta verde"
msgstr[1] "tintas de caneta verde"

#. ~ Description for {'str_sp': 'green pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Chlorophyll pigment infused with polymers, stabilizers and water to help the"
" ink flow properly."
msgstr ""
"Pigmento de clorofila infundido com polímeros, estabilizantes e água para "
"auxiliar no fluxo de tinta apropriadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "red pen ink"
msgid_plural "red pen ink"
msgstr[0] "tinta de caneta vermelha"
msgstr[1] "tintas de caneta vermelhas"

#. ~ Description for {'str_sp': 'red pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Eosin dye infused with polymers, stabilizers and water to help the ink flow "
"properly."
msgstr ""
"Corante de eosina infundidos com polímeros, estabilizantes e água para "
"auxiliar no fluxo de tinta apropriadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "anesthetic"
msgid_plural "anesthetics"
msgstr[0] "anestésico"
msgstr[1] "anestésico"

#. ~ Description for anesthetic
#: lang/json/AMMO_from_json.py
msgid ""
"A variety of powerful hypnotic, analgesic, and stimulative drugs.  It's "
"intended for use in specialized medical equipment, and can't be administered"
" manually.  You can reload an anesthesia kit with it."
msgstr ""
"Uma variedade potente de drogas hipnóticas, analgésicas e estimulantes. "
"Projetado para uso em equipamento médico especializado, e não pode ser "
"administrado manualmente. Você pode recarregar um kit de anestesia com isso."

#: lang/json/AMMO_from_json.py
msgid "sulfur"
msgid_plural "sulfur"
msgstr[0] "enxofre"
msgstr[1] "enxofre"

#. ~ Description for {'str_sp': 'sulfur'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of pure sulfur.  Primarily used to make battery acid, sulfur is "
"sometimes used as fuel for explosives.  Can be burned to produce acidic "
"smoke that is deadly to bacteria and humans alike, or oxidized to make "
"paper-bleaching agents."
msgstr ""
"Um punhado de puro enxofre. Primariamente utilizado para fazer ácido de "
"bateria, enxofre é por vezes utilizado como combustível para explosivos. "
"Pode ser queimado para produzir fumaça acídica letal para bactérias e seres "
"humanos igualmente, ou oxidado para fazer agentes branqueadores de papel. "

#: lang/json/AMMO_from_json.py
msgid "chunk of sulfur"
msgid_plural "chunks of sulfur"
msgstr[0] "pedaço de enxofre"
msgstr[1] "pedaços de enxofre"

#. ~ Description for chunk of sulfur
#: lang/json/AMMO_from_json.py
msgid "A chunk of pure sulfur.  Break it up to use it."
msgstr "Um bloco de enxofre puro. Quebre-o em pedaços menores para utilizar."

#: lang/json/AMMO_from_json.py
msgid "cement"
msgid_plural "cement"
msgstr[0] "cimento"
msgstr[1] "cimento"

#. ~ Description for {'str_sp': 'cement'}
#: lang/json/AMMO_from_json.py
msgid ""
"Portland is most likely long gone, but its memory persists in cement.  This "
"ubiquitous binder can be used for all kinds of advanced masonry.  Just add "
"water."
msgstr ""
" Portland provavelmente já se foi, mas sua memória persiste no cimento. Este"
" produto universal pode ser usado para qualquer tipo de alvenaria avançada. "
"É só adicionar água."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "gravel"
msgid_plural "gravel"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'gravel'}
#: lang/json/AMMO_from_json.py
msgid "A handful of gravel, smaller than pebbles but larger than sand."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "limestone"
msgid_plural "limestone"
msgstr[0] "calcário"
msgstr[1] "calcário"

#. ~ Description for {'str_sp': 'limestone'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of small chunks of limestone.  Useful for experiments at science "
"fairs, but pretty useless as ammo.  Maybe something could be crafted from "
"this stuff…"
msgstr ""
" Um punhado de pequenos pedaços de calcário. Útil para projetos em uma feira"
" de ciências, mas inútil como munição. Talvez você possa construir algo com "
"isso..."

#: lang/json/AMMO_from_json.py
msgid "quicklime"
msgid_plural "quicklime"
msgstr[0] "cal viva"
msgstr[1] "cal viva"

#. ~ Description for {'str_sp': 'quicklime'}
#: lang/json/AMMO_from_json.py
msgid ""
"The product of burning limestone, this white powder is a crucial ingredient "
"in making cement.  That said, it is also extremely caustic and will cause "
"severe burns to any tissue it comes in contact with.  This property could "
"probably be exploited."
msgstr ""
"O produto da queima de calcário, este pó branco é um ingrediente crucial na "
"fabricação de cimento. Dito isto, também é extremamente cáustico, e causará "
"queimaduras graves a qualquer tecido com o qual entre em contato. Essa "
"propriedade provavelmente poderia ser explorada."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "sand"
msgid_plural "sand"
msgstr[0] "areia"
msgstr[1] "areia"

#. ~ Description for {'str_sp': 'sand'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of New England sand.  If you had a stoked furnace, you could turn "
"it into glass.  Otherwise, it's only good for making cement."
msgstr ""
"Um punhado de areia da Nova Inglaterra. Se você tivesse uma fornalha acesa, "
"talvez pudesse transformar isso em vidro. Fora isso, só é bom para fazer "
"cimento."

#: lang/json/AMMO_from_json.py
msgid "soil"
msgid_plural "soil"
msgstr[0] "terra"
msgstr[1] "terra"

#. ~ Description for {'str_sp': 'soil'}
#: lang/json/AMMO_from_json.py
msgid ""
"A pile of loosely-packed, slightly damp loamy soil.  This mixture of sand, "
"silt and clay is ideal for growing plants."
msgstr ""
"Uma pilha solta de solo úmido levemente enlameado. Esta mistura de areia, "
"lodo e lama é ideal para plantar."

#: lang/json/AMMO_from_json.py
msgid "aluminum powder"
msgid_plural "aluminum powder"
msgstr[0] "pó de alumínio"
msgstr[1] "pó de alumínio"

#. ~ Description for {'str_sp': 'aluminum powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of finely-ground aluminum powder.  This strong reducing agent was "
"used in combination with various oxidants for chemical welding and "
"explosives alike.  Just before the Cataclysm, however, it was the basis of "
"virtually all commercial metallic-hued paints and anti-corrosive coatings."
msgstr ""
"Um punhado de pó de alumínio moído finamente. Este forte agente redutor era "
"utilizado em combinação com vários oxidantes para solda química e explosivos"
" igualmente. Porém, logo antes do Cataclisma, era a base de virtualmente "
"todas as tintas de tons metálicos e revestimentos anti-corrosivos."

#: lang/json/AMMO_from_json.py
msgid "zinc powder"
msgid_plural "zinc powder"
msgstr[0] "pó de zinco"
msgstr[1] "pó de zinco"

#. ~ Description for {'str_sp': 'zinc powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of zinc powder.  While commercially used mostly in cosmetics and "
"for paints, hobbyists used to mix it with sulfur to make basic rocket fuel "
"or a smokescreen.  When treated with a strong acid, it will produce "
"hydrogen."
msgstr ""
"Um punhado de zinco em pó. Embora comercialmente utilizado principalmente em"
" cosméticos e tintas, hobistas costumavam misturar com enxofre para fazer "
"combustível de foguete básico ou uma cortina de fumaça. Quando tratada com "
"um ácido forte, produz hidrogênio."

#: lang/json/AMMO_from_json.py
msgid "zinc oxide"
msgid_plural "zinc oxide"
msgstr[0] "óxido de zinco"
msgstr[1] "óxido de zinco"

#. ~ Description for {'str_sp': 'zinc oxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of zinc oxide.  It can be reduced into zinc, or used for some "
"other reactions of its own."
msgstr ""
"Um punhado de óxido de zinco. Pode ser reduzido para se obter zinco, ou "
"utilizado por si só em algumas outras reações."

#: lang/json/AMMO_from_json.py
msgid "manganese dioxide"
msgid_plural "manganese dioxide"
msgstr[0] "dióxido de manganês"
msgstr[1] "dióxido de manganês"

#. ~ Description for {'str_sp': 'manganese dioxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of manganese dioxide powder.  Occurring naturally in the mineral "
"pyrolusite, it is used commercially in the production of alkaline and zinc-"
"carbon batteries."
msgstr ""
"Um punhado de pó de dióxido de manganês. Ocorre naturalmente no mineral "
"pirolusita, e é usado na produção comercial de baterias alcalinas e de "
"zinco-carbono."

#: lang/json/AMMO_from_json.py
msgid "potassium chloride"
msgid_plural "potassium chloride"
msgstr[0] "cloreto de potássio"
msgstr[1] "cloreto de potássio"

#. ~ Description for {'str_sp': 'potassium chloride'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of potassium chloride.  Although it occurs naturally in the "
"mineral sylvite, it can be produced as a byproduct of the reaction of "
"saltpeter and hydrochloric acid.  It can be used for making fertilizer, or "
"potassium hydroxide by way of electrolysis."
msgstr ""
"Um punhado de cloreto de potássio. Ocorre naturalmente no mineral silvita, e"
" pode ser criado como subproduto da reação de salitre e ácido hidroclórico. "
"Pode ser usado para fazer fertilizante, ou processado através de eletrólise "
"para criar hidróxido de potássio."

#: lang/json/AMMO_from_json.py
msgid "potassium hydroxide"
msgid_plural "potassium hydroxide"
msgstr[0] "hidróxido de potássio"
msgstr[1] "hidróxido de potássio"

#. ~ Description for {'str_sp': 'potassium hydroxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of potassium hydroxide.  Commonly called caustic potash, it was "
"mainly used industrially for its caustic nature.  It can be used as an "
"electrolyte in alkaline batteries, among other applications."
msgstr ""
"Um punhado de hidróxido de potássio. Comumente chamado de potassa cáustica, "
"era principalmente utilizado industrialmente devido às suas propriedades "
"cáusticas. Pode ser usado como eletrólito em baterias alcalinas, entre "
"outras coisas."

#: lang/json/AMMO_from_json.py
msgid "acetone"
msgid_plural "acetone"
msgstr[0] "acetona"
msgstr[1] "acetona"

#. ~ Description for {'str_sp': 'acetone'}
#: lang/json/AMMO_from_json.py
msgid ""
"Acetone, best known as the primary constituent of most nail polish removers."
"  Flammable, and can be easily used for potent home-made explosives, as "
"demonstrated by the terrorist attacks of 2016."
msgstr ""
"Acetona, melhor conhecido como o constituinte primário da maioria dos "
"removedores de esmalte. Inflamável, e pode ser facilmente utilizado para "
"explosivos caseiros potentes, conforme demonstrado pelos ataques terroristas"
" de 2016."

#: lang/json/AMMO_from_json.py
msgid "chromium oxide"
msgid_plural "chromium oxide"
msgstr[0] "óxido de cromo"
msgstr[1] "óxido de cromo"

#. ~ Description for {'str_sp': 'chromium oxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of chromium oxide.  This substance, typically known as the only "
"stable green pigment for paints, is also a mild oxidizer, which can be mixed"
" with aluminum powder to make thermite for welding.  If one had access to a "
"CVD machine and a laboratory worth of reagents, they might be able to "
"produce very durable ceramic layers."
msgstr ""
"Um punhado de óxido de cromo. Esta substância, tipicamente conhecida como o "
"único pigmento verde estável para tintas, também é um oxidante leve, que "
"pode ser misturado com pó de alumínio para fazer termite para soldas. Se "
"você possuir acesso a uma máquina de deposição química em fase de vapor, e "
"um laboratório inteiro de reagentes, você poderia produzir camadas de "
"cerâmica extremamente resistentes."

#: lang/json/AMMO_from_json.py
msgid "calcium carbide"
msgid_plural "calcium carbide"
msgstr[0] "carbeto de cálcio"
msgstr[1] "carbeto de cálcio"

#. ~ Description for {'str_sp': 'calcium carbide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of calcium carbide, giving off a faint, garlic-like smell.  "
"Commercially, calcium carbide was used for on-the-spot manufacture of "
"acetylene and historically to power acetylene lamps.  If mixed with water "
"and sealed, it will explode with little strength, but with relatively loud "
"noise and could maybe be used as a decoy."
msgstr ""
"Um punhado de carbeto de cálcio, com um leve cheiro de alho. Comercialmente,"
" era usado para a criação de acetileno e, historicamente, como combustível "
"em lâmpadas de acetileno. Se misturado com água e selado, vai explodir com "
"pouca força, mas com um ruído relativamente alto, possivelmente útil na "
"criação de distrações."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "hexamine"
msgid_plural "hexamine"
msgstr[0] "hexamina"
msgstr[1] "hexamina"

#. ~ Description for {'str_sp': 'hexamine'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of waxy hexamine tablets.  This ubiquitous fuel was used to start "
"up almost every garden grill, and no 'real' camping trip could do its "
"cooking without it, until the Cataclysm.  Nowadays, it is even more valuable"
" than before, being the key component in the preparation of several "
"military-grade explosives."
msgstr ""
"Um punhado de tabletes de hexamina encerados. Este combustível ubíquo era "
"utilizado para iniciar quase toda grelha de jardim, e nenhum acampamento "
"\"real\" conseguia cozinhar sem isto, até o Cataclisma. Hoje em dia, é ainda"
" mais valiosa que antes, sendo o componente chave na preparação de diversos "
"explosivos de nível militar."

#: lang/json/AMMO_from_json.py
msgid "hydrogen peroxide (concentrated)"
msgid_plural "hydrogen peroxide (concentrated)"
msgstr[0] "peróxido de hidrogênio (concentrado)"
msgstr[1] "peróxido de hidrogênio (concentrado)"

#. ~ Description for {'str_sp': 'hydrogen peroxide (concentrated)'}
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated hydrogen peroxide is a powerful oxidant, violently decomposing "
"in contact with most reducing agents.  Can be used as rocket fuel or to make"
" high explosives.  Causes severe burns to any organic matter and may ignite "
"it on contact."
msgstr ""
" Peróxido de de hidrogênio concentrado é um oxidante poderoso, decompondo- "
"seviolentamente em contato com a maioria dos agentes redutores. Podeserusado"
" como combustível de foguete ou para fazer altos explosivos. "
"Provocaqueimaduras graves em qualquer matéria orgânica e pode incendiá- "
"laaocontato."

#: lang/json/AMMO_from_json.py
msgid "ammonium nitrate"
msgid_plural "ammonium nitrate"
msgstr[0] "nitrato de amônio"
msgstr[1] "nitrato de amônio"

#. ~ Description for {'str_sp': 'ammonium nitrate'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some ammonium nitrate.  This white, crystalline powder is commonly used as a"
" component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Algum nitrato de amônio. Este pó branco e cristalino é comumente utilizado "
"como componente em fertilizantes e explosivos. Poderia também ser dissolvido"
" em água para baixar sua temperatura bruscamente, mas há algum uso para esta"
" qualidade neste novo mundo?"

#: lang/json/AMMO_from_json.py
msgid "ammonium nitrate pellets"
msgid_plural "ammonium nitrate pellets"
msgstr[0] "pelotas de nitrato de amônio"
msgstr[1] "pelotas de nitrato de amônio"

#. ~ Description for {'str_sp': 'ammonium nitrate pellets'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some ammonium nitrate pellets.  These pellets are commonly used as a "
"component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Algumas pelotas de nitrato de amônio. Estas pelotas são comumente utilizadas"
" como componente em fertilizantes e explosivos. Poderia também ser "
"dissolvido em água para baixar sua temperatura bruscamente, mas há algum uso"
" para esta qualidade neste novo mundo?"

#: lang/json/AMMO_from_json.py
msgid "saltpeter"
msgid_plural "saltpeter"
msgstr[0] "salitre"
msgstr[1] "salitre"

#. ~ Description for {'str_sp': 'saltpeter'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of saltpeter.  Sometimes used as a fertilizer, this ubiquitous "
"nitrate is the principal constituent of black gunpowder and simple rocket "
"propellants, such as rocket candy."
msgstr ""
"Um punhado de salitre. Às vezes usado como fertilizante, esse nitrato "
"onipresente é o principal constituinte da pólvora negra e dos propelentes de"
" foguetes simples, como foguetes doces."

#: lang/json/AMMO_from_json.py
msgid "niter"
msgid_plural "niter"
msgstr[0] "nitro"
msgstr[1] "nitro"

#. ~ Description for {'str_sp': 'niter'}
#: lang/json/AMMO_from_json.py
msgid ""
"A large crystal of niter, the mineral form of potassium nitrate.  It can be "
"processed into saltpeter."
msgstr ""
"Um grande cristal de nitro, a forma mineral de nitrato de potássio. Pode ser"
" processado para se obter salitre."

#: lang/json/AMMO_from_json.py
msgid "aluminum sulfate"
msgid_plural "aluminum sulfate"
msgstr[0] "sulfato de alumínio"
msgstr[1] "sulfato de alumínio"

#. ~ Description for {'str_sp': 'aluminum sulfate'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several crystals of aluminum sulfate.  Historically, an agent for purifying "
"water and as molluscicide, due to the fact that it degenerates their slime."
"  Just before the Cataclysm, its main uses were for adjusting the acidity of"
" the soil and as an additive to baking powder.  If mixed with a strong acid,"
" it could be used to saturate the soil with aluminum, causing all but the "
"most resistant of plants to wither and die."
msgstr ""
"Vários cristais de sulfato de alumínio. Historicamente, um agente para "
"purificar a água e como moluscicida, por degenerar seu muco. Pouco antes do "
"Cataclismo, seus principais usos eram para ajustar a acidez do solo e como "
"um aditivo ao fermento em pó. Se misturado com um ácido forte, ele poderia "
"ser usado para saturar o solo com alumínio, fazendo com que todas as "
"plantas, com exceção das mais resistentes, murchassem e morressem."

#: lang/json/AMMO_from_json.py
msgid "acetic acid"
msgid_plural "acetic acid"
msgstr[0] "ácido acético"
msgstr[1] "ácido acético"

#. ~ Description for {'str_sp': 'acetic acid'}
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated acetic acid, typically used as a chemical reagent and "
"antifungal agent.  Despite its horrid smell, it was used to prepare several "
"types of perfumes, but would making perfume not be too fancy for "
"postapocalyptic New England?"
msgstr ""
"Ácido acético concentrado, tipicamente usado como reagente químico e agente "
"fungicida. Apesar de seu cheiro horrível, já foi usado no preparo de muitos "
"tipos de perfumes, mas a perfumaria não seria luxuosa demais para a Nova "
"Inglaterra pós-apocalíptica?"

#: lang/json/AMMO_from_json.py
msgid "formaldehyde"
msgid_plural "formaldehyde"
msgstr[0] "formaldeído"
msgstr[1] "formaldeído"

#. ~ Description for {'str_sp': 'formaldehyde'}
#: lang/json/AMMO_from_json.py
msgid ""
"Formaldehyde, here dissolved in water, was widely used before the Cataclysm "
"as a precursor to production of many chemicals and materials and as an "
"embalming agent.  Easily identifiable by its pungent odor.  Terribly toxic, "
"carcinogenic, and volatile."
msgstr ""
"O formaldeído, aqui dissolvido em água, foi amplamente utilizado antes do "
"Cataclismo como precursor da produção de muitos produtos químicos e "
"materiais e como agente de embalsamamento. Facilmente identificável pelo seu"
" odor pungente. Terrivelmente tóxico, cancerígeno, e volátil."

#: lang/json/AMMO_from_json.py
msgid "thermite"
msgid_plural "thermite"
msgstr[0] "termite"
msgstr[1] "termite"

#. ~ Description for {'str_sp': 'thermite'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of silvery-greenish powder, produced by mixing aluminum and "
"chromium oxide.  This mixture, burning at a constant pace and at extremely "
"high temperature, was once used for on-the-spot welding.  Can be used as an "
"incendiary material in a pinch."
msgstr ""
"Um punhado de pó esverdeado-prateado, produzido pela mistura de alumínio e "
"óxido de cromo. Esta mistura, queimando a um ritmo constante e a uma "
"temperatura extremamente alta, já foi usada para soldagem. Pode ser usado "
"como um material incendiário em caso de aperto."

#: lang/json/AMMO_from_json.py
msgid "ANFO"
msgid_plural "ANFO"
msgstr[0] "ANFO"
msgstr[1] "ANFO"

#. ~ Description for {'str_sp': 'ANFO'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several brownish pellets that were made by allowing ammonium nitrate to "
"absorb an organic fuel.  This ammonium nitrate/fuel oil mixture, or ANFO, is"
" a common industrial explosive due to its stability and low price.  Burns "
"fast, but needs an explosive primer to detonate."
msgstr ""
"Diversas pelotas acastanhadas que foram feitas por permitir nitrato de "
"amônio absorver um combustível orgânico. Este nitrato de amônio/mistura de "
"combustível óleo, ou ANFO, é um explosivo industrial comum devido à sua "
"estabilidade e baixo custo. Queima rápido, mas precisa de uma base explosiva"
" para detonar."

#: lang/json/AMMO_from_json.py
msgid "black gunpowder"
msgid_plural "black gunpowder"
msgstr[0] "pólvora negra"
msgstr[1] "pólvora negra"

#. ~ Description for {'str_sp': 'black gunpowder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of black gunpowder, a mix of saltpeter, charcoal and sulfur.  "
"Pretty useless for making modern cartridges, as the soot produced when it "
"burns will quickly clog any firearm, but it could be used to make some "
"vicious bombs."
msgstr ""
"Um punhado de pólvora negra, uma mistura de salitre, carvão vegetal e "
"enxofre. Bastante inútil para produção de cartuchos modernos, visto que a "
"fuligem produzida quando queima rapidamente entope qualquer arma de fogo, "
"mas pode ser utilizado para fazer algumas bombas viciosas."

#: lang/json/AMMO_from_json.py
msgid "match head powder"
msgid_plural "match head powder"
msgstr[0] "pó de cabeças de fósforos"
msgstr[1] "pó de cabeças de fósforos"

#. ~ Description for {'str_sp': 'match head powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some match head powder from match heads, similar to black gunpowder but a "
"bit weaker.  It can be used in crafting explosives and fuses when other, "
"more suitable candidates are less available."
msgstr ""
"Algum pó de cabeça de fósforo, similar à pólvora negra mas um pouco mais "
"fraco. Pode ser utilizado na fabricação de explosivos e fusíveis quando "
"outros candidatos mais apropriados estiverem menos disponíveis."

#: lang/json/AMMO_from_json.py
msgid "RDX"
msgid_plural "RDX"
msgstr[0] "RDX"
msgstr[1] "RDX"

#. ~ Description for {'str_sp': 'RDX'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several off-white crystals of RDX, or hexogen: a military-grade, shelf-"
"stable high explosive.  Can be cast into shaped charges, or mixed with scrap"
" to pepper the blast area with high-velocity shrapnel."
msgstr ""
"Diversos cristais enbranquiçados de RDX, ou hexogeno: um alto explosivo de "
"nível militar, de alta durabilidade. Pode ser fundido em diversas cargas, ou"
" misturado com sucata para salpicar a área de explosão com estilhaços de "
"alta velocidade."

#: lang/json/AMMO_from_json.py
msgid "composition b"
msgid_plural "composition b"
msgstr[0] "composição b"
msgstr[1] "composições b"

#. ~ Description for {'str_sp': 'composition b'}
#: lang/json/AMMO_from_json.py
msgid ""
"Composition B is an explosive consisting of castable mixtures of RDX and "
"TNT.  It is used as the main explosive filling in artillery projectiles, "
"rockets, land mines, hand grenades and various other munitions."
msgstr ""
"Composição B é um explosivo consistindo em misturadas fundíveis de RDX e "
"TNT. É utilizado como o enchimento explosivo principal em projéteis de "
"artilharia, foguetes, minas terrestres, granadas de mão e diversas outras "
"munições. "

#: lang/json/AMMO_from_json.py
msgid "HMTD"
msgid_plural "HMTD"
msgstr[0] "HMTD"
msgstr[1] "HMTD"

#. ~ Description for {'str_sp': 'HMTD'}
#: lang/json/AMMO_from_json.py
msgid ""
"Hexamine peroxide: this fine, yellowish powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, but best not store it for too long."
msgstr ""
"Peróxido de hexamina: este fino pó amarelado é um poderoso explosivo "
"primário, usado para iniciar a detonação de explosivos mais estáveis, como "
"RDX. Relativamente estável, mas é melhor não guardar por muito tempo."

#: lang/json/AMMO_from_json.py
msgid "APEX"
msgid_plural "APEX"
msgstr[0] "APEX"
msgstr[1] "APEX"

#. ~ Description for {'str_sp': 'APEX'}
#: lang/json/AMMO_from_json.py
msgid ""
"Acetone peroxide: this fine, white crystalline powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, with a fruit like smell when pure."
msgstr ""
"Peróxido de acetona: este fino, branco e cristalino pó branco é um explosivo"
" primário poderoso, utilizado para iniciar detonação de explosivos mais "
"estáveis, como RDX. Relativamente estável, com um cheiro frutoso quando "
"puro."

#: lang/json/AMMO_from_json.py
msgid "improvised rocket fuel"
msgid_plural "improvised rocket fuel"
msgstr[0] "combustível de foguete improvisado"
msgstr[1] "combustível de foguete improvisado"

#. ~ Description for {'str_sp': 'improvised rocket fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A chunk of a zinc powder and sulfur mixture, bound together by superglue, "
"that can be used as an impromptu rocket fuel."
msgstr ""
"Um bloco de pó de zinco e enxofre misturados, ligados por super cola, que "
"pode ser usado como um combustível de foguete improvisado."

#: lang/json/AMMO_from_json.py
msgid "detergent"
msgid_plural "detergent"
msgstr[0] "detergente"
msgstr[1] "detergente"

#. ~ Description for {'str_sp': 'detergent'}
#: lang/json/AMMO_from_json.py
msgid "A popular pre-Cataclysm washing powder."
msgstr "Um pó de lavagem popular no pré-Cataclismo."

#: lang/json/AMMO_from_json.py
msgid "soap flakes"
msgid_plural "soap flakes"
msgstr[0] "flocos de sabão"
msgstr[1] "flocos de sabão"

#. ~ Description for {'str_sp': 'soap flakes'}
#: lang/json/AMMO_from_json.py
msgid "A bar of soap cut into flakes suitable for use in a washing machine."
msgstr ""
"Uma barra de sabão cortada em pedaços próprios para uso em uma máquina de "
"lavar."

#: lang/json/AMMO_from_json.py
msgid "nanomaterial canister"
msgid_plural "nanomaterial canisters"
msgstr[0] "lata de nano-material "
msgstr[1] "latas de nano-material "

#. ~ Description for nanomaterial canister
#: lang/json/AMMO_from_json.py
msgid ""
"Steel canisters containing carbon, iron, titanium, copper and other elements"
" in specifically engineered atomic-scale configurations.  A nanofabricator "
"can assemble them into usable items."
msgstr ""
"Recipientes de caço contendo carbono, ferro, titânio, cobre e outros "
"elementos em configurações de escala atômica especificamente projetados. Um "
"nanofabricador pode montá-los em itens utilizáveis."

#: lang/json/AMMO_from_json.py
msgid "wood ash"
msgid_plural "wood ashes"
msgstr[0] "cinza de madeira"
msgstr[1] "cinzas de madeira"

#. ~ Description for wood ash
#: lang/json/AMMO_from_json.py
msgid ""
"This is almost-weightless residue left after the burning of some substance."
msgstr ""
"Isto é resíduo quase sem peso que restou após a queima de alguma substância."

#: lang/json/AMMO_from_json.py
msgid "wooden bead"
msgid_plural "wooden beads"
msgstr[0] "conta de madeira"
msgstr[1] "contas de madeira"

#. ~ Description for wooden bead
#: lang/json/AMMO_from_json.py
msgid ""
"This is a wooden bead.  It can be used to craft inscribable jewelry or "
"create a beaded curtain door."
msgstr ""
"Uma conta de madeira. Pode ser usada para criar joalheria ou criar uma porta"
" de cortina de contas."

#: lang/json/AMMO_from_json.py
msgid "rosin"
msgid_plural "rosins"
msgstr[0] "rosina"
msgstr[1] "rosina"

#. ~ Description for rosin
#: lang/json/AMMO_from_json.py
msgid "This is a chunk of yellowish rosin, usable as a flux for soldering."
msgstr "Um pedaço de breu amarelado, usado como fundente para solda."

#: lang/json/AMMO_from_json.py
msgid "concentrated venom"
msgid_plural "concentrated venom"
msgstr[0] "veneno concentrado"
msgstr[1] "veneno concentrado"

#. ~ Description for {'str_sp': 'concentrated venom'}
#: lang/json/AMMO_from_json.py
msgid ""
"A transparent, lightly greenish liquid, refined from the venom of bees and "
"wasps.  Active ingredients include (nor-)adrenaline, dopamine, histamine and"
" protein toxins.  It is now relatively stable, but will require further "
"separation to be useful for anything other than killing you."
msgstr ""
"Um líquido transparente e levemente esverdeado, refinado da peçonha de "
"abelhas e vespas. Os ingredientes ativos incluem (nor-)adrenalina, dopamina,"
" histamina e proteínas tóxicas. Foi estabilizado, mas ainda precisa de mais "
"separação antes de ser útil para qualquer coisa que não seja te matar."

#: lang/json/AMMO_from_json.py
msgid "concentrated paralytic"
msgid_plural "concentrated paralytic"
msgstr[0] "paralítico concentrado"
msgstr[1] "paralítico concentrado"

#. ~ Description for {'str_sp': 'concentrated paralytic'}
#: lang/json/AMMO_from_json.py
msgid ""
"The concentrated paralytic agent, originally from a triffid.  Given your "
"experience with its effects (chiefly gathered while sourcing this batch) and"
" their striking similarity to earthly flora, you figure it's related to "
"curarines.  Might come in handy in crafting more useful things."
msgstr ""
"O agente paralizante concentrado, originalmente de um trifídeo. Dada sua "
"experiência com seus efeitos (especialmente adquirida enquanto abastecia "
"este lote) e sua similaridade marcante com a flora terreste, você deduz que "
"é relacionado a curarinas. Pode vir a calhar para a fabricação de coisas "
"mais úteis."

#: lang/json/AMMO_from_json.py
msgid "rocuronium"
msgid_plural "rocuronium"
msgstr[0] "rocurônio"
msgstr[1] "rocurônio"

#. ~ Description for {'str_sp': 'rocuronium'}
#: lang/json/AMMO_from_json.py
msgid ""
"Rocuronium bromide, a fast-acting muscle relaxant.  Used primarily in "
"emergency medicine because of its relative stability, it can serve as a "
"component of a balanced anesthesia in a pinch."
msgstr ""
"Brometo de rocurônio, um relaxante muscular de ação rápida. Usado "
"principalmente em tratamentos de emergência devido à sua relativa "
"estabilidade, pode servir como componente de um anestésico balanceado, caso "
"não haja coisa melhor."

#: lang/json/AMMO_from_json.py
msgid "ethanol"
msgid_plural "ethanol"
msgstr[0] "etanol"
msgstr[1] "etanol"

#. ~ Description for {'str_sp': 'ethanol'}
#: lang/json/AMMO_from_json.py
msgid ""
"Extremely pure alcohol suitable for use as a component in chemical "
"reactions.  You could also water it down and drink it, or use it as fuel in "
"alcohol-burning stoves."
msgstr ""
"Álcool extremamente puro usado como um componente em reações químicas. "
"Também pode ser diluído e bebido, ou usado como combustível em fogões a "
"álcool."

#: lang/json/AMMO_from_json.py
msgid "denatured alcohol"
msgid_plural "denatured alcohols"
msgstr[0] "álcool desnaturado"
msgstr[1] "álcool desnaturado"

#. ~ Description for denatured alcohol
#: lang/json/AMMO_from_json.py
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr ""
"Uma solução de etanol muito forte misturada com metanol para torná-la "
"tóxica, para prevenir regulamentos pré-apocalípticos ao etanol. É usada em "
"fogões à álcool ou como um solvente."

#: lang/json/AMMO_from_json.py
msgid "methanol"
msgid_plural "methanol"
msgstr[0] "metanol"
msgstr[1] "metanol"

#. ~ Description for {'str_sp': 'methanol'}
#: lang/json/AMMO_from_json.py
msgid ""
"High purity methanol suitable for use in chemical reactions.  Could be used "
"in alcohol-burning stoves.  Very toxic."
msgstr ""
"Metanol de alta pureza adequado para uso em reações químicas. Pode ser usado"
" em fogões à álcool. Muito tóxico."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
#: src/iexamine.cpp
msgid "diesel"
msgid_plural "diesel"
msgstr[0] "diesel"
msgstr[1] "diesel"

#. ~ Description for {'str_sp': 'diesel'}
#: lang/json/AMMO_from_json.py
msgid ""
"Petroleum-based fuel made from a byproduct of the gasoline making process."
msgstr ""
"Combustível à base de petróleo, feito a partir de um subproduto do processo "
"de fabricação de gasolina."

#: lang/json/AMMO_from_json.py
msgid "JP8 fuel"
msgid_plural "JP8 fuel"
msgstr[0] "combustível JP8"
msgstr[1] "combustível JP8"

#. ~ Description for {'str_sp': 'JP8 fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A kerosene-based fuel used mainly by US military vehicles as a replacement "
"for diesel and jet fuel, to simplify logistics."
msgstr ""
"Um combustível baseado em querosene, usado principalmente por veículos "
"militares dos Estados Unidos como substituto de diesel e combustível de "
"jatos, para simplificar a logística."

#: lang/json/AMMO_from_json.py lang/json/material_from_json.py
msgid "avgas fuel"
msgid_plural "avgas fuel"
msgstr[0] "gasolina de aviação"
msgstr[1] "gasolina de aviação"

#. ~ Description for {'str_sp': 'avgas fuel'}
#: lang/json/AMMO_from_json.py
msgid "A specialized type of petroleum-based fuel used to power aircraft."
msgstr ""
"Um tipo especializado de combustível baseado em petróleo usado para "
"alimentar aviões"

#: lang/json/AMMO_from_json.py
msgid "biodiesel"
msgid_plural "biodiesel"
msgstr[0] "biodisel"
msgstr[1] "biodiesel"

#. ~ Description for {'str_sp': 'biodiesel'}
#: lang/json/AMMO_from_json.py
msgid ""
"Vegetable oil- or animal fat-based diesel fuel consisting of long-chain "
"alkyl (methyl, ethyl, or propyl) esters."
msgstr ""
"Combustível diesel à base de óleo vegetal ou gordura animal, consistindo de "
"ésteres alquílicos (metila, etila ou propila)."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
#: src/iexamine.cpp
msgid "gasoline"
msgid_plural "gasoline"
msgstr[0] "gasolina"
msgstr[1] "gasolina"

#. ~ Description for {'str_sp': 'gasoline'}
#: lang/json/AMMO_from_json.py
msgid ""
"Gasoline is a highly flammable liquid.  When under pressure, it has the "
"potential for violent explosion."
msgstr ""
" Gasolina é um liquido altamemte inflamável.  Quando sobre pressão, "
"elapossui um potencial para explosões violentas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "lamp oil"
msgid_plural "lamp oil"
msgstr[0] "óleo de lamparina"
msgstr[1] "óleo de lamparina"

#. ~ Description for {'str_sp': 'lamp oil'}
#: lang/json/AMMO_from_json.py
msgid "A thin and clean-burning oil made for use in oil lamps."
msgstr "Um óleo fino e de queima limpa, feito para uso em lâmpadas a óleo."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "motor oil"
msgid_plural "motor oil"
msgstr[0] "óleo de motor"
msgstr[1] "óleo de motor"

#. ~ Description for {'str_sp': 'motor oil'}
#: lang/json/AMMO_from_json.py
msgid "An oil made for use in car engines."
msgstr "Um óleo criado para uso em motores de carro."

#: lang/json/AMMO_from_json.py
msgid "napalm"
msgid_plural "napalm"
msgstr[0] "napalm"
msgstr[1] "napalm"

#. ~ Description for {'str_sp': 'napalm'}
#: lang/json/AMMO_from_json.py
msgid ""
"This is gasoline mixed with some other components to make it stick to the "
"surface and increase burning temperature, meant to be used with a "
"flamethrower."
msgstr ""
" Isso é gasolina misturada com alguns outros componentes para fazerelagrudar"
" em superfícies e aumentar a temperatura de queima, destinadacomocombustível"
" de lança-chamas."

#: lang/json/AMMO_from_json.py
msgid "gelled gasoline"
msgid_plural "gelled gasoline"
msgstr[0] "gasolina em gel"
msgstr[1] "gasolina em gel"

#. ~ Description for {'str_sp': 'gelled gasoline'}
#: lang/json/AMMO_from_json.py
msgid ""
"A flammable gel composed of gasoline and dissolved shavings of polystyrene, "
"roughly similar in properties to napalm b.  It's meant to be used with a "
"flamethrower."
msgstr ""
"Um gel inflamável feito de gasolina e pedaços de isopor dissolvidos, com "
"propriedades semelhantes ao napalm B. Feito para ser usado em lança-chamas."

#: lang/json/AMMO_from_json.py
msgid "flamethrower fuel"
msgid_plural "flamethrower fuel"
msgstr[0] "combustível de lança-chamas"
msgstr[1] "combustível de lança-chamas"

#. ~ Description for {'str_sp': 'flamethrower fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A mixture of gasoline and diesel oil in equal parts.  Its combustion "
"properties make it unfit for applications where you would use any of them "
"separately, but it can be used to feed a flamethrower."
msgstr ""
"Uma mistura de gasolina e óleo diesel em partes iguais. Suas propriedades de"
" queima a tornam imprópria para os usos desses materiais separados, mas pode"
" ser usada para abastecer um lança-chamas."

#: lang/json/AMMO_from_json.py
msgid "autoclave pouch"
msgid_plural "autoclave pouches"
msgstr[0] "bolsa de autoclave"
msgstr[1] "bolsas de autoclave"

#. ~ Description for autoclave pouch
#: lang/json/AMMO_from_json.py
msgid ""
"This is a medical device that bears the approval of the FDA (Food and Drug "
"Administration).  If used properly, these pouches can keep things sterile "
"indefinitely."
msgstr ""
"Isto é um dispositivo médico aprovado pela FDA (Administração de Comidas e "
"Drogas). Se usadas corretamente, essas bolsas podem manter as coisas "
"esterilizadas por um período indefinido."

#: lang/json/AMMO_from_json.py
msgid "shrapnel"
msgid_plural "shrapnel"
msgstr[0] "estilhaços"
msgstr[1] "estilhaços"

#. ~ Description for {'str_sp': 'shrapnel'}
#: lang/json/AMMO_from_json.py
msgid "A twisted shard of jagged metal."
msgstr "Um pedaço de metal irregular."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss slug"
msgid_plural "blunderbuss slugs"
msgstr[0] "balaço de bacamarte"
msgstr[1] "balaços de bacamarte"

#. ~ Description for blunderbuss slug
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of a large hunk of metal.  Better for distance."
msgstr ""
"Um tiro de bacamarte preparado de um grande pedaço de metal. Melhor para a "
"distância."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss shot"
msgid_plural "blunderbuss shots"
msgstr[0] "chumbo de bacamarte"
msgstr[1] "chumbo de bacamarte"

#. ~ Description for blunderbuss shot
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of marbles, pebbles, bearings, basically "
"whatever is at hand.  The homemade pellet spread and number makes up for the"
" shoddy quality."
msgstr ""
"Um tiro bacamarte preparado de bolinhas de gude, seixos, rolamentos, "
"basicamente qualquer coisa ao alcance. A pelota caseira e espalha e os "
"números compensam a má qualidade."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss flechette"
msgid_plural "blunderbuss flechettes"
msgstr[0] "bacamarte de flechette"
msgstr[1] "bacamartes de flechette"

#. ~ Description for blunderbuss flechette
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of homemade flechette made out of nails.  Shreds"
" armor."
msgstr ""
"Munição preparada para bacamartes, composta de flechettes improvisados a "
"partir de pregos. Estilhaça armadura."

#: lang/json/AMMO_from_json.py
msgid "40mm flare"
msgid_plural "40mm flares"
msgstr[0] "sinalizadores de 40mm"
msgstr[1] "sinalizadores de 40mm"

#. ~ Description for 40mm flare
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm signal flare.  It will burn brightly for up to a minute, and will "
"also leave a streak of smoke cover in its wake."
msgstr ""
"Um sinalizador fulgurante de 40 milímetros. Ele vai queimar brilhantemente "
"por até um minuto, e também vai deixar um rastro de fumaça por onde passar."

#: lang/json/AMMO_from_json.py
msgid "40x46mm"
msgid_plural "40x46mms"
msgstr[0] "40x46mm"
msgstr[1] "40x46mms"

#. ~ Description for 40x46mm
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm grenade with a flashbang load.  It will detonate with a blast of "
"light and sound, designed to blind, deafen, and disorient anyone nearby."
msgstr ""
"Uma granada de 40 milímetros com uma carga flashbang. Ela vai detonar com "
"uma explosão de luz e som, projetada para cegar, ensurdecer e desorientar "
"qualquer um nas proximidades."

#: lang/json/AMMO_from_json.py
msgid "40mm incendiary"
msgid_plural "40mm incendiaries"
msgstr[0] "40mm incendiário"
msgstr[1] "40mm incendiário"

#. ~ Description for 40mm incendiary
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm grenade with a small napalm load, designed to create a burst of "
"flame."
msgstr ""
"Uma granada de 40 milímetros com uma pequena carga de napalm, concebida para"
" criar uma explosão de chamas."

#: lang/json/AMMO_from_json.py
msgid "40mm smoke cover"
msgid_plural "40mm smoke covers"
msgstr[0] "40mm tipo fumaça"
msgstr[1] "40mm tipo fumaça"

#. ~ Description for 40mm smoke cover
#: lang/json/AMMO_from_json.py
msgid "A 40mm grenade designed to provide smoke cover."
msgstr "Uma granada de 40mm projetada para fornecer cobertura de fumaça."

#: lang/json/AMMO_from_json.py
msgid "40mm slug"
msgid_plural "40mm slugs"
msgstr[0] "Cápsula 40mm"
msgstr[1] "Cápsulas 40mm"

#. ~ Description for 40mm slug
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm shell loaded with a massive bullet.  Say goodbye to your shoulder, I "
"guess."
msgstr ""
"Um tiro de 40mm carregado com uma bala maciça. Diga adeus ao seu ombro, "
"acho."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "modified mininuke"
msgid_plural "modified mininukes"
msgstr[0] "mini bomba nuclear modificada"
msgstr[1] "mini bombas nucleares modificadas"

#. ~ Description for modified mininuke
#: lang/json/AMMO_from_json.py
msgid ""
"A heavily modified handheld nuclear device on a rocket.  Intended to be "
"fired from a specialized launcher, it has been rigged to explode on impact "
"instead of on a timer.  It can fly further than the explosion will reach, "
"probably."
msgstr ""
"Um dispositivo nuclear portátil altamente modificado preso em um foguete. "
"Usado como munição de um lançador especializado, foi equipado para explodir "
"com o impacto ao invés de com um temporizador. Provavelmente deve voar além "
"do alcance da explosão."

#: lang/json/AMMO_from_json.py
msgid "scrap shotcanister"
msgid_plural "scrap shotcanisters"
msgstr[0] "metralha de sucata"
msgstr[1] "metralhas de sucata"

#. ~ Description for scrap shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with assorted pieces of scrap metal."
msgstr ""
"Este pequeno cilindro de papel semelhante a um cartucho de escopeta "
"rudimentar é cheio até a borda com pedaços variados de sucata de metal."

#: lang/json/AMMO_from_json.py
msgid "pebble shotcanister"
msgid_plural "pebble shotcanisters"
msgstr[0] "metralha de seixo"
msgstr[1] "metralhas de seixo"

#. ~ Description for pebble shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with tiny pebbles.  Damage is pathetic but flight is much more stable than "
"scrap."
msgstr ""
"Este pequeno cilindro de papel semelhante a um cartucho de escopeta "
"rudimentar é cheio até a borda com pequenos seixos. O dano é patético, mas o"
" vôo é muito mais estável do que sucata."

#: lang/json/AMMO_from_json.py
msgid "flechette shotcanister"
msgid_plural "flechette shotcanisters"
msgstr[0] "metralha de flechette"
msgstr[1] "metralhas de flechette"

#. ~ Description for flechette shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with handmade flechettes, giving it some armor piercing capabilities."
msgstr ""
"Este pequeno cilindro de papel semelhante a um cartucho de escopeta "
"rudimentar é cheio até a borda com flechettes artesanais, dando alguma "
"capacidade de penetração de armadura."

#: lang/json/AMMO_from_json.py
msgid "bearing shotcanister"
msgid_plural "bearing shotcanisters"
msgstr[0] "metralha de rolamento"
msgstr[1] "metralhas de rolamento"

#. ~ Description for bearing shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with handmade bearings, stabilizing its flight pattern a tiny bit."
msgstr ""
"Este pequeno cilindro de papel semelhante a um cartucho de escopeta "
"rudimentar é cheio até a borda com rolamentos artesanais, estabilizando um "
"pouco o padrão de vôo."

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ"
msgid_plural "10mm Auto FMJ"
msgstr[0] "10mm Auto FMJ"
msgstr[1] "10mm Auto FMJ"

#. ~ Description for {'str_sp': '10mm Auto FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
"Jacketed 10mm Auto ammunition with 180gr bullets.  The 10mm Auto cartridge "
"is a rather powerful handgun round and the progenitor to the more popular "
".40 S&W."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ, black powder"
msgid_plural "10mm Auto FMJ, black powder"
msgstr[0] "10mm Auto FMJ, pólvora negra"
msgstr[1] "10mm Auto FMJ, pólvora negra"

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ, reloaded"
msgid_plural "10mm Auto FMJ, reloaded"
msgstr[0] "10mm Auto FMJ, recarregada"
msgstr[1] "10mm Auto FMJ, recarregada"

#: lang/json/AMMO_from_json.py
msgid "H&K 12mm"
msgid_plural "H&K 12mm"
msgstr[0] "H&K 12mm"
msgstr[1] "H&K 12mm"

#. ~ Description for {'str_sp': 'H&K 12mm'}
#: lang/json/AMMO_from_json.py
msgid ""
"The Heckler & Koch 12mm projectiles are used in H&K railguns.  It's made of "
"a ferromagnetic metal, probably cobalt."
msgstr ""
" Os projéteis Heckler & Koch 12 mm são usados ​​em canhões elétricos "
"H&K.Éfeito de um metal ferromagnético, provavelmente cobalto."

#: lang/json/AMMO_from_json.py
msgid "20x66mm beanbag"
msgid_plural "20x66mm beanbags"
msgstr[0] "20x66mm bago"
msgstr[1] "20x66mm bagos"

#. ~ Description for 20x66mm beanbag
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, sublethal beanbag type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"Munição não-letal sem cartucho 20x66mm para espingardas. Variedade "
"proprietária para espingardas Rivtech. Sendo munição sem invólucros, ela não"
" pode ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flechette, handmade"
msgid_plural "20x66mm flechettes, handmade"
msgstr[0] "20x66mm flechette, artesanal"
msgstr[1] "20x66mm flechettes, artesanais"

#. ~ Description for 20x66mm flechette, handmade
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless flechette rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Duplicatas piratas de munições sem cartucho tipo flechette para espingardas "
"Rivtech 20x66mm. Sendo uma munição sem invólucros, ela não pode ser "
"desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm buckshot, handmade"
msgid_plural "20x66mm buckshot, handmade"
msgstr[0] "20x66mm buckshot, artesanal"
msgstr[1] "20x66mm buckshot, artesanais"

#. ~ Description for {'str_sp': '20x66mm buckshot, handmade'}
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless buckshot rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Duplicatas piratas de munições sem cartucho do tipo chumbo grosso para "
"espingardas Rivtech 20x66mm. Sendo uma munição sem invólucros, ela não pode "
"ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm slug, handmade"
msgid_plural "20x66mm slugs, handmade"
msgstr[0] "20x66mm slug, artesanal"
msgstr[1] "20x66mm slugs, artesanais"

#. ~ Description for 20x66mm slug, handmade
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless solid projectile "
"rounds.  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Duplicatas piratas de projéteis Rivtech 20x66mm sólidos sem invólucro. Sendo"
" uma munição sem invólucro, ela não pode ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm explosive"
msgid_plural "20x66mm explosive"
msgstr[0] "20x66mm explosiva"
msgstr[1] "20x66mm explosivas"

#. ~ Description for {'str_sp': '20x66mm explosive'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, explosive projectile type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"tiros de escopeta 20x66mm sem invólucro, tipo explosivo. Munição "
"proprietária para espingardas Rivtech. Sendo uma munição sem invólucro, "
"estas não podem ser desmontadas ou recarregadas."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flare"
msgid_plural "20x66mm flares"
msgstr[0] "20x66mm sinalizador"
msgstr[1] "20x66mm sinalizadores"

#. ~ Description for 20x66mm flare
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, signal flare type.  Proprietary ammunition "
"for Rivtech shotguns.  Being caseless rounds, these cannot be disassembled "
"or reloaded."
msgstr ""
"tiros de escopeta 20x66mm sem invólucro, tipo sinalizador. Munição "
"proprietária para espingardas Rivtech. Sendo uma munição sem invólucro, ela "
"não pode ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flechette"
msgid_plural "20x66mm flechettes"
msgstr[0] "20x66mm flechette"
msgstr[1] "20x66mm flechettes"

#. ~ Description for 20x66mm flechette
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, flechette type.  Proprietary ammunition for"
" Rivtech shotguns.  Being caseless rounds, these cannot be disassembled or "
"reloaded."
msgstr ""
"tiros de escopeta 20x66mm sem invólucro, tipo flechette. Munição "
"proprietária para espingardas Rivtech. Sendo uma munição sem invólucro, ela "
"não pode ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm frag"
msgid_plural "20x66mm frag"
msgstr[0] "20x66mm frag"
msgstr[1] "20x66mm frag"

#. ~ Description for {'str_sp': '20x66mm frag'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, explosive fragmentation type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"tiros de escopeta 20x66mm sem invólucro, variedade com fragmentação "
"explosiva. Munição proprietária para espingardas Rivtech. Sendo uma munição "
"sem invólucro, ela não pode ser desmontada ou recarregada."

#: lang/json/AMMO_from_json.py
msgid "20x66mm incendiary"
msgid_plural "20x66mm incendiary"
msgstr[0] "20x66mm incendiária"
msgstr[1] "20x66mm incendiárias"

#. ~ Description for {'str_sp': '20x66mm incendiary'}
#: lang/json/AMMO_from_json.py
msgid ""
