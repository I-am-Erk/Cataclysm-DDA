msgid_plural "aztlani hunting swords"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for aztlani hunting sword
#: lang/json/TOOL_from_json.py
msgid ""
"An ornate, single-handed sword used by Aztlani hunters to finish injured "
"game.  Made from gleaming composite alloy, its tip and frontal blade have "
"been sharpened to a monomolecular point, while its back features a serrated "
"saw edge."
msgstr ""

