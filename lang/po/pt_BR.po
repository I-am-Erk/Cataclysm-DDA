msgstr[1] "chapas pequenas de metal"

#. ~ Description for small metal sheet
#: lang/json/AMMO_from_json.py
msgid "A small sheet of metal."
msgstr "Uma pequena folha de metal."

#: lang/json/AMMO_from_json.py
msgid "chunk of steel"
msgid_plural "chunks of steel"
msgstr[0] "pedaço de aço"
msgstr[1] "pedaços de aço"

#. ~ Description for chunk of steel
#: lang/json/AMMO_from_json.py
