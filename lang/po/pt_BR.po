msgstr ""
" Piso xadrez de alta qualidade e resistência para reduzir o risco de "
"escorregões e quedas, com um telhado correspondente."

#: lang/json/terrain_from_json.py
msgid "floor"
msgstr "chão"

#. ~ Description for floor
#: lang/json/terrain_from_json.py
msgid ""
