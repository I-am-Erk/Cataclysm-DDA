"\n"
"+1 Dodge attempt\n"
"Lasts 1 turn.  Stacks 2 times"
msgstr ""

#: lang/json/martial_art_from_json.py
msgid "Quicksilver Motion"
msgstr ""

#. ~ Description of buff 'Quicksilver Motion' for martial art '{'str':
#. 'Diamond Mind'}'
#: lang/json/martial_art_from_json.py
