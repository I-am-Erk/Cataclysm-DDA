"tripwire trap must be placed across a doorway or other thin passage.  Its "
"purpose is to trip up trespassers, causing them to stumble and possibly hurt"
" themselves slightly."
msgstr ""

#: lang/json/TOOL_from_json.py
msgid "wood axe"
msgid_plural "wood axes"
msgstr[0] "machado de lenha"
msgstr[1] "machados de lenha"

#. ~ Description for wood axe
#: lang/json/TOOL_from_json.py
