msgstr[1] ".50 BMG Match"

#. ~ Description for {'str_sp': '.50 BMG Match'}
#: lang/json/AMMO_from_json.py
msgid ""
".50 BMG FMJ lead core ammunition manufactured with tighter tolerances for "
"long-range competition shooting or other precision rifle use."
msgstr ""
"Munição .50 BMG FMJ com núcleo de chumbo, fabricada sob regulações mais "
"estritas para uso em competições de tiro esportivo de longo alcance, ou para"
" outros usos necessitando de precisão elevada."

#: lang/json/AMMO_from_json.py
