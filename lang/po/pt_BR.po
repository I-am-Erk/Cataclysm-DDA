msgid "Rending Strikes"
msgstr ""

#. ~ Description of buff 'Rending Strikes' for martial art 'CRIT Blade-work'
#: lang/json/martial_art_from_json.py
msgid ""
"Additional Armor penetration per stack.  Further reduces dodge attempts.  3 "
"stacks max."
msgstr ""

