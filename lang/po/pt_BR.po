msgid "Viper's Ambush"
msgstr ""

#. ~ Description of buff 'Viper's Ambush' for martial art '{'str': 'Viper Kung
#. Fu'}'
#: lang/json/martial_art_from_json.py
msgid ""
"Your evasiveness has left your opponent wide open to painful bite.\n"
"\n"
"Enables \"Viper Bite\" technique.\n"
"Lasts 1 turn."
msgstr ""

#: lang/json/martial_art_from_json.py
msgid "Viper's Venom"
msgstr "Veneno da Víbora"

#. ~ Description of buff 'Viper's Venom' for martial art '{'str': 'Viper Kung
