#. ~ Description for habitat window (shutters)
#: lang/json/terrain_from_json.py
msgid ""
"A porthole style window of standard design, completely covered by sturdy "
"metallic shutters."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "broken habitat window (shutters)"
msgstr ""

#. ~ Description for broken habitat window (shutters)
#: lang/json/terrain_from_json.py
msgid ""
"The shutters of this porthole are deployed, but the lack of a window between"
" them allows the frozen air to leak into the room."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "broken habitat window"
msgstr ""

#. ~ Description for broken habitat window
#: lang/json/terrain_from_json.py
msgid ""
"The glass panel that would have covered this porthole has been broken, "
"allowing unfettered access to the rooms within."
msgstr ""

