#. ~ Description of buff 'Stance of Alacrity' for martial art '{'str':
#. 'Diamond Mind'}'
#: lang/json/martial_art_from_json.py
#, no-python-format
msgid ""
"Your mind is clearer than normal.  This clarity allows you to move slightly faster in combat.\n"
"\n"
"-10% move cost"
msgstr ""

