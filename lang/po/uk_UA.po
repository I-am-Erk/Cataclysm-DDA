#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built leather utility belt covered with straps and pouches "
"containing many useful hand tools and a clip for holding various equipment."
"  Durable and carefully crafted to be comfortable to wear.  Activate to clip"
" something to it."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "survivor utility belt (sheath)"
msgid_plural "survivor utility belts (sheath)"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

