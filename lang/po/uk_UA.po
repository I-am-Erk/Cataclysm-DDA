msgid_plural "autoclave pouches"
msgstr[0] "упаковка для автоклаву"
msgstr[1] "упаковки для автоклаву"
msgstr[2] "упаковок для автоклаву"
msgstr[3] "упаковка для автоклаву"

#. ~ Description for autoclave pouch
#: lang/json/AMMO_from_json.py
