msgid "Keep hands free from machinery"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"STOP\n"
"For Your\n"
"Safety"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"NOTICE\n"
"Safety Glasses Required"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"DANGER\n"
"Keep Hands Clear\n"
"When Equipment\n"
"Is Running"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Keep guns holstered or locked up"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Tasers Save Lives"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"STOP\n"
"Where's your gun?"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"NOTICE\n"
"Check in with your squad on the hour."
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Keep Equipment Clean and Hygenic"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "PPE Required"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "<color_yellow_red>Biohazard</color>"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Do not look into laser with remaining eye"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"There have been\n"
"[4]\n"
"days without a life-threatening workplace accident"
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Be Alert, Don't get Hurt!"
msgstr ""

#: lang/json/snippet_from_json.py
msgid ""
"Safety First\n"
"Work Safely"
msgstr ""

#: lang/json/snippet_from_json.py
