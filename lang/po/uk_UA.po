msgstr[3] ""

#. ~ Use action msg for CE-4 "The Claw" (Non-Lethal).
#: lang/json/TOOL_from_json.py
msgid ""
"You activate the claw, and its bludgeoning surface slowly flattens into an "
"edge as it begins to glow red-hot"
msgstr ""

#. ~ Use action need_charges_msg for CE-4 "The Claw" (Non-Lethal).
