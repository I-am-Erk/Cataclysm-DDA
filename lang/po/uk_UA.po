msgid "CRIT backpack"
msgid_plural "CRIT backpacks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for CRIT backpack
#: lang/json/ARMOR_from_json.py
