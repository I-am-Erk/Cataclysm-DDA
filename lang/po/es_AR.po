" o como herramienta. Tiene una capacidad de 250 ml."

#: lang/json/GENERIC_from_json.py
msgid "pack"
msgid_plural "packs"
msgstr[0] "atado de cigarrillos"
msgstr[1] "atados de cigarrillos"

#. ~ Description for pack
#: lang/json/GENERIC_from_json.py
msgid ""
"SURGEON GENERAL'S WARNING: Smoking Causes Lung Cancer, Heart Disease, "
"Emphysema And May Complicate Pregnancy."
msgstr ""
