msgstr ""
"Son granos de maíz que han sido cocinados en una solución alcalina y luego "
"enjuagados, haciéndolos más adecuados para comer o cocinar."

#: lang/json/COMESTIBLE_from_json.py
msgid "cornmeal"
msgid_plural "cornmeal"
msgstr[0] "harina de maíz"
msgstr[1] "harina de maíz"

#. ~ Description for {'str_sp': 'cornmeal'}
#: lang/json/COMESTIBLE_from_json.py
msgid "This yellow cornmeal is useful for baking."
msgstr "Harina de maíz amarilla, útil para hornear."

#: lang/json/COMESTIBLE_from_json.py
