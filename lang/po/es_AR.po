"que los Terraformantes canalicen magia en sus creaciones."

#: lang/json/TOOL_from_json.py
msgid "Kelvinist rune"
msgid_plural "Kelvinist runes"
msgstr[0] "runa Kelvinista"
msgstr[1] "runas Kelvinista"

#. ~ Description for Kelvinist rune
#: lang/json/TOOL_from_json.py
msgid ""
