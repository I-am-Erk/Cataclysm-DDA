msgstr[1] ".38 FMJ"

#. ~ Description for {'str_sp': '.38 FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
".38 Special ammunition with brass jacketed 130gr bullets.  The .38 Special "
"round has been known from its inception for its accuracy and low recoil."
msgstr ""
"Es munición .38 Special con recubierta de latón de 130gr. La bala .38 "
"Special fue famosa desde sus inicios por su precisión y bajo retroceso."

