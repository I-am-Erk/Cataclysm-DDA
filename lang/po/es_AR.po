msgstr "Ya no queda nada del %s que <npcname> estaba fabricando."

#: src/activity_actor.cpp
msgid "You are too tired to exercise."
msgstr "Estás demasiado cansado como para hacer ejercicios."

#: src/activity_actor.cpp
msgid "You are too dehydrated to exercise."
msgstr "Estás demasiado deshidratado como para hacer ejercicios."

#: src/activity_actor.cpp
msgid "Empty your hands first."
msgstr "Primero, tenés que tener las manos libres."

#: src/activity_actor.cpp
msgid "You cannot train here with a broken arm."
msgstr "No podés entrenar acá con un brazo roto."

#: src/activity_actor.cpp
msgid "You cannot train here with a broken leg."
msgstr "No podés entrenar acá con una pierna rota."

#: src/activity_actor.cpp
msgid "You cannot train freely with a broken limb."
msgstr "No podés entrenar libremente con un miembro roto."

#: src/activity_actor.cpp
msgid ""
"Physical effort determines workout efficiency, but also rate of exhaustion."
msgstr ""
"El esfuerzo físico determina la eficiencia del ejercicio, pero también el "
"ritmo del agotamiento."

#: src/activity_actor.cpp
msgid "Choose training intensity:"
msgstr "Elegí la intensidad del entrenamiento:"

#: src/activity_actor.cpp
msgctxt "training intensity"
msgid "Light"
msgstr "Luz"

#: src/activity_actor.cpp
msgid ""
"Light exercise comparable in intensity to walking, but more focused and "
"methodical."
msgstr ""
"El ejercicio liviano es comparable en intensidad a caminar, pero más "
"focalizado y metódico."

#: src/activity_actor.cpp
msgctxt "training intensity"
msgid "Moderate"
msgstr "Moderado"

#: src/activity_actor.cpp
msgid ""
"Moderate exercise without excessive exertion, but with enough effort to "
"break a sweat."
msgstr ""
"Es el ejercicio moderado sin esfuerzo excesivo, pero con suficiente esfuerzo"
" como para chivar un rato."

#: src/activity_actor.cpp
msgctxt "training intensity"
msgid "Active"
msgstr "Activo"

#: src/activity_actor.cpp
msgid ""
"Active exercise with full involvement.  Strenuous, but in a controlled "
"manner."
msgstr ""
"Es el ejercicio activo con completa involucramiento. Extenuante pero de "
"manera controlada."

#: src/activity_actor.cpp
msgctxt "training intensity"
msgid "High"
msgstr "Alto"

#: src/activity_actor.cpp
msgid ""
"High intensity exercise with maximum effort and full power.  Exhausting in "
"the long run."
msgstr ""
"Es ejercicio de alta intensidad con un esfuerzo máximo y potencia completa. "
"A la larga es extenueante."

#: src/activity_actor.cpp
msgid "Train for how long (minutes): "
msgstr "Tiempo para entrenar (minutos): "

#: src/activity_actor.cpp
msgid "You start your workout session."
msgstr "Empezás tu sesión de ejercicios."

#: src/activity_actor.cpp
msgid "You are exhausted so you finish your workout early."
msgstr "Estás exhausto así que dejás antes de entrenar."

#: src/activity_actor.cpp
msgid "You are dehydrated so you finish your workout early."
msgstr "Estás deshidratado así que dejás antes de entrenar."

#. ~ heavy breathing when exercising
#: src/activity_actor.cpp
msgid "yourself huffing and puffing!"
msgstr "¡tus resoplidos y jadeos!"

#: src/activity_actor.cpp
msgid "You catch your breath for few moments."
msgstr "Recuperás el aliento por unos momentos."

#: src/activity_actor.cpp
msgid "You get back to your training."
msgstr "Volvés al entrenamiento."

#: src/activity_actor.cpp
msgid "You finish your workout session."
msgstr "Terminaste tu sesión de ejercicios."

#: src/activity_actor.cpp
msgid "You have finished your training cycle, keep training?"
msgstr "Terminaste tu ciclo de entrenamiento, ¿querés seguir entrenando?"

#: src/activity_actor.cpp
msgid "Stop training."
msgstr "Dejar de entrenar."

#: src/activity_actor.cpp
msgid "Continue training."
msgstr "Seguir entrenando."

#: src/activity_actor.cpp
msgid "Continue training and don't ask again."
msgstr "Seguir entrenando y no volver a preguntar."

