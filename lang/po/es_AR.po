#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Photojournalist"
msgstr "Fotoperiodista"

#. ~ Profession (male Photojournalist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Covering the apocalypse up close could make your career, though finding a "
"publisher seems more difficult a prospect than usual.  You managed to hold "
"onto your camera - hopefully you can get some fantastic shots."
msgstr ""
"Cubrir el apocalipsis bien de cerca podría hacer tu carrera, aunque "
"conseguir alguien que te publique parece ser un poco más complicado de lo "
"normal. Pudiste quedarte con tu cámara y con un poco de suerte vas a sacar "
"unas fotos fantásticas."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Photojournalist"
msgstr "Fotoperiodista"

#. ~ Profession (female Photojournalist) description
#: lang/json/professions_from_json.py
