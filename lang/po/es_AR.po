msgid "tiny pistol ammo, JHP (black powder)"
msgid_plural "tiny pistol ammo, JHP (black powder)"
msgstr[0] "munición de pistola pequeña, JHP (pólvora)"
msgstr[1] "municiones de pistola pequeña, JHP (pólvora)"

#: lang/json/AMMO_from_json.py
msgid "rifle ammo, ball"
msgid_plural "rifle ammo, ball"
msgstr[0] "munición de rifle, bola"
msgstr[1] "municiones de rifle, bola"

#. ~ Description for {'str_sp': 'rifle ammo, ball'}
#: lang/json/AMMO_from_json.py
msgid ""
"Modern rifle ammunition, ubiquitous and affordable.  It's suitable for "
"international conflicts, hunting small to large game, home defense, and "
"these days, zombies.  'Ball' is an old term for full metal jacketed bullets "
"which offer reduced fouling, better reliability, and slightly improved "
"penetration compared to plain lead."
msgstr ""
"Es munición para rifle moderno, útil y barata. Es adecuada para los "
"conflictos internacionales, caza menor o grande, defensa personal, y, por "
"estos días, zombis. \"Bola\" es un término antiguo para las balas full metal"
" jacket, que generan menor suciedad, mejor fiabilidad y una penetración "
"levemente mejorada en comparación al simple plomo."

#: lang/json/AMMO_from_json.py
msgid "rifle ammo, AP"
msgid_plural "rifle ammo, AP"
msgstr[0] "munición de rifle, AP"
msgstr[1] "municiones de rifle, AP"

#. ~ Description for {'str_sp': 'rifle ammo, AP'}
#: lang/json/AMMO_from_json.py
msgid ""
"Modern rifle ammunition, ubiquitous and affordable.  It's suitable for "
"international conflicts, hunting small to large game, home defense, and "
"these days, zombies.  This 'armor piercing' variant features a mild steel "
"penetrator for environmental friendliness, improved barrier penetration, and"
" enhanced effect on armor."
msgstr ""
"Es munición para rifle moderno, útil y barata. Es adecuada para los "
"conflictos internacionales, caza menor o grande, defensa personal, y, por "
"estos días, zombis. Esta variante con penetración de armadura tiene un "
"perforante de acero dulce, lo que lo hace amigable al medio ambiente, mejora"
" la penetración y tiene mayor efecto ante las armaduras."

#: lang/json/AMMO_from_json.py
msgid "rifle ammo, ball (reloaded)"
msgid_plural "rifle ammo, ball (reloaded)"
msgstr[0] "munición de rifle, bola (recargada)"
msgstr[1] "municiones de rifle, bola (recargadas)"

