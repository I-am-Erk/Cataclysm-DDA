msgid_plural "skeletal Siats"
msgstr[0] "Siats esquelético"
msgstr[1] "Siats esqueléticos"

#. ~ Description for {'str_sp': 'skeletal Siats'}
#: lang/json/MONSTER_from_json.py
msgid ""
"Monstrous columns of dense bone lifting sharp teeth dripping with black goo."
"  There are long claws and strong arms for grappling."
msgstr ""
"Son unas monstruosas columnas de hueso denso que soportan unos dientes "
"filosos que chorrean una viscosidad negra. Tiene garras largas y brazos "
"fuertes."

#: lang/json/MONSTER_from_json.py
msgid "skeletal Albertosaurus"
msgid_plural "skeletal Albertosaurus"
msgstr[0] "Albertosaurus esquelético"
msgstr[1] "Albertosaurus esqueléticos"

#. ~ Description for {'str_sp': 'skeletal Albertosaurus'}
#: lang/json/MONSTER_from_json.py
msgid ""
"Monstrous columns of dense bone lifting sharp, pointed teeth dripping with "
"black goo.  Skeletal claws reach ahead."
msgstr ""
"Son unas monstruosas columnas de hueso denso que soportan unos dientes "
"puntiagudos y filosos que chorrean una viscosidad negra. Tiene unas garras "
