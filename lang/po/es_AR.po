msgid "Spawning Zombie Die"
msgstr "Crear Zombi que Muere"

#. ~ Description for Spawning Zombie Die
#: lang/json/SPELL_from_json.py
msgid "For zombies that are spawning something and die in the process."
msgstr "Para los zombis que crean algo cuando mueren."

#: lang/json/SPELL_from_json.py
msgid "Phase Skulker Teleport"
msgstr "Teletransportar Skulker Fase"

#. ~ Description for Phase Skulker Teleport
#: lang/json/SPELL_from_json.py
msgid "Teleports the monster."
msgstr "Teletransporta el monstruo."

#: lang/json/SPELL_from_json.py
msgid "Summon Centipede"
msgstr "Conjurar Ciempiés"

#. ~ Description for Summon Centipede
#: lang/json/SPELL_from_json.py
msgid "Summons a small, pissed off centipede."
msgstr "Conjura un pequeño ciempiés enojado."

#. ~ Description for Phase Skulker Teleport
#: lang/json/SPELL_from_json.py
msgid "Electric explosion followed by a teleport."
msgstr "Explosión eléctrica seguida de una teletransportación."

#: lang/json/SPELL_from_json.py
msgid "Dermatik Emergence"
msgstr "Emergencia Demartik"

#. ~ Description for Dermatik Emergence
#: lang/json/SPELL_from_json.py
msgid "The incubating dermatik larvae flee their host."
msgstr "La larva dermatik que estaba incubándose, huye de su huésped."

#: lang/json/SPELL_from_json.py
msgid "Spread Sludge"
msgstr "Esparcir Barro"

#. ~ Description for Spread Sludge
#: lang/json/SPELL_from_json.py
msgid "Splatters sludge along the ground in a cone."
msgstr "Tira un chorro de barro por el suelo en forma de cono."

#: lang/json/SPELL_from_json.py
msgid "Blinding spray"
msgstr "Rayo cegador"

#. ~ Description for Blinding spray
#: lang/json/SPELL_from_json.py
msgid "Blinds enemy for a short time."
msgstr "Ciega al enemigo por un tiempo breve."

#: lang/json/SPELL_from_json.py
msgid "Cranial Explosion"
msgstr "Explosión Craneal"

#. ~ Description for Cranial Explosion
#: lang/json/SPELL_from_json.py
msgid "This fake spell occurs on cranial bomb activation.  Likely fatal."
msgstr ""
"Este falso hechizo ocurre con la activación de la bomba craneal. "
"Probablemente, fatal."

#: lang/json/SPELL_from_json.py
msgid "Skullgun Snapback"
msgstr "Retroceso de Arma Craneal"

#. ~ Description for Skullgun Snapback
#: lang/json/SPELL_from_json.py
msgid ""
"This fake spell occurs on skullgun activation.  May be fatal if done in "
"critical condition."
msgstr ""
"Este hechizo falso ocurre con la activación del arma craneal. Puede ser "
"fatal si sucede en una situación crítica."

#. ~ Message for SPELL 'Skullgun Snapback'
#: lang/json/SPELL_from_json.py
msgid "Your head snaps back from the force of the shot."
msgstr "Tu cuello da un golpe brusco hacia atrás por la fuerza del disparo."

#: lang/json/SPELL_from_json.py
msgid "Aftershock Extra Turn"
msgstr "Aftershock Turno Extra"

#. ~ Description for Aftershock Extra Turn
#: lang/json/SPELL_from_json.py
msgid "Grants you an extra turn."
msgstr "Te da un turno extra."

#: lang/json/SPELL_from_json.py
msgid "Aftershock Stacking Speed Bonus"
msgstr "Aftershock Bonus de Velocidad"

#. ~ Description for Aftershock Stacking Speed Bonus
#: lang/json/SPELL_from_json.py
msgid "Grants you a stackable speed bonus."
msgstr "Te da un bonus de velocidad que se puede acumular."

#. ~ Description for heat retention cream
#: lang/json/SPELL_from_json.py
msgid ""
"You rub the thick cream all over your body in preparation for the expected "
"cold."
msgstr ""
"Te pasas la crema gruesa por todo el cuerpo preparándote para el frío."

#. ~ Description for heat retention cream xtreme
#: lang/json/SPELL_from_json.py
msgid ""
"You rub the thick cream all over your body in preparation for unbearable "
"cold."
msgstr ""
"Te pasas la crema gruesa por todo el cuerpo preparándote para el frío "
"intolerable."

#: lang/json/SPELL_from_json.py
msgid "emergency insulation"
msgstr "aislación de emergencia"

#. ~ Description for emergency insulation
#: lang/json/SPELL_from_json.py
msgid ""
"You feel a jolt through your body as energy pulses through the wires in your"
" flesh."
msgstr ""
"Sentís una sacudida por tu cuerpo mientras la energía late por los cables de"
" tu carne."

#: lang/json/SPELL_from_json.py
msgid "Cryokinetic blast"
msgstr "Explosión criocinética"

#: lang/json/SPELL_from_json.py
msgid "Holographic Field"
msgstr "Campo Holográfico"

#. ~ Description for Holographic Field
#: lang/json/SPELL_from_json.py
msgid "Creates several short-lived holograms around you."
msgstr "Crea varios hologramas de corta vida a tu alrededor."

#: lang/json/SPELL_from_json.py
msgid "Holographic Decoy"
msgstr "Señuelo Holográfico"

#. ~ Description for Holographic Decoy
#: lang/json/SPELL_from_json.py
msgid "Creates a short-lived hologram."
msgstr "Crea un holograma de corta vida."

#: lang/json/SPELL_from_json.py
msgid "Holographic Flash"
msgstr "Destello Holográfico"

#. ~ Description for Holographic Flash
#. ~ Description for Holographic Flash Explosion
#: lang/json/SPELL_from_json.py
msgid ""
"Causes an existing hologram to explode into burning light, harming and "
"stunning enemies close to it."
msgstr ""
"Causa que un holograma ya existente explote en una luz quemadora, dañando y "
"aturdiendo a los enemigos cercanos."

#: lang/json/SPELL_from_json.py
msgid "Holographic Flash Explosion"
msgstr "Explosión de Destello Holográfico"

#: lang/json/SPELL_from_json.py
msgid "Holographic Transposition"
msgstr "Transposición Holográfica"

#: lang/json/SPELL_from_json.py
msgid "Isohypsa Coordination"
msgstr "Coordinación Isohypsa"

#. ~ Description for Isohypsa Coordination
#: lang/json/SPELL_from_json.py
msgid "Increases the speed of simpler Wraitheon drones."
msgstr "Incrementa la velocidad de los drones Wraitheon comunes."

#: lang/json/SPELL_from_json.py
msgid "Blade Rush"
msgstr "Ráfaga Blade"

#. ~ Description for Blade Rush
#: lang/json/SPELL_from_json.py
msgid "Heals some light damage to the character."
msgstr "Cura un poco de daño al personaje."

#. ~ Message for SPELL 'Blade Rush'
#: lang/json/SPELL_from_json.py
msgid "You feel a rush of vitality from your target into your body."
msgstr ""
"Sentís una ráfaga de vitalidad que sale desde tu objetivo y va hacia tu "
"cuerpo."

#: lang/json/SPELL_from_json.py lang/json/TOOL_from_json.py
msgid "camera"
msgid_plural "cameras"
msgstr[0] "cámara"
msgstr[1] "cámaras"

#. ~ Description for camera
#: lang/json/SPELL_from_json.py
msgid "an attack that blinds the target for a few turns"
msgstr "un ataque que ciega al objetivo por algunos turnos"

#: lang/json/SPELL_from_json.py
msgid "Spawn ALRP"
msgstr "Crear ALRP"

#. ~ Description for Spawn ALRP
#: lang/json/SPELL_from_json.py
msgid "Summons a squad of 3-4 skirmishers."
msgstr "Conjura un grupo de 3 o 4 hostigadores."

#: lang/json/SPELL_from_json.py
msgid "Ki Strike Meditations"
msgstr "Meditaciones de Golpe Ki"

#. ~ Description for Ki Strike Meditations
#: lang/json/SPELL_from_json.py
msgid "This grants a specific mutation."
msgstr "Esto otorga una mutación específica."

#. ~ Message for SPELL '{'str': 'Ki Strike Meditations'}'
#: lang/json/SPELL_from_json.py
msgid "You study the meditations until you could do them in your sleep…"
msgstr "Estudiás las meditaciones hasta que podrías hacerlas dormido…"

#: lang/json/SPELL_from_json.py
msgid "Smite"
msgstr "Golpe"

#: lang/json/SPELL_from_json.py
msgid "Life Conversion"
msgstr "Conversión Vital"

#: lang/json/SPELL_from_json.py
msgid "Mind over Pain"
msgstr "No Me Va a Doler"

#: lang/json/SPELL_from_json.py
msgid "Summon Zombie"
msgstr "Conjurar Zombi"

#: lang/json/SPELL_from_json.py
msgid "Summon Tough Zombie"
msgstr "Conjurar Zombi Rudo"

#. ~ Description for Summon Tough Zombie
#: lang/json/SPELL_from_json.py
msgid ""
"An ethereal-looking tough zombie rises from the depths of the earth to fight"
" for you.  You may be able to summon more with a higher level in this spell."
msgstr ""
"Un zombi rudo de apariencia etérea se levanta de las profundidades de la "
"tierra para luchar por vos. Podrías conjurar más zombis con un nivel más "
"alto de este hechizo."

#: lang/json/SPELL_from_json.py
msgid "Summon Skeleton"
msgstr "Conjurar Esqueleto"

#: lang/json/SPELL_from_json.py
msgid "Summon Decayed Pouncer"
msgstr "Conjurar Saltador Podrido"

#: lang/json/SPELL_from_json.py
msgid "Summon Spearcat Hunter"
msgstr "Conjurar Cazador Gatolanza"

#. ~ Description for Summon Spearcat Hunter
#: lang/json/SPELL_from_json.py
msgid ""
"A primal looking large cat rises from the depths of the earth to fight for "
"you.  You may be able to summon more with a higher level in this spell."
msgstr ""
"Un felino grande y primitivo se levanta de las profundidades de la tierra "
"para luchar por vos. Podrías conjurar más saltadores con un nivel más alto "
"de este hechizo."

#: lang/json/SPELL_from_json.py
msgid "Necrotic Gaze"
msgstr "Mirada Necrótica"

#: lang/json/SPELL_from_json.py
msgid "Animist Rune"
msgstr "Runa Animista"

#. ~ Description for Animist Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Animists.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Animistas. Podés usar la "
"runa como catalizador en recetas."

#: lang/json/SPELL_from_json.py
msgid "Soulrend"
msgstr "Desgarralmas"

#. ~ Description for Soulrend
#: lang/json/SPELL_from_json.py
msgid ""
"Violently tears the spirit from the body, and bounds the resulting shade to "
"your will."
msgstr ""
"Arranca violentamente el espíritu del cuerpo, y une esa sombra a tu "
"voluntad."

#: lang/json/SPELL_from_json.py
msgid "Lesser Banishment"
msgstr "Destierro Menor"

#: lang/json/SPELL_from_json.py
msgid "Ignus Fatuus"
msgstr "Ignus Fatuus"

#: lang/json/SPELL_from_json.py
msgid "Bleed"
msgstr "Sangrado"

#: lang/json/SPELL_from_json.py
msgid "Decaying Boneclub"
msgstr "Garrote de Hueso Putrefacto"

#. ~ Description for Decaying Boneclub
#: lang/json/SPELL_from_json.py
msgid ""
"This spell links your live blood to the dead blood & bones, creating a club "
"hungry for the flesh of the living."
msgstr ""
"Este hechizo conecta tu sangre viva con la sangre y huesos muertos creando "
"un garrote hambriento de carne de los vivos."

#: lang/json/SPELL_from_json.py
msgid "Cure Light Wounds"
msgstr "Curar Heridas Menores"

#: lang/json/SPELL_from_json.py
msgid "Pain Split"
msgstr "Dividir Dolor"

#: lang/json/SPELL_from_json.py
msgid "Vicious Tentacle"
msgstr "Tentáculo Feroz"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Grotesque Enhancement"
msgstr "Mejora Grotesca"

#: lang/json/SPELL_from_json.py
msgid "Acidic Spray"
msgstr "Chorro Ácido"

#: lang/json/SPELL_from_json.py
msgid "Flesh Pouch"
msgstr "Bolsa de Carne"

#: lang/json/SPELL_from_json.py
msgid "Conjure Bonespear"
msgstr "Conjurar Lanza de Hueso"

#: lang/json/SPELL_from_json.py
msgid "Biomancer Rune"
msgstr "Runa Biomante"

#. ~ Description for Biomancer Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Biomancers.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Biomantes. Podés usar la "
"runa como catalizador en recetas."

#: lang/json/SPELL_from_json.py
msgid "Paralytic Dart"
msgstr "Dardo Paralizante"

#: lang/json/SPELL_from_json.py
msgid "Visceral Projection"
msgstr "Proyección Visceral"

#: lang/json/SPELL_from_json.py
msgid "Visceral Paralysis"
msgstr "Parálisis Visceral"

#. ~ Description for Visceral Paralysis
#: lang/json/SPELL_from_json.py
msgid "Paralytic side effect of Projection."
msgstr "Efecto secundario paralizante de la Proyección."

#: lang/json/SPELL_from_json.py
msgid "Visceral Backlash"
msgstr "Reacción Visceral"

#. ~ Description for Visceral Backlash
#: lang/json/SPELL_from_json.py
msgid "Hits the user with side effects too."
msgstr "También causa efectos secundarios."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Coagulant Weave"
msgstr "Tejido Coagulante"

#: lang/json/SPELL_from_json.py
msgid "Caustic Feedback"
msgstr "Retroalimentación Cáustica"

#. ~ Description for Caustic Feedback
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of the Caustic Aura spell."
msgstr "Esto es un subhechizo del hechizo Aura Cáustica."

#. ~ description for the sound of spell 'Caustic Feedback'
#: lang/json/SPELL_from_json.py
msgid "acidic sizzle!"
msgstr "chisporroteo ácido!"

#: lang/json/SPELL_from_json.py
msgid "Caustic Aura"
msgstr "Aura Cáustica"

#. ~ Description for Caustic Aura
#: lang/json/SPELL_from_json.py
msgid ""
"This spell suspends acid in a layer around you, corroding melee attackers "
"when struck and enhancing your melee damage."
msgstr ""
"Este hechizo suspende ácido en una capa a tu alrededor, corroyendo a los "
"atacantes cercanos cuando golpean y mejorando tu daño en el cuerpo a cuerpo."

#: lang/json/SPELL_from_json.py
msgid "Acid Claw"
msgstr "Garra Ácida"

#. ~ Description for Acid Claw
#: lang/json/SPELL_from_json.py
msgid ""
"Your claws glow with yellow acid energy, and as you swipe your claw a wave "
"of acid sweeps forth from it."
msgstr ""
"Tus garras brillan con una energía ácida amarilla, y cuando golpeás con "
"fuerza tu garra una onda de ácido sale hacia adelante."

#: lang/json/SPELL_from_json.py
msgid "Acid Bite"
msgstr "Mordida Ácida"

#. ~ Description for Acid Bite
#: lang/json/SPELL_from_json.py
msgid "Your maw drips with acid as you make a bite attack."
msgstr "Tus fauces chorrean ácido cuando pegás una mordida."

#: lang/json/SPELL_from_json.py
msgid "Dragon's Bite"
msgstr "Mordida de Dragón"

#. ~ Description for Dragon's Bite
#: lang/json/SPELL_from_json.py
msgid "The bite damage in Acid Bite."
msgstr "El daño de la mordida del hechizo Mordida Ácida."

#. ~ Description for Black Dragon Shell
#: lang/json/SPELL_from_json.py
msgid ""
"You channel your inner draconic magic to protect yourself from damage and "
"reflect some back as acid damage."
msgstr ""
"Canalizás tu magia dracónica interior para protegerte del daño y devolver "
"una parte como daño ácido."

#: lang/json/SPELL_from_json.py
msgid "Black Dragon Shell Retaliation"
msgstr "Represalia de Caparazón de Dragón Negro"

#. ~ Description for Black Dragon Shell Retaliation
#: lang/json/SPELL_from_json.py
msgid "Acid burst that punishes attackers."
msgstr "Un chorro de ácido que castiga a los atacantes."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Terror"
msgstr "Terror de Dragón"

#. ~ Description for Dragon Terror
#: lang/json/SPELL_from_json.py
msgid ""
"With an ear piercing roar, you channel the inner power of dragons and strike"
" fear into those who stand before you, slowing their escape from your "
"terror."
msgstr ""
"Con un rugido penetrante, canalizás tus energía interna de dragón y causás "
"miedo en aquellos frente a vos, haciendo lento su escape de tu terror."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Boost"
msgstr "Estimulación de Dragón"

#. ~ Description for Dragon Boost
#: lang/json/SPELL_from_json.py
msgid ""
"You let out a mighty roar as you infuse yourself with the power of Dragons."
msgstr ""
"Dejás salir un potente rugido mientras te infundís con el poder de los "
"Dragones."

#: lang/json/SPELL_from_json.py
msgid "Health recovery"
msgstr "Recuperación de salud"

#. ~ Description for Health recovery
#: lang/json/SPELL_from_json.py
msgid "minor health recovery spell associated with Dragon Boost."
msgstr ""
"Hechizo menor de recuperación de salud asociado con la Estimulación de "
"Dragón."

#: lang/json/SPELL_from_json.py
msgid "Stamina recovery"
msgstr "Recuperación de resistencia"

#. ~ Description for Stamina recovery
#: lang/json/SPELL_from_json.py
msgid "minor stamina recovery spell associated with Dragon Boost."
msgstr ""
"Hechizo menor de recuperación de resistencia asociado con la Estimulación de"
" Dragón."

#: lang/json/SPELL_from_json.py
msgid "Dragon Acid Spit"
msgstr "Escupida Ácida de Dragón"

#. ~ Description for Dragon Acid Spit
#: lang/json/SPELL_from_json.py
msgid ""
"You conjur up acidic spittle that you can shoot long distances as you close "
"on your terrified prey."
msgstr ""
"Conjurás un escupitajo ácido que podés disparar de lejos mientras te acercás"
" a tu aterrorizada presa."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Black Dragon Breath"
msgstr "Aliento de Dragón Negro"

#. ~ Description for Black Dragon Breath
#. ~ Description for Black Dragons' Breath
#: lang/json/SPELL_from_json.py
msgid "Spews a line of acid from your mouth."
msgstr "Escupe una línea de ácido de tu boca."

#: lang/json/SPELL_from_json.py
msgid "Crystallize Mana"
msgstr "Cristalizar Maná"

#. ~ Description for Crystallize Mana
#: lang/json/SPELL_from_json.py
msgid "Crystallizes mana into solid form"
msgstr "Cristalizar maná a forma sólida"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Mana Fatigue"
msgstr "Fatiga de Maná"

#. ~ Description for Mana Fatigue
#: lang/json/SPELL_from_json.py
msgid "Secondary effect of Crystallize Mana"
msgstr "Efecto secundario de Cristalizar Maná"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dark Sight"
msgstr "Vista Oscura"

#. ~ Description for Dark Sight
#: lang/json/SPELL_from_json.py
msgid "Gives you the power to see in the dark"
msgstr "Te da el poder de ver en la oscuridad"

#. ~ Message for SPELL 'Dark Sight'
#: lang/json/SPELL_from_json.py
msgid ""
"Your eyes glow green for a moment.  Now your sight can pierce the darkest "
"shadows."
msgstr ""
"Tus ojos brillan verdes por un momento. Ahora tu vista puede penetrar en las"
" sombras más oscuras."

#: lang/json/SPELL_from_json.py
msgid "Megablast"
msgstr "Megaexplosión"

#: lang/json/SPELL_from_json.py
msgid "Magical Light"
msgstr "Luz Mágica"

#: lang/json/SPELL_from_json.py
msgid "Blinding Flash"
msgstr "Destello Cegador"

#: lang/json/SPELL_from_json.py
msgid "Ethereal Grasp"
msgstr "Agarre Etéreo"

#: lang/json/SPELL_from_json.py
msgid "Obfuscated Body"
msgstr "Cuerpo Confundido"

#. ~ Description for Obfuscated Body
#: lang/json/SPELL_from_json.py
msgid ""
"A magical aura distorts light around your body, increasing the amount of "
"attacks you might dodge in a given turn."
msgstr ""
"Un aura mágica distorsiona la luz alrededor de tu cuerpo, aumentando la "
"cantidad de ataques que podés esquivar en ese turno."

#: lang/json/SPELL_from_json.py
msgid "Aura of Protection"
msgstr "Aura de Protección"

#: lang/json/SPELL_from_json.py
msgid "Translocate Self"
msgstr "Translocarse"

#. ~ Description for Translocate Self
#: lang/json/SPELL_from_json.py
msgid "Translocates the user to an attuned gate."
msgstr "Transloca al usuario a una puerta afín."

#: lang/json/SPELL_from_json.py
msgid "Acid Resistance"
msgstr "Resistencia al Ácido"

#. ~ Description for Acid Resistance
#. ~ Description for Greater Acid Resistance
#: lang/json/SPELL_from_json.py
msgid "Protects the user from acid."
msgstr "Protege al usuario del ácido."

#: lang/json/SPELL_from_json.py
msgid "Greater Acid Resistance"
msgstr "Resistencia Mayor al Ácido"

#: lang/json/SPELL_from_json.py
msgid "Template Spell"
msgstr "Plantilla de Hechizo"

#. ~ Description for Template Spell
#: lang/json/SPELL_from_json.py
msgid "This is a template to show off all the available values"
msgstr "Es la plantilla para mostrar todos los valores disponibles"

#. ~ Message for SPELL 'Template Spell'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "As you cast %s, your ears pops!"
msgstr "Cuando lanzás %s, ¡tus orejas truenan!"

#: lang/json/SPELL_from_json.py
msgid "debug push no aoe"
msgstr "debug empujar sin área"

#. ~ Description for debug push no aoe
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 0"
msgstr "empuja toda clase de objetos en un área de 0"

#: lang/json/SPELL_from_json.py
msgid "debug push blast"
msgstr "debug empujón estallido"

#. ~ Description for debug push blast
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 3 in a blast pattern"
msgstr "empuja toda clase de objetos en un área de 3 en estallido"

#: lang/json/SPELL_from_json.py
msgid "Spawn Debug Monsters"
msgstr "Crear Monstruos Debug"

#. ~ Description for Spawn Debug Monsters
#: lang/json/SPELL_from_json.py
msgid "Set level to number of monsters spawned."
msgstr "Establece nivel al número de monstruos creados."

#. ~ Message for SPELL 'Spawn Debug Monsters'
#. ~ Message for SPELL 'Debug HP Spell'
#. ~ Message for SPELL 'Debug Bionic Spell'
#. ~ Message for SPELL 'Debug effect spell'
#. ~ Message for SPELL 'Test Area Pull'
#. ~ Message for SPELL 'Test Area Pull (Field)'
#. ~ Message for SPELL 'Test Area Push'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "Debug spell %s cast."
msgstr "Conjurado %s hechizo debug."

#: lang/json/SPELL_from_json.py
msgid "Debug Stamina Spell"
msgstr "Hechizo Resistencia Debug"

#. ~ Description for Debug Stamina Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little stamina"
msgstr "Usa poca resistencia"

#. ~ Message for SPELL 'Debug Stamina Spell'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "Debug spell [ %s ] has no effect.  Debug warning is expected."
msgstr "Hechizo debug [ %s ] no tiene efecto. Advertencia de debug probable."

#: lang/json/SPELL_from_json.py
msgid "Debug polymorph"
msgstr "Polimorfia debug"

#. ~ Description for Debug polymorph
#: lang/json/SPELL_from_json.py
msgid "Well you wanted to lose weight, right?"
msgstr "Bueno, querias bajar unos kilitos, ¿no?"

#: lang/json/SPELL_from_json.py
msgid "Debug HP Spell"
msgstr "Hechizo PV Debug"

#. ~ Description for Debug HP Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little HP"
msgstr "Usa poco HP"

#: lang/json/SPELL_from_json.py
msgid "Debug Bionic Spell"
msgstr "Hechizo Biónico Debug"

#. ~ Description for Debug Bionic Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little Bionic Power"
msgstr "Usa poco Poder Biónico"

#: lang/json/SPELL_from_json.py
msgid "Debug effect spell"
msgstr "Hechizo efecto debug"

#. ~ Description for Debug effect spell
#: lang/json/SPELL_from_json.py
msgid "Adds an effect to the target"
msgstr "Agrega un efecto al objetivo"

#: lang/json/SPELL_from_json.py
msgid "Test Area Pull"
msgstr "Prueba de Acercar Área"

#. ~ Description for Test Area Pull
#: lang/json/SPELL_from_json.py
msgid "Pulls all objects inside."
msgstr "Acerca todos los objetos que estén en el área."

#: lang/json/SPELL_from_json.py
msgid "Test Area Pull (Field)"
msgstr "Prueba de Acercar Área (Campo)"

#. ~ Description for Test Area Pull (Field)
#: lang/json/SPELL_from_json.py
msgid "Pulls field contents tiles inside."
msgstr "Acerca el contenido del campo que esté adentro."

#: lang/json/SPELL_from_json.py
msgid "Test Area Push"
msgstr "Prueba de Empujar Área"

#. ~ Description for Test Area Push
#: lang/json/SPELL_from_json.py
msgid "Pushes all objects outside."
msgstr "Empuja todos los objetos que estén en el área."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Debug Full Protection"
msgstr "Proteccion Total Debug"

#. ~ Description for Debug Full Protection
#. ~ Description of effect 'Debug Full Protection'.
#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "You can not be harmed by anything."
msgstr "No te puede dañar nada."

#. ~ Message for SPELL 'Debug Full Protection'
#: lang/json/SPELL_from_json.py
msgid "You are invulnerable, nothing can harm you!"
msgstr "Sos invulnerable, ¡nada te puede hacer daño!"

#: lang/json/SPELL_from_json.py
msgid "Debug Feather Falling"
msgstr "Debug Caída de Pluma"

#. ~ Description for Debug Feather Falling
#: lang/json/SPELL_from_json.py
msgid "You  are light as a feather and fall like."
msgstr "Sos liviano como una pluma y caerás así de suave."

#. ~ Message for SPELL 'Debug Feather Falling'
#: lang/json/SPELL_from_json.py
msgid "You eat a feather!"
msgstr "¡Te comés una pluma!"

#: lang/json/SPELL_from_json.py
msgid "Black Dragons' Breath"
msgstr "Aliento de Dragón Negro"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Vegetative Grasp"
msgstr "Agarre Vegetativo"

#: lang/json/SPELL_from_json.py
msgid "Root Strike"
msgstr "Golpe de Raíz"

#: lang/json/SPELL_from_json.py
msgid "Wooden Shaft"
msgstr "Asta de Madera"

#: lang/json/SPELL_from_json.py
msgid "Nature's Bow"
msgstr "Arco Natural"

#: lang/json/SPELL_from_json.py
msgid "Nature's Trance"
msgstr "Trance Natural"

#: lang/json/SPELL_from_json.py
msgid "Bag of Cats"
msgstr "Bolsa de Gatos"

#: lang/json/SPELL_from_json.py
msgid "Cause Bear"
msgstr "Causar Oso"

#. ~ Description for Cause Bear
#: lang/json/SPELL_from_json.py
msgid ""
"This spell appears to be very smudged.  You're fairly sure the name should "
"be Cause Fear, but you're also fairly sure it won't have the desired effect "
"because the instructions are hardly legible.  No time like the Cataclysm to "
"find out, though!"
msgstr ""
"Este hechizo parece estar muy manchado. Estás bastante seguro que el nombre "
"debería ser Causar Miedo, pero también estás bastante seguro que no va a "
"tener el efecto deseado porque las instrucciones son casi ilegibles. ¡No hay"
" mejor momento que el Cataclismo para ver qué pasa!"

#: lang/json/SPELL_from_json.py
msgid "Kill Fungus"
msgstr "Matar Hongo"

#. ~ Description for Kill Fungus
#: lang/json/SPELL_from_json.py
msgid "Kills fungus affected areas"
msgstr "Mata las áreas afectadas por hongos"

#: lang/json/SPELL_from_json.py
msgid "Druid Rune"
msgstr "Runa Druida"

#. ~ Description for Druid Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Druids.  You can use the rune "
"as a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Druidas. Podés usar la "
"runa como catalizador en recetas."

#: lang/json/SPELL_from_json.py
msgid "Purification Seed"
msgstr "Semilla de Purificación"

#. ~ Description for Purification Seed
#: lang/json/SPELL_from_json.py
msgid ""
"You summon a gift of the earth which will purify water.  Rapidly degrades if"
" not utilized."
msgstr ""
"Conjurás un regalo de la tierra que podés usar para purificar agua. Se "
"degrada rápidamente si no se utiliza."

#: lang/json/SPELL_from_json.py
msgid "Sacrificial Regrowth"
msgstr "Resurgimiento Sacrificial"

#: lang/json/SPELL_from_json.py
msgid "Sacrificial Healing"
msgstr "Curación Sacrificial"

#: lang/json/SPELL_from_json.py
msgid "Tornskin"
msgstr "Piel de Espiras"

#. ~ Description for Tornskin
#: lang/json/SPELL_from_json.py
msgid ""
"This spell, which resembles Thornskin through the sap & needles covering the"
" page, seemed to involve thorns and bleeding wounds.  The marred words may "
"have altered the function."
msgstr ""
"Este hechizo, que te recuerda a Piel de Espinas por la savia y púas "
"recubriendo la página, parece involucrar espinas y heridas sangrantes. Las "
"palabras deterioradas pueden haber alterado su función."

#: lang/json/SPELL_from_json.py
msgid "Feral Form"
msgstr "Forma Salvaje"

#. ~ Description for Feral Form
#: lang/json/SPELL_from_json.py
msgid ""
"This spell unleashes your inner beast, growing claws & fangs to rend your "
"foes limb from limb."
msgstr ""
"Este hechizo libera a tu bestia interna, te crecen garras y colmillos para "
"rasgar a tus enemigos miembro por miembro."

#: lang/json/SPELL_from_json.py
msgid "Summon Wolf"
msgstr "Conjurar Lobo"

#. ~ Description for Summon Wolf
#: lang/json/SPELL_from_json.py
msgid "Call to the wilds for aid from some wolves."
msgstr "Invocar a lo salvaje para que ayude con unos lobos."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Nature's Commune"
msgstr "Comunión Natural"

#. ~ Description for Nature's Commune
#: lang/json/SPELL_from_json.py
msgid ""
"You concentrate on the nature around you and commune with it, improving your"
" health and calming the nearby wildlife."
msgstr ""
"Te concentrás en la naturaleza a tu alrededor y entrás en comunión con ella,"
" mejorando tu salud y calmando a los animales cercanos."

#: lang/json/SPELL_from_json.py
msgid "Seed of Growth"
msgstr "Semilla de Crecimiento"

#: lang/json/SPELL_from_json.py
msgid "Stonefist"
msgstr "Puño Pétreo"

#: lang/json/SPELL_from_json.py
msgid "Seismic Stomp"
msgstr "Pisotón Sísmico"

#: lang/json/SPELL_from_json.py
msgid "Stone's Endurance"
msgstr "Resistencia Pétrea"

#: lang/json/SPELL_from_json.py
msgid "Shardspray"
msgstr "Esquirlas"

#: lang/json/SPELL_from_json.py
msgid "Piercing Bolt"
msgstr "Rayo Penetrante"

#: lang/json/SPELL_from_json.py
msgid "Shardstorm"
msgstr "Tormenta de Esquirlas"

#: lang/json/SPELL_from_json.py
msgid "Rockbolt"
msgstr "Rayo de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Move Earth"
msgstr "Mover Tierra"

#. ~ Description for Move Earth
#: lang/json/SPELL_from_json.py
msgid "Your essense flows around you, and the earth follows."
msgstr "Tu esencia fluye a tu alrededor, y la tierra le sigue."

#: lang/json/SPELL_from_json.py
msgid "Earthshaper Rune"
msgstr "Runa Terraformante"

#. ~ Description for Earthshaper Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Earthshapers.  You can use the"
" rune as a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Terraformantes. Podés "
"usar la runa como catalizador en recetas."

#: lang/json/SPELL_from_json.py
msgid "Clairvoyance"
msgstr "Clarividencia"

#: lang/json/SPELL_from_json.py
msgid "Stoneskin"
msgstr "Piel Pétrea"

#: lang/json/SPELL_from_json.py
msgid "Pillar of Stone"
msgstr "Pilar de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Pillar Side Effect"
msgstr "Efecto Secundario de Pilar"

#. ~ Description for Pillar Side Effect
#: lang/json/SPELL_from_json.py
msgid "Bash effect that follows, levels reduce damage and AoE."
msgstr ""
"Es un efecto de golpe que le sigue, los niveles reducen el daño y el área "
"que afecta."

#: lang/json/SPELL_from_json.py
msgid "Twisted Restoration"
msgstr "Restoración Retorcida"

#. ~ Description for Twisted Restoration
#: lang/json/SPELL_from_json.py
msgid ""
"This spell overclocks your heart, generating new flesh and muscle.  It is "
"unwise to use this in immediate danger, and may be fatal if done in critical"
" condition."
msgstr ""
"Este hechizo acelera tu corazón, generando carne y músculos nuevos. No se "
"aconseja usar esto ante un peligro inmediato, y puede ser fatal si se lo "
"hace en condiciones críticas."

#: lang/json/SPELL_from_json.py
msgid "Improved Twisted Restoration"
msgstr "Restoración Retorcida Improvisada"

#. ~ Description for Improved Twisted Restoration
#: lang/json/SPELL_from_json.py
msgid ""
"This spell overclocks your heart, generating new flesh and muscle.  It is "
"unwise to use this in immediate danger, and may be fatal if done in critical"
" condition.  Improved brewing mitigates the strain of the spell."
msgstr ""
"Este hechizo acelera tu corazón, generando carne y músculos nuevos. No se "
"aconseja usar esto ante un peligro inmediato, y puede ser fatal si se lo "
"hace en condiciones críticas. Una destilación mejorada mitiga la presión del"
" hechizo."

#: lang/json/SPELL_from_json.py
msgid "Conjure Throwing Blade I"
msgstr "Conjurar Cuchillas Arrojadizas I"

#. ~ Description for Conjure Throwing Blade I
#: lang/json/SPELL_from_json.py
msgid "conjures 3 throwing knives"
msgstr "conjura 3 cuchillos arrojadizos"

#. ~ Message for SPELL 'Conjure Throwing Blade I'
#: lang/json/SPELL_from_json.py
msgid ""
"You activate your ring and three throwing knives appear, ready to throw!"
msgstr ""
"Activás el anillo y aparecen tres cuchillos arrojadizos, ¡listos para ser "
"lanzados!"

#: lang/json/SPELL_from_json.py
msgid "Recover Mana"
msgstr "Recuperar Maná"

#. ~ Description for Recover Mana
#: lang/json/SPELL_from_json.py
msgid "You regain mana."
msgstr "Recuperás maná."

#. ~ Message for SPELL 'Recover Mana'
#: lang/json/SPELL_from_json.py
msgid "You start regenerating mana!"
msgstr "¡Empezás a regenerar maná!"

#. ~ Message for SPELL '{'str': 'Pain'}'
#: lang/json/SPELL_from_json.py
msgid ""
"Your veins feel like they are on fire!\n"
"You start regenerating mana!"
msgstr ""
"¡Sentís las venas como si estuvieran en fuego!\n"
"¡Empezás a regenerar maná!"

#: lang/json/SPELL_from_json.py
msgid "Lupercalian Release"
msgstr "Liberación Lupercalia"

#. ~ Description for Lupercalian Release
#: lang/json/SPELL_from_json.py
msgid ""
"This spell transforms you into a werewolf.  There may be some cons to this."
msgstr ""
"Este hechizo te transforma en un hombre lobo. Eso puede tener ventajas y "
"desventajas."

#. ~ Description for Wolfsbane
#: lang/json/SPELL_from_json.py
msgid "The tip of the spear glows white hot as you strike."
msgstr ""
"La punta de la lanza brilla de un blanco incandescente mientras atacás."

#: lang/json/SPELL_from_json.py
msgid "Point Flare"
msgstr "Fulgor"

#: lang/json/SPELL_from_json.py
