#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Helicopter Pilot"
msgstr "Piloto de Helicóptero"

#. ~ Profession (male Helicopter Pilot) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You got your pilot's license, and earned a living ferrying businessmen and "
"tourists around.  The Cataclysm has grounded you for now, but the sky still "
"calls to you…"
msgstr ""
"Tenés tu licencia de piloto y te ganaste la vida transportando gente de "
"negocios y turistas. El Cataclismo no te dejó volar más por ahora, pero "
"todavía sentís al cielo llamándote…"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Helicopter Pilot"
msgstr "Piloto de Helicóptero"

#. ~ Profession (female Helicopter Pilot) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
