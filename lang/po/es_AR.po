msgstr[1] "poleras"

#. ~ Use action msg for turtleneck.
#. ~ Use action msg for turtleneck (rolled).
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You adjust the neck and collar of the turtleneck."
msgstr "Te ajustás el cuello de la polera."

#. ~ Description for turtleneck
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A tasteful wool turtleneck, modeled after cashmere.  Unemcumbering and warm,"
" but lacking storage."
msgstr ""
"Es una polera de lana de buen gusto, modelado de de cachemira. Cómodo y "
"abrigado pero sin capacidad de almacenamiento."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "turtleneck (rolled)"
msgid_plural "turtlenecks (rolled)"
msgstr[0] "polera (enrollada)"
msgstr[1] "poleras (enrolladas)"

#. ~ Description for turtleneck (rolled)
#: lang/json/TOOL_ARMOR_from_json.py
msgid "This wool turtleneck's neck is rolled out of the way of the mouth."
msgstr ""
"El cuello de esta polera de lana está bajo para que no te tape la boca."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "turtleneck shirt"
msgid_plural "turtleneck shirts"
msgstr[0] "remera polera"
msgstr[1] "remeras polera"

#. ~ Use action msg for turtleneck shirt.
#. ~ Use action msg for turtleneck shirt (rolled).
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You adjust the neck and collar of the turtleneck shirt."
msgstr "Ajustás el cuello de la remera polera."

#. ~ Description for turtleneck shirt
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A tasteful cotton turtleneck shirt, thick for a shirt, thin for a sweater "
"and completely lacking storage."
msgstr ""
"Es una remera polera de algodón de buen gusto, gruesa comparada con una "
"remera común pero fina comparada con un suéter y carente de capacidad de "
"almacenamiento."

#: lang/json/TOOL_ARMOR_from_json.py
