msgstr "Cocino para mi comunidad."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
msgid "food guard"
msgstr "guardia de comida"

#: lang/json/npc_class_from_json.py
msgid "I'm guarding the food."
msgstr "Estoy cuidando la comida."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
msgid "Mr Lapin"
msgstr "Mr. Lapin"

#: lang/json/npc_class_from_json.py
msgid "I raise rabbits."
msgstr "Crío conejos."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
msgid "Barry Isherwood"
msgstr "Barry Isherwood"

#: lang/json/npc_class_from_json.py
msgid "Missing member of the Isherwood family."
msgstr "Miembro perdido de la familia Isherwood."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
msgid "Carlos Isherwood"
msgstr "Carlos Isherwood"

#: lang/json/npc_class_from_json.py
msgid "I'm Jesse's husband, part of the Isherwood family"
msgstr "Soy el marido de Jesse, soy parte de la familia Isherwood."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
msgid "Chris Isherwood"
msgstr "Chris Isherwood"

#: lang/json/npc_class_from_json.py
msgid "I'm Jesse and Carlos' son, part of the Isherwood family"
msgstr "Soy el hijo de Jesse y Carlos, soy parte de la familia Isherwood."

