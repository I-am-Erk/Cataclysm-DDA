#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The earth is scorched clean!"
msgstr "¡La tierra queda quemada!"

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The earth is upheaved!"
msgstr "¡La tierra está levantada!"

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The earth here does not listen to your command to move."
msgstr "Acá la tierra no escucha tu comando para que se mueva."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The pit has deepened further."
msgstr "El pozo ha sido hecho más profundo."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "More debris shifts out of the pit."
msgstr "Más escombros salen del pozo."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The earth moves out of the way for you."
msgstr "La tierra se mueve y se corre de tu camino."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The rocks here are ground into sand."
msgstr "Las piedras acá son molidas y convertidas en arena."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The rock crumbles to dust."
msgstr "La roca se desmenuza y se hace polvo."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "All the dust in the air here falls to the ground."
msgstr "Todo el polvo en el aire cae al suelo."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The fungus here dies back."
msgstr "Los hongos acá mueren."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid ""
"The ground shakes, a section of unnaturally smooth stone wall rising up."
msgstr ""
"La tierra tiembla, un fragmento de pared de piedra sobrenaturalmente lisa se"
" levanta."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The dead tree regrows."
msgstr "El árbol muerto vuelve a crecer."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "Life springs anew from the dead grass."
msgstr "La vida vuelve a salir del pasto muerto."

#: lang/json/ter_furn_transform_messages_from_json.py
msgid "The door opens forcefully!"
msgstr "¡La puerta se abre enfáticamente!"

#: lang/json/terrain_from_json.py
msgid "broken diesel tank"
msgstr "tanque de gasoil roto"

#. ~ Description for centrifuge
#: lang/json/terrain_from_json.py
msgid ""
"This is a centrifuge, a liquid separating device with an automated analyzer "
"unit.  It could be used to analyze a medical fluid sample, such as blood, if"
" a test tube was placed in it."
msgstr ""
"Es un dispositivo centrífugo para separar líquidos, con una unidad de "
"análisis automatizada. Puede ser usada para analizar muestras médicas de "
"fluidos, como la sangre, si se le pone un tubo de ensayo."

#: lang/json/terrain_from_json.py
msgid "plutonium generator"
msgstr "generador de plutonio"

#. ~ Description for plutonium generator
#: lang/json/terrain_from_json.py
msgid ""
"This imposing apparatus harnesses the power of the atom.  Refined nuclear "
"fuel is 'burned' to provide nearly limitless electrical power.  It's not "
"doing much good here though.  Perhaps it could be salvaged for other "
"purposes."
msgstr ""
"Este impresionante aparato aprovecha la energía del átomo. El combustible "
"refinado nuclear se 'quema' para brindar una energía eléctrica casi "
"ilimitada. Igual, no sirve para mucho acá. Tal vez pueda ser utilizado para "
"otros propósitos."

#. ~ Description for old machinery
#: lang/json/terrain_from_json.py
msgid "Assorted old machinery.  You could scavenge it for parts."
msgstr ""
"Es una variedad de maquinaria vieja. Podrías recuperar algunas partes de "
"acá."

#: lang/json/terrain_from_json.py
msgid "scorched earth"
msgstr "tierra calcinada"

#: lang/json/terrain_from_json.py
msgid "alder tree"
msgstr "aliso"

#. ~ Description for alder tree
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous flowering tree with serrate, scalloped, round-obovate leaves, "
"commonly forming dense groves alongside water."
msgstr ""
"Es un árbol floreciente de hoja caduca con hojas dentadas, ondeadas y "
"obovadas, que comúnmente forma densas arboledas cerca del agua."

#: lang/json/terrain_from_json.py
msgid "walkway"
msgstr "pasarela peatonal"

#. ~ Description for walkway
#: lang/json/terrain_from_json.py
msgid ""
"A metallic bridge commonly used in industrial settings to meet specified "
"safety standards."
msgstr ""
"Es un puente metálico comúnmente utilizado en industrias para cumplir con "
"las reglas de seguridad establecidas."

#. ~ Description for dock
#. ~ Description for shallow bridge
#: lang/json/terrain_from_json.py
msgid "A wooden platform held by a support made of logs dug into the ground."
msgstr ""
"Es una plataforma de madera sostenida por unos soportes hechos con troncos, "
"enterrados en el suelo."

#: lang/json/terrain_from_json.py
msgid "deep dock pile"
msgstr "pilote de muelle profundo"

#. ~ Description for deep dock pile
#: lang/json/terrain_from_json.py
msgid ""
"A sturdy pile made of wood extending all the way to the riverbed.  A frame "
"will be required to support a surface."
msgstr ""
"Es un pilote robusto hecho de madera que se extiende hasta el lecho del río."
" Se necesita una estructura para que pueda sostener una superficie."

#: lang/json/terrain_from_json.py
msgid "deep dock frame"
msgstr "estructura de muelle profundo"

#. ~ Description for deep dock frame
#: lang/json/terrain_from_json.py
msgid ""
"A log frame secured atop a wooden pile.  Adding a wood surface will make "
"this into a proper dock section."
msgstr ""
"Es una estructura de troncos puesta sobre un pilote de madera. Si se le "
"agrega una superficie de madera se convertirá en una sección apropiada de "
"muelle."

#: lang/json/terrain_from_json.py
msgid "deep dock"
msgstr "muelle profundo"

#. ~ Description for deep dock
#: lang/json/terrain_from_json.py
msgid ""
"A wooden platform held by a tall wooden pile that extend to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr ""
"Es una plataforma de madera sostenida por un pilote alto de madera que se "
"extiende hasta el lecho del río. Muy robusto y es probable que viva más que "
"vos."

#: lang/json/terrain_from_json.py
msgid "shallow bridge"
msgstr "puente poco profundo"

#: lang/json/terrain_from_json.py
msgid "pontoon bridge"
msgstr "puente flotante"

#. ~ Description for pontoon bridge
#: lang/json/terrain_from_json.py
msgid ""
"A floating temporary bridge over still water, like the ones armies used to "
"make to cross lakes."
msgstr ""
"Es un puente colgante temporario sobre espejos de agua, como los que usa el "
"ejército para cruzar lagos."

#: lang/json/terrain_from_json.py
msgid "river bridge"
msgstr "puente sobre río"

#. ~ Description for river bridge
#: lang/json/terrain_from_json.py
msgid ""
"A floating temporary bridge over flowing water, like the ones armies used to"
" make to cross rivers."
msgstr ""
"Es un puente colgante temporario sobre agua que fluye, como los que usa el "
"ejército para cruzar ríos."

#: lang/json/terrain_from_json.py
msgid "bridge pavement"
msgstr "pavimento puente"

#. ~ Description for bridge pavement
#: lang/json/terrain_from_json.py
msgid "A bridge section made out of concrete and metal."
msgstr "Es una sección de puente hecha de concreto y metal."

#: lang/json/terrain_from_json.py
msgid "concrete cracking and metal screeching!"
msgstr "¡rotura de concreto y chillido de metal!"

#: lang/json/terrain_from_json.py
msgid "bridge yellow pavement"
msgstr "pavimento amarillo puente"

#. ~ Description for bridge yellow pavement
#: lang/json/terrain_from_json.py
msgid "A bridge section made out of concrete and metal.  It's painted yellow."
msgstr ""
"Es una sección de puente hecha de concreto y metal. Está pintada de "
"amarillo."

#: lang/json/terrain_from_json.py
msgid "bridge sidewalk"
msgstr "vereda puente"

#. ~ Description for bridge sidewalk
#: lang/json/terrain_from_json.py
msgid "The sidewalk section of a concrete bridge."
msgstr "Es la vereda de un puente de concreto."

#. ~ Description for dock
#: lang/json/terrain_from_json.py
msgid ""
"A metal platform held by a support made of concrete set into the ground."
msgstr ""
"Es una plataforma de metal sostenida por un soporte hecho de concreto "
"enterrado en el suelo."

#. ~ Description for deep dock pile
#: lang/json/terrain_from_json.py
msgid ""
"A sturdy pile made of poured concrete extending all the way to the riverbed."
"  A metal frame will be required to support a surface."
msgstr ""
"Es un pilote robusto hecho de concreto que se extiende hasta el lecho del "
"río. Se necesita una estructura de metal para que pueda sostener una "
"superficie."

#. ~ Description for deep dock frame
#: lang/json/terrain_from_json.py
msgid ""
"A metal frame secured atop a concrete pile.  Adding a metal surface will "
"make this into a proper dock section."
msgstr ""
"Es una estructura de metal puesta sobre un pilote de concreto. Si se le "
"agrega una superficie de metal se convertirá en una sección apropiada de "
"muelle."

#. ~ Description for deep dock
#: lang/json/terrain_from_json.py
msgid ""
"A metal platform held by a tall metal pile that extends to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr ""
"Es una plataforma de metal sostenida por un pilote alto de metal que se "
"extiende hasta el lecho del río. Muy robusto y es probable que viva más que "
"vos."

#: lang/json/terrain_from_json.py
msgid "metal floating dock"
msgstr "muelle flotante de metal"

#. ~ Description for metal floating dock
#: lang/json/terrain_from_json.py
msgid "A floating temporary dock, anchored to keep it from drifting away."
msgstr ""
"Es un muelle flotante temporario, anclado para evitar que se vaya a la "
"deriva."

#: lang/json/terrain_from_json.py
msgid "closed laminated glass door"
msgstr "puerta de vidrio laminado cerrada"

#. ~ Description for closed laminated glass door
#: lang/json/terrain_from_json.py
msgid ""
"A closed laminated glass door is composed layers of glass and plastic held "
"together by an interlayer."
msgstr ""
"Es una puerta de vidrio laminado cerrada compuesta de capas de vidrio y "
"plástico unidas por un interlaminado."

#: lang/json/terrain_from_json.py
msgid "open laminated glass door"
msgstr "puerta de vidrio laminado abierta"

#. ~ Description for open laminated glass door
#: lang/json/terrain_from_json.py
msgid ""
"Laminated glass door is composed layers of glass and plastic held together "
"by an interlayer.  Yep, it's open."
msgstr ""
"Es una puerta de vidrio laminado compuesta de capas de vidrio y plástico "
"unidas por un interlaminado. Sí, está abierta."

#: lang/json/terrain_from_json.py
msgid "closed ballistic glass door"
msgstr "puerta de vidrio balístico cerrada"

#. ~ Description for closed ballistic glass door
#. ~ Description for ballistic glass
#: lang/json/terrain_from_json.py
msgid "Ballistic glass consists of layers of laminated glass."
msgstr "Es un vidrio balístico que consiste en capas de vidrio laminado."

#: lang/json/terrain_from_json.py
msgid "open ballistic glass door"
msgstr "puerta de vidrio balístico abierta"

#. ~ Description for open ballistic glass door
#: lang/json/terrain_from_json.py
msgid ""
"Ballistic glass consists of layers of laminated glass.  Yep, it's open."
msgstr ""
"Es un vidrio balístico que consiste en capas de vidrio laminado. Sí, está "
"abierta."

#: lang/json/terrain_from_json.py
msgid "closed reinforced glass door"
msgstr "puerta de vidrio reforzada cerrada"

#. ~ Description for closed reinforced glass door
#: lang/json/terrain_from_json.py
msgid ""
"A closed glass door reinforced with woven steel wires in a stylish, but "
"practical pattern."
msgstr ""
"Es una puerta de vidrio reforzado que está cerrada, y tiene alambres de "
"acero entretejidos en un patrón práctico y con estilo."

#: lang/json/terrain_from_json.py
msgid "open reinforced glass door"
msgstr "puerta de vidrio reforzado abierta"

#. ~ Description for open reinforced glass door
#: lang/json/terrain_from_json.py
msgid ""
"A glass door reinforced with woven steel wires in a stylish, but practical "
"pattern.  Yep, it's open."
msgstr ""
"Es una puerta de vidrio reforzado con alambres de acero entretejidos en un "
"patrón práctico y con estilo. Y sí, está abierta."

#: lang/json/terrain_from_json.py
msgid "closed wood door"
msgstr "puerta de madera cerrada"

#. ~ Description for closed wood door
#: lang/json/terrain_from_json.py
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too."
msgstr ""
"Es una puerta común de madera que no parece muy resistente. Y probablemente,"
" se prenda fuego fácil, también."

#: lang/json/terrain_from_json.py
msgid "open wood door"
msgstr "puerta de madera abierta"

#. ~ Description for open wood door
#: lang/json/terrain_from_json.py
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one is wide open."
msgstr ""
"Es una puerta común de madera que no parece muy resistente. Y probablemente,"
" se prenda fuego fácil, también. Está abierta."

#: lang/json/terrain_from_json.py
msgid "damaged wood door"
msgstr "puerta dañada de madera"

#. ~ Description for damaged wood door
#: lang/json/terrain_from_json.py
msgid ""
"A trashed wooden door, that is more of an obstacle than a door.  Also, you "
"can see right through it.  It could be boarded up with a few planks."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "empty door frame"
msgstr "marco vacío de puerta"

#. ~ Description for empty door frame
#: lang/json/terrain_from_json.py
msgid ""
"An empty door frame made from planks and nails.  A variety of doors could be"
" constructed here."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "closed glass door"
msgstr "puerta de vidrio cerrada"

#. ~ Description for closed glass door
#: lang/json/terrain_from_json.py
msgid ""
"A sliding glass door, the kind that was on social media with people and "
"animals running into.  This one is closed, so don't hurt yourself."
msgstr ""
"Es una puerta corrediza de vidrio, esa que aparece en los fails con personas"
" y animales chocándosela. Esta está cerrada, así que cuidado."

#: lang/json/terrain_from_json.py
msgid "open glass door"
msgstr "puerta de vidrio abierta"

#. ~ Description for open glass door
#. ~ Description for open frosted glass door
#: lang/json/terrain_from_json.py
msgid ""
"A sliding glass door that has been left open for all manner of things to "
"travel through."
msgstr ""
"Es una puerta corrediza de vidrio que ha sido dejada abierta para que todo "
"lo que quiera pasar, pase por ahí."

#: lang/json/terrain_from_json.py
msgid "closed wood door with peephole"
msgstr "puerta de madera cerrada con mirilla"

#. ~ Description for closed wood door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole."
msgstr ""
"Es un puerta común de madera con la excepción de que esta tiene mirilla. Si "
"lo examinás de cerca, vas a poder espiar por el agujerito."

#: lang/json/terrain_from_json.py
msgid "damaged wood door with peephole"
msgstr "puerta dañada de madera con mirilla"

#. ~ Description for damaged wood door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"Bad news is the peephole is broken and you can't look outside the door.  "
"Good news is the door is nearly broken down, so there's nothing blocking the"
" view.  A few planks, nails and the right tools could patch up all the "
"damage."
msgstr ""
"Las malas noticias son que la mirilla está rota y no podés espiar por ahí. "
"Las buenas noticias es que la puerta está prácticamente destrozada, así que "
"no hay nada que te tape la visión. Con unas tablas de madera, clavos y "
"herramientas adecuadas podrías repararla."

#: lang/json/terrain_from_json.py
msgid "open wood door with peephole"
msgstr "puerta de madera abierta con mirilla"

#. ~ Description for open wood door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  "
"Although, you don't need to peek through it since the door is open anyway."
msgstr ""
"Es un puerta común de madera con la excepción de que esta tiene mirilla. Si "
"lo examinás de cerca, vas a poder espiar por el agujerito. De todas maneras,"
" no necesitás espiar nada porque la puerta está abierta."

#: lang/json/terrain_from_json.py
msgid "closed reinforced wood door"
msgstr "puerta de madera reforzada cerrada"

#. ~ Description for closed reinforced wood door
#: lang/json/terrain_from_json.py
msgid ""
"Just like other wooden doors, except this one has layers of nailed in planks"
" and additional hinge for reinforcement.  It might be barricaded, but still "
"susceptible to fire."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "damaged reinforced wood door"
msgstr "puerta dañada de madera reforzada"

#. ~ Description for damaged reinforced wood door
#: lang/json/terrain_from_json.py
msgid ""
"There are splintering planks and visible holes in the wood, it looks like it"
" could be smashed apart if not repaired."
msgstr ""
"Hay tablas rotas y agujeros en la madera, parece que se puede romper "
"fácilmente si no se la repara."

#: lang/json/terrain_from_json.py
msgid "open reinforced wood door"
msgstr "puerta de madera reforzada abierta"

#. ~ Description for open reinforced wood door
#: lang/json/terrain_from_json.py
msgid ""
"Just like other wooden doors, except this one has layers of nailed in planks"
" for reinforcement.  It might be fortified, but still susceptible to fire.  "
"It's open so it's not stopping anything right now."
msgstr ""

#. ~ Description for closed wood door
#: lang/json/terrain_from_json.py
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has an extra keyhole, so it's likely locked.  You "
"could pry it open or pick the lock."
msgstr ""
"Es una puerta común de madera que no parece muy resistente. Y probablemente,"
" se prenda fuego fácil, también. Esta tiene otra cerradura más, así que más "
"que seguro que está cerrada. Podrías intentar forzar la cerradura."

#. ~ Description for closed wood door
#: lang/json/terrain_from_json.py
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has a deadbolt keyhole, so it's likely locked.  You "
"could pry it open or pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"Es una puerta común de madera que no parece muy resistente. Y probablemente,"
" se prenda fuego fácil, también. Esta tiene una cerradura de seguridad, así "
"que debe estar cerrada. Podrías intentar abrirla o forzar la cerradura, o "
"abrir la cerradura de seguridad desde adentro."

#. ~ Description for closed wood door
#: lang/json/terrain_from_json.py
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  This "
"one has a deadbolt keyhole, so it's likely locked.  You could pry it open or"
" pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"Es un puerta común de madera con la excepción de que esta tiene mirilla. Si "
"lo examinás de cerca, vas a poder espiar por el agujerito. Esta puerta tiene"
" una cerradura de seguridad, así que debe estar cerrada. Podrías usar un "
"barreta o forzar la cerradura, o abrir la cerradura de seguridad desde "
"adentro."

#: lang/json/terrain_from_json.py
msgid "closed door curtain"
msgstr "puerta de cortina cerrada"

#. ~ Description for closed door curtain
#: lang/json/terrain_from_json.py
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else."
msgstr ""
"Son cortinas reutilizadas de una ventana que funcionan como una puerta. "
"Podría ser desarmada fácilmente o reubicada."

#: lang/json/terrain_from_json.py
msgid "closed makeshift door"
msgstr "puerta improvisada cerrada"

#. ~ Description for closed makeshift door
#: lang/json/terrain_from_json.py
msgid ""
"A makeshift screen consisting of planks bound together with vertical rope "
"hanging from the top of the doorway.  Could be easily taken down and re-"
"purposed."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "wham."
msgstr "zas."

#: lang/json/terrain_from_json.py
msgid "open door curtain"
msgstr "puerta de cortina abierta"

#. ~ Description for open door curtain
#: lang/json/terrain_from_json.py
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else.  These curtains are open, "
"bundled and tied next to the doorway."
msgstr ""
"Son cortinas reutilizadas de una ventana que funcionan como una puerta. "
"Podría ser desarmada fácilmente o reubicada. Estas están abiertas, atadas al"
" lado de la entrada."

#: lang/json/terrain_from_json.py
msgid "open makeshift door"
msgstr "puerta improvisada abierta"

#. ~ Description for open makeshift door
#: lang/json/terrain_from_json.py
msgid ""
"A makeshift screen consisting of planks bound together with rope hanging "
"from the top of the doorway.  Could be easily taken down and re-purposed.  "
"The planks have been rolled up and attached to the top of the doorway, "
"allowing free movement through."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "empty metal door frame"
msgstr "marco de metal vacío de puerta"

#. ~ Description for empty metal door frame
#: lang/json/terrain_from_json.py
msgid ""
"An empty door frame made of steel and assorted metal.  A variety of doors "
"could be constructed here."
msgstr ""
"Es un marco de puerta vacío hecho con acero y otros metales. Podría "
"construirse acá diferentes tipos de puertas."

#: lang/json/terrain_from_json.py
msgid "empty metal window frame"
msgstr "marco de metal vacío de ventana"

#. ~ Description for empty metal window frame
#: lang/json/terrain_from_json.py
msgid ""
"An empty window frame constructed from assembled metal and carefully braced "
"with various hardware."
msgstr ""
"Es un marco de ventana vacío construido con metales ensamblados y "
"cuidadosamente apuntalados."

#: lang/json/terrain_from_json.py
msgid "boarded up door"
msgstr "puerta cubierta con tablas"

#. ~ Description for boarded up door
#: lang/json/terrain_from_json.py
msgid ""
"A standard wooden door that has several planks across it, nailed down to "
"board it up and increase its durability.  Still flammable though."
msgstr ""
"Es una puerta común de madera con varias tablas atravesadas y clavadas para "
"reforzara y aumentar su durabilidad. Igual, sigue siendo inflamable."

#: lang/json/terrain_from_json.py
msgid "boarded up damaged door"
msgstr "puerta dañada cubierta con tablas"

#. ~ Description for boarded up damaged door
#: lang/json/terrain_from_json.py
msgid ""
"A boarded up wooden door, except that some of the planks are fractured or "
"coming loose.  Without repairs, it could be broken down easily."
msgstr ""
"Es una puerta de madera reforzada con tablas, excepto las que están rotas o "
"medio sueltas. Si no se repara, podría romperse fácilmente."

#: lang/json/terrain_from_json.py
msgid "boarded up door with peephole"
msgstr "puerta con tablas con mirilla"

#. ~ Description for boarded up door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"A boarded up door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, you could still examine the "
"peephole."
msgstr ""
"Es una puerta de madera comunacha reforzada con tablas, pero con una "
"mirilla. Aunque está cubierta de tablas, se puede espiar por la mirilla."

#: lang/json/terrain_from_json.py
msgid "boarded up reinforced door"
msgstr "puerta con tablas reforzada"

#. ~ Description for boarded up reinforced door
#: lang/json/terrain_from_json.py
msgid ""
"An additionally reinforced door of layered planks that has been boarded up "
"with more wood to prevent it from opening.  Still susceptible to fire."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "boarded up damaged reinforced door"
msgstr "puerta dañada con tablas reforzada"

#. ~ Description for boarded up damaged reinforced door
#: lang/json/terrain_from_json.py
msgid ""
"A battered and torn reinforced door with planks bursting from the joints.  "
"The boarded up planks are fragmented and in pieces, this doesn't look like "
"an easy repair."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "boarded up damaged door with peephole"
msgstr "puerta dañada con tablas con mirilla"

#. ~ Description for boarded up damaged door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"A wrecked door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, the peephole was damaged and can't "
"be used to see through."
msgstr ""
"Es una puerta de madera comunacha destruida, con una mirilla. Aunque está "
"cubierta de tablas, la mirilla está rota y no puede usarse para espiar."

#: lang/json/terrain_from_json.py
msgid "closed metal door"
msgstr "puerta de metal cerrada"

#. ~ Description for closed metal door
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape."
msgstr ""
"Es una puerta extremadamente resistente hecha con acero variado, cortado y "
"golpeado para darle forma."

#: lang/json/terrain_from_json.py
msgid "metal wall"
msgstr "pared de metal"

#. ~ Description for metal wall
#: lang/json/terrain_from_json.py
msgid ""
"An industrially fabricated thick sheet carefully positioned and joined "
"seamlessly with perimeter sealant, this wall is capable of resisting extreme"
" elements as well as hostile forces.  Blast load rated and extremely fire-"
"retardant, breaching will require specialized tools or industrial vehicles."
msgstr ""
"Es una lámina gruesa fabricada de manera industrial y cuidadosamente ubicada"
" y unida con un sellador sin tener uniones visibles. Esta pared es capaz de "
"resistir los elementos naturales más extremos y las fuerzas hostiles. "
"Aguanta explosiones y retrasa extremadamente los fuegos, para romperla serán"
" necesarias herramientas especiales o vehículos industriales."

#: lang/json/terrain_from_json.py
msgid "open secret door"
msgstr "puerta secreta abierta"

#. ~ Description for open secret door
#: lang/json/terrain_from_json.py
msgid ""
"This apparently normal segment of metal wall has opened to reveal a secret "
"passage."
msgstr ""
"Este segmento aparentemente normal de pared de metal ha sido abierto para "
"revelar un pasadizo secreto."

#: lang/json/terrain_from_json.py
msgid "concrete wall"
msgstr "pared de concreto"

#. ~ Description for concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"A faux concrete wall positioned and joined seamlessly with the wall, this "
"wall is capable of resisting extreme elements as well as hostile forces.  "
"Blast load rated and extremely fire-retardant, breaching will require "
"specialized tools or industrial vehicles."
msgstr ""

#. ~ Description for open secret door
#: lang/json/terrain_from_json.py
msgid ""
"This apparently normal segment of concrete wall has opened to reveal a "
"secret passage."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "thwack!"
msgstr ""

#: lang/json/terrain_from_json.py
msgid "open metal door"
msgstr "puerta de metal abierta"

#. ~ Description for open metal door
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's open, so no tools are needed to break in."
msgstr ""
"Es una puerta extremadamente resistente hecha con acero variado, cortado y "
"golpeado para darle forma. Está abierta, así que no necesitás herramientas "
"para entrar."

#: lang/json/terrain_from_json.py
msgid "closed metal door with peephole"
msgstr "puerta de metal cerrada con mirilla"

#. ~ Description for closed metal door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole."
msgstr ""
"Es una puerta extremadamente resistente hecha con acero variado, cortado y "
"golpeado para darle forma. Si la mirás bien de cerca, vas a poder espiar por"
" el agujero."

#: lang/json/terrain_from_json.py
msgid "open metal door with peephole"
msgstr "puerta de metal abierta con mirilla"

#. ~ Description for open metal door with peephole
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole.  Although, you don't need to peek through it since the door is open "
"anyway."
msgstr ""
"Es una puerta extremadamente resistente hecha con acero variado, cortado y "
"golpeado para darle forma. Si la mirás bien de cerca, vas a poder espiar por"
" el agujero. Aunque no necesitás espiar nada porque la puerta está abierta."

#. ~ Description for closed metal door
#: lang/json/terrain_from_json.py
msgid ""
"A galvanized steel door, forged to withstand punishment and impede anyone or"
" anything.  Typically used in conjunction with automated electronic locking "
"mechanisms that require an external source to unlock."
msgstr ""
"Es una puerta de acero galvanizado, forjada para soportar cualquier castigo "
"y impedir el paso de todo. Comúnmente se utiliza en conjunto con un "
"mecanismo de cerradura electrónica que requieren un elemento externo para "
"poder abrirse."

#. ~ Description for closed metal door
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  This one has an extra keyhole, so it's likely locked.  You could "
"probably pick the lock."
msgstr ""
"Es una puerta extremadamente resistente hecha con acero variado, cortado y "
"golpeado para darle forma. Está tiene una cerradura más, así que debe estar "
"cerrada. Podrías probar de forzar la cerraduras."

#: lang/json/terrain_from_json.py
msgid "closed bar door"
msgstr "puerta de bar cerrada"

#. ~ Description for closed bar door
#: lang/json/terrain_from_json.py
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism doesn't appear to be engaged."
msgstr ""
"Es una puerta de cárcel hecha de barras entrecruzadas de acero inoxidable. "
"El mecanismo de cerradura no parece estar puesto."

#: lang/json/terrain_from_json.py
msgid "open bar door"
msgstr "puerta de bar abierta"

#. ~ Description for open bar door
#: lang/json/terrain_from_json.py
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's swung "
"wide open.  Freedom!"
msgstr ""
"Es una puerta de cárcel hecha de barras entrecruzadas de acero inoxidable. "
"Está abierta. ¡Freedom!"

#. ~ Description for closed bar door
#: lang/json/terrain_from_json.py
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism appears to be engaged.  The mechanism could be picked open with "
"enough skill."
msgstr ""
"Es una puerta de cárcel hecha de barras entrecruzadas de acero inoxidable. "
"El mecanismo de cerradura parece estar puesto. Podrías forzarlo si sos "
"hábil."

#: lang/json/terrain_from_json.py
msgid "closed frosted glass door"
msgstr "puerta de vidrio esmerilado cerrada"

#. ~ Description for closed frosted glass door
#: lang/json/terrain_from_json.py
msgid "A sliding door of frosted white glass."
msgstr "Es una puerta corrediza de vidrio esmerilado blanco."

#: lang/json/terrain_from_json.py
msgid "open frosted glass door"
msgstr "puerta de vidrio esmerilado abierta"

#: lang/json/terrain_from_json.py
msgid "closed bulkhead door"
msgstr "puerta de mamparo cerrada"

#. ~ Description for closed bulkhead door
#. ~ Description for open bulkhead door
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient door of cast metal, it is watertight and opened using"
" the fly wheel."
msgstr ""
"Es una puerta extremadamente resistente de metal, es hermética y se abre "
"usando un volante."

#: lang/json/terrain_from_json.py
msgid "open bulkhead door"
msgstr "puerta de mamparo abierta"

#: lang/json/terrain_from_json.py
msgid "palisade gate"
msgstr "verja empalizada"

#. ~ Description for palisade gate
#: lang/json/terrain_from_json.py
msgid ""
"A large doorway consisting of long logs cabled together, that could be "
"expanded upon.  Can act as a door if some type of pulley system were rigged "
"on an adjacent palisade wall."
msgstr ""
"Es una gran entrada hecha de troncos largos atadas juntos, que podría seguir"
" siendo agrandada. Puede funcionar como puerta si se le pone alguna clase de"
" sistema de poleas en una empalizada adyacente."

#: lang/json/terrain_from_json.py
msgid "open palisade gate"
msgstr "verja empalizada abierta"

#. ~ Description for open palisade gate
#: lang/json/terrain_from_json.py
msgid ""
"A hanging palisade gate, hoisted by a nearby pulley system.  Probably "
"shouldn't be underneath when it comes down."
msgstr ""
"Es una puerta empalizada colgando, sostenida por un sistema de poleas "
"cercano. Probablemente, no debería estar abajo cuando baja."

#: lang/json/terrain_from_json.py
msgid "makeshift portcullis"
msgstr "compuerta improvisada de rejas"

#. ~ Description for makeshift portcullis
#: lang/json/terrain_from_json.py
msgid ""
"An immense gateway scrapped together with various bits of steel and metal "
"scraps."
msgstr ""
"Es una inmensa entrada hecha de pedazos de acero y chatarra de varios "
"metales."

#: lang/json/terrain_from_json.py
msgid "locked wire gate"
msgstr "verja de alambre cerrada con llave"

#. ~ Description for locked wire gate
#: lang/json/terrain_from_json.py
msgid ""
"A gate for a chain link fence.  This one has a locked padlock on the latch "
"system.  With the right tools, you could cut the metal fence or pick the "
"lock.  You could also examine the fence to see if it looks climbable."
msgstr ""
"Es la puerta para una verja de alambre. Esta tiene un candado para cerrarla."
" Con las herramientas adecuadas, podrías cortar la verja o forzar la "
"cerradura. También podrías examinar la verja para ver si se puede trepar."

#: lang/json/terrain_from_json.py
msgid "closed wire gate"
msgstr "verja de alambre cerrada"

#. ~ Description for closed wire gate
#: lang/json/terrain_from_json.py
msgid "A gate for a chain link fence with a latch system to stay closed."
msgstr ""
"Es la puerta de una verja de alambre con un sistema de cerrojos para "
"mantenerla cerrada."

#: lang/json/terrain_from_json.py
msgid "open wire gate"
msgstr "verja de alambre abierta"

#. ~ Description for open wire gate
#: lang/json/terrain_from_json.py
msgid ""
"A gate for a chain link fence with a latch system to stay closed.  The latch"
" is undone, so the gate has swung open."
msgstr ""
"Es la puerta de una verja de alambre con un sistema de cerrojos para "
"mantenerla cerrada. El pestillo no está terminado, así que se abre."

#: lang/json/terrain_from_json.py
msgid "locked retractable gate"
msgstr ""

#. ~ Description for locked retractable gate
#: lang/json/terrain_from_json.py
msgid ""
"A retractable security gate.  The latch on this one is locked.  With the "
"right tools, you could cut the metal fence or disable the lock."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "closed retractable gate"
msgstr ""

#. ~ Description for closed retractable gate
#: lang/json/terrain_from_json.py
msgid "A retractable security gate with a latch system to stay closed."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "open retractable gate"
msgstr ""

#. ~ Description for open retractable gate
#: lang/json/terrain_from_json.py
msgid ""
"A retractable security gate with a latch system to stay closed.  The latch "
"is undone, so the gate has retracted up."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "closed wooden gate"
msgstr "verja de madera cerrada"

#. ~ Description for closed wooden gate
#. ~ Description for closed wooden split rail gate
#: lang/json/terrain_from_json.py
msgid "A commercial quality gate made of wood with a latch system."
msgstr ""
"Es una verja de calidad comercial hecha de madera con un sistema de "
"cerrojos."

#: lang/json/terrain_from_json.py
msgid "open wooden gate"
msgstr "verja de madera abierta"

#. ~ Description for open wooden gate
#. ~ Description for open wooden split rail gate
#: lang/json/terrain_from_json.py
msgid ""
"A commercial quality gate made of wood with a latch system.  The gate is "
"wide open, allowing anything to travel through."
msgstr ""
"Es una verja de calidad comercial hecha de madera con un sistema de "
"cerrojos. Está abierta, lo que permite pasar por ahí."

#: lang/json/terrain_from_json.py
msgid "closed screen door"
msgstr "puerta mosquitera cerrada"

#. ~ Description for closed screen door
#. ~ Description for open screen door
#: lang/json/terrain_from_json.py
msgid "A simple wooden doorway with screen mesh."
msgstr "Es un simple marco de madera con un malla mosquitera."

#: lang/json/terrain_from_json.py
msgid "rattle!"
msgstr "¡traqueteo!"

#: lang/json/terrain_from_json.py
msgid "open screen door"
msgstr "puerta mosquitera abierta"

#: lang/json/terrain_from_json.py
msgid "closed chickenwire gate"
msgstr "verja de alambre tejido cerrada"

#. ~ Description for closed chickenwire gate
#: lang/json/terrain_from_json.py
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed."
msgstr ""
"Es la puerta de una verja de alambre tejido con un simple sistema de "
"cerrojos para mantenerla cerrada."

#: lang/json/terrain_from_json.py
msgid "open chickenwire gate"
msgstr "verja de alambre tejido abierta"

#. ~ Description for open chickenwire gate
#: lang/json/terrain_from_json.py
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed.  "
"The latch is undone, so the gate has swung open."
msgstr ""
"Es la puerta de una verja de alambre tejido con un simple sistema de "
"cerrojos para mantenerla cerrada. El pestillo no está terminado, así que se "
"abre."

#: lang/json/terrain_from_json.py
msgid "picket fence"
msgstr "valla de madera"

#. ~ Description for picket fence
#: lang/json/terrain_from_json.py
msgid ""
"A barrier made of wood, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Es una barrera hecha de madera, nada muy complicado que digamos. Sugiere "
"tibiamente por dónde no habría que pasar."

#: lang/json/terrain_from_json.py
msgid "woven wattle fence"
msgstr ""

#. ~ Description for woven wattle fence
#: lang/json/terrain_from_json.py
msgid "A flimsy barrier made of woven sticks.  Suitable for small animals."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "narrow fence posts"
msgstr ""

#. ~ Description for narrow fence posts
#: lang/json/terrain_from_json.py
msgid "A set of narrow wooden posts for a woven wattle fence."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "chain link fence"
msgstr "valla metálica"

#. ~ Description for chain link fence
#: lang/json/terrain_from_json.py
msgid ""
"A tall fence made of woven wires.  It doesn't suggest to stop, it just "
"stops."
msgstr ""
"Es una cerca hecha de alambre tejido. No te sugiere que te detengas, te "
"detiene."

#: lang/json/terrain_from_json.py
msgid "metal post"
msgstr "poste de metal"

#. ~ Description for metal post
#: lang/json/terrain_from_json.py
msgid "Set of metal posts, that can hold more serious fences."
msgstr ""
"Es un conjunto de postes de metal, que pueden sostener unas cercas más "
"serias."

#: lang/json/terrain_from_json.py
msgid "chickenwire fence"
msgstr "valla de alambre tejido"

#. ~ Description for chickenwire fence
#: lang/json/terrain_from_json.py
msgid ""
"A rather flimsy tall fence made of 2x4s and woven wire, suitable for "
"containing small livestock like chickens."
msgstr ""
"Es una valla alta bastante endeble hecha con tablas de madera y alambre "
"tejido, ideal para contener animales pequeños como las gallinas."

#: lang/json/terrain_from_json.py
msgid "metal rattling!"
msgstr "¡traqueteo metálico!"

#: lang/json/terrain_from_json.py
msgid "screen mesh wall"
msgstr "pared de malla"

#. ~ Description for screen mesh wall
#: lang/json/terrain_from_json.py
msgid ""
"A rather flimsy tall wall made of 2x4s and screen mesh, suitable for keeping"
" the bugs out."
msgstr ""
"Es una pared alta bastante endeble hecha con tablas de madera y malla "
"mosquitera, ideal para mantener afuera a los insectos."

#: lang/json/terrain_from_json.py
msgid "chickenwire fence post"
msgstr "poste de valla de alambre tejido"

#. ~ Description for chickenwire fence post
#. ~ Description for fence post
#: lang/json/terrain_from_json.py
msgid ""
"A couple of posts that support the fence.  They look alone without the "
"fence."
msgstr ""
"Es un par de postes que sostienen una cerca. Se los ve solitos así sin "
"cerca."

#: lang/json/terrain_from_json.py
msgid "fence post"
msgstr "poste"

#: lang/json/terrain_from_json.py
msgid "wire fence"
msgstr "alambrado"

#. ~ Description for wire fence
#: lang/json/terrain_from_json.py
msgid ""
"A barrier made of wire, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Es una barrera hecha de alambre, nada muy complicado que digamos. Sugiere "
"tibiamente por dónde no habría que pasar."

#: lang/json/terrain_from_json.py
msgid "barbed wire fence"
msgstr "alambrado de púas"

#. ~ Description for barbed wire fence
#: lang/json/terrain_from_json.py
msgid ""
"A barrier made of sharp barbed wire.  More persuasive brother of wire fence."
msgstr ""
"Es una barrera hecha de alambre de púa filoso. El hermano persuasivo de la "
"reja de alambre."

#: lang/json/terrain_from_json.py
msgid "rope fence"
msgstr "alambrado de soga"

#. ~ Description for rope fence
#: lang/json/terrain_from_json.py
msgid ""
"A barrier made of rope, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr ""
"Es una barrera hecha de soga, nada muy complicado que digamos. Sugiere "
"tibiamente por dónde no habría que pasar."

#: lang/json/terrain_from_json.py
msgid "split rail fence"
msgstr "valla de madera"

#. ~ Description for split rail fence
#: lang/json/terrain_from_json.py
msgid ""
"A rather stout fence made of 2x4s and fence posts, suitable for containing "
"livestock like horses, cows and pigs."
msgstr ""
"Es una valla bastante robusta hecha con tablas de madera y postes, ideal "
"para contener animales como caballos, vacas y chanchos."

#: lang/json/terrain_from_json.py
msgid "closed wooden split rail gate"
msgstr "verja cerrada de valla de madera"

#: lang/json/terrain_from_json.py
msgid "open wooden split rail gate"
msgstr "verja abierta de valla de madera"

#: lang/json/terrain_from_json.py
msgid "metal fence"
msgstr "valla metálica"

#. ~ Description for metal fence
#: lang/json/terrain_from_json.py
msgid "A simple metal fence."
msgstr "Es una simple valla metálica."

#: lang/json/terrain_from_json.py
msgid "closed metal gate"
msgstr "verja metálica cerrada"

#. ~ Description for closed metal gate
#: lang/json/terrain_from_json.py
msgid "A closed metal gate."
msgstr "Es una verja metálica cerrada."

#: lang/json/terrain_from_json.py
msgid "open metal gate"
msgstr "verja metálica abierta"

#. ~ Description for open metal gate
#: lang/json/terrain_from_json.py
msgid "An open metal gate."
msgstr "Es una verja metálica abierta."

#: lang/json/terrain_from_json.py
msgid "wooden privacy fence"
msgstr "valla ciega de madera"

#. ~ Description for wooden privacy fence
#: lang/json/terrain_from_json.py
msgid ""
"A rather stout fence made of 2x4s and fence posts, it is tall and prevents "
"people from seeing into your yard."
msgstr ""
"Es una valla bastante robusta hecha con tablas de madera y postes, es alta y"
" evita que la gente vea tu patio."

#: lang/json/terrain_from_json.py
msgid "railing"
msgstr "pasamanos"

#. ~ Description for railing
#: lang/json/terrain_from_json.py
msgid "A section of wooden railing."
msgstr "Es una parte de una baranda de madera."

#: lang/json/terrain_from_json.py
msgid "crack!"
msgstr "¡crack!"

#: lang/json/terrain_from_json.py
msgid "glass railing"
msgstr "baranda de vidrio"

#. ~ Description for glass railing
#: lang/json/terrain_from_json.py
msgid "A section of railing made out of glass."
msgstr "Es una parte de una baranda hecha de vidrio."

#: lang/json/terrain_from_json.py
msgid "glass braking!"
msgstr "¡vidrio astillándose!"

#: lang/json/terrain_from_json.py
msgid "ker-rash!"
msgstr "¡ker-rash!"

#: lang/json/terrain_from_json.py
msgid "metal railing"
msgstr "baranda metálica"

#. ~ Description for metal railing
#: lang/json/terrain_from_json.py
msgid "A section of metal railing."
msgstr "Es una parte de una baranda metálica."

#: lang/json/terrain_from_json.py
msgid "concrete railing"
msgstr "baranda de concreto"

#. ~ Description for concrete railing
#: lang/json/terrain_from_json.py
msgid "A section of cemented concrete railing."
msgstr "Es una parte de una baranda de concreto."

#: lang/json/terrain_from_json.py
msgid "guard rail"
msgstr "guardarraíl"

#. ~ Description for guard rail
#: lang/json/terrain_from_json.py
msgid ""
"A section of metal railing, put in place to prevent people from falling or "
"taking the easy way out."
msgstr ""
"Es una parte de baranda metálica puesta para prevenir que la gente se caiga "
"y elija la salida más fácil."

#: lang/json/terrain_from_json.py
msgid "overgrown floor"
msgstr "piso cubierto"

#. ~ Description for overgrown floor
#: lang/json/terrain_from_json.py
msgid ""
"A bare concrete floor, almost completely covered by twitching filaments of "
"grey flesh."
msgstr ""
"Es un suelo básico de concreto, casi completamente cubierto por filamentos "
"que se retuercen de carne gris."

#: lang/json/terrain_from_json.py
msgid "overgrown wall"
msgstr "pared cubierta"

#. ~ Description for overgrown wall
#: lang/json/terrain_from_json.py
msgid ""
"A concrete wall overgrown by a  grotesque grid of veins and knotted flesh."
msgstr ""
"Es una pared de concreto cubierta por una grotesca red de venas y carne "
"nudosa."

#: lang/json/terrain_from_json.py
msgid "concrete floor"
msgstr "suelo de concreto"

#. ~ Description for concrete floor
#: lang/json/terrain_from_json.py
msgid ""
"A bare and cold concrete floor with matching roof, could still insulate from"
" the outdoors but roof collapse is possible if supporting walls are broken "
"down."
msgstr ""
"Es un simple y frío piso de concreto que combina con el techo, igual puede "
"aislarte del exterior pero si las paredes se rompen es posible que el techo "
"colapse."

#. ~ Description for concrete floor
#: lang/json/terrain_from_json.py
msgid ""
"A bare and cold concrete floor with a streak of yellow paint, could still "
"insulate from the outdoors but roof collapse is possible if supporting walls"
" are broken down."
msgstr ""
"Es un simple y frío piso de concreto con una raya de pintura amarilla, igual"
" puede aislarte del exterior pero si las paredes se rompen es posible que el"
" techo colapse."

#. ~ Description for concrete floor
#: lang/json/terrain_from_json.py
msgid ""
"A bare and cold concrete floor with a streak of red paint, could still "
"insulate from the outdoors but roof collapse is possible if supporting walls"
" are broken down."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "concrete floor, overhead light"
msgstr "suelo de concreto, luz superior"

#. ~ Description for concrete floor, overhead light
#: lang/json/terrain_from_json.py
msgid ""
"A bare and cold concrete floor with a still-functioning light attached to "
"the ceiling above."
msgstr ""
"Es un suelo de concreto frío y desnudo con una luz funcionando, puesta "
"arriba, en el techo."

#: lang/json/terrain_from_json.py
msgid "wooden floor, overhead light"
msgstr "suelo de madera, luz superior"

#. ~ Description for wooden floor, overhead light
#: lang/json/terrain_from_json.py
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with a still-functioning light attached to the ceiling above."
msgstr ""
"Son pedazos de madera interconectados que están tratados para resistir el "
"fuego, con una luz que todavía funciona en el techo."

#: lang/json/terrain_from_json.py
msgid "metal floor, with overhead light"
msgstr "suelo de metal, luz superior"

#. ~ Description for metal floor, with overhead light
#: lang/json/terrain_from_json.py
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a still-functioning light attached to the ceiling above."
msgstr ""
"Es un piso de buena calidad y resistente con baldosas cuadriculadas que "
"reduce el riesgo de patinarse y caerse, con una luz que todavía funciona en "
"el techo."

#: lang/json/terrain_from_json.py
msgid "thump"
msgstr "tomp"

#: lang/json/terrain_from_json.py
msgid "small rebar roof cage"
msgstr "techo chico de jaula de acero corrugado"

#. ~ Description for small rebar roof cage
#: lang/json/terrain_from_json.py
msgid ""
"A series of structural support crafted from rebar in order to allow the "
"pouring of concrete for a more stable floor and roof."
msgstr ""
"Es una serie de estructuras de soporte hechas con varillas corrugadas para "
"poder permitir meterle concreto y hacer un piso techo más estables."

#: lang/json/terrain_from_json.py
msgid "SCRRRASH!"
msgstr "¡SCRRRASH!"

#: lang/json/terrain_from_json.py
msgid "reinforced concrete floor"
msgstr "suelo de concreto reforzado"

#. ~ Description for reinforced concrete floor
#: lang/json/terrain_from_json.py
msgid ""
"Extremely resilient floor made from carefully placed rebar and poured "
"concrete, capable of providing protection from the elements.  As for the "
"matching roof, it still requires supporting walls, otherwise it may very "
"well cave in."
msgstr ""
"Es un piso extremadamente resistente hecho con varillas corrugadas "
"cuidadosamente ubicadas y concreto, capaz de brindar protección a los "
"elementos naturales. En lo que respecta al techo, todavía faltan las "
"paredes, si no no va a resistir."

#: lang/json/terrain_from_json.py
msgid "rebar roof cage"
msgstr "techo de jaula de acero corrugado"

#. ~ Description for rebar roof cage
#: lang/json/terrain_from_json.py
msgid ""
"A network of architecturally sound rebar in order to support a floor and "
"roof, looks like it's missing the poured concrete."
msgstr ""
"Es una red arquitectónica de varillas corrugadas hechas para soportar un "
"piso y un techo, pero que le falta el concreto que las rellena."

#: lang/json/terrain_from_json.py
msgid "half-built reinforced concrete floor"
msgstr "suelo de concreto reforzado a medio construir"

#. ~ Description for half-built reinforced concrete floor
#: lang/json/terrain_from_json.py
msgid ""
"Unfinished series of rebar and poured concrete; the floor hasn't been "
"smoothed and the roof isn't quite filled in yet."
msgstr ""
"Es una serie de varillas corrugadas y concreto que todavía no está "
"terminado. Al piso todavía no lo emparejaron y el techo todavía no está "
"completamente lleno."

#: lang/json/terrain_from_json.py
msgid "rock floor"
msgstr "suelo de piedra"

#. ~ Description for rock floor
#: lang/json/terrain_from_json.py
msgid ""
"A relatively flat area of rock and stone.  Looks stable enough to be mined "
"with the proper mining gear."
msgstr ""
"Es un área relativamente plana de piedra y roca. Parece lo suficientemente "
"estable como para poder ser extraída con el equipo adecuado de minería."

#: lang/json/terrain_from_json.py
msgid "metal floor"
msgstr "suelo de metal"

#. ~ Description for metal floor
#: lang/json/terrain_from_json.py
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a matching roof."
msgstr ""
"Es un piso de buena calidad y resistente con baldosas cuadriculadas que "
"reduce el riesgo de patinarse y caerse, con un techo que combina."

#: lang/json/terrain_from_json.py
msgid "floor"
msgstr "suelo"

#. ~ Description for floor
#: lang/json/terrain_from_json.py
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams supporting a roof."
msgstr ""
"Son pedazos de madera interconectados que están tratados para resistir el "
"fuego, con postes de madera y vigas soportando el techo."

#: lang/json/terrain_from_json.py
msgid "primitive floor"
msgstr "suelo primitivo"

#. ~ Description for primitive floor
#: lang/json/terrain_from_json.py
msgid "Timber floor and supports, holding up a sod roof."
msgstr "Es un suelo y soporte de troncos, que sostienen un techo de tierra."

#: lang/json/terrain_from_json.py
msgid "simple metal floor"
msgstr "suelo simple de metal"

#. ~ Description for simple metal floor
#: lang/json/terrain_from_json.py
msgid ""
"A crudely welded together floor of metal with steel trusses and supporting "
"girders."
msgstr ""
"Es un piso de metal no muy bien soldado con una estructura de acero y vigas "
"de apoyo."

#: lang/json/terrain_from_json.py
msgid "waxed floor"
msgstr "suelo encerado"

#. ~ Description for waxed floor
#: lang/json/terrain_from_json.py
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports."
msgstr ""
"Es un piso de madera dura que ha sido tratado con químicos para disminuir la"
" posibilidad de patinarse, generalmente utilizado para deportes recreativos."

#: lang/json/terrain_from_json.py
msgid "dirt floor"
msgstr "suelo de tierra"

#. ~ Description for dirt floor
#: lang/json/terrain_from_json.py
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with a "
"wooden ceiling above it."
msgstr ""
"Es un piso que consiste en tierra fina mezclada que ha sido apisonada, con "
"techo de madera."

#. ~ Description for dirt floor
#: lang/json/terrain_from_json.py
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with "
"thatched roof above it."
msgstr ""
"Es un piso que consiste en tierra fina mezclada que ha sido apisonada, con "
"techo de paja."

#. ~ Description for metal grate
#: lang/json/terrain_from_json.py
msgid ""
"A type of walkway that can be used as protective covering over drains or "
"even used as a filter."
msgstr ""
"Es un tipo de vereda que puede usarse como protección sobre los drenajes o "
"también puede usarse como filtro."

#: lang/json/terrain_from_json.py
msgid "utility light"
msgstr "luz de utilidad"

#. ~ Description for utility light
#: lang/json/terrain_from_json.py
msgid ""
"An industrial flood light set up to illuminate the surroundings.  Smashing "
"it doesn't seem like it'd produce any worthwhile salvage."
msgstr ""
"Es un reflector industrial utilizado para iluminar. Si lo rompés no vas a "
"poder recuperar nada útil."

#: lang/json/terrain_from_json.py
msgid "wax floor"
msgstr "piso de cera"

#. ~ Description for wax floor
#: lang/json/terrain_from_json.py
msgid "A floor section made entirely out of wax."
msgstr "Es una parte de suelo hecho completamente de cera."

#: lang/json/terrain_from_json.py
msgid "elevator"
msgstr "ascensor"

#. ~ Description for elevator
#: lang/json/terrain_from_json.py
msgid "The interior section of an elevator."
msgstr "Es la parte interior de un ascensor."

#: lang/json/terrain_from_json.py
msgid "red floor"
msgstr "suelo rojo"

#. ~ Description for red floor
#: lang/json/terrain_from_json.py
msgid "A red section of flooring."
msgstr "Es una parte roja de suelo."

#: lang/json/terrain_from_json.py
msgid "green floor"
msgstr "suelo verde"

#. ~ Description for green floor
#: lang/json/terrain_from_json.py
msgid "A green section of flooring."
msgstr "Es una parte verde de suelo."

#: lang/json/terrain_from_json.py
msgid "blue floor"
msgstr "suelo azul"

#. ~ Description for blue floor
#: lang/json/terrain_from_json.py
msgid "A blue section of flooring."
msgstr "Es una parte azul de suelo."

#: lang/json/terrain_from_json.py
msgid "carpet"
msgstr "alfombra"

#. ~ Description for carpet
#: lang/json/terrain_from_json.py
msgid "Base carpet!"
msgstr "¡Es una alfombra básica!"

#. ~ Description for carpet
#: lang/json/terrain_from_json.py
msgid "Soft red carpet."
msgstr "Es una suave alfombra roja."

#. ~ Description for yellow carpet
#: lang/json/terrain_from_json.py
msgid "Soft yellow carpet."
msgstr "Es una suave alfombra amarilla."

#. ~ Description for green carpet
#: lang/json/terrain_from_json.py
msgid "Soft green carpet."
msgstr "Es una suave alfombra verde."

#. ~ Description for purple carpet
#: lang/json/terrain_from_json.py
msgid "Soft purple carpet."
msgstr "Es una suave alfombra púrpura."

#: lang/json/terrain_from_json.py
msgid "Carpet"
msgstr "Alfombra"

#. ~ Description for Carpet
#: lang/json/terrain_from_json.py
msgid "Base concrete carpet!"
msgstr "¡Es una alfombra básica de concreto!"

#: lang/json/terrain_from_json.py
msgid "industrial red carpet"
msgstr "alfombra industrial roja"

#. ~ Description for industrial red carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, high-durability carpet in a red color, for laying down on "
"bare concrete."
msgstr ""
"Es una alfombra firme, de pelo corto y gran durabilidad de color rojo, para "
"poner sobre concreto."

#: lang/json/terrain_from_json.py
msgid "industrial yellow carpet"
msgstr "alfombra industrial amarilla"

#. ~ Description for industrial yellow carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, high-durability carpet in a yellow color, for laying down on"
" bare concrete."
msgstr ""
"Es una alfombra firme, de pelo corto y gran durabilidad de color amarillo, "
"para poner sobre concreto."

#: lang/json/terrain_from_json.py
msgid "industrial green carpet"
msgstr "alfombra industrial verde"

#. ~ Description for industrial green carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, high-durability carpet in a green color, for laying down on "
"bare concrete."
msgstr ""
"Es una alfombra firme, de pelo corto y gran durabilidad de color verde, para"
" poner sobre concreto."

#: lang/json/terrain_from_json.py
msgid "industrial purple carpet"
msgstr "alfombra industrial púrpura"

#. ~ Description for industrial purple carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, high-durability carpet in a purple color, for laying down on"
" bare concrete."
msgstr ""
"Es una alfombra firme, de pelo corto y gran durabilidad de color púrpura, "
"para poner sobre concreto."

#. ~ Description for carpet
#: lang/json/terrain_from_json.py
msgid "Base metal carpet!"
msgstr "¡Es una alfombra metálica básica!"

#: lang/json/terrain_from_json.py
msgid "bunker red carpet"
msgstr "alfombra roja de búnker"

#. ~ Description for bunker red carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, totally non-flammable carpet in a red color, with an "
"insulation layer beneath."
msgstr ""
"Es una alfombra firme, de pelo corto, no inflamable alfombra de color rojo, "
"con una capa de aislación debajo."

#: lang/json/terrain_from_json.py
msgid "bunker yellow carpet"
msgstr "alfombra amarilla de búnker"

#. ~ Description for bunker yellow carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, totally non-flammable carpet in a yellow color, with an "
"insulation layer beneath."
msgstr ""
"Es una alfombra firme, de pelo corto, no inflamable alfombra de color "
"amarillo, con una capa de aislación debajo."

#: lang/json/terrain_from_json.py
msgid "bunker green carpet"
msgstr "alfombra verde de búnker"

#. ~ Description for bunker green carpet
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, totally non-flammable carpet in a green color, with an "
"insulation layer beneath."
msgstr ""
"Es una alfombra firme, de pelo corto, no inflamable alfombra de color verde,"
" con una capa de aislación debajo."

#: lang/json/terrain_from_json.py
msgid "bunker carpet purple"
msgstr "alfombra púrpura de búnker"

#. ~ Description for bunker carpet purple
#: lang/json/terrain_from_json.py
msgid ""
"Firm, low-pile, totally non-flammable carpet in a purple color, with an "
"insulation layer beneath."
msgstr ""
"Es una alfombra firme, de pelo corto, no inflamable alfombra de color "
"púrpura, con una capa de aislación debajo."

#: lang/json/terrain_from_json.py
msgid "linoleum tile"
msgstr "baldosa de linóleo"

#. ~ Description for linoleum tile
#: lang/json/terrain_from_json.py
msgid ""
"A section of flooring made out of a tough, rubbery material.  Colored a "
"simple white."
msgstr ""
"Es una parte de piso hecho con un material resistente y gomoso. De un simple"
" color blanco."

#. ~ Description for linoleum tile
#: lang/json/terrain_from_json.py
msgid "A section of flooring made out of a tough, gray, rubbery material."
msgstr "Es una parte de piso hecho con un material resistente y gomoso."

#: lang/json/terrain_from_json.py
msgid "painted waxed floor"
msgstr "suelo pintado encerado"

#. ~ Description for painted waxed floor
#: lang/json/terrain_from_json.py
msgid "This section of wax flooring has been painted."
msgstr "Esta parte de suelo encerado ha sido pintado."

#: lang/json/terrain_from_json.py
msgid "radiation platform"
msgstr "plataforma de radiación"

#. ~ Description for radiation platform
#: lang/json/terrain_from_json.py
msgid ""
"A dual purpose platform that serves as a containment, and as a device that "
"exposes items places on in to the radioactive source, by temporarily "
"hoisting the radioactive material stored within.  Operated from external "
"console."
msgstr ""
"Es una plataforma con dos propósitos que funciona como contención y como "
"dispositivo que expone si los objetos son una fuente radiactiva, al levantar"
" temporalmente el material radiactivo almacenado dentro. Se opera desde una "
"consola externa."

#: lang/json/terrain_from_json.py
msgid "junk metal floor"
msgstr "piso de chatarra"

#. ~ Description for junk metal floor
#: lang/json/terrain_from_json.py
msgid ""
"A simple roof and floor of rusty scrap metal bolted and wire-tied to a "
"makeshift frame.  Very fashionable in post-apocalyptic shantytowns.  Hope "
"you like the sound of rain on corrugated metal."
msgstr ""
"Es un simple techo y suelo hechos de chatarra oxidada abulonada y atada con "
"alambre armando una estructura resistente. Muy elegante en las villas post-"
"apocalípticas. Espero que te guste el sonido de la lluvia sobre el metal "
"corrugado."

#: lang/json/terrain_from_json.py
msgid "dirt"
msgstr "tierra"

#. ~ Description for dirt
#: lang/json/terrain_from_json.py
msgid ""
"It's dirt.  Looks like some fine soil for tillage.  Could also be dug out "
"for construction projects."
msgstr ""
"Es tierra. Parece que es de buena calidad como para cultivar. También puede "
"ser quitada para usar en alguna construcción."

#. ~ Description for sand
#: lang/json/terrain_from_json.py
msgid ""
"A large area of fine sand that could be useful in a number of ways, if it "
"was extracted properly."
msgstr ""
"Es un área grande con arena que podría utilizarse de varias maneras, si se "
"la extrae de manera apropiada."

#: lang/json/terrain_from_json.py
msgid "mud"
msgstr "barro"

#. ~ Description for mud
#: lang/json/terrain_from_json.py
msgid "An area of wet, slick mud."
msgstr "Es un área de barro húmedo y resbaladizo."

#: lang/json/terrain_from_json.py
msgid "moss"
msgstr "musgo"

#. ~ Description for moss
#: lang/json/terrain_from_json.py
msgid "Moist spongy moss."
msgstr "Es musguito esponjoso y húmedo."

#: lang/json/terrain_from_json.py
msgid "clay"
msgstr "arcilla"

#. ~ Description for clay
#: lang/json/terrain_from_json.py
msgid ""
"A field full of malleable clay, suitable for kiln firing if it was extracted"
" properly."
msgstr ""
"Es un campo lleno de arcilla maleable, ideal para la alfarería si se la "
"extrae de manera apropiada."

#: lang/json/terrain_from_json.py
msgid "mound of clay"
msgstr "montículo de arcilla"

#. ~ Description for mound of clay
#: lang/json/terrain_from_json.py
msgid "A mound of clay soil."
msgstr "Es un montículo de suelo arcilloso."

#: lang/json/terrain_from_json.py
msgid "splosh!"
msgstr "¡splash!"

#: lang/json/terrain_from_json.py
msgid "paper floor"
msgstr "piso de papel"

#. ~ Description for paper floor
#: lang/json/terrain_from_json.py
msgid "Floor made of pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Es un piso hecho con una masa pulposa, cubierta con saliva pegajosa de "
"avispa."

#: lang/json/terrain_from_json.py
msgid "hard paper floor"
msgstr ""

#. ~ Description for hard paper floor
#: lang/json/terrain_from_json.py
msgid ""
"Hardened cardboard floor made of chewed up trees and resin mixed with wasp "
"saliva."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "paper brood cap"
msgstr ""

#. ~ Description for paper brood cap
#: lang/json/terrain_from_json.py
msgid ""
"A thin paper floor, protecting the pupatig wasp larva until it's ready to "
"emerge."
msgstr ""

#. ~ Description for open air
#: lang/json/terrain_from_json.py
msgid "This is open air."
msgstr "Esto es aire libre."

#: lang/json/terrain_from_json.py
msgid "mound of sand"
msgstr "montículo de arena"

#. ~ Description for mound of sand
#: lang/json/terrain_from_json.py
msgid "A mound of sand."
msgstr "Es un montículo de arena."

#: lang/json/terrain_from_json.py
msgid "glassed sand"
msgstr ""

#. ~ Description for glassed sand
#: lang/json/terrain_from_json.py
msgid ""
"A patch of sand that has a crust of natural glass atop it, after exposure to"
" intense heat."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "crunch"
msgstr ""

#. ~ Description for mound of dirt
#: lang/json/terrain_from_json.py
msgid ""
"An area of heaped dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr ""
"Es un área de tierra removida, difícil para caminar por ahí. Si se la "
"examina un poco, se ve que es bastante favorable para plantar semillas y "
"cosas así."

#. ~ Description for mound of dirt
#: lang/json/terrain_from_json.py
msgid ""
"A giant hill of dirt that looks like you could crawl inside for shelter."
msgstr ""
"Es una pilla gigante de tierra en la que parece que podrías meterte para "
"usar de refugio."

#: lang/json/terrain_from_json.py
msgid "odd fault"
msgstr "desperfecto extraño"

#. ~ Description for odd fault
#: lang/json/terrain_from_json.py
msgid ""
"An unnaturally humanoid-shaped hole, it seems oddly familiar.  There's a "
"strange sensation to examine it closer, as if it belongs to you somehow."
msgstr ""
"Es un agujero antinatural con forma humanoide, y te resulta extrañamente "
"familiar. Sentís una extraña sensación al examinarlo, como si te "
"perteneciera de alguna manera."

#: lang/json/terrain_from_json.py
msgid "grave"
msgstr "tumba"

#. ~ Description for grave
#: lang/json/terrain_from_json.py
msgid ""
"A dirt grave, with some grass growing on it.  At least some of the dead do "
"actually rest in peace."
msgstr ""
"Es una tumba sucia con un poco de pasto creciéndole encima. Por lo menos "
"algunos muertos sí descansan en paz."

#. ~ Description for grave
#: lang/json/terrain_from_json.py
msgid ""
"A fresh grave, covered with stones, either to keep something from digging it"
" out or to keep one inside from digging out of it.  Two planks mark this "
"place of someone's eternal rest."
msgstr ""
"Es una tumba nueva cubierta de piedras, tanto para evitar que algo saque lo "
"de adentro como para evitar que lo de adentro salga. Dos tablas marcan este "
"lugar como el descanso eterno de alguien."

#: lang/json/terrain_from_json.py
msgid "pavement"
msgstr "pavimento"

#. ~ Description for pavement
#: lang/json/terrain_from_json.py
msgid ""
"A segment of asphalt, slowly degrading from cracks, frost heaves and lack of"
" maintenance."
msgstr ""
"Es un pedazo de asfalto, lentamente degradándose por las rajaduras, el "
"congelamiento y la falta de mantenimiento."

#: lang/json/terrain_from_json.py
msgid "yellow pavement"
msgstr "pavimento amarillo"

#. ~ Description for yellow pavement
#: lang/json/terrain_from_json.py
msgid ""
"Streaks of carefully aligned yellow paint mark the road to inform drivers "
"not to cross.  No one is enforcing these rules anymore."
msgstr ""
"Son rayas de pintura amarilla cuidadosamente alineadas en la ruta para "
"informar a los conductores que no deben cruzarlas. Aunque ya nadie cuida que"
" estas cosas se cumplan."

#: lang/json/terrain_from_json.py
msgid "pedestrian crossing"
msgstr "cruce peatonal"

#. ~ Description for pedestrian crossing
#: lang/json/terrain_from_json.py
msgid ""
"White polymer lines painted on the pavement which indicate places where "
"pedestrians should cross the road."
msgstr ""
"Son unas líneas blancas de polímero pintadas sobre el pavimento para indicar"
" los lugares por los cuales los peatones deben cruzar la calle."

#: lang/json/terrain_from_json.py
msgid "sidewalk"
msgstr "vereda"

#. ~ Description for sidewalk
#: lang/json/terrain_from_json.py
msgid ""
"An area of common poured concrete, damaged by frost heaves and large cracks "
"due to lack of maintenance."
msgstr ""
"Es un área con concreto común, dañado por el congelamiento y las rajaduras "
"grandes que tiene debido a la falta de mantenimiento."

#. ~ Description for concrete
#: lang/json/terrain_from_json.py
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles."
msgstr ""
"Es un sector nuevo con concreto con terminaciones en la superficie para "
"hacerlo más estético y resistente a los ciclos de congelamiento y "
"descongelamiento."

#. ~ Description for concrete
#: lang/json/terrain_from_json.py
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles.  Covered with a streak of yellow paint."
msgstr ""
"Es un sector nuevo con concreto con terminaciones en la superficie para "
"hacerlo más estético y resistente a los ciclos de congelamiento y "
"descongelamiento. Cubierto con una línea de pintura amarilla."

#: lang/json/terrain_from_json.py
msgid "wooden floor"
msgstr "piso de madera"

#. ~ Description for wooden floor
#: lang/json/terrain_from_json.py
msgid ""
"Wooden floor created from boards, packed tightly together and nailed down.  "
"Common in patios."
msgstr ""
"Es un piso de madera creado con tablas, unidos firmemente y clavados. Es "
"común en los patios."

#. ~ Description for metal floor
#: lang/json/terrain_from_json.py
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls."
msgstr ""
"Es un piso de buena calidad y resistente con baldosas cuadriculadas que "
"reduce el riesgo de patinarse y caerse."

#. ~ Description for dirt floor
#: lang/json/terrain_from_json.py
msgid "Floor consisting of finely mixed earth that has been tamped down."
msgstr ""
"Es un piso que consiste en tierra fina mezclada que ha sido apisonada."

#: lang/json/terrain_from_json.py
msgid "walnut tree"
msgstr "nogal"

#. ~ Description for walnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Juglans' genus.  If you look closely you "
"can see some unharvested walnuts.  You could cut it down with the right "
"tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Juglans'. Si lo mirás de cerca "
"podés ver que tiene algunas nueces todavía. Podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for walnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Juglans' genus.  You could cut it down with"
" the right tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Juglans'. Podrías talarlo con "
"las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "blackjack oak"
msgstr "roble blackjack"

#. ~ Description for blackjack oak
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  You could peel off the bark "
"sections if you examined the tree more closely.  You could cut it down with "
"the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Quercus', con la corteza agrietada "
"formando placas negras rectangulares, separadas por estrechas fisuras "
"naranjas. Podrías arrancar partes de la corteza si lo examinás de más cerca."
" También podrías talarlo con las herramientas adecuadas."

#. ~ Description for blackjack oak
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  All usable bark has been "
"stripped off.  You could cut it down with the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Quercus', con la corteza agrietada "
"formando placas negras rectangulares, separadas por estrechas fisuras "
"naranjas. Ya no tiene más corteza que puedas arrancar. Podrías talarlo con "
"las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "chestnut tree"
msgstr "castaño"

#. ~ Description for chestnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Castanea' genus.  If you look closely you "
"can see some unharvested chestnuts.  You could cut it down with the right "
"tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Castanea'. Si lo mirás de cerca "
"podés ver que tiene algunas castañas todavía. Podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for chestnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Castanea' genus.  You could cut it down "
"with the right tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Castanea'. Podrías talarlo con "
"las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "beech tree"
msgstr "hayuco"

#. ~ Description for beech tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Fagus' genus.  If you look closely you can "
"see some unharvested beech nuts.  You could cut it down with the right "
"tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Fagus'. Si lo mirás de cerca "
"podés ver que tiene algunos hayucos todavía. Podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for beech tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive tree belonging to the 'Fagus' genus.  You could cut it down with "
"the right tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Fagus'. Podrías talarlo con las "
"herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "hazelnut tree"
msgstr "avellano"

#. ~ Description for hazelnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  If you look closely you can"
" see some unharvested hazelnuts.  You could cut it down with the right "
"tools."
msgstr ""
"Es un árbol gordito perteneciente al género 'Corylus'. Si lo mirás de cerca "
"podés ver que tiene algunas avellanas todavía. Podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for hazelnut tree
#: lang/json/terrain_from_json.py
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  You could cut it down with "
"the right tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Corylus'. Podrías talarlo con "
"las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "oak tree"
msgstr "roble"

#. ~ Description for oak tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  If you look closely you can see some acorns "
"the squirrels haven't gotten yet.  You could cut it down with the right "
"tools."
msgstr ""
"Es un enorme árbol de hoja caduca que pertenece al género 'Quercus', "
"comúnmente visto por toda la región de New England. Si lo mrás de cerca "
"podés ver que tiene algunas bellotas que las ardillas no agarraron. Podrías "
"talarlo con las herramientas adecuadas."

#. ~ Description for oak tree
#: lang/json/terrain_from_json.py
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  You could cut it down with the right tools."
msgstr ""
"Es un enorme árbol de hoja caduca que pertenece al género 'Quercus', "
"comúnmente visto por toda la región de New England. Podrías talarlo con las "
"herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "cottonwood tree"
msgstr "álamo de Norteamérica"

#. ~ Description for cottonwood tree
#: lang/json/terrain_from_json.py
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout New"
" England region.  You could cut it down with the right tools."
msgstr ""
"Es un enorme árbol perteneciente al género 'Populus', comúnmente visto por "
"toda la región de New England. Podrías talarlo con las herramientas "
"adecuadas."

#: lang/json/terrain_from_json.py
msgid "elm tree"
msgstr "olmo"

#. ~ Description for elm tree
#: lang/json/terrain_from_json.py
msgid ""
"A large tree belonging to the 'Ulmus' genus, commonly found throughout New "
"England region.  You could cut it down with the right tools."
msgstr ""
"Es un gran árbol perteneciente al género 'Ulmus', comúnmente visto por toda "
"la región de New England. Podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "dead tree"
msgstr "árbol seco"

#. ~ Description for dead tree
#: lang/json/terrain_from_json.py
msgid ""
"An indiscernible tree that has withered away, whether by weather, fire or "
"otherworldy.  You could cut it down with the right tools."
msgstr ""
"Es un árbol indiscernible que se ha marchitado, ya sea por el clima, por "
"fuego, o por algo sobrenatural. Podrías talarlo con las herramientas "
"adecuadas."

#: lang/json/terrain_from_json.py
msgid "young tree"
msgstr "árbol joven"

#. ~ Description for young tree
#: lang/json/terrain_from_json.py
msgid ""
"A relatively young sapling of an indeterminate species.  It could take "
"decades before reaching maturity, so there's no use waiting around."
msgstr ""
"Es un arbolito relativamente joven de alguna especie indeterminada. Podría "
"tardar décadas en alcanzar su madurez, así que no tiene mucho sentido "
"esperarlo."

#: lang/json/terrain_from_json.py
msgid "apple tree"
msgstr "manzano"

#. ~ Description for apple tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  If you examined the branches more closely, you could probably "
"find a few mature ones in autumn.  You could also cut it down with the right"
" tools."
msgstr ""
"Este árbol pertenece al género 'Malus', produce la fruta conocida comúnmente"
" como manzana. Si examinás las ramas de cerca, probablemente encuentres "
"algunas maduras. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for apple tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  There doesn't appear to be any ripe apples now.  You could also "
"cut it down with the right tools."
msgstr ""
"Este árbol pertenece al género 'Malus', produce la fruta conocida comúnmente"
" como manzana. Aunque no parece tener ninguna madura en este momento. "
"También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "pear tree"
msgstr "peral"

#. ~ Description for pear tree
#: lang/json/terrain_from_json.py
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  If you examined the branches more closely, you could "
"probably find a few mature ones.  You could also cut it down with the right "
"tools."
msgstr ""
"Esto es un 'Pyrus communis' o peral, que produce peras durante el otoño. Si "
"examinás las ramas de cerca, probablemente encuentres algunas maduras. "
"También podrías talarlo con las herramientas adecuadas."

#. ~ Description for pear tree
#: lang/json/terrain_from_json.py
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  Looks like all the ripe pears have been picked.  You "
"could also cut it down with the right tools."
msgstr ""
"Esto es un 'Pyrus communis' o peral, que produce peras durante el otoño. "
"Parece que ya han sido sacadas todas las peras maduras. También podrías "
"talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "coffee tree"
msgstr "cafeto"

#. ~ Description for coffee tree
#: lang/json/terrain_from_json.py
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  If you examined the "
"branches more closely, you could probably find a few mature ones.  You could"
" also cut it down with the right tools."
msgstr ""
"Esto es un 'gymnocladus dioicus', también conocido como el cafeto kentucky, "
"que produce granos de café que pueden tostarse y hojas para infusión durante"
" el otoño. Si examinás las ramas de cerca, probablemente encuentres algunas "
"maduras. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for coffee tree
#: lang/json/terrain_from_json.py
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  Looks like all the "
"ripe pods have been picked.  You could also cut it down with the right "
"tools."
msgstr ""
"Esto es un 'gymnocladus dioicus', también conocido como el cafeto kentucky, "
"que produce granos de café que pueden tostarse y hojas para infusión durante"
" el otoño. Parece que todos los granos maduros ya han sido sacados. También "
"podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "cherry tree"
msgstr "cerezo"

#. ~ Description for cherry tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  If you examined the foliage more closely, you could"
" probably find some viable clusters.  You could also cut it down with the "
"right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano tiene cerezas. Si examinás el follaje más de cerca, podrías encontrar"
" algunos racimos. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for cherry tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  Looks like all the ripe bunches of cherries have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano tiene cerezas. Parece que todos los racimos maduros ya han sido "
"sacados. También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "juniper tree"
msgstr "enebro"

#. ~ Description for juniper tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years, first flowering.  On the second year "
"producing a green berry, the last, they produce their more famed blue "
"varieties.  If you examined the foliage more closely, you could probably "
"find some viable clusters.  You could also cut it down with the right tools."
msgstr ""
"Es una de las especies de 'Juniperus' que crece en New England, los frutos "
"del enebro crecen en dos o tres años, luego de florecer. Al segundo año "
"produce un fruto verde, al último, producen los más conocidos de color azul."
" Si examinás el follaje más de cerca, podrías encontrar algunos racimos. "
"También podrías talarlo con las herramientas adecuadas."

#. ~ Description for juniper tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years.  In the first year they flower, in the second"
" year they produce a green berry, the last, they produce their more famed "
"blue varieties.  Looks like all the ripe bunches of berries have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"Es una de las especies de 'Juniperus' que crece en New England, los frutos "
"del enebro crecen en dos o tres años. En el primer año florecen, en el "
"segundo año producen un fruto verde, y en el último, producen el fruto azul,"
" más conocido. Parece que todos los racimos maduros ya han sido sacados. "
"También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "peach tree"
msgstr "durazno"

#. ~ Description for peach tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  If you examined the branches more closely, you could"
" probably find some mature peaches.  You could also cut it down with the "
"right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano tiene duraznos. Si examinás el follaje más de cerca, podrías "
"encontrar algunos duraznos maduros. También podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for peach tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  Looks like all the ripe peaches have been picked.  "
"You could also cut it down with the right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano tiene duraznos. Parece que todos los duraznos maduros ya han sido "
"sacados. También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "apricot tree"
msgstr "damasco"

#. ~ Description for apricot tree
#: lang/json/terrain_from_json.py
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  If you examined the spurs more closely,"
" you could probably find some mature apricots.  You could also cut it down "
"with the right tools."
msgstr ""
"Es una de las especies transplantadas de 'Prunus armeniaca', raramente "
"encontrada en New England. En verano tiene damascos. Si examinás los brotes "
"de cerca, probablemente encuentres algunos damascos maduros. También podrías"
" talarlo con las herramientas adecuadas."

#. ~ Description for apricot tree
#: lang/json/terrain_from_json.py
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  Looks like all the ripe apricots have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"Es una de las especies transplantadas de 'Prunus armeniaca', raramente "
"encontrada en New England. En verano tiene damascos. Parece que todos los "
"damascos maduros ya han sido sacados. También podrías talarlo con las "
"herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "plum tree"
msgstr "ciruelo"

#. ~ Description for plum tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  If you examined the spurs more closely, you "
"could probably find some ripe plums.  You could also cut it down with the "
"right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano produce ciruelas. Si examinás los brotes más de cerca, podrías "
"encontrar algunas ciruelas maduras. También podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for plum tree
#: lang/json/terrain_from_json.py
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  Looks like all the ripe plums have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"Es una de las varias especies de 'Prunus' encontrados en New England, en "
"verano produce ciruelas. Parece que todas las ciruelas maduras ya han sido "
"sacadas. También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "mulberry tree"
msgstr "árbol de moras"

#. ~ Description for mulberry tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  In the summer many berries can be picked.  You could also "
"cut it down with the right tools."
msgstr ""
"Este árbol pertenece al género 'Morus', produce la fruta conocida comúnmente"
" como mora. Sus frutos pueden recolectarse durante el verano. También "
"podrías talarlo con las herramientas adecuadas."

#. ~ Description for mulberry tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  There doesn't appear to be any ripe mulberries now.  You "
"could also cut it down with the right tools."
msgstr ""
"Este árbol pertenece al género 'Morus', produce la fruta conocida comúnmente"
" como mora. Aunque no parece tener ninguna madura en este momento. También "
"podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "elderberry tree"
msgstr "árbol de bayas del saúco"

#. ~ Description for elderberry tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  In the summer many berries can be picked.  You could"
" also cut it down with the right tools."
msgstr ""
"Este árbol pertenece al género 'Sambucus', produce la fruta conocida "
"comúnmente como baya del saúco. Sus frutos pueden recolectarse durante el "
"verano. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for elderberry tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  There doesn't appear to be any ripe elderberries "
"now.  You could also cut it down with the right tools."
msgstr ""
"Este árbol pertenece al género 'Sambucus', produce la fruta conocida "
"comúnmente como baya del saúco. Aunque no parece tener ninguna madura en "
"este momento. También podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "pine tree"
msgstr "pino"

#. ~ Description for pine tree
#: lang/json/terrain_from_json.py
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"If you examined the tree more closely, you might find usable sticky whorls "
"and unharvested pinecones.  Also, you could cut it down with the right "
"tools."
msgstr ""
"Es un árbol conífero alto que pertenece al género 'Prunus', de alguna de las"
" variedades de New England como la 'P. strobus', 'P. resinosa' y 'P. "
"rigida'. Si examinás el árbol más de cerca, podrías encontrar algunas "
"espinas pegajosas y piñas. También podrías talarlo con las herramientas "
"adecuadas."

#. ~ Description for pine tree
#: lang/json/terrain_from_json.py
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"Some of the branches have been stripped away and many of the pinecones "
"aren't developed fully yet, but given a season, it could be harvestable "
"again.  Also, you could cut it down with the right tools."
msgstr ""
"Es un árbol conífero alto que pertenece al género 'Prunus', de alguna de las"
" variedades de New England como la 'P. strobus', 'P. resinosa' y 'P. "
"rigida'. Algunas de las ramas han sido peladas y muchas de las piñas todavía"
" no se han desarrollado completamente, pero dependiendo la temporada, "
"podrían volver a cosecharse. También podrías talarlo con las herramientas "
"adecuadas."

#: lang/json/terrain_from_json.py
msgid "dead pine tree"
msgstr "pino seco"

#. ~ Description for dead pine tree
#: lang/json/terrain_from_json.py
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"This trees branches are bare, and it appears to be dead.  You could cut it "
"down with the right tools."
msgstr ""
"Es un árbol conífero alto que pertenece al género 'Prunus', de alguna de las"
" variedades de New England como la 'P. strobus', 'P. resinosa' y 'P. "
"rigida'. Las ramas de este árbol están peladas y parece estar muerto. "
"Podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "birch tree"
msgstr "abedul"

#. ~ Description for birch tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  You could tear "
"off some strips of bark if you examined the tree more closely.  You could "
"cut it down with the right tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Betula', con su característica "
"corteza agrietada. Las especies más comunes en la región de New England son "
"'B. alleghaniensis', 'B. papyrifera', y 'B. populifolia'.  Podés arrancar "
"algunas piezas de la corteza si examinás el árbol de cerca. También podrías "
"talarlo con las herramientas adecuadas."

#. ~ Description for birch tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  Looks like "
"there isn't enough rhytidome to peel off yet.  You could cut it down with "
"the right tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Betula', con su característica "
"corteza agrietada. Las especies más comunes en la región de New England son "
"'B. alleghaniensis', 'B. papyrifera', y 'B. populifolia'. Parece que todavía"
" no hay suficiente ritidoma para arrancar la corteza. Podrías talarlo con "
"las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "willow tree"
msgstr "sauce"

#. ~ Description for willow tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  You could tear off some bark.  You "
"could cut it down with the right tools."
msgstr ""
"Es un árbol ancho y alto de hoja caduca del género 'Salix', con ramas largas"
" y finas con muchas hojas que cuelgan como cortinas. Podrías arrancarlo un "
"poco de corteza. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for willow tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  Looks like all usable bark has been "
"torn off, and new rhytidomes have not formed yet.  You could cut it down "
"with the right tools."
msgstr ""
"Es un árbol ancho y alto de hoja caduca del género 'Salix', con ramas largas"
" y finas con muchas hojas que cuelgan como cortinas. Parece que ya no le "
"queda corteza para sacarle, no se han formado nuevas ritidomas todavía. "
"Podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "maple tree"
msgstr "arce"

#. ~ Description for maple tree
#: lang/json/terrain_from_json.py
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  It could be tapped in order to extract maple "
"syrup.  You could cut it down with the right tools."
msgstr ""
"Es un árbol grande de hoja caduca del género 'Acer'. Las hojas tiene una "
"forma distintiva con cinco puntas. Puede ponérsele una espita para extraer "
"jarabe de arce. Podrías talarlo con las herramientas adecuadas."

#. ~ Description for maple tree
#: lang/json/terrain_from_json.py
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  A spigot is wedged into the trunk, and sweet maple"
" syrup can be extracted.  You could cut it down with the right tools."
msgstr ""
"Es un árbol grande de hoja caduca del género 'Acer'. Las hojas tiene una "
"forma distintiva con cinco puntas. Tiene una espita calzada en el tronco, y "
"se le puede extraer jarabe de arce. Podrías talarlo con las herramientas "
"adecuadas."

#: lang/json/terrain_from_json.py
msgid "hickory tree"
msgstr "jicoria"

#. ~ Description for hickory tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for hickory nuts"
" if you examined the tree more closely.  You could cut it down with the "
"right tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Carya'. Podrías ver si tiene "
"nueces jicoria si lo examinás de cerca. También podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for hickory tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It looks like the tree has been"
" picked clean of hickory nuts.  You could cut it down with the right tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Carya'. Parece que ya le han "
"sacado las nueces jicoria que tenía. Podrías talarlo con las herramientas "
"adecuadas."

#: lang/json/terrain_from_json.py
msgid "pistachio tree"
msgstr "pistachero"

#. ~ Description for pistachio tree
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  You could look for pistachio nuts if you "
"examined the tree more closely.  You could cut it down with the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Pistacia'. Es un árbol cultivado, no "
"es nativo de esta región. Podrías ver si tiene pistachos si lo examinás de "
"cerca. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for pistachio tree
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  Unfortunately, it looks like it has been picked"
" clean of pistachio nuts.  You could cut it down with the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Pistacia'. Es un árbol cultivado, no "
"es nativo de esta región. Lamentablemente, parece que ya le han quitado "
"todos los pistachos. Podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "almond tree"
msgstr "nogal"

#. ~ Description for almond tree
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for fresh almonds if you examined"
" the tree more closely.  You could cut it down with the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Prunus'. Es un árbol cultivado, no es"
" nativo de esta región. Podrías ver si tiene almendras si lo examinás de "
"cerca. También podrías talarlo con las herramientas adecuadas."

#. ~ Description for almond tree
#: lang/json/terrain_from_json.py
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  There are no almonds left to pick on the tree.  "
"You could cut it down with the right tools."
msgstr ""
"Es un árbol de hoja caduca del género 'Prunus'. Es un árbol cultivado, no es"
" nativo de esta región. Ya no tiene almendras para agarrar. Podrías talarlo "
"con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "pecan tree"
msgstr "pacano"

#. ~ Description for pecan tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for pecan nuts "
"if you examined the tree more closely.  You could cut it down with the right"
" tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Carya'. Podrías ver si tiene "
"nueces pecán si lo examinás de cerca. También podrías talarlo con las "
"herramientas adecuadas."

#. ~ Description for pecan tree
#: lang/json/terrain_from_json.py
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It doesn't look like there are "
"any pecan nuts left on the tree.  You could cut it down with the right "
"tools."
msgstr ""
"Es un árbol alto de hoja caduca del género 'Carya'. No parece que le hayan "
"quedado nueces pecán ahora. Podrías talarlo con las herramientas adecuadas."

#: lang/json/terrain_from_json.py
msgid "dead hickory tree"
msgstr "jicoria muerto"

#. ~ Description for dead hickory tree
#: lang/json/terrain_from_json.py
msgid ""
"The dead remnants of a tall deciduous tree of the 'Carya' genus.  Nothing "
"useful can be foraged from this poor, dead tree.  You could cut it down with"
" the right tools."
msgstr ""
"Son los restos muertos de un árbol alto de hoja caduca del género 'Carya'. "
"No se le puede sacar nada útil a este pobre árbol muerto. Pero podrías "
"cortarlo con las herramientas adecuadas."

#. ~ Description for underbrush
#: lang/json/terrain_from_json.py
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager "
"could obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr ""
"Son pequeñas plantas y arbustos que decoran el bosque. Un buscador de comida"
" avezado puede obtener plantas comestibles, bellotas, huevos y hongos ahí."

#: lang/json/terrain_from_json.py
msgid "brush."
msgstr "brash."

#. ~ Description for underbrush
#: lang/json/terrain_from_json.py
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr ""
"Son pequeñas plantas y arbustos que decoran el bosque. Ya han sido revueltas"
" y no tiene nada útil que sacarles."

#. ~ Description for underbrush
#: lang/json/terrain_from_json.py
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr ""
"Son pequeñas plantas y arbustos que decoran el bosque. Ya han sido revueltas"
" y no tiene nada útil que sacarles. Están cubiertas de escarcha."

#: lang/json/terrain_from_json.py
msgid "shrub"
msgstr "arbusto"

#. ~ Description for shrub
#: lang/json/terrain_from_json.py
msgid "A small shrub."
msgstr "Es un pequeño arbusto."

#: lang/json/terrain_from_json.py
msgid "peanut bush"
msgstr "arbusto de maní"

#. ~ Description for peanut bush
#: lang/json/terrain_from_json.py
msgid "A small bush of crunchy peanuts."
msgstr "Es un pequeño arbusto de crujientes maníes."

#. ~ Description for peanut bush
#: lang/json/terrain_from_json.py
msgid "A small peanut bush that's fruitless."
msgstr "Es un pequeño arbusto de maní sin frutos."

#: lang/json/terrain_from_json.py
msgid "blueberry bush"
msgstr "arbusto de moras azules"

#. ~ Description for blueberry bush
#: lang/json/terrain_from_json.py
msgid "A small bush of sweet blueberries."
msgstr "Es un pequeño arbusto de moras azules dulces."

#. ~ Description for blueberry bush
#: lang/json/terrain_from_json.py
msgid "A small blueberry bush that's fruitless."
msgstr "Es un pequeño arbusto de moras azules sin frutos."

#: lang/json/terrain_from_json.py
msgid "strawberry bush"
msgstr "arbusto de frutillas"

#. ~ Description for strawberry bush
#: lang/json/terrain_from_json.py
msgid "A small bush of juicy strawberries."
msgstr "Es un pequeño arbusto de jugosas frutillas."

#. ~ Description for strawberry bush
#: lang/json/terrain_from_json.py
msgid "A small strawberry bush that's fruitless."
msgstr "Es un pequeño arbusto de frutillas sin frutos."

#: lang/json/terrain_from_json.py
msgid "blackberry bush"
msgstr "arbusto de zarzamoras"

#. ~ Description for blackberry bush
#: lang/json/terrain_from_json.py
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de deliciosas zarzamoras. Tené cuidado con las "
"espinas."

#. ~ Description for blackberry bush
#: lang/json/terrain_from_json.py
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de zarzamoras sin frutos. Tené cuidado con las "
"espinas."

#: lang/json/terrain_from_json.py
msgid "huckleberry bush"
msgstr "arbusto de arándanos agrios"

#. ~ Description for huckleberry bush
#: lang/json/terrain_from_json.py
msgid "A small bush of huckleberries, often mistaken as blueberries."
msgstr ""
"Es un pequeño arbusto de arándanos agrios, a menudo confundidos con las "
"moras azules."

#. ~ Description for huckleberry bush
#: lang/json/terrain_from_json.py
msgid "A small huckleberry bush that's fruitless."
msgstr "Es un pequeño arbusto de arándanos agrios sin frutos."

#: lang/json/terrain_from_json.py
msgid "raspberry bush"
msgstr "arbusto de frambuesas"

#. ~ Description for raspberry bush
#: lang/json/terrain_from_json.py
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de deliciosas frambuesas. Tené cuidado con las "
"espinas."

#. ~ Description for raspberry bush
#: lang/json/terrain_from_json.py
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr ""
"Es un pequeño arbusto de frambuesas sin frutos. Tené cuidado con las "
"espinas."

#: lang/json/terrain_from_json.py
msgid "grape bush"
msgstr "arbusto de uvas"

#. ~ Description for grape bush
#: lang/json/terrain_from_json.py
msgid "A bush of a different species invaded by vines of grapes."
msgstr "Es un arbusto de diferente especie invadido por la vid de la uva."

#. ~ Description for grape bush
#: lang/json/terrain_from_json.py
msgid ""
"A bush of a different species invaded by grape vines but they're fruitless."
msgstr ""
"Es un arbusto de diferente especie invadido por la vid de la uva pero sin "
"frutos."

#: lang/json/terrain_from_json.py
msgid "rose bush"
msgstr "arbusto de rosas"

#. ~ Description for rose bush
#: lang/json/terrain_from_json.py
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""
"Es un arbusto gordo de hermosas rosas rojas, ¡si pudieras tener pareja! "
"Cuidado con las espinas."

#. ~ Description for rose bush
#: lang/json/terrain_from_json.py
msgid ""
"A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr ""
"Es un arbusto gordo de rosas sin flores. Tené cuidado con las espinas."

#: lang/json/terrain_from_json.py
msgid "hydrangea bush"
msgstr "arbusto de hortensia"

#. ~ Description for hydrangea bush
#: lang/json/terrain_from_json.py
msgid "A fat, bush of fragrant blue hydrangeas."
msgstr "Es un arbusto gordo de aromáticas hortensias azules."

#. ~ Description for hydrangea bush
#: lang/json/terrain_from_json.py
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Es un arbusto gordo de hortensias pero sin flores."

#: lang/json/terrain_from_json.py
msgid "lilac bush"
msgstr "arbusto de lilas"

#. ~ Description for lilac bush
#: lang/json/terrain_from_json.py
msgid "A wide, bush of bright pinkish purple lilacs."
msgstr "Es un arbusto ancho con brillantes lílas púrpuras y rosadas."

#. ~ Description for lilac bush
#: lang/json/terrain_from_json.py
msgid "A wide lilac bush that currently has no blooms."
msgstr "Es un arbusto ancho de lilas pero sin flores."

#: lang/json/terrain_from_json.py
msgid "tree trunk"
msgstr "tronco de árbol"

#. ~ Description for tree trunk
#: lang/json/terrain_from_json.py
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into "
"logs with the right tool."
msgstr ""
"Es un pedazo de tronco de un árbol que ha sido cortado. Puede ser serruchado"
" con la herramienta adecuada."

#: lang/json/terrain_from_json.py
msgid "tree stump"
msgstr "tocón"

#. ~ Description for tree stump
#: lang/json/terrain_from_json.py
msgid "A tree stump, remnant of a tree that has been cut down."
msgstr "Es un tocón, resto de un árbol que ha sido cortado."

#: lang/json/terrain_from_json.py
msgid "woodchips"
msgstr "astillas de madera"

#. ~ Description for woodchips
#: lang/json/terrain_from_json.py
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""
"Son pequeñas astillas de madera tiradas formando una capa para evitar que "
"crezcan plantas no deseadas."

#. ~ Description for grass
#: lang/json/terrain_from_json.py
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a"
" patch of dirt."
msgstr ""
"Es un área de pasto azul de Kentucky, que te llega a los tobillos. Si cortás"
" el pasto bien corto vas a destruir el sistema de raíces, causando que este "
"lugar se transforme en un pedazo de tierra."

#: lang/json/terrain_from_json.py
msgid "white grass"
msgstr "pasto blanco"

#. ~ Description for white grass
#: lang/json/terrain_from_json.py
msgid ""
"A section of Kentucky bluegrass covered in white latex-based paint, with "
"neat lines designed for recreational sports."
msgstr ""
"Es un área de pasto azul de Kentucky cubierta de pintura de látex blanca, "
"con prolijas líneas diseñadas para deportes recreativos."

#: lang/json/terrain_from_json.py
msgid "long grass"
msgstr "pasto largo"

#. ~ Description for long grass
#: lang/json/terrain_from_json.py
msgid "Long shaggy grass about shin high."
msgstr "Es pasto largo y desprolijo que llega a la altura de las rodillas."

#: lang/json/terrain_from_json.py
msgid "tall grass"
msgstr "pasto alto"

#. ~ Description for tall grass
#: lang/json/terrain_from_json.py
msgid "Tall grass about head high."
msgstr "Es pasto alto que te llega a la cabeza."

#: lang/json/terrain_from_json.py
msgid "dead grass"
msgstr "pasto seco"

#. ~ Description for dead grass
#: lang/json/terrain_from_json.py
msgid "Long shaggy grass that hasn't been cut recently."
msgstr "Es pasto largo y desprolijo que hace rato que no lo cortan."

#: lang/json/terrain_from_json.py
msgid "golf green"
msgstr "green"

#. ~ Description for golf green
#: lang/json/terrain_from_json.py
msgid "Grass mowed very short and neat."
msgstr ""
"Es pasto cortado muy cortito y prolijo, el que se ve en el green de las "
"canchas de golf."

#: lang/json/terrain_from_json.py
msgid "golf hole"
msgstr "hoyo de golf"

#. ~ Description for golf hole
#: lang/json/terrain_from_json.py
msgid "A small plastic cup embedded in the grass."
msgstr "Es un pequeño vaso de plástico metido en el pasto."

#: lang/json/terrain_from_json.py
msgid "fern"
msgstr "helecho"

#. ~ Description for fern
#: lang/json/terrain_from_json.py
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr ""
"Es una planta petisa con cientos de hojas que crece en un patrón fractal "
"desde el tallo."

#. ~ Description for fern
#: lang/json/terrain_from_json.py
msgid ""
"A short plant with thousands leaves which grow in a fractal pattern, without"
" any curled shoots."
msgstr ""
"Es una planta petisa con cientos de hojas que crece en un patrón fractal, "
"sin brotes enrulados."

#: lang/json/terrain_from_json.py
msgid "marloss bush"
msgstr "arbusto de marloss"

#. ~ Description for marloss bush
#: lang/json/terrain_from_json.py
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"Esta planta extraterrestre es similar al arbusto de la mora azul, y le "
"cuelgan pomos grandes, jugosos y rosas que emiten un aroma embriagador y "
"frutal."

#: lang/json/terrain_from_json.py
msgid "poof!"
msgstr "¡puf!"

#: lang/json/terrain_from_json.py
msgid "fungal bed"
msgstr "cama fúngica"

#. ~ Description for fungal bed
#: lang/json/terrain_from_json.py
msgid "Fungus grows thick here, obscuring the ground beneath it."
msgstr "Los hongos crecen abundantes acá, oscureciendo el suelo debajo."

#: lang/json/terrain_from_json.py
msgid "fungal floor"
msgstr "suelo fúngico"

#. ~ Description for fungal floor
#: lang/json/terrain_from_json.py
msgid ""
"Grayish mold coats both the floor and the roof here, silent and still.  "
"Stray spores waft through the air."
msgstr ""
"Un moho gris cubre tanto el piso como el techo acá, silencioso y quieto. "
"Unas esporas flotan descarriadas por el aire."

#. ~ Description for fungal floor
#: lang/json/terrain_from_json.py
msgid "Grayish mold coats the floor here, silent and still."
msgstr "Un moho gris cubre el piso acá, silencioso y quieto."

#. ~ Description for fungal floor
#: lang/json/terrain_from_json.py
msgid "Grayish mold coats the ground here, silent and still."
msgstr "Un moho gris cubre el terreno acá, silencioso y quieto."

#. ~ Description for fungal wall
#: lang/json/terrain_from_json.py
msgid ""
"Several thick, large tendrils of fungus perforate the wall here, piercing "
"straight through it from the outside.  Despite the apparent damage, the wall"
" is still structurally sound."
msgstr ""
"Varios zarcillos gruesos y grandes de hongos perforan la pared acá, "
"atravesándola desde afuera. A pesar del daño aparente, la pared todavía está"
" estructuralmente bien."

#. ~ Description for fungal wall
#: lang/json/terrain_from_json.py
msgid ""
"The fungus here has grown thickly and tightly enough to form a solid wall.  "
"It feels very stiff to the touch, and seems to be very strong."
msgstr ""
"Los hongos acá han crecido abundantes y apretados como para formar una pared"
" sólida. Se siente muy rígida al tacto y parece ser muy fuerte."

#: lang/json/terrain_from_json.py
msgid "fungal mound"
msgstr "montículo fúngico"

#. ~ Description for fungal mound
#: lang/json/terrain_from_json.py
msgid "A mound of fungal matter, intertwined in itself."
msgstr "Es un montículo de materia fúngica, entrelazándose consigo misma."

#: lang/json/terrain_from_json.py
msgid "fungal shrub"
msgstr "arbusto fúngico"

#. ~ Description for fungal shrub
#: lang/json/terrain_from_json.py
msgid ""
"This shrub has been completely absorbed by the mushrooms.  Its branches "
"droop and have lost much of their structure, and its leaves have vanished, "
"replaced by fleshy gray sacks that visibly expand and contract."
msgstr ""
"Este arbusto ha sido completamente absorbido por los hongos. Sus ramas caen "
"y han perdido su estructura, y sus hojas han desaparecido, reemplazadas por "
"sacos grises carnosos que se expanden y se contraen visiblemente."

#: lang/json/terrain_from_json.py
msgid "fungal tree"
msgstr "árbol fúngico"

#. ~ Description for fungal tree
#: lang/json/terrain_from_json.py
msgid ""
"Once tall and majestic, this tree is now a slave to the fungus like the "
"landscape around it.  Its bark is penetrated by and covered with fungal "
"tendrils, and the canopy has rotted away, leaving only the branches, "
"stretching forlornly to the sky as if to escape the infection overrunning "
"it."
msgstr ""
"Este árbol que alguna vez fue alto y majestuoso, ahora es un esclavo de los "
"hongos al igual que el paisaje a su alrededor. Su corteza está penetrada y "
"cubierta por zarcillos fúngicos, y su dosel se ha podrido, dejando solo las "
"ramas, tristemente alzándose al cielo como si pudieran escapar a la "
"infección."

#: lang/json/terrain_from_json.py
msgid "young fungal tree"
msgstr "árbol joven fúngico"

#. ~ Description for young fungal tree
#: lang/json/terrain_from_json.py
msgid "A small sapling poking through the ground, infested by fungal mold."
msgstr "Es un pequeño brote que sale del suelo, infectado de moho fúngico."

#: lang/json/terrain_from_json.py
msgid "marloss tree"
msgstr "árbol de marloss"

#. ~ Description for marloss tree
#: lang/json/terrain_from_json.py
msgid ""
"This tree stands as a stark outlier to the landscape around it.  Despite its"
" infestation, its leaves wave proudly in the wind, colored pinkish-white.  "
"Its branches are heavy with pink fruit that looks both mutated and "
"delicious."
msgstr ""
"Este árbol se yergue apartado y escueto del paisaje a su alrededor. A pesar "
"de su infestación, sus hojas se agitan con orgullo en el viento, de un color"
" rosa blancuzco. Sus ramas son pesadas con frutas rosas que parece tanto "
"deliciosas como mutadas."

#: lang/json/terrain_from_json.py
msgid "shallow water"
msgstr "agua poco profunda"

#. ~ Description for shallow water
#: lang/json/terrain_from_json.py
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Acá el agua no es muy profunda. Con un recipiente hermético podrías "
"recolectar agua dulce. Pero no es seguro tomarla así como está."

#: lang/json/terrain_from_json.py
msgid "deep water"
msgstr "agua profunda"

#. ~ Description for deep water
#: lang/json/terrain_from_json.py
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather fresh water from here.  Not safe to "
"drink as is."
msgstr ""
"Tenés problemas para ver el fondo a través del agua profunda. Con un "
"recipiente hermético, podrías recolectar agua dulce. No es seguro tomarla "
"así como está."

#: lang/json/terrain_from_json.py
msgid "murky shallow water"
msgstr "agua turbia poco profunda"

#. ~ Description for murky shallow water
#: lang/json/terrain_from_json.py
msgid ""
"The water isn't too deep here but is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Acá el agua no es muy profunda pero es turbia y tiene materia orgánica. Con "
"un recipiente hermético podrías recolectar agua fétida. Aunque no es seguro "
"tomarla así como está."

#. ~ Description for murky shallow water
#: lang/json/terrain_from_json.py
msgid ""
"The water isn't too deep here but it is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Acá el agua no es muy profunda pero es turbia y tiene materia orgánica. Con "
"un recipiente hermético podrías recolectar agua fétida. Aunque no es seguro "
"tomarla así como está."

#: lang/json/terrain_from_json.py
msgid "flowing shallow water"
msgstr "corriente de agua poco profunda"

#. ~ Description for flowing shallow water
#: lang/json/terrain_from_json.py
msgid ""
"The streaming water isn't too deep here.  With a watertight container, you "
"could gather fresh water from here.  Not safe to drink as is, although "
"probably safer than stagnant water."
msgstr ""
"Esta corriente de agua no es muy profunda acá. Con un recipiente hermético "
"podrías recolectar agua dulce. No es seguro tomarla así, aunque "
"probablemente sea más segura que el agua estancada."

#: lang/json/terrain_from_json.py
msgid "flowing deep water"
msgstr "corriente de agua profunda"

#. ~ Description for flowing deep water
#: lang/json/terrain_from_json.py
msgid ""
"The streaming water looks deep here.  With a watertight container, you could"
" gather fresh water from here.  Not safe to drink as is, although probably "
"safer than stagnant water."
msgstr ""
"Esta corriente de agua parece profunda acá. Con un recipiente hermético "
"podrías recolectar agua dulce. No es seguro tomarla así, aunque "
"probablemente sea más segura que el agua estancada."

#. ~ Description for shallow water
#: lang/json/terrain_from_json.py
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather salt water from here."
msgstr ""
"Acá el agua no es muy profunda. Con un recipiente hermético podrías "
"recolectar agua salada."

#. ~ Description for deep water
#: lang/json/terrain_from_json.py
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather salt water from here."
msgstr ""
"Tenés problemas para ver el fondo a través del agua profunda. Con un "
"recipiente hermético, podrías recolectar agua salada."

#: lang/json/terrain_from_json.py
msgid "pool water"
msgstr "charco de agua"

#. ~ Description for pool water
#: lang/json/terrain_from_json.py
msgid ""
"A deep pool full of water.  Never swim without a lifeguard present.  Even "
"though monsters probably ate them."
msgstr ""
"Es un charco profundo lleno de agua. No nadar sin un guardavidas presente. "
"Incluso aunque sea probable que se los hayan comido los monstruos."

#: lang/json/terrain_from_json.py
msgid "shallow pool water"
msgstr "charco poco profundo de agua"

#. ~ Description for shallow pool water
#: lang/json/terrain_from_json.py
msgid "A shallow pool of water."
msgstr "Es un charco poco profundo de agua."

#: lang/json/terrain_from_json.py
msgid "sewage"
msgstr "agua cloacal"

#. ~ Description for sewage
#: lang/json/terrain_from_json.py
msgid ""
"Gross.  Sewage water flows through here.  As if it needed saying, this isn't"
" safe to drink."
msgstr ""
"Un asco. Agua cloacal va pasando por acá. Como si fuera necesario decirlo, "
"no es seguro tomarla."

#: lang/json/terrain_from_json.py lang/json/trap_from_json.py
msgid "lava"
msgstr "lava"

#. ~ Description for lava
#: lang/json/terrain_from_json.py
msgid ""
"An extremely hot, glowing liquid, composed of molten rock and/or metal.  In "
"some places, lava-grilled steak is a delicacy."
msgstr ""
"Es un líquido brillante y extremadamente caliente, compuesto de roca "
"derretida y/o metal. En algunas partes, los bifes hechos a la lava son una "
"exquisitez."

#: lang/json/terrain_from_json.py
msgid "submersed water"
msgstr "agua sumergida"

#. ~ Description for submersed water
#: lang/json/terrain_from_json.py
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"Estás sumergido debajo de la superficie del agua, tus pies no pueden tocar "
"el fondo. Con un recipiente hermético, podrías recolectar agua dulce. No es "
"seguro tomarla así como está."

#: lang/json/terrain_from_json.py
msgid "lake bed"
msgstr "lecho de lago"

#. ~ Description for lake bed
#: lang/json/terrain_from_json.py
msgid ""
"You are standing at the bottom of a body of fresh water.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Estás parado en el fondo de un cuerpo de agua dulce. Con un recipiente "
"hermético, podrías recolectar agua dulce. No es seguro tomarla así como "
"está."

#: lang/json/terrain_from_json.py
msgid "ocean bed"
msgstr "lecho de océano"

#. ~ Description for ocean bed
#: lang/json/terrain_from_json.py
msgid ""
"You are standing at the bottom of a body of salt water.  With a watertight "
"container, you could gather salt water from here.  Not safe to drink as is."
msgstr ""
"Estás parado en el fondo de un cuerpo de agua salada. Con un recipiente "
"hermético, podrías recolectar agua salada. No es seguro tomarla así como "
"está."

#: lang/json/terrain_from_json.py
msgid "bulkhead"
msgstr "mamparo"

#. ~ Description for bulkhead
#: lang/json/terrain_from_json.py
msgid ""
"The top of a submerged structure.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Es la parte superior de una estructura sumergida. Con un recipiente "
"hermético, podrías recolectar agua dulce. No es seguro tomarla así como "
"está."

#. ~ Description for bulkhead
#: lang/json/terrain_from_json.py
msgid "The bottom of a submerged structure."
msgstr "Es la parte inferior de una estructura sumergida."

#: lang/json/terrain_from_json.py
msgid "submerged concrete"
msgstr "concreto sumergido"

#. ~ Description for submerged concrete
#: lang/json/terrain_from_json.py
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of "
"concrete.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"Estás parado en el fondo de un cuerpo de agua dulce en un relleno de "
"concreto. Con un recipiente hermético, podrías recolectar agua dulce. No es "
"seguro tomarla así como está."

#. ~ Description for submerged concrete
#: lang/json/terrain_from_json.py
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of yellow-"
"painted concrete.  With a watertight container, you could gather fresh water"
" from here.  Not safe to drink as is."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "hot spring water"
msgstr "agua termal"

#. ~ Description for hot spring water
#: lang/json/terrain_from_json.py
msgid ""
"Scalding hot water, not particularly safe for swimming.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "metal compactor"
msgstr "compactadora de metal"

#. ~ Description for metal compactor
#: lang/json/terrain_from_json.py
msgid ""
"A hydraulic machine for squeezing scrap into more compact chunks.  Useless "
"now that there's no power."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "gasoline pump"
msgstr "surtidor de nafta"

#. ~ Description for gasoline pump
#: lang/json/terrain_from_json.py
msgid ""
"Precious GASOLINE.  The former world bowed to their petroleum god as it led "
"them to their ruin.  There's plenty left over to fuel your inner road "
"warrior.  If this gas dispenser doesn't give up the goods for free, you may "
"have to pay at a nearby terminal."
msgstr ""
"Preciosa NAFTA. El mundo anterior estaba sometido a su dios petróleo "
"mientras lo guiaba hacia su ruina. Todavía hay suficiente como para "
"alimentar tu guerrero de la carretera interior. Si este surtidor no otorga "
"si contenido gratuitamente, tal vez tengas que pagarlo en una terminal "
"cercana."

#: lang/json/terrain_from_json.py
msgid "smashed gas pump"
msgstr "surtidor de nafta roto"

#. ~ Description for smashed gas pump
#: lang/json/terrain_from_json.py
msgid ""
"The horror!  This gasoline pump has been destroyed, denying you access to "
"the liquid gold."
msgstr ""
"¡El horror! Este surtidor de nafta ha sido destruido, negándote el acceso al"
" oro líquido."

#: lang/json/terrain_from_json.py
msgid "diesel pump"
msgstr "surtidor diésel"

#. ~ Description for diesel pump
#: lang/json/terrain_from_json.py
msgid ""
"This is a diesel fuel pump.  This roadside attraction provides all the "
"thick, gloopy liquid POWER you need to move your sensibly oversized "
"APOCOLYPTIC SUPERTRUCK from point A to points beyond.  If it doesn't "
"dispense fuel immediately, try banging on it or grunt your way over the "
"nearby payment terminal."
msgstr ""
"Esto es un surtidor de gasoil. Esta atracción brinda todo el PODER líquido, "
"espeso y pegajoso que necesitás para mover tu sensiblemente "
"sobredimensionado SUPERCAMIÓN APOCALÍPTICO del punto A a los puntos "
"siguientes. Si no expende inmediatamente el combustible, intentá golpearlo o"
" ir puteando hasta la terminal cercana de pago."

#: lang/json/terrain_from_json.py
msgid "smashed diesel pump"
msgstr "surtidor diésel roto"

#. ~ Description for smashed diesel pump
#: lang/json/terrain_from_json.py
msgid ""
"You're not getting any diesel out of this pump any time soon.  Some "
"barbarian decided to take their frustration out on it."
msgstr ""
"No vas a poder conseguir nada de gasoil de este surtidor. Algún bárbaro ha "
"decidido liberar toda su frustración en él."

#: lang/json/terrain_from_json.py
msgid "JP8 pump"
msgstr "surtidor de JP8"

#. ~ Description for JP8 pump
#: lang/json/terrain_from_json.py
msgid ""
"This pump is filled with JP8.  If this gas dispenser doesn't give up the "
"goods for free, you may have to pay at a nearby terminal."
msgstr ""
"Este surtidor está lleno de JP8. Si este surtidor no otorga si contenido "
"gratuitamente, tal vez tengas que pagarlo en una terminal cercana."

#: lang/json/terrain_from_json.py
msgid "smashed JP8 pump"
msgstr "surtidor de JP8 roto"

#. ~ Description for smashed JP8 pump
#: lang/json/terrain_from_json.py
msgid ""
"You're not getting any JP8 out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"No vas a poder conseguir nada de JP8 de este surtidor. Algún bárbaro ha "
"decidido liberar toda su frustración en él."

#: lang/json/terrain_from_json.py
msgid "avgas pump"
msgstr ""

#. ~ Description for avgas pump
#: lang/json/terrain_from_json.py
msgid ""
"This pump is filled with avgas.  If this gas dispenser doesn't give up the "
"goods for free, you may have to pay at a nearby terminal."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "smashed avgas pump"
msgstr ""

#. ~ Description for smashed avgas pump
#: lang/json/terrain_from_json.py
msgid ""
"You're not getting any avgas out of this pump any time soon.  Some barbarian"
" decided to take their frustration out on it."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "ATM"
msgstr "cajero automático"

#. ~ Description for ATM
#: lang/json/terrain_from_json.py
msgid ""
"For your banking convenience, this Automated Teller Machine is fully capable"
" of operating autonomously in the event of complete network failure.  You "
"can deposit funds from cash cards and migrate all of your inflation-adjusted"
" earnings to a single card.  These things have seen better days.  There's "
"been a run on the bank, and this machine has the dents and cracks to prove "
"it."
msgstr ""
"Para tu conveniencia bancaria, este Cajero Automático es completamente capaz"
" de operar de manera autónoma en el caso de un fallo total de la red. Podés "
"depositar fondos desde tarjetas de crédito y transferir todas tus ganancias "
"ajustadas por inflación a una sola tarjeta. Estas cosas han visto días "
"mejores. Ha habido una corrida bancaria y esta máquina tiene las marcas y "
"golpes que lo demuestran."

#: lang/json/terrain_from_json.py
msgid "Critical failure imminent, self destruct activated.  Have a nice day!"
msgstr ""
"Fallo crítico inminente, auto-destrucción activada. ¡Que tengas un buen día!"

#: lang/json/terrain_from_json.py
msgid "ticket vendor"
msgstr "expendedora de vales"

#. ~ Description for ticket vendor
#: lang/json/terrain_from_json.py
msgid ""
"This machine has a little screen, and slots intended to take your money and "
"provide you with a ticket."
msgstr ""
"Esta máquina posee una pequeña pantalla y unas ranuras con la intención de "
"recibir tu dinero y brindarte un vale."

#: lang/json/terrain_from_json.py
msgid "ticket machine"
msgstr "máquina de vales"

#. ~ Description for ticket machine
#: lang/json/terrain_from_json.py
msgid ""
"This machine will provide you access to whatever is beyond it - for the "
"price of a ticket, of course."
msgstr ""
"Esta máquina te brindará acceso a lo que sea que esté detrás - por el precio"
" de un vale, por supuesto."

#: lang/json/terrain_from_json.py
msgid "ventilation shutters"
msgstr "rejillas de ventilación"

#. ~ Description for ventilation shutters
#: lang/json/terrain_from_json.py
msgid ""
"A large wall mounted panel, covered fragile metal sheets that regulate "
"airflow."
msgstr ""
"Es un panel grande montado en la pared, cubierto con láminas frágiles de "
"metal que regulan el flujo de aire."

#: lang/json/terrain_from_json.py
msgid "missile"
msgstr "misil"

#. ~ Description for missile
#: lang/json/terrain_from_json.py
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that goes to the moon."
msgstr ""
"Esto es una sección de un ICBM, un Misil Balístico Intercontinental. Este es"
" el tipo de cohetes que llegan a la luna."

#: lang/json/terrain_from_json.py
msgid "blown-out missile"
msgstr "misil explotado"

#. ~ Description for blown-out missile
#: lang/json/terrain_from_json.py
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that's going anywhere."
msgstr ""
"Esto es una sección de un ICBM, un Misil Balístico Intercontinental. Este es"
" el tipo de cohetes que llegan a cualquier parte."

#. ~ Description for radio tower
#: lang/json/terrain_from_json.py
msgid "This is the structure of a radio transmission tower."
msgstr "Esta es la estructura de una torre de transmisión de radio."

#: lang/json/terrain_from_json.py
msgid "radio controls"
msgstr "radiocontroles"

#. ~ Description for radio controls
#: lang/json/terrain_from_json.py
msgid ""
"This console appears to control a nearby radio transmission tower.  It "
"doesn't seem to be fully operational."
msgstr ""
"Esta consola parece controlar la torre de transmisión de radio cercana. No "
"parece estar funcionando completamente."

#: lang/json/terrain_from_json.py
msgid "high gauge pipe"
msgstr "caño de gran espesor"

#. ~ Description for high gauge pipe
#: lang/json/terrain_from_json.py
msgid "This is a section of high gauge pipe."
msgstr "Este es un pedazo de un caño de gran espesor."

#: lang/json/terrain_from_json.py
msgid "high gauge pump"
msgstr "bomba de gran espesor"

#. ~ Description for high gauge pump
#: lang/json/terrain_from_json.py
msgid ""
"This unpowered pump previously would have moved fluids around in a hurry."
msgstr ""
"Esta bomba sin energía en algún momento movía fluidos por todas partes a "
"gran velocidad."

#: lang/json/terrain_from_json.py
msgid "CVD machine"
msgstr "máquina CVD"

#. ~ Description for CVD machine
#: lang/json/terrain_from_json.py
msgid ""
"The bulk of a highly technical-looking apparatus controlled by a nearby "
"console."
msgstr ""
"Es la mole de un aparato de apariencia técnica controlado por una consola "
"cercana."

#: lang/json/terrain_from_json.py
msgid "CVD control panel"
msgstr "panel de control de CVD"

#. ~ Description for CVD control panel
#: lang/json/terrain_from_json.py
msgid ""
"This is a VERY expensive-looking apparatus that's labeled 'Chemical Vapor "
"Deposition Machine'.  With the input of certain exceptionally rare chemicals"
" and elements, one could conceivably coat one's weapon with diamond.  While "
"the process is extremely complicated, a previous user has helpfully "
"sketched: Hydrogen + charcoal = smiley face."
msgstr ""
"Este es un aparato que parece MUY caro y está etiquetado como 'Máquina de "
"Deposición de Vapores Químicos'. Cuando se le meten ciertos químicos "
"excepcionalmente raros, uno podría posiblemente cubrir su arma con diamante."
" Aunque el proceso es extremadamente complicado, un usuario previo ha dejado"
" una ayuda: Hidrógeno + carbón vegetal = carita sonriente."

#: lang/json/terrain_from_json.py
msgid "nanofabricator"
msgstr "nanofabricador"

#. ~ Description for nanofabricator
#: lang/json/terrain_from_json.py
msgid ""
"A great column of advanced machinery.  Within this self-contained, "
"miniaturized factory, several 3d printers work in tandem with a robotic "
"assembler to manufacture nearly any inorganic object."
msgstr ""
"Es un gran artículo de maquinaria avanzada. Dentro de esta fabrica "
"miniatura, varias impresoras 3D trabajan en tandem con un ensamblador "
"robótico para fabricar casi cualquier objeto inorgánico."

#: lang/json/terrain_from_json.py
msgid "nanofabricator control panel"
msgstr "panel de control de nanofabricador"

#. ~ Description for nanofabricator control panel
#: lang/json/terrain_from_json.py
msgid ""
"A small computer panel attached to a nanofabricator.  It has a single slot "
"for reading templates."
msgstr ""
"Es un pequeño panel computarizado unido a un nanofabricador. Tiene una "
"ranura para leer plantillas."

#: lang/json/terrain_from_json.py
msgid "cloning vat"
msgstr "tanque de clonación"

#. ~ Description for cloning vat
#: lang/json/terrain_from_json.py
msgid ""
"A vat full of solution, probably intended to hold growing clones of people "
"or other life forms."
msgstr ""
"Es un tanque lleno de una solución, probablemente diseñado para contener "
"clones creciendo de gente o de otras formas de vida."

#: lang/json/terrain_from_json.py
msgid "plunk."
msgstr "plank"

#: lang/json/terrain_from_json.py
msgid "slot machine"
msgstr "máquina tragamonedas"

#. ~ Description for slot machine
#: lang/json/terrain_from_json.py
msgid ""
"A machine with a bright screen flashing hypnotic promises of wealth.  If "
"gambling with your life on a daily basis isn't enough for you, you can also "
"gamble with this."
msgstr ""
"Es una máquina con una pantalla brillante con promesas hipnóticas de "
"riqueza. Si jugarte la vida todos los días no es suficiente para vos, "
"también podés jugar con esto."

#: lang/json/terrain_from_json.py
msgid "water pump"
msgstr "bomba de agua"

#. ~ Description for water pump
#: lang/json/terrain_from_json.py
msgid ""
"Deep well collecting ground water.  Installed water pump allows to draw "
"water from it."
msgstr ""
"Es un pozo profundo usado para recolectar agua subterránea. Tiene instalada "
"una bomba que permite sacar el agua de ahí."

#: lang/json/terrain_from_json.py
msgid "water dispenser"
msgstr "dispenser"

#. ~ Description for water dispenser
#: lang/json/terrain_from_json.py
msgid "A machine with several taps that dispenses clean water."
msgstr "Es una máquina con varias canillas que dispensan agua potable."

#: lang/json/terrain_from_json.py
msgid "telecom cabinet"
msgstr "cabina de telecomunicación"

#. ~ Description for telecom cabinet
#: lang/json/terrain_from_json.py
msgid ""
"A cabinet full of telecoms equipment.  With the lines down, you might be "
"able to take it apart for its useful electronics."
msgstr ""
"Es un armario lleno de equipo de telecomunicaciones. Con las líneas caídas, "
"tal vez puedas desarmarlos para recuperar las piezas electrónicas."

#: lang/json/terrain_from_json.py
msgid "damaged telecom cabinet"
msgstr "cabina dañada de telecomunicación"

#. ~ Description for damaged telecom cabinet
#: lang/json/terrain_from_json.py
msgid ""
"A damaged telecoms cabinet.  Might still be able to salvage some useful "
"electronics scrap from it."
msgstr ""
"Es una cabina dañada de telecomunicaciones. Tal vez todavía pueda "
"recuperarse algunos elementos electrónicos de acá."

#: lang/json/terrain_from_json.py
msgid "HV oil circuit breaker"
msgstr "disyuntor en aceite de alta tensión"

#. ~ Description for HV oil circuit breaker
#: lang/json/terrain_from_json.py
msgid "A circuit breaker that uses oil in its arc suppression chamber."
msgstr "Es un disyuntor que utiliza aceite en su cámara de supresión de arco."

#: lang/json/terrain_from_json.py
msgid "pow!"
msgstr "¡pam!"

#: lang/json/terrain_from_json.py
msgid "small HV oil circuit breaker"
msgstr "disyuntor en aceite chico de alta tensión"

#. ~ Description for small HV oil circuit breaker
#: lang/json/terrain_from_json.py
msgid "A small circuit breaker that uses oil in its arc suppression chamber."
msgstr ""
"Es un disyuntor pequeño que utiliza aceite en su cámara de supresión de "
"arco."

#: lang/json/terrain_from_json.py
msgid "large switchgear"
msgstr "dispositivo de distribución grande"

#. ~ Description for large switchgear
#: lang/json/terrain_from_json.py
msgid ""
"A switchgear panel.  It's covered in breaker switches, fuses, and gauges."
msgstr ""
"Es un panel de distribución. Está lleno de interruptores, fusibles e "
"indicadores."

#: lang/json/terrain_from_json.py
msgid "small switchgear"
msgstr "dispositivo de distribución chico"

#. ~ Description for small switchgear
#: lang/json/terrain_from_json.py
msgid ""
"A small switchgear panel.  It's covered in breaker switches, fuses, and "
"gauges."
msgstr ""
"Es un panel pequeño de distribución. Está lleno de interruptores, fusibles e"
" indicadores."

#: lang/json/terrain_from_json.py
msgid "lightning arrester"
msgstr "descargador de corriente de rayo"

#. ~ Description for lightning arrester
#: lang/json/terrain_from_json.py
msgid ""
"A component designed to protect insulation and conductors in an electrical "
"system by directing lightning through itself and into the ground."
msgstr ""
"Es un componente diseñado para proteger la aislación y conductores en un "
"sistema eléctrico al dirigir la electricidad a través de sí mismo y a "
"tierra."

#: lang/json/terrain_from_json.py
msgid "disconnect switch"
msgstr "interruptor de desconexión"

#. ~ Description for disconnect switch
#: lang/json/terrain_from_json.py
msgid ""
"A switch used to make sure an electrical system doesn't have any current "
"flowing through it, for maintenance periods."
msgstr ""
"Es un interruptor que se usaba para asegurar que un sistema eléctrico no "
"tuviera ninguna corriente pasando por él, para el momento de hacer "
"mantenimiento."

#: lang/json/terrain_from_json.py
msgid "current transformer"
msgstr "transformador de corriente"

#. ~ Description for current transformer
#: lang/json/terrain_from_json.py
msgid "An electronic component used to transform the voltage of a current."
msgstr ""
"Es un componente electrónico que se usaba para transformar el voltaje de una"
" corriente eléctrica."

#: lang/json/terrain_from_json.py
msgid "potential transformer"
msgstr "transformador de potencial"

#. ~ Description for potential transformer
#: lang/json/terrain_from_json.py
msgid "A specialized type of electrical transformer, "
msgstr "Es un tipo especializado de transformador eléctrico."

#: lang/json/terrain_from_json.py
msgid "conveyor belt"
msgstr "cinta transportadora"

#. ~ Description for conveyor belt
#: lang/json/terrain_from_json.py
msgid "A conveyor belt.  Used to transport things."
msgstr "Es una cinta transportadora. Se usa para eso, transportar objetos."

#: lang/json/terrain_from_json.py
msgid "milking machine"
msgstr "máquina de ordeñe"

#. ~ Description for milking machine
#: lang/json/terrain_from_json.py
msgid "A machine used in the dairy industry to milk cows."
msgstr "Es una máquina usada en la industria láctea para ordeñar vacas."

#: lang/json/terrain_from_json.py
msgid "bulk tank"
msgstr "tanque de almacenamiento de leche"

#. ~ Description for bulk tank
#: lang/json/terrain_from_json.py
msgid "A heavy, high capacity tank."
msgstr "Es un tanque pesado de gran capacidad."

#. ~ Description for root cellar
#: lang/json/terrain_from_json.py
msgid "A cellar dug into the earth for storing food in a cool environment."
msgstr ""
"Es un sótano cavado en la tierra para almacenar comida en un ambiente "
"fresco."

#: lang/json/terrain_from_json.py
msgid "covered well"
msgstr "pozo de agua cubierto"

#. ~ Description for covered well
#: lang/json/terrain_from_json.py
msgid ""
"Deep well collecting ground water.  Requires a method to draw water from."
msgstr ""
"Es un pozo profundo usado para recolectar agua subterránea. Necesita tener "
"un modo de sacar el agua."

#: lang/json/terrain_from_json.py
msgid "improvised shelter"
msgstr "refugio improvisado"

#. ~ Description for improvised shelter
#: lang/json/terrain_from_json.py
msgid ""
"Improvised shelter providing little bit of protection, that can be used to "
"take refuge from the elements or to protect a campfire from the rain."
msgstr ""
"Es un refugio improvisado que brinda un poquito de protección, y puede ser "
"usado para refugiarse del clima o para proteger una fogata de la lluvia."

#: lang/json/terrain_from_json.py
msgid "pine lean-to"
msgstr "cobertizo de pino"

#. ~ Description for pine lean-to
#: lang/json/terrain_from_json.py
msgid ""
"A small shelter roofed with pine leaves, that can be used to take refuge "
"from the elements or to protect a campfire from the rain."
msgstr ""
"Es un pequeño refugio con techo de hojas de pino que puede ser usado para "
"refugiarse del clima o para proteger una fogata de la lluvia."

#: lang/json/terrain_from_json.py
msgid "tarp lean-to"
msgstr "cobertizo de lona"

#. ~ Description for tarp lean-to
#: lang/json/terrain_from_json.py
msgid ""
"A small shelter covered by waterproof tarp, that can be used to take refuge "
"from the elements or to protect a campfire from the rain."
msgstr ""
"Es un pequeño refugio cubierto con una lona impermeable que puede ser usado "
"para refugiarse del clima o para proteger una fogata de la lluvia."

#: lang/json/terrain_from_json.py
msgid "mechanical winch"
msgstr "malacate mecánico"

#. ~ Description for mechanical winch
#: lang/json/terrain_from_json.py
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate or door."
msgstr ""
"Es una manija que controla una puerta. Si funciona, puede usarse para abrir "
"o cerrar una verja o una puerta cercana."

#. ~ Description for mechanical winch
#. ~ Description for control lever
#: lang/json/terrain_from_json.py
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate."
msgstr ""
"Es una manija que controla una puerta. Si funciona, puede usarse para abrir "
"o cerrar una verja cercana."

#: lang/json/terrain_from_json.py
msgid "control lever"
msgstr "palanca de control"

#: lang/json/terrain_from_json.py
msgid "rope and pulley"
msgstr "soga y polea"

#. ~ Description for rope and pulley
#: lang/json/terrain_from_json.py
msgid "A system of ropes and pulleys that allows to pull up heavy doors."
msgstr "Es un sistema de sogas y poleas que te permite subir puertas pesadas."

#. ~ Description for rope and pulley
#: lang/json/terrain_from_json.py
msgid ""
"A system of ropes and pulleys that allows to pull up heavy doors or gates."
msgstr ""
"Es un sistema de sogas y poleas que te permite subir puertas o verjas "
"pesadas."

#. ~ Description for intercom
#: lang/json/terrain_from_json.py
msgid ""
"An intercom panel.  For when you want to scare the crap out of someone, or "
"just talk to them over the intercom system, if you're boring like that."
msgstr ""
"Es un panel de intercomunicaciones. Para cuando querés asustar a alguien, o "
"solamente hablar a través del sistema de intercomunicación, si sos aburrido."

#: lang/json/terrain_from_json.py
msgid "card reader"
msgstr "lector de tarjeta"

#. ~ Description for card reader
#: lang/json/terrain_from_json.py
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  An ominous red LED "
"reminds you of a robot gone haywire from an old sci-fi flick.  You could "
"swipe a scientific ID badge near it if you do not fear the machine."
msgstr ""
"Es un lector de tarjetas con circuitos integrados. Tiene el símbolos "
"estilizado de un átomo adentro de un frasco que es universalmente conocido "
"por indicar CIENCIA. Un amenazante LED rojo te recuerda a un robot que se "
"volvió loco en una vieja película de ciencia ficción. Podrías deslizar un "
"carné de científico si no le tenés miedo a la máquina."

#. ~ Description for card reader
#: lang/json/terrain_from_json.py
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  The stark red LED "
"blinks askance at your geek cred.  You could swipe a scientific ID badge "
"near it to unlock the gates to discovery."
msgstr ""
"Es un lector de tarjetas con circuitos integrados. Tiene el símbolos "
"estilizado de un átomo adentro de un frasco que es universalmente conocido "
"por indicar CIENCIA. El escueto LED rojo titila con recelo hacia tu imagen "
"ñoña. Podrías deslizar un carné de científico para destrabar las puertas al "
"descubrimiento."

#. ~ Description for card reader
#: lang/json/terrain_from_json.py
msgid ""
"This is a smartcard reader.  The universal symbol of an eagle driving a "
"tank, biting a grenade pin stands rampant in front of an American flag.  A "
"small, red LED remains constant, as if watching you, waiting.  You could "
"swipe a military ID card in front of the reader if you dared."
msgstr ""
"Es un lector de tarjetas con circuitos integrados. El símbolo universal de "
"un águila manejando un tanque, mordiendo un gancho de granada, parada "
"rampante frente a una bandera estadounidense. Un pequeño LED rojo sigue "
"constante, com si te estuviera mirando, esperando. Podrías deslizar un carné"
" de militar si te animás."

#. ~ Description for card reader
#: lang/json/terrain_from_json.py
msgid ""
"This is a smartcard reader.  The symbol of a gear in front of a bulging "
"bicep is emblazoned on the matte black surface with an illegible heavy "
"industrial company title.  A red LED blinks on the card reader.  Perhaps an "
"industrial ID card could still open it."
msgstr ""
"Es un lector de tarjetas con circuitos integrados. El símbolo de un "
"engranaje frente a un bíceps hinchado está estampado sobre una superficie "
"negro mate con el título ilegible de una empresa industrial. Un LED rojo "
"titila en el lector. Tal vez un carné de industrial aún pueda abrirla."

#. ~ Description for card reader
#: lang/json/terrain_from_json.py
msgid ""
"This looks like the console controlling the security door, there's a pretty "
"big reading surface on it.  You can see \"Fp\" soberly printed above the "
"reader.  You have no idea what could open it."
msgstr ""
"Esta parece una consola que controla la puerta de seguridad, tiene una "
"superficie de lectura de tarjeta bastante grande. Podés ver las letras "
"\"Fp\" sobriamente impresas sobre el lector. No tenés ni idea de qué puede "
"abrir."

#: lang/json/terrain_from_json.py
msgid "broken card reader"
msgstr "lector de tarjeta roto"

#. ~ Description for broken card reader
#: lang/json/terrain_from_json.py
msgid ""
"This is a smartcard reader, but it doesn't seem to be functioning.  Probably"
" because there's no more blinking red LED."
msgstr ""
"Esto es un lector de tarjetas inteligentes pero no parece estar funcionando."
" Probablemente, porque ya no tiene ningún LED rojo titilando."

#: lang/json/terrain_from_json.py
msgid "elevator controls"
msgstr "controles del ascensor"

#. ~ Description for elevator controls
#: lang/json/terrain_from_json.py
msgid ""
"This is the control face for an elevator.  You could press the appropriate "
"button to take you to your choice of floor."
msgstr ""
"Estos son los controles de un ascensor. Podés apretar el botón apropiado "
"para que te lleve al piso de elección."

#: lang/json/terrain_from_json.py
msgid "powerless controls"
msgstr "controles sin energía"

#. ~ Description for powerless controls
#: lang/json/terrain_from_json.py
msgid "This is the control face for an elevator.  It's currently unpowered."
msgstr ""
"Estos son los controles de un ascensor. Ahora no tiene alimentación "
"eléctrica."

#: lang/json/terrain_from_json.py
msgid "dark pedestal"
msgstr "pedestal oscuro"

#. ~ Description for dark pedestal
#: lang/json/terrain_from_json.py
msgid ""
"A dark stone pedestal covered in ancient, unintelligible symbols.  Looks "
"ominous."
msgstr ""
"Es un pedestal oscuro de piedra cubierto con símbolos antiguos e "
"incomprensibles. Parece siniestro."

#: lang/json/terrain_from_json.py
msgid "light pedestal"
msgstr "pedestal claro"

#. ~ Description for light pedestal
#: lang/json/terrain_from_json.py
msgid "A light stone pedestal covered in ancient, unintelligible symbols."
msgstr ""
"Es un pedestal claro de piedra cubierto con símbolos antiguos e "
"incomprensibles."

#: lang/json/terrain_from_json.py
msgid "yellow switch"
msgstr "interruptor amarillo"

#. ~ Description for yellow switch
#: lang/json/terrain_from_json.py
msgid "A yellow switch.  Should you activate it?"
msgstr "Es un interruptor amarillo. ¿Estaría bien apretarlo?"

#: lang/json/terrain_from_json.py
msgid "cyan switch"
msgstr "interruptor turquesa"

#. ~ Description for cyan switch
#: lang/json/terrain_from_json.py
msgid "A cyan switch.  Should you activate it?"
msgstr "Es un interruptor cian. ¿Estaría bien apretarlo?"

#: lang/json/terrain_from_json.py
msgid "purple switch"
msgstr "interruptor púrpura"

#. ~ Description for purple switch
#: lang/json/terrain_from_json.py
msgid "A purple switch.  Should you activate it?"
msgstr "Es un interruptor púrpura. ¿Estaría bien apretarlo?"

#: lang/json/terrain_from_json.py
msgid "checkered switch"
msgstr "interruptor cuadrillé"

#. ~ Description for checkered switch
#: lang/json/terrain_from_json.py
msgid "A checkered switch.  Should you activate it?"
msgstr "Es un interruptor cuadriculado. ¿Estaría bien apretarlo?"

#: lang/json/terrain_from_json.py
msgid "resin wall"
msgstr "pared de resina"

#. ~ Description for resin wall
#: lang/json/terrain_from_json.py
msgid ""
"This wall is made of a glistening, nearly opaque, plastic-like substance.  "
"Deep within the material making it up, you can barely see a network of "
"pulsating green conduits, snaking like blood vessels through it.  The "
"material is hard, warm to the touch, and slightly damp."
msgstr ""
"Esta pared está hecha de una sustancia similar al plástico, casi opaca pero "
"brillante. Adentro del material que la forma es apenas visible una red de "
"conductos verdes que palpitan, serpenteando como vasos sanguíneos. El "
"material es duro, tibio al tacto y un poco húmedo."

#: lang/json/terrain_from_json.py
msgid "boom!"
msgstr "¡bum!"

#: lang/json/terrain_from_json.py
msgid "resin cage"
msgstr "jaula de resina"

#. ~ Description for resin cage
#: lang/json/terrain_from_json.py
msgid ""
"This resin wall opens into a series of small honeycomb-like hexagons, "
"allowing the passage of air and light.  While still made of the same sturdy "
"material, it is thinner and more delicate in appearance."
msgstr ""
"Esta pared de resina se abre en una serie de pequeños hexágonos similares a "
"un panal, permitiendo el paso del aire y la luz. Aunque sigue siendo del "
"mismo material resistente, es más fino y más delicado en apariencia."

#: lang/json/terrain_from_json.py
msgid "resin floor"
msgstr "suelo de resina"

#. ~ Description for resin floor
#: lang/json/terrain_from_json.py
msgid ""
"This nearly opaque, plastic-like floor has a gentle curve from wall to wall,"
" but in the central areas is quite flat.  The material is hard, warm to the "
"touch, and slightly damp."
msgstr ""
"Este suelo casi opaco, similar al plástico, tiene una curva suave de pared a"
" pared pero en la zona central es bastante plano. El material es duro, tibio"
" al tacto y un poco húmedo."

#. ~ Description for resin floor
#: lang/json/terrain_from_json.py
msgid ""
"This nearly opaque, plastic-like floor is smooth and flat.  The material is "
"hard, warm to the touch, and slightly damp."
msgstr ""
"Este suelo casi opaco, similar al plástico, es liso y plano. El material es "
"duro, tibio al tacto y un poco húmedo."

#: lang/json/terrain_from_json.py
msgid "resin roof"
msgstr "techo de resina"

#. ~ Description for resin roof
#: lang/json/terrain_from_json.py
msgid ""
"A wide, domed section of nearly opaque, plastic-like material.  When the "
"light hits it, a network of multicolored conduits like blood vessels can be "
"seen snaking through its glistening interior."
msgstr ""
"Es una sección de cúpula ancha de un material casi opaco, similar al "
"plástico. Donde le da la luz, una red de conductos multicolores como vasos "
"sanguíneos pueden verse serpenteando a través de su interior brillante."

#: lang/json/terrain_from_json.py
msgid "closed resin portal"
msgstr "portal cerrado de resina"

#. ~ Description for closed resin portal
#: lang/json/terrain_from_json.py
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is closed tightly, but it looks like a firm push would cause it to snap "
"open."
msgstr ""
"Es una escotilla tricúspide de alguna clase de material húmedo, flexible y "
"resinoso. Está cerrado firmemente pero parece que un empujón podría abrirlo."

#: lang/json/terrain_from_json.py
msgid "open resin portal"
msgstr "portal abierto de resina"

#. ~ Description for open resin portal
#: lang/json/terrain_from_json.py
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is open, the flaps held out by some sort of stringy mucus-like "
"substance."
msgstr ""
"Es una escotilla tricúspide de alguna clase de material húmedo, flexible y "
"resinoso. Está abierto y sus hojas están sostenidas por una clase de "
"sustancia fibrosa y similar al moco."

#: lang/json/terrain_from_json.py
msgid "resin-lined hole"
msgstr "agujero cubierto de resina"

#. ~ Description for resin-lined hole
#: lang/json/terrain_from_json.py
msgid "An open hole in the resin wall, large enough to pass through."
msgstr ""
"Es un agujero abierto en la pared de resina, lo suficientemente grande como "
"para pasar por ahí."

#. ~ Description for gravel
#: lang/json/terrain_from_json.py
msgid ""
"A small mallet that a judge uses to call - er, wait.  Oh, gravel!  Gravel is"
" a collection of small stones often used for roads, as railroad ballast, and"
" in many other applications."
msgstr ""
"Es un conjunto de pequeñas piedritas generalmente utilizado para caminos, "
"balasto de vías, y con varios usos más."

#: lang/json/terrain_from_json.py
msgid "railroad track"
msgstr "vía"

#. ~ Description for railroad track
#: lang/json/terrain_from_json.py
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm."
msgstr ""
"Antes los trenes andaban sobre esto. Estas vías quedaron estoicamente "
"inútiles frente al Cataclismo."

#: lang/json/terrain_from_json.py
msgid "railroad tie"
msgstr "durmiente"

#. ~ Description for railroad tie
#: lang/json/terrain_from_json.py
msgid "This crosstie is used to support the rails."
msgstr "Este durmiente se utiliza para sostener las vías."

#. ~ Description for railroad track
#: lang/json/terrain_from_json.py
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm.  A crosstie sits underneath, supporting the rails."
msgstr ""
"Antes los trenes andaban sobre esto. Estas vías quedaron estoicamente "
"inútiles frente al Cataclismo. Tiene un durmiente debajo, sosteniendo las "
"vías."

#: lang/json/terrain_from_json.py
msgid "buffer stop"
msgstr "topera"

#. ~ Description for buffer stop
#: lang/json/terrain_from_json.py
msgid ""
"A tiny blockade on the train tracks, meant to signify the end of a track, or"
" mark a 'no-go' zone for trains."
msgstr ""
"Es un pequeño bloque en las vías que están para demostrar el fin de la "
"misma, o para marcar zonas donde no deben entrar los trenes."

#: lang/json/terrain_from_json.py
msgid "railroad crossing signal"
msgstr "cartel de cruce ferroviario"

#. ~ Description for railroad crossing signal
#: lang/json/terrain_from_json.py
msgid ""
"Traffic lights meant to light and make noise when a train approaches, to "
"prevent people from turning into meaty mush while they cross the tracks.  "
"Won't stop people from turning into meaty mush by other means, though."
msgstr ""
"Las luces están para encenderse y hacer ruido cada vez que se acerca un "
"tren, para prevenir que la gente se convierta en carne picada cuando "
"intentan cruzar las vías. Pero no va a evitar que la gente se convierta en "
"carne picada por otros medios."

#: lang/json/terrain_from_json.py
msgid "clang."
msgstr "clang."

#: lang/json/terrain_from_json.py
msgid "crossbuck"
msgstr "paso a nivel"

#. ~ Description for crossbuck
#: lang/json/terrain_from_json.py
msgid ""
"A traffic sign intended to indicate a level railway crossing.  If the trains"
" were still running."
msgstr ""
"Es un cartel con la intención de indicar un paso de las vías a nivel. Si es "
"que los trenes siguen andando."

#. ~ Description for small railroad track
#: lang/json/terrain_from_json.py
msgid ""
"Like a railroad track, only smaller.  You could probably run a small vehicle"
" on this."
msgstr ""
"Es como una vía de tren pero más pequeña. Probablemente, puedas hacer andar "
"un pequeño vehículo en esto."

#: lang/json/terrain_from_json.py
msgid "sandbox"
msgstr "arenero"

#. ~ Description for sandbox
#: lang/json/terrain_from_json.py
msgid ""
"Children used to play in this sandbox.  The population of lice probably "
"diminished considerably now that they no longer do."
msgstr ""
"Los chicos antes jugaban en este arenero. La población de piojos "
"probablemente haya disminuido considerablemente ahora que ya no van ahí a "
"jugar."

#: lang/json/terrain_from_json.py
msgid "slide"
msgstr "tobogán"

#. ~ Description for slide
#: lang/json/terrain_from_json.py
msgid "A children's slide.  Too small to slide on comfortably anymore."
msgstr ""
"Es un tobogán infantil. Demasiado pequeño para deslizarse cómodamente."

#: lang/json/terrain_from_json.py
msgid "monkey bars"
msgstr "pasamanos"

#. ~ Description for monkey bars
#: lang/json/terrain_from_json.py
msgid ""
"A set of monkey bars, to be used by children to train their arms by hanging "
"from the bars, and have fun."
msgstr ""
"Es un pasamanos para que lo usen los pibes para entrenar sus brazos "
"colgándose de las barras y divertirse."

#: lang/json/terrain_from_json.py
msgid "backboard"
msgstr "tablero"

#. ~ Description for backboard
#: lang/json/terrain_from_json.py
msgid "A basketball backboard."
msgstr "Es un tablero de básquet."

#. ~ Description for backboard
#: lang/json/terrain_from_json.py
msgid "A metal backboard."
msgstr "Es un tablero de metal."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: lang/json/terrain_from_json.py
msgid "this should never actually show up, it's a pseudo terrain"
msgstr "esto no debería aparecer nunca, es un pseudo terreno"

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: lang/json/terrain_from_json.py
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"people have trampled away grass, or otherwise cleared plant life."
msgstr ""
"esto no debería aparecer nunca, es un pseudo terreno. Para usar donde la "
"gente pisoteó el pasto o limpió toda vida vegetal."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: lang/json/terrain_from_json.py
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"clean, curated grass is the only expected terrain - modified by whatever the"
" biome equivalent is"
msgstr ""
"esto no debería aparecer nunca, es un pseudo terreno. Para usar donde el "
"único terreno que se espera es pasto prolijo - modificado por el bioma "
"equivalente"

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: lang/json/terrain_from_json.py
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"plants have been planted and grass/groundcover kept clear"
msgstr ""
"esto no debería aparecer nunca, es un pseudo terreno. Para usar donde las "
"plantas han sido plantadas y el pasto no se acerca"

#: lang/json/terrain_from_json.py
msgid "rain gutter"
msgstr "canaleta"

#. ~ Description for rain gutter
#: lang/json/terrain_from_json.py
msgid "Channels water from the roof towards the ground, it looks flimsy."
msgstr ""
"Son canales que llevan el agua del techo hasta el suelo, parece endeble."

#: lang/json/terrain_from_json.py
msgid "gutter drop"
msgstr "desagüe de canaleta"

#. ~ Description for gutter drop
#: lang/json/terrain_from_json.py
msgid ""
"Funnels water from gutter system towards the ground, it looks flimsy.  You "
"may be able to climb down here."
msgstr ""
"Es el embudo del sistema de canaletas que hace bajar al agua hasta el suelo,"
" parece endeble. Tal vez puedas bajar del techo por acá."

#: lang/json/terrain_from_json.py
msgid "downspout"
msgstr "bajada desagüe"

#. ~ Description for downspout
#: lang/json/terrain_from_json.py
msgid ""
"A length of gutter running from the roof to the ground, you could place a "
"container underneath it to collect rainwater.  It looks flimsy.  You may be "
"able to climb down here."
msgstr ""
"Es un pedazo de canaleta que va desde el techo hasta el suelo, podrías poner"
" un recipiente debajo para recolectar el agua de lluvia. Parece endeble. Tal"
" vez puedas bajar del techo por acá."

#: lang/json/terrain_from_json.py
msgid "flat roof"
msgstr "techo plano"

#. ~ Description for flat roof
#: lang/json/terrain_from_json.py
msgid "A flat, gray section of rooftop."
msgstr "Es una sección plana de techo gris."

#: lang/json/terrain_from_json.py
msgid "tar paper flat roof"
msgstr "techo con membrana asfáltica"

#. ~ Description for tar paper flat roof
#: lang/json/terrain_from_json.py
msgid "A flat, gray section of rooftop covered with tar paper."
msgstr "Es una sección plana de techo gris cubierta con membrana asfáltica."

#: lang/json/terrain_from_json.py
msgid "shingle flat roof"
msgstr "techo plano con tejas asfálticas"

#. ~ Description for shingle flat roof
#: lang/json/terrain_from_json.py
msgid "A flat section of rooftop covered in shingles."
msgstr "Es una sección plana de techo cubierta con tejas asfálticas."

#: lang/json/terrain_from_json.py
msgid "thatched roof"
msgstr "techo de paja"

#. ~ Description for thatched roof
#: lang/json/terrain_from_json.py
msgid "A section of roof made out of straw."
msgstr "Es una sección de techo hecho con paja."

#: lang/json/terrain_from_json.py
msgid "metal flat roof"
msgstr "techo plano de chapa"

#. ~ Description for metal flat roof
#: lang/json/terrain_from_json.py
msgid "A section of flat, sheet metal rooftop."
msgstr "Es una sección de techo plano de chapa."

#: lang/json/terrain_from_json.py
msgid "tile flat roof"
msgstr "techo plano con tejas"

#. ~ Description for tile flat roof
#: lang/json/terrain_from_json.py
msgid "A section of tiled, flat rooftop."
msgstr "Es una sección de techo plano con tejas."

#: lang/json/terrain_from_json.py
msgid "skylight"
msgstr "claraboya"

#. ~ Description for skylight
#: lang/json/terrain_from_json.py
msgid ""
"A giant sheet of glass inserted into the roof, lets light pass through."
msgstr ""
"Es una lámina gigante de vidrio insertada en el techo, que deja pasar la "
"luz."

#: lang/json/terrain_from_json.py
msgid "rock roof"
msgstr "techo de piedra"

#. ~ Description for rock roof
#: lang/json/terrain_from_json.py
msgid "A section of flat natural rock."
msgstr "Es una sección de techo natural de piedra."

#. ~ Description for flat roof
#: lang/json/terrain_from_json.py
msgid "A flat surface made of pulpy mass, covered in sticky wasp saliva."
msgstr ""
"Es una superficie plana hecha con una masa pulposa, cubierta con saliva "
"pegajosa de avispa."

#. ~ Description for flat roof
#: lang/json/terrain_from_json.py
msgid ""
"A flat surface made of hardened pulpy mass, covered in sticky wasp saliva."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "empty space"
msgstr "espacio vacío"

#. ~ Description for empty space
#: lang/json/terrain_from_json.py
msgid "This is empty space."
msgstr "Acá hay un espacio vacío."

#: lang/json/terrain_from_json.py
msgid "shallow pit"
msgstr "pozo poco profundo"

#. ~ Description for shallow pit
#: lang/json/terrain_from_json.py
msgid ""
"A pit that could be dug even deeper or filled up.  Also useful as a starting"
" foundation for some constructions."
msgstr ""
"Es un pozo que podría hacerse más hondo o rellenarse. También es útil como "
"para hacer cimientos de alguna construcción."

#: lang/json/terrain_from_json.py lang/json/trap_from_json.py
msgid "pit"
msgstr "pozo"

#. ~ Description for pit
#: lang/json/terrain_from_json.py
msgid ""
"A steep hole that could seriously injure something if it fell in, "
"potentially fatal if it was filled with sharp and dangerous things.  Deep "
"enough for more advanced construction projects, and possibly to reach "
"groundwater if constructed properly."
msgstr ""
"Es un pozo profundo que podría ser peligroso, potencialmente fatal si se le "
"pone alguna cosa filosa en el fondo. Lo suficientemente profundo como para "
"alguna construcción importante, y posiblemente como para llegar a aguas "
"subterráneas si se lo construye correctamente."

#: lang/json/terrain_from_json.py
msgid "corpse filled pit"
msgstr "pozo lleno de cadáveres"

#. ~ Description for corpse filled pit
#: lang/json/terrain_from_json.py
msgid ""
"A giant trench full of corpses, maybe even a mass graveyard.  The bodies "
"could be dug out but none of it looks remotely usable."
msgstr ""
"Es una zanja gigante llena de cadáveres, tal vez alguna especie de "
"cementerio. Los cuerpos podrían ser sacados, pero ninguno parece ni "
"remotamente útil para algo."

#: lang/json/terrain_from_json.py
msgid "covered pit"
msgstr "pozo cubierto"

#. ~ Description for covered pit
#: lang/json/terrain_from_json.py
msgid ""
"A deep pit with a plank placed across it, looks sturdy enough to cross "
"safely or the plank could be removed to turn it back into trap fall."
msgstr ""

#: lang/json/terrain_from_json.py lang/json/trap_from_json.py
msgid "spiked pit"
msgstr "pozo con púas"

#. ~ Description for spiked pit
#: lang/json/terrain_from_json.py
msgid ""
"A narrow trench full of very pointy things that would easily puncture a "
"body."
msgstr ""
"Es una zanja angosta llena de cosas muy puntiagudas que fácilmente podrían "
"herir el cuerpo."

#: lang/json/terrain_from_json.py
msgid "covered spiked pit"
msgstr "pozo con púas cubierto"

#. ~ Description for covered spiked pit
#: lang/json/terrain_from_json.py
msgid ""
"Menacing with sharp spears along the bottom, this pit has a plank across it "
"to allow someone or something to cross safely.  The plank could be removed "
"to revert it back into a trap."
msgstr ""

#: lang/json/terrain_from_json.py lang/json/trap_from_json.py
msgid "glass pit"
msgstr "pozo con vidrios"

#. ~ Description for glass pit
#: lang/json/terrain_from_json.py
msgid ""
"Looks like a ton of broken glass was dumped into this pit, maybe not fatal "
"to fall in but wouldn't be pleasant to try to crawl out."
msgstr ""
"Parece que tiraron un montón de vidrios rotos en este pozo, tal vez no sea "
"fatal caer en él, pero estaría bueno tener que salir de ahí."

#: lang/json/terrain_from_json.py
msgid "covered glass pit"
msgstr "pozo con vidrios cubierto"

#. ~ Description for covered glass pit
#: lang/json/terrain_from_json.py
msgid ""
"A plank has been placed carefully to allow traversal over this ditch full of"
" large glass shards.  The wooden board could be removed so it couldn't be "
"safely crossed."
msgstr ""

#. ~ Description for slime
#: lang/json/terrain_from_json.py
msgid ""
"A disgusting and slippery mess that could be used to stash things because "
"who'd want to touch it?"
msgstr ""
"Es un desagradable y resbaloso revoltijo que puede usarse para guardar cosas"
" porque... ¿quién va a querer meter la mano ahí?"

#: lang/json/terrain_from_json.py
msgid "solid bark wall"
msgstr ""

#. ~ Description for solid bark wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid wall of bark, enclosing the trunk of a massive tree.  It will "
"probably burn quite well."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "chipped bark wall"
msgstr ""

#. ~ Description for chipped bark wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid wall of bark enclosing the trunk of a massive tree.  Some of it has "
"been broken away."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "broken bark wall"
msgstr ""

#. ~ Description for broken bark wall
#: lang/json/terrain_from_json.py
msgid ""
"A formerly solid wall of bark, now almost completely destroyed and waiting "
"to collapse."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "solid wood wall"
msgstr ""

#. ~ Description for solid wood wall
#: lang/json/terrain_from_json.py
msgid "A solid wall of naturally grown wood.  Likely very flammable."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "bark"
msgstr ""

#. ~ Description for bark
#: lang/json/terrain_from_json.py
msgid "A solid piece of bark covers the floor here."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "branches with leaves"
msgstr ""

#. ~ Description for branches with leaves
#: lang/json/terrain_from_json.py
msgid "Thin branches emerge here, covered with thick, large leaves."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "root floor"
msgstr ""

#. ~ Description for root floor
#: lang/json/terrain_from_json.py
msgid "A dirt floor covered with roots."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "downward root slope"
msgstr ""

#. ~ Description for downward root slope
#: lang/json/terrain_from_json.py
msgid "A downward-facing slope of root-covered dirt."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "upward root slope"
msgstr ""

#. ~ Description for upward root slope
#: lang/json/terrain_from_json.py
msgid "An upward-facing slope of root-covered dirt."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "closed bramble roots"
msgstr ""

#. ~ Description for closed bramble roots
#: lang/json/terrain_from_json.py
msgid ""
"A bramble of roots are here, covering a hole.  They could easily be pulled "
"apart."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "open bramble roots"
msgstr ""

#. ~ Description for open bramble roots
#: lang/json/terrain_from_json.py
msgid "A bramble of roots are here, they are pulled apart revealing a hole."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "wall"
msgstr "pared"

#. ~ Description for wall
#: lang/json/terrain_from_json.py
msgid ""
"The stereotypical wall with wooden support structure filled with insulation "
"and drywalled.  Paint job is the all too common and neutral off-white or "
"cream color, it could use more vibrant paint.  Appears as though the "
"material is still flammable."
msgstr ""
"Es la típica pared con estructura de madera con relleno aislante y durlock. "
"La pintura es comunacha y de un blanco neutro o cremita, le vendría bien un "
"color más vibrante. Parece que el material es inflamable."

#: lang/json/terrain_from_json.py
msgid "half-built wall"
msgstr "pared a medio construir"

#. ~ Description for half-built wall
#: lang/json/terrain_from_json.py
msgid ""
"An incomplete wall of refined wood, dotted with carefully placed nails to "
"provide proper support.  It requires some more planks and nails before it'd "
"be considered a suitable wall."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "pony wall"
msgstr "pared petisa"

#. ~ Description for pony wall
#: lang/json/terrain_from_json.py
msgid ""
"A short divider wall with wooden support structure with drywall.  Paint job "
"is the all too common and neutral off-white or cream color.  Appears as "
"though the material is flammable."
msgstr ""
"Es una pared corta divisoria con estructura de madera y durlock. La pintura "
"es comunacha de un blanco neutro o cremita. Parece que el material es "
"inflamable."

#: lang/json/terrain_from_json.py
msgid "red wall"
msgstr "pared roja"

#. ~ Description for red wall
#: lang/json/terrain_from_json.py
msgid "Wall painted red."
msgstr "Es una pared pintada de rojo."

#: lang/json/terrain_from_json.py
msgid "white wall"
msgstr "pared blanca"

#. ~ Description for white wall
#: lang/json/terrain_from_json.py
msgid "Wall painted white."
msgstr "Es una pared pintada de blanco."

#: lang/json/terrain_from_json.py
msgid "blue wall"
msgstr "pared azul"

#. ~ Description for blue wall
#: lang/json/terrain_from_json.py
msgid "Wall painted blue."
msgstr "Es una pared pintada de azul."

#: lang/json/terrain_from_json.py
msgid "green wall"
msgstr "pared verde"

#. ~ Description for green wall
#: lang/json/terrain_from_json.py
msgid "Wall painted green."
msgstr "Es una pared pintada de verde."

#: lang/json/terrain_from_json.py
msgid "yellow wall"
msgstr "pared amarilla"

#. ~ Description for yellow wall
#: lang/json/terrain_from_json.py
msgid "Wall painted yellow."
msgstr "Es una pared pintada de amarillo."

#: lang/json/terrain_from_json.py
msgid "pink wall"
msgstr "pared rosa"

#. ~ Description for pink wall
#: lang/json/terrain_from_json.py
msgid "Wall painted pink."
msgstr "Es una pared pintada de rosa."

#: lang/json/terrain_from_json.py
msgid "purple wall"
msgstr "pared púrpura"

#. ~ Description for purple wall
#: lang/json/terrain_from_json.py
msgid "Wall painted purple."
msgstr "Es una pared pintada de púrpura."

#: lang/json/terrain_from_json.py
msgid "half-built brick wall"
msgstr "pared de ladrillos a medio construir"

#. ~ Description for half-built brick wall
#: lang/json/terrain_from_json.py
msgid ""
"Half of a brick wall, looks like it still requires some more resources and "
"effort before being considered a real wall."
msgstr ""
"Es la mitad de una pared de ladrillos, todavía le faltan materiales y "
"esfuerzo para poder ser considerada una pared de en serio."

#: lang/json/terrain_from_json.py
msgid "bash!"
msgstr "¡bash!"

#: lang/json/terrain_from_json.py
msgid "brick wall"
msgstr "pared de ladrillos"

#. ~ Description for brick wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and "
"keep out any unwanted visitors."
msgstr ""
"Es una sólida pared de ladrillos, lo suficientemente resistente como para "
"aguantar un techo con más paredes y mantener afuera a los visitantes "
"indeseados."

#: lang/json/terrain_from_json.py
msgid "stone wall"
msgstr "pared de piedra"

#. ~ Description for stone wall
#: lang/json/terrain_from_json.py
msgid "A sturdy stone wall."
msgstr "Es una robusta pared de piedra."

#: lang/json/terrain_from_json.py
msgid "half-built stone wall"
msgstr "pared de piedra a medio construir"

#. ~ Description for half-built stone wall
#: lang/json/terrain_from_json.py
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before this "
"stone wall is complete."
msgstr ""
"Es la robusta mitad de una pared de piedra. Necesita algún trabajo más para "
"que esta pared esté completa."

#: lang/json/terrain_from_json.py
msgid "smoothed rock"
msgstr "roca suavizada"

#. ~ Description for smoothed rock
#: lang/json/terrain_from_json.py
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble"
" for funerary chapels and mausoleums."
msgstr ""
"Es un bloque de piedra que ha sido alisada, usualmente de granito o mármol "
"para usar en capillas y mausoleos."

#: lang/json/terrain_from_json.py
msgid "half-built adobe wall"
msgstr "pared de adobe a medio construir"

#. ~ Description for half-built adobe wall
#: lang/json/terrain_from_json.py
msgid ""
"Half of an adobe brick wall, looks like it still requires some more "
"resources and effort before being considered a real wall."
msgstr ""
"Es la mitad de una pared de adobe, todavía le faltan materiales y esfuerzo "
"para poder ser considerada una pared de en serio."

#: lang/json/terrain_from_json.py
msgid "adobe wall"
msgstr "pared de adobe"

#. ~ Description for adobe wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid adobe brick wall, sturdy enough to support a roof with enough walls "
"and keep out any unwanted visitors."
msgstr ""
"Es una sólida pared de ladrillos de adobe, lo suficientemente resistente "
"como para aguantar un techo con más paredes y mantener afuera a los "
"visitantes indeseados."

#. ~ Description for concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"An aesthetically pleasing design with simple lines, this type of concrete "
"was used with a weaker chemical mixture in order to have faster setting "
"times.  Not ideal for multi-story buildings, but still capable of supporting"
" a roof."
msgstr ""
"Con un diseño estéticamente agradable de líneas simples, esta clase de "
"concreto era usado con una mezcla química más débil para hacer más rápida el"
" proceso de armado. No es ideal para edificios de varios pisos, pero es "
"capaz de soportar un techo."

#. ~ Description for bulkhead
#: lang/json/terrain_from_json.py
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr ""
"Es una lámina gruesa fabricada de manera industrial y cuidadosamente "
"ubicada, esta pared es capaz de resistir los elementos naturales más "
"extremos y las fuerzas hostiles."

#: lang/json/terrain_from_json.py
msgid "simple concrete wall"
msgstr "pared de concreto común"

#. ~ Description for simple concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"A durable and uniform concrete wall, quite drab without decoration.  More "
"than capable of supporting a roof, as well as keeping out most anything, "
"save for vehicles."
msgstr ""
"Es una pared uniforme y resistente de concreto, bastante aburrida así sin "
"decoraciones. Más que capaz de soportar un techo y evitar el ingreso de casi"
" cualquier cosa, excepto los vehículos, claro."

#: lang/json/terrain_from_json.py
msgid "half-built simple concrete wall"
msgstr "pared de concreto común a medio construir"

#. ~ Description for half-built simple concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"A partially poured concrete wall that could probably keep anything behind it"
" quite safe if it were finished."
msgstr ""
"Es una pared de concreto parcialmente construida que probablemente "
"mantendría alejado a cualquier cosa si estuviera entera."

#: lang/json/terrain_from_json.py
msgid "reinforced concrete wall"
msgstr "pared de concreto reforzado"

#. ~ Description for reinforced concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"An extremely resilient wall, filled with concrete and rebar.  Best suited "
"for supporting multi-level buildings, only serious explosives and high-speed"
" impacts would be capable of damaging this wall."
msgstr ""
"Es una pared extremadamente resistente, con concreto y varillas corrugadas. "
"Es la mejor opción para soportar construcciones de varios niveles, solamente"
" los explosivos serios y los impactos de alta velocidad pueden dañar esta "
"pared."

#: lang/json/terrain_from_json.py
msgid "scrrrash!"
msgstr "¡scrrrash!"

#: lang/json/terrain_from_json.py
msgid "half-built reinforced concrete wall"
msgstr "pared de concreto reforzado a medio construir"

#. ~ Description for half-built reinforced concrete wall
#: lang/json/terrain_from_json.py
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It appears to need more "
"resources before being considered complete."
msgstr ""
"Es una pared de concreto con varillas corrugadas ubicadas metódicamente y "
"que están sobresaliendo, que no es lo más práctico para soportar un techo o "
"hacer un refugio. Parece que necesita más materiales antes de considerarse "
"completa."

#: lang/json/terrain_from_json.py
msgid "rebar cage"
msgstr "jaula de acero corrugado"

#. ~ Description for rebar cage
#: lang/json/terrain_from_json.py
msgid ""
"A structural support system made of rebar that appears to be the early "
"stages of a reinforced concrete wall, just missing the poured concrete."
msgstr ""
"Es un sistema de estructura de soporte hecho con varillas corrugadas que "
"parece ser la primera etapa de una pared de concreto reforzada, solo falta "
"que le metan el concreto."

#: lang/json/terrain_from_json.py
msgid "simple metal wall"
msgstr "pared simple de metal"

#. ~ Description for simple metal wall
#: lang/json/terrain_from_json.py
msgid ""
"A relatively simple wall made of scraped together metal.  It's still capable"
" of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
"Es, relativamente, una simple pared hecha de rejuntes de metal. Todavía es "
"capaz de impedir el ingreso a los intrusos y de soportar un techo con otras "
"paredes adyacentes."

#: lang/json/terrain_from_json.py
msgid "half-built simple metal wall"
msgstr "pared simple de metal a medio construir"

#. ~ Description for half-built simple metal wall
#: lang/json/terrain_from_json.py
msgid ""
"A partially built makeshift wall of metal that could potentially support a "
"roof if it were completed."
msgstr ""
"Es una pared improvisada de metal a medio construir, que podría soportar un "
"techo si estuviera terminada."

#: lang/json/terrain_from_json.py
msgid "wooden wall"
msgstr "pared de madera"

#. ~ Description for wooden wall
#: lang/json/terrain_from_json.py
msgid ""
"A finished wall of planks and support beams, capable of supporting an upper "
"level or roof.  Still highly flammable."
msgstr ""
"Es una pared terminada de tablas de madera y vigas de apoyo, capaz de "
"soportar un piso más o un techo. Igual, es muy inflamable."

#: lang/json/terrain_from_json.py
msgid "chipped wood wall"
msgstr "pared quebrada de madera"

#. ~ Description for chipped wood wall
#: lang/json/terrain_from_json.py
msgid ""
"A wall of aligned planks that's starting to crack and break open.  Some cut "
"wood and a number of nails could patch this up quick."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "broken wood wall"
msgstr "pared rota de madera"

#. ~ Description for broken wood wall
#: lang/json/terrain_from_json.py
msgid ""
"A number of planks are missing and the structure is beginning to sag and "
"fall apart.  It's going to need quite a bit of work to repair this wall."
msgstr ""
"Le faltan algunas tablas de madera y la estructura empieza a caerse. Va a "
"ser necesario bastante trabajo para reparar esta pared."

#: lang/json/terrain_from_json.py
msgid "half-built log wall"
msgstr "pared de troncos a medio construir"

#. ~ Description for half-built log wall
#: lang/json/terrain_from_json.py
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability."
"  Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"Es una pared a medio construir hecha de troncos dentados que se "
"interconectan para crear estabilidad. Necesita algunos troncos más para "
"poder soportar un techo. Parece inflamable."

#: lang/json/terrain_from_json.py
msgid "log wall"
msgstr "pared de troncos"

#. ~ Description for log wall
#: lang/json/terrain_from_json.py
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather."
"  Quite flammable."
msgstr ""
"Es una pared alta de madera, ideal para una casa y para aislarte del clima. "
"Bastante inflamable, eso sí."

#: lang/json/terrain_from_json.py
msgid "chipped log wall"
msgstr "pared quebrada de troncos"

#. ~ Description for chipped log wall
#: lang/json/terrain_from_json.py
msgid ""
"A moderately damaged wall, could probably be patched up with some planks and"
" nails."
msgstr ""
"Es una pared un tanto dañada, que podría repararse con algunas tablas y "
"clavos."

#: lang/json/terrain_from_json.py
msgid "broken log wall"
msgstr "pared rota de troncos"

#. ~ Description for broken log wall
#: lang/json/terrain_from_json.py
msgid ""
"A destroyed wood wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr ""
"Es un pared destrozada de madera a la que le queda un solo tronco como "
"soporto, lista para derrumbarse. Se podría reparar con algunas tablas y "
"clavos."

#: lang/json/terrain_from_json.py
msgid "palisade wall"
msgstr "empalizada"

#. ~ Description for palisade wall
#: lang/json/terrain_from_json.py
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr ""
"Es una antigua fortificación de alguna clase que consiste en madera "
"estaqueada al suelo y atadas juntas."

#: lang/json/terrain_from_json.py
msgid "wattle-and-daub wall"
msgstr "pared de bareque"

#. ~ Description for wattle-and-daub wall
#: lang/json/terrain_from_json.py
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung and "
"straw."
msgstr ""
"Es una pared relativamente primitiva hecha untando un enrejado de tiras de "
"madera, usando una combinación de tierra húmeda, arcilla, arena, bosta "
"animal y paja."

#: lang/json/terrain_from_json.py
msgid "broken wattle-and-daub wall"
msgstr "pared de bareque rota"

#. ~ Description for broken wattle-and-daub wall
#: lang/json/terrain_from_json.py
msgid ""
"This wattle-and-daub wall section has been destroyed, leaving mostly just "
"frame, and is barely held together."
msgstr ""
"Esta parte de pared de bareque ha sido destruida, quedando solamente la "
"armazón y apenas si se sostiene unida."

#: lang/json/terrain_from_json.py
msgid "half-built wattle-and-daub wall"
msgstr "pared de bareque a medio construir"

#. ~ Description for half-built wattle-and-daub wall
#: lang/json/terrain_from_json.py
msgid ""
"This wattle-and-daub wall has some of the wooden strip lattice in place, and"
" still requires the rest of the lattice and supporting wet compound to be "
"filled in."
msgstr ""
"Esta pared de bareque tiene parte de su entramado de madera en su lugar, "
"pero todavía necesita que sea rellenado el resto del entramado y los "
"soportes."

#: lang/json/terrain_from_json.py
msgid "junk metal wall"
msgstr "pared de chatarra"

#. ~ Description for junk metal wall
#: lang/json/terrain_from_json.py
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"Es una pared de chatarra oxidada, abulonada y atada con alambres armando una"
" estructura resistente. Muy elegante para una villa post-apocalítica. Puede "
"sostener un techo."

#: lang/json/terrain_from_json.py
msgid "rammed earth wall"
msgstr "pared de tierra compacta"

#. ~ Description for rammed earth wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough"
" walls and keep out some unwanted visitors."
msgstr ""
"Es una sólida pared de tierra compacta, lo suficientemente resistente como "
"para aguantar un techo con más paredes y mantener afuera a algunos "
"visitantes indeseados."

#: lang/json/terrain_from_json.py
msgid "heavy rumbling!"
msgstr "¡gran estruendo!"

#: lang/json/terrain_from_json.py
msgid "smooth dirt wall"
msgstr "pared lisa de tierra"

#. ~ Description for smooth dirt wall
#: lang/json/terrain_from_json.py
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr ""
"Es una pared sólida de tierra compacta, mezclada con… algo que la mantiene "
"estable. Su superficie brilla suavemente y tiene olor a leche podrida."

#: lang/json/terrain_from_json.py
msgid "junk metal barrier"
msgstr "barrera de chatarra"

#. ~ Description for junk metal barrier
#: lang/json/terrain_from_json.py
msgid ""
"A simple wall of rusty scrap metal bolted and wire-tied to a makeshift "
"frame.  Very fashionable in post-apocalyptic shantytowns.  This one isn't "
"quite strong enough to support a roof, but could be reinforced."
msgstr ""
"Es una simple pared de chatarra metálica atornillada y atada con alambre a "
"una estructura improvisada. Muy elegante para los pueblos post-"
"apocalípticos. Esta no es tan fuerte como para sostener un techo, pero puede"
" ser reforzada."

#: lang/json/terrain_from_json.py
msgid "glass wall"
msgstr "pared de vidrio"

#. ~ Description for glass wall
#: lang/json/terrain_from_json.py
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger if"
" the glass is tampered."
msgstr ""
"Es una barrera hecha de vidrio, nada complicado, y parece extremadamente "
"frágil. Algunas tienen sensores de rotura o de ventana que se encienden si "
"el vidrio es violentado."

#: lang/json/terrain_from_json.py
msgid "laminated glass"
msgstr "vidrio laminado"

#. ~ Description for laminated glass
#: lang/json/terrain_from_json.py
msgid ""
"Laminated glass is composed layers of glass and plastic held together by an "
"interlayer."
msgstr ""
"Es un vidrio laminado compuesto de capas de vidrio y plástico unidas por un "
"interlaminado."

#: lang/json/terrain_from_json.py
msgid "ballistic glass"
msgstr "vidrio balístico"

#: lang/json/terrain_from_json.py
msgid "reinforced glass"
msgstr "vidrio reforzado"

#. ~ Description for reinforced glass
#: lang/json/terrain_from_json.py
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  Still weaker than other types of "
"walls, and not made to support a roof either."
msgstr ""
"Es un panel grueso de vidrio con delgados cables metálicos entretejidos, lo "
"que hacen la estructura más fuerte. Igual es más débil que otro tipo de "
"pared, y no puede soportar un techo."

#: lang/json/terrain_from_json.py
msgid "reinforced glass with closed shutters"
msgstr "vidrio reforzado con persiana cerrada"

#. ~ Description for reinforced glass with closed shutters
#: lang/json/terrain_from_json.py
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"Tiene una segunda capa de protección sobre el vidrio reforzado, estas "
"cortinas metálicas son comúnmente usadas para encerrar criminales o proteger"
" contra el daño de climas extremos. Parece que solo pueden abrirse desde "
"adentro. Aún con sus cortinas instaladas, no es posible que soporte un "
"techo."

#: lang/json/terrain_from_json.py
msgid "reinforced glass with open shutters"
msgstr "vidrio reforzado con persiana abierta"

#. ~ Description for reinforced glass with open shutters
#: lang/json/terrain_from_json.py
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr ""
"Tiene unas cortinas de metal colgando que no han sido desplegadas, dejando "
"expuesto el vidrio reforzado. Parece que esas cortinas solo pueden ser "
"activadas desde el interior."

#: lang/json/terrain_from_json.py
msgid "metal bars"
msgstr "barras de metal"

#. ~ Description for metal bars
#: lang/json/terrain_from_json.py
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"Son barras gruesas y pesadas que van del suelo hasta el techo, conectadas de"
" pared a pared. No está hecho para soportar un techo, pero es muy útil para "
"cortar el paso."

#: lang/json/terrain_from_json.py
msgid "paper wall"
msgstr "pared de papel"

#. ~ Description for paper wall
#: lang/json/terrain_from_json.py
msgid ""
"A huge wall of pulpy mass, covered in sticky wasp saliva.  You could smash "
"it down effortlessly."
msgstr ""
"Es un enorme pared de una masa pulposa, cubierta con saliva pegajosa de "
"avispa. Podrías destrozarla sin ningún esfuerzo."

#: lang/json/terrain_from_json.py
msgid "layered paper wall"
msgstr ""

#. ~ Description for layered paper wall
#: lang/json/terrain_from_json.py
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the"
" elements.  You could break through this, but it won't be easy."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "root wall"
msgstr "pared de raíces"

#. ~ Description for root wall
#: lang/json/terrain_from_json.py
msgid "A dirt wall covered with roots."
msgstr "Es una pared de tierra cubierta con raíces."

#: lang/json/terrain_from_json.py
msgid "wax wall"
msgstr "pared de cera"

#. ~ Description for wax wall
#: lang/json/terrain_from_json.py
msgid "A wall made entirely out of wax."
msgstr "Es una pared completamente hecha de cera."

#. ~ Description for solid earth
#: lang/json/terrain_from_json.py
msgid "A wall of solid earth."
msgstr ""

#. ~ Description for solid rock
#: lang/json/terrain_from_json.py
msgid ""
"It's solid rock, could be full of all kinds of interesting things.  Best "
"grab your pickaxe or equivalent digging implement, and strike the earth!"
msgstr ""
"Es roca sólida, podría estar llena de muchas cosas interesantes. Mejor que "
"agarres tu pico o algo parecido para cavar, y ¡golpees la tierra!"

#: lang/json/terrain_from_json.py
msgid "red stone"
msgstr "piedra roja"

#. ~ Description for red stone
#: lang/json/terrain_from_json.py
msgid "A red stone."
msgstr "Es una piedra roja."

#: lang/json/terrain_from_json.py
msgid "green stone"
msgstr "piedra verde"

#. ~ Description for green stone
#: lang/json/terrain_from_json.py
msgid "A green stone."
msgstr "Es una piedra verde."

#: lang/json/terrain_from_json.py
msgid "blue stone"
msgstr "piedra azul"

#. ~ Description for blue stone
#: lang/json/terrain_from_json.py
msgid "A blue stone."
msgstr "Es una piedra azul."

#: lang/json/terrain_from_json.py
msgid "little column"
msgstr "columna chica"

#. ~ Description for little column
#: lang/json/terrain_from_json.py
msgid "A small support column."
msgstr "Es una pequeña columna de soporte."

#: lang/json/terrain_from_json.py
msgid "half-built column"
msgstr "columna a medio construir"

#. ~ Description for half-built column
#: lang/json/terrain_from_json.py
msgid ""
"An empty wooden frame in the shape of a column, built around a concrete and "
"rebar foundation.  It isn't capable of supporting roofs or shelter, and "
"appears to need more resources before being considered complete."
msgstr ""
"Es una estructura de madera vacía con forma de columna, construida alrededor"
" de cimientos de concreto y varillas corrugadas. No es capaz de soportar un "
"techo o un refugio, y parece necesitar más recursos antes de considerarse "
"completa."

#: lang/json/terrain_from_json.py
msgid "column"
msgstr "columna"

#. ~ Description for column
#: lang/json/terrain_from_json.py
msgid "A concrete column."
msgstr "Es una columna de concreto."

#: lang/json/terrain_from_json.py
msgid "bollard"
msgstr ""

#. ~ Description for bollard
#: lang/json/terrain_from_json.py
msgid ""
"A set of concrete and steel bollards designed to harden areas against "
"vehicle ram attacks.  It requires a few more steps to walk in between the "
"bollards sticking up out of the ground."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "large metal support"
msgstr "soporte grande de metal"

#. ~ Description for large metal support
#: lang/json/terrain_from_json.py
msgid "A heavy-duty metal support beam."
msgstr "Es una viga metálica de soporte muy resistente."

#: lang/json/terrain_from_json.py
msgid "small metal support"
msgstr "soporte chico de metal"

#. ~ Description for small metal support
#: lang/json/terrain_from_json.py
msgid "A metal support beam."
msgstr "Es una viga metálica de soporte."

#: lang/json/terrain_from_json.py
msgid "field stone wall"
msgstr "pared de piedra natural"

#. ~ Description for field stone wall
#: lang/json/terrain_from_json.py
msgid "A sturdy dry stone wall.  Just rocks fitted together without mortar."
msgstr ""
"Es una robusta pared de piedra seca. Son básicamente piedras encajadas "
"juntas sin usar mezcla."

#: lang/json/terrain_from_json.py
msgid "field stone half-wall"
msgstr "media pared de piedra natural"

#. ~ Description for field stone half-wall
#: lang/json/terrain_from_json.py
msgid ""
"A half height sturdy dry stone wall.  Just rocks fitted together without "
"mortar.  Complete as is or with extensive work it could be doubled in "
"height."
msgstr ""
"Es una robusta pared de media altura de piedra seca. Son básicamente piedras"
" encajadas juntas sin usar mezcla. Sirve así petisa o puede completarse para"
" duplicar su altura."

#: lang/json/terrain_from_json.py
msgid "pillar"
msgstr ""

#. ~ Description for pillar
#: lang/json/terrain_from_json.py
msgid ""
"A concrete column that helps keep the mine's ceiling and walls from "
"collapsing."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "window"
msgstr "ventana"

#. ~ Description for window
#: lang/json/terrain_from_json.py
msgid ""
"A giant sheet of glass inserted into a window, typically found on the side "
"of shops to showcase goods."
msgstr ""
"Es una lámina gigante de vidrio insertada en una ventana, comúnmente vista a"
" los costados de los negocios para mostrar la mercadería. Como una vidriera,"
" bah."

#: lang/json/terrain_from_json.py
msgid "taped window"
msgstr "ventana encintada"

#. ~ Description for taped window
#: lang/json/terrain_from_json.py
msgid ""
"Duct tape covers this window, blocking sunlight and visibility.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Esta ventana esta tapada con cinta adhesiva, lo que bloquea la visibilidad y"
" la luz solar. Podrías sacar la cinta adhesiva cortándola."

#: lang/json/terrain_from_json.py
msgid "window with curtains"
msgstr "ventana con cortinas"

#. ~ Description for window with curtains
#: lang/json/terrain_from_json.py
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block"
" visibility and shut out any light."
msgstr ""
"Es una ventana con cortinas muy elegantes en la parte de adentro que pueden "
"cerrarse para bloquear la visibilidad y la luz."

#: lang/json/terrain_from_json.py
msgid "window without curtains"
msgstr "ventana sin cortinas"

#. ~ Description for window without curtains
#: lang/json/terrain_from_json.py
msgid ""
"A smaller window typically found in residential homes.  You could install a "
"curtain rod and drapes if you had the supplies and skill."
msgstr ""
"Es una ventana chica que comúnmente tienen las casas residenciales. Podrías "
"ponerle unas cortinas y un palo para colgarlas, si tenés los elementos y la "
"habilidad."

#: lang/json/terrain_from_json.py
msgid "open window without curtains"
msgstr "ventana abierta sin cortinas"

#. ~ Description for open window without curtains
#: lang/json/terrain_from_json.py
msgid ""
"A smaller window typically found in residential homes.  It's open and can be"
" crawled through."
msgstr ""
"Es una ventana chica que comúnmente tienen las casas residenciales. Está "
"abierta y se puede pasar por ahí."

#. ~ Description for taped window
#: lang/json/terrain_from_json.py
msgid ""
"A smaller window typically found in residential homes.  This one has been "
"blocked out with duct tape.  You could remove the duct tape by cutting it "
"off."
msgstr ""
"Es un ventana chica que comúnmente tienen las casas residenciales. Esta ha "
"sido tapada con cinta adhesiva. Podrías cortar la cinta para sacarla."

#. ~ Description for taped window
#: lang/json/terrain_from_json.py
msgid ""
"A window with fancy curtains on the inside.  This one has been blocked out "
"with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Es una ventana con elegantes cortinas en la parte interior. Ha sido tapada "
"con cinta adhesiva. Podrías cortar la cinta para sacarla."

#: lang/json/terrain_from_json.py
msgid "open window with curtains"
msgstr "ventana abierta con cortinas"

#. ~ Description for open window with curtains
#: lang/json/terrain_from_json.py
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block"
" visibility and shut out any light.  It's open and you can crawl through."
msgstr ""
"Es una ventana con cortinas muy elegantes en la parte de adentro que pueden "
"cerrarse para bloquear la visibilidad y la luz. Está abierta y podés pasar "
"por ahí."

#: lang/json/terrain_from_json.py
msgid "window with closed curtains"
msgstr "ventana con cortinas cerradas"

#. ~ Description for window with closed curtains
#: lang/json/terrain_from_json.py
msgid ""
"A window with fancy curtains that have been drawn shut, blocking sunlight "
"and visibility.  The curtains can only be opened on the inside.  If you "
"examined the curtains more closely, you could peek through the drapes or "
"tear down everything.  Or you could just smash the window open."
msgstr ""
"Es una ventana con cortinas elegantes que han sido cerradas, bloqueando la "
"luz solar y la visibilidad. Las cortinas solamente pueden abrirse desde "
"adentro. Si las examinás de cerca, vas a poder espiar a través. O podrías "
"destrozar la ventana para abrirla. "

#. ~ Description for taped window
#: lang/json/terrain_from_json.py
msgid ""
"Duct tape covers this window, blocking out any sunlight and visibility.  You"
" could remove the duct tape by cutting it off."
msgstr ""
"Esta ventana está tapada con cinta adhesiva, lo que bloquea toda visibilidad"
" y luz solar. Podrías sacar la cinta adhesiva cortándola."

#: lang/json/terrain_from_json.py
msgid "empty window"
msgstr "ventana vacía"

#. ~ Description for empty window
#: lang/json/terrain_from_json.py
msgid ""
"An empty window frame consisting of planks and nails.  You could install a "
"sheet of glass, or even board it up for protection.  You could also convert "
"it into a wall if you took the time to construct it."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "window frame"
msgstr "marco de ventana"

#. ~ Description for window frame
#: lang/json/terrain_from_json.py
msgid ""
"A wooden window frame that has shattered glass around it.  You'll probably "
"get hurt if you crawled through the sharp and jagged shards.  You could "
"smash out the remaining pieces, or take your time and quietly clean them up."
msgstr ""
"Es un marco de madera de ventana, con pedazos de vidrios rotos. "
"Probablemente, te vayas a lastimar si pasás por ahí. Podrías destrozar los "
"restos o tomarte tu tiempo y sacar todos los vidrios del marco."

#: lang/json/terrain_from_json.py
msgid "glass crunching!"
msgstr "¡crujido de vidrios!"

#: lang/json/terrain_from_json.py
msgid "boarded up window"
msgstr "ventana cubierta con tablas"

#. ~ Description for boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"A glass window that has been covered with nailed down planks, blocking "
"sunlight and visibility.  It's not much stronger, but it could be further "
"reinforced with strategically placed planks."
msgstr ""

#. ~ Description for boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"An empty window frame that has been covered with nailed down planks, "
"blocking sunlight and visibility.  It's not much stronger, but it could be "
"further reinforced with strategically placed planks."
msgstr ""

#: lang/json/terrain_from_json.py
msgid "reinforced boarded up window"
msgstr "ventana reforzada cubierta con tablas"

#. ~ Description for reinforced boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"A heavily fortified glass window with carefully placed planks across the "
"glass to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Es una ventana de vidrio muy fortificada, con tablas de madera ubicadas "
"cuidadosamente en el vidrio para bloquear la visibilidad. Si le agregás unas"
" púas y unas placas de metal, podrías incrementar su durabilidad."

#. ~ Description for reinforced boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"A heavily fortified window with carefully placed planks across the open "
"frame to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Es una ventana muy fortificada, con tablas de madera ubicadas cuidadosamente"
" en el marco para bloquear la visibilidad. Si le agregás unas púas y unas "
"placas de metal podrías incrementar su durabilidad."

#: lang/json/terrain_from_json.py
msgid "armored boarded up window"
msgstr "ventana blindada cubierta con tablas"

#. ~ Description for armored boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"This once normal glass window now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Esto que antes era una ventana normal de vidrio, ahora tiene unas púas "
"amenazantes en los bordes, con placas de metal cuidadosamente puestas para "
"reforzar los refuerzos de madera."

#. ~ Description for armored boarded up window
#: lang/json/terrain_from_json.py
msgid ""
"This once normal window frame now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
