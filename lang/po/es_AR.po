#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "CRIT NCO"
msgstr "Suboficial CRIT"

#. ~ Profession (male CRIT NCO) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were a senior NCO, relaying orders to your squad was an everyday task.  "
"When the cataclysm struck, your expertise helped save everyone time and time"
" again until it all fell apart."
msgstr ""
"Eras un suboficial superior que impartía órdenes a su escuadrón todos los "
"días. Cuando llegó el Cataclismo, tu pericia ayudó a salvar a todos una y "
"otra vez hasta que finalmente todo se derrumbó."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "CRIT NCO"
msgstr "Suboficial CRIT"

#. ~ Profession (female CRIT NCO) description
#: lang/json/professions_from_json.py
