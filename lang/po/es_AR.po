"letales."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Earthquake Brawler"
msgstr "Matón Terremoto"

#. ~ Profession (male Earthquake Brawler) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You've made a name for yourself in underground magic boxing rings as an "
"unstoppable punching machine.  Now that all your opponents are undead, "
"there's no need to hold back."
msgstr ""
"Te hiciste un nombre en los rings subterráneos de boxeo de magia, al ser una"
" máquina imparable de trompadas. Ahora que todos tus oponentes son muertos "
"vivos, no hay necesidad de que te guardes nada."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Earthquake Brawler"
msgstr "Matona Terremoto"

#. ~ Profession (female Earthquake Brawler) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
