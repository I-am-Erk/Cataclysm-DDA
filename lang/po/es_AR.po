#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Shock Officer"
msgstr "Oficial de Shock"

#. ~ Profession (male Shock Officer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were enrolled in a experimental law enforcement program designed to "
"decrease suspect casualties and equipment costs by substituting tasers and "
"bullets for less-lethal Stormshaping."
msgstr ""
"Te inscribiste en un programa experimental de fuerzas de la ley diseñado "
"para disminuir las muertes de sospechosos y los costos de equipamiento, al "
"sustituir las pistolas eléctricas y las balas por Tormentaformantes menos "
"letales."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Shock Officer"
msgstr "Oficial de Shock"

#. ~ Profession (female Shock Officer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"You were enrolled in a experimental law enforcement program designed to "
