msgstr[1] "Famuli rotos"

#. ~ Description for broken Famulus
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken Famulus, now silent and mangled.  If it wasn't for the obvious "
"rivets and welding, it would look completely human.  Could be stripped down "
"for parts."
msgstr ""
"Es un Famulus roto, ahora silencioso y destrozado. Si no fuera por los "
"remaches y soldaduras obvias, parecería totalmente humano. Puede ser "
"desarmado para recuperar partes."

#: lang/json/GENERIC_from_json.py
msgid "broken Udarnik"
msgid_plural "broken Udarniks"
msgstr[0] "Udarnik roto"
msgstr[1] "Udarniks rotos"

#. ~ Description for broken Udarnik
