"vehículo."

#: lang/json/GENERIC_from_json.py
msgid "RV kitchen unit"
msgid_plural "RV kitchen units"
msgstr[0] "cocina para casilla"
msgstr[1] "cocinas para casilla"

#. ~ Description for RV kitchen unit
#: lang/json/GENERIC_from_json.py
