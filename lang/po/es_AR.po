#, c-format
msgid "As soon as the cougar sprang %s darted to the safety of the outpost!"
msgstr ""
"¡Cuando el puma saltó, %s se escapó rápidamente a la seguridad del puesto!"

#: src/mission_companion.cpp
#, c-format
msgid ""
"%s was caught unaware and was forced to fight the creature at close range!"
msgstr ""
"¡%s fue atrapado desprevenido y forzado a luchar con la criatura cuerpo a "
"cuerpo!"

#: src/mission_companion.cpp
#, c-format
msgid "%s was able to scare off the bear after delivering a nasty blow!"
msgstr "¡%s pudo asustar al oso después de pegarle un golpe tremendo!"

#: src/mission_companion.cpp
#, c-format
msgid "%s beat the cougar into a bloody pulp!"
msgstr "¡%s golpeó al puma y dejó una pulpa sangrienta!"

#: src/mission_companion.cpp
#, c-format
msgid ""
"%s was able to hold off the first wolf but the others that were skulking in "
