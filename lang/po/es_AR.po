#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Baseball Player"
msgstr "Jugadora de Béisbol"

#. ~ Profession (male Baseball Player) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were playing at the local team.  With no one left to play baseball, you "
"can eventually use your best friend for another purpose.  Home run!"
msgstr ""
"Estabas jugando para el equipo del pueblo. Ahora que no quedó nadie para "
"jugar al béisbol, eventualmente podrás usar a tu mejor amigo para otro "
"propósito. ¡Home run!"

