#, c-format
msgid "Looks like %d story.  Jump down?"
msgid_plural "Looks like %d stories.  Jump down?"
msgstr[0] "Parece que es %d piso. ¿Te querés tirar?"
msgstr[1] "Parece que son %d pisos. ¿Te querés tirar?"

#: src/iexamine.cpp
msgid "You probably won't be able to get up and jumping down may hurt.  Jump?"
msgstr ""
"Probablemente, no vayas a poder subir y tirarte puede doler. ¿Te querés "
"tirar?"

