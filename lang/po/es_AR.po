msgstr "Es una rueda chica como la de una carretilla normal de jardinería."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "bicycle wheel"
msgid_plural "bicycle wheels"
msgstr[0] "rueda de bicicleta"
msgstr[1] "ruedas de bicicleta"

#. ~ Description for bicycle wheel
#: lang/json/WHEEL_from_json.py
