#: lang/json/snippet_from_json.py
msgid ""
"\"they've got robots for everything.  haven't seen a single grey.  some "
"aliens, huh?\""
msgstr ""
"\"tienen robots para todo. no vi ni un solo canoso. qué extraterrestres, "
"¿eh?\""

#: lang/json/snippet_from_json.py
msgid "\"at least they aren't quiet\""
