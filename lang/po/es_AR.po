#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Tweaker"
msgstr "Drogadicto"

#. ~ Profession (male Tweaker) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You're not entirely sure what happened last night, but you woke up on the "
"floor and everything has gone completely to shit.  The only thing running "
"through your head, though, is where you're gonna find your next hit."
msgstr ""
"No estás completamente seguro de lo que pasó anoche, pero te despertaste en "
"el suelo y todo se fue a la mierda. Igual, la única cosa que te pasa por la "
"cabeza es dónde vas a poder conseguir tu próxima dosis."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Tweaker"
msgstr "Drogadicta"

#. ~ Profession (female Tweaker) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
