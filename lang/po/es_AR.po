msgstr ""
"Una extraña sombra envuelve a esta criatura. Podés distinguir la forma de un"
" dinosaurio bípedo con bordes con plumas. Los dos pies lucen garras largas "
"con forma de hoz."

#: lang/json/MONSTER_from_json.py
msgid "shady Utahraptor"
msgid_plural "shady Utahraptor"
msgstr[0] "Utahraptor sombrío"
msgstr[1] "Utahraptor sombríos"

#. ~ Description for {'str_sp': 'shady Utahraptor'}
#: lang/json/MONSTER_from_json.py
