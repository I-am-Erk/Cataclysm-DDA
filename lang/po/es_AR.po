msgid_plural "wooden bodkin bolts"
msgstr[0] "perno bodkin de madera"
msgstr[1] "pernos bodkin de madera"

#. ~ Description for wooden bodkin bolt
#: lang/json/AMMO_from_json.py
msgid ""
