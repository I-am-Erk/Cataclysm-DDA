msgid "knock!"
msgstr "knock!"

#: lang/json/terrain_from_json.py
msgid "thud thud."
msgstr "poc poc."

#: lang/json/terrain_from_json.py
msgid "knock knock."
msgstr "toc toc."

#: lang/json/terrain_from_json.py
msgid "open secret"
msgstr "secreto abierto"

#: lang/json/terrain_from_json.py
msgid "book case"
msgstr "biblioteca"

#: lang/json/terrain_from_json.py
msgid "unusual book case"
msgstr "biblioteca extraña"

#: lang/json/terrain_from_json.py
msgid "open sliding wall"
msgstr "pared corrediza abierta"

#: lang/json/terrain_from_json.py
msgid "unusual statue"
msgstr "estatua extraña"

#: lang/json/terrain_from_json.py
msgid "containment manual override"
msgstr "control manual de contención"

#: lang/json/terrain_from_json.py
msgid "security bolt release"
msgstr "apertura de pestillos de seguridad"

#: lang/json/terrain_from_json.py
msgid "bridge control"
msgstr "control de puente"

#: lang/json/terrain_from_json.py
msgid "shallow chocolate"
msgstr "chocolate poco profundo"

#. ~ Description for shallow chocolate
#: lang/json/terrain_from_json.py
msgid ""
"The chocolate isn't too deep here.  With a watertight container, you could "
"gather what looks to be pure melted cacao.  This will not be tasty."
msgstr ""
"Acá el chocolate no es muy profundo. Con un recipiente hermético podrías "
"recolectar lo que parece ser cacao puro derretido. Pero no va a ser sabroso."

#: lang/json/terrain_from_json.py
msgid "deep chocolate"
msgstr "chocolate profundo"

#. ~ Description for deep chocolate
#: lang/json/terrain_from_json.py
msgid ""
"The chocolate here is deep enough to drown in.  With a watertight container,"
" you could gather what looks to be pure melted cacao.  This will not be "
"tasty."
msgstr ""
"Acá el chocolate es lo suficientemente profundo como para que te ahogues en "
"él. Con un recipiente hermético podrías recolectar lo que parece ser cacao "
"puro derretido. Pero no va a ser sabroso."

#. ~ Description for caramel
#: lang/json/terrain_from_json.py
msgid ""
"An extremely hot, glowing liquid, composed of molten caramel.  In some "
"places, caramel coated fruit is a delicacy."
msgstr ""
"Es un líquido brillante y extremadamente caliente, compuesto de caramelo "
"derretido. En algunas partes, la fruta recubierta de caramelo es una "
"exquisitez."

#: lang/json/terrain_from_json.py
msgid "singing sand"
msgstr "duna cantora"

#. ~ Description for singing sand
#: lang/json/terrain_from_json.py
msgid ""
"A formation of sand containing special minerals to produce whistling noises "
"when stepped on and from the wind."
msgstr ""
"Es una formación de arena que contiene unos minerales especiales que "
"producen sonido de silbido cuando la pisás y por el viento."

#: lang/json/terrain_from_json.py
msgid "outcrop"
msgstr "saliente"

#. ~ Description for outcrop
#: lang/json/terrain_from_json.py
msgid ""
"An assortment of various large, sharp rocks that jut out from the "
"surrounding terrain.  Could be as a surface for a number of things or "
"climbed on if worn with proper footwear."
msgstr ""
"Es una selección de varias rocas grandes y filosas que sobresalen del "
"terreno. Puede ser usada como superficie para varias cosas o se puede trepar"
" si se dispone del calzado adecuado."

#: lang/json/terrain_from_json.py
msgid "dune"
msgstr "duna"

#. ~ Description for dune
#: lang/json/terrain_from_json.py
msgid ""
"A huge sand dune that is continually reshaped by the wind.  Climbing it will"
" be troublesome."
msgstr ""
"Es una enorme duna de arena que está siendo continuamente reformada por el "
"viento. No será sencillo treparla."

#: lang/json/terrain_from_json.py
msgid "desert pavement"
msgstr "pavimento desértico"

#. ~ Description for desert pavement
#: lang/json/terrain_from_json.py
msgid ""
"Not that kind of pavement!  Naturally occurring pockets of densely packed "
"rock fragments that is easier to traverse than sand, with the right "
"footwear."
msgstr ""
"¡No es el pavimento que estás pensando! Son bolsillos naturales de "
"fragmentos de roca densamente unida por los que son más fáciles de transitar"
" que la arena, con el calzado adecuado."

#. ~ Description for scorched earth
#: lang/json/terrain_from_json.py
msgid ""
"Cracked and dry soil that doesn't look like it will be capable of supporting"
" anything in your lifetime."
msgstr ""
"Es suelo seco y resquebrajado que no parece ser capaz de soportar en tu "
"vida."

#. ~ Description for cactus
#: lang/json/terrain_from_json.py
msgid "A tall cactus."
msgstr "Es un cactus alto."

