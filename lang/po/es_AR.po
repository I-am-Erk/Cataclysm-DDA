#, c-format
msgid "< Press %s to filter, %s to reset >"
msgstr "< Apretá %s para filtrar, %s para restaurar >"

#: src/messages.cpp
#, c-format
msgid ""
"<color_light_gray>The default is to search the entire message log.  Use message-types as prefixes followed by (:) to filter more specific.\n"
"Valid message-type values are:</color> %s\n"
"\n"
"<color_white>Examples:</color>\n"
"  <color_light_green>good</color><color_white>:mutation\n"
"  :you pick up: 1</color>\n"
"  <color_light_red>bad</color><color_white>:</color>\n"
"\n"
msgstr ""
"<color_light_gray>Lo normal es buscar en el registro completo de mensajes. Usá tipos de mensajes como los prefijos seguidos por (:) para filtrar algo específico.\n"
"Los tipos de mensajes válidos son:</color> %s\n"
"\n"
"<color_white>Ejemplos:</color>\n"
"  <color_light_green>bueno</color><color_white>:mutación\n"
"  :vos agarrás: 1</color>\n"
"  <color_light_red>malo</color><color_white>:</color>\n"
"\n"

