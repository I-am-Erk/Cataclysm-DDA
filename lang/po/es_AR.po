msgid_plural ".50 BMG AP, black powder"
msgstr[0] ".50 BMG AP, pólvora"
msgstr[1] ".50 BMG AP, pólvora"

#: lang/json/AMMO_from_json.py
msgid ".500 S&W Magnum"
msgid_plural ".500 S&W Magnums"
msgstr[0] ".500 S&W Magnum"
msgstr[1] ".500 S&W Magnum"

#. ~ Description for .500 S&W Magnum
#: lang/json/AMMO_from_json.py
msgid ""
".500 S&W Magnum ammunition with 500gr bullets.  The .500 S&W Magnum round is"
" a colossally powerful handgun cartridge capable of killing almost any "
"target with one hit.  It has extremely high damage and recoil to match."
msgstr ""
"Es munición .500 S&W Magnum de 500gr. La bala .500 S&W Magnum es un cartucho"
" colosalmente poderoso para armas cortas, capaz de matar casi cualquier "
"objetivo con un solo disparo. Causa un daño extremadamente alto y su "
"retroceso es equivalente."

#: lang/json/AMMO_from_json.py
