msgstr[1] "9x19mm FMJ, pólvora"

#: lang/json/AMMO_from_json.py
msgid "9x19mm JHP, reloaded"
msgid_plural "9x19mm JHP, reloaded"
msgstr[0] "9x19mm JHP, recargada"
msgstr[1] "9x19mm JHP, recargada"

#: lang/json/AMMO_from_json.py
