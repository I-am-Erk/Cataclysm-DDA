msgstr[1] "granadas fúngicas activadas"

#. ~ Description for armed fungicidal gas canister
#: lang/json/GENERIC_from_json.py
msgid ""
"This fungicidal bomb has had its pin removed and is expelling highly toxic "
"gas."
msgstr ""
"Esta bomba fúngica no tiene el gancho de seguridad y está largando un gas "
"muy tóxico."

