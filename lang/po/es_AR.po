msgid_plural "corn on the cob"
msgstr[0] "choclo en mazorca"
msgstr[1] "choclo en mazorca"

#. ~ Description for {'str_sp': 'corn on the cob'}
#: lang/json/COMESTIBLE_from_json.py
msgid "An ear of corn cooked in foil."
msgstr "Es un choclo cocinado en papel aluminio."

#: lang/json/COMESTIBLE_from_json.py
