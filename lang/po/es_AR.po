#: lang/json/MONSTER_from_json.py
msgid "shady Nothronychus"
msgid_plural "shady Nothronychus"
msgstr[0] "Nothronychus sombrío"
msgstr[1] "Nothronychus sombríos"

#. ~ Description for {'str_sp': 'shady Nothronychus'}
