#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Survivalist"
msgstr "Survivalista"

#. ~ Profession (male Survivalist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Living off the land, far from civilization, is nothing new to you.  The only"
" difference is all the monsters that suddenly want you dead.  Your equipment"
" is basic, but versatile… except that your canteen's run out!"
msgstr ""
"Vivir de la naturaleza alejado de la civilización no es nada nuevo para vos."
" La única diferencia son todos los monstruos que de repente te quieren "
"matar. Tu equipamiento es básico pero versátil… ¡excepto con el problemita "
"de que casi no tenés agua!"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Survivalist"
msgstr "Survivalista"

#. ~ Profession (female Survivalist) description
#: lang/json/professions_from_json.py
