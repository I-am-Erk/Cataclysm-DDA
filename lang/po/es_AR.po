#, c-format
msgid "You don't know the recipe for the %s and can't continue crafting."
msgstr "No conocés la receta del %s y no podés continuar la fabricación."

#: src/iexamine.cpp src/iuse.cpp
#, c-format
msgid ""
"<npcname> doesn't know the recipe for the %s and can't continue crafting."
msgstr ""
"<npcname> no conoce la receta del %s y no puede continuar la fabricación."

#: src/iexamine.cpp
#, c-format
