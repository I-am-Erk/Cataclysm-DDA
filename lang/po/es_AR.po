msgid "fungal Spinosaurus zombie"
msgid_plural "fungal Spinosaurus zombies"
msgstr[0] "Spinosaurus zombi fúngico"
msgstr[1] "Spinosaurus zombis fúngicos"

#. ~ Description for fungal Spinosaurus zombie
#: lang/json/MONSTER_from_json.py
msgid ""
