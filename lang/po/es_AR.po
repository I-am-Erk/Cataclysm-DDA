#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Hobby Handloader"
msgstr "Recargador Aficionado"

#. ~ Profession (male Hobby Handloader) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Out of financial concerns and an appreciation for power, you took up "
"handloading for your mighty handgun.  Now that the gunstores are closed, "
"your skills ensure you won't be running out of ammo anytime soon."
msgstr ""
"Por problemas financieros y una apreciación por la potencia, empezaste a "
"recargar a mano tu poderosa arma. Ahora que las armerías cerraron, tus "
"habilidades te aseguran que por el momento no te vas a quedar sin munición."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Hobby Handloader"
msgstr "Recargadora Aficionada"

