#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Rating"
msgstr "Tripulante"

#. ~ Profession (male Rating) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were a junior crewmember on a freight spaceship.  Without any "
"exceptionally valuable abilities, you spent your workshifts performing "
"miscellaneous maintenance tasks within the ship.  As such, you are "
"moderately skilled at performing all sorts of minor electrical and "
"mechanical repairs, a skillset you hope remains useful planetside…"
msgstr ""
"Eras un joven miembro del equipo en un carguero espacial. Sin ninguna "
"habilidad excepcional, te pasaste tus turnos desempeñando diversas tareas de"
" mantenimiento dentro de la nave. Como tal, estás moderadamente entrenado "
"para realizar toda clase de reparaciones mecánicas y eléctricas, unas "
"habilidades que esperás que sigan siendo útiles fuera de la nave…"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Rating"
msgstr "Tripulante"

#. ~ Profession (female Rating) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
