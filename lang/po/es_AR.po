msgstr "Decidiste alejarte un paso del borde."

#. ~ %1$s is the name of the ally
#: src/iexamine.cpp
#, c-format
msgid ""
"<color_white>%1$s is asleep, but has a <color_green>%2$d<color_white> chance"
