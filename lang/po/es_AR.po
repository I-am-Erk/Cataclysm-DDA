#: lang/json/effects_from_json.py
msgid "Sadie's injection"
msgstr "Inyección de Sadie"

#. ~ Apply message for effect(s) 'Sadie's injection'.
#: lang/json/effects_from_json.py
msgid "A wave of cold runs through your body and you feel dizzy"
msgstr "Una ola de frío te corre por el cuerpo y te sentís mareado"

#. ~ Remove message for effect(s) 'Sadie's injection'.
#: lang/json/effects_from_json.py
msgid "The effects of Sadie's injection appear to be wearing off now"
msgstr "Los efectos de la inyección de Sadie parecen estar yéndose"

#: lang/json/effects_from_json.py
msgid "Panicking"
msgstr "En pánico"

#. ~ Description of effect 'Panicking'.
#: lang/json/effects_from_json.py
msgid "You just can't stop shaking and are overwhelmed by fear."
msgstr "No podés dejar de temblar y estás agobiado por el miedo."

#. ~ Apply message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid ""
"An all consuming dread overwhelms your mind and you begin to shake "
"uncontrollably!"
msgstr ""
"Te consume un pavor que agobia tu mente ¡y comenzás a temblar "
"descontroladamente!"

#. ~ Remove message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid "Your heartrate slows back to normal!"
msgstr "¡Tu ritmo cardíaco se desacelera y vuelve a ser normal!"

#. ~ Miss message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid "You shake uncontrollably"
