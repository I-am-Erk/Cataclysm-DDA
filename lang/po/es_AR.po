#. ~ Description for finger firelighter
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small flame you can hold in your hand.  With a thought, you can "
"cause it to light something on fire."
msgstr ""
"Es una pequeña llama que podés tener en tu mano. Con un pensamiento, podés "
"hacer que encienda fuego algo."

#: lang/json/TOOL_from_json.py
msgid "seed of purification"
msgid_plural "seeds of purification"
msgstr[0] "semilla de purificación"
msgstr[1] "semillas de purificación"

#. ~ Use action menu_text for seed of purification.
#: lang/json/TOOL_from_json.py
msgid "Squeeze seed"
msgstr "Exprimir semilla"

#. ~ Use action msg for seed of purification.
#: lang/json/TOOL_from_json.py
msgid ""
"You squeeze the seed in your palm, and it begins to turn to a fine dust."
msgstr ""
"Exprimís la semilla en tu mano y comienza a convertirse en un fino polvo."

#. ~ Description for seed of purification
#: lang/json/TOOL_from_json.py
msgid ""
"A magical seed that can be squeezed to release purifying dust, which can "
"then be used to purify up to a gallon of water"
msgstr ""
"Es una semilla mágica que puede exprimirse para liberar un polvo "
"purificador, que puede ser usado para purificar hasta casi 4 litros de agua."

#: lang/json/TOOL_from_json.py
msgid "faintly glowing dust"
msgid_plural "faintly glowing dusts"
msgstr[0] "polvo ligeramente brillante"
msgstr[1] "polvos ligeramente brillantes"

#. ~ Description for faintly glowing dust
#: lang/json/TOOL_from_json.py
msgid "This fine dust glows with a growing intensity"
msgstr "Este polvo fino brilla con una intensidad que va creciendo."

#: lang/json/TOOL_from_json.py
msgid "orichalcum combat knife"
msgid_plural "orichalcum combat knives"
msgstr[0] "cuchillo de combate de oricalco"
msgstr[1] "cuchillos de combate de oricalco"

#. ~ Description for orichalcum combat knife
#: lang/json/TOOL_from_json.py
msgid ""
"A variant of the combat knife that is made of orichalcum instead of steel.  "
"Sharper and easier to maintain than steel while just as dense, this knife "
"also has a thinner blade, which shaves off some weight."
msgstr ""
"Es una variante hecha de oricalco del cuchillo de combate, en lugar de "
"acero. Más filoso y fácil de mantener que el acero pero igual de denso. Este"
" cuchillo tiene una hoja más fina lo que lo hace más liviano."

#: lang/json/TOOL_from_json.py
msgid "orichalcum longsword"
msgid_plural "orichalcum longswords"
msgstr[0] "espada larga de oricalco"
msgstr[1] "espadas largas de oricalco"

#. ~ Description for orichalcum longsword
#: lang/json/TOOL_from_json.py
msgid ""
"A variant of the longsword that is made of orichalcum instead of steel.  "
"Sharper and easier to maintain than steel while just as dense, this "
"longsword also has a thinner blade, which shaves off some weight."
msgstr ""
"Es una variante hecha de oricalco de la espada larga, en lugar de acero. Más"
" filoso y fácil de mantener que el acero pero igual de denso. Esta espada "
"tiene una hoja más fina lo que la hace más liviana."

#: lang/json/TOOL_from_json.py
msgid "orichalcum fire axe"
msgid_plural "orichalcum fire axes"
msgstr[0] "hacha de bombero de oricalco"
msgstr[1] "hachas de bombero de oricalco"

#. ~ Description for orichalcum fire axe
#: lang/json/TOOL_from_json.py
msgid ""
"A fire axe made with orichalcum instead of steel.  This makes it possible to"
" chop through harder materials, and in the very well-funded fire stations is"
" preferred."
msgstr ""
"Es un hacha de bombero hecha de oricalco en lugar de acero. Esto la hace "
"posible de cortar los materiales más duros, y en las cuarteles de bomberos "
"es la favorita."

#: lang/json/TOOL_from_json.py
msgid "wand of fireballs"
msgid_plural "wands of fireballs"
msgstr[0] "vara bola de fuego"
msgstr[1] "varas bola de fuego"

#. ~ Description for wand of fireballs
#: lang/json/TOOL_from_json.py
msgid ""
"A classic, this wand shoots fireballs without fail.  A more skilled "
"Kelvinist could cast them more efficiently, though."
msgstr ""
"Un clásico, la vara que dispara bolas de fuego sin fallar. De todas maneras,"
" un Kelvinista más habilidoso puede conjurar ese hechizo de manera más "
"eficiente."

#: lang/json/TOOL_from_json.py
msgid "wand of magic missiles"
msgid_plural "wands of magic missiles"
msgstr[0] "vara de misiles mágicos"
msgstr[1] "varas de misiles mágicos"

#. ~ Description for wand of magic missiles
#: lang/json/TOOL_from_json.py
msgid ""
"A classic, this wand shoots magic missiles without fail.  A more skilled "
"Magus could cast them more efficiently, though."
msgstr ""
"Un clásico, la vara que dispara misiles mágicos sin fallar. De todas "
"maneras, un Magi más habilidoso puede conjurar ese hechizo de manera más "
"eficiente."

#: lang/json/TOOL_from_json.py lang/json/furniture_from_json.py
msgid "demon forge"
msgid_plural "demon forges"
msgstr[0] "forja demoníaca"
msgstr[1] "forjas demoníacas"

#. ~ Description for demon forge
#: lang/json/TOOL_from_json.py
msgid ""
"This is a portable version of the charcoal forge that is magically enhanced "
"and fortified with demon spider chitin in order to be able to resmelt "
"magical metals into their workable ingot form."
msgstr ""
"Es una versión portátil de la forja de carbón, mejorada mágicamente y "
"fortificada con quitina de araña demoníaca para hacerla capaz de fundir "
"metales mágicos para darles forma de lingote para trabajarlos."

#: lang/json/TOOL_from_json.py
msgid "glassteel shard"
msgid_plural "glassteel shards"
msgstr[0] "fragmento de vidriacero"
msgstr[1] "fragmentos de vidriacero"

#. ~ Description for glassteel shard
#: lang/json/TOOL_from_json.py
msgid ""
"A broken shard of glassteel covered in sharp edges.  You could use it as a "
"weapon, but you might want to wear gloves."
msgstr ""
"Es un fragmento de vidriacero roto con las puntas afiladas. Lo podés usar "
"como arma, pero te conviene usar guantes."

#: lang/json/TOOL_from_json.py
msgid "rock candy chunk"
msgid_plural "rock candy chunks"
msgstr[0] "pedazo de caramelo duro"
msgstr[1] "pedazos de caramelo duro"

#. ~ Description for rock candy chunk
#: lang/json/TOOL_from_json.py
msgid "This is a chunk of hard rock candy.  It can be broken down into sugar."
msgstr "Esto es un pedazo de caramelo duro. Puede ser roto para hacer azúcar."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "yoke and harness"
msgid_plural "yokes and harnesses"
msgstr[0] "yugo y arnés"
msgstr[1] "yugos y arneses"

#. ~ Description for yoke and harness
#: lang/json/WHEEL_from_json.py
msgid ""
"A bar and harness to attach a creature to a wheeled vehicle, they then "
"should be able to pull it."
msgstr ""
"Es una barra y un arnés para unir una criatura a un vehículo, con el que "
"podrían tirar del vehículo."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "wheel"
msgid_plural "wheels"
msgstr[0] "rueda"
msgstr[1] "ruedas"

#. ~ Description for wheel
