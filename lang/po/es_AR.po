#: lang/json/GENERIC_from_json.py
msgid "10mm Auto casing"
msgid_plural "10mm Auto casings"
msgstr[0] "vaina 10mm Auto"
msgstr[1] "vainas 10mm Auto"

#. ~ Description for 10mm Auto casing
#: lang/json/GENERIC_from_json.py
msgid "An empty casing from a 10mm Auto round."
msgstr "Es una vaina servida de una bala calibre 10mm Auto."

#: lang/json/GENERIC_from_json.py
msgid "40x46mm M212 casing"
msgid_plural "40x46mm M212 casings"
msgstr[0] "vaina 40x46mm M212"
msgstr[1] "vainas 40x46mm M212"

#. ~ Description for 40x46mm M212 casing
#: lang/json/GENERIC_from_json.py
msgid ""
"A large casing from a spent 40x46mm cartridge, which used to hold a less-"
"lethal projectile."
msgstr ""
"Es una vaina grande de un cartucho 40x46mm usado, que contenía un proyectil "
"no muy letal."

#: lang/json/GENERIC_from_json.py
msgid "40x46mm M118 casing"
msgid_plural "40x46mm M118 casings"
msgstr[0] "vaina 40x46mm M118"
msgstr[1] "vainas 40x46mm M118"

#. ~ Description for 40x46mm M118 casing
#: lang/json/GENERIC_from_json.py
msgid ""
"A large casing from a spent 40x46mm cartridge, which used to hold a HEDP "
"grenade.  Suitable for reloading with buckshot, slug or flechette loads."
msgstr ""
"Es una vaina grande de un cartucho 40x46mm usado, que contenía una granada "
"HEDP. Adecuada para recargar con perdigones grandes, postas o dardos "
"perforantes."

#: lang/json/GENERIC_from_json.py
msgid "40x46mm M199 casing"
msgid_plural "40x46mm M199 casings"
msgstr[0] "vaina 40x46mm M199"
msgstr[1] "vainas 40x46mm M199"

#. ~ Description for 40x46mm M199 casing
