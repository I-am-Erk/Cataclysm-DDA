msgid_plural "pairs of EOD gloves"
msgstr[0] "par de guantes EOD"
msgstr[1] "pares de guantes EOD"

#. ~ Description for pair of EOD gloves
#: lang/json/ARMOR_from_json.py
msgid ""
"Light armored gloves constructed from kevlar and nomex for explosive "
"ordnance disposal.  They are designed to protect against fragmentation and "
"heat."
msgstr ""
"Son unos guantes livianos construidos de kevlar y Nomex que son parte del "
"traje antiexplosivos. Están diseñados para proteger contra la fragmentación "
"y el calor."

#: lang/json/ARMOR_from_json.py
