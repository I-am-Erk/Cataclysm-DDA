#: lang/json/mutation_from_json.py
msgid "Facial hair: none"
msgstr "Pelo facial: nada"

#. ~ Description for {'str': 'Facial hair: none'}
#: lang/json/mutation_from_json.py
msgid ""
"You have no hair on your face, it is shaven or simply untouched by the "
"presence of hair."
msgstr ""
"No tenés pelo en la cara, está afeitada o simplemente nunca tuvo presencia "
"de pelo"

#: lang/json/mutation_from_json.py
msgid "Facial hair: goatee"
msgstr "Pelo facial: chiva"

#. ~ Description for {'str': 'Facial hair: goatee'}
#: lang/json/mutation_from_json.py
msgid "You have a short beard at the tip of your chin."
msgstr "Tenés una barba corta en la punta de tu pera."

#: lang/json/mutation_from_json.py
msgid "Facial hair: circle beard"
msgstr "Pelo facial: candado"

#. ~ Description for {'str': 'Facial hair: circle beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache and a short beard, that both form a circle around your "
"lips."
msgstr ""
"Tenés bigote y barba corta, formando un círculo alrededor de tus labios."

#: lang/json/mutation_from_json.py
msgid "Facial hair: royale beard"
msgstr "Pelo facial: barba real"

#. ~ Description for {'str': 'Facial hair: royale beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache and a short beard forming a patch under your lips."
msgstr "Tenés bigote y barba corta debajo de los labios pero que no se tocan."

#: lang/json/mutation_from_json.py
msgid "Facial hair: anchor beard"
msgstr "Pelo facial: barbita ancla"

#. ~ Description for {'str': 'Facial hair: anchor beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache and a beard starting with a strip going down from the "
"bottom lip, then tracing the jaw lines.  It looks a bit like an anchor, thus"
" the name."
msgstr ""
"Tenés bigote y barba que comienzan con una línea bajando por el labio "
"inferior y por el borde de la línea de la mandíbula. Se parece un poco a un "
"ancla, por eso el nombre."

#: lang/json/mutation_from_json.py
msgid "Facial hair: short boxed beard"
msgstr "Pelo facial: barba corta cuadrada"

#. ~ Description for {'str': 'Facial hair: short boxed beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache and a short beard with trimmed sides.  Thin patches "
"connect them both, forming a 'box' around the lips, thus the name."
msgstr ""
"Tenés bigote y barba corta con los costados cortados. Pequeños pedazos "
"conectan a los dos, formando una especie de caja alrededor de los labios, "
"por eso el nombre."

#: lang/json/mutation_from_json.py
msgid "Facial hair: chevron moustache"
msgstr "Pelo facial: bigote chevron"

#. ~ Description for {'str': 'Facial hair: chevron moustache'}
#: lang/json/mutation_from_json.py
msgid "You have a moustache that covers your entire top lip."
msgstr "Tenés bigote que cubre el labio superior completamente."

#: lang/json/mutation_from_json.py
msgid "Facial hair: 3-day stubble"
msgstr "Pelo facial: barba de 3 días"

#. ~ Description for {'str': 'Facial hair: 3-day stubble'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a short trimmed moustache and beard imitating a 3-day stubble."
msgstr "Tenés bigote recortado y barba que asemejan una crecida de 3 días."

#: lang/json/mutation_from_json.py
msgid "Facial hair: horseshoe"
msgstr "Pelo facial: herradura"

#. ~ Description for {'str': 'Facial hair: horseshoe'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache with patches going down the chin from both ends, thus "
"the name."
msgstr ""
"Tenés bigote con puntas hacia la pera desde los dos costados, por eso el "
"nombre."

#: lang/json/mutation_from_json.py
msgid "Facial hair: original moustache"
msgstr "Pelo facial: bigote original"

#. ~ Description for {'str': 'Facial hair: original moustache'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache with shortened ends, that covers only the skin above "
"your upper lip."
msgstr ""
"Tenés un bigote con las puntas cortas que cubre solamente la piel sobre tu "
"labio superior."

#: lang/json/mutation_from_json.py
msgid "Facial hair: mutton chops beard"
msgstr "Pelo facial: patillas souvarov"

#. ~ Description for {'str': 'Facial hair: mutton chops beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have long sideburns that connect to your moustache, with the tip of the "
"chin shaven clean."
msgstr ""
"Tenés patillas largas que se conectan con el bigote, con la punta de la pera"
" afeitada."

#: lang/json/mutation_from_json.py
msgid "Facial hair: gunslinger beard"
msgstr "Pelo facial: barba pistolero"

#. ~ Description for {'str': 'Facial hair: gunslinger beard'}
#: lang/json/mutation_from_json.py
msgid "You have a horseshoe moustache and disconnected sideburns."
msgstr "Tenés bigote herradura y patillas que no llegan hasta el bigote."

#: lang/json/mutation_from_json.py
msgid "Facial hair: chin strip"
msgstr "Pelo facial: raya de mentón"

#. ~ Description for {'str': 'Facial hair: chin strip'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a short beard in a form of a vertical patch under your bottom lip."
msgstr "Tenés una barba corta en forma vertical bajo tu labio inferior."

#: lang/json/mutation_from_json.py
msgid "Facial hair: chin curtain"
msgstr "Pelo facial: cortina de mentón"

#. ~ Description for {'str': 'Facial hair: chin curtain'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a full beard without a moustache, restricted to the chin, sometimes"
" called a 'lion's mane'. Much like Abraham Lincoln's beard."
msgstr ""
"Tenés barba completa sin bigote, solamente en el mentón, que a veces llaman "
"'melena de león'. Muy parecida a la barba de Abraham Lincoln."

#: lang/json/mutation_from_json.py
msgid "Facial hair: chin strap"
msgstr "Pelo facial: tira de mentón"

#. ~ Description for {'str': 'Facial hair: chin strap'}
#: lang/json/mutation_from_json.py
msgid ""
"You have beard along the jaw lines, circling the chin, and no moustache."
msgstr ""
"Tenés barba por la línea de la mandíbula, alrededor de la pera y sin bigote."

#: lang/json/mutation_from_json.py
msgid "Facial hair: beard"
msgstr "Pelo facial: barba"

#. ~ Description for {'str': 'Facial hair: beard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a moustache and a long beard, both formed by allowing free growth "
"of hair, with no particular styling."
msgstr ""
"Tenés bigote y barba larga, que crecen libres sin ningún estilo en "
"particular."

#: lang/json/mutation_from_json.py
msgid "Facial hair: handlebar moustache"
msgstr "Pelo facial: bigote manubrio"

#. ~ Description for {'str': 'Facial hair: handlebar moustache'}
#: lang/json/mutation_from_json.py
msgid "You have a moustache with long flared out ends."
msgstr "Tenés bigote con las puntas largas hacia arriba."

#: lang/json/mutation_from_json.py
msgid "Facial hair: neckbeard"
msgstr "Pelo facial: barba de cuello"

#. ~ Description for {'str': 'Facial hair: neckbeard'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a beard formed from hair grown on neck below the chin line.  No "
"moustache included."
msgstr ""
"Tenés barba formada por el pelo creciendo del cuello, debajo de la línea de "
"la mandíbula. No incluye bigote."

#: lang/json/mutation_from_json.py
msgid "Facial hair: pencil moustache"
msgstr "Pelo facial: bigote pincel"

#. ~ Description for {'str': 'Facial hair: pencil moustache'}
#: lang/json/mutation_from_json.py
msgid "You have a very thin moustache just above the line of the upper lip."
msgstr "Tenés bigote muy finito justo arriba de la línea del labio superior."

#: lang/json/mutation_from_json.py
msgid "Facial hair: shenandoah"
msgstr "Pelo facial: shenandoah"

#. ~ Description for {'str': 'Facial hair: shenandoah'}
#: lang/json/mutation_from_json.py
msgid ""
"Long full beard with no moustache, popular among Amish community, often with"
" two pointed ends."
msgstr ""
"Tenés barba larga sin bigote, popular en la comunidad amish, a veces con dos"
" puntas."

#: lang/json/mutation_from_json.py
msgid "Facial hair: sideburns"
msgstr "Pelo facial: patillas"

#. ~ Description for {'str': 'Facial hair: sideburns'}
#: lang/json/mutation_from_json.py
msgid ""
"You have patches of hair in front of your ears, that normally would connect "
"your hair with the beard, but they are here by themselves."
msgstr ""
"Tenés pedazos de pelo adelante de las orejas, que normalmente conectarían tu"
" pelo con la barba pero están ahí solos."

#: lang/json/mutation_from_json.py
msgid "Facial hair: soul patch"
msgstr "Pelo facial: mosca"

#. ~ Description for {'str': 'Facial hair: soul patch'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a little bit of hair in the dip under your lower lip, and no other "
"facial hair whatsoever."
msgstr "Tenés un pedacito de pelo debajo de tu labio inferior y nada más."

#: lang/json/mutation_from_json.py
msgid "Facial hair: toothbrush moustache"
msgstr "Pelo facial: bigote cepillo"

#. ~ Description for {'str': 'Facial hair: toothbrush moustache'}
#: lang/json/mutation_from_json.py
msgid ""
"Charlie Chaplin used to have this short patch of hair just under the nose, "
"but then that other guy used it as a characteristic, and it became "
"unwelcomed."
msgstr ""
"Charlie Chaplin usaba este tipo de pedacito de pelo justo debajo de la "
"nariz, pero después ese otro tipo lo usó como característica, y este bigote "
"ya no es bien recibido."

#: lang/json/mutation_from_json.py
msgid "Facial hair: Van Dyke"
msgstr "Pelo facial: Van Dyke"

#. ~ Description for {'str': 'Facial hair: Van Dyke'}
#: lang/json/mutation_from_json.py
msgid "You have handlebar moustache with a chin strip or a small goatee."
msgstr ""
"Tenés bigote manubrio con una línea en el mentón o un pequeño candado."

#: lang/json/mutation_from_json.py
msgid "Facial hair: walrus"
msgstr "Pelo facial: morsa"

#. ~ Description for {'str': 'Facial hair: walrus'}
#: lang/json/mutation_from_json.py
msgid ""
"You have long thick moustache, overshadowing you lips, that somewhat "
"resembles facial hair of a walrus."
msgstr ""
"Tenés bigote largo y grueso, que sobrepasa los labios y que de alguna manera"
" parece el pelo facial de una morsa."

#: lang/json/mutation_from_json.py
msgid "Facial hair: The Zappa"
msgstr "Pelo facial: El Zappa"

#. ~ Description for {'str': 'Facial hair: The Zappa'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a wide soul patch and a full moustache that extends a bit downwards"
" at the corners of your lips."
msgstr ""
"Tenés bigote mosca ancho que se extiende hacia abajo hasta los bordes de tus"
" labios."

#: lang/json/mutation_from_json.py
msgid "Fleet-Footed"
msgstr "Pies Ligeros"

#. ~ Description for {'str': 'Fleet-Footed'}
#. ~ Description for Fleet-Footed
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can move more quickly than most, resulting in a 15% speed bonus on sure "
"footing."
msgstr ""
"Podés moverte más rápido que la mayoría. Tenés un 15% de bonus sobre la "
"velocidad normal a pie."

#: lang/json/mutation_from_json.py
msgid "Reflex Photophore"
msgstr "Fotóforo Reflejo"

#. ~ Description for {'str': 'Reflex Photophore'}
#. ~ Description for {'str': 'Reflex Photophore (on)'}
#: lang/json/mutation_from_json.py
msgid ""
"A photophore has grown from your head.  You can't consciously control it, "
"and it might start to shine in response to your emotions or your "
"physiological state."
msgstr ""
"Un fotóforo ha crecido en tu cabeza. No podés controlarlo de manera "
"consciente y podría empezar a brillar en respuesta a tus emociones o tu "
"estado psicológico."

#: lang/json/mutation_from_json.py
msgid "Your photophore starts glowing."
msgstr "Tu fotóforo empieza a brillar."

#: lang/json/mutation_from_json.py
msgid "You're so happy, you're glowing!"
msgstr "¡Estás tan feliz que estás brillando!"

#: lang/json/mutation_from_json.py
msgid "You're feeling hungry; time to lure some prey!"
msgstr "Sentís hambre; ¡es momento de atraer alguna presa!"

#: lang/json/mutation_from_json.py
msgid "Reflex Photophore (on)"
msgstr "Fotóforo Reflejo (encendido)"

#: lang/json/mutation_from_json.py
msgid "Your photophore stops glowing."
msgstr "Tu fotóforo deja de brillar."

#: lang/json/mutation_from_json.py
msgid "Your glow fades."
msgstr "Tu brillo desaparece."

#: lang/json/mutation_from_json.py
msgid "Weak Photophore"
msgstr "Fotóforo Débil"

#. ~ Description for {'str': 'Weak Photophore'}
#: lang/json/mutation_from_json.py
msgid ""
"A photophore has grown from your head; you can make it glow softly.  This "
"will make you very visible in the dark, ideal for attracting a partner "
"during mating season."
msgstr ""
"Te ha crecido un fotóforo en la cabeza, lo podés hacer brillar suavemente. "
"Esto te hará muy visible en la oscuridad, ideal para atraer un compañero en "
"la temporada de apareamiento."

#: lang/json/mutation_from_json.py
msgid "Weak Photophore (on)"
msgstr "Fotóforo Débil (encendido)"

#. ~ Description for {'str': 'Weak Photophore (on)'}
#: lang/json/mutation_from_json.py
msgid "Your photophore is glowing softly."
msgstr "Tu fotóforo brilla suavemente."

#: lang/json/mutation_from_json.py
msgid "Photophore"
msgstr "Fotóforo"

#. ~ Description for {'str': 'Photophore'}
#: lang/json/mutation_from_json.py
msgid "You can make your photophore glow brightly."
msgstr "Podés hacer brillar fuertemente a tu fotóforo."

#: lang/json/mutation_from_json.py
msgid "Photophore (on)"
msgstr "Fotóforo (encendido)"

#. ~ Description for {'str': 'Photophore (on)'}
#: lang/json/mutation_from_json.py
msgid "You photophore is glowing brightly."
msgstr "Tu fotóforo brilla fuertemente."

#: lang/json/mutation_from_json.py
msgid "Normal Human"
msgstr "Humano Normal"

#. ~ Description for {'str': 'Normal Human'}
#: lang/json/mutation_from_json.py
msgid ""
"You're a normal human; there's nothing wrong with you.  No need to worry."
msgstr "Sos un humano normal, no tenés nada raro. No necesitás preocuparte."

#: lang/json/mutation_from_json.py
msgid "The anger overtakes you!"
msgstr "¡Te invade una ira incontrolable!"

#: lang/json/mutation_from_json.py
msgid "Everything is terrible and this makes you so ANGRY!"
msgstr "Todo es una porquería y ¡eso te pone MUY ENOJADO!"

#: lang/json/mutation_from_json.py
msgid "Violent Monster"
msgstr "Monstruo Violent"

#. ~ Description for {'str': 'Violent Monster'}
#: lang/json/mutation_from_json.py
msgid "Anger clouds your mind; you can't think straight, but you feel strong."
msgstr "La ira te nubla la mente, no podés pensar bien pero te sentís fuerte."

#: lang/json/mutation_from_json.py
msgid "The anger subsides."
msgstr "Tu ira sosega."

#: lang/json/mutation_from_json.py
msgid "As the morning comes, you return back to normal."
msgstr "Cuando llega la mañana, volvés a la normalidad."

#: lang/json/mutation_from_json.py
msgid "Good Hearing"
msgstr "Buen Oído"

#. ~ Description for {'str': 'Good Hearing'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr ""
"Tenés mejor oído que lo normal y podés oír sonidos distantes con mayor "
"facilidad."

#: lang/json/mutation_from_json.py
msgid "Fey Hearing"
msgstr "Oído Fey"

#. ~ Description for {'str': 'Fey Hearing'}
#: lang/json/mutation_from_json.py
msgid ""
"You're not sure the shape of your ears is helping you any; regardless, you "
"have become very sensitive to sounds."
msgstr ""
"No estás seguro si la forma de tus orejas te ayudan en algo, pero más allá "
"de eso te volviste muy sensible a los sonidos."

#: lang/json/mutation_from_json.py
msgid "Outdoorsman"
msgstr "Amante de la Naturaleza"

#. ~ Description for {'str': 'Outdoorsman'}
#: lang/json/mutation_from_json.py
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr ""
"Estás acostumbrado a estar al aire libre. Esto hace que sea menor la "
"penalidad a la moral por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Parkour Expert"
msgstr "Experto/a en Parkour"

#. ~ Description for {'str': 'Parkour Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"You're skilled at clearing obstacles; terrain like railings or counters are "
"as easy for you to move on as solid ground."
msgstr ""
"Tenés habilidad para franquear obstáculos. Cosas como pasamanos o mesadas "
"son tan fáciles de transitar para vos como el suelo mismo."

#: lang/json/mutation_from_json.py
msgid "Indefatigable"
msgstr "Infatigable"

#. ~ Description for {'str': 'Indefatigable'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to exercise and good diet, or due to a natural abundance of "
"physical endurance, you tire due to physical exertion much less readily than"
" others.  Your maximum stamina is 25% higher than usual."
msgstr ""
"Ya sea debido al ejercicio y la buena dieta, o debido a una abundancia de "
"resistencia, el esfuerzo físico te cansa mucho menos que a los demás. Tu "
"máxima resistencia es un 25% mayor que lo normal."

#: lang/json/mutation_from_json.py
msgid "Hyperactive"
msgstr "Hiperactividad"

#. ~ Description for {'str': 'Hyperactive'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body's efficiency is like that of a tiny furnace, increasing your "
"maximum stamina by 40%."
msgstr ""
"La eficacia de tu cuerpo es como la de un pequeño horno, incrementando tu "
"resistencia máxima en un 40%."

#: lang/json/mutation_from_json.py
msgid "Quick"
msgstr "Rapidez"

#. ~ Description for {'str': 'Quick'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr ""
"¡Sos más rápido/a para todo! Tenés un bonus del 10% a tus puntos de acción."

#. ~ Description for {'str': 'Optimist'}
#: lang/json/mutation_from_json.py
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, "
"and are generally happier than most people."
msgstr ""
"¡Nada te deprime! Saboreás los placeres de la vida, ignorás las "
"dificultades, y en general sos más feliz que la mayoría de la gente."

#: lang/json/mutation_from_json.py
msgid "Fast Healer"
msgstr "Sanación Veloz"

#. ~ Description for {'str': 'Fast Healer'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your wounds heal themselves quicker than usual.  You heal 50% faster whilst "
"asleep, and 20% faster whilst awake.  Your broken limbs also heal twice as "
"fast."
msgstr ""
"Tus heridas se curan solas más rápido de lo normal. Te curás 50% más rápido "
"mientras dormís y 20% más rápido cuando estás despierto. Tus miembros "
"fracturados también sanarán al doble de velocidad."

#: lang/json/mutation_from_json.py
msgid "Light Eater"
msgstr "Apetito Liviano"

#. ~ Description for {'str': 'Light Eater'}
#: lang/json/mutation_from_json.py
msgid ""
"Your metabolism is a little slower, and you require less food than most."
msgstr ""
"Tu metabolismo es un poco más lento y necesitás menos comida que la mayoría "
"de la gente."

#: lang/json/mutation_from_json.py
msgid "Accomplished Sleeper"
msgstr "Dormilón/a Consumado/a"

#. ~ Description for {'str': 'Accomplished Sleeper'}
#: lang/json/mutation_from_json.py
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr ""
"Siempre tuviste la capacidad de dormirte fácilmente, incluso cuando tenés "
"que dormir en circunstancias poco ideales."

#: lang/json/mutation_from_json.py
msgid "Practiced Sleeper"
msgstr "Dormilón/a Esperimentado/a"

#. ~ Description for {'str': 'Practiced Sleeper'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body's demanding energy needs mean you can fall asleep just about "
"anywhere."
msgstr ""
"La demanda de energía de tu cuerpo significa que podés dormirte en casi "
"cualquier lado."

#: lang/json/mutation_from_json.py
msgid "Pain Resistant"
msgstr "Resistencia al Dolor"

#. ~ Description for {'str': 'Pain Resistant'}
#: lang/json/mutation_from_json.py
msgid "You have a high tolerance for pain."
msgstr "Tenés una gran tolerancia al dolor."

#: lang/json/mutation_from_json.py
msgid "Night Vision"
msgstr "Visión Nocturna"

#. ~ Description for {'str': 'Night Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"You possess natural night vision, and can see further in the dark than most."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Tenés visión nocturna natural y podés ver un poco más de lo normal en la "
"oscuridad. Hay que activarlo para encender y apagar las áreas visibles por "
"Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Poison Resistant"
msgstr "Resistencia al Veneno"

#. ~ Description for {'str': 'Poison Resistant'}
#: lang/json/mutation_from_json.py
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr ""
"Tu sistema es bastante tolerante a los venenos y toxinas, y la mayoría te "
"afectará menos."

#: lang/json/mutation_from_json.py
msgid "Fast Reader"
msgstr "Lectura Veloz"

#. ~ Description for {'str': 'Fast Reader'}
#: lang/json/mutation_from_json.py
msgid ""
"You're a quick reader, and can get through books a lot faster than most."
msgstr ""
"Sos rápido/a para leer, podés terminar libros mucho más rápido que los "
"demás."

#: lang/json/mutation_from_json.py
msgid "Tough Feet"
msgstr "Pies Fuertes"

#. ~ Description for {'str': 'Tough Feet'}
#: lang/json/mutation_from_json.py
msgid ""
"The bottoms of your feet are tough, and you are accustomed to going "
"barefoot.  You receive no movement penalty for not wearing shoes."
msgstr ""
"Las plantas de tus pies son resistentes y estás acostumbrado a andar en "
"patas. Si no usás nada en los pies, no se te aplica ninguna penalidad."

#: lang/json/mutation_from_json.py
msgid "Tough"
msgstr "Dureza"

#. ~ Description for {'str': 'Tough'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr "¡Derrotarte cuesta mucho! Tenés un 20% de bonus a tus puntos de vida."

#: lang/json/mutation_from_json.py
msgid "Durable"
msgstr "Resistencia"

#. ~ Description for {'str': 'Durable'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr "¡Casi nada te hace mella! Tenés un 30% de bonus a tus puntos de vida."

#: lang/json/mutation_from_json.py
msgid "Unbreakable"
msgstr "Irrompible"

#. ~ Description for {'str': 'Unbreakable'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr "¡Nada te puede romper! Tenés un 40% de bonus a tus puntos de vida."

#: lang/json/mutation_from_json.py
msgid "Thick-Skinned"
msgstr "Piel Gruesa"

#. ~ Description for {'str': 'Thick-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is tough.  Cutting and bashing damage is slightly reduced for you."
"  There's a small chance you don't cut yourself on sharp terrain."
msgstr ""
"Tu piel es resistente. El daño cortante y golpeante es reducido levemente. "
"Hay una pequeña probabilidad de que no te cortes pasando por lugares "
"filosos."

#: lang/json/mutation_from_json.py
msgid "Packmule"
msgstr "Mula de Carga"

#. ~ Description for {'str': 'Packmule'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You pack things very efficiently!  You can retrieve things from containers "
"10% faster."
msgstr ""
"¡Guardás las cosas de manera muy eficiente! Podés sacar cosas de los "
"recipientes 10% más rápido."

#: lang/json/mutation_from_json.py
msgid "Strong Back"
msgstr "Espalda Fuerte"

#. ~ Description for {'str': 'Strong Back'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr ""
"Sos capaz de cargar mucho más que una persona con fuerza similar. Tu máxima "
"carga posible está incrementada en un 35%."

#: lang/json/mutation_from_json.py
msgid "Fast Learner"
msgstr "Aprendiz Veloz"

#. ~ Description for {'str': 'Fast Learner'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Tenés una mente flexible que te permite aprender habilidades mucho más "
"rápido que los demás. Esto solo se aplica para la experiencia práctica, no "
"para las habilidades aprendidas de libros y similares."

#: lang/json/mutation_from_json.py
msgid "Rigid Table Manners"
msgstr "Modales Rígidos"

#. ~ Description for {'str': 'Rigid Table Manners'}
#: lang/json/mutation_from_json.py
msgid ""
"You've been taught proper table manners from your early childhood on; now, "
"you can't even think about eating without being seated at a table and taking"
" your time.  Eating without a table and chair frustrates you, but eating "
"like a civilized person gives you a bigger morale bonus."
msgstr ""
"Te han enseñado cómo comportarte apropiadamente en la mesa desde tu niñez. "
"Ahora ni se te ocurre pensar en comer sin sentarte a una mesa y tomarte tu "
"tiempo para hacerlo. Comer sin esos cuidados te frustra, pero comer como una"
" persona civilizada te da un bonus mayor a tu moral."

#: lang/json/mutation_from_json.py
msgid "Strong Stomach"
msgstr "Estómago Fuerte"

#. ~ Description for {'str': 'Strong Stomach'}
#: lang/json/mutation_from_json.py
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up despite this, you won't suffer any residual nausea."
msgstr ""
"Sos menos propenso a vomitar por intoxicación con la comida, el alcohol, "
"etc. Si de todas maneras igual vomitás, no vas a sufrir de náuseas."

#: lang/json/mutation_from_json.py
msgid "Good Memory"
msgstr "Buena Memoria"

#. ~ Description for {'str': 'Good Memory'}
#: lang/json/mutation_from_json.py
msgid ""
"You have an exceptional memory, and find it easy to remember things.  Your "
"skills will erode slightly slower than usual, and you can remember more "
"terrain."
msgstr ""
"Tenés una memoria excepcional y te resulta fácil recordar cosas. Tus "
"habilidades se atrofiarán más despacio que lo normal, y podés recordar mejor"
" el terreno."

#: lang/json/mutation_from_json.py
msgid "Deft"
msgstr "Hábil"

#. ~ Description for {'str': 'Deft'}
#: lang/json/mutation_from_json.py
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr ""
"Aunque no sos mejor en el combate cuerpo a cuerpo, sos mejor para "
"recuperarte de un golpe errado, y podrás intentar otro golpe más rápido."

#: lang/json/mutation_from_json.py
msgid "Spiritual"
msgstr "Espiritual"

#. ~ Description for {'str': 'Spiritual'}
#: lang/json/mutation_from_json.py
msgid ""
"You've always felt that there is more to the world than we can see.  Whether"
" driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr ""
"Siempre sentiste que hay algo más en el mundo que lo que podemos ver. Ya sea"
" por creencias religiosas o intereses filosóficos, encontrás gran "
"inspiración en estudiar los textos sagrados y experimentar cosas místicas."

#: lang/json/mutation_from_json.py
msgid "Substance Tolerance"
msgstr "Tolerante a Sustancias"

#. ~ Description for {'str': 'Substance Tolerance'}
#: lang/json/mutation_from_json.py
msgid ""
"You can handle intoxicants well.  Their effects clear up more quickly for "
"you."
msgstr ""
"Podés manejar bien las intoxicaciones. Sus efectos se van a ir más rápido."

#: lang/json/mutation_from_json.py
msgid "Gourmand"
msgstr "Gourmet"

#. ~ Description for {'str': 'Gourmand'}
#: lang/json/mutation_from_json.py
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also "
"enjoy food more; delicious food is better for your morale, and you don't "
"mind unsavory meals as much.  Activate to skip prompt for overeating."
msgstr ""
"¡Comés más rápido, y podés comer y tomar más que los demás! También "
"disfrutás más de la comida. La comida deliciosa mejora tu moral y no te "
"molesta tanto la comida fea. Activalo para omitir el aviso por comer en "
"exceso."

#: lang/json/mutation_from_json.py
msgid "Bookworm"
msgstr "Cufa"

#. ~ Description for {'str': 'Bookworm'}
#: lang/json/mutation_from_json.py
msgid ""
"There's nothing quite like the smell of a good book!  Books are more fun (or"
" less boring) for you!"
msgstr ""
"¡No hay nada comparable con el olor de un buen libro! ¡Los libros te "
"resultan más divertidos (o menos aburridos)!"

#: lang/json/mutation_from_json.py
msgid "Addiction Resistant"
msgstr "Resistencia a Adicciones"

#. ~ Description for {'str': 'Addiction Resistant'}
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr ""
"Ya sea por una vida de revelación o por simple fuerza de voluntad, es más "
"difícil para vos hacerte adicto a una sustancia, y te resulta más fácil "
"salir de las adicciones."

#: lang/json/mutation_from_json.py
msgid "Animal Empathy"
msgstr "Empatía Animal"

#. ~ Description for {'str': 'Animal Empathy'}
#: lang/json/mutation_from_json.py
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are"
" less likely to attack.  This only applies to natural animals such as "
"woodland creatures."
msgstr ""
"Los animales pacíficos no se escaparán cuando te vean, e incluso los "
"animales agresivos te atacarán menos. Esto solo se aplica a los animales "
"naturales como las criaturas del bosque."

#: lang/json/mutation_from_json.py
msgid "Animal Kinship"
msgstr "Parentesco Animal"

#. ~ Description for {'str': 'Animal Kinship'}
#: lang/json/mutation_from_json.py
msgid ""
"Something about your presence is calming to animals, and they will treat you"
" with innate trust.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Algo de tu presencia calma a los animales, y te tratarán con confianza "
"innata. Esto solo se aplica a los animales naturales como las criaturas del "
"bosque."

#: lang/json/mutation_from_json.py
msgid "Terrifying"
msgstr "Aterrador/a"

#. ~ Description for {'str': 'Terrifying'}
#: lang/json/mutation_from_json.py
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr ""
"Hay algo en vos que causa terror. Las criaturas tienden a escaparse cuando "
"te ven."

#: lang/json/mutation_from_json.py
msgid "Disease Resistant"
msgstr "Resistencia a Enfermedades"

#. ~ Description for {'str': 'Disease Resistant'}
#: lang/json/mutation_from_json.py
msgid ""
"It's very unlikely that you will catch ambient diseases like the cold or "
"flu."
msgstr ""
"Es muy raro que te agarres una enfermedad ambiental como un resfrío o gripe."

#: lang/json/mutation_from_json.py
msgid "High Adrenaline"
msgstr "Alta Adrenalina"

#. ~ Description for {'str': 'High Adrenaline'}
#: lang/json/mutation_from_json.py
msgid ""
"If you are in a very dangerous situation, you may experience a temporary "
"rush which increases your speed and strength significantly."
msgstr ""
"Si te encontrás en una situación muy peligrosa, podés experimentar un "
"empujón temporal que incrementa significativamente tu velocidad y tu fuerza."

#: lang/json/mutation_from_json.py
msgid "Less Sleep"
msgstr "Menos Sueño"

#. ~ Description for {'str': 'Less Sleep'}
#: lang/json/mutation_from_json.py
msgid "You need less sleep than the average person."
msgstr "Necesitás dormir menos que una persona normal."

#: lang/json/mutation_from_json.py
msgid "Self-Aware"
msgstr "Consciente de Sí Mismo/a"

#. ~ Description for {'str': 'Self-Aware'}
#: lang/json/mutation_from_json.py
msgid ""
"You get to see your exact amount of HP remaining and health, instead of "
"having only a vague idea of whether you're in good condition or not."
msgstr ""
"Podés ver la cantidad exacta de PV que tenés y tu salud, en lugar de solo "
"tener una vaga idea de si estás en buena condición o no."

#: lang/json/mutation_from_json.py
msgid "Masochist"
msgstr "Masoquista"

#. ~ Description for {'str': 'Masochist'}
#: lang/json/mutation_from_json.py
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr ""
"Aunque igual vas a sufrir las penalidades por el dolor, a la vez vas a "
"sentir placer."

#: lang/json/mutation_from_json.py
msgid "Stimulant Psychosis"
msgstr "Psicosis con Estimulantes"

#. ~ Description for {'str': 'Stimulant Psychosis'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a unique history with stimulants (like coffee or amphetamines).  "
"You can tolerate a lot more of them without overdosing, but if you indulge "
"too much, you start seeing things…"
msgstr ""
"Tenés una historia única con los estimulantes (como el café o las "
"anfetaminas). Tolerás mucho más sin llegar a la sobredosis, pero si te "
"entregás demasiado, empezás a ver cosas…"

#. ~ Description for {'str': 'Stylish'}
#: lang/json/mutation_from_json.py
msgid ""
"Practicality is far less important than style.  Your morale is improved by "
"wearing fashionable and attractive clothing."
msgstr ""
"La funcionalidad es mucho menos importante que el estilo. Tu moral mejora "
"cuando vestís ropas fascinantes y de moda."

#: lang/json/mutation_from_json.py
msgid "Light Step"
msgstr "Paso Liviano"

#. ~ Description for {'str': 'Light Step'}
#: lang/json/mutation_from_json.py
msgid ""
"You make less noise while walking.  You're also less likely to set off "
"traps."
msgstr ""
"Hacés menos ruido cuando caminás. También sos menos propenso a caer en "
"trampas."

#: lang/json/mutation_from_json.py
msgid "Robust Genetics"
msgstr "Genética Robusta"

#. ~ Description for {'str': 'Robust Genetics'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a very strong genetic base.  If you mutate, the odds that the "
"mutation will be beneficial are greatly increased."
msgstr ""
"Tenés una base genética muy fuerte. Si sufrís una mutación, son mucho "
"mayores las posibilidades de que sea una beneficiosa."

#: lang/json/mutation_from_json.py
msgid "Scout"
msgstr "Exploración"

#. ~ Description for {'str': 'Scout'}
#: lang/json/mutation_from_json.py
msgid ""
"You're an excellent navigator and your ability to recognize distant "
"landmarks is unmatched.  Your sight radius on the overmap extends beyond the"
" normal range."
msgstr ""
"Sos un excelente explorador y tu habilidad para reconocer puntos de "
"referencia distantes no tiene comparación. Tu radio de visión en el mapa "
"general se extiende más allá del rango normal."

#: lang/json/mutation_from_json.py
msgid "Topographagnosia"
msgstr "Topografagnosia"

#. ~ Description for {'str': 'Topographagnosia'}
#: lang/json/mutation_from_json.py
msgid ""
"Focal brain damage has rendered you incapable of recognizing landmarks and "
"orienting yourself in your surroundings, severely crippling your sight "
"radius on the overmap."
msgstr ""
"Una lesión cerebral focal te ha dejado incapaz de reconocer puntos de "
"referencia en el terreno y de orientarte, lo que incapacita severamente tu "
"radio de visión en el mapa."

#: lang/json/mutation_from_json.py
msgid "Cannibal"
msgstr "Caníbal"

#. ~ Description for {'str': 'Cannibal'}
#: lang/json/mutation_from_json.py
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr ""
"Toda tu vida te han prohibido satisfacer tus particulares gustos. Ahora que "
"el mundo se terminó, ya nadie podrá venir a decirte que no te podés comer "
"una persona."

#: lang/json/mutation_from_json.py
msgid "Strict Humanitarian"
msgstr "Humanitario Estricto"

#. ~ Description for {'str': 'Strict Humanitarian'}
#: lang/json/mutation_from_json.py
msgid ""
"You're convinced that these things that look vaguely human from elsewhere "
"are definitely not people.  Therefore it's okay to eat them, right?"
msgstr ""
"Estás convencido de que estas cosas que se parecen vagamente a un ser humano"
" de otro mundo, definitivamente no son personas. Por lo tanto, está bien "
"comérselos, ¿no?"

#: lang/json/mutation_from_json.py
msgid "Psychopath"
msgstr "Psicópata"

#. ~ Description for {'str': 'Psychopath'}
#: lang/json/mutation_from_json.py
msgid ""
"You don't experience guilt like others do.  Even when you know your actions "
"are wrong, you just don't care."
msgstr ""
"No experimentás la culpa de la misma manera que lo hacen los demás. Incluso "
"cuando sabés que tus acciones están mal, simplemente no te importa."

#: lang/json/mutation_from_json.py
msgid "Killer Drive"
msgstr "Impulso Asesino"

#. ~ Description for {'str': 'Killer Drive'}
#: lang/json/mutation_from_json.py
msgid ""
"You derive enjoyment from killing things.  Putting end to life seem to spark"
" some dark satisfaction and thrill, and you crave it every moment."
msgstr ""
"Obtenés placer por matar cosas. Ponerle un fin a la vida parece encender "
"alguna satisfacción y emoción oscuras, y lo deseás en todo momento."

#: lang/json/mutation_from_json.py
msgid "Martial Arts Training"
msgstr "Artes Marciales"

#. ~ Description for {'str': 'Martial Arts Training'}
#: lang/json/mutation_from_json.py
msgid ""
"You have received some martial arts training at a local dojo.  You start "
"with your choice of Karate, Judo, Aikido, Tai Chi, Taekwondo, or Pankration."
msgstr ""
"Recibiste entrenamiento en algún arte marcial en tu dojo local. Empezás con "
"uno de estos estilos a elección: Karate, Judo, Aikido, Tai Chi, Taekwondo o "
"Pancracio."

#: lang/json/mutation_from_json.py
msgid "Self-Defense Classes"
msgstr "Defensa Personal"

#. ~ Description for {'str': 'Self-Defense Classes'}
#: lang/json/mutation_from_json.py
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Capoeira, Krav Maga, Muay Thai, Ninjutsu, Wing Chun, or Zui "
"Quan."
msgstr ""
"Has recibido clases de defensa personal en un gimnasio de tu barrio. Empezás"
" con uno de estos estilos a elección: Capoeira, Krav Maga, Muay Thai, "
"Ninjutsu, Wing Chun o Zui Quan."

#: lang/json/mutation_from_json.py
msgid "Shaolin Adept"
msgstr "Experto/a Shaolin"

#. ~ Description for {'str': 'Shaolin Adept'}
#: lang/json/mutation_from_json.py
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr ""
"Has estudiado las artes de los monjes Shaolin. Empezás con uno de estos "
"estilos de lucha a elección: Tigre, Grulla, Leopardo, Serpiente o Dragón."

#: lang/json/mutation_from_json.py
msgid "Melee Weapon Training"
msgstr "Armas Cuerpo a cuerpo"

#. ~ Description for {'str': 'Melee Weapon Training'}
#: lang/json/mutation_from_json.py
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Eskrima, Fencing, Fior Di Battaglia, Medieval Swordsmanship, Niten Ichi-Ryu,"
" Pentjak Silat, or Sōjutsu."
msgstr ""
"Has practicado luchar con armas. Empezás eligiendo una de estas prácticas: "
"Eskrima, Esgrima, Fior Di Battaglia, Espadeo Medieval, Niten Ichi-Ryu, "
"Pencak Silat o Sōjutsu."

#: lang/json/mutation_from_json.py
msgid "Competitive Fencer"
msgstr "Esgrimista de Competición"

#. ~ Description for {'str': 'Competitive Fencer'}
#: lang/json/mutation_from_json.py
msgid ""
"You were an avid fencer, starting with foil and moving onto saber, then "
"épée.  You competed nationally and dabbled with some of the historical "
"fencing weapons afforded by HEMA's popularity."
msgstr ""
"Eras un esgrimista ávido, comenzaste con el florete, pasaste por el sable y "
"llegaste al épée. Participaste en competiciones nacionales e incursionaste "
"en armas históricas de esgrima gracias a la popularidad de HEMA."

#: lang/json/mutation_from_json.py
msgid "Weak Scent"
msgstr "Poco Olor"

#. ~ Description for {'str': 'Weak Scent'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with "
"more difficulty."
msgstr ""
"Tu olor es bastante débil. A los animales que te rastrean por tu olor se les"
" hará más difícil hacerlo."

#: lang/json/mutation_from_json.py
msgid "Skilled Liar"
msgstr "Mentiroso/a Hábil"

#. ~ Description for {'str': 'Skilled Liar'}
#: lang/json/mutation_from_json.py
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr ""
"No tenés ningún escrúpulo en tergiversar la verdad y sin que se note. Decir "
"mentiras y otros engaños es mucho más fácil para vos."

#: lang/json/mutation_from_json.py
msgid "Weight: XS"
msgstr "Peso: XS"

#. ~ Description for {'str': 'Weight: XS'}
#: lang/json/mutation_from_json.py
msgid ""
"You lost an awful lot of weight before the Cataclysm.  Whatever the reason, "
"now that food is not always close at hand, your skeletal figure presents an "
"additional danger.  You need to gain weight or die trying."
msgstr ""
"Perdiste muchísimo peso antes del Cataclismo. Cualquiera sea la razón, ahora"
" que no tenés siempre comida a mano, tu figura esquelética representa un "
"peligro adicional. Vas a tener que ganar peso o morir intentándolo."

#: lang/json/mutation_from_json.py
msgid "Weight: XXXL"
msgstr "Peso: XXXL"

#. ~ Description for {'str': 'Weight: XXXL'}
#: lang/json/mutation_from_json.py
msgid ""
"You gained an awful lot of weight before the Cataclysm.  Whatever the "
"reason, now that mobility is key to survival, your bloated figure presents "
"an additional danger.  You need to lose weight or die trying."
msgstr ""
"Ganaste muchísimo peso antes del Cataclismo. Cualquiera sea la razón, ahora "
"que la movilidad es clave para la supervivencia tu figura hinchada "
"representa un peligro adicional. Vas a tener que empezar a perder peso o "
"morir intentándolo."

#: lang/json/mutation_from_json.py
msgid "Pretty"
msgstr "Lindura"

#. ~ Description for {'str': 'Pretty'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a sight to behold.  People who care about such things will react "
"more kindly to you."
msgstr ""
"Sos una belleza admirable. Las personas que se interesen en las apariencias,"
" serán más amables con vos."

#: lang/json/mutation_from_json.py
msgid "Bad Knees"
msgstr "Malas Rodillas"

#. ~ Description for {'str': 'Bad Knees'}
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Ya sea por una lesión o por la edad, tus rodillas no son particularmente "
"fuertes ni flexibles. Atravesar terreno duro te hace más lento, más que lo "
"normal."

#: lang/json/mutation_from_json.py
msgid "Languorous"
msgstr "Languidez"

#. ~ Description for {'str': 'Languorous'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural lack of "
"physical endurance, you tire from physical exertion much more readily than "
"others.  Your maximum stamina is 25% lower than usual."
msgstr ""
"Ya sea por falta de ejercicio y mala alimentación, o debido a tu falta de "
"resistencia, el esfuerzo físico te cansa mucho más que a los demás. Tu "
"máxima resistencia es un 25% menor de lo normal."

#: lang/json/mutation_from_json.py
msgid "Near-Sighted"
msgstr "Miopía"

#. ~ Description for {'str': 'Near-Sighted'}
#: lang/json/mutation_from_json.py
msgid ""
"Without glasses, your seeing radius is severely reduced!  However, you are "
"guaranteed to start with a pair of glasses."
msgstr ""
"Sin tus anteojos ¡tu rango de visión se reduce severamente! Sin embargo, "
"empezás con un par."

#: lang/json/mutation_from_json.py
msgid "Slow Healer"
msgstr "Sanación Lenta"

#. ~ Description for {'str': 'Slow Healer'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your wounds heal a little slower than most.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 75% of the regular rate."
msgstr ""
"Tus heridas se curan un poco más despacio que lo normal. Tus PV mientras "
"dormís y tus miembros fracturados se curarán a un 75% de la velocidad "
"normal."

#: lang/json/mutation_from_json.py
msgid "Poor Healer"
msgstr "Poca Sanación"

#. ~ Description for {'str': 'Poor Healer'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your health recovery is severely impaired.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 33% of the regular rate."
msgstr ""
"Tu recuperación de salud está severamente dificultada. Tus PV mientras "
"dormís y tus miembros fracturados se curarán a un 33% de la velocidad "
"normal."

#: lang/json/mutation_from_json.py
msgid "Imperceptive Healer"
msgstr "Sanación Imperceptiva"

#. ~ Description for {'str': 'Imperceptive Healer'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Wounds are incredibly dangerous to you, as they barely heal at all.  Your HP"
" whilst asleep, as well as your broken limbs, heal at 10% of the regular "
"rate."
msgstr ""
"Las heridas son increíblemente peligrosas para vos, ya que apenas si se "
"curan. Tus PV mientras dormís y tus miembros fracturados se curarán a un 10%"
" de la velocidad normal."

#: lang/json/mutation_from_json.py
msgid "Far-Sighted"
msgstr "Hipermetropía"

#. ~ Description for {'str': 'Far-Sighted'}
#: lang/json/mutation_from_json.py
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties"
" on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr ""
"Sin tus anteojos sos incapaz de leer y recibís penalidades a tu puntería en "
"el cuerpo a cuerpo y en la fabricación de electrónicos y en sastrería. Pero "
"empezás con un par de anteojos para leer."

#: lang/json/mutation_from_json.py
msgid "Heavy Sleeper"
msgstr "Sueño pesado"

#. ~ Description for {'str': 'Heavy Sleeper'}
#: lang/json/mutation_from_json.py
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr ""
"Sos uno de esos que tienen el sueño pesado. Los ruidos no te van a despertar"
" fácilmente."

#: lang/json/mutation_from_json.py
msgid "Sleepy"
msgstr "Somnolencia"

#. ~ Description for {'str': 'Sleepy'}
#: lang/json/mutation_from_json.py
msgid "You need sleep more often, but still spend most of your time awake."
msgstr ""
"Necesitás dormir más seguido, pero igual pasás la mayor parte del tiempo "
"despierto."

#: lang/json/mutation_from_json.py
msgid "Asthmatic"
msgstr "Asma"

#. ~ Description for {'str': 'Asthmatic'}
#: lang/json/mutation_from_json.py
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical"
" limitations.  However, you are guaranteed to start with an inhaler."
msgstr ""
"Ocasionalmente, necesitarás utilizar un inhalador o sino sufrirás severas "
"limitaciones físicas. Pero empezás con un inhalador."

#: lang/json/mutation_from_json.py
msgid "Bad Back"
msgstr "Espalda Mala"

#. ~ Description for {'str': 'Bad Back'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You simply cannot carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr ""
"Simplemente, no podés cargar tanto como otras personas de fuerza similar. Tu"
" máxima carga posible está reducida en un 35%."

#: lang/json/mutation_from_json.py
msgid "Bad Temper"
msgstr "Mal Humor"

#. ~ Description for {'str': 'Bad Temper'}
#: lang/json/mutation_from_json.py
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes "
"some doing to cheer you up."
msgstr ""
"Las cosas siempre te ponen mal. Tenés una tendencia a estar triste, y te "
"cuesta bastante levantar el ánimo."

#: lang/json/mutation_from_json.py
msgid "Disorganized"
msgstr "Desorganización"

#. ~ Description for {'str': 'Disorganized'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are terrible at organizing and storing your possessions.  You retrieve "
"things from containers 10% slower."
msgstr ""
"Sos horrible para organizar y guardar tus posesiones. Sacás las cosas de los"
" recipientes un 10% más despacio."

#: lang/json/mutation_from_json.py
msgid "Illiterate"
msgstr "Analfabetismo"

#. ~ Description for {'str': 'Illiterate'}
#: lang/json/mutation_from_json.py
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr ""
"¡Nunca aprendiste a leer! Los libros y las computadoras están fuera de tus "
"posibilidades."

#: lang/json/mutation_from_json.py
msgid "Poor Hearing"
msgstr "Mal Oído"

#. ~ Description for {'str': 'Poor Hearing'}
#: lang/json/mutation_from_json.py
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr "Tu oído es malo, y no vas a escuchar los ruidos leves o distantes."

#. ~ Description for {'str': 'Deaf'}
#: lang/json/mutation_from_json.py
msgid ""
"You're not able to hear anything, and as such you're not able to talk to "
"NPCs."
msgstr ""
"No sos capaz de escuchar nada, y por lo tanto no vas a poder hablar con PNJ."

#: lang/json/mutation_from_json.py
msgid "Slow Learner"
msgstr "Aprendiz Lento/a"

#. ~ Description for {'str': 'Slow Learner'}
#: lang/json/mutation_from_json.py
msgid ""
"You are slow to grasp new ideas, and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Sos lento para incorporar nuevas ideas y entonces aprendés las cosas con más"
" lentitud que los demás. Esto solo se aplica para la experiencia práctica, "
"no para las habilidades aprendidas de libros y similares."

#: lang/json/mutation_from_json.py
msgid "Insomniac"
msgstr "Insomne"

#. ~ Description for {'str': 'Insomniac'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time falling asleep, even under the best circumstances!"
msgstr ""
"Te cuesta mucho dormirte, ¡incluso cuando las condiciones son perfectas!"

#: lang/json/mutation_from_json.py
msgid "Meat Intolerance"
msgstr "Intolerante a la Carne"

#. ~ Description for {'str': 'Meat Intolerance'}
#. ~ Description for Herbivorous Ancestry
#: lang/json/mutation_from_json.py
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but "
"you will suffer morale penalties and obtain less nutrition from it."
msgstr ""
"Tenés problemas para comer carne. La podés comer igual, pero vas a sufrir "
"penalidades a tu moral y recibir menos nutrición de ella."

#: lang/json/mutation_from_json.py
msgid "Thin-Skinned"
msgstr "Piel Finita"

#. ~ Description for {'str': 'Thin-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is fragile.  Cutting and bashing damage is slightly increased for "
"you."
msgstr ""
"Tu piel es frágil. El daño cortante y golpeante que sufrís se incrementa "
"levemente."

#: lang/json/mutation_from_json.py
msgid "Hates Vegetables"
msgstr "Odiás las Verduras"

#. ~ Description for {'str': 'Hates Vegetables'}
#: lang/json/mutation_from_json.py
msgid ""
"You have problems with eating vegetables.  It's possible for you to eat "
"them, but you will suffer morale penalties and obtain less nutrition from "
"them."
msgstr ""
"Tenés problemas para comer verduras. Las podés comer igual, pero vas a "
"sufrir penalidades a tu moral y recibir menos nutrición de ellas."

#: lang/json/mutation_from_json.py
msgid "Hates Books"
msgstr "Odiás los Libros"

#. ~ Description for {'str': 'Hates Books'}
#: lang/json/mutation_from_json.py
msgid ""
"Reading is for nerds!  Boring books are more boring, and you can't have fun "
"by reading books."
msgstr ""
"¡La lectura es para los nerds! Los aburridos libros son muy aburridos, y no "
"podés divertirte leyendo libros."

#: lang/json/mutation_from_json.py
msgid "Hates Fruit"
msgstr "Odiás las Frutas"

#. ~ Description for {'str': 'Hates Fruit'}
#: lang/json/mutation_from_json.py
msgid ""
"You despise eating fruits.  It's possible for you to eat them, but you will "
"suffer morale penalties and obtain less nutrition from them."
msgstr ""
"Despreciás comer frutas. Las podés comer, pero vas a sufrir penalidades a tu"
" moral y recibir menos nutrición de ellas."

#. ~ Description for {'str': 'Lactose Intolerance'}
#: lang/json/mutation_from_json.py
msgid ""
"You, like 75 percent of the world, cannot tolerate milk or milk based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties and obtain less nutrition from them."
msgstr ""
"Vos, como el 75 por ciento de la humanidad, no tolerás la leche o los "
"productos lácteos. Podés consumirlos, pero vas a sufrir penalidades a tu "
"moral y recibir menos nutrición de ella."

#: lang/json/mutation_from_json.py
msgid "Junkfood Intolerance"
msgstr "Intolerante a la Comida Chatarra"

#. ~ Description for {'str': 'Junkfood Intolerance'}
#: lang/json/mutation_from_json.py
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties and "
"obtain less nutrition from them."
msgstr ""
"Algo de esa comida excesivamente procesada, no se lleva bien con vos. Podés "
"comerla igual, pero vas a sufrir penalidades a tu moral y recibir menos "
"nutrición de ella."

#: lang/json/mutation_from_json.py
msgid "Grain Intolerance"
msgstr "Intolerante a los Granos"

#. ~ Description for {'str': 'Grain Intolerance'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a rare allergy that prevents you from eating wheat.  It's possible "
"for you to eat wheat-based products, but you will suffer morale penalties "
"and obtain less nutrition from them."
msgstr ""
"Tenés una rara alergia que te impide comer trigo. Igual podés consumir "
"productos con trigo pero vas a sufrir penalidades a tu moral y recibir menos"
" nutrición de ellos."

#: lang/json/mutation_from_json.py
msgid "Sweet Tooth"
msgstr "Goloso/a"

#. ~ Description for {'str': 'Sweet Tooth'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a soft spot for processed foods, and gain a morale bonus from "
"eating them."
msgstr ""
"Tenés debilidad por la comida procesada, y recibís un bonus a la moral al "
"comerla."

#: lang/json/mutation_from_json.py
msgid "Sugar-Loving"
msgstr "Amante de la Azúcar"

#. ~ Description for {'str': 'Sugar-Loving'}
#: lang/json/mutation_from_json.py
msgid ""
"You *adore* the taste of junk food, and find it preferable to everything "
"else!"
msgstr ""
"*Adorás* el sabor de la comida chatarra, ¡y la preferís a cualquier otra "
"comida!"

#: lang/json/mutation_from_json.py
msgid "Glass Jaw"
msgstr "Mandíbula de Cristal"

#. ~ Description for {'str': 'Glass Jaw'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual."
msgstr ""
"Tu cabeza no puede soportar demasiados golpes. Tus máximos PV de esa parte "
"de tu cuerpo es un 20% menos que lo normal."

#: lang/json/mutation_from_json.py
msgid "Forgetful"
msgstr "Olvidadizo/a"

#. ~ Description for {'str': 'Forgetful'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual, and you can remember less terrain."
msgstr ""
"Te cuesta mucho recordar las cosas. Tus habilidades se atrofiarán más rápido"
" que lo normal, y sos malo recordando el terreno."

#: lang/json/mutation_from_json.py
msgid "Lightweight"
msgstr "Flojito/a"

#. ~ Description for {'str': 'Lightweight'}
#: lang/json/mutation_from_json.py
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects"
" of these for longer."
msgstr ""
"Las drogas y el alcohol se te van derechito a la cabeza. Sufrís los efectos "
"negativos de estas cosas por más tiempo."

#: lang/json/mutation_from_json.py
msgid "Addictive Personality"
msgstr "Personalidad Adictiva"

#. ~ Description for {'str': 'Addictive Personality'}
#: lang/json/mutation_from_json.py
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr ""
"Es más fácil para vos volverte adicto a las sustancias, y más difícil "
"deshacerte de esas adicciones."

#: lang/json/mutation_from_json.py
msgid "Trigger Happy"
msgstr "Gatillo Fácil"

#. ~ Description for {'str': 'Trigger Happy'}
#: lang/json/mutation_from_json.py
msgid ""
"Unimplemented.  To be removed after 0.F. to preserve save compatibility."
msgstr ""
"Sin implementar. Para ser borrado después de la compatibilidad de partidas "
"guardadas de 0.F."

#: lang/json/mutation_from_json.py
msgid "Strong Scent"
msgstr "Mucho Olor"

#. ~ Description for {'str': 'Strong Scent'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but "
"animals that track your scent will do so more easily."
msgstr ""
"Tu olor es bastante fuerte. No es ofensivo para los otros humanos, pero a "
"los animales que te rastrean por tu olor se les hará más fácil."

#: lang/json/mutation_from_json.py
msgid "Chemical Imbalance"
msgstr "Desequilibrio Químico"

#. ~ Description for {'str': 'Chemical Imbalance'}
#: lang/json/mutation_from_json.py
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr ""
"Sufrís un pequeño desequilibrio químico, ya sea mental o físico. Los "
"pequeños cambios en tu química interior se manifestarán ocasionalmente, como"
" el hambre, el sueño, los efectos narcóticos, etc."

#: lang/json/mutation_from_json.py
msgid "Animal Discord"
msgstr "Antipatía Animal"

#. ~ Description for {'str': 'Animal Discord'}
#: lang/json/mutation_from_json.py
msgid ""
"Most animals don't like you, and aggressive animals are more likely to "
"attack you.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Le caés mal a la mayoría de los animales, y los que son agresivos serán más "
"propensos a atacarte. Esto solo se aplica a los animales naturales como las "
"criaturas del bosque."

#: lang/json/mutation_from_json.py
msgid "Prey Animal"
msgstr "Presa"

#. ~ Description for {'str': 'Prey Animal'}
#: lang/json/mutation_from_json.py
msgid ""
"Natural animals like dogs and wolves see you as prey, and are liable to "
"attack you on sight."
msgstr ""
"Los animales naturales como los perros y los lobos te ven como una presa, y "
"son más propensos a atacarte a simple vista."

#: lang/json/mutation_from_json.py
msgid "Slow Reader"
msgstr "Lectura Lenta"

#. ~ Description for {'str': 'Slow Reader'}
#: lang/json/mutation_from_json.py
msgid ""
"You're a slow reader, and it takes you longer to get through books than "
"most."
msgstr ""
"Sos lento para leer, te lleva más tiempo que a los demás terminar un libro."

#: lang/json/mutation_from_json.py
msgid "Kaluptic Psychosis"
msgstr "Psicosis Kalúptica"

#. ~ Description for {'str': 'Kaluptic Psychosis'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since the sky first broke, you have felt unwell, your head split by "
"alien thoughts.  You will periodically suffer from delusions, ranging from "
"minor effects to full visual hallucinations.  Some of these effects may be "
"controlled through the use of antipsychotics."
msgstr ""
"Desde la primera vez que el cielo se rompió te sentiste mal, la cabeza se te"
" partía con pensamientos extraterrestres. Sufrirás alucinaciones "
"periódicamente, que van desde efectos leves hasta alucinaciones visuales "
"completas. Algunos de estos efectos pueden ser controlados con el uso de "
"antipsicóticos."

#: lang/json/mutation_from_json.py
msgid "Narcoleptic"
msgstr "Narcolepsia"

#. ~ Description for {'str': 'Narcoleptic'}
#: lang/json/mutation_from_json.py
msgid "You randomly fall asleep without any reason."
msgstr "Sin razón alguna, a veces te quedás dormido."

#: lang/json/mutation_from_json.py
msgid "Clumsy"
msgstr "Torpe"

#. ~ Description for {'str': 'Clumsy'}
#. ~ Description for {'str': 'Giant Step'}
#: lang/json/mutation_from_json.py
msgid ""
"You make more noise while walking.  You're also more likely to set off "
"traps."
msgstr ""
"Hacés más ruido cuando caminás. También sos más propenso a caer en trampas."

#: lang/json/mutation_from_json.py
msgid "Jittery"
msgstr "Tembleque"

#. ~ Description for {'str': 'Jittery'}
#: lang/json/mutation_from_json.py
msgid ""
"When very hungry or under the effects of stimulants, you may find your hands"
" shaking uncontrollably, severely reducing your Dexterity."
msgstr ""
"Cuando tengas mucha hambre o estés bajo los efectos de estimulantes, vas a "
"ver que tus manos tiemblan incontrolablemente, lo que reduce severamente tu "
"Destreza."

#. ~ Description for {'str': 'Hoarder'}
#: lang/json/mutation_from_json.py
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored)."
"  Xanax can help control this anxiety."
msgstr ""
"No te vas a sentir bien a menos que estés cargando tanto como puedas. Sufrís"
" penalidades a la moral si cargás menos del máximo volumen que podés llevar "
"(el peso no importa). El Xanax te puede ayudar a controlar esta ansiedad."

#: lang/json/mutation_from_json.py
msgid "Savant"
msgstr "Erudición"

#. ~ Description for {'str': 'Savant'}
#: lang/json/mutation_from_json.py
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr ""
"Te especializás en una habilidad y sos peor en todas las demás. Avanzás a "
"media velocidad en todas excepto en la mejor que tengas. Combinado con "
"Aprendiz Rápido resulta en un aprendizaje más lento para todas las "
"habilidades."

#. ~ Description for {'str': 'Pacifist'}
#: lang/json/mutation_from_json.py
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr ""
"No te gusta pensar en la violencia. Tus habilidades de combate avanzan mucho"
" más lento que lo normal, y te sentís más culpable cuando matás."

#: lang/json/mutation_from_json.py
msgid "Mood Swings"
msgstr "Cambios de Humor"

#. ~ Description for {'str': 'Mood Swings'}
#: lang/json/mutation_from_json.py
msgid "Your morale will shift up and down at random, often dramatically."
msgstr "Tu moral sube y baja al azar, a veces dramáticamente. "

#: lang/json/mutation_from_json.py
msgid "Slow Footed"
msgstr "Pies Lentos"

#. ~ Description for {'str': 'Slow Footed'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr ""
"No te podés mover tan rápido como los demás. Tenés una penalidad de 15% en "
"suelo plano."

#: lang/json/mutation_from_json.py
msgid "Weak Stomach"
msgstr "Estómago Flojo"

#. ~ Description for {'str': 'Weak Stomach'}
#: lang/json/mutation_from_json.py
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr ""
"Sos más propenso a vomitar por intoxicación con la comida, el alcohol, etc."

#: lang/json/mutation_from_json.py
msgid "Wool Allergy"
msgstr "Alergia a la Lana"

#. ~ Description for {'str': 'Wool Allergy'}
#: lang/json/mutation_from_json.py
msgid ""
"You are badly allergic to wool, and cannot wear any clothing made of the "
"substance."
msgstr ""
"Sos muy alérgico a la lana, y no podés ponerte ninguna ropa de ese material."

#: lang/json/mutation_from_json.py
msgid "Truth Teller"
msgstr "Honestidad"

#. ~ Description for {'str': 'Truth Teller'}
#: lang/json/mutation_from_json.py
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr ""
"Cuando tratás de decir una mentira, te ponés colorado, tartamudeás y parecés"
" sospechoso. Para vos, es mucho más difícil decir mentiras y otros engaños."

#: lang/json/mutation_from_json.py
msgid "Ugly"
msgstr "Fealdad"

#. ~ Description for {'str': 'Ugly'}
#: lang/json/mutation_from_json.py
msgid ""
"You're not much to look at.  People who care about such things will react "
"poorly to you."
msgstr ""
"No sos algo que dan ganas de mirar. Las personas que se interesen en las "
"apariencias te van a tratar con desprecio."

#: lang/json/mutation_from_json.py
msgid "Albino"
msgstr "Albinismo"

#. ~ Description for {'str': 'Albino'}
#: lang/json/mutation_from_json.py
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and sunglasses when going out in the "
"sun."
msgstr ""
"Debido a un problema genético, no tenés pigmentación en la piel. El sol te "
"quema extremadamente fácil, y podés usar un paraguas y lentes oscuros para "
"cubrirte del sol."

#: lang/json/mutation_from_json.py
msgid "Flimsy"
msgstr "Endeble"

#. ~ Description for {'str': 'Flimsy'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual, "
"and you heal slightly slower.  Stacks with Glass Jaw."
msgstr ""
"Tu cuerpo no puede soportar demasiados golpes. Tus máximos PV son un 25% "
"menor que lo usual, y te curás un poco más lento. Es acumulativo con "
"Mandíbula de Cristal."

#: lang/json/mutation_from_json.py
msgid "Frail"
msgstr "Delicadez"

#. ~ Description for {'str': 'Frail'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual, and "
"you heal slower.  Stacks with Glass Jaw."
msgstr ""
"Tu cuerpo se rompe fácilmente. Tus máximos PV son un 50% menor que lo usual,"
" y te curás más lento. Es acumulativo con Mandíbula de Cristal."

#: lang/json/mutation_from_json.py
msgid "Fragile"
msgstr "Frágil"

#. ~ Description for {'str': 'Fragile'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual, and"
" you heal much slower.  Stacks with Glass Jaw."
msgstr ""
"Tu cuerpo es extremadamente frágil. Tus máximos PV son un 75% menor que lo "
"usual, y te curás mucho más lento. Es acumulativo con Mandíbula de Cristal."

#: lang/json/mutation_from_json.py
msgid "Genetic Downward Spiral"
msgstr "Espiral Descendente Genético"

#. ~ Description for {'str': 'Genetic Downward Spiral'}
#: lang/json/mutation_from_json.py
msgid ""
"The events of the Cataclysm have damaged your DNA beyond repair.  You mutate"
" frequently, and all mutations you receive (from any source) are negative."
msgstr ""
"Los sucesos del Cataclismo te han dañado el ADN a puntos irreparables. Mutás"
" frecuentemente, y todas las mutaciones que recibís (de cualquier fuente) "
"serán negativas."

#: lang/json/mutation_from_json.py
msgid "Rough Skin"
msgstr "Piel Dura"

#. ~ Description for {'str': 'Rough Skin'}
#: lang/json/mutation_from_json.py
msgid "Your skin is slightly rough.  This has no gameplay effect."
msgstr "Tu piel es un poco más dura. Esto no tiene ningún efecto."

#: lang/json/mutation_from_json.py
msgid "High Night Vision"
msgstr "Visión Nocturna Aguda"

#. ~ Description for {'str': 'High Night Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"¡Podés ver increíblemente bien en la oscuridad! Hay que activarlo para ver "
"las áreas visibles por Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Full Night Vision"
msgstr "Visión Nocturna Completa"

#. ~ Description for {'str': 'Full Night Vision'}
#. ~ Description for Full Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"En la oscuridad total podés ver como si estuvieras usando anteojos de visión"
" nocturna. Hay que activarlo para ver las áreas visibles por Visión "
"Nocturna."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Eyes"
msgstr "Ojos de Cefalópodo"

#. ~ Description for {'str': 'Cephalopod Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes still bulge, yet your pupils look different somehow.  Water "
"doesn't seem to cause any trouble at all, though."
msgstr ""
"Tus ojos son saltones, y tus pupilas se ven un poco diferentes. El agua no "
"parece causarte ningún problema."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Vision"
msgstr "Visión de Cefalópodo"

#. ~ Description for {'str': 'Cephalopod Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Tu cerebro ahora acompaña la capacidad de tus ojos. Podés ver mucho mejor en"
" la oscuridad, pero la luz del sol parece mucho más brillante. Hay que "
"activarlo para ver las áreas visibles por Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Fey Eyes"
msgstr "Ojos de Fey"

#. ~ Description for {'str': 'Fey Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have turned… green.  It's tough to tell the exact shade, as it "
"seems to shift.  The effect is… pleasant."
msgstr ""
"Tus ojos se han vuelto… verdes. Es difícil decir exactamente de qué matiz "
"son porque parecen cambiar. El efecto es… placentero."

#: lang/json/mutation_from_json.py
msgid "Fey Vision"
msgstr "Visión de Fey"

#. ~ Description for {'str': 'Fey Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr ""
"Las sombras ya no parecen ser tan oscuras. Hay que activarlo para ver las "
"áreas visibles por Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Fey Nightsight"
msgstr "Visión Nocturna de Fey"

#. ~ Description for {'str': 'Fey Nightsight'}
#: lang/json/mutation_from_json.py
msgid ""
"You have great low-light vision now, but it doesn't allow you to perform "
"fine tasks such as crafting and reading in darkness.  Activate to toggle NV-"
"visible areas on or off."
msgstr ""
"Ahora tenés muy buena visión con poca luz, aunque eso no te permite realizar"
" acciones como fabricar o leer en la oscuridad. Hay que activarla para "
"encender y apagar las áreas visibles por Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Feline Eyes"
msgstr "Ojos Felinos"

#. ~ Description for {'str': 'Feline Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated; now you have slit pupils, and they glitter in the "
"light, much like a cat's.  This is visually striking, but it isn't helping "
"you see at night."
msgstr ""
"Tus ojos han mutado, ahora tenés pupilas rasgadas que brillan en la luz, muy"
" similar a los de los gatos. Esto es llamativo pero no te ayuda a ver en la "
"noche."

#: lang/json/mutation_from_json.py
msgid "Feline Vision"
msgstr "Visión Felina"

#. ~ Description for {'str': 'Feline Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see "
"pretty well at night.  Activate to toggle NV-visible areas on or off."
msgstr ""
"Tus nervios ópticos ahora acompañan la capacidad de tus ojos. Podés ver "
"bastante bien en la noche. Hay que activarlo para ver las áreas visibles por"
" Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Ursine Vision"
msgstr "Visión Osuna"

#. ~ Description for {'str': 'Ursine Vision'}
#: lang/json/mutation_from_json.py
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"Tu proceso visual ha cambiado: a pesar de que podés ver mejor en la "
"oscuridad, sos miope cuando hay luz. Tal vez los anteojos te puedan ayudar. "
"Hay que activarlo para ver las áreas visibles por Visión Nocturna."

#: lang/json/mutation_from_json.py
msgid "Avian Eyes"
msgstr "Ojos Aviarios"

#. ~ Description for {'str': 'Avian Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr ""
"Tu visión se ha vuelto particularmente aguda: sospechás que podés divisar "
"zombis desde mucho más lejos. Percepción +4."

#. ~ Description for {'str': 'Infrared Vision'}
#: lang/json/mutation_from_json.py
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr ""
"Tus ojos han mutado y podés ver la radiación en el espectro infrarrojo."

#: lang/json/mutation_from_json.py
msgid "Reptilian Eyes"
msgstr "Ojos Reptilianos"

#. ~ Description for {'str': 'Reptilian Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect "
"your vision."
msgstr ""
"Tus ojos han mutado, con un iris brillante y la pupila rasgada, similar a "
"los de un lagarto. Esto es llamativo, pero no parece afectar tu visión."

#: lang/json/mutation_from_json.py
msgid "Reptilian IR"
msgstr "IR Reptiliano"

#. ~ Description for {'str': 'Reptilian IR'}
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, "
"allowing you to see in the infrared spectrum."
msgstr ""
"Tus nervios ópticos y cerebro han mutado para acompañar la capacidad de tus "
"ojos, lo que te permite ver en el espectro infrarrojo."

#: lang/json/mutation_from_json.py
msgid "Very Fast Healer"
msgstr "Sanación Muy Rápida"

#. ~ Description for {'str': 'Very Fast Healer'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your wounds heal very quickly.  You heal 50% faster whilst asleep and 66% "
"faster whilst awake.  Your broken limbs also heal 4 times faster than usual."
msgstr ""
"Tus heridas se curan solas muy rápidamente. Te curás 50% más rápido mientras"
" dormís y 66% más rápido cuando estás despierto. Tus miembros fracturados "
"también sanarán al cuádruple de velocidad."

#: lang/json/mutation_from_json.py
msgid "Regeneration"
msgstr "Regeneración"

#. ~ Description for {'str': 'Regeneration'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your flesh regenerates from wounds incredibly quickly.  You heal 150% faster"
" whilst asleep and 200% faster whilst awake.  Your broken limbs also heal 16"
" times faster than usual."
msgstr ""
"Tu carne se regenera de las heridas increíblemente rápido. Te curás 150% más"
" rápido mientras dormís y 200% más rápido cuando estás despierto. Tus "
"miembros fracturados también sanarán 16 veces más rápido de lo normal."

#: lang/json/mutation_from_json.py
msgid "Reptilian Healing"
msgstr "Sanación Reptiliana"

#. ~ Description for {'str': 'Reptilian Healing'}
#: lang/json/mutation_from_json.py
msgid ""
"Your broken limbs mend themselves without significant difficulty.  You do "
"not require splints and broken limbs heal 20 times faster than usual."
msgstr ""
"Tus miembros rotos se curan solos sin mayor dificultad. No necesitás usar "
"tablillas y tus miembros fracturados sanarán 20 veces más rápido que lo "
"normal."

#: lang/json/mutation_from_json.py
msgid "Very Little Sleep"
msgstr "Poquito Sueño"

#. ~ Description for {'str': 'Very Little Sleep'}
#: lang/json/mutation_from_json.py
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr "No dormís muy seguido. Pero cuando dormís, con poquito es suficiente."

#: lang/json/mutation_from_json.py
msgid "Tireless"
msgstr "Incansable"

#. ~ Description for {'str': 'Tireless'}
#: lang/json/mutation_from_json.py
msgid "You defend the realm all night and all day."
msgstr "Defendés el reino toda la noche y todo el día."

#: lang/json/mutation_from_json.py
msgid "Fangs"
msgstr "Colmillos"

#. ~ Description for {'str': 'Fangs'}
#. ~ Description for Fangs
#: lang/json/mutation_from_json.py
msgid ""
"Your teeth have grown into two-inch-long fangs, allowing you to make an "
"extra attack when conditions favor it."
msgstr ""
"Tus dientes se han convertido en colmillos de 5 centímetros, lo que te "
"permite tener un ataque extra cuando las condiciones te lo permiten."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You sink your fangs into %s"
msgstr "Hundís tus colmillos en el %s"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s sinks their fangs into %2$s"
msgstr "%1$s hunde sus colmillos en el/a %2$s"

#: lang/json/mutation_from_json.py
msgid "Incisors"
msgstr "Incisivos"

#. ~ Description for {'str': 'Incisors'}
#: lang/json/mutation_from_json.py
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr ""
"Tus dientes grandes han crecido. La gente te va a tener que respetar más."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite into %s with your ratlike incisors"
msgstr "Mordés el %s con tus incisivos como los de una rata"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s with their ratlike incisors"
msgstr "¡%1$s muerde el %2$s con sus incisivos como los de una rata!"

#: lang/json/mutation_from_json.py
msgid "Nictitating Membrane"
msgstr "Membrana Nictitante"

#. ~ Description for {'str': 'Nictitating Membrane'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a set of clear lenses which lower over your eyes while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr ""
"Tenés un par de lentes transparentes que se cierran sobre tus ojos cuando "
"estás bajo el agua, lo que te permite ver como si estuvieras usando "
"antiparras. Disminuye levemente las penalidades por mojarse."

#: lang/json/mutation_from_json.py
msgid "Gills"
msgstr "Branquias"

#. ~ Description for {'str': 'Gills'}
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe "
"underwater.  Slightly increases wet benefits."
msgstr ""
"Te han crecido unas branquias en tu cuello, lo que te permite respirar bajo "
"el agua. Incrementa levemente los beneficios de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Gills"
msgstr "Branquias de Cefalópodo"

#. ~ Description for {'str': 'Cephalopod Gills'}
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr ""
"Te han crecido unas branquias a lo largo de tu cuello hasta detras de las "
"orejas. Te permiten respirar abajo del agua y incrementa levemente los "
"beneficios de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Mycus Flesh"
msgstr "Carne de Mycus"

#. ~ Description for {'str': 'Mycus Flesh'}
#: lang/json/mutation_from_json.py
msgid ""
"We have begun adapting local physiology to Mycus physical structure, greatly"
" reducing wet effects."
msgstr ""
"Nosotros hemos comenzado a adaptar la fisiología local hacia la estructura "
"física Mycus, reduciendo mucho los efectos de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Mycus Fireproofing"
msgstr "Ignifuguez de Mycus"

#. ~ Description for {'str': 'Mycus Fireproofing'}
#: lang/json/mutation_from_json.py
msgid ""
"We have spliced the dense, amphibole fibers from Mycus core towers with the "
"resilient, adaptive flesh of local physiology.  This reduces our speed by a "
"moderate amount, but provides powerful armor across our body, nullifies wet "
"effects, and provides complete protection from fire."
msgstr ""
"Nosotros hemos unido las densas fibras de anfíbol de las torres centrales "
"del Mycus, con la carne resistente y adaptable de la fisiología local. Esto "
"reduce nuestra velocidad considerablemente, pero nos otorga poderosa "
"armadura para nuestro cuerpo, anula los efectos de estar mojado, y brinda "
"completa protección al fuego."

#: lang/json/mutation_from_json.py
msgid "Mycogenesis"
msgstr "Micogenesis"

#. ~ Description for {'str': 'Mycogenesis'}
#: lang/json/mutation_from_json.py
msgid ""
"Local physiology has been fully incorporated with that of Mycus silicate "
"fibers.  In addition to benefits conferred by previous developments, we may "
"join with Mycus fibers beneath us - sleeping on top of fungal areas places "
"us into a dormant state, which spreads spores around us as we sleep and "
"revitalizes our body much more quickly than regular sleep."
msgstr ""
"La fisiología local ha sido completamente incorporada con las fibras de "
"silicato del Mycus. Además de los beneficios conferidos por los desarrollos "
"anteriores, nosotros podemos unirnos con las fibras del Mycus - durmiendo "
"sobre áreas fúngicas, nos ponen en estado inactivo, lo que libera esporas a "
"nuestro alrededor mientras dormimos y revitaliza nuestro cuerpo mucho más "
"rápido que un sueño normal."

#: lang/json/mutation_from_json.py
msgid "Scales"
msgstr "Escamas"

#. ~ Description for {'str': 'Scales'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of flexible green scales has grown to cover your body, acting as "
"natural armor.  Somewhat reduces wet effects."
msgstr ""
"Es una colección de escamas verdes y flexibles te han crecido y cubren tu "
"cuerpo. Funcionan como una armadura natural. De alguna manera, disminuyen "
"los efectos de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Thick Scales"
msgstr "Escamas Gruesas"

#. ~ Description for {'str': 'Thick Scales'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of heavy green scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also limits your flexibility, "
"resulting in a -2 penalty to Dexterity.  Greatly reduces wet effects."
msgstr ""
"Es una colección de escamas verdes y resistentes te han crecido y cubren tu "
"cuerpo. Funcionan como una armadura natural. Aunque es difícil de penetrar, "
"también limita tu flexibilidad, lo que te da una penalidad de -2 a tu "
"destreza. Reduce mucho los efectos de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Sleek Scales"
msgstr "Escamas Lisas"

#. ~ Description for {'str': 'Sleek Scales'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of very flexible and slick scales has grown to cover your body.  These"
" act as weak natural armor, improve your ability to swim, and make you "
"difficult to grab.  Mostly reduces wet effects."
msgstr ""
"Es una colección de escamas muy flexibles y lisas te han crecido y cubren tu"
" cuerpo. Estas actúan como una débil armadura natural, mejoran tu habilidad "
"para nadar, y hacen que sea más difícil agarrarte. Reduce mucho los efectos "
"de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Light Bones"
msgstr "Huesos Livianos"

#. ~ Description for {'str': 'Light Bones'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt "
"a little more."
msgstr ""
"Tus huesos son muy livianos. Esto te permite moverte y atacar un 10% más "
"rápido, pero también reduce tu capacidad de cargar peso en un 20%, y hace "
"que los ataques golpeantes duelan un poco más."

#: lang/json/mutation_from_json.py
msgid "Feathers"
msgstr "Plumas"

#. ~ Description for {'str': 'Feathers'}
#: lang/json/mutation_from_json.py
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr ""
"Plumas iridiscentes han crecido y cubren tu cuerpo entero, lo que te brinda "
"una protección mínima contra los ataques y un poco de protección al frío. "
"También son un impermeable natural."

#: lang/json/mutation_from_json.py
msgid "Down"
msgstr "Plumones"

#. ~ Description for {'str': 'Down'}
#: lang/json/mutation_from_json.py
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr ""
"No vas a necesitar migrar al sur con tu capa de plumones. Todavía es mejor "
"porque ¡no hay simios por ahí tratando de matarte para quitártelas!"

#: lang/json/mutation_from_json.py
msgid "Lightly Furred"
msgstr "Pelaje Ligero"

#. ~ Description for {'str': 'Lightly Furred'}
#: lang/json/mutation_from_json.py
msgid ""
"Light fur has grown to cover your entire body, providing slight protection "
"from cold."
msgstr ""
"Un pelaje ligero ha crecido y cubre tu cuerpo entero, lo que te brinda una "
"pequeña protección contra el frío."

#: lang/json/mutation_from_json.py
msgid "Furry"
msgstr "Peludo/a"

#. ~ Description for {'str': 'Furry'}
#: lang/json/mutation_from_json.py
msgid ""
"Thick black fur has grown to cover your entire body, providing marginal "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Te ha crecido pelo negro y grueso que cubre todo tu cuerpo, lo que te brinda"
" una mínima protección contra los ataques, y una protección considerable "
"contra el frío."

#: lang/json/mutation_from_json.py
msgid "Shaggy Fur"
msgstr "Pelaje Largo"

#. ~ Description for {'str': 'Shaggy Fur'}
#: lang/json/mutation_from_json.py
msgid ""
"Your fur has grown out and thickened, providing noticeable protection from "
"attacks as well as considerable insulation."
msgstr ""
"Tu pelaje ha crecido y se ha endurecido, lo que te brinda una evidente "
"protección contra los ataques, así como también un aislamiento térmico "
"considerable."

#: lang/json/mutation_from_json.py
msgid "Gray Fur"
msgstr "Pelaje Gris"

#. ~ Description for {'str': 'Gray Fur'}
#: lang/json/mutation_from_json.py
msgid ""
"Dense gray fur has grown to cover your entire body, providing marginal "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Es un pelaje denso y gris te ha crecido y cubre todo tu cuerpo, lo que te "
"brinda una mínima protección contra los ataques, y una protección "
"considerable contra el frío."

#: lang/json/mutation_from_json.py
msgid "Sleek Fur"
msgstr "Pelaje Liso"

#. ~ Description for {'str': 'Sleek Fur'}
#: lang/json/mutation_from_json.py
msgid "You've grown sleek brown fur, providing some protection from cold."
msgstr ""
"Te ha crecido un pelaje marrón y liso, lo que te brinda algo de protección "
"contra el frío."

#: lang/json/mutation_from_json.py
msgid "Lynx Fur"
msgstr "Pelaje de Lince"

#. ~ Description for {'str': 'Lynx Fur'}
#: lang/json/mutation_from_json.py
msgid ""
"Your fur has grown out significantly around your cheeks and neck.  It "
"provides minor protection against attacks."
msgstr ""
"Tu pelaje ha crecido mucho en tus cachetes y tu cuello. Te brinda una "
"protección menor contra los ataques."

#: lang/json/mutation_from_json.py
msgid "Patchwork Skin"
msgstr "Piel de Retazos"

#. ~ Description for {'str': 'Patchwork Skin'}
#: lang/json/mutation_from_json.py
msgid "Your skin has mutated into an amalgamation of fur and scales."
msgstr ""
"Tu piel ha mutado hasta convertirse en una amalgama de piel y escamas."

#: lang/json/mutation_from_json.py
msgid "Thickened Patchwork Skin"
msgstr "Piel Endurecida de Retazos"

#. ~ Description for {'str': 'Thickened Patchwork Skin'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin has mutated into an amalgamation of thickened fur and scales."
msgstr ""
"Tu piel ha mutado hasta convertirse en una amalgama de piel y escamas "
"endurecida."

#: lang/json/mutation_from_json.py
msgid "Chitinous Skin"
msgstr "Piel Quitinosa"

#. ~ Description for {'str': 'Chitinous Skin'}
#: lang/json/mutation_from_json.py
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It "
"provides minor protection from cutting wounds.  Slightly reduces wet "
"effects."
msgstr ""
"Tu epidermis se ha convertido en una capa de quitina delgada y flexible. Te "
"brinda una protección menor al daño cortante. Y reduce un poco los efectos "
"de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Chitinous Armor"
msgstr "Armadura Quitinosa"

#. ~ Description for {'str': 'Chitinous Armor'}
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides"
" considerable physical protection, and make your punches hit a little harder"
" but reduces your Dexterity by 1.  Somewhat reduces wet effects."
msgstr ""
"Te ha crecido un exoesqueleto de quitina, muy parecido al de un insecto. Te "
"brinda una protección física considerable y hace que tus piñas sean un poco "
"más duras, pero reduce tu Destreza en 1 punto. Y reduce un poco los efectos "
"de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Chitinous Plate"
msgstr "Coraza Quitinosa"

#. ~ Description for {'str': 'Chitinous Plate'}
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton made of thick, stiff plates.  It provides "
"excellent physical protection and makes your punches hit harder, but reduces"
" your Dexterity by 1 and encumbers all body parts but your eyes and mouth.  "
"Greatly reduces wet effects."
msgstr ""
"Te ha crecido un exoesqueleto de placas rígidas y gruesas de quitina. Te "
"brinda una excelente protección física y hace tus golpes más fuertes pero "
"reduce tu Destreza en 1 punto, y aumenta la incomodidad en todas las partes "
"de tu cuerpo, excepto los ojos y la boca. Reduce mucho los efectos de estar "
"mojado."

#: lang/json/mutation_from_json.py
msgid "Hairy Chitin"
msgstr "Quitina con Pelaje"

#. ~ Description for {'str': 'Hairy Chitin'}
#: lang/json/mutation_from_json.py
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr ""
"Has desarrollado alguna especie de pelo que crece de tu capa de quitina. Es "
"un poco más abrigado que no tener pelo."

#: lang/json/mutation_from_json.py
msgid "Furred Chitin"
msgstr "Quitina Peluda"

#. ~ Description for {'str': 'Furred Chitin'}
#: lang/json/mutation_from_json.py
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr ""
"El pelo que crece de tu capa de quitina se ha engrosado y extendido por todo"
" tu cuerpo. Te brinda un poco de abrigo y te ayuda a percibir vibraciones "
"cercanas."

#: lang/json/mutation_from_json.py
msgid "Furred Plate"
msgstr "Coraza Peluda"

#. ~ Description for {'str': 'Furred Plate'}
#: lang/json/mutation_from_json.py
msgid ""
"Your exoskeleton has hardened considerably, imposing a further -1 to "
"Dexterity, and boasts a fine coat of hairs that put feline whiskers to "
"shame."
msgstr ""
"Tu exoesqueleto se ha endurecido considerablemente, ocasionando un "
"disminución de -1 a tu Destreza, pero presume de una buena campera de pelos "
"que les hacen pasar vergüenza a los bigotes de los gatos."

#: lang/json/mutation_from_json.py
msgid "Urticating Hairs"
msgstr "Pelos Urticantes"

#. ~ Description for {'str': 'Urticating Hairs'}
#: lang/json/mutation_from_json.py
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an"
" irritating spot; it doesn't carry your venom but it will be distracting."
msgstr ""
"Cantidades significativas de pelo se te han aflojado. Si alguna criatura "
"intenta atacarte, es bastante probable que tu agresor reciba una buena "
"quitina rasposa en un lugar molesto. No tiene tu veneno pero es una buena "
"distracción."

#: lang/json/mutation_from_json.py
msgid "Spines"
msgstr "Pinchos"

#. ~ Description for {'str': 'Spines'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes"
" a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr ""
"Tu piel está cubierta con pinchos finos. Cada vez que un oponente desarmado "
"golpea una parte de tu cuerpo que no está cubierta, va a recibir un daño "
"moderado."

#: lang/json/mutation_from_json.py
msgid "Quills"
msgstr "Púas"

#. ~ Description for {'str': 'Quills'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive significant damage."
msgstr ""
"Tu cuerpo está cubierto con grandes púas. Cada vez que un oponente desarmado"
" golpea una parte de tu cuerpo que no está cubierta, va a recibir un daño "
"significativo."

#. ~ Description for {'str': 'Assault barbs'}
#: lang/json/mutation_from_json.py
msgid ""
"Some of the quills on your arms have become quite loose.  By flinging your "
"arms, you can fire off these quills as projectiles."
msgstr ""
"Algunos de las púas en tus brazos se han aflojado. Al azotar tus brazos "
"podés arrojar estas púas como proyectiles."

#: lang/json/mutation_from_json.py
msgid "You fire off some of your quills."
msgstr "Disparás algunas de tus púas."

#: lang/json/mutation_from_json.py
msgid "Phelloderm"
msgstr "Felodermis"

#. ~ Description for {'str': 'Phelloderm'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides a weak armor, and helps you retain moisture, resulting in less "
"thirst.  Greatly decreases wet penalties."
msgstr ""
"Tu piel es ligeramente verdosa y tiene una pequeña similitud con la madera. "
"Esto te brinda una armadura débil, y te ayuda a mantener la humedad, lo que "
"significa menos sed. Disminuye mucho las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Bark"
msgstr "Corteza"

#. ~ Description for {'str': 'Bark'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"resistance to cutting damage and minor protection from fire.  Greatly "
"reduces wet effects."
msgstr ""
"Tu piel está revestida con una fina corteza, como la de un árbol. Esto te "
"brinda resistencia al daño cortante, y una protección menor al fuego. Reduce"
" mucho las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Thorns"
msgstr "Espinas"

#. ~ Description for {'str': 'Thorns'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr ""
"Tu piel está cubierta con pequeñas espinas de madera. Cada vez que un "
"oponente desarmado golpea una parte de tu cuerpo que no está cubierta, va a "
"recibir un daño menor. Tus trompadas también causan daño extra."

#: lang/json/mutation_from_json.py
msgid "Leaves"
msgstr "Hojas"

#. ~ Description for {'str': 'Leaves'}
#: lang/json/mutation_from_json.py
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from"
" being physically striking, these provide you with a minor amount of "
"nutrients while in sunlight when your head is uncovered.  Slightly reduces "
"wet effects."
msgstr ""
"Todo el pelo de tu cuerpo se ha convertido en unas hojas largas como pasto. "
"Además de ser llamativo, te brinda una pequeña cuota de nutrientes mientras "
"estás al sol cuando no tenés cubierta la cabeza. Reduce un poco los efectos "
"de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Lush Leaves"
msgstr "Hojas Exuberantes"

#. ~ Description for {'str': 'Lush Leaves'}
#: lang/json/mutation_from_json.py
msgid ""
"Your leaves have grown in size and prominence, with additional leaves "
"sprouting along your arms.  While your arms and head are uncovered, you will"
" photosynthesize nutrients while in sunlight.  Reduces wet effects."
msgstr ""
"Tus hojas han crecido en tamaño y prominencia, con más hojas brotando por "
"tus brazos. Mientras tus brazos y cabeza estén sin cubrir, vas a poder "
"fotosintetizar nutrientes cuando estés a la luz del sol. Reduce los efectos "
"de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Verdant Leaves"
msgstr "Hojas Verdes"

#. ~ Description for {'str': 'Verdant Leaves'}
#: lang/json/mutation_from_json.py
msgid ""
"Your leaves are vibrant, large, and green, and have become a major source of"
" nutrients for your body.  Whenever your arms and head are uncovered you "
"will gain a large amount of nutrients by standing in the sunlight.  Reduces "
"wet effects."
msgstr ""
"Tus hojas son verdes, vibrantes y grandes y se han vuelto una gran fuente de"
" nutrientes para tu cuerpo. Cuando tus brazos y cabeza estén descubiertos "
"ganarás una gran cantidad de nutrientes al estar parado a la luz del sol. "
"Reduce los efectos de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Transpiration"
msgstr "Transpiración"

#. ~ Description for {'str': 'Transpiration'}
#: lang/json/mutation_from_json.py
msgid ""
"You body has begun moving nutrients via the evaporation of water.  This "
"increases your thirst when it's hot, but reduces it when it's cold."
msgstr ""
"Tu cuerpo ha comenzado a mover los nutrientes a través de la evaporación del"
" agua. Esto incrementa tu sed cuando hace calor, pero la reduce cuando hace "
"frío."

#: lang/json/mutation_from_json.py
msgid "Flowering"
msgstr "Floreciente"

#. ~ Description for {'str': 'Flowering'}
#: lang/json/mutation_from_json.py
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr ""
"Donde antes estaba tu cuero cabelludo, ahora empezaste a florecer. Tus "
"flores tienen un aroma agradable, son llamativos y bastante sensitivos."

#: lang/json/mutation_from_json.py
msgid "Rosebuds"
msgstr "Pimpollos"

#. ~ Description for {'str': 'Rosebuds'}
#: lang/json/mutation_from_json.py
msgid ""
"The top of your head is blooming with rosebuds.  They're eye catching, and "
"have a strong fragrance that makes you pleasant to be around."
msgstr ""
"La parte superior de tu cabeza está llena de pimpollos. Son vistosos y tiene"
" una fragancia fuerte que te hace placentero de tenerte al lado."

#: lang/json/mutation_from_json.py
msgid "Mycus Spores"
msgstr "Esporas de Mycus"

#. ~ Description for {'str': 'Mycus Spores'}
#: lang/json/mutation_from_json.py
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr ""
"Nosotros hemos desarrollado sacos locales de esporas. El Mycus debe crecer."

#: lang/json/mutation_from_json.py
msgid "Mycus Sporogenesis"
msgstr "Esporogénesis de Mycus"

#. ~ Description for {'str': 'Mycus Sporogenesis'}
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local spore sacs remain quiescent, until local"
" guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Organismos locales parecen considerar la dispersión de esporas como peligro,"
" y atacan a los Mycus. En consecuencia, nuestros sacos locales de esporas se"
" mantienen inactivos hasta que una orden local determina que es seguro "
"germinar. El desarrollo rápido exprime las reservas locales de nutrientes, "
"pero asegura el crecimiento rápido y efectivo."

#: lang/json/mutation_from_json.py
msgid "Mycus Blossoms"
msgstr "Capullos de Mycus"

#. ~ Description for {'str': 'Mycus Blossoms'}
#: lang/json/mutation_from_json.py
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr "Nosotros hemos desarrollado capullos locales. El Mycus debe crecer."

#: lang/json/mutation_from_json.py
msgid "Mycus Bloom"
msgstr "Floración de Mycus"

#. ~ Description for {'str': 'Mycus Bloom'}
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Organismos locales parecen considerar la dispersión de esporas como peligro,"
" y atacan a los Mycus. En consecuencia, nuestros capullos locales se "
"mantienen inactivos hasta que una orden local determina que es seguro "
"germinar. El desarrollo rápido exprime las reservas locales de nutrientes, "
"pero asegura el crecimiento rápido y efectivo."

#: lang/json/mutation_from_json.py
msgid "Mycus Provenance"
msgstr "Procedencia Mycus"

#. ~ Description for {'str': 'Mycus Provenance'}
#: lang/json/mutation_from_json.py
msgid ""
"Local spore sacs and blossoms have merged into a single, symbiotic form.  "
"Acting as one, they germinate together to cement rapid growth across a large"
" area according to local guidance.  The Mycus must grow."
msgstr ""
"Los sacos locales de esporas y de flores se han fusionado en una sola forma "
"simbiótica. Actuando como uno, germinan juntos para asegurar el crecimiento "
"rápido a lo largo de toda un área extensa. El Mycus debe crecer."

#: lang/json/mutation_from_json.py
msgid "Long Fingernails"
msgstr "Uñas Largas"

#. ~ Description for {'str': 'Long Fingernails'}
#. ~ Description for Long Fingernails
#: lang/json/mutation_from_json.py
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Tus uñas son largas y afiladas. Si no tenés puestos guantes, tus ataques "
"desarmados causan un daño cortante menor."

#: lang/json/mutation_from_json.py
msgid "Claws"
msgstr "Garras"

#. ~ Description for {'str': 'Claws'}
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Tenés garras en la punta de tus dedos. Si no tenés puestos guantes, tus "
"ataques desarmados causan un daño cortante menor."

#: lang/json/mutation_from_json.py
msgid "Rat Claws"
msgstr "Garras de Rata"

#. ~ Description for {'str': 'Rat Claws'}
#: lang/json/mutation_from_json.py
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "Tus garras han crecido y son más duras y un poco retorcidas."

#: lang/json/mutation_from_json.py
msgid "Stainless Claws"
msgstr "Garras Inoxidables"

#. ~ Description for {'str': 'Stainless Claws'}
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  "
"They might as well be made of stainless steel."
msgstr ""
"Tus patas están hechas de hueso, músculo y garras con una pequeña capa de "
"piel y pelo. Como si fueran de acero inoxidable."

#: lang/json/mutation_from_json.py
msgid "Retractable Claws"
msgstr "Garras Retráctiles"

#. ~ Description for {'str': 'Retractable Claws'}
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them "
"as desired.  Gloves will still get in the way, though."
msgstr ""
"Tenés garras en la punta de tus dedos, y las podés extender o retraer cuando"
" quieras. Igual, los guantes van a ser un obstáculo."

#: lang/json/mutation_from_json.py
msgid "You extend your claws."
msgstr "Extendés tus garras."

#: lang/json/mutation_from_json.py
msgid "Extended Claws"
msgstr "Garras Extendidas"

#. ~ Description for {'str': 'Extended Claws'}
#: lang/json/mutation_from_json.py
msgid "Sharp claws are extending from the end of your fingers."
msgstr "Unas garras filosas se extienden de la punta de tus dedos."

#: lang/json/mutation_from_json.py
msgid "You retract your claws."
msgstr "Retraés tus garras."

#: lang/json/mutation_from_json.py
msgid "Tentacle Rakes"
msgstr "Tentáculos Rastrillo"

#. ~ Description for {'str': 'Tentacle Rakes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr ""
"Tus tentáculos superiores han desarrollado en la punta, como unos ganchos "
"largos. Parecen bastante feroces, pero no son adecuados para la motricidad "
"fina."

#: lang/json/mutation_from_json.py
msgid "Ink glands"
msgstr "Glándulas de tinta"

#. ~ Description for {'str': 'Ink glands'}
#: lang/json/mutation_from_json.py
msgid ""
"Several ink glands have grown onto your torso.  They can be used to spray "
"defensive ink and blind an attacker in an emergency, as long as the torso "
"isn't covered."
msgstr ""
"Varias glándulas de tinta te han crecido en el torso. Pueden usarse para "
"lanzar una tinta defensiva y enceguecer al atacante en una emergencia, "
"siempre que el torso esté descubierto."

#: lang/json/mutation_from_json.py
msgid "Large Talons"
msgstr "Zarpas Grandes"

#. ~ Description for {'str': 'Large Talons'}
#. ~ Description for {'str': 'Demon Claws'}
#: lang/json/mutation_from_json.py
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, "
"you find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent wearing gloves."
msgstr ""
"Tus dedos índice han desarrollado unas enormes zarpas. Con un poco de "
"práctica esto no afecta tu destreza y te permite tener una ataque desarmado "
"mortal. Aunque te impiden utilizar guantes."

#: lang/json/mutation_from_json.py
msgid "Radiogenic"
msgstr "Radiogénico/a"

#. ~ Description for {'str': 'Radiogenic'}
#: lang/json/mutation_from_json.py
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr ""
"Tu sistema se ha adaptado a la radiación. Mientras estás irradiado, sanarás "
"lentamente convirtiendo la radiación en puntos de vida."

#: lang/json/mutation_from_json.py
msgid "Marloss Carrier"
msgstr "Portación de Marloss"

#. ~ Description for {'str': 'Marloss Carrier'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and… sap?"
msgstr ""
"Desde que comiste esas bayas Marloss, no te podés sacar su olor de la nariz,"
" y tenés como un fuerte deseo de probar semillas y…  ¿savia?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vessel"
msgstr "Recipiente de Marloss"

#. ~ Description for {'str': 'Marloss Vessel'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and… sap?"
msgstr ""
"Desde que comiste esas semillas de Marloss, no te podés sacar su gusto de la"
" lengua, y tenés como un fuerte deseo de probar unas bayas y… ¿savia?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vector"
msgstr "Vector de Marloss"

#. ~ Description for {'str': 'Marloss Vector'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and "
"you have a strong desire to eat some seeds and berries."
msgstr ""
"Desde que comiste esa gelatina de Marloss, no podés dejar de pensar en ella,"
" y tenés como un fuerte deseo de comer semillas y bayas."

#: lang/json/mutation_from_json.py
msgid "Marloss Rejection"
msgstr "Rechazo al Marloss"

#. ~ Description for {'str': 'Marloss Rejection'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr ""
"Desde que tuviste la reacción que casi te mata a esa porquería de Marloss, "
"¡no podés soportar el pensamiento de volver a comerlo!"

#: lang/json/mutation_from_json.py
msgid "Mutagenic Aversion"
msgstr "Aversión al Mutágeno"

#. ~ Description for {'str': 'Mutagenic Aversion'}
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr ""
"Desde que tuviste la reacción que casi te mata a ese mutágeno y ese "
"purificador, ¡no podés soportar el pensamiento de volver a usarlos!"

#: lang/json/mutation_from_json.py
msgid "Insect Pheromones"
msgstr "Feromonas de Insecto"

#. ~ Description for {'str': 'Insect Pheromones'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of insects.  Insects will attack you much less."
msgstr ""
"Tu cuerpo produce feromonas de bajo nivel, lo que te identifica como amigo "
"de varias especies de insectos. Los insectos te atacarán mucho menos que "
"antes."

#: lang/json/mutation_from_json.py
msgid "Mammal Pheromones"
msgstr "Feromonas de Mamífero"

#. ~ Description for {'str': 'Mammal Pheromones'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones which put mammals at ease.  They "
"will be less likely to attack or flee from you."
msgstr ""
"Tu cuerpo produce feromonas de bajo nivel, lo que tranquiliza a los "
"mamíferos. Estos serán menos propensos a atacarte o a huir de vos."

#: lang/json/mutation_from_json.py
msgid "Disease Immune"
msgstr "Inmune a la Enfermedad"

#. ~ Description for {'str': 'Disease Immune'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr ""
"Tu cuerpo es inmune a las enfermedades. Nunca te agarrarás una enfermedad "
"ambiental."

#: lang/json/mutation_from_json.py
msgid "Infection Resistant"
msgstr "Resistencia a Infección"

#. ~ Description for {'str': 'Infection Resistant'}
#: lang/json/mutation_from_json.py
msgid ""
"Your immune system is particularly good at resisting infections.  You have "
"an increased chance for bad wounds and infections to heal on their own, and "
"only suffer reduced penalties from them."
msgstr ""
"Tu sistema inmunológico es particularmente bueno para resistir infecciones. "
"Tenés mejor probabilidad de que las heridas graves y las infecciones se "
"curen solas, y solo sufrís penalidades menores a causa de ellas."

#: lang/json/mutation_from_json.py
msgid "Infection Immune"
msgstr "Inmune a la Infección"

#. ~ Description for {'str': 'Infection Immune'}
#: lang/json/mutation_from_json.py
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will "
"never become infected."
msgstr ""
"Tu torrente sanguíneo ha desarrollado propiedades antibióticas. Tus heridas "
"nunca se infectarán."

#: lang/json/mutation_from_json.py
msgid "Mycus Identity"
msgstr "Identidad de Mycus"

#. ~ Description for {'str': 'Mycus Identity'}
#: lang/json/mutation_from_json.py
msgid ""
"We have synchronized our local physiology with that of the Mycus.  Any "
"spores we may encounter will not attempt to germinate inside the local "
"system, and we may traverse Mycus biospheres easily, as native bioforms "
"shift shape to accommodate us."
msgstr ""
"Hemos sincronizado nuestra fisiología local con la del Mycus. Las esporas "
"que encontremos no intentará germinar dentro de nuestro sistema local, y "
"podamos extender biósferas Mycus fácilmente, ya que las formas de vida "
"nativas se acomodan a nosotros."

#: lang/json/mutation_from_json.py
msgid "Parasite Immune"
msgstr "Inmune a los Parásitos"

#. ~ Description for {'str': 'Parasite Immune'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr ""
"Tu cuerpo es extrañamente poco hospitalario a las formas de vida parásitas. "
"Nunca te infectarás con parásitos internos."

#: lang/json/mutation_from_json.py
msgid "Venomous"
msgstr "Venenoso/a"

#. ~ Description for {'str': 'Venomous'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr ""
"Tu cuerpo produce un poderoso veneno. Los ataques cortantes o punzantes de "
"las mutaciones tienen una posibilidad de envenenar a tu oponente."

#: lang/json/mutation_from_json.py
msgid "Strongly Venomous"
msgstr "Poderosamente Venenoso/a"

#. ~ Description for {'str': 'Strongly Venomous'}
#: lang/json/mutation_from_json.py
msgid ""
"Your venom has become particularly strong.  You're confident that your bites"
" or other cutting/stabbing natural attacks will take your target down "
"quickly."
msgstr ""
"Tu veneno se ha vuelto particularmente fuerte. Tenés confianza en que tus "
"mordeduras u otros ataques naturales cortantes o punzantes matarán a tu "
"oponente rápidamente."

#: lang/json/mutation_from_json.py
msgid "Slime Hands"
msgstr "Manos Babosas"

#. ~ Description for {'str': 'Slime Hands'}
#: lang/json/mutation_from_json.py
msgid ""
"The skin on your hands is now a mucous membrane that produces a thick, acrid"
" slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr ""
"La piel de tus manos es una membrana mucosa que produce una baba espesa y "
"acre. Los ataques usando tus manos causarán un daño menor de ácido. "
"Incrementa un poco los beneficios de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Stretchy Limbs"
msgstr "Miembros Elásticos"

#. ~ Description for {'str': 'Stretchy Limbs'}
#: lang/json/mutation_from_json.py
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr "Tus miembros parecen tener un poco más de elasticidad. +1 a Destreza."

#: lang/json/mutation_from_json.py
msgid "Rubbery Limbs"
msgstr "Miembros de Goma"

#. ~ Description for {'str': 'Rubbery Limbs'}
#: lang/json/mutation_from_json.py
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr ""
"Tus miembros son significativamente más flexibles que cualquier patético "
"brazo o pierna humanos. Destreza +3 y Fuerza -2."

#: lang/json/mutation_from_json.py
msgid "Pseudolimbs"
msgstr "Pseudomiembros"

#. ~ Description for {'str': 'Pseudolimbs'}
#: lang/json/mutation_from_json.py
msgid ""
"Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."
msgstr ""
"¡Tus miembros similares a los de un pseudópodo no se adaptan a nada! "
"Destreza +4 y Fuerza -4."

#: lang/json/mutation_from_json.py
msgid "Compound Eyes"
msgstr "Ojos Compuestos"

#. ~ Description for {'str': 'Compound Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"Perception by 2 whenever you aren't wearing eyewear."
msgstr ""
"Tus ojos son compuestos, como los de un insecto. Esto incrementa tu "
"Percepción en 2 puntos mientras no estés usando anteojos."

#: lang/json/mutation_from_json.py
msgid "Padded Feet"
msgstr "Pies Acolchados"

#. ~ Description for {'str': 'Padded Feet'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and even receive a 10% bonus when moving "
"barefoot."
msgstr ""
"Las plantas de tus pies están muy acolchadas. No recibís penalidades al "
"movimiento por no tener calzado, y recibís un bonus de 10% cuando andás "
"descalzo."

#: lang/json/mutation_from_json.py
msgid "Toe Talons"
msgstr "Zarpas en Pies"

#. ~ Description for {'str': 'Toe Talons'}
#: lang/json/mutation_from_json.py
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big"
" toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent wearing footgear."
msgstr ""
"Te han crecido unas zarpas extremadamente filosas, largas y curvas en lugar "
"de tus dedos gordos de los pies. Por suerte, no te molestan para caminar, "
"pero no te permiten usar calzado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slash %s with a talon"
msgstr "Le hacés un corte al %s con tu zarpa"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slashes %2$s with a talon"
msgstr "%1$s le hace un corte al %2$s con una zarpa"

#: lang/json/mutation_from_json.py
msgid "Hooves"
msgstr "Pezuñas"

#. ~ Description for {'str': 'Hooves'}
#: lang/json/mutation_from_json.py
msgid ""
"Your feet have fused into hooves.  This allows kicking attacks to do much "
"more damage, provides natural armor, and removes the need to wear shoes; "
"however, you cannot wear shoes of any kind.  Reduces wet effects."
msgstr ""
"Tus pies se fusionaron en pezuñas. Esto te permite pegar patadas para hacer "
"mucho daño, te brinda armadura natural, y te quita la necesidad de usar "
"calzado. Sin embargo, no vas a poder usar calzado de ningún tipo. Disminuye "
"los efectos de estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You kick %s with your hooves"
msgstr "Pateás al %s con tus pezuñas"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s kicks %2$s with their hooves"
msgstr "%1$s patea al %2$s con sus pezuñas"

#: lang/json/mutation_from_json.py
msgid "Alcohol Metabolism"
msgstr "Metabolismo de Alcohol"

#. ~ Description for {'str': 'Alcohol Metabolism'}
#: lang/json/mutation_from_json.py
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed "
"the ability to metabolize alcohol as a food source."
msgstr ""
"¿Así que está fermentado? No importa, igual es una buena bebida. Has "
"desarrollado la capacidad de metabolizar el alcohol como si fuera comida."

#: lang/json/mutation_from_json.py
msgid "Subterranean Fortitude"
msgstr "Fortaleza Subterránea"

#. ~ Description for {'str': 'Subterranean Fortitude'}
#: lang/json/mutation_from_json.py
msgid "The aches and pains of living underground don't bother you as much."
msgstr "Los malestares y dolores de vivir bajo tierra, no te molestan tanto."

#: lang/json/mutation_from_json.py
msgid "Subterranean Build"
msgstr "Constitución Subterránea"

#. ~ Description for {'str': 'Subterranean Build'}
#: lang/json/mutation_from_json.py
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading mobility for muscle mass.  (+2 Strength, -2 "
"Dexterity)"
msgstr ""
"Tu estructura se ha adaptado a la vida en espacios confinados. Parecés un "
"poco más petiso y corpulento, cambiaste movilidad por masa muscular. (Fuerza"
" +2 y Destreza -2)"

#: lang/json/mutation_from_json.py
msgid "Saprovore"
msgstr "Saprófago/a"

#. ~ Description for {'str': 'Saprovore'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr ""
"Tu sistema digestivo se especializó en permitirte consumir materia en "
"descomposición. Podés comer comida podrida, aunque obteniendo menos "
"nutrición que lo normal."

#: lang/json/mutation_from_json.py
msgid "Saprophage"
msgstr "Sedimentívoro/a"

#. ~ Description for {'str': 'Saprophage'}
#: lang/json/mutation_from_json.py
msgid ""
"You prefer to sustain your nutritional needs using your roots and direct "
"nutrient extraction/synthesis.  Your human parts still need the raw caloric "
"bulk of 'food' to keep them going, though, and you handle it a lot easier if"
" it's had time to… age a little."
msgstr ""
"Preferís sostener tus necesidades nutricionales usando tus raíces "
"extracción/síntesis directa de nutrientes. Igual, tus partes humanas todavía"
" necesitan el volumen de calorías crudas de la 'comida' para funcionar, y te"
" resulta mucho más fácil si tuvo tiempo de… añejarse un poco."

#: lang/json/mutation_from_json.py
msgid "Gizzard"
msgstr "Molleja"

#. ~ Description for {'str': 'Gizzard'}
#: lang/json/mutation_from_json.py
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr ""
"Has desarrollado mucha velocidad para comer, y la comida también pasa más "
"rápido por adentro tuyo."

#: lang/json/mutation_from_json.py
msgid "Mycus Feeder"
msgstr "Alimentador/a Mycus"

#. ~ Description for {'str': 'Mycus Feeder'}
#: lang/json/mutation_from_json.py
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us.  We may locate sources of sustenance in "
"close proximity to Mycus core towers, and in forested areas that the Mycus "
"has grown into."
msgstr ""
"Hemos simplificado nuestros requisitos nutricionales. Dependemos del Mycus "
"para el sustento, como él depende de nosotros. Podemos encontrar recursos de"
" sustento en la proximidad de las torres centrales del Mycus y en áreas "
"forestales en donde el Mycus ha crecido."

#: lang/json/mutation_from_json.py
msgid "Ruminant"
msgstr "Rumiante"

#. ~ Description for {'str': 'Ruminant'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is capable of digesting cellulose and other rough "
"plant material.  You can eat underbrush and shrubs by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Tu sistema digestivo es capaz de digerir celulosa y otras materias duras de "
"las plantas. Podés comer maleza o arbustos parándote encima y apretando 'E'."

#: lang/json/mutation_from_json.py
msgid "Grazer"
msgstr "Pastador/a"

#. ~ Description for {'str': 'Grazer'}
#: lang/json/mutation_from_json.py
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from "
"grass as well as underbrush and shrubs.  Eat either one by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Estás acostumbrado a comer plantas de manera directa, y podés obtener "
"nutrientes del pasto y también de la maleza y de los arbustos. Te los podés "
"comer parándote encima y apretando 'E'."

#: lang/json/mutation_from_json.py
msgid "Intestinal Fortitude"
msgstr "Fortaleza Intestinal"

#. ~ Description for {'str': 'Intestinal Fortitude'}
#: lang/json/mutation_from_json.py
msgid ""
"Your guts have developed the ability to handle poisonous food.  Mostly."
msgstr ""
"Tus tripas han desarrollado la capacidad de controlar la comida venenosa. La"
" mayoría, por lo menos."

#: lang/json/mutation_from_json.py
msgid "Eater Of The Dead"
msgstr "Comedor/a de Muertos"

#. ~ Description for {'str': 'Eater Of The Dead'}
#: lang/json/mutation_from_json.py
msgid ""
"Eating rotting, long-dead flesh is good for the struggle, and safe--if still"
" completely unappealing--for you."
msgstr ""
"Comerse la carne podrida, muerta hace mucho tiempo es bueno para la lucha, y"
" también es seguro para vos aunque te siga pareciendo un asco."

#: lang/json/mutation_from_json.py
msgid "Burrowing"
msgstr "Cavador/a"

#. ~ Description for {'str': 'Burrowing'}
#: lang/json/mutation_from_json.py
msgid "Your tough paws allow you to dig through dirt and rubble with ease."
msgstr ""
"Tus resistentes patas te permiten cavar por la tierra y el escombro con "
"facilidad."

#: lang/json/mutation_from_json.py
msgid "Saber Teeth"
msgstr "Dientes de Sable"

#. ~ Description for {'str': 'Saber Teeth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat… but leave nasty wounds "
"when you bite."
msgstr ""
"Tus colmillos han crecido extremadamente grandes e increíblemente afilados. "
"Te va a ser imposible usar equipo que cubre tu boca, y te resultará difícil "
"comer… pero dejás unas horribles heridas cuando mordés."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your saber teeth"
msgstr "Hundís tus dientes de sable en el %s desgarrándolo"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their saber teeth"
msgstr "%1$s hunde sus dientes de sable en el %2$s y lo desgarra"

#: lang/json/mutation_from_json.py
msgid "Hyper-Metabolism"
msgstr "Hiper-Metabolismo"

#. ~ Description for {'str': 'Hyper-Metabolism'}
#: lang/json/mutation_from_json.py
msgid ""
"Your particular metabolism allows you to burn calories at a prodigious rate "
"to regenerate tissues in a matter of minutes; this is, however, a very "
"wasteful process.  Activate to start healing."
msgstr ""
"Tu particular metabolismo te permite quemar calorías a un ritmo prodigioso "
"para regenerar tejido en cuestión de minutos, sin embargo es un proceso muy "
"ineficiente. Hay que activarlo para empezar a curarse."

#: lang/json/mutation_from_json.py
msgid "Your hyper-metabolism starts burning up calories."
msgstr "Tu hipermetabolismo empieza a quemar calorías."

#: lang/json/mutation_from_json.py
msgid "Hyper-Metabolism: burning"
msgstr "Hiper-Metabolismo: quemando"

#. ~ Description for {'str': 'Hyper-Metabolism: burning'}
#: lang/json/mutation_from_json.py
msgid "You're burning calories like crazy to heal your wounds."
msgstr "Estás quemando calorías como loco para curar tus heridas."

#: lang/json/mutation_from_json.py
msgid "Your hyper-metabolism slows down."
msgstr "Tu hipermetabolismo comienza a hacer más lento."

#: lang/json/mutation_from_json.py
msgid "Horns"
msgstr "Cuernos"

#. ~ Description for {'str': 'Horns'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack."
msgstr ""
"Tenés un par de pequeños cuernos en la cabeza. Te permiten causar un poco de"
" daño punzante con tu cabezazo."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You headbutt %s with your horns"
msgstr "Le das un cabezazo al %s con tus cuernos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s headbutts %2$s with their horns"
msgstr "%1$s le da un cabezazo al %2$s con sus cuernos"

#: lang/json/mutation_from_json.py
msgid "Curled Horns"
msgstr "Cuernos Enroscados"

#. ~ Description for {'str': 'Curled Horns'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent wearing any headwear."
msgstr ""
"Tenés un par de cuernos largos enroscados, como los de un carnero. Te "
"permiten causar mucho daño golpeante con tus cabezazos, pero te impiden "
"utilizar equipo en la cabeza."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You headbutt %s with your curled horns"
msgstr "Le das un cabezazo al %s con tus cuernos enroscados"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s headbutts %2$s with their curled horns"
msgstr "%1$s le da un cabezazo al %2$s con sus cuernos enroscados"

#: lang/json/mutation_from_json.py
msgid "Pointed Horns"
msgstr "Cuernos Puntiagudos"

#. ~ Description for {'str': 'Pointed Horns'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent wearing "
"headwear that is not made of fabric."
msgstr ""
"Tenés un par de cuernos largos y puntiagudos, como los de un antílope. Te "
"permiten causar mucho daño punzante con tus cabezazos, pero te impiden "
"utilizar equipo en la cabeza que no sea de tela."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You stab %s with your pointed horns"
msgstr "Apuñalás al %s con tus cuernos puntiagudos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stabs %2$s with their pointed horns"
msgstr "%1$s apuñala al %2$s con sus cuernos puntiagudos"

#: lang/json/mutation_from_json.py
msgid "Antlers"
msgstr "Astas"

#. ~ Description for {'str': 'Antlers'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a huge rack of antlers, like those of a moose.  They allow you to "
"make a weak headbutt attack, but prevent wearing headwear that is not made "
"of fabric."
msgstr ""
"Tenés unos enormes cuernos, como los de un alce. Te permiten realizar un "
"débil ataque de cabeza, pero evita que puedas usar algo en la cabeza que no "
"esté hecho de tela."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You butt %s with your antlers"
msgstr "Corneás al %s con tus astas"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s butts %2$s with their antlers"
msgstr "%1$s cornea al %2$s con sus astas"

#: lang/json/mutation_from_json.py
msgid "Antennae"
msgstr "Antenas"

#. ~ Description for {'str': 'Antennae'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent wearing headwear that is not made of fabric."
msgstr ""
"Tenés un par de antenas. Te permiten detectar la presencia del enemigo "
"dentro de un rango corto, aunque no los puedas ver ni oir. Te impide usar "
"equipo para la cabeza que no sea de tela."

#: lang/json/mutation_from_json.py
msgid "Road-Runner"
msgstr "Correcaminos"

#. ~ Description for {'str': 'Road-Runner'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat"
" surfaces."
msgstr ""
"Tus piernas son extremadamente flexibles y rápidas. Te movés un 30% más "
"rápido en superficies planas."

#: lang/json/mutation_from_json.py
msgid "Stubby Tail"
msgstr "Cola Regordeta"

#. ~ Description for {'str': 'Stubby Tail'}
#: lang/json/mutation_from_json.py
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr ""
"Tenés una cola regordeta, corta, como la de un conejo. No te sirve para "
"nada."

#: lang/json/mutation_from_json.py
msgid "Tail Fin"
msgstr "Aleta Caudal"

#. ~ Description for {'str': 'Tail Fin'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr ""
"Tenés una cola que parece una aleta, como un pez. Te permite nadar más "
"rápido, pero no te permite utilizar pantalones que no sean de tela. "
"Incrementa levemente los beneficios de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Long Tail"
msgstr "Cola Larga"

#. ~ Description for {'str': 'Long Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-"
"fabric pants."
msgstr ""
"Tenés una cola larga y elegante, como la de un felino grande. Mejora tu "
"balance, lo que incrementa tu habilidad de esquivar, pero no te permite "
"utilizar pantalones que no sean de tela."

#: lang/json/mutation_from_json.py
msgid "Cattle Tail"
msgstr "Cola de Ganado"

#. ~ Description for {'str': 'Cattle Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail with a tuft on the end.  You find yourself "
"instinctively swatting away flies with it, though it's not as effective at "
"balancing you as you'd like.  Prevents wearing non-fabric pants."
msgstr ""
"Tenés una cola larga con un penacho en la punta. Instintivamente, la usás "
"para sacarte las moscas de encima, pero no es tan buena para el balance como"
" te hubiera gustado. No te permite utilizar pantalones que no sean de tela."

#: lang/json/mutation_from_json.py
msgid "Rodent Tail"
msgstr "Cola de Roedor"

#. ~ Description for {'str': 'Rodent Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr ""
"Tenés una cola larga y pelada. Es una ayuda bastante efectiva para tu "
"balance, pero parece... eh... de rata. No te permite utilizar pantalones que"
" no sean de tela."

#: lang/json/mutation_from_json.py
msgid "Thick Tail"
msgstr "Cola Gruesa"

#. ~ Description for {'str': 'Thick Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but "
"also makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr ""
"Tenés una cola larga y gruesa, como la de un lagarto. Ayuda un poco tu "
"balance pero también sirve como látigo. No te permite utilizar pantalones "
"que no sean de tela."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You whap %s with your tail"
msgstr "Le pegás al %s con tu cola"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s whaps %2$s with their tail"
msgstr "%1$s le pega al %2$s con su cola"

#: lang/json/mutation_from_json.py
msgid "Raptor Tail"
msgstr "Cola de Raptor"

#. ~ Description for {'str': 'Raptor Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long and semi-stiff lizardlike tail.  You can't effectively "
"strike with it in combat, but it significantly improves your balance.  "
"Prevents wearing non-fabric pants."
msgstr ""
"Tenés una cola larga y semi-rígida como la de un lagarto. No podés usarla "
"efectivamente en combate, pero incrementa notablemente tu balance. No te "
"permite utilizar pantalones que no sean de tela."

#: lang/json/mutation_from_json.py
msgid "Fluffy Tail"
msgstr "Cola Peludita"

#. ~ Description for {'str': 'Fluffy Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric "
"pants."
msgstr ""
"Tenés una cola larga y peludita. Mejora mucho tu balance, lo que incrementa "
"tu capacidad para esquivar. No te permite utilizar pantalones que no sean de"
" tela."

#: lang/json/mutation_from_json.py
msgid "Spiked Tail"
msgstr "Cola Aguijón"

#. ~ Description for {'str': 'Spiked Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a vicious stinger.  It does not improve "
"your balance at all, but allows for a powerful piercing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Tenés una cola larga que termina con un feroz aguijón. No te mejora el "
"balance para nada, pero te permite tener un poderoso ataque punzante. No te "
"permite utilizar pantalones que no sean de tela."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You sting %s with your tail"
msgstr "Picás al %s con tu cola"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stings %2$s with their tail"
msgstr "%1$s pica al %2$s con su cola"

#: lang/json/mutation_from_json.py
msgid "Club Tail"
msgstr "Cola Garrote"

#. ~ Description for {'str': 'Club Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Tenés una cola larga que termina en un garrote óseo pesado. No te mejora le "
"balance para nada, pero te permite tener un poderoso ataque golpeante. No te"
" permite utilizar pantalones que no sean de tela"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You club %s with your tail"
msgstr "Aporreás al %s con tu cola"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s clubs %2$s with their tail"
msgstr "¡%1$s aporrea al %2$s con su cola!"

#: lang/json/mutation_from_json.py
msgid "Hibernation"
msgstr "Hibernación"

#. ~ Description for {'str': 'Hibernation'}
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr ""
"Has desarrollado la habilidad de almacenar calorías y luego dormir por "
"períodos extensos de tiempo."

#: lang/json/mutation_from_json.py
msgid "Resilient"
msgstr "Resiliencia"

#. ~ Description for {'str': 'Resilient'}
#. ~ Description for Immovable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus"
" to all hit points.  Stacks with Tough, etc."
msgstr ""
"Podés sobrevivir a heridas que incapacitarían a otros humanos: tenés un 20% "
"de bonus a tus puntos de vida. Es acumulativo con Duro, etc."

#: lang/json/mutation_from_json.py
msgid "Solidly Built"
msgstr "Fornido/a"

#. ~ Description for {'str': 'Solidly Built'}
#. ~ Description for Unstoppable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr ""
"No hay muchas cosas que te asusten. Tenés un 30% de bonus a tus puntos de "
"vida. Es acumulativo con Duro, etc."

#: lang/json/mutation_from_json.py
msgid "TAAANK"
msgstr "TAAANQUE"

#. ~ Description for {'str': 'TAAANK'}
#. ~ Description for Meatshield
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr ""
"Simplemente, podés recibir el castigo de seres más pequeños y seguir como si"
" nada. Tenés un 40% de bonus a tus puntos de vida. Es acumulativo con Duro, "
"etc."

#: lang/json/mutation_from_json.py
msgid "Pain Recovery"
msgstr "Recuperación del Dolor"

#. ~ Description for {'str': 'Pain Recovery'}
#: lang/json/mutation_from_json.py
msgid "You recover from pain slightly faster than normal."
msgstr "Te recuperás del dolor un poco más rápido que lo normal."

#: lang/json/mutation_from_json.py
msgid "Quick Pain Recovery"
msgstr "Recuperación Rápida del Dolor"

#. ~ Description for {'str': 'Quick Pain Recovery'}
#: lang/json/mutation_from_json.py
msgid "You recover from pain faster than normal."
msgstr "Te recuperás del dolor más rápido que lo normal."

#: lang/json/mutation_from_json.py
msgid "Very Quick Pain Recovery"
msgstr "Recuperación Muy Rápida del Dolor"

#. ~ Description for {'str': 'Very Quick Pain Recovery'}
#: lang/json/mutation_from_json.py
msgid "You recover from pain much faster than normal."
msgstr "Te recuperás del dolor mucho más rápido que lo normal."

#: lang/json/mutation_from_json.py
msgid "Pain Junkie"
msgstr "Adicción al Dolor"

#. ~ Description for {'str': 'Pain Junkie'}
#: lang/json/mutation_from_json.py
msgid ""
"You've developed a serious appetite for pain, and take pride in your scars."
msgstr ""
"Desarrollaste un serio apetito por el dolor, y mostrás con orgullo tus "
"cicatrices."

#: lang/json/mutation_from_json.py
msgid "Cenobite"
msgstr "Cenobita"

#. ~ Description for {'str': 'Cenobite'}
#: lang/json/mutation_from_json.py
msgid "You positively adore pain, in all its varied forms."
msgstr "Ciertamente, adorás el dolor, en todas sus variedades posibles."

#: lang/json/mutation_from_json.py
msgid "Deadened"
msgstr "Mitigado/a"

#. ~ Description for {'str': 'Deadened'}
#: lang/json/mutation_from_json.py
msgid ""
"Nothing hurts anymore.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr ""
"Ya nada te duele. Esas mordidas te hacen cosquillas y las heridas te pican "
"un poco, pero nada más."

#: lang/json/mutation_from_json.py
msgid "Pain Sensitive"
msgstr "Sensible al Dolor"

#. ~ Description for {'str': 'Pain Sensitive'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"For some reason, things always seem to hurt you more.  Pain dealt to you is "
"increased by 25%."
msgstr ""
"Por alguna razón, siempre parece que todo te duele más. El dolor que sufrís "
"tiene un incremento del 25%."

#: lang/json/mutation_from_json.py
msgid "Hyperalgesia"
msgstr "Hiperalgesia"

#. ~ Description for {'str': 'Hyperalgesia'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body experiences pain out of proportion to the physical causes.  Pain "
"dealt to you is increased by 50%."
msgstr ""
"Tu cuerpo experimenta el dolor fuera de proporción con la causa física. El "
"dolor que sufrís tiene un incremento del 50%."

#: lang/json/mutation_from_json.py
msgid "Extreme Hyperalgesia"
msgstr "Hiperalgesia Extrema"

#. ~ Description for {'str': 'Extreme Hyperalgesia'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body reacts cripplingly to any source of pain.  Pain dealt to you is "
"doubled."
msgstr ""
"Tu cuerpo queda incapacitado ante cualquier causa de dolor. El dolor que "
"sufrís se duplica."

#: lang/json/mutation_from_json.py
msgid "Culler"
msgstr "Sacrificio"

#. ~ Description for {'str': 'Culler'}
#: lang/json/mutation_from_json.py
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die"
" anyway, you preserve resources for those better able to survive.  You are "
"less bothered by the deaths of others: their own weakness invited these "
"fates upon them."
msgstr ""
"Has tenido una revelación: matando a las criaturas más débiles, que de todas"
" maneras morirían, lográs preservar recursos para aquellos que están aptos "
"para la supervivencia. No te molesta tanto la muerte de los otros: sus "
"propias debilidades los llevaron a ese destino."

#: lang/json/mutation_from_json.py lang/json/npc_class_from_json.py
#: lang/json/npc_from_json.py
msgid "Hunter"
msgstr "Cazador/a"

#. ~ Description for {'str': 'Hunter'}
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has a lot more in common with a predatory animal than a human, "
"making it easier to control misplaced reactions to the death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easier to learn and "
"maintain."
msgstr ""
"Tu cerebro tiene más cosas en común con un animal predador que con un "
"humano, lo que te hace más fácil controlar las reacciones a la muerte de tu "
"presa. Además, las habilidades de combate, que usás para cazar, son más "
"fáciles de aprender y mantener."

#: lang/json/mutation_from_json.py
msgid "Predator"
msgstr "Depredador/a"

#. ~ Description for {'str': 'Predator'}
#: lang/json/mutation_from_json.py
msgid ""
"You consider yourself something other than human and no longer empathize "
"with them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr ""
"Te considerás a vos mismo algo distinto a lo humano y ya no tenés empatía "
"con ellos. Las habilidades de combate son más fáciles de aprender y "
"mantener, pero tu pensamiento crítico, tan característico de estas "
"criaturas, se ve afectado."

#: lang/json/mutation_from_json.py
msgid "Apex Predator"
msgstr "SuperDepredador/a"

#. ~ Description for {'str': 'Apex Predator'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top of the food chain.  You can effortlessly master and maintain combat "
"skills, but your critical thinking has atrophied further."
msgstr ""
"Tu mente y cerebro se han adaptado a tu nuevo lugar en el mundo: el de uno "
"en la punta de la pirámide alimenticia. Sin esfuerzo, podés perfeccionar y "
"mantener tus habilidades de combate, pero tu pensamiento crítico se ha "
"atrofiado aún más."

#: lang/json/mutation_from_json.py
msgid "Sapiovore"
msgstr "Sapióvoro/a"

#. ~ Description for {'str': 'Sapiovore'}
#: lang/json/mutation_from_json.py
msgid "The hairless apes make as good eating as any other meat."
msgstr "Esos simios sin pelo son tan buena comida como cualquier otra carne."

#: lang/json/mutation_from_json.py
msgid "Pack Hunter"
msgstr "Cazador de Manada"

#. ~ Description for {'str': 'Pack Hunter'}
#: lang/json/mutation_from_json.py
msgid ""
"Puny as they may seem, a hunter needs a pack, and some of those hairless "
"bipeds may yet prove some worth.  You continue to gain combat skills at an "
"elevated rate, and maintain a level of critical thinking that supports "
"cooperation."
msgstr ""
"Aunque suene un poco cobarde, un cazador necesita una manada y algunos de "
"esos bípedos sin pelo pueden tener algún valor. Continuás ganando "
"habilidades de combate a una velocidad elevada, y mantenés un nivel de "
"pensamiento crítico que acepta la cooperación."

#: lang/json/mutation_from_json.py
msgid "Mycus Defender"
msgstr "Defensor/a Mycus"

#. ~ Description for {'str': 'Mycus Defender'}
#: lang/json/mutation_from_json.py
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this task"
" - our fibers will grow strong and resilient when such threats present "
"themselves to us."
msgstr ""
"De vez en cuando, el Mycus necesita protección de los no-Mycus que, por "
"alguna razón, quieren dañarlo. Nos hemos adaptado para cumplir con esa tarea"
" defensiva - nuestras fibras crecerán fuertes y resistentes cuando se nos "
"presenten esas amenazas."

#: lang/json/mutation_from_json.py
msgid "Bird Wings"
msgstr "Alas de pájaro"

#. ~ Description for {'str': 'Bird Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, feathered wings.  Your body is too heavy to be "
"able to fly, but you can use them to slow your descent during a fall, and "
"will not take falling damage under any circumstances."
msgstr ""
"Tenés un par de alas largas con plumas. Tu cuerpo es muy pesado para poder "
"volar, pero podés usarlas para frenar una caída y no sufrir daño en ninguna "
"circunstancia."

#: lang/json/mutation_from_json.py
msgid "Insect Wings"
msgstr "Alas de Insecto"

#. ~ Description for {'str': 'Insect Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, translucent wings.  They are too small to lift "
"you, but are powerful enough to greatly speed your movement, with some "
"effort and noise."
msgstr ""
"Tenés un par de alas grandes y translúcidas. Son muy pequeñas para "
"levantarte, pero lo suficientemente fuertes para aumentar tu velocidad de "
"movimiento, con un poco de esfuerzo y ruido."

#: lang/json/mutation_from_json.py
msgid "Mouth Tentacles"
msgstr "Tentáculos Bucales"

#. ~ Description for {'str': 'Mouth Tentacles'}
#. ~ Description for Facial Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr ""
"Un grupo de tentáculos te rodea la boca. Te permiten comer el doble de "
"rápido. Disminuye levemente las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Mandibles"
msgstr "Mandíbulas"

#. ~ Description for {'str': 'Mandibles'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you"
" to eat faster and provide a slicing unarmed attack, but prevent wearing "
"mouthwear.  Slightly reduces wet effects."
msgstr ""
"Te han crecido alrededor de la boca, unas mandíbulas como las de los "
"insectos. Te permiten comer más rápido y te dan un ataque desarmado "
"cortante, pero no te permiten usar nada sobre la boca. Disminuye levemente "
"los efectos por estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite %s with your fangs"
msgstr "Mordés al %s con tus colmillos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s with their fangs"
msgstr "%1$s muerde al %2$s con sus colmillos"

#: lang/json/mutation_from_json.py
msgid "Folding Fangs"
msgstr "Colmillos Plegables"

#. ~ Description for {'str': 'Folding Fangs'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mandibles have developed extensible fangs, allowing you to bite quickly"
" or ensure your venom goes home, as desired."
msgstr ""
"Tus mandíbulas han desarrollado colmillos extensibles, lo que te permite "
"morder rápido o asegurar que tu veneno llegue a destino, cuando quieras."

#: lang/json/mutation_from_json.py
msgid "Canine Ears"
msgstr "Orejas Caninas"

#. ~ Description for {'str': 'Canine Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed ones, like those of a canine.  "
"They enhance your hearing, allowing you to hear at greater distances."
msgstr ""
"Tus orejas se extienden largas y puntiagudas, como las de los caninos. "
"Aumentan tu audición, lo que te permite escuchar a grandes distancias."

#: lang/json/mutation_from_json.py
msgid "Lupine Ears"
msgstr "Orejas Lobunas"

#. ~ Description for {'str': 'Lupine Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing has evolved further and is now on par with that of wolves.  You"
" can hear things significantly farther away."
msgstr ""
"Tu audición ha evolucionado más y ya es del mismo nivel que la de los lobos."
" Podés escuchar cosas que están considerablemente alejadas."

#: lang/json/mutation_from_json.py
msgid "Feline Ears"
msgstr "Orejas Felinas"

#. ~ Description for {'str': 'Feline Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr ""
"Tus orejas se extienden largas, puntiagudas y aterciopeladas, como las de "
"los felinos. Te resulta más fácil captar sonidos desde lejos."

#: lang/json/mutation_from_json.py
msgid "Ursine Ears"
msgstr "Orejas Osunas"

#. ~ Description for {'str': 'Ursine Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can"
" hear things a little farther away."
msgstr ""
"Tus orejas han crecido largas y redondas, muy parecidas a las de los osos. "
"Ahora escuchás cosas que están un poco más lejos."

#: lang/json/mutation_from_json.py
msgid "Pointed Ears"
msgstr "Orejas Puntiagudas"

#. ~ Description for {'str': 'Pointed Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr ""
"Tus lóbulos superiores han crecido notablemente altos. Por suerte, no te "
"molestan para usar cosas en la cabeza, no mucho. Pero, no te mejoran la "
"audición."

#: lang/json/mutation_from_json.py
msgid "Rodent Ears"
msgstr "Orejas de Roedor"

#. ~ Description for {'str': 'Rodent Ears'}
#: lang/json/mutation_from_json.py
msgid ""
"Your ears are huge, round, and gray!  They're rather fascinating, and help "
"you hear from a much greater distance."
msgstr ""
"¡Tus orejas son enormes, redondas y grises! Son fascinantes y te ayudan a "
"escuchar a mucha mayor distancia."

#: lang/json/mutation_from_json.py
msgid "Web Walker"
msgstr "Caminante de Telarañas"

#. ~ Description for {'str': 'Web Walker'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr ""
"Tu cuerpo segrega grandes cantidades de un químico que evita que te pegues "
"en las telarañas. Caminar a través de las telarañas no te afecta para nada."

#: lang/json/mutation_from_json.py
msgid "Web Spinner"
msgstr "Hilandero/a de Telarañas"

#. ~ Description for {'str': 'Web Spinner'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr ""
"Tu cuerpo produce y coloca telarañas. Lo malo es que parece que no controlás"
" ese proceso. Hay una posibilidad de que dejes telarañas como estela."

#: lang/json/mutation_from_json.py
msgid "Web Weaver"
msgstr "Tejedor/a de Telarañas"

#. ~ Description for {'str': 'Web Weaver'}
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the necessary anatomy and techniques to control your web-"
"generation.  Activate this to start or stop weaving webs."
msgstr ""
"Has desarrollado la anatomía necesaria y las técnicas para controlar tu "
"generación de telarañas. Hay que activar esta habilidad para empezar o dejar"
" de tejer telarañas."

#: lang/json/mutation_from_json.py
msgid "Web Diver"
msgstr "Saltador/a de Telarañas"

#. ~ Description for {'str': 'Web Diver'}
#: lang/json/mutation_from_json.py
msgid ""
"Your webbing is easily strong enough to support your weight.  You'll use it "
"to descend any sheer drops you may encounter."
msgstr ""
"Tus telarañas son lo suficientemente fuertes como para soportar tu peso. Las"
" usarás para descender cualquier desnivel brusco que te encuentres."

#: lang/json/mutation_from_json.py
msgid "Rope Webs"
msgstr "Soga de Telarañas"

#. ~ Description for {'str': 'Rope Webs'}
#: lang/json/mutation_from_json.py
msgid ""
"With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr ""
"Con un hilador de telarañas como este, ¿quién necesita sogas? Activalo para "
"producir tu propia soga."

#: lang/json/mutation_from_json.py
msgid "You spin a rope from your silk."
msgstr "Creás una soga con tu seda."

#: lang/json/mutation_from_json.py
msgid "Whiskers"
msgstr "Bigotes"

#. ~ Description for {'str': 'Whiskers'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a handsome set of feline whiskers around your mouth.  These make "
"you more aware of vibrations in the air, and improve your ability to dodge "
"very slightly."
msgstr ""
"Tenés unos lindos bigotes felinos a los costados de tu boca. Te hacen más "
"consciente de las vibraciones del aire, y mejora muy levemente tu habilidad "
"para esquivar."

#: lang/json/mutation_from_json.py
msgid "Wiry Whiskers"
msgstr "Bigotes Tiesos"

#. ~ Description for {'str': 'Wiry Whiskers'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr ""
"Tenés unos bigotes prominentes como los de los roedores en los costados de "
"tu boca. Te hacen más consciente de las vibraciones del aire, y mejora "
"levemente tu habilidad para esquivar."

#: lang/json/mutation_from_json.py
msgid "Fat Deposits"
msgstr "Depósitos de Grasa"

#. ~ Description for {'str': 'Fat Deposits'}
#: lang/json/mutation_from_json.py
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr ""
"Pusiste un poco más de peso alrededor de tu cuerpo. Te hace un poco más "
"lento, pero te ayuda a nadar y te abriga."

#: lang/json/mutation_from_json.py
msgid "Inconveniently Large"
msgstr "Inconvenientemente Grande"

#. ~ Description for {'str': 'Inconveniently Large'}
#. ~ Description for Elephantine
#: lang/json/mutation_from_json.py
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr ""
"Te has hecho notablemente más alto y ancho. La mayoría es masa muscular útil"
" (Fuerza +2), pero notás que te quita el balance y estás más torpe (+10 de "
"incomodidad en torso y brazos)."

#: lang/json/mutation_from_json.py
msgid "Large"
msgstr "Grande"

#. ~ Description for {'str': 'Large'}
#. ~ Description for Large
#: lang/json/mutation_from_json.py
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr "Cargás tu robusto cuerpo con la dignidad que se merece. Fuerza +2."

#: lang/json/mutation_from_json.py
msgid "Freakishly Huge"
msgstr "Peculiarmente Enorme"

#. ~ Description for {'str': 'Freakishly Huge'}
#. ~ Description for Freakishly Gigantic
#. ~ Description for {'str': 'Freakish Draconic Maturity'}
#: lang/json/mutation_from_json.py
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit"
" into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr ""
"Has crecido todavía más, al punto que ya no entrás en la ropa tamaño humano "
"normal ni en los vehículos. La mayor parte de lo crecido es poderosa masa "
"muscular (Fuerza +4), pero es un verdadero problema ir acarreando tu cuerpo."

#: lang/json/mutation_from_json.py
msgid "Huge"
msgstr "Enorme"

#. ~ Description for {'str': 'Huge'}
#. ~ Description for Gigantic
#. ~ Description for {'str': 'Draconic Maturity'}
#: lang/json/mutation_from_json.py
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who"
" needs pathetic human cars?  Strength +4."
msgstr ""
"Tu sistema cardiovascular ha llegado al mismo nivel que tu físico, así que "
"¿quién necesita esos patéticos autos de humanos? Fuerza +4."

#: lang/json/mutation_from_json.py
msgid "Strong"
msgstr "Fuerte"

#. ~ Description for {'str': 'Strong'}
#: lang/json/mutation_from_json.py
msgid "Your muscles are a little stronger.  Strength + 1"
msgstr "Tus músculos son un poco más fuertes. Fuerza +1."

#: lang/json/mutation_from_json.py
msgid "Very Strong"
msgstr "Muy Fuerte"

#. ~ Description for {'str': 'Very Strong'}
#: lang/json/mutation_from_json.py
msgid "Your muscles are stronger.  Strength + 2"
msgstr "Tus músculos son más fuertes. Fuerza +2."

#: lang/json/mutation_from_json.py
msgid "Extremely Strong"
msgstr "Extremadamente Fuerte"

#. ~ Description for {'str': 'Extremely Strong'}
#: lang/json/mutation_from_json.py
msgid "Your muscles are much stronger.  Strength + 4"
msgstr "Tus músculos son mucho más fuertes. Fuerza +4."

#: lang/json/mutation_from_json.py
msgid "Insanely Strong"
msgstr "Terriblemente Fuerte"

#. ~ Description for {'str': 'Insanely Strong'}
#: lang/json/mutation_from_json.py
msgid "Your muscles are noticeably bulging.  Strength + 7"
msgstr "Tus músculos son notablemente más fuertes. Fuerza +7."

#: lang/json/mutation_from_json.py
msgid "Prime Strength"
msgstr "Fuerza Suprema"

#. ~ Description for {'str': 'Prime Strength'}
#: lang/json/mutation_from_json.py
msgid "Your muscles are perfectly developed."
msgstr "Tus músculos están perfectamente desarrollados."

#: lang/json/mutation_from_json.py
msgid "Dextrous"
msgstr "Diestro/a"

#. ~ Description for {'str': 'Dextrous'}
#: lang/json/mutation_from_json.py
msgid "You are a little nimbler.  Dexterity + 1"
msgstr "Sos un poco más ágil. Destreza +1."

#: lang/json/mutation_from_json.py
msgid "Very Dextrous"
msgstr "Muy Diestro/a"

#. ~ Description for {'str': 'Very Dextrous'}
#: lang/json/mutation_from_json.py
msgid "You are nimbler.  Dexterity + 2"
msgstr "Sos más ágil. Destreza +2."

#: lang/json/mutation_from_json.py
msgid "Extremely Dextrous"
msgstr "Extremadamente Diestro/a"

#. ~ Description for {'str': 'Extremely Dextrous'}
#: lang/json/mutation_from_json.py
msgid "You are nimble and quick.  Dexterity + 4"
msgstr "Sos más ágil y rápido. Destreza +4."

#: lang/json/mutation_from_json.py
msgid "Insanely Dextrous"
msgstr "Terriblemente Diestro/a"

#. ~ Description for {'str': 'Insanely Dextrous'}
#: lang/json/mutation_from_json.py
msgid "You are much nimbler than before.  Dexterity + 7"
msgstr "Sos mucho más ágil que antes. Destreza +7."

#: lang/json/mutation_from_json.py
msgid "Prime Dexterity"
msgstr "Destreza Suprema"

#. ~ Description for {'str': 'Prime Dexterity'}
#: lang/json/mutation_from_json.py
msgid "You're perfectly coordinated."
msgstr "Tenés una coordinación perfecta."

#: lang/json/mutation_from_json.py
msgid "Smart"
msgstr "Inteligente"

#. ~ Description for {'str': 'Smart'}
#: lang/json/mutation_from_json.py
msgid "You are a little smarter.  Intelligence + 1"
msgstr "Sos un poco más inteligente. Inteligencia +1."

#: lang/json/mutation_from_json.py
msgid "Very Smart"
msgstr "Muy Inteligente"

#. ~ Description for {'str': 'Very Smart'}
#: lang/json/mutation_from_json.py
msgid "You are smarter.  Intelligence + 2"
msgstr "Sos más inteligente. Inteligencia +2."

#: lang/json/mutation_from_json.py
msgid "Extremely Smart"
msgstr "Extremadamente Ingeligente"

#. ~ Description for {'str': 'Extremely Smart'}
#: lang/json/mutation_from_json.py
msgid ""
"You are much smarter, and your skull bulges slightly.  Intelligence + 4"
msgstr ""
"Sos mucho más inteligente, y tu cráneo aumentó un poco de tamaño. "
"Inteligencia +4."

#: lang/json/mutation_from_json.py
msgid "Insanely Smart"
msgstr "Terriblemente Inteligente"

#. ~ Description for {'str': 'Insanely Smart'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skull bulges noticeably due to your impressive brain.  Intelligence + 7"
msgstr ""
"Tu cráneo aumentó notablemente de tamaño, debido a tu impresionante cerebro."
" Inteligencia +7."

#: lang/json/mutation_from_json.py
msgid "Prime Intelligence"
msgstr "Inteligencia Suprema"

#. ~ Description for {'str': 'Prime Intelligence'}
#: lang/json/mutation_from_json.py
msgid ""
"You understand almost everything about which you think, with minimal effort."
msgstr "Entendés casi todo lo que podés pensar, con un esfuerzo mínimo."

#: lang/json/mutation_from_json.py
msgid "Distributed Neurology"
msgstr "Neurología Distribuida"

#. ~ Description for {'str': 'Distributed Neurology'}
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr ""
"Tu cerebro ha evolucionado más allá de las posibilidades humanas. ¡Ahora les"
" vas a mostrar el VERDADERO sentido de 'materia gris'!"

#: lang/json/mutation_from_json.py
msgid "Perceptive"
msgstr "Perceptivo/a"

#. ~ Description for {'str': 'Perceptive'}
#: lang/json/mutation_from_json.py
msgid "Your senses are a little keener.  Perception + 1"
msgstr "Tus sentidos son un poco más agudos. Percepción +1."

#: lang/json/mutation_from_json.py
msgid "Very Perceptive"
msgstr "Muy Perceptivo/a"

#. ~ Description for {'str': 'Very Perceptive'}
#: lang/json/mutation_from_json.py
msgid "Your senses are keener.  Perception + 2"
msgstr "Tus sentidos son más agudos. Percepción +2."

#: lang/json/mutation_from_json.py
msgid "Extremely Perceptive"
msgstr "Extremadamente Perceptivo/a"

#. ~ Description for {'str': 'Extremely Perceptive'}
#: lang/json/mutation_from_json.py
msgid "Your senses are much keener.  Perception + 4"
msgstr "Tus sentidos son mucho más agudos. Percepción +4."

#: lang/json/mutation_from_json.py
msgid "Insanely Perceptive"
msgstr "Terriblemente Perceptivo/a"

#. ~ Description for {'str': 'Insanely Perceptive'}
#: lang/json/mutation_from_json.py
msgid "You can sense things you never imagined.  Perception + 7"
msgstr "Podés percibir cosas que nunca te imaginaste. Percepción +7."

#: lang/json/mutation_from_json.py
msgid "Prime Perception"
msgstr "Percepción Suprema"

#. ~ Description for {'str': 'Prime Perception'}
#: lang/json/mutation_from_json.py
msgid "Your senses are keenly honed."
msgstr "Tus sentidos están perfectamente agudizados."

#: lang/json/mutation_from_json.py
msgid "Sensory Disintegration"
msgstr "Desintegración Sensorial"

#. ~ Description for {'str': 'Sensory Disintegration'}
#: lang/json/mutation_from_json.py
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr ""
"Tus órganos sensoriales están por todos lados: ojos que se extienden y "
"retraen, 'orejas' de diversas formas, y el gusto y el olfato son "
"incontrolables. El mundo es una terrible confusión. ¡Puf!"

#: lang/json/mutation_from_json.py
msgid "Distributed Senses"
msgstr "Sentidos Distribuidos"

#. ~ Description for {'str': 'Distributed Senses'}
#: lang/json/mutation_from_json.py
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr ""
"Ahora podés extender y reabsorber a voluntad tus órganos sensoriales, y por "
"lo tanto ignorás las conmociones que abrumarían a seres inferiores."

#: lang/json/mutation_from_json.py
msgid "Little"
msgstr "Chico/a"

#. ~ Description for {'str': 'Little'}
#: lang/json/mutation_from_json.py
msgid ""
"You've noticeably shrunk in size.  You're able to move with increased "
"litheness, but your smaller stature prevents you from carrying as much."
msgstr ""
"Te has achicado notablemente. Sos capaz de moverte con mayor agilidad, pero "
"tu baja estatura no te permite llevar muchas cosas."

#: lang/json/mutation_from_json.py
msgid "Tiny"
msgstr "Pequeño/a"

#. ~ Description for {'str': 'Tiny'}
#: lang/json/mutation_from_json.py
msgid ""
"You're only half as tall as you used to be!  The weight of things you once "
"found easy to carry is now unbearable, clothes are now twice as encumbering "
"for you unless you refit them (since you're half their size), and your hit "
"points are heavily reduced.  However, your movement is silent, and your "
"dodge skill is a little higher."
msgstr ""
"¡Sos la mitad de alto/a de lo que eras antes! El peso de las cosas que antes"
" parecían fácil de llevar ahora te resulta insoportable. La ropa es el doble"
" de incómoda salvo que la reajustes, y tus puntos de vidas se han reducido. "
"Sin embargo, tu movimiento es silencioso y tu habilidad para esquivar es un "
"poco mayor."

#: lang/json/mutation_from_json.py
msgid "Unassuming"
msgstr "Insignificante"

#. ~ Description for {'str': 'Unassuming'}
#: lang/json/mutation_from_json.py
msgid ""
"You've mastered your tiny form!  Item encumbrance and carry weight penalties"
" are reduced, and you've learned to use your increased nimbleness to offset "
"your reduced capacity to absorb damage."
msgstr ""
"¡Sos un experto en ser de tamaño pequeño! Las penalidades por incomodidad y "
"peso de los objetos se reducen, y aprendiste a utilizar tu agilidad para "
"compensar tu capacidad reducida con absorción de daño."

#: lang/json/mutation_from_json.py
msgid "Crafty"
msgstr "Astuto/a"

#. ~ Description for {'str': 'Crafty'}
#: lang/json/mutation_from_json.py
msgid ""
"By making the most of your small stature, you can avoid the notice of all "
"but the most perceptive creatures, and your speed is greatly increased."
msgstr ""
"Sacás lo mejor de tu pequeña estatura, podés pasar inadvertido para las "
"criaturas más perceptivas, y tu velocidad es mucho mayor."

#: lang/json/mutation_from_json.py
msgid "Metallassomaiphile"
msgstr "Metallassomáfilo/a"

#. ~ Description for {'str': 'Metallassomaiphile'}
#: lang/json/mutation_from_json.py
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr ""
"Con solo pensar en mutágeno (¡qué linda palabra! 'Mutágeno'. ¡Perfecta!) te "
"agarra sed. Y te fascinan tus partes nuevas. ¡Necesitás conseguir más "
"mutágeno!"

#: lang/json/mutation_from_json.py
msgid "Head Bumps"
msgstr "Protuberancias en la Cabeza"

#. ~ Description for {'str': 'Head Bumps'}
#: lang/json/mutation_from_json.py
msgid "You have a pair of bumps on your skull."
msgstr "Tenés un par de protuberancias en el cráneo."

#: lang/json/mutation_from_json.py
msgid "Slit Nostrils"
msgstr "Tajos Nasales"

#. ~ Description for {'str': 'Slit Nostrils'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a lizard-"
"like appearance.  This makes breathing slightly difficult and increases "
"mouth encumbrance by 10."
msgstr ""
"Tenés la nariz aplanada y tus fosas nasales son unos tajos delgados, lo que "
"te da una apariencia de lagarto. Esto te dificulta levemente la respiración "
"e incrementa la incomodidad en tu boca en 10 puntos."

#: lang/json/mutation_from_json.py
msgid "Forked Tongue"
msgstr "Lengua Bífida"

#. ~ Description for {'str': 'Forked Tongue'}
#: lang/json/mutation_from_json.py
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr ""
"Tu lengua está bifurcada, como la de un reptil. Esto no tiene ningún efecto."

#: lang/json/mutation_from_json.py
msgid "Bulging Eyes"
msgstr "Ojos Saltones"

#. ~ Description for {'str': 'Bulging Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr ""
"Tus ojos sobresalen algunos centímetros de tu cráneo. Esto no afecta tu "
"visión de ninguna manera."

#: lang/json/mutation_from_json.py
msgid "Mouth Flaps"
msgstr "Aletas Bucales"

#. ~ Description for {'str': 'Mouth Flaps'}
#. ~ Description for Mouth Tendrils
#: lang/json/mutation_from_json.py
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your"
" eating, but are unpleasant to look at."
msgstr ""
"Unas extrañas aletas y lengüetas de piel rodean tu boca. No te molestan para"
" comer, pero son desagradables de ver."

#: lang/json/mutation_from_json.py
msgid "Wing Stubs"
msgstr "Alas Muñones"

#. ~ Description for {'str': 'Wing Stubs'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades."
"  They can be wiggled at will, but are useless."
msgstr ""
"Tenés un par de pequeñas alas regordetas que salen de tus omóplatos. Las "
"podés mover a voluntad, pero no sirven para nada."

#: lang/json/mutation_from_json.py
msgid "Bat Wings"
msgstr "Alas de Murciélago"

#. ~ Description for {'str': 'Bat Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, leathery wings.  You can move them a little, but "
"they are useless, and in fact put you off balance, reducing your ability to "
"dodge slightly."
msgstr ""
"Tenés un par de alas grandes de cuero. Las podés mover un poquito, pero no "
"sirven para nada, y de hecho te sacan de balance reduciendo levemente tu "
"habilidad para esquivar."

#: lang/json/mutation_from_json.py
msgid "Butterfly Wings"
msgstr "Alas de Mariposa"

#. ~ Description for {'str': 'Butterfly Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a very large pair of brightly-colored, very beautiful wings.  They "
"can't lift you, and they make balancing tricky, but they certainly catch air"
" and attention!"
msgstr ""
"Tenes un par de alas muy grandes y hermosas de colores brillantes. No te "
"pueden levantar, y te complican un poco el balance, ¡pero ciertamente "
"capturan la atención!"

#: lang/json/mutation_from_json.py
msgid "Pale Skin"
msgstr "Piel Pálida"

#. ~ Description for {'str': 'Pale Skin'}
#: lang/json/mutation_from_json.py
msgid "Your skin is rather pale."
msgstr "Tu piel es más bien pálida."

#: lang/json/mutation_from_json.py
msgid "Spots"
msgstr "Manchas"

#. ~ Description for {'str': 'Spots'}
#: lang/json/mutation_from_json.py
msgid "Your skin is covered in a pattern of red spots."
msgstr "Tu piel está cubierta con un diseño de manchas rojas."

#: lang/json/mutation_from_json.py
msgid "Smelly"
msgstr "Oloroso/a"

#. ~ Description for {'str': 'Smelly'}
#: lang/json/mutation_from_json.py
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr ""
"Tenés una baranda horrible. Los monstruos que te rastrean por tu olor te van"
" a encontrar fácilmente, y los humanos no te van a querer cerca."

#: lang/json/mutation_from_json.py
msgid "Deformed"
msgstr "Deforme"

#. ~ Description for {'str': 'Deformed'}
#: lang/json/mutation_from_json.py
msgid ""
"You're slightly deformed.  Some people will react badly to your appearance."
msgstr ""
"Estás un poquito deformado. Alguna gente va a reaccionar mal debido a tu "
"apariencia."

#: lang/json/mutation_from_json.py
msgid "Badly Deformed"
msgstr "Muy Deforme"

#. ~ Description for {'str': 'Badly Deformed'}
#: lang/json/mutation_from_json.py
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction"
" to your appearance."
msgstr ""
"Estás horriblemente deformado. Alguna gente va a reaccionar muy "
"negativamente a tu apariencia."

#: lang/json/mutation_from_json.py
msgid "Grotesque"
msgstr "Grotesco/a"

#. ~ Description for {'str': 'Grotesque'}
#: lang/json/mutation_from_json.py
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr ""
"Tu cara es repugnante y es probable que induzca al vómito. La gente no va a "
"querer interactuar con vos salvo que tengan una muy buena razón para "
"hacerlo."

#: lang/json/mutation_from_json.py
msgid "Beautiful"
msgstr "Hermosura"

#. ~ Description for {'str': 'Beautiful'}
#: lang/json/mutation_from_json.py
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr ""
"Sos de esos que hacen girar la cabeza a los demás. Algunos van a reaccionar "
"bien a tu apariencia, y a la mayoría les resultará más fácil confiar en vos."

#: lang/json/mutation_from_json.py
msgid "Very Beautiful"
msgstr "Mucha Hermosura"

#. ~ Description for {'str': 'Very Beautiful'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks,"
" and most people will trust you immediately."
msgstr ""
"Sos una vista hermosa. Algunos van a reaccionar muy bien a tu apariencia, y "
"la mayoría van a confiar en vos inmediatamente."

#: lang/json/mutation_from_json.py
msgid "Glorious"
msgstr "Espléndido/a"

#. ~ Description for {'str': 'Glorious'}
#: lang/json/mutation_from_json.py
msgid ""
"You are incredibly beautiful.  People cannot help themselves due to your "
"charms, and will do whatever they can to please you."
msgstr ""
"Sos increíblemente hermoso/a. La gente no puede evitar caer en tus encantos,"
" y harán cualquier cosa para complacerte."

#: lang/json/mutation_from_json.py
msgid "Snout"
msgstr "Hocico"

#. ~ Description for {'str': 'Snout'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have begun… changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr ""
"Tu cara y mandíbula han empezado a… cambiar. Las máscaras te quedan bien, "
"pero se te nota la mutación."

#: lang/json/mutation_from_json.py
msgid "Bovine Snout"
msgstr "Hocico Bovino"

#. ~ Description for {'str': 'Bovine Snout'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but prevents wearing mouthgear."
msgstr ""
"Tu cara parece la de un toro, con un hocico importante. Parece temible pero "
"te impide usar cosas sobre la boca."

#: lang/json/mutation_from_json.py
msgid "Lupine Muzzle"
msgstr "Hocico Lobuno"

#. ~ Description for {'str': 'Lupine Muzzle'}
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents wearing mouthgear."
msgstr ""
"Tu mandíbula y nariz se extienden formando un hocico como el de un lobo. "
"Viene bien para morder en combate y se ve impresionante, pero te impide usar"
" cosas sobre la boca."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You nip at %s"
msgstr "Le das un mordisco al %s"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s nips and harries %2$s"
msgstr "%1$s le da un mordisco y hostiga al %2$s"

#: lang/json/mutation_from_json.py
msgid "Ursine Muzzle"
msgstr "Hocico Osuno"

#. ~ Description for {'str': 'Ursine Muzzle'}
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents wearing mouthgear."
msgstr ""
"Tu mandíbula y nariz se extienden formando un hocico como el de un oso. "
"Podés usarlo para morder y se ve impresionante, pero te impide usar cosas "
"sobre la boca."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite %s"
msgstr "Mordés al %s"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s"
msgstr "%1$s muerde al %2$s"

#: lang/json/mutation_from_json.py
msgid "Rodent Muzzle"
msgstr "Hocico Roedor"

#. ~ Description for {'str': 'Rodent Muzzle'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have extended, giving you an alert and attentive "
"appearance."
msgstr ""
"Tu cara y mandíbula se han extendido, lo que te da una apariencia alerta y "
"atenta."

#: lang/json/mutation_from_json.py
msgid "Reptilian Muzzle"
msgstr "Hocico Reptiliano"

#. ~ Description for {'str': 'Reptilian Muzzle'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They"
" look NASTY--as do the bite wounds they can inflict--but prevent wearing "
"mouthgear."
msgstr ""
"Tu cara y mandíbula son una versión más chica de las que tienen los "
"cocodrilos. Se ve TREMENDO -como lo son las heridas que puede causar- pero "
"te impide usar cosas sobre la boca."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite a chunk out of %s"
msgstr "Le arrancás un pedazo de una mordida al %s"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites a chunk out of %2$s"
msgstr "%1$s le arranca un pedazo de una mordida al %2$s"

#: lang/json/mutation_from_json.py
msgid "Proboscis"
msgstr "Probóscide"

#. ~ Description for {'str': 'Proboscis'}
#: lang/json/mutation_from_json.py
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr ""
"Te liberaste de esa boca terriblemente imprecisa y ahora absorbés tu comida "
"por tu trompa como una persona correcta. De todas formas, masticar era "
"agotador."

#: lang/json/mutation_from_json.py
msgid "Hollow Bones"
msgstr "Huesos Huecos"

#. ~ Description for {'str': 'Hollow Bones'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also"
" frail; you can carry 40% less, and bashing attacks injure you more."
msgstr ""
"Tenés el Síndrome de los Huesos Aviarios -tus huesos son casi huecos. Como "
"resultado tu cuerpo es muy liviano, lo que te permite moverte y atacar un "
"20% más rápido, pero también es frágil. Podés cargar un 40% menos, y los "
"ataques golpeantes te causan más daño."

#. ~ Description for {'str': 'Nausea'}
#: lang/json/mutation_from_json.py
msgid ""
"You feel nauseated almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr ""
"Sentís náuseas casi constantemente y sos más propenso a vomitar por "
"intoxicación con la comida, el alcohol, etc. Podés, si querés, hacerte "
"vomitar con solo pensarlo."

#: lang/json/mutation_from_json.py
msgid "Vomitous"
msgstr "Vómitos"

#. ~ Description for {'str': 'Vomitous'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand,"
" too."
msgstr ""
"Tenés un desorden alimenticio grave. Aunque te causa vomitar con frecuencia,"
" descubriste que podés hacerte vomitar cuando quieras."

#: lang/json/mutation_from_json.py
msgid "Fast Metabolism"
msgstr "Metabolismo Veloz"

#. ~ Description for {'str': 'Fast Metabolism'}
#. ~ Description for Constant Eater
#: lang/json/mutation_from_json.py
msgid ""
"You require more food than most people, but recover stamina slightly faster."
msgstr ""
"Necesitás más comida que la mayoría de la gente, pero recuperás tu "
"resistencia bastante más rápido."

#: lang/json/mutation_from_json.py
msgid "Rapid Metabolism"
msgstr "Metabolismo Rápido"

#. ~ Description for {'str': 'Rapid Metabolism'}
#: lang/json/mutation_from_json.py
msgid ""
"You require more resources than most, but heal more rapidly as well.  "
"Provides weak regeneration even when not asleep."
msgstr ""
"Necesitás más recursos que los demás, pero también te curás más rápido. "
"Brinda una leve regeneración también cuando estás despierto."

#: lang/json/mutation_from_json.py
msgid "Very Fast Metabolism"
msgstr "Metabolismo Muy Rápido"

#. ~ Description for {'str': 'Very Fast Metabolism'}
#: lang/json/mutation_from_json.py
msgid ""
"You need about twice as much food as the average human to maintain your "
"expanded cardiovascular and respiratory systems.  On the plus side, it "
"doesn't take you much time to recover from any strenuous activity."
msgstr ""
"Necesitás más o menos el doble de comida que un humano promedio para "
"mantener tus sistemas respiratorio y cardiovascular. La ventaja es que no "
"tardás mucho tiempo en recuperarte de cualquier actividad extenuante."

#: lang/json/mutation_from_json.py
msgid "Extreme Metabolism"
msgstr "Metabolismo Extremo"

#. ~ Description for {'str': 'Extreme Metabolism'}
#: lang/json/mutation_from_json.py
msgid ""
"You consume three times as much food as the average human to maintain your "
"truly superhuman endurance."
msgstr ""
"Consumís el triple de comida que un humano promedio para mantener tu "
"resistencia verdaderamente superhumana."

#: lang/json/mutation_from_json.py
msgid "High Thirst"
msgstr "Alta Sed"

#. ~ Description for {'str': 'High Thirst'}
#: lang/json/mutation_from_json.py
msgid "Your body dries out easily; you need to drink more water."
msgstr "Tu cuerpo se seca con facilidad; necesitás tomar más agua."

#: lang/json/mutation_from_json.py
msgid "Very Thirsty"
msgstr "Mucha Sed"

#. ~ Description for {'str': 'Very Thirsty'}
#. ~ Description for Giant Thirst
#: lang/json/mutation_from_json.py
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr ""
"Puf, ¿otra vez sin agua? Necesitás más o menos el doble de fluidos que una "
"persona normal."

#: lang/json/mutation_from_json.py
msgid "Extremely Thirsty"
msgstr "Sed Extrema"

#. ~ Description for {'str': 'Extremely Thirsty'}
#: lang/json/mutation_from_json.py
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr ""
"Te secás verdaderamente rápido, por lo que necesitás tres veces más de "
"líquido para mantenerte hidratado."

#: lang/json/mutation_from_json.py
msgid "Metabolic Rehydration"
msgstr "Rehidratación Metabólica"

#. ~ Description for {'str': 'Metabolic Rehydration'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body gets everything it needs from the food that you eat!  You no "
"longer need hydration from fluids."
msgstr ""
"¡Tu cuerpo recibe todo lo que necesita de la comida que comés! Ya no "
"necesitás hidratarte con fluidos."

#: lang/json/mutation_from_json.py
msgid "Very Heavy Sleeper"
msgstr "Sueño Muy Pesado"

#. ~ Description for {'str': 'Very Heavy Sleeper'}
#: lang/json/mutation_from_json.py
msgid "You could probably sleep through a firefight."
msgstr "Probablemente, podrías dormir durante un tiroteo."

#: lang/json/mutation_from_json.py
msgid "Very Sleepy"
msgstr "Mucho Sueño"

#. ~ Description for {'str': 'Very Sleepy'}
#: lang/json/mutation_from_json.py
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half of "
"your time in or around bed."
msgstr ""
"Sentís que tenés que dormir bastante seguido. Pasás la mitad de tus días en "
"la cama o cerca de ella."

#: lang/json/mutation_from_json.py
msgid "Weakening"
msgstr "Debilitándote"

#. ~ Description for {'str': 'Weakening'}
#: lang/json/mutation_from_json.py
msgid ""
"You feel as though you are slowly weakening and your body heals slower."
msgstr ""
"Sentís como si te estuvieras debilitando lentamente y tu cuerpo se cura más "
"lento."

#: lang/json/mutation_from_json.py
msgid "Deterioration"
msgstr "Deterioro"

#. ~ Description for {'str': 'Deterioration'}
#: lang/json/mutation_from_json.py
msgid "Your body is very slowly wasting away."
msgstr "Muy lentamente, tu cuerpo se va quedando en piel y hueso."

#: lang/json/mutation_from_json.py
msgid "Disintegration"
msgstr "Desintegración"

#. ~ Description for {'str': 'Disintegration'}
#: lang/json/mutation_from_json.py
msgid "Your body is slowly wasting away!"
msgstr "¡Lentamente, tu cuerpo se va quedando en piel y hueso!"

#: lang/json/mutation_from_json.py
msgid "Solar Sensitivity"
msgstr "Sensibilidad Solar"

#. ~ Description for {'str': 'Solar Sensitivity'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr ""
"Tu piel no puede soportar la radiación ultravioleta, como la luz del solar. "
"Te va a quemar seriamente."

#: lang/json/mutation_from_json.py
msgid "Sores"
msgstr "Llagas"

#. ~ Description for {'str': 'Sores'}
#: lang/json/mutation_from_json.py
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr ""
"Tus extremidades están cubiertas de dolorosas llagas. El dolor es peor "
"cuando tenés puesta alguna ropa."

#: lang/json/mutation_from_json.py
msgid "Light Sensitive"
msgstr "Sensible a la Luz"

#. ~ Description for {'str': 'Light Sensitive'}
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr ""
"La luz del sol te molesta. Si estás afuera y el clima está soleado, sufrís "
"una penalidad de -1 en todas tus características."

#: lang/json/mutation_from_json.py
msgid "Very Light Sensitive"
msgstr "Muy Sensible a la Luz"

#. ~ Description for {'str': 'Very Light Sensitive'}
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr ""
"La luz del sol te molesta mucho. Si estás afuera durante el día, sufrís una "
"penalidad de -1 en todas tus características, y -2 si el clima está soleado."

#. ~ Description for {'str': 'Troglobite'}
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr ""
"La luz del sol te molesta extremadamente, lo que resulta en penalidades "
"grandes para tus características."

#: lang/json/mutation_from_json.py
msgid "Webbed Hands"
msgstr "Manos Palmeadas"

#. ~ Description for {'str': 'Webbed Hands'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hands and feet are heavily webbed, reducing your Dexterity by 1 and "
"causing problems with gloves.  However, you can swim much faster.  Slightly "
"decreases wet penalties."
msgstr ""
"Tus manos y pies están palmeados, lo que reduce tu Destreza (-1) y te "
"dificulta usar guantes. Sin embargo, podés nadar mucho más rápido. Disminuye"
" levemente las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Paws"
msgstr "Patas"

#. ~ Description for {'str': 'Paws'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better."
msgstr ""
"Tus manos se han fusionado en cuasi-patas. Se te complica la motricidad "
"fina: tenés una incomodidad de 10 permanente en las manos, es difícil la "
"fabricación de cosas delicadas, y no entran los guantes. Pero se manejan "
"mejor en el agua."

#: lang/json/mutation_from_json.py
msgid "Broad Paws"
msgstr "Patas Anchas"

#. ~ Description for {'str': 'Broad Paws'}
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are much larger now.  Manual dexterity is difficult: permanent "
"hand encumbrance of 20, serious problems crafting, and no gloves.  In "
"return, though, you can swim better."
msgstr ""
"Ahora tus patas son más grandes. Se te complica la destreza manual: tenés "
"una incomodidad de 20 permanente en las manos, muy difícil fabricar cosas, y"
" no podés usar guantes. Como compensación, podés nadar mejor."

#: lang/json/mutation_from_json.py
msgid "Beak"
msgstr "Pico"

#. ~ Description for {'str': 'Beak'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr ""
"Tenés un pico en lugar de la boca. Ocasionalmente, lo podés usar para picar "
"a tus enemigos, pero es imposibles usar algo sobre tu cara. Disminuye "
"levemente los efectos de estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You peck %s"
msgstr "Le das un picotazo al %s"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s pecks %2$s"
msgstr "%1$s le da un picotazo al %2$s"

#: lang/json/mutation_from_json.py
msgid "Woodpecker Beak"
msgstr "Pico de Pájaro Carpintero"

#. ~ Description for {'str': 'Woodpecker Beak'}
#: lang/json/mutation_from_json.py
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr ""
"Picar a tus presas se ha convertido en parte de tu rutina diaria. Disminuye "
"levemente los efectos de estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You jackhammer into %s with your beak"
msgstr "Taladrás en el %s con tu pico"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s jackhammer into %2$s with their beak"
msgstr "%1$s taladra al %2$s con su pico"

#: lang/json/mutation_from_json.py
msgid "Hummingbird Beak"
msgstr "Pico de Picaflor"

#. ~ Description for {'str': 'Hummingbird Beak'}
#: lang/json/mutation_from_json.py
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr ""
"Aunque tu pico no es apropiado para picar, esas flores que andan por ahí son"
" una buena fuente de energía. Examinalas para alimentarte."

#: lang/json/mutation_from_json.py
msgid "Genetically Unstable"
msgstr "Genéticamente Inestable"

#. ~ Description for {'str': 'Genetically Unstable'}
#: lang/json/mutation_from_json.py
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr ""
"Tu ADN ha sido dañado de una manera que te causa desarrollar mutaciones "
"continuamente."

#: lang/json/mutation_from_json.py
msgid "Genetic Chaos"
msgstr "Caos Genético"

#. ~ Description for {'str': 'Genetic Chaos'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr ""
"Tu cuerpo se altera muy rápidamente, y sin que vos tengas ningún control "
"sobre eso."

#: lang/json/mutation_from_json.py
msgid "Minor Radioactivity"
msgstr "Radiactividad Menor"

#. ~ Description for {'str': 'Minor Radioactivity'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo niveles "
"bajos de radiación, que contamina lentamente el mundo que te rodea."

#: lang/json/mutation_from_json.py
msgid "Radioactivity"
msgstr "Radiactividad"

#. ~ Description for {'str': 'Radioactivity'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo niveles "
"medios de radiación, que contamina el mundo que te rodea."

#: lang/json/mutation_from_json.py
msgid "Severe Radioactivity"
msgstr "Radiactividad Severa"

#. ~ Description for {'str': 'Severe Radioactivity'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo grandes "
"niveles de radiación, lo que vuelve inhabitables tus alrededores."

#: lang/json/mutation_from_json.py
msgid "Slimy"
msgstr "Baboso/a"

#. ~ Description for {'str': 'Slimy'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body is coated with a fine slime.  Protects from long-term effects of "
"acid, though not short-term ones.  Greatly increases wet benefits."
msgstr ""
"Tu cuerpo está cubierto con una baba fina. Te protege de los efectos de "
"largo plazo del ácido, pero no de los efectos de corto plazo. Incrementa "
"mucho los beneficios de estar mojado."

#: lang/json/mutation_from_json.py
msgid "Viscous"
msgstr "Viscoso/a"

#. ~ Description for {'str': 'Viscous'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body's slime output has become sticky and gel-like.  Somewhat protects "
"from acid.  Greatly increases wet benefits."
msgstr ""
"La baba que emite tu cuerpo se ha vuelto más pegajosa y con consistencia de "
"gel. Te protege un poco del ácido e incrementa mucho los beneficios de estar"
" mojado."

#: lang/json/mutation_from_json.py
msgid "Amorphous Body"
msgstr "Cuerpo Amorfo"

#. ~ Description for {'str': 'Amorphous Body'}
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem "
"to be moving around, and your leg-equivalents flow comfortably - if a little"
" slower than your old meat-legs."
msgstr ""
"Tu carne tiene un agradable consistencia similar al gel. Tus funciones "
"corporales parecen estar moviéndose, y lo que serían tus piernas fluyen "
"cómodamente - aunque un poco más lentas que tus viejas piernas de carne."

#: lang/json/mutation_from_json.py
msgid "Omnicellular"
msgstr "Omnicelular"

#. ~ Description for {'str': 'Omnicellular'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr ""
"Tu cuerpo es más o menos un todo consistente: una omnicélula sola, gigante, "
"que se altera a sí misma según sea necesario."

#: lang/json/mutation_from_json.py
msgid "Herbivore"
msgstr "Herbívoro/a"

#. ~ Description for {'str': 'Herbivore'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr ""
"La capacidad de tu cuerpo para digerir carne está muy limitada. Hay mucha "
"probabilidad de que comer carne te haga vomitar, e incluso cuando la podés "
"mantener adentro, su valor nutricional se reduce mucho."

#: lang/json/mutation_from_json.py
msgid "Carnivore"
msgstr "Carnívoro/a"

#. ~ Description for {'str': 'Carnivore'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest fruits, vegetables, grains and nuts is "
"severely hampered.  You cannot eat anything besides meat."
msgstr ""
"La capacidad de tu cuerpo para digerir frutas, verduras, granos y frutos "
"secos está muy limitada. No podés comer nada que no sea carne."

#: lang/json/mutation_from_json.py
msgid "Ponderous"
msgstr "Ponderoso/a"

#. ~ Description for {'str': 'Ponderous'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr ""
"Tus músculos son generalmente lentos en sus movimientos. Te movés un 10% más"
" lento."

#: lang/json/mutation_from_json.py
msgid "Very Ponderous"
msgstr "Muy Ponderoso/a"

#. ~ Description for {'str': 'Very Ponderous'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr ""
"Tus músculos son bastante lentos en sus movimientos. Te movés un 20% más "
"lento."

#: lang/json/mutation_from_json.py
msgid "Extremely Ponderous"
msgstr "Extremadamente Ponderoso/a"

#. ~ Description for {'str': 'Extremely Ponderous'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr ""
"Tus músculos son muy lentos en sus movimientos. Te movés un 30% más lento."

#: lang/json/mutation_from_json.py
msgid "Sunlight Dependent"
msgstr "Dependiente del Sol"

#. ~ Description for {'str': 'Sunlight Dependent'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in"
" speed when in shade, and a 10% drop in speed when in the dark."
msgstr ""
"Te sentís con muy poco vigor cuando no estás expuesto a la luz del sol. "
"Sufrís una caída del 5% en tu velocidad cuando estás en la sombra, y un 10% "
"cuando está oscuro."

#: lang/json/mutation_from_json.py
msgid "Vines"
msgstr "Enredaderas"

#. ~ Description for {'str': 'Vines'}
#: lang/json/mutation_from_json.py
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're"
" bulky, and get in the way."
msgstr ""
"Has desarrollado enredaderas que brotan desde tus hombros. Son grandes y te "
"molestan."

#: lang/json/mutation_from_json.py
msgid "Vine Limbs"
msgstr "Miembros Enredaderas"

#. ~ Description for {'str': 'Vine Limbs'}
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr ""
"Has desarrollado la capacidad de controlar tus enredaderas; las podés usar "
"como látigos. Incluso las podés usar para descender por superficies "
"verticales, pero desconectarlas DUELE."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You lash %s with a vine"
msgstr "Le pegás un latigazo al %s con una liana"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s lashes %2$s with their vines"
msgstr "%1$s le pega un latigazo al %2$s con sus lianas"

#: lang/json/mutation_from_json.py
msgid "Vine Sprouter"
msgstr "Germinador/a de Enredaderas"

#. ~ Description for {'str': 'Vine Sprouter'}
#: lang/json/mutation_from_json.py
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr ""
"Tenés control total sobre tus enredaderas y podés hacer crecer nuevas y "
"soltar las viejas, casi a voluntad."

#: lang/json/mutation_from_json.py
msgid "You detach a vine from your body."
msgstr "Te sacás una liana de tu cuerpo."

#: lang/json/mutation_from_json.py
msgid "Hair Roots"
msgstr "Pelos Absorbentes"

#. ~ Description for {'str': 'Hair Roots'}
#: lang/json/mutation_from_json.py
msgid ""
"Roots have started growing from your leaf-like hair.  They don't seem to do "
"much."
msgstr ""
"Unas raíces han comenzado a crecer desde tus hojas como pelos, pero no "
"parecen servir para nada."

#: lang/json/mutation_from_json.py
msgid "Toe Roots"
msgstr "Dedos Raíces"

#. ~ Description for {'str': 'Toe Roots'}
#: lang/json/mutation_from_json.py
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr ""
"Tus dedos de los pies han crecido retorcidos, y no te podés ni imaginar por "
"qué tenés calzado en los pies. Sacátelo, te molesta."

#: lang/json/mutation_from_json.py
msgid "Roots"
msgstr "Raíces"

#. ~ Description for {'str': 'Roots'}
#. ~ The idea is that you, for lack of a better term, plant yourself.
#. Crafting and digging don't count because they presume a certain amount of
#. movement during the task.  The handheld game does count.
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you started developing a root system.  When reading, "
"fishing, waiting, or otherwise being stationary for a while on diggable "
"terrain, you'll extract nutrients and water from the soil."
msgstr ""
"Era tiempo de que desarrollaras un sistema de raíces. Cuando leés, pescás, "
"esperás, o cuando te quedás quieto en un terreno cavable por un tiempo, vas "
"a extraer los nutrientes y agua de la tierra."

#: lang/json/mutation_from_json.py
msgid "Rooter"
msgstr "Arraigador/a"

#. ~ Description for {'str': 'Rooter'}
#: lang/json/mutation_from_json.py
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients "
"and water whenever on diggable terrain, but move more slowly."
msgstr ""
"Te cuesta no clavar tu raíces cada vez que podés. Vas a extraer los "
"nutrientes y agua cuando estés sobre terreno cavable, pero te vas a mover "
"más lento."

#: lang/json/mutation_from_json.py
msgid "Chloromorphosis"
msgstr "Cloromorfosis"

#. ~ Description for {'str': 'Chloromorphosis'}
#: lang/json/mutation_from_json.py
msgid ""
"Every inch of your skin is packed with chlorophyll and you have strong "
"roots.  Sleeping on diggable soil will satisfy any hunger or thirst you "
"might have."
msgstr ""
"Cada centímetro de tu piel está lleno con clorofila y tenés raíces fuertes. "
"Si dormís en suelo cavable vas a satisfacer el hambre o sed que tengas."

#: lang/json/mutation_from_json.py
msgid "Mycorrhizal Communion"
msgstr "Comunión Micorrizal"

#. ~ Description for {'str': 'Mycorrhizal Communion'}
#: lang/json/mutation_from_json.py
msgid ""
"You have gained the ability to commune with trees and comprehend their "
"ancient wisdom.  Activate next to a tree to gradually gain overmap vision "
"through connected forests."
msgstr ""
"Has recibido la habilidad de comunicarte con los árboles y comprender su "
"antigua sabiduría. Activala al lado de un árbol para ganar gradualmente "
"visión en el mapa general a través de los bosques conectados."

#: lang/json/mutation_from_json.py
msgid "Heat Dependent"
msgstr "Dependiente del Calor"

#. ~ Description for {'str': 'Heat Dependent'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  This sluggishness"
" helps you conserve energy, however."
msgstr ""
"Tu respuesta muscular depende de la temperatura ambiental. Perdés 1% de tu "
"velocidad por cada 2.8 C (5 F) grados por debajo de 18.3 C (65 F). De todas "
"maneras, este letargo te ayuda a conservar energía."

#: lang/json/mutation_from_json.py
msgid "Very Heat Dependent"
msgstr "Muy Dependiente del Calor"

#. ~ Description for {'str': 'Very Heat Dependent'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C), but your "
"slow metabolism requires much less food."
msgstr ""
"Tu respuesta muscular depende mucho de la temperatura ambiental. Perdés 1% "
"de tu velocidad por cada 1.7 C (3 F) grados por debajo de 18.3 C (65 F), "
"pero tu lento metabolismo necesita mucha menos comida."

#: lang/json/mutation_from_json.py
msgid "Cold Blooded"
msgstr "Sangre Fría"

#. ~ Description for {'str': 'Cold Blooded'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C), but only need to eat "
"about half as much as before."
msgstr ""
"Tenés sangre fría y dependés del calor para poder funcionar. Perdés 1% de tu"
" velocidad por cada 1.1 C (2 F) grados por debajo de 18.3 C (65 F), pero "
"solo necesitás comer más o menos la mitad de lo que comías antes."

#: lang/json/mutation_from_json.py
msgid "Ectothermic"
msgstr "Ectotermia"

#. ~ Description for {'str': 'Ectothermic'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  You only need to"
" eat half as much as an average human."
msgstr ""
"Ahora tu cuerpo se ha vuelto permanentemente de sangre fría. Tu velocidad "
"disminuye o aumenta un 1% por cada 1.1 C grados (2 F) por debajo o por "
"encima de 18.3 C (65 F). Solo necesitás comer la mitad de lo que come un "
"humano promedio."

#: lang/json/mutation_from_json.py
msgid "Growling Voice"
msgstr "Gruñido"

#. ~ Description for {'str': 'Growling Voice'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr ""
"Tenés una voz áspera, como un gruñido. Te va a resultar más difícil "
"persuadir a los PNJ, pero amenazarlos va a ser más fácil."

#: lang/json/mutation_from_json.py
msgid "Snarling Voice"
msgstr "Rugido"

#. ~ Description for {'str': 'Snarling Voice'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr ""
"Tenés un rugido amenazante en tu voz. Te va a resultar casi imposible "
"persuadir a los PNJ, pero amenazarlos va a ser mucho más fácil."

#: lang/json/mutation_from_json.py
msgid "Hissing Voice"
msgstr "Siseo"

#. ~ Description for {'str': 'Hissing Voice'}
#: lang/json/mutation_from_json.py
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr ""
"Siseás cuando hablás. Te va a resultar más difícil persuadir a los PNJ, pero"
" amenazarlos va a ser más fácil."

#: lang/json/mutation_from_json.py
msgid "Shouter"
msgstr "Grito"

#. ~ Description for {'str': 'Shouter'}
#: lang/json/mutation_from_json.py
msgid "You occasionally shout uncontrollably."
msgstr "Ocasionalmente, se te escapa un grito."

#: lang/json/mutation_from_json.py
msgid "Screamer"
msgstr "Alarido"

#. ~ Description for {'str': 'Screamer'}
#: lang/json/mutation_from_json.py
msgid "You sometimes scream uncontrollably."
msgstr "Ocasionalmente, se te escapa un alarido."

#: lang/json/mutation_from_json.py
msgid "Howler"
msgstr "Aullido"

#. ~ Description for {'str': 'Howler'}
#: lang/json/mutation_from_json.py
msgid "You frequently let out a piercing howl."
msgstr "Frecuentemente, dejás escapar un aullido agudo."

#: lang/json/mutation_from_json.py
msgid "Feathered Arms"
msgstr "Brazos con Plumas"

#. ~ Description for {'str': 'Feathered Arms'}
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have grown vibrantly-colored feathers.  They effectively "
"waterproof your arms and take the edge off hits, but really get in the way."
"  They're simply too small to help you in the air."
msgstr ""
"En tus brazos han crecido unas plumas de colores brillantes. Impermeabilizan"
" tus brazos de manera eficaz y suavizan los golpes, pero son bastante "
"incómodos. Las plumas son muy pequeñas como para permitirte volar."

#: lang/json/mutation_from_json.py
msgid "Insect Limbs"
msgstr "Miembros de Insecto"

#. ~ Description for {'str': 'Insect Limbs'}
#: lang/json/mutation_from_json.py
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more or less uncontrollably, making you feel rather larval."
msgstr ""
"Te han salido, por fin, unos brazos desde el abdomen. Se agitan más o menos "
"descontroladamente, lo que te hace sentir bastante como una larva."

#: lang/json/mutation_from_json.py
msgid "Insect Arms"
msgstr "Brazos de Insecto"

#. ~ Description for {'str': 'Insect Arms'}
#: lang/json/mutation_from_json.py
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr ""
"Está bueno tener todos tus brazos. Aunque son muy flacos para defenderte o "
"golpear, los podés doblar dentro de la ropa para humano, si lo necesitás."

#: lang/json/mutation_from_json.py
msgid "Arachnid Limbs"
msgstr "Miembros de Arácnido"

#. ~ Description for {'str': 'Arachnid Limbs'}
#: lang/json/mutation_from_json.py
msgid ""
"There's the last two limbs you were expecting.  Unfortunately, you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr ""
"Aparecieron los últimos dos miembros que estabas esperando. Lamentablemente,"
" todavía no los podés coordinar, así que te molestan bastante. Bastante "
"mucho."

#: lang/json/mutation_from_json.py
msgid "Arachnid Arms"
msgstr "Brazos de Arácnido"

#. ~ Description for {'str': 'Arachnid Arms'}
#: lang/json/mutation_from_json.py
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' "
"things.  They probably aren't worth concealing."
msgstr ""
"Tenés cuatro espléndidos miembros, y también esa especie de manos y pies "
"mutantes. No parece necesario tener que ocultarlos."

#: lang/json/mutation_from_json.py
msgid "Tentacle Arms"
msgstr "Brazos de Tentáculos"

#. ~ Description for {'str': 'Tentacle Arms'}
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  Somewhat decreases wet penalties."
msgstr ""
"Tus brazos se han transformado en tentáculos, lo que te da un bonus de +1 "
"punto a tu Destreza, una incomodidad permanente de 30, y la imposibilidad de"
" usar guantes. De alguna manera, disminuye las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slap %s with your tentacle"
msgstr "Cacheteás al %s con tu tentáculo"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slaps %2$s with their tentacle"
msgstr "%1$s cachetea al %2$s con su tentáculo"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You rake %s with your tentacle"
msgstr "Rasgás al %s con tu tentáculo"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s rakes %2$s with their tentacle"
msgstr "%1$s rasga al %2$s con su tentáculo"

#: lang/json/mutation_from_json.py
msgid "4 Tentacles"
msgstr "4 Tentáculos"

#. ~ Description for {'str': '4 Tentacles'}
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into four tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 3 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Tus brazos se han transformado en cuatro tentáculos, lo que resulta en un "
"bonus de +1 punto a tu Destreza, una incomodidad permanente de 30, y la "
"imposibilidad de usar guantes. Ahora podés tener hasta 3 ataques extra. De "
"alguna manera, disminuye las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "8 Tentacles"
msgstr "8 Tentáculos"

#. ~ Description for {'str': '8 Tentacles'}
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into eight tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Tus brazos se han transformado en ocho tentáculos, lo que resulta en un "
"bonus de +1 punto a tu Destreza, una incomodidad permanente de 30, y la "
"imposibilidad de usar guantes. Ahora podés tener hasta 7 ataques extra. De "
"alguna manera, disminuye las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Shell"
msgstr "Caparazón"

#. ~ Description for {'str': 'Shell'}
#: lang/json/mutation_from_json.py
msgid ""
"You have grown a thick shell over your torso, providing excellent armor, but"
" you cannot wear anything on your torso.  Somewhat reduces wet effects."
msgstr ""
"Te ha crecido un caparazón grueso sobre tu torso, que funciona como una "
"excelente armadura, pero no te podés poner nada en el torso. De alguna "
"manera, disminuye las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Roomy Shell"
msgstr "Caparazón Amplio"

#. ~ Description for {'str': 'Roomy Shell'}
#: lang/json/mutation_from_json.py
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--"
"your whole body.  Activate to pull your head and limbs into your shell, "
"trading mobility and vision for warmth and shelter."
msgstr ""
"Tu caparazón protector ha crecido tan grande como para meter tu cuerpo "
"entero, si lo necesitás. Hay que activarlo para meter tu cabeza y tus brazos"
" adentro, ganando abrigo y refugio, y perdiendo movilidad y visión."

#: lang/json/mutation_from_json.py
msgid "Leg Tentacles"
msgstr "Piernas de Tentáculos"

#. ~ Description for {'str': 'Leg Tentacles'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on"
" land by 20%, makes your movement silent, increases your swimming speed, and"
" reduces wet penalties."
msgstr ""
"Tus piernas se han transformado en seis tentáculos. Esto disminuye tu "
"velocidad a pie en un 20%, pero te hace silencioso cuando caminás, aumenta "
"tu velocidad de nado, y reduce las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Tentacle Bracing"
msgstr "Soporte Tentacular"

#. ~ Description for {'str': 'Tentacle Bracing'}
#: lang/json/mutation_from_json.py
msgid ""
"Your lower tentacles have developed suckers.  They make land movement "
"marginally more tiring, but do a good job of keeping you set in place."
msgstr ""
"Tus tentáculos inferiores han desarrollado ventosas. Estas causan que tu "
"movimiento sea ligeramente más cansador, pero hacen un buen trabajo para "
"mantenerte fijo en un lugar."

#. ~ Description for {'str': 'Lizard'}
#: lang/json/mutation_from_json.py
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr ""
"A veces rememorás tus días antes de que te creciera la cola. Pero ahora "
"estás mejor."

#. ~ Description for {'str': 'Bird'}
#: lang/json/mutation_from_json.py
msgid ""
"You're sure you'll fly someday.  In the meantime, there are still nests to "
"build."
msgstr ""
"Estás confiado que algún día podrás volar. Mientras tanto, todavía tenés que"
" construir algunos nidos."

#: lang/json/mutation_from_json.py
msgid "Aquatic"
msgstr "Acuático/a"

#. ~ Description for {'str': 'Aquatic'}
#: lang/json/mutation_from_json.py
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And"
" enjoy.  What was that about a surface?"
msgstr ""
"90 por ciento del planeta, y es todo tuyo para explorarlo. Y colonizarlo. Y "
"disfrutarlo. ¿Qué era eso de una superficie?"

#. ~ Description for {'str': 'Beast'}
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr ""
"Ya era hora de que crecieras. Ahora que maduraste, es momento de hacer algo "
"de vos mismo."

#. ~ Description for {'str': 'Feline'}
#: lang/json/mutation_from_json.py
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr ""
"Acechar a la presa, comer bien, y tirarte al sol. Mmm, todo lo que siempre "
"deseaste."

#. ~ Description for {'str': 'Wolf'}
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to lead a pack."
msgstr "Sos el candidato perfecto para liderar una manada."

#. ~ Description for {'str': 'Bear'}
#: lang/json/mutation_from_json.py
msgid "So the humans died; what's the worry?  Now they won't ruin the woods."
msgstr ""
"Así que los humanos murieron, ¿cuál es la preocupación? Ya no arruinarán los"
" bosques."

#: lang/json/mutation_from_json.py
msgid "Bovine"
msgstr "Bovino"

#. ~ Description for {'str': 'Bovine'}
#: lang/json/mutation_from_json.py
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr ""
"¿La civilización colapsó? ¡Genial! Vos y tus familiares nunca tendrán que "
"volver a preocuparse por un matadero."

#. ~ Description for {'str': 'Insect'}
#: lang/json/mutation_from_json.py
msgid ""
"It would be good to be a queen, having workers constantly servicing your "
"every need… but how would you keep them in line?"
msgstr ""
"Estaría bueno ser reina, tener a los obreros constantemente a tu servicio… "
"pero ¿cómo hacés para mantenerlos controlados?"

#. ~ Description for {'str': 'Plant'}
#: lang/json/mutation_from_json.py
msgid ""
"Well, you still have those other walking flowers--and the mushrooms, too--to"
" deal with.  But you'll manage."
msgstr ""
"Bueno, todavía tenés que ocuparte de esas otras flores que caminan, y "
"también de los hongos. Pero lo vas a resolver."

#: lang/json/mutation_from_json.py
msgid "Aqueous"
msgstr "Acuoso"

#. ~ Description for {'str': 'Aqueous'}
#: lang/json/mutation_from_json.py
msgid ""
"What was that old advertisement?  'Paint the planet'?  That might be a good "
"long-term goal, but for now…"
msgstr ""
"¿Cómo era esa publicidad vieja? ¿'Pintar el planeta'? Eso puede ser un buen "
"objetivo a largo plazo, pero por ahora…"

#: lang/json/mutation_from_json.py
msgid "Subterranean"
msgstr "Subterráneo/a"

#. ~ Description for {'str': 'Subterranean'}
#: lang/json/mutation_from_json.py
msgid ""
"Not much point to rebuilding up in that horribly bright, roofless wasteland."
"  Now that you've become accustomed to your new digs, there's the beginning "
"of a great empire right here, underground."
msgstr ""
"No tiene mucho sentido reconstruir en ese baldío sin techo y horriblemente "
"brillante. Ahora que te acostumbraste a tus nuevos aposentos, aquí están las"
" bases de un gran imperio, subterráneo."

#. ~ Description for {'str': 'Cephalopod'}
#: lang/json/mutation_from_json.py
msgid ""
"Strange aeons, true, but Death seems to be slacking, and you are doing just "
"fine."
msgstr ""
"Son eones extraños, es cierto, pero la Muerte parece estar boludeando y vos "
"la vas llevando bien."

#: lang/json/mutation_from_json.py
msgid "Arachnid"
msgstr "Arácnido"

#. ~ Description for {'str': 'Arachnid'}
#: lang/json/mutation_from_json.py
msgid "Well, maybe you'll just have to make your own worldwide web."
msgstr "Bueno, tal vez tengas que hacer tu propia red informática mundial."

#: lang/json/mutation_from_json.py lang/json/mutation_from_json.py
#: lang/json/npc_from_json.py
msgid "Survivor"
msgstr "Superviviente"

#. ~ Description for {'str': 'Survivor'}
#: lang/json/mutation_from_json.py
msgid ""
"Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr ""
"¡Eh! La civilización cayó. Vos todavía andás dando vueltas. 'Rata' es "
"faltarte el respeto."

#: lang/json/mutation_from_json.py
msgid "Prototype"
msgstr "Prototipo"

#. ~ Description for {'str': 'Prototype'}
#: lang/json/mutation_from_json.py
msgid "After all those experiments, what's a few more, hmm?"
msgstr "Después de todos esos experimentos, ¿qué te hacen un par más, eh?"

#: lang/json/mutation_from_json.py
msgid "Prime"
msgstr "Supremo"

#. ~ Description for {'str': 'Prime'}
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to tidy this mess."
msgstr "Sos el candidato perfecto para ordenar este quilombo."

#. ~ Description for {'str': 'Fey'}
#: lang/json/mutation_from_json.py
msgid ""
"You are the tree under which humankind will shelter during these dark times."
msgstr ""
"Sos el árbol debajo del cual la humanidad se refugiará durante estos tiempos"
" oscuros."

#: lang/json/mutation_from_json.py
msgid "Chaos"
msgstr "Caos"

#. ~ Description for {'str': 'Chaos'}
#: lang/json/mutation_from_json.py
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens."
msgstr ""
"Ya no sabés qué sos. Todo y también anda, como si no hubieras debido "
"existir. Pero existís, y sos una fuerza, no importa lo que pase."

#. ~ Description for {'str': 'Raptor'}
#: lang/json/mutation_from_json.py
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr ""
"La posibilidad de enmendar no uno, sino DOS extinciones. Tenés confianza que"
" lo vas a hacer bien."

#: lang/json/mutation_from_json.py
msgid "Diminutive"
msgstr "Diminutivo"

#. ~ Description for {'str': 'Diminutive'}
#: lang/json/mutation_from_json.py
msgid ""
"So much food, everywhere!  And nobody's even guarding it anymore!  These are"
" good times."
msgstr ""
"¡Tanta comida, en todos lados! ¡Y nadie la está cuidando! Esto se puso "
"bueno."

#: lang/json/mutation_from_json.py
msgid "Marloss Gateway"
msgstr "Entrada Marloss"

#. ~ Description for {'str': 'Marloss Gateway'}
#: lang/json/mutation_from_json.py
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr ""
"Tenés la sensación de estar en la cúspide de convertirte en algo más grande "
"que vos mismo."

#: lang/json/mutation_from_json.py
msgid "Mycus"
msgstr "Mycus"

#. ~ Description for {'str': 'Mycus'}
#: lang/json/mutation_from_json.py
msgid "We are the Mycus."
msgstr "Nosotros somos el Mycus."

#: lang/json/mutation_from_json.py
msgid "Acidproof"
msgstr "Antiácido"

#. ~ Description for {'str': 'Acidproof'}
#: lang/json/mutation_from_json.py
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "Tu carne mutada es inmune a los daños causados por el ácido."

#: lang/json/mutation_from_json.py
msgid "Acid Blood"
msgstr "Sangre Ácida"

#. ~ Description for {'str': 'Acid Blood'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr ""
"Tu cuerpo ha desarrollado un maravilloso mecanismo de defensa. En lugar de "
"tener sangre normal, te corre por las venas un ácido molecular fuerte que "
"dañará a cualquier criatura que sea lo suficientemente estúpida de "
"lastimarte."

#: lang/json/mutation_from_json.py
msgid "Pyromaniac"
msgstr "Piromanía"

#. ~ Description for {'str': 'Pyromaniac'}
#: lang/json/mutation_from_json.py
msgid ""
"You have an unhealthy obsession with fire, and you get anxious if you don't "
"light them every now and then or stand near them often.  However, you gain a"
" mood bonus from doing so."
msgstr ""
"Tenés una obsesión enfermiza con el fuego, y te ponés ansioso si no encendés"
" uno de vez en cuando, o por lo menos te ponés cerca de uno. Pero al hacerlo"
" recibirás un bonus a tu moral."

#: lang/json/mutation_from_json.py
msgid "Amphibious"
msgstr "Anfibio"

#. ~ Description for {'str': 'Amphibious'}
#: lang/json/mutation_from_json.py
msgid ""
"You're as comfortable in water as on land, and your body has adapted around "
"that fact.  Your base swimming speed is greatly increased, and weight will "
"hinder you much less while swimming."
msgstr ""
"Estás tan cómodo en el agua como en la tierra, y tu cuerpo se ha adaptado "
"para eso. Tu velocidad de nado se incrementa, y el peso te molesta mucho "
"menos cuando nadás."

#: lang/json/mutation_from_json.py
msgid "Lidless Eyes"
msgstr "Sin Párpados"

#. ~ Description for {'str': 'Lidless Eyes'}
#: lang/json/mutation_from_json.py
msgid ""
"Like a true fish, your eyes lack eyelids, and are instead covered by a "
"translucent, protective membrane that blocks irritants and water, and "
"provides minor armor.  It also allows you to sleep with your eyes open!  "
"Activate to cause the approach of hostile creatures to wake you up."
msgstr ""
"Como un verdadero pez, tus ojos no tienen párpados y en su lugar están "
"cubiertos por una membrana translúcida que bloquea el agua y los irritantes,"
" y brinda un poco de protección. ¡También te permite dormir con los ojos "
"abiertos! Activalos para que la aproximación de las criaturas hostiles te "
"despierten."

#: lang/json/mutation_from_json.py
msgid "Aqueous Repose"
msgstr "Descanso Acuoso"

#. ~ Description for {'str': 'Aqueous Repose'}
#: lang/json/mutation_from_json.py
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there.  You can also eat underwater, though you can't drink."
msgstr ""
"Te resulta fácil dormirte abajo del agua, y necesitás dormir menos cuando lo"
" hacés en el agua. También podés comer abajo del agua pero no podés beber."

#: lang/json/mutation_from_json.py
msgid "Toxic Flesh"
msgstr "Carne Tóxica"

#. ~ Description for {'str': 'Toxic Flesh'}
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh is highly poisonous, and creatures that bite you will receive a "
"nasty surprise."
msgstr ""
"Tu carnes es muy venenosa y las criaturas que te muerden recibirán una "
"desagradable sorpresa."

#: lang/json/mutation_from_json.py
msgid "Freshwater Osmosis"
msgstr "Ósmosis de Agua Dulce"

#. ~ Description for {'str': 'Freshwater Osmosis'}
#: lang/json/mutation_from_json.py
msgid ""
"Your gills and skin are highly permeable to moisture, and you can hydrate "
"your body through osmosis.  While submerged in fresh water, any thirst you "
"might have will be slaked."
msgstr ""
"Tus branquias y piel son muy permeables a la humedad y podés hidratar tu "
"cuerpo por ósmosis. Cuando estás sumergido en agua dulce, tu sed será "
"satisfecha."

#: lang/json/mutation_from_json.py
msgid "Electroreceptors"
msgstr "Electroreceptores"

#. ~ Description for {'str': 'Electroreceptors'}
#: lang/json/mutation_from_json.py
msgid ""
"A network of jelly-filled electroreceptors, like that of a shark, have grown"
" throughout your face and nose.  They are very sensitive to magnetic fields,"
" allowing you to see robots and creatures charged with electricity through "
"walls, but being shocked will seriously mess you up."
msgstr ""
"Es una red de electroreceptores gelatinosos, como los de un tiburón, que "
"crecieron en tu cara y por tu nariz. Son muy sensibles a los campos "
"magnéticos, lo que te permite ver robots y criaturas cargadas de "
"electricidad a través de las paredes, pero si recibís un shock eléctrico la "
"vas a pasar mal."

#: lang/json/mutation_from_json.py
msgid "Shark Teeth"
msgstr "Dientes de Tiburón"

#. ~ Description for {'str': 'Shark Teeth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your teeth have grown incredibly sharp, and have calcified even further.  In"
" addition to letting you eat much faster, you can use them as a lethal "
"natural weapon, as long as your anatomy favors it.  They also grow very "
"fast, and you harmlessly shed them more or less at random."
msgstr ""
"Tus dientes han crecido y se han puesto muy filosos, y se han calsificado "
"mucho más. Además de permitirte comer mucho más rápido, los podés usar como "
"una letal arma natural, mientras tu anatomía lo permita. También crecen muy "
"rápido, y los vas cambiando más o menos al azar."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your teeth"
msgstr "Abrís al/a %s con tus dientes"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their teeth"
msgstr "%1$s abre el/a %2$s con sus dientes"

#: lang/json/mutation_from_json.py
msgid "Police Officer"
msgstr "Agente de Policía"

#. ~ Description for {'str': 'Police Officer'}
#. ~ Description for {'str': 'SWAT Officer'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr ""
"Sos un/a agente de la ley bajo juramento, con jurisdicción en toda la región"
" de New England gracias a los acuerdos interestatales. Que esto signifique "
"algo ahora, eso ya es otra cosa."

#: lang/json/mutation_from_json.py
msgid "SWAT Officer"
msgstr "Agente de SWAT"

#: lang/json/mutation_from_json.py
msgid "Bionic Officer"
msgstr "Agente Biónico"

#. ~ Description for {'str': 'Bionic Officer'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a cybernetically-resurrected law enforcement officer, with "
"jurisdiction throughout the New England region thanks to interstate "
"agreements.  Whether you can do for the law what the law did for you is "
"another question."
msgstr ""
"Sos un/a agente de la ley resucitado/a cibernéticamente, con jurisdicción en"
" toda la región de New England gracias a los acuerdos interestatales. Que "
"esto signifique algo ahora, eso ya es otra cosa."

#: lang/json/mutation_from_json.py
msgid "Churl"
msgstr "Tosco/a"

#. ~ Description for {'str': 'Churl'}
#: lang/json/mutation_from_json.py
msgid ""
"Thou art a lewede man, a lowly cowherd, though where thi catel been thou "
"hast not ynn certain."
msgstr ""
"Tú eres un hombre común, humilde pastor, aunque donde haya estado tu ganado,"
" no lo has de podido saber."

#: lang/json/mutation_from_json.py
msgid "Police Detective"
msgstr "Detective de Policía"

#. ~ Description for {'str': 'Police Detective'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcement investigator, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"your shield means anything now is another question."
msgstr ""
"Sos un/a agente de la ley bajo juramento, con jurisdicción en toda la región"
" de New England gracias a los acuerdos interestatales. Que esto signifique "
"algo ahora, eso ya es otra cosa."

#: lang/json/mutation_from_json.py
msgid "US Marshal"
msgstr "Alguacil de EE.UU."

#. ~ Description for {'str': 'US Marshal'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn Federal marshal, with nationwide jurisdiction and the "
"authority of the United States of America."
msgstr ""
"Sos un alguacil federal bajo juramento, con jurisdicción en toda la nación y"
" la autoridad en los Estados Unidos de América."

#: lang/json/mutation_from_json.py
msgid "Hub 01 Ancilliary"
msgstr "Auxiliar de Hub 01"

#. ~ Description for {'str': 'Hub 01 Ancilliary'}
#: lang/json/mutation_from_json.py
msgid ""
"You are known to be a capable and resourceful mercenary at the employ of Hub"
" 01."
msgstr ""
"Te conocen por ser un mercenario capaz e ingenioso trabajando en Hub 01."

#: lang/json/mutation_from_json.py
msgid "True Foodperson"
msgstr "Foodperson Verdadera"

#. ~ Description for {'str': 'True Foodperson'}
#: lang/json/mutation_from_json.py
msgid ""
"You are the true Foodperson, some might think Foodperson is just a mascot, "
"but you know better.  You are Foodperson, the mask has become your face; you"
" are real, and the only thing standing between this world and oblivion is "
"you."
msgstr ""
"Sos la verdadera Foodperson, algunos pueden pensar que Foodperson es solo "
"una mascota, pero vos tenés más conocimiento. Sos una Foodperson, esta "
"máscara se ha vuelto tu cara, sos real y la única cosa parada entre este "
"mundo y el olvido sos vos."

#. ~ Description for {'str': 'MD'}
#: lang/json/mutation_from_json.py
msgid ""
"You were just through with the administrative formalities for your residency"
" when the Cataclysm struck.  \"Your\" hospital was overrun and evacuated, "
"but there's always work for a good doctor."
msgstr ""
"Justo terminaste todas las formalidades administrativas de tu residencia, "
"cuando sucedió el Cataclismo. \"Tu\" hospital fue invadido y evacuado, pero "
"siempre hay trabajo para un buen médico."

#: lang/json/mutation_from_json.py
msgid "Skater"
msgstr "Skater"

#. ~ Description for {'str': 'Skater'}
#: lang/json/mutation_from_json.py
msgid ""
"You are skilled in maneuvering on skates.  You suffer lower penalties to "
"dodging and are less likely to fall down if hit in melee combat while you're"
" wearing rollerskates or rollerblades."
msgstr ""
"Sos habilidoso/a para maniobrar sobre patines. Sufrís menos penalidades a "
"esquivar y es menos probable que te caigas al suelo si te golpean en combate"
" cuerpo a cuerpo mientras tenés puestos patines o rollers."

#: lang/json/mutation_from_json.py
msgid "Martial Artist"
msgstr "Artista Marcial"

#. ~ Description for {'str': 'Martial Artist'}
#: lang/json/mutation_from_json.py
msgid ""
"You were shaping up to be a pretty decent student of the martial arts before"
" the Cataclysm struck.  Time to see just how good you really are."
msgstr ""
"Estabas logrando convertirte en un decente estudiante de artes marciales, "
"antes de que suceda el Cataclismo. Ahora es momento de ver que tan bueno sos"
" realmente."

#: lang/json/mutation_from_json.py
msgid "Black Belt"
msgstr "Cinturón Negro"

#. ~ Description for {'str': 'Black Belt'}
#: lang/json/mutation_from_json.py
msgid ""
"You were competitive at national levels, and had considered teaching your "
"art.  Defending against the entire town may still be a challenge, though."
msgstr ""
"Estabas compitiendo a niveles nacionales, y consideraste enseñar tu arte. "
"Igual, defenderte contra el pueblo entero puede ser un desafío importante."

#: lang/json/mutation_from_json.py
msgid "Pugilist"
msgstr "Pugilista"

#. ~ Description for {'str': 'Pugilist'}
#: lang/json/mutation_from_json.py
msgid ""
"You are experienced in the Sweet Science of boxing.  You could've had a shot"
" at a local boxing tournament, if the Cataclysm hadn't screwed that up."
msgstr ""
"Tenés práctica en la Dulce Ciencia del boxeo. Podrías haber tenido éxito en "
"el torneo local de boxeo, si no fuera por este quilombito del Cataclismo."

#: lang/json/mutation_from_json.py
msgid "Autodoc Specialist"
msgstr "Especialista en Autodoc"

#. ~ Description for {'str': 'Autodoc Specialist'}
#: lang/json/mutation_from_json.py
msgid ""
"You're trained in proper operation of the Autodoc, an advanced machine used "
"for surgical procedures.  Operations involving it will be moderately more "
"likely to succeed."
msgstr ""
"Has sido entrenado para operar correctamente un Autodoc, una máquina "
"avanzada para procedimientos quirúrgicos. Las operaciones hechas con él "
"tendrán mejores chances de ser existosas."

#: lang/json/mutation_from_json.py
msgid "Dungeon Master"
msgstr "Dungeon Master"

#. ~ Description for {'str': 'Dungeon Master'}
#: lang/json/mutation_from_json.py
msgid ""
"Weeks spent picking through manuals and researching topics you aren't versed"
" in has taught you to find what you need to know more quickly.  You read "
"slightly faster, and suffer no reading time penalty for books too complex "
"for you to easily understand."
msgstr ""
"Semanas fisgoneando manuales e investigando temas que no conocías te "
"enseñaron a encontrar las cosas que necesitás para aprender más rápidamente."
" Leés un poco más rápido, y no sufrís penalidades al tiempo de lectura de "
"libros demasiados complejos como para que los comprendas fácilmente."

#: lang/json/mutation_from_json.py
msgid "Carries Brandy"
msgstr "Lleva Brandy"

#. ~ Description for {'str': 'Carries Brandy'}
#: lang/json/mutation_from_json.py
msgid "This Bartender now carries brandy!"
msgstr "¡Este Barman ahora tiene brandy!"

#: lang/json/mutation_from_json.py
msgid "Carries Rum"
msgstr "Lleva Ron"

#. ~ Description for {'str': 'Carries Rum'}
#: lang/json/mutation_from_json.py
msgid "This Bartender now carries rum!"
msgstr "¡Este Barman ahora tiene ron!"

#: lang/json/mutation_from_json.py
msgid "Carries Whiskey"
msgstr "Lleva Whisky"

#. ~ Description for {'str': 'Carries Whiskey'}
#: lang/json/mutation_from_json.py
msgid "This Bartender now carries whiskey!"
msgstr "¡Este Barman ahora tiene whisky!"

#: lang/json/mutation_from_json.py
msgid "Has Level 1 Companion Missions"
msgstr "Tiene Misiones de Compañero Nivel 1"

#. ~ Description for {'str': 'Has Level 1 Companion Missions'}
#: lang/json/mutation_from_json.py
msgid "New mission options have become available!"
msgstr "¡Están disponibles nuevas opciones de misiones!"

#: lang/json/mutation_from_json.py
msgid "Has Level 1 Construction Built"
msgstr "Tiene Construcciones Nivel 1"

#. ~ Description for {'str': 'Has Level 1 Construction Built'}
#. ~ Description for {'str': 'Has Level 2 Construction Built'}
#: lang/json/mutation_from_json.py
msgid "New options may have become available!"
msgstr "¡Pueden estar disponibles nuevas opciones de misiones!"

#: lang/json/mutation_from_json.py
msgid "Has Level 2 Construction Built"
msgstr "Tiene Construcciones Nivel 2"

#: lang/json/mutation_from_json.py
msgid "Starting NPC"
msgstr "PNJ al comienzo"

#. ~ Description for {'str': 'Starting NPC'}
#: lang/json/mutation_from_json.py
msgid "Marker for starting NPCs"
msgstr "Marca para los PNJ del comienzo del juego"

#: lang/json/mutation_from_json.py
msgid "Static NPC"
msgstr "PNJ estático"

#. ~ Description for {'str': 'Static NPC'}
#: lang/json/mutation_from_json.py
msgid "Marker for static NPCs"
msgstr "Marca para los PNJ estáticos"

#: lang/json/mutation_from_json.py
msgid "Hallucination"
msgstr "Alucinación"

#. ~ Description for {'str': 'Hallucination'}
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes them be hallucination.  It is a bug if you have it."
msgstr ""
"Es una peculiaridad de los PNJ que los hace alucinar. Si te aparece esto, es"
" un bug."

#: lang/json/mutation_from_json.py
msgid "Debug Night Vision"
msgstr "Visión Nocturna Debug"

#. ~ Description for {'str': 'Debug Night Vision'}
#. ~ Description for {'str': 'Debug Clairvoyance'}
#: lang/json/mutation_from_json.py
msgid "You can clearly see that this is for dev purposes only."
msgstr ""
"Claramente, te das cuenta que esto es solo para propósitos de desarrollo del"
" software."

#: lang/json/mutation_from_json.py
msgid "Debug Clairvoyance"
msgstr "Clarividencia Debug"

#: lang/json/mutation_from_json.py
msgid "Debug Clairvoyance Super"
msgstr "Super Clarividencia Debug"

#. ~ Description for {'str': 'Debug Clairvoyance Super'}
#: lang/json/mutation_from_json.py
msgid "You can see all the bugs with this one."
msgstr "Con esto vas a poder ver todos los bugs."

#: lang/json/mutation_from_json.py
msgid "Debug Invisibility"
msgstr "Invisibilidad Debug"

#. ~ Description for {'str': 'Debug Invisibility'}
#: lang/json/mutation_from_json.py
msgid "If you see this, you'd best be debugging something."
msgstr "Si te aparece esto, te convendría estar buscando los bugs."

#: lang/json/mutation_from_json.py
msgid "Debug Life Support"
msgstr "Soporte Vital para Debug"

#. ~ Description for {'str': 'Debug Life Support'}
#: lang/json/mutation_from_json.py
msgid ""
"Holds hunger, thirst, and fatigue stable.  You can debug all year long with "
"this one!"
msgstr ""
"Mantiene estable el hambre, la sed y el cansacio. ¡Podés arreglar bugs todo "
"el año con esto!"

#: lang/json/mutation_from_json.py
msgid "Debug Deodorizer"
msgstr "Desodorante para Debug"

#. ~ Description for {'str': 'Debug Deodorizer'}
#: lang/json/mutation_from_json.py
msgid "Smell that bug?  Smell's certainly not coming from you!"
msgstr "¿Olés ese bug? ¡Ese olor no sale de vos!"

#: lang/json/mutation_from_json.py
msgid "Debug Silent Walk"
msgstr "Sigiloso Debug"

#. ~ Description for {'str': 'Debug Silent Walk'}
#: lang/json/mutation_from_json.py
msgid "Be vewwy vewwy quiet.  We're hunting bugs."
msgstr "Shhh... no hagas ruido. Estamos cazando bugs."

#: lang/json/mutation_from_json.py
msgid "Debug HVAC"
msgstr "Debug HVAC"

#. ~ Description for {'str': 'Debug HVAC'}
#: lang/json/mutation_from_json.py
msgid "Temperature and weather won't bug you."
msgstr "La temperatura y el calor no te van a molestar. Tampoco los bugs."

#: lang/json/mutation_from_json.py
msgid "Debug Invincibility"
msgstr "Invulnerabilidad Debug"

#. ~ Description for {'str': 'Debug Invincibility'}
#: lang/json/mutation_from_json.py
msgid "Bug-repellent forcefield."
msgstr "Campo de fuerza repelente de bugs."

#: lang/json/mutation_from_json.py
msgid "Debug Hammerspace"
msgstr "Debug Hammerspace"

#. ~ Description for {'str': 'Debug Hammerspace'}
#: lang/json/mutation_from_json.py
msgid ""
"Crafting and construction requirements bugger off with this one.  Apply with"
" care."
msgstr ""
"Con esto, no existen los requisitos para fabricar o construir. Manejar con "
"cuidado."

#: lang/json/mutation_from_json.py
msgid "Debug Crafting Virtuoso"
msgstr "Fabricación Virtuosa Debug"

#. ~ Description for {'str': 'Debug Crafting Virtuoso'}
#: lang/json/mutation_from_json.py
msgid "Crafting failures won't bug you any more."
msgstr "Los fallos en las fabricaciones ya no te molestarán más."

#: lang/json/mutation_from_json.py
msgid "Debug Mind Control"
msgstr "Control Mental Debug"

#. ~ Description for {'str': 'Debug Mind Control'}
#: lang/json/mutation_from_json.py
msgid "Mind the bugs, would you kindly?"
msgstr "Preocupate por los bugs, ¿serías tan amable?"

#: lang/json/mutation_from_json.py
msgid "Debug Bionic Installation"
msgstr "Instalación de Biónico Debug"

#. ~ Description for {'str': 'Debug Bionic Installation'}
#: lang/json/mutation_from_json.py
msgid "Lets you instantly install torsion ratchets for your eight legs."
msgstr ""
"Te permite instalar instantáneamente engranajes de torsión en tus ocho "
"patas."

#: lang/json/mutation_from_json.py
msgid "Debug Bionic Power"
msgstr "Energía de Biónicos Debug"

#. ~ Description for {'str': 'Debug Bionic Power'}
#: lang/json/mutation_from_json.py
msgid ""
"For fueling your inner cybug.  Activate to increase power capacity by 100 "
"(can be repeated.)"
msgstr ""
"Para alimentar tu cybug interior. Activalo para incrementar la capacidad de "
"energía en 100 (puede ser repetido)."

#: lang/json/mutation_from_json.py
msgid "Debug Bionic Powergen"
msgstr "Generación Energía de Biónicos Debug"

#. ~ Description for {'str': 'Debug Bionic Powergen'}
#: lang/json/mutation_from_json.py
msgid "Activate to increase power by an amount you specify (can be repeated)."
msgstr ""
"Activar para incrementar tu energía por la cantidad que especifiques (puede "
"hacerse varias veces)."

#: lang/json/mutation_from_json.py
msgid "Squeamish"
msgstr "Quisquilloso/a"

#. ~ Description for {'str': 'Squeamish'}
#: lang/json/mutation_from_json.py
msgid ""
"You can't even think about putting filthy clothes on yourself, especially "
"from zombies' corpses."
msgstr ""
"Ni siquiera soportás la idea de ponerte ropas sucias, especialmente las que "
"estuvieron en el cuerpo de un zombi."

#: lang/json/mutation_from_json.py
msgid "Bee"
msgstr "Abeja"

#. ~ Description for {'str': 'Bee'}
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes monsters see it as a bee.  It is a bug (heh) if you "
"have it."
msgstr ""
"Es una peculiaridad de los PNJ que hace que los monstruos lo vean como una "
"abeja. Es un bug (ja) si te aparece esto."

#: lang/json/mutation_from_json.py
msgid "mycus friend"
msgstr "Amigo Mycus"

#. ~ Description for {'str': 'mycus friend'}
#: lang/json/mutation_from_json.py
msgid "NPC trait that makes fungaloid monsters see this NPC as a friend."
msgstr ""
"Es una peculiaridad de los PNJ que hace que los monstruos fungaloides lo "
"vean como un amigo."

#: lang/json/mutation_from_json.py
msgid "mute"
msgstr "Mudez"

#. ~ Description for {'str': 'mute'}
#: lang/json/mutation_from_json.py
msgid "Trait that makes it impossible to say anything."
msgstr "Es una peculiaridad que hace imposible decir algo."

#: lang/json/mutation_from_json.py
msgid "Nomad"
msgstr "Nómade"

#. ~ Description for {'str': 'Nomad'}
#: lang/json/mutation_from_json.py
msgid ""
"You're too adventurous for your own good.  The more time you spend "
"somewhere, the unhappier it makes you to be there."
msgstr ""
"Sos demasiado aventurero incluso para tu propio bien. Cuanto más tiempo "
