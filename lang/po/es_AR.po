#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A thick slab of salty cured bacon.  Shelf stable, precooked and ready-to-"
"eat, it tastes better when reheated."
msgstr ""
"Es una feta de panceta salada. No necesita refrigeración, está precocida y "
"lista para comer. Tiene mejor gusto cuando es recalentada."

#: lang/json/COMESTIBLE_from_json.py
msgid "wasteland sausage"
msgid_plural "wasteland sausages"
