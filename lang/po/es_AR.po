msgid "You cannot disassemble this smoking rack while it is active!"
msgstr "¡No podés desarmar este soporte para ahumar mientras está activo!"

#: src/iexamine.cpp
msgid "Disassemble the smoking rack"
msgstr "Desarmar el soporte para ahumar"

#: src/iexamine.cpp
msgid "Remove food from smoking rack"
msgstr "Sacar comida del soporte para ahumar"

#: src/iexamine.cpp
msgid "Reload with charcoal… you don't have any"
msgstr "Recargar carbón vegetal… no tenés"

#: src/iexamine.cpp
msgid "Reload with charcoal"
msgstr "Recargar carbón vegetal"

#: src/iexamine.cpp
#, c-format
msgid ""
"You need %d charges of charcoal for %s %s of food.  Minimal amount of "
"charcoal is %d charges."
msgstr ""
"Necesitás %d cargas de carbón vegetal para %s %s de comida. La cantidad "
"mínima de carbón vegetal es %d cargas."

#: src/iexamine.cpp
msgid "Quench burning charcoal"
msgstr "Extinguir carbón vegetal encendido"

