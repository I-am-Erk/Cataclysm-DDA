#. ~ Description for fog ex machina
#: lang/json/SPELL_from_json.py
msgid "You see fog bubbling out of the device."
msgstr "Ves niebla burbujeante que sale del dispositivo."

#: lang/json/SPELL_from_json.py
msgid "spice pain"
msgstr "dolor por condimentos"

#. ~ Description for spice pain
#: lang/json/SPELL_from_json.py
msgid "Causes pain from eating spicy food."
