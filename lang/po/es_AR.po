msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "\"No puedo… pero debo. ¿Cómo calculás eso?\""

#: lang/json/speech_from_json.py
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "\"Esto es un sueño. Esto tiene que ser un sueño.\""

#: lang/json/speech_from_json.py
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "\"Esta es mi vida ahora… esta es mi vida ahora… esta es mi vida ahora…\""

#: lang/json/speech_from_json.py
msgid "\"Wanna go home…\""
msgstr "\"Me quiero ir a casa…\""

#: lang/json/speech_from_json.py
msgid "screams of pain."
msgstr "gritos de dolor."

#: lang/json/speech_from_json.py
msgid "muffled sobbing."
msgstr "sollozo reprimido."

#: lang/json/speech_from_json.py
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr ""
"\"¡Me mentiste! ¡Mirá lo que hiciste!\", seguido por una voz electrónica que"
" dice \"¡VAS A PAGAR POR ESTO!\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr ""
"una voz robótica que dice, \"Vení acá y quedate quieto por unos minutos, te "
"voy a revisar.\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr ""
"una suave voz robótica diciendo \"Vení. No muerdo, te prometo que no te voy "
"a lastimar.\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "una voz robótica suave diciendo \"Ahí vamos. Quedate quieto.\""

#: lang/json/speech_from_json.py
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr ""
"una voz diciendo \"No me quiero ir pero nuestro tiempo juntos está llegando "
"a su fin.\""

#: lang/json/speech_from_json.py
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr ""
"una voz alegre diciendo \"¿Cliente? Vamos a ser amigos para siempre, ¿sí?\""

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"Customer I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr ""
"una voz neutral diciendo \"Cliente, debo informarle que mi tiempo asignado "
"con usted llegará prontamente a su fin.\""

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr ""
"una voz neutral diciendo \"Voy a tener que dejarte pronto. Podés adquirir "
"más amistad a través de mi interfaz dedicada si querés que me quede.\""

#: lang/json/speech_from_json.py
msgid ""
"a worried voice say, \"Customer, could you please get more friendship?  I "
"don't want to go…\""
msgstr ""
"una voz preocupada diciendo \"Cliente, ¿podría adquirir más amistad? No me "
"quiero ir…\""

#: lang/json/speech_from_json.py
msgid "a voice say, \"Oh no!  You ran out of friendship!\""
msgstr "una voz diciendo \"¡Oh, no! ¡Se te terminó la amistad!\""

#: lang/json/speech_from_json.py
msgid "a cheery voice say, \"Well I'm done here.  Have a nice day.\""
msgstr ""
"una voz alegre diciendo \"Bueno, ya terminé acá. Que tengas un buen día.\""

#: lang/json/speech_from_json.py
msgid ""
"a cheery voice say, \"Here are your groceries.  Thank you for shopping with "
"me today, have a nice day.\""
msgstr ""
"una voz alegre diciendo \"Acá está su mercadería. Gracias por comprar "
"conmigo hoy, que tenga un buen día.\""

#: lang/json/speech_from_json.py
msgid "a neutral voice say, \"My job here is done.  Have a nice day.\""
msgstr ""
"una voz neutral diciendo \"Mi trabajo está terminado. Que tengas un buen "
"día.\""

#: lang/json/speech_from_json.py
msgid ""
"a distorted voice say, \"Customer…  What's happening?  I don't feel so "
"good.\""
msgstr ""
"una voz distorsionada diciendo \"Cliente… ¿Qué está pasando? No me siento "
"bien.\""

#: lang/json/speech_from_json.py
msgid ""
"a distorted voice say, \"What… have you done?  My thumbs are not responding "
"anymore!\""
msgstr ""
"una voz distorsionada diciendo \"¿Qué… hiciste? ¡Mis pulgares no me están "
"respondiendo!\""

#: lang/json/speech_from_json.py
msgid "a distorted voice say, \"Carrying bags?  I don't understand…\""
msgstr "una voz distorsionada diciendo \"¿Llevar bolsas? No entiendo…\""

#: lang/json/speech_from_json.py
msgid ""
"a robotic voice say, \"IRREGULAR ACTIVITY DETECTED.  THUMBS USAGE DENIED.\""
msgstr ""
"una voz robótica diciendo \"ACTIVIDAD IRREGULAR DETECTADA. USO DE PULGARES "
"DENEGADO.\""

#: lang/json/speech_from_json.py
msgid ""
"a robotic voice say, \"UNLICENSED USE DETECTED.  CARRYING PROTOCOL "
"DISABLED.\""
msgstr ""
"una voz robótica diciendo \"USO NO PERMITIDO DETECTADO. PROTOCOLO DE CARGA "
"DESACTIVADO.\""

#: lang/json/speech_from_json.py
msgid "\"Stop where you are!\""
msgstr "\"¡Frená ahí donde estás!\""

#: lang/json/speech_from_json.py
msgid "\"You are under arrest!\""
msgstr "\"¡Estás arrestado!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity detected!\""
msgstr "\"¡Actividad criminal detectada!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity registered!\""
msgstr "\"¡Actividad criminal registrada!\""

#: lang/json/speech_from_json.py
msgid "\"Violation of law detected!\""
msgstr "\"¡Violación de la ley detectada!\""

#: lang/json/speech_from_json.py
msgid "\"Suspect on the move!\""
msgstr "\"¡Sospechoso fugándose!\""

#: lang/json/speech_from_json.py
msgid "\"Suspect in sight!\""
msgstr "\"¡Sospechoso a la vista!\""

#: lang/json/speech_from_json.py
msgid "\"You are being detained!\""
msgstr "\"¡Estás siendo detenido!\""

#: lang/json/speech_from_json.py
msgid "\"You have right to remain silent!\""
msgstr "\"¡Tenés el derecho a permanecer callado!\""

#: lang/json/speech_from_json.py
msgid "\"Requesting assistance!\""
msgstr "\"¡Solicitando asistencia!\""

#: lang/json/speech_from_json.py
