#. ~ Description for scenario 'Lost Faith' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You've been preaching your faith for a long time, but the recent events have"
" begun to make you doubt it.  Wandering in your temple, you just found books"
" that may restore your faith or shatter it completely."
msgstr ""
"Estuviste predicando tu fe por mucho tiempo pero los acontecimientos "
"recientes han empezado a hacerte dudar. Dando vueltas por tu templo, "
"encontraste libros que puede hacerte recuperar la fe o destruirla "
"completamente."

