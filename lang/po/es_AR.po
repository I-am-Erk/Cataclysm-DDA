msgstr "Esa puerta no está cerrada con llave."

#: src/activity_actor.cpp
msgid "That cannot be picked."
msgstr "No podés usar la ganzúa en eso."

#: src/activity_actor.cpp
msgid ""
"You feel you should've fallen asleep by now, but somehow you're still awake."
msgstr ""
"Sentís que ya deberías estar durmiendo pero por alguna razón, todavía estás "
"despierto."

#: src/activity_actor.cpp
msgid "You toss and turn…"
msgstr "Das vueltas en la cama…"

#: src/activity_actor.cpp
msgid "You try to sleep, but can't."
msgstr "Intentás dormirte pero no podés."

#: src/activity_actor.cpp
msgid "You have trouble sleeping, keep trying?"
msgstr "Tenés problemas para dormirte, ¿querés seguir intentándolo?"

#: src/activity_actor.cpp
msgid "Stop trying to fall asleep and get up."
msgstr "Dejar de intentar dormirte y levantarse."

#: src/activity_actor.cpp
