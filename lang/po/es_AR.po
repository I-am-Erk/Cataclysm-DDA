msgid "Mana Blast"
msgstr "Bomba de Maná"

#: lang/json/SPELL_from_json.py
msgid "Mana Bolt"
msgstr "Flecha de Maná"

#: lang/json/SPELL_from_json.py
msgid "Haste"
msgstr "Apuro"

#: lang/json/SPELL_from_json.py
msgid "Baleful Polymorph"
msgstr "Polimorfia Siniestra"

#: lang/json/SPELL_from_json.py
msgid "Mana Beam"
msgstr "Rayo de Maná"

#: lang/json/SPELL_from_json.py
msgid "Escape"
msgstr "Escape"

#: lang/json/SPELL_from_json.py
msgid "Magus Rune"
msgstr "Runa Magus"

#. ~ Description for Magus Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Magi.  You can use the rune as"
" a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Magi. Podés usar la runa "
"como catalizador en recetas."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Cat's Grace"
msgstr "Gracia Gatuna"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Eagle's Sight"
msgstr "Vista de Águila"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Ogre's Strength"
msgstr "Fuerza de Ogro"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Fox's Cunning"
msgstr "Astucia de Zorro"

#: lang/json/SPELL_from_json.py
msgid "Jar of Force"
msgstr "Frasco de Fuerza"

#. ~ Description for Jar of Force
#: lang/json/SPELL_from_json.py
msgid "Summon a jar of force in which you can store liquids."
msgstr "Conjura un frasco de fuerza en el que podés guardar líquidos."

#: lang/json/SPELL_from_json.py
msgid "Impact Sling"
msgstr "Honda de Impacto"

#. ~ Description for Impact Sling
#: lang/json/SPELL_from_json.py
msgid ""
"This spell infuses a sling with tremendous force, delivering devastating "
"pebble shots until the energy tears it apart."
msgstr ""
"Este hechizo infundo una honda con una fuerza tremenda, capaz de emitir "
"disparos devastadores de piedras hasta que la energía la desarma."

#. ~ Description for Crystallize Mana
#: lang/json/SPELL_from_json.py
msgid ""
"Crystallizes mana into solid form.  Your physiological changes have made "
"this spell much more efficient and easier to cast."
msgstr ""
"Cristaliza maná en forma sólida. Tus cambios psicológicos han hecho que este"
" hechizo se mucho más eficiente y fácil de usar."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Seeker Bolts"
msgstr "Rayos Buscadores"

#. ~ Description for Seeker Bolts
#: lang/json/SPELL_from_json.py
msgid ""
"Fires bolts of mana from your fingertips that home in on randomly selected "
"targets in range."
msgstr ""
"Dispara rayos de maná desde tus dedos que son dirigidos a objetivos "
"aleatorios al alcance."

#. ~ description for the sound of spell 'Seeker Bolts'
#: lang/json/SPELL_from_json.py
msgid "a zing"
msgstr "una chispa"

#: lang/json/SPELL_from_json.py
msgid "Blood Suck"
msgstr "Chupar Sangre"

#. ~ Description for Blood Suck
#: lang/json/SPELL_from_json.py
msgid "Sucks blood from one foe."
msgstr "Chupa la sangre de un enemigo."

#: lang/json/SPELL_from_json.py
msgid "Bear Trap"
msgstr "Trampa de Oso"

#. ~ Description for Bear Trap
#: lang/json/SPELL_from_json.py
msgid "A trap that summons bears!  Not what you were expecting, is it?"
msgstr "¡Es una trampa que conjura osos! No era lo que esperabas, ¿eh?"

#. ~ description for the sound of spell 'Bear Trap'
#. ~ description for the sound of spell 'Forge Trap'
#: lang/json/SPELL_from_json.py
msgid "\"It's a trap!\""
msgstr "\"¡Es una trampa!\""

#: lang/json/SPELL_from_json.py
msgid "Forge Trap"
msgstr "Trampa de Forja"

#. ~ Description for Forge Trap
#: lang/json/SPELL_from_json.py
msgid "A trap that summons forge hounds!  Not what you were expecting, is it?"
msgstr ""
"¡Es una trampa que conjura sabuesos forjados! No era lo que esperabas, ¿eh?"

#: lang/json/SPELL_from_json.py
msgid "Rocket Punch"
msgstr "Piña Misil"

#. ~ Description for Rocket Punch
#: lang/json/SPELL_from_json.py
msgid "Ejects giant fist from arm."
msgstr "Eyecta un puño gigante desde el brazo."

#: lang/json/SPELL_from_json.py
msgid "Leprechaun prank"
msgstr "Joda leprechaun"

#. ~ Description for Leprechaun prank
#: lang/json/SPELL_from_json.py
msgid "Pranks the PC.  Gag humor."
msgstr "Le hace una joda a la PC. Humor."

#: lang/json/SPELL_from_json.py
msgid "Gas Attack"
msgstr "Ataque de Gas"

#. ~ Description for Gas Attack
#: lang/json/SPELL_from_json.py
msgid "Spreads toxic gas around itself."
msgstr "Libera un gas tóxico a tu alrededor."

#: lang/json/SPELL_from_json.py
msgid "Demon Fireball"
msgstr "Bola de Fuego Demoníaca"

#. ~ Description for Demon Fireball
#: lang/json/SPELL_from_json.py
msgid "This is a monster only spell."
msgstr "Este hechizo es solo para monstruos."

#: lang/json/SPELL_from_json.py
msgid "Summon Demon Spiderlings"
msgstr "Conjurar Arañitas Demoníacas"

#. ~ Description for Summon Demon Spiderlings
#: lang/json/SPELL_from_json.py
msgid "Summons 4 permanent demon spiderlings."
msgstr "Conjura 4 arañitas demoníacas permanentes."

#: lang/json/SPELL_from_json.py
msgid "Hellfire Belch"
msgstr "Eructo Infernal"

#. ~ Description for Hellfire Belch
#: lang/json/SPELL_from_json.py
msgid "Spits supernatural napalm from your mouth."
msgstr "Escupe un napalm sobrenatural desde tu boca."

#: lang/json/SPELL_from_json.py
msgid "Jolt"
msgstr "Descarga"

