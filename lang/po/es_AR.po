msgid_plural "MRE entrees"
msgstr[0] "MRE entrada"
msgstr[1] "MRE entrada"

#. ~ Description for MRE entree
#: lang/json/COMESTIBLE_from_json.py
msgid "A generic MRE entree, you shouldn't see this."
msgstr "Es un plato de entrada MRE genérico, no deberías ver esto."

#: lang/json/COMESTIBLE_from_json.py
