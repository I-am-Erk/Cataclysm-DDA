msgstr "Bajón de Estimulante RX11"

#. ~ Description of effect 'RX11 Stimulant Comedown'.
#: lang/json/effects_from_json.py
msgid "You feel sluggish and slow."
msgstr "Te sentís vago y lento."

#: lang/json/effects_from_json.py
msgid "RX11 Stimulant Rush"
msgstr "Empujón de Estimulante RX11"

#. ~ Description of effect 'RX11 Stimulant Rush'.
#: lang/json/effects_from_json.py
msgid "An intense surge of stimulants pulses through your body."
msgstr "Un intenso aluvión de estimulantes te late por el cuerpo."

#. ~ Apply message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "You feel an intense surge of stimulants pulse through your body!"
msgstr "¡Sentís un intenso aluvión de estimulantes latiendo en tu cuerpo!"

#. ~ Decay message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "The stimulant combo is wearing off.  You feel sluggish."
msgstr ""
"Los efectos del combo de estimulantes se te pasaron. Te sentís perezoso."

#: lang/json/effects_from_json.py
msgid "Adrenaline Comedown"
msgstr "Bajón de Adrenalina"

#: lang/json/effects_from_json.py
msgid "Adrenaline Rush"
msgstr "Empujón de Adrenalina"

#. ~ Description of effect 'Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel the rush of adrenaline in your body!"
msgstr "¡Sentís la ráfaga de adrenalina en tu cuerpo!"

#. ~ Apply message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel a surge of adrenaline!"
msgstr "¡Sentís una explosión de adrenalina!"

#. ~ Miss message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your comedown throws you off."
msgstr "El bajón te deja confundido."

#. ~ Decay message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your adrenaline rush wears off.  You feel AWFUL!"
msgstr "El empujón de adrenalina ya se te pasó. ¡Te sentís TERRIBLE!"

#: lang/json/effects_from_json.py
msgid "Mycus Respite"
msgstr "Alivio de Mycus"

#. ~ Description of effect 'Mycus Respite'.
#: lang/json/effects_from_json.py
msgid ""
"Our fibers are stretched near breaking.  Local power diverted to regenerate."
msgstr ""
"Nuestras fibras están estiradas hasta casi romperse. La energía local se "
"desvía para la regeneración."

#: lang/json/effects_from_json.py
msgid "Mycus Wrath"
msgstr "Ira de Mycus"

#. ~ Description of effect 'Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Our enemies are near, and violent action is imminent.  We are turgid."
msgstr ""
"Nuestros enemigos están cerca, y es inminente una acción violenta. Nosostros"
" estamos hinchados."

#. ~ Apply message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Mycal wrath fills our fibers, and we grow turgid."
msgstr "La ira de Mycus llena nuestras fibras, y nos hinchamos."

#. ~ Decay message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "We require repose; our fibers are nearly spent…"
msgstr "Nosotros necesitamos descansar; nuestras fibras están casi gastadas…"

#: lang/json/effects_from_json.py
msgid "Meth comedown"
msgstr "Bajón de Metanfetaminas"

#: lang/json/effects_from_json.py
msgid "High on Meth"
msgstr "Drogado con Metanfetaminas"

#: lang/json/effects_from_json.py
msgid "Nicotine"
msgstr "Nicotina"

#: lang/json/effects_from_json.py
msgid "You had a puff or two."
msgstr "Le pegás una pitada o dos."

#: lang/json/effects_from_json.py
msgid "You smoked too much."
msgstr "Fumaste demasiado."

#: lang/json/effects_from_json.py
msgid "High"
msgstr "Drogado"

#. ~ Description of effect 'High'.
#: lang/json/effects_from_json.py
msgid "You are high as a kite."
msgstr "Estás dado vuelta como una media."

#. ~ Apply message for effect(s) 'High'.
#. ~ Apply message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#: lang/json/effects_from_json.py
msgid "You feel lightheaded."
msgstr "Estás un poco mareado."

#: lang/json/effects_from_json.py
msgid ""
"That critter's jumping around like a jitterbug!  It needs to mellow out."
msgstr ""
"¡Ese bicho está saltando como si estuviera bailando jitterbug! Necesita "
"calmarse."

#: lang/json/effects_from_json.py
msgid "Contact Lenses"
msgstr "Lentes de Contacto"

#. ~ Description of effect 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You are wearing contact lenses."
msgstr "Estás usando lentes de contacto."

#. ~ Apply message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You can see more clearly."
msgstr "Ahora podés ver mejor."

#. ~ Remove message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "Your vision starts to blur."
msgstr "Tu visión se empieza a hacer borrosa."

#: lang/json/effects_from_json.py
msgid "Tipsy"
msgstr "Entonado"

#. ~ Description of effect 'Tipsy'.
#: lang/json/effects_from_json.py
msgid "You drank some alcohol.  You feel warm inside."
msgstr "Tomaste un poco de alcohol. Te sentís calentito."

#: lang/json/effects_from_json.py
msgid "Drunk"
msgstr "Borracho"

#. ~ Description of effect 'Drunk'.
#: lang/json/effects_from_json.py
msgid "You drank alcohol.  Party on!"
msgstr "Tomaste alcohol. ¡Qué arranque la fiesta!"

#: lang/json/effects_from_json.py
msgid "Trashed"
msgstr "En pedo"

#. ~ Description of effect 'Trashed'.
#: lang/json/effects_from_json.py
msgid "You drank lots of alcohol.  Are those white mice?"
msgstr "Tomaste mucho alcohol. ¿Esos son ratones blancos?"

#: lang/json/effects_from_json.py
msgid "Wasted"
msgstr "Mamado"

#. ~ Description of effect 'Wasted'.
#: lang/json/effects_from_json.py
msgid ""
"You drank unholy amounts of alcohol.  It's the end of the world, what do you"
" care?"
msgstr ""
"Tomaste cantidades industriales de alcohol. Es el fin de mundo, ¿y qué "
"importa?"

#: lang/json/effects_from_json.py
msgid "Dead Drunk"
msgstr "Borrachazo"

#. ~ Description of effect 'Dead Drunk'.
#: lang/json/effects_from_json.py
msgid ""
"You embalmed yourself alive with so much alcohol, that even zombies will "
"leave your dead body alone."
msgstr ""
"Te metiste tanto alcohol adentro que ni siquiera los zombis se atreverían a "
"tocar tu cadáver."

#. ~ Miss message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#. ~ Miss message for effect(s) 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You feel woozy."
msgstr "Te sentís atontado."

#: lang/json/effects_from_json.py
msgid "You can't look away from the faultline…"
msgstr "No podés dejar de mirar la enorme grieta en el suelo…"

#: lang/json/effects_from_json.py
msgid "Feared"
msgstr "Aterrado"

#. ~ Description of effect 'Feared'.
#: lang/json/effects_from_json.py
msgid "You have been paralyzed by the fear."
msgstr "Estás paralizado del cagazo."

#: lang/json/effects_from_json.py
msgid "Asthma"
msgstr "Asma"

#: lang/json/effects_from_json.py
msgid "Heavy Asthma"
msgstr "Asma Grave"

#: lang/json/effects_from_json.py
msgid ""
"You suffer from a respiratory disorder that makes breathing difficult.\n"
"An asthma attack can occur from time to time, so have your inhaler nearby."
msgstr ""
"Sufrís de un trastorno respiratorio que te dificulta respirar.\n"
"Un ataque de asma puede suceder de vez en cuando, así que te conviene tener el inhalador cerca."

#. ~ Apply message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy
#. Asthma, Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You can't breathe… asthma attack!"
msgstr "No podés respirar… ¡un ataque de asma!"

#. ~ Miss message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy Asthma,
#. Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You're winded."
msgstr "Te falta el aire."

#: lang/json/effects_from_json.py
msgid "The ceiling collapses on you!"
msgstr "¡El techo se te cae encima!"

#: lang/json/effects_from_json.py
msgid "Took anticonvulsant drugs"
msgstr "Tomaste anticonvulsivo"

#. ~ Description of effect 'Took anticonvulsant drugs'.
#: lang/json/effects_from_json.py
msgid ""
"You took anticonvulsant drugs some time ago and you might still be under its influence.\n"
"Prescription note says its effect duration may vary, so your estimate may be inaccurate."
msgstr ""
"Tomaste anticonvulsivos hace poco y puede que todavía estés bajo su influencia.\n"
"La prescripción dice que la duración del efecto puede variar, así que el estimado puede ser erróneo."

#: lang/json/effects_from_json.py
msgid "Relaxation gas"
msgstr "Gas relajante"

#. ~ Description of effect 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid ""
"You are thoroughly relaxed and don't feel like moving.  Fighting?  Too much "
"effort."
msgstr ""
"Estás completamente relajado y no tenés ganas de moverte. ¿Pelear? Demasiado"
" esfuerzo."

#. ~ Apply message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "You inhale sweetish gas."
msgstr "Inhalás un gas dulce."

#. ~ Remove message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "The slackness leaves your muscles."
msgstr "Ya recuperaste el vigor de tus músculos."

#: lang/json/effects_from_json.py
msgid "Experiencing Datura"
msgstr "Experimentando Datura"

#. ~ Description of effect 'Experiencing Datura'.
#: lang/json/effects_from_json.py
msgid "Buy the ticket, take the ride.  The datura has you now."
msgstr "Comprá el pasaje, hacé el viaje. La datura ahora te posee."

#: lang/json/effects_from_json.py
msgid "Grabbed"
msgstr "Agarrado"

#. ~ Description of effect 'Grabbed'.
#: lang/json/effects_from_json.py
msgid ""
"You have been grabbed by an attack.\n"
"You are being held in place, and dodging and blocking are very difficult."
msgstr ""
"Fuiste agarrado en la pelea.\n"
"Estás retenido en el lugar, esquivar y bloquear ataques es muy difícil."

#: lang/json/effects_from_json.py
msgid "Grabbing"
msgstr "Agarrando"

#. ~ Description of effect 'Grabbing'.
#: lang/json/effects_from_json.py
msgid "Grabbing another creature and holding them in place."
msgstr "Agarrando a otra criatura y manteniéndola en su lugar."

#: lang/json/effects_from_json.py
msgid "Lacking Sleep"
msgstr "Falta de Sueño"

#. ~ Description of effect 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You haven't slept in a while, and it shows."
msgstr "Hace mucho que no dormís, y se te nota."

#. ~ Apply message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You are too physically tired to function well."
msgstr ""
"Estás demasiado cansado/a físicamente como para hacer actividades "
"normalmente."

#. ~ Miss message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You don't have energy to fight."
msgstr "No tenés energía para pelear."

#: lang/json/effects_from_json.py
msgid "You lie down to go to sleep…"
msgstr "Te acostás para dormirte…"

#: lang/json/effects_from_json.py src/mutation_data.cpp
msgid "You fall asleep."
msgstr "Te quedaste dormido/a."

#: lang/json/effects_from_json.py
msgid "You wake up."
msgstr "Te despertás."

#: lang/json/effects_from_json.py
msgid "Under operation"
msgstr "En operación"

#. ~ Description of effect 'Under operation'.
#: lang/json/effects_from_json.py
msgid "You are being operated on.  Try to stay still."
msgstr "Estás siendo operado. Quedate quieto."

#: lang/json/effects_from_json.py
msgid "Playing an instrument"
msgstr "Tocar un instrumento"

#. ~ Description of effect 'Playing an instrument'.
#: lang/json/effects_from_json.py
msgid ""
"You're playing an instrument.\n"
"Focusing on playing music distracts you, slowing you down."
msgstr ""
"Estás tocando un instrumento.\n"
"Enfocarte en tocar música te distrae, lo que te hace más lento."

#: lang/json/effects_from_json.py
msgid "Corroding"
msgstr "Corroyendo"

#. ~ Description of effect 'Corroding'.
#. ~ Apply message for effect(s) 'Corroding'.
#: lang/json/effects_from_json.py
msgid "You're covered in acid!"
msgstr "¡Estás cubierto de ácido!"

#: lang/json/effects_from_json.py
msgid "Zapped"
msgstr "Electrocutado"

#. ~ Description of effect 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You've been zapped with electricity and are barely able to move!"
msgstr "¡Has sido electrocutado y apenas si te podés mover!"

#. ~ Apply message for effect(s) 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You're zapped!"
msgstr "¡Sos electrocutado!"

#: lang/json/effects_from_json.py
msgid "Hypocalcemia"
msgstr "Hipocalcemia"

#: lang/json/effects_from_json.py
msgid "Weak bones"
msgstr "Huesos frágiles"

#: lang/json/effects_from_json.py
msgid "Brittle bones"
msgstr "Huesos quebradizos"

#: lang/json/effects_from_json.py
msgid ""
"A lack of calcium in your diet will make your bones progressively weaker."
msgstr ""
"La falta de calcio en tu dieta irá progresivamente debilitando tus huesos."

#. ~ Apply message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones are becoming more brittle."
msgstr "Tus huesos se están volviendo más quebradizos."

#. ~ Remove message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones regain their usual strength."
msgstr "Tus huesos recuperan su fortaleza normal."

#. ~ Decay message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your calcium deficiency is nearly resolved."
msgstr "Ya casi has superado tu deficiencia de calcio."

#. ~ Decay message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones become stronger as your calcium deficiency improves."
msgstr ""
"Tus huesos se vuelven más fuertes a medida que mejorás tus niveles de "
"calcio."

#: lang/json/effects_from_json.py
msgid "Early iron deficiency"
msgstr "Deficiencia inicial de hierro"

#. ~ Description of effect 'Early iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"A lack of iron in your diet has hampered the efficiency and regeneration of "
"your red blood cells."
msgstr ""
"La falta de hierro en tu dieta ha enlentecido la eficiencia y regeneración "
"de tus glóbulos rojos."

#: lang/json/effects_from_json.py
msgid "Iron deficiency"
msgstr "Deficiencia de hierro"

#. ~ Description of effect 'Iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"Prolonged lack of iron in your diet has compromised the efficiency and "
"regeneration of your red blood cells."
msgstr ""
"La falta prolongada de hierro en tu dieta ha puesto en riesgo la eficiencia "
"y regeneración de tus glóbulos rojos."

#: lang/json/effects_from_json.py
msgid "Acute iron deficiency"
msgstr "Deficiencia grave de hierro"

#. ~ Description of effect 'Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"Severe lack of iron in your diet results in your red blood cells dying "
"faster then they are regenerating."
msgstr ""
"La severa falta de hierro en tu dieta ha resultado en glóbulos rojos "
"muriendo más rápidamente de lo que se pueden regenerar."

#. ~ Apply message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#. ~ Apply message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "You begin feeling increasingly tired and listless."
msgstr "Empezás a sentirte cada vez más cansado/a y apático/a."

#. ~ Remove message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "You are no longer in risk of becoming anemic."
msgstr "Ya no estás en riesgo de volverte anémico."

#. ~ Decay message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "Your iron deficiency is nearly resolved."
msgstr "Ya casi has superado tu deficiencia de hierro."

#. ~ Decay message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "Your feel stronger as your iron deficiency starts to improve."
msgstr "Te sentís con más fuerza a medida que mejorás de tu falta de hierro."

#: lang/json/effects_from_json.py
msgid "Early anemia"
msgstr "Anemia precoz"

#: lang/json/effects_from_json.py
msgid "Anemia"
msgstr "Anemia"

#: lang/json/effects_from_json.py
msgid "Acute anemia"
msgstr "Anemia grave"

#: lang/json/effects_from_json.py
msgid "Loss of red blood cells results in progressively worsening anemia."
msgstr ""
"La pérdida de glóbulos rojos resulta en una anemia que empeora "
"progresivamente."

#. ~ Remove message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "You no longer feel anemic."
msgstr "Ya no te sentís anémico."

#. ~ Decay message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "Your anemia is nearly resolved."
msgstr "Ya casi has superado tu anemia."

#. ~ Decay message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "Your feel stronger as your anemia starts to improve."
msgstr "Te sentís con más fuerza a medida que mejorás de tu anemia."

#: lang/json/effects_from_json.py
msgid "VitA deficiency"
msgstr "Deficiencia de VitA"

#: lang/json/effects_from_json.py
msgid "Poor vision"
msgstr "Mala visión"

#: lang/json/effects_from_json.py
msgid "Night blindness"
msgstr "Ceguera nocturna"

#: lang/json/effects_from_json.py
msgid ""
"A lack of vitamin A in your diet will progressively worsen your vision."
msgstr ""
"La falta de vitamina A en tu dieta irá progresivamente empeorando tu vista."

#. ~ Apply message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "You start struggling to make out the finer details."
msgstr "Empezás a tener dificultades para distinguir los detalles."

#. ~ Remove message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your normal visual acuity returns."
msgstr "Volvés a recuperar tu agudeza visual normal."

#. ~ Decay message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your vitamin A deficiency is nearly resolved."
msgstr "Ya casi has superado tu deficiencia de vitamina A."

#. ~ Decay message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your vision improves as your Vitamin A deficiency improves."
msgstr "Tu vista mejora a medida que mejorás tus niveles de vitamina A."

#: lang/json/effects_from_json.py
msgid "B12 deficiency"
msgstr "Deficiencia de B12"

#: lang/json/effects_from_json.py
msgid "Slow healing"
msgstr "Curación lenta"

#: lang/json/effects_from_json.py
msgid "No healing"
msgstr "Sin curación"

#: lang/json/effects_from_json.py
msgid "A lack of vitamin B12 in your diet will affect your ability to heal."
msgstr ""
"La falta de vitamina B12 en tu dieta afectará tu habilidad para curar tus "
"heridas."

#. ~ Apply message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Simple wounds are starting to concern you more than usual."
msgstr "Las heridas comunes te empiezan a preocupar más de lo común."

#. ~ Remove message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your wounds now heal normally."
msgstr "Ahora, tus heridas sanan normalmente."

#. ~ Decay message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your vitamin B12 deficiency is starting to resolve."
msgstr "Has comenzado a superar tu deficiencia de vitamina B12."

#. ~ Decay message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your ability to heal returns as your Vitamin B12 deficiency improves."
msgstr ""
"Volvés a recuperar tu capacidad de curación a medida que superás tu "
"deficiencia de B12."

#: lang/json/effects_from_json.py
msgid "Early scurvy"
msgstr "Escorbuto leve"

#: lang/json/effects_from_json.py
msgid "Scurvy"
msgstr "Escorbuto"

#: lang/json/effects_from_json.py
msgid "Bad Scurvy"
msgstr "Escorbuto grave"

#: lang/json/effects_from_json.py
msgid ""
"A lack of vitamin C in your diet will result in progressively worse symptoms"
" of scurvy."
msgstr ""
"La falta de vitamina C en tu dieta irá progresivamente empeorando tus "
"síntomas de escorbuto."

#. ~ Apply message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "You start to develop symptoms of scurvy."
msgstr "Empezás a padecer síntomas de escorbuto."

#. ~ Remove message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy has resolved."
msgstr "Se te ha curado el escorbuto."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your vitamin C deficiency is starting to resolve."
msgstr "Has comenzado a superar tu deficiencia de vitamina C."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy lessens as your Vitamin C deficiency improves."
msgstr ""
"Empezás a curarte el escorbuto a medida que superás tu deficiencia de "
"vitamina C."

#: lang/json/effects_from_json.py
msgid "Hypervitaminosis"
msgstr "Hipervitaminosis"

#. ~ Description of effect 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "An excess of vitamins has badly affected your metabolism."
msgstr "Un exceso de vitaminas ha afectado gravemente tu metabolismo."

#. ~ Apply message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes unstable."
msgstr "Tu metabolismo se ha vuelto inestable."

#. ~ Remove message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes more stable."
msgstr "Tu metabolismo se vuelve más estable."

#: lang/json/effects_from_json.py
msgid "Concerning symptoms"
msgstr "Síntomas preocupantes"

#. ~ Description of effect 'Concerning symptoms'.
#: lang/json/effects_from_json.py
msgid "Your muscles keep twitching strangely."
msgstr "Tus músculos siguen sacudiéndose de manera extraña."

#: lang/json/effects_from_json.py
msgid "Unnerving symptoms"
msgstr "Síntomas inquietantes"

#. ~ Description of effect 'Unnerving symptoms'.
#: lang/json/effects_from_json.py
msgid ""
"Your nervous system is malfunctioning, almost like it's being torn apart "
"from the inside."
msgstr ""
"Tu sistema nervioso está funcionando mal, casi como si te lo estuvieran "
"arrancando."

#: lang/json/effects_from_json.py
msgid "Gross food"
msgstr "Comida desagradable"

#. ~ Description of effect 'Gross food'.
#: lang/json/effects_from_json.py
msgid "The food you eat is disgusting."
msgstr "Lo que comiste fue desagradable."

#: lang/json/effects_from_json.py
msgid "Demoralizing food"
msgstr "Comida desmoralizante"

#. ~ Description of effect 'Demoralizing food'.
#: lang/json/effects_from_json.py
msgid "Eating nothing but disgusting rations is starting to get you down."
msgstr "Comer solamente raciones desagradables está empezando a deprimirte."

#: lang/json/effects_from_json.py
msgid "Depressing food"
msgstr "Comida deprimente"

#. ~ Description of effect 'Depressing food'.
#: lang/json/effects_from_json.py
msgid ""
"Sure, you survived, but what kind of survival is this, eating these "
"disgusting rations day in and day out?"
msgstr ""
"Sí, sobreviviste, pero ¿qué clase de supervivencia es esta, comiendo estas "
"raciones desagradables día por medio?"

#: lang/json/effects_from_json.py
msgid "Mild hypovolemic shock"
msgstr "Choque hipovolémico leve"

#. ~ Description of effect 'Mild hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You've lost some blood and look somewhat pale."
msgstr "Perdiste un poco de sangre y estás un poco pálido."

#: lang/json/effects_from_json.py
msgid "Moderate hypovolemic shock"
msgstr "Choque hipovolémico moderado"

#. ~ Description of effect 'Moderate hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You've lost a large amount of blood, and you're not feeling well."
msgstr "Perdiste una gran cantidad de sangre y ahora no te sentís bien."

#: lang/json/effects_from_json.py
msgid "Advanced hypovolemic shock"
msgstr "Choque hipovolémico avanzado"

#. ~ Description of effect 'Advanced hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You've lost an awful lot of blood, and your condition is severe.  Seek "
"medical attention."
msgstr ""
"Perdiste muchísima sangre y tu condición es severa. Buscá atención médica."

#: lang/json/effects_from_json.py
msgid "Severe hypovolemic shock"
msgstr "Choque hipovolémico severo"

#. ~ Description of effect 'Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You've lost tremendous amount of blood, and you're standing on death's door."
"  Transfusion might save you."
msgstr ""
"Perdiste cantidades tremendas de sangre y estás a punto de morir. Una "
"transfusión podría salvarte."

#. ~ Apply message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You have lost a lot of blood, and your condition worsens."
msgstr "Perdiste mucha sangre y tu condición empeora."

#. ~ Remove message for effect(s) 'Mild hypovolemic shock, Moderate
#. hypovolemic shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You are no longer in shock."
msgstr "Ya no estás en choque hipovolémico."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"Your blood volume increases, and you feel better; but still, you look pale."
msgstr ""
"Tu cantidad de sangre aumenta y te sentís mejor, pero todavía estás pálido."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You feel stronger as your blood volume starts to improve."
msgstr ""
"Te sentís más fuerte a medida que tu cantidad de sangre comienza a mejorar."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You're not dying from lack of blood, but you're not out of the woods yet."
msgstr ""
"Ya no te estás muriendo por falta de sangre pero todavía estás en riesgo."

#: lang/json/effects_from_json.py
msgid "Lit up"
msgstr "Iluminado"

#. ~ Description of effect 'Lit up'.
#: lang/json/effects_from_json.py
msgid "You are carrying a light and can't hide well."
msgstr "Estás llevando una luz y no te podés esconder muy bien."

#: lang/json/effects_from_json.py
msgid "Started recovery"
msgstr "Empezando a recuperarse"

#: lang/json/effects_from_json.py
msgid "Recovering"
msgstr "Recuperándose"

#: lang/json/effects_from_json.py
msgid "Mostly recovered"
msgstr "Casi recuperado"

#: lang/json/effects_from_json.py
msgid "This damaged limb is slowly regaining its functions."
msgstr "Este miembro dañado está recuperando sus funciones lentamente."

#: lang/json/effects_from_json.py
msgctxt "physically"
msgid "Disabled"
msgstr "Incapacitado"

#. ~ Description of effect '{'ctxt': 'physically', 'str': 'Disabled'}'.
#: lang/json/effects_from_json.py
msgid "This limb is damaged beyond use and may require a splint to recover."
msgstr ""
"Este miembro está tan dañado que no lo podés usar y puede necesitar ser "
"entablillado para poder sanar."

#. ~ Apply message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py lang/json/snippet_from_json.py
msgid "Your limb breaks!"
msgstr "¡Se te fracturó ese miembro!"

#. ~ Remove message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py
msgid "The broken limb has mended."
msgstr "El miembro fracturado se recuperó."

#: lang/json/effects_from_json.py
msgid "Milked"
msgstr "Ordeñada"

#. ~ Description of effect 'Milked'.
#: lang/json/effects_from_json.py
msgid "The creature has been partially or fully milked."
msgstr "Esta criatura ha sido ordeñada completa o parcialmente."

#: lang/json/effects_from_json.py
msgid "Sheared"
msgstr "Esquilada"

#. ~ Description of effect 'Sheared'.
#: lang/json/effects_from_json.py
msgid "The creature has been fully sheared."
msgstr "La criatura ha sido completamente esquilada."

#: lang/json/effects_from_json.py
msgid "Painkillers"
msgstr "Analgésicos"

#. ~ Description of effect 'Painkillers'.
#: lang/json/effects_from_json.py
msgid ""
"You are under the influence of analgesic substances to relieve pain, but "
"they may numb you a bit."
msgstr ""
"Estás bajo los efectos de sustancias analgésicas para aliviar el dolor, pero"
" te pueden adormecer un poco."

#: lang/json/effects_from_json.py
msgid "Happy"
msgstr "Feliz"

#. ~ Description of effect 'Happy'.
#: lang/json/effects_from_json.py
msgid "Life is good."
msgstr "La vida está copada."

#: lang/json/effects_from_json.py
msgid "Joyful"
msgstr "Alegre"

#. ~ Description of effect 'Joyful'.
#: lang/json/effects_from_json.py
msgid "Oh what a day!  What a lovely day!"
msgstr "¡Oh, qué día! ¡Qué día hermoso!"

#: lang/json/effects_from_json.py
msgid "Elated"
msgstr "Eufórico"

#. ~ Description of effect 'Elated'.
#: lang/json/effects_from_json.py
msgid "I'm on top of the world, baby!"
msgstr "¡Soy lo mejor del mundo, chabón!"

#: lang/json/effects_from_json.py
msgid "Unhappy"
msgstr "Infeliz"

#. ~ Description of effect 'Unhappy'.
#: lang/json/effects_from_json.py
msgid "You are not content with your life."
msgstr "No estás contento/a con tu vida."

#: lang/json/effects_from_json.py
msgid "Sad"
msgstr "Triste"

#. ~ Description of effect 'Sad'.
#: lang/json/effects_from_json.py
msgid "This is not what you planned for your life."
msgstr "Esto no es lo que tenías planeado para tu vida."

#: lang/json/effects_from_json.py
msgid "Depressed"
msgstr "Deprimido"

#. ~ Description of effect 'Depressed'.
#: lang/json/effects_from_json.py
msgid "When will all your suffering end?"
msgstr "¿Cuándo se terminará todo este sufrimiento?"

#. ~ Miss message for effect(s) 'Unhappy, Unhappy, Unhappy, Unhappy, Unhappy,
#. Sad, Sad, Sad, Sad, Sad, Depressed'.
#: lang/json/effects_from_json.py
msgid "What's the point of fighting?"
msgstr "¿Qué sentido tiene pelear?"

#: lang/json/effects_from_json.py
msgid "Weakness"
msgstr "Debilidad"

#: lang/json/effects_from_json.py
msgid "Stimulants"
msgstr "Estimulantes"

#. ~ Description of effect 'Stimulants'.
#: lang/json/effects_from_json.py
msgid "You're very jittery and pumped up, probably from some stimulants."
msgstr ""
"Te sentís muy agitado y excitado, probablemente sean los estimulantes."

#: lang/json/effects_from_json.py
msgid "Depressants"
msgstr "Calmantes"

#. ~ Description of effect 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You are under the influence of depressants, and in a bit of a daze."
msgstr "Estás bajo los efectos de calmantes, y un poco aturdido."

#: lang/json/effects_from_json.py
msgid "Stimulant Overdose"
msgstr "Sobredosis de Estimulantes"

#. ~ Description of effect 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid ""
"You can't sit still as you feel your heart pounding out of your chest.  You "
"probably overdosed on those stims."
msgstr ""
"No te podés quedar quieto, sentís como te golpea el corazón. Probablemente, "
"se te fue la mano con los estimulantes."

#. ~ Miss message for effect(s) 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid "You shake with the excess stimulation."
msgstr "Temblás por el exceso de estimulación."

#: lang/json/effects_from_json.py
msgid "Took weak antibiotic"
msgstr "Tomaste antibiótico suave"

#. ~ Description of effect 'Took weak antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed mild antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Consumiste un antibiótico suave hace poco para combatir la infección.\n"
"Si no te recuperás, deberías tomar otra dosis pero tené cuidado con la sobredosis."

#: lang/json/effects_from_json.py
msgid "Took antibiotic"
msgstr "Tomaste antibiótico"

#. ~ Description of effect 'Took antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Consumiste un antibiótico hace poco para combatir la infección.\n"
"Si no te recuperás, deberías tomar otra dosis pero tené cuidado con la sobredosis."

#: lang/json/effects_from_json.py
msgid "Took strong antibiotic"
msgstr "Tomaste antibiótico fuerte"

#. ~ Description of effect 'Took strong antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed prescription-grade antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Consumiste un antibiótico solo de venta con receta hace poco para combatir la infección.\n"
"Si no te recuperás, deberías tomar otra dosis pero tené cuidado con la sobredosis."

#: lang/json/effects_from_json.py
msgid "Panacea"
msgstr "Panacea"

#. ~ Description of effect 'Panacea'.
#: lang/json/effects_from_json.py
msgid "You feel incredible!  You could take on the world!"
msgstr "¡Te sentís increíble! ¡Podías apoderarte del mundo!"

#: lang/json/effects_from_json.py
msgid "Soothed stomach"
msgstr "Estómago aliviado"

#. ~ Description of effect 'Soothed stomach'.
#: lang/json/effects_from_json.py
msgid "You are under the effects of a stomach soother."
msgstr "Estás bajo los efectos de tener el estómago aliviado."

#: lang/json/effects_from_json.py
msgid "Antifungals"
msgstr "Antifúngicos"

#. ~ Description of effect 'Antifungals'.
#: lang/json/effects_from_json.py
msgid "You are under the effects of an antifungal medicine or chemicals."
msgstr "Estás bajo los efectos de un medicamento o químico antifúngico."

#: lang/json/effects_from_json.py
msgid "Discharge"
msgstr "Descarga"

#. ~ Description of effect 'Discharge'.
#: lang/json/effects_from_json.py
msgid "You've been recently affected by an electromagnetic pulse."
msgstr "Has sido afectado recientemente por un pulso electromagnético."

#: lang/json/effects_from_json.py
msgid "Supercharged"
msgstr "Supercarga"

#. ~ Description of effect 'Supercharged'.
#: lang/json/effects_from_json.py
msgid "You've been struck by lightning, and feel… different."
msgstr "Has sido golpeado por un rayo, y te sentís… diferente."

#: lang/json/effects_from_json.py
msgid "Grown of Fusion"
msgstr "Crecido por Fusión"

#. ~ Description of effect 'Grown of Fusion'.
#: lang/json/effects_from_json.py
msgid ""
"AI effect to increase stats after fusing with another critter.  1 stack "
"means one absorbed max_hp."
msgstr ""
"Efecto de IA para incrementar las características después de haberse "
"fusionado con otra criatura. 1 acumulado significa un max_hp absorbido."

#: lang/json/effects_from_json.py
msgid "Stinking air"
msgstr "Aire apestoso"

#. ~ Description of effect 'Stinking air'.
#: lang/json/effects_from_json.py
msgid "The air in here smells like vinegar and mold."
msgstr "Acá el aire huele a vinagre y moho."

#: lang/json/effects_from_json.py
msgid "Disorienting air"
msgstr "Aire desorientador"

#. ~ Description of effect 'Disorienting air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It makes you feel soft-headed"
" and confused."
msgstr ""
"Acá el aire huele a vinagre y moho. Te hace sentir mareado y confundido."

#: lang/json/effects_from_json.py
msgid "Smothering air"
msgstr "Aire asfixiante"

#. ~ Description of effect 'Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It is closing in and "
"smothering you, making it impossible to think clearly."
msgstr ""
"Acá el aire huele a vinagre y moho. Pareciera cerrarse y empezar a "
"asfixiarte, haciéndote imposible pensar con claridad."

#. ~ Apply message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold, and hurts your lungs a bit."
msgstr "Acá el aire huele a vinagre y moho y te duelen un poco los pulmones."

#. ~ Miss message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid "You feel groggy in this sweltering, foul air."
msgstr "Te sentís atontado en este aire sofocante y nauseabundo."

#: lang/json/effects_from_json.py
msgid "Covered in fetid goop"
msgstr "Cubierto por un pegote fétido"

#. ~ Description of effect 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid ""
"The feeling of the goop slowly sliding on your skin revulses you and the "
"smell makes you gag."
msgstr ""
"La sensación del pegote chorreando lentamente por tu piel te repugna y el "
"olor te da arcadas."

#. ~ Apply message for effect(s) 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid "You're disgusted by the goop."
msgstr "Estás asqueado por el pegote."

#: lang/json/effects_from_json.py
msgid "Incorporeal"
msgstr "Incorpóreo"

#. ~ Description of effect 'Incorporeal'.
#: lang/json/effects_from_json.py
msgid "You lack substance, as if composed of mist."
msgstr "Te falta sustancia, como si estuvieras compuesto de neblina."

#: lang/json/effects_from_json.py
msgid "Lightly Weary"
msgstr "Poca Fatiga"

#. ~ Description of effect 'Lightly Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been pretty active for a while; operating at the highest levels of activity will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.25x"
msgstr ""
"Hiciste un poco actividad por un rato, no vas a poder realizar los niveles más altos de actividad.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 1.25x"

#: lang/json/effects_from_json.py
msgid "Moderately Weary"
msgstr "Fatiga Media"

#. ~ Description of effect 'Moderately Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been quite active for a while; operating at higher levels of activity will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.67x, Active: 1.33x"
msgstr ""
"Hiciste bastante actividad por un rato, no vas a poder realizar los niveles altos de actividad.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 1.67x, Activo: 1.33x"

#: lang/json/effects_from_json.py
msgid "Weary"
msgstr "Fatiga"

#. ~ Description of effect 'Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been very active for a while, and need to slow down for a bit.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 2.5x, Active: 2x, Brisk: 1.5x"
msgstr ""
"Hiciste mucha actividad por un rato y necesitás descansar un poco.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 2.5x, Activo: 2x, Enérgico: 1.5x"

#: lang/json/effects_from_json.py
msgid "Very Weary"
msgstr "Mucha Fatiga"

#. ~ Description of effect 'Very Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and need to slow down.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 5x, Active: 4x, Brisk: 3x, Moderate: 2x"
msgstr ""
"Hiciste actividad extrema por un rato y necesitás descansar.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 5x, Activo: 4x, Enérgico: 3x, Moderado: 2x"

#: lang/json/effects_from_json.py
msgid "Extremely Weary"
msgstr "Fatiga Extrema"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and can't take much more activity.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Hiciste actividad extrema por un rato y no podés hacer más actividad.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 10x, Activo: 8x, Enérgico: 6x, Moderado: 4x, Liviano: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and really need to get some rest.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Hiciste actividad extrema por un rato y tenés mucha necesidad de descansar.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 10x, Activo: 8x, Enérgico: 6x, Moderado: 4x, Liviano: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while; it's time to stop.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Hiciste actividad extrema por un rato, tenés que parar.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 10x, Activo: 8x, Enérgico: 6x, Moderado: 4x, Liviano: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and can no longer keep pushing.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Hiciste actividad extrema por un rato y no podés esforzarte más.\n"
"Se aplican estas penalidades al costo de movimiento por cada nivel de actividad:\n"
"Extremo: 10x, Activo: 8x, Enérgico: 6x, Moderado: 4x, Liviano: 2x"

#: lang/json/effects_from_json.py src/character.cpp
