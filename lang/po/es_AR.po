#. ~ Description for pair of thermal electric socks
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a pair of socks with internal battery-powered heating elements.  Use"
" it to turn it on."
msgstr ""
"Es un par de medias con resistencias térmicas internas alimentadas con "
"baterías. Usalo para encenderlas."

