#: lang/json/MONSTER_from_json.py
msgid "shady Deinonychus"
msgid_plural "shady Deinonychus"
msgstr[0] "Deinonychus sombrío"
msgstr[1] "Deinonychus sombríos"

#. ~ Description for {'str_sp': 'shady Deinonychus'}
