#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Pillhead"
msgstr "Adicto a las pastillas"

#. ~ Profession (male Pillhead) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"After an accident in your youth, you got addicted to the opiates treating "
"your pain.  With the pharmacies shut down and your dealers turned undead, "
"satisfying those cravings just got a lot more difficult."
msgstr ""
"Después de un accidente que sufriste en tu juventud, te hiciste adicto a los"
" opiáceos que te ayudaban con el dolor. Ahora que las farmacias cerraron y "
"los repartidores son muertos vivos, satisfacer ese deseo se hizo un poco más"
" complicado."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Pillhead"
msgstr "Adicta a las pastillas"

#. ~ Profession (female Pillhead) description
#: lang/json/professions_from_json.py
