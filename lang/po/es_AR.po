msgstr "expolicía"

#: lang/json/npc_class_from_json.py
msgid "I used to be a police officer, but I'm just a survivor now."
msgstr "Antes era un oficial de policía pero ahora solo soy un sobreviviente."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
