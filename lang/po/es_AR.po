#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
msgid "manhole cover"
msgid_plural "manhole covers"
msgstr[0] "tapa de cámara de inspección"
msgstr[1] "tapas de cámara de inspección"

#. ~ Description for manhole cover
#: lang/json/GENERIC_from_json.py
msgid ""
"A heavy iron disc that typically covers a ladder into the sewers.  Lifting "
"it from the manhole is impossible without a crowbar."
msgstr ""
"Es un disco pesado de hierro que comúnmente cubre la escalera que baja a las"
" cloacas. No se puede abrir la cámara de inspección sin una barreta."

#: lang/json/GENERIC_from_json.py
msgid "pine bough"
msgid_plural "pine boughs"
msgstr[0] "rama de pino"
msgstr[1] "ramas de pino"

#. ~ Description for pine bough
#: lang/json/GENERIC_from_json.py
msgid ""
"A branch from a pine tree, oozing sticky sap and bristling with prickly "
"needles."
msgstr ""
"Es una rama de un pino, con savia pegajosa goteando y cubierta de espinas "
"puntiagudas."

#: lang/json/GENERIC_from_json.py
msgid "pinecone"
msgid_plural "pinecones"
msgstr[0] "piña"
msgstr[1] "piñas"

#. ~ Description for pinecone
#: lang/json/GENERIC_from_json.py
msgid ""
"A spiny pod from a pine tree.  Dry seeds rattle around inside when you shake"
" it."
msgstr ""
"Es una vaina espinosa de un pino. Adentro, se escuchan las semillas secas "
"cuando la agitás."

#: lang/json/GENERIC_from_json.py
msgid "poppy bud"
msgid_plural "poppy buds"
msgstr[0] "capullo de amapola"
msgstr[1] "capullos de amapola"

#. ~ Description for poppy bud
#: lang/json/GENERIC_from_json.py
msgid ""
"A poppy bud.  Contains some substances commonly produced by a mutated poppy "
"flower."
msgstr ""
"Es un capullo de amapola. Contiene algunas sustancias comúnmente producidas "
"por una flor de amapola mutada."

#. ~ Description for sunflower
#: lang/json/GENERIC_from_json.py
msgid ""
"The top of a sunflower, with yellow pedals and some seeds that have yet to "
"be eaten by animals."
msgstr ""
"La parte superior de un girasol, con pétalos amarillos y algunas semillas "
"que todavía no han sido comidas por animales."

#: lang/json/GENERIC_from_json.py
msgid "chamomile flowers"
msgid_plural "chamomile flowers"
msgstr[0] "flores de manzanilla"
msgstr[1] "flores de manzanilla"

#. ~ Description for {'str_sp': 'chamomile flowers'}
#: lang/json/GENERIC_from_json.py
msgid ""
"White chamomile flowers, used as a herbal remedy since the ancient times."
msgstr ""
"Son unas flores blancas de manzanilla, utilizadas desde la antigüedad como "
"hierba medicinal."

#: lang/json/GENERIC_from_json.py
msgid "lotus flower"
msgid_plural "lotus flowers"
msgstr[0] "flor de loto"
msgstr[1] "flores de loto"

#. ~ Description for lotus flower
#. ~ Description for lotus
#: lang/json/GENERIC_from_json.py lang/json/furniture_from_json.py
msgid ""
"A lovely flower that grows on the surface of bodies of freshwater.  "
"Traditionally connected with many Eastern cultures."
msgstr ""
"Es una flor divina que crece en la superficie de los cuerpos de agua dulce. "
"Está conectada a la tradición de muchas culturas orientales."

#: lang/json/GENERIC_from_json.py
msgid "spurge flowers"
msgid_plural "spurge flowers"
msgstr[0] "flor de euforbio"
msgstr[1] "flores de euforbio"

#. ~ Description for {'str_sp': 'spurge flowers'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A handful of yellow-green flowers.  Can be brewed into a tea that prevents "
"asthma attacks."
msgstr ""
"Es un puñado de flores verdes y amarillas. Con ellas se puede hacer un té "
"que previene ataques de asma."

#: lang/json/GENERIC_from_json.py
msgid "lump of clay"
msgid_plural "lumps of clay"
msgstr[0] "masa de arcilla"
msgstr[1] "masas de arcilla"

#. ~ Description for lump of clay
#: lang/json/GENERIC_from_json.py
msgid "A fresh piece of clay.  Useful for some crafting recipes."
msgstr "Es masa de arcilla fresca. Útil para fabricar algunas cosas."

#: lang/json/GENERIC_from_json.py
msgid "brick"
msgid_plural "bricks"
msgstr[0] "ladrillo"
msgstr[1] "ladrillos"

#. ~ Description for brick
#: lang/json/GENERIC_from_json.py
msgid "A fire hardened building block used in masonry construction."
msgstr ""
"Un bloque de construcción endurecido al fuego, utilizado en albañilería."

#: lang/json/GENERIC_from_json.py
msgid "mortar"
msgid_plural "mortar"
msgstr[0] "mezcla"
msgstr[1] "mezcla"

#. ~ Description for {'str_sp': 'mortar'}
#: lang/json/GENERIC_from_json.py
msgid "Some mortar, ready to be used in building projects."
msgstr "Es un poco de mezcla, lista para ser usada en alguna construcción."

#: lang/json/GENERIC_from_json.py
msgid "soft adobe brick"
msgid_plural "soft adobe bricks"
msgstr[0] "ladrillo blando de adobe"
msgstr[1] "ladrillos blandos de adobe"

#. ~ Use action msg for soft adobe brick.
#: lang/json/GENERIC_from_json.py
msgid "You test the brick, and it seems solid enough to use."
msgstr "Probás el ladrillo y es lo suficientemente sólido como para usarlo."

#. ~ Use action not_ready_msg for soft adobe brick.
#: lang/json/GENERIC_from_json.py
msgid "The brick is still too damp to bear weight."
msgstr "El ladrillo todavía está demasiado húmedo para soportar peso."

#. ~ Description for soft adobe brick
#: lang/json/GENERIC_from_json.py
msgid ""
"A compacted mass of soil and natural fibers, still too wet to build with.  "
"Load it onto a pallet and leave it to dry."
msgstr ""
"Es una masa compacta de tierra y fibras naturales, todavía muy húmeda como "
"para usarla en alguna construcción. Cargala en un palé y dejá que se seque."

#: lang/json/GENERIC_from_json.py
msgid "adobe brick"
msgid_plural "adobe bricks"
msgstr[0] "ladrillo de adobe"
msgstr[1] "ladrillos de adobe"

#. ~ Description for adobe brick
#: lang/json/GENERIC_from_json.py
msgid ""
"A compacted mass of soil and natural fibers, baked dry enough to harden into"
" a brick."
msgstr ""
"Es una masa compacta de tierra y fibras naturales, cocinada para endurecerse"
" y ser un ladrillo."

#: lang/json/GENERIC_from_json.py
msgid "adobe mortar"
msgid_plural "adobe mortar"
msgstr[0] "mezcla de adobe"
msgstr[1] "mezcla de adobe"

#. ~ Description for {'str_sp': 'adobe mortar'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A thick, pasty mud, low in sand content to reduce crumbling once dry.  Used "
"to glue larger, heavier pieces of mud and clay together."
msgstr ""
"Es un barro pastoso y espeso, con poca arena para reducir el desmoronado "
"cuando está seco. Se usa para pegar pedazos de barro y arcilla más grandes y"
" pesados."

#: lang/json/GENERIC_from_json.py
msgid "tanbark"
msgid_plural "tanbark"
msgstr[0] "casca"
msgstr[1] "casca"

#. ~ Description for {'str_sp': 'tanbark'}
#: lang/json/GENERIC_from_json.py
msgid "A sheet of tannin-rich bark from a tree, useful for tanning leather"
msgstr ""
"Es un pedazo de corteza de árbol rica en tanino, útil para curtir cuero."

#: lang/json/GENERIC_from_json.py
msgid "birchbark"
msgid_plural "birchbarks"
msgstr[0] "corteza de abedul"
msgstr[1] "cortezas de abedul"

#. ~ Description for birchbark
#: lang/json/GENERIC_from_json.py
msgid "A sheet of tough, water-resistant bark taken from a birch tree."
msgstr ""
"Es un pedazo de corteza dura y resistente al agua, sacada de un abedul."

#: lang/json/GENERIC_from_json.py
msgid "willowbark"
msgid_plural "willowbark"
msgstr[0] "cortezas de sauce"
msgstr[1] "corteza de sauce"

#. ~ Description for {'str_sp': 'willowbark'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A sheet of bark taken from a willow tree.  Used in the production of "
"aspirin."
msgstr ""
"Es un pedazo de corteza sacado de un sauce. Se utiliza en la producción de "
"aspirinas."

#: lang/json/GENERIC_from_json.py
msgid "diamond"
msgid_plural "diamonds"
msgstr[0] "diamante"
msgstr[1] "diamantes"

#. ~ Description for diamond
#: lang/json/GENERIC_from_json.py
msgid "A sparkling diamond."
msgstr "Es un diamante brillante."

#: lang/json/GENERIC_from_json.py
msgid "garnet"
msgid_plural "garnets"
msgstr[0] "granate"
msgstr[1] "granates"

#. ~ Description for garnet
#: lang/json/GENERIC_from_json.py
msgid "A sparkling garnet."
msgstr "Es un granate brillante."

#: lang/json/GENERIC_from_json.py
msgid "amethyst"
msgid_plural "amethysts"
msgstr[0] "amatista"
msgstr[1] "amatistas"

#. ~ Description for amethyst
#: lang/json/GENERIC_from_json.py
msgid "A sparkling amethyst."
msgstr "Es una amatista brillante."

#: lang/json/GENERIC_from_json.py
msgid "aquamarine"
msgid_plural "aquamarines"
msgstr[0] "aguamarina"
msgstr[1] "aguamarinas"

#. ~ Description for aquamarine
#: lang/json/GENERIC_from_json.py
msgid "A sparkling aquamarine."
msgstr "Es una aguamarina brillante."

#: lang/json/GENERIC_from_json.py
msgid "emerald"
msgid_plural "emeralds"
msgstr[0] "esmeralda"
msgstr[1] "esmeraldas"

#. ~ Description for emerald
#: lang/json/GENERIC_from_json.py
msgid "A sparkling emerald."
msgstr "Es una esmeralda brillante."

#: lang/json/GENERIC_from_json.py
msgid "alexandrite"
msgid_plural "alexandrites"
msgstr[0] "alejandrita"
msgstr[1] "alejandritas"

#. ~ Description for alexandrite
#: lang/json/GENERIC_from_json.py
msgid "A sparkling alexandrite."
msgstr "Es una alejandrita brillante."

#: lang/json/GENERIC_from_json.py
msgid "pearl"
msgid_plural "pearls"
msgstr[0] "perla"
msgstr[1] "perlas"

#. ~ Description for pearl
#: lang/json/GENERIC_from_json.py
msgid "A lustrous pearl."
msgstr "Es una perla lustrosa."

#: lang/json/GENERIC_from_json.py
msgid "ruby"
msgid_plural "rubies"
msgstr[0] "rubí"
msgstr[1] "rubíes"

#. ~ Description for ruby
#: lang/json/GENERIC_from_json.py
msgid "A sparkling ruby."
msgstr "Es un rubí brillante."

#: lang/json/GENERIC_from_json.py
msgid "peridot"
msgid_plural "peridots"
msgstr[0] "peridoto"
msgstr[1] "peridotos"

#. ~ Description for peridot
#: lang/json/GENERIC_from_json.py
msgid "A sparkling peridot."
msgstr "Es un peridoto brillante."

#: lang/json/GENERIC_from_json.py
msgid "sapphire"
msgid_plural "sapphires"
msgstr[0] "zafiro"
msgstr[1] "zafiros"

#. ~ Description for sapphire
#: lang/json/GENERIC_from_json.py
msgid "A sparkling sapphire."
msgstr "Es un zafiro brillante."

#: lang/json/GENERIC_from_json.py
msgid "opal"
msgid_plural "opals"
msgstr[0] "ópalo"
msgstr[1] "ópalos"

#. ~ Description for opal
#: lang/json/GENERIC_from_json.py
msgid "A lustrous opal."
msgstr "Es un ópalo lustroso."

#: lang/json/GENERIC_from_json.py
msgid "tourmaline"
msgid_plural "tourmalines"
msgstr[0] "turmalina"
msgstr[1] "turmalinas"

#. ~ Description for tourmaline
#: lang/json/GENERIC_from_json.py
msgid "A sparkling tourmaline."
msgstr "Es una turmalina brillante."

#: lang/json/GENERIC_from_json.py
msgid "citrine"
msgid_plural "citrines"
msgstr[0] "citrino"
msgstr[1] "citrinos"

#. ~ Description for citrine
#: lang/json/GENERIC_from_json.py
msgid "A sparkling citrine."
msgstr "Es un citrino brillante."

#: lang/json/GENERIC_from_json.py
msgid "topaz"
msgid_plural "topazes"
msgstr[0] "topacio"
msgstr[1] "topacios"

#. ~ Description for topaz
#: lang/json/GENERIC_from_json.py
msgid "A sparkling blue topaz."
msgstr "Es un topacio azul brillante."

#: lang/json/GENERIC_from_json.py
msgid "cured hide"
msgid_plural "cured hides"
msgstr[0] "pellejo curado"
msgstr[1] "pellejos curados"

#. ~ Description for cured hide
#: lang/json/GENERIC_from_json.py
msgid ""
"A rolled up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It still requires tanning to become usable "
"leather."
msgstr ""
"Un pellejo enrollado de animal que ha sido rasqueteado para sacarle los "
"pelos y carne, y tratado para prevenir la descomposición. Todavía necesita "
"ser curtido para convertirse en cuero utilizable."

#: lang/json/GENERIC_from_json.py
msgid "tanned hide"
msgid_plural "tanned hides"
msgstr[0] "pellejo curtido"
msgstr[1] "pellejos curtidos"

#. ~ Description for tanned hide
#: lang/json/GENERIC_from_json.py
msgid ""
"A folded sheet of leather made from carefully tanned animal hide.  Can be "
"cut up or used as is."
msgstr ""
"Es un pedazo grande doblado de cuero, hecho con pellejo de animal "
"cuidadosamente curtido. Puede ser cortado o ser usado así."

#: lang/json/GENERIC_from_json.py
msgid "cured pelt"
msgid_plural "cured pelts"
msgstr[0] "pelaje curado"
msgstr[1] "pelajes curados"

#. ~ Description for cured pelt
#: lang/json/GENERIC_from_json.py
msgid ""
"A rolled up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It still requires tanning to become usable "
"fur."
msgstr ""
"Un pelaje enrollado de animal que ha sido rasqueteado para sacarle los pelos"
" y carne, y tratado para prevenir la descomposición. Todavía necesita ser "
"curtido para convertirse en piel utilizable."

#: lang/json/GENERIC_from_json.py
msgid "tanned pelt"
msgid_plural "tanned pelts"
msgstr[0] "pelaje curtido"
msgstr[1] "pelajes curtidos"

#. ~ Description for tanned pelt
#: lang/json/GENERIC_from_json.py
msgid ""
"A folded sheet of leather made from carefully tanned animal hide, with the "
"fur still intact.  Can be cut up or used as is."
msgstr ""
"Es un pedazo grande doblado de cuero, hecho con pellejo de animal "
"cuidadosamente curtido, con la piel todavía intacta. Puede ser cortado o ser"
" usado así."

#: lang/json/GENERIC_from_json.py
msgid "pile of straw"
msgid_plural "piles of straw"
msgstr[0] "pila de paja"
msgstr[1] "pilas de paja"

#. ~ Description for pile of straw
#: lang/json/GENERIC_from_json.py
msgid ""
"A pile of dry grass.  Can be used to craft a straw bed if there is nothing "
"else to sleep on."
msgstr ""
"Es una pila de pasto seco. Se puede usar para hacer una cama de paja si no "
"hay otra cosa en la que dormir."

#: lang/json/GENERIC_from_json.py
msgid "straw doll"
msgid_plural "straw dolls"
msgstr[0] "muñeca de paja"
msgstr[1] "muñecas de paja"

#. ~ Description for straw doll
#: lang/json/GENERIC_from_json.py
msgid "Old straw doll.  Represents a woman in a dress."
msgstr "Una muñeca vieja de paja. Representa una mujer con un vestido."

#: lang/json/GENERIC_from_json.py
msgid "pillow"
msgid_plural "pillows"
msgstr[0] "almohada"
msgstr[1] "almohadas"

#. ~ Description for pillow
#: lang/json/GENERIC_from_json.py
msgid "A pillow to rest your head on when sleeping."
msgstr "Es una almohada para descansar tu cabeza cuando dormís."

#: lang/json/GENERIC_from_json.py
msgid "body pillow"
msgid_plural "body pillows"
msgstr[0] "almohada de cuerpo"
msgstr[1] "almohadas de cuerpo"

#. ~ Description for body pillow
#: lang/json/GENERIC_from_json.py
msgid ""
"A big, body-sized pillow with a print of an anime character on the front and"
" their scantily clad version on the back."
msgstr ""
"Es una almohada grande, del tamaño de tu cuerpo, con un personaje de dibujo "
"animado en la parte de adelante, y una versión con poca ropa en la parte de "
"atrás."

#: lang/json/GENERIC_from_json.py
msgid "makeshift body pillow"
msgid_plural "makeshift body pillows"
msgstr[0] "almohada de cuerpo improvisada"
msgstr[1] "almohadas de cuerpo improvisadas"

#. ~ Description for makeshift body pillow
#: lang/json/GENERIC_from_json.py
msgid ""
"A big, body-sized pillow.  Someone drew a vaguely humanoid figure on it.  "
"Its heartwarming smile fills you with joy."
msgstr ""
"Es una gran almohada, tamaño cuerpo. Alguien dibujó una figura vagamente "
"humana en ella. Su sonrisa cálida te llena de regocijo."

#: lang/json/GENERIC_from_json.py
msgid "down-filled pillow"
msgid_plural "down-filled pillows"
msgstr[0] "almohada de plumón"
msgstr[1] "almohadas de plumón"

#. ~ Description for down-filled pillow
#: lang/json/GENERIC_from_json.py
msgid "A fluffy pillow to rest your head on when sleeping."
msgstr "Es una almohada acolchada para descansar tu cabeza cuando dormís."

#: lang/json/GENERIC_from_json.py
msgid "teddy bear"
msgid_plural "teddy bears"
msgstr[0] "osito de peluche"
msgstr[1] "ositos de peluche"

#. ~ Description for teddy bear
#: lang/json/GENERIC_from_json.py
msgid ""
"An old and half rotten teddy bear.  Looks like this one commemorates the "
"grave of the child who once owned it."
msgstr ""
"Un osito de peluche viejo y ha medio podrir. Parece que este conmemora la "
"tumba del niño al que alguna vez perteneció."

#. ~ Description for teddy bear
#: lang/json/GENERIC_from_json.py
msgid ""
"A mass-produced plush teddy bear.  It is wearing a little red tshirt but no "
"pants."
msgstr ""
"Es un osito de peluche de producción masiva. Tiene puesta una remera roja "
"pero no tiene pantalones."

#: lang/json/GENERIC_from_json.py
msgid "money bundle"
msgid_plural "money bundles"
msgstr[0] "fajo de billetes"
msgstr[1] "fajos de billetes"

#. ~ Description for money bundle
#: lang/json/GENERIC_from_json.py
msgid "A bundle holding many 20 dollar bills, pretty useless now though."
msgstr ""
"Un fajo con muchos billetes de 20 dólares, que ahora son bastante "
"inservibles."

#: lang/json/GENERIC_from_json.py
msgid "one dollar bill"
msgid_plural "one dollar bills"
msgstr[0] "billete de un dólar"
msgstr[1] "billetes de un dólar"

#. ~ Description for one dollar bill
#: lang/json/GENERIC_from_json.py
msgid "A one dollar bill, pretty useless now though."
msgstr "Es un billete de un dólar, bastante inútil ahora."

#: lang/json/GENERIC_from_json.py
msgid "ten dollar bill"
msgid_plural "ten dollar bills"
msgstr[0] "billete de diez dólares"
msgstr[1] "billetes de diez dólares"

#. ~ Description for ten dollar bill
#: lang/json/GENERIC_from_json.py
msgid "A ten dollar bill, pretty useless now though."
msgstr "Es un billete de diez dólares, bastante inútil ahora."

#: lang/json/GENERIC_from_json.py
msgid "twenty dollar bill"
msgid_plural "twenty dollar bills"
msgstr[0] "billete de veinte dólares"
msgstr[1] "billetes de veinte dólares"

#. ~ Description for twenty dollar bill
#: lang/json/GENERIC_from_json.py
msgid "A twenty dollar bill, pretty useless now though."
msgstr "Es un billete de veinte dólares, bastante inútil ahora."

