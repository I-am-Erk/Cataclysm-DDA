msgid_plural "armored Brachiosaurus"
msgstr[0] "Brachiosaurus blindado"
msgstr[1] "Brachiosaurus blindados"

#. ~ Description for {'str_sp': 'armored Brachiosaurus'}
#: lang/json/MONSTER_from_json.py
msgid ""
"This zombified Brachiosaurus has grown dense body armor, completely covering"
" the gigantic, long-necked, four-legged body."
msgstr ""
"A este Brachiosaurus zombificado le ha crecido una armadura ósea densa que "
"cubre completamente el gigantesco cuerpo de cuatro patas y cuello largo."

#: lang/json/MONSTER_from_json.py
msgid "armored Alamosaurus"
msgid_plural "armored Alamosaurus"
msgstr[0] "Alamosaurus blindado"
msgstr[1] "Alamosaurus blindados"

#. ~ Description for {'str_sp': 'armored Alamosaurus'}
