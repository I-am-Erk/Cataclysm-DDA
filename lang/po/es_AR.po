msgstr ""
"%s pudo aguantar al primer lobo pero los otros que estaban merodeando en los"
" árboles se metieron…"

#: src/mission_companion.cpp
msgid "I'm sorry, there wasn't anything we could do…"
msgstr "Lo lamento, no pudimos hacer nada…"

#: src/mission_companion.cpp
#, c-format
msgid ""
