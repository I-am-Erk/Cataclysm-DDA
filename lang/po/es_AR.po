"cubre completamente el masivo cuerpo de cuatro patas y la pequeña cabeza."

#: lang/json/MONSTER_from_json.py
msgid "armored Camarasaurus"
msgid_plural "armored Camarasaurus"
msgstr[0] "Camarasaurus blindado"
msgstr[1] "Camarasaurus blindados"

#. ~ Description for {'str_sp': 'armored Camarasaurus'}
