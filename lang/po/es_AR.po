msgstr[0] ".45 ACP +P"
msgstr[1] ".45 ACP +P"

#. ~ Description for {'str_sp': '.45 ACP +P'}
#: lang/json/AMMO_from_json.py
msgid ""
"Overpressure .45 ACP ammunition with 185gr JHP bullets.  This +P ammunition "
"has higher muzzle energy than typical loads leading to greater damage, "
"accuracy and recoil."
msgstr ""
"Es munición sobrepresionada .45 ACP JHP de 185gr. Esta munición +P tiene "
"mayor energía de bocacha que las cargas normales, lo que causa mayor daño, "
"precisión y retroceso."

