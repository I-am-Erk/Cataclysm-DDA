msgstr ""
"Es un agarrabot roto, ahora inmóvil e indefenso. Puede ser desarmado o "
"reconstruido."

#: lang/json/GENERIC_from_json.py
msgid "broken pest hunter"
msgid_plural "broken pest hunters"
msgstr[0] "cazapestes roto"
msgstr[1] "cazapestes rotos"

#. ~ Description for broken pest hunter
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken pest hunter, now harmless and inert.  Could be gutted for parts or "
"re-crafted."
msgstr ""
"Es un cazapestes roto, ahora inerte e indefenso. Puede ser desarmado o "
"reconstruido."

#: lang/json/GENERIC_from_json.py
msgid "broken Imaginifier"
msgid_plural "broken Imaginifiers"
msgstr[0] "Imaginifier roto"
msgstr[1] "Imaginifiers rotos"

#. ~ Description for broken Imaginifier
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken military humaniform, shattered and inert.  While it looks nowhere "
"near human, you still feel uneasy - as if it is studying you with its eyes."
"  Could be stripped for parts."
msgstr ""
"Es un humaniforme militar roto, destruido e inerte. Aunque no se parece en "
"nada a un humano, te hace sentir incómodo - como si te estuviera estudiando "
"con sus ojos. Puede ser desarmado para recuperar partes."

#: lang/json/GENERIC_from_json.py
msgid "broken Hashashiyyin"
msgid_plural "broken Hashashiyyins"
msgstr[0] "Hashashiyyin roto"
msgstr[1] "Hashashiyyins rotos"

#. ~ Description for broken Hashashiyyin
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken Hashashiyyin, shattered and inert.  While it looks nowhere near "
"human, you still feel uneasy - as if it is studying you with its eyes.  "
"Could be stripped for parts."
msgstr ""
"Es un Hashashiyyin roto, destruido e inerte. Aunque no se parece en nada a "
"un humano, te hace sentir incómodo - como si te estuviera estudiando con sus"
" ojos. Puede ser desarmado para recuperar partes."

#: lang/json/GENERIC_from_json.py
msgid "broken Suppressor"
msgid_plural "broken Suppressors"
msgstr[0] "Represor roto"
msgstr[1] "Represores rotos"

#. ~ Description for broken Suppressor
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken Suppressor, shattered and inert.  Could be stripped for parts."
msgstr ""
"Es un Represor roto, destrozado e inerte. Puede ser desarmado para recuperar"
" partes."

#: lang/json/GENERIC_from_json.py
msgid "broken floating heater"
msgid_plural "broken floating heaters"
msgstr[0] "calentador flotante roto"
msgstr[1] "calentadores flotantes rotos"

#. ~ Description for broken floating heater
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken floating heater, now cold and motionless.  Could be stripped down "
"or re-crafted."
msgstr ""
"Es un calentador flotante roto, ahora frío e inmóvil. Puede ser desarmado o "
"reconstruido."

#: lang/json/GENERIC_from_json.py
msgid "broken Aegis"
msgid_plural "broken Aegises"
msgstr[0] "Égida roto"
msgstr[1] "Égidas rotos"

#. ~ Description for broken Aegis
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken defense robot.  Could be gutted for parts or crafted into a "
"salvaged robot."
msgstr ""
"Es un robot defensivo roto. Puede ser desarmado para recuperar partes o "
"convertido en un robot recuperado."

#: lang/json/GENERIC_from_json.py
