#. ~ Description for {'str_sp': '.357 SIG FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
"Jacketed .357 SIG ammunition.  The .357 SIG round is a high velocity pistol "
"cartridge, giving it a flatter trajectory than many handgun rounds."
msgstr ""
"Es munición .357 SIG recubierta. El .357 SIG es un cartucho de pistola de "
"alta velocidad, lo que le da una trayectoria más recta que otras balas."

