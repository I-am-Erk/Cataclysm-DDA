#: lang/json/GENERIC_from_json.py
msgid "tear gas grenade"
msgid_plural "tear gas grenades"
msgstr[0] "granada lacrimógina"
msgstr[1] "granadas lacrimóginas"

#. ~ Description for tear gas grenade
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a canister grenade filled with noxious irritant.  Use this item to "
"pull the pin and light the fuse, turning it into an active tear gas grenade."
"  In five seconds it will begin to expel a highly toxic gas for some time.  "
"This gas damages and slows those who enter it, as well as obscuring vision "
"and scent."
msgstr ""
"Es una granada en forma de lata llena de un irritante nocivo. Usala para el "
"sacarle el gancho y activar el detonador, lo que activa la granada de gas "
"lacrimógeno. Explotará en cinco segundos y empezará a largar un gas "
"altamente tóxico por un rato. Este gas daña y detiene a los que son "
"afectados y también dificulta la visión y el olfato."

#: lang/json/GENERIC_from_json.py
msgid "armed tear gas canister"
msgid_plural "armed tear gas canisters"
msgstr[0] "granada lacrimógina activada"
msgstr[1] "granadas lacrimóginas activadas"

