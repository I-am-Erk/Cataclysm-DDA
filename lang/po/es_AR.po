#. ~ Description for Kelvinist Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Kelvinists.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea una pequeña piedra alineada a los Kelvinistas. Podés usar "
"la runa como catalizador en recetas."

#: lang/json/SPELL_from_json.py
msgid "Flamesword"
msgstr "Espada Llameante"

#. ~ Description for Flamesword
#: lang/json/SPELL_from_json.py
msgid ""
"This spell ignites a wooden sword, creating a flaming blade able to burn, "
"bruise, and chop."
msgstr ""
"Este hechizo prende fuego una espada de madera creando una cuchilla "
"llameante capaz de quemar, golpear y cortar."

#: lang/json/SPELL_from_json.py
msgid "Flamebreath"
msgstr "Aliento de Llamas"

#. ~ Description for Flamebreath
#: lang/json/SPELL_from_json.py
msgid ""
"This spell ignites dust scattered in the air, creating a cone of flame.  The"
" hot ashes can cling to targets, causing additional burns over time."
msgstr ""
"Este hechizo incendia el polvo repartido en el aire creando un cono de "
"llamas. Las cenizas calientes se pegan al objetivo causando quemadura "
"durante un tiempo."

#: lang/json/SPELL_from_json.py
msgid "Freezing Touch"
msgstr "Toque Helante"

#. ~ Description for Freezing Touch
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of Freezing touch."
msgstr "Esto es un subhechizo del hechizo Toque helante."

#: lang/json/SPELL_from_json.py
msgid "Summon Crocodile"
msgstr "Conjurar Cocodrilo"

#. ~ Description for Summon Crocodile
#: lang/json/SPELL_from_json.py
msgid "Summons a permanent crocodile."
msgstr "Conjura un cocodrilo permanente."

#. ~ Message for SPELL 'Summon Crocodile'
#: lang/json/SPELL_from_json.py
msgid "The shaman summons a crocodile!"
msgstr "¡El chamán conjura un cocodrilo!"

#: lang/json/SPELL_from_json.py
msgid "an ancient reptilian spell"
msgstr "un antiguo hechizo reptiliano"

#. ~ Description for an ancient reptilian spell
#: lang/json/SPELL_from_json.py
msgid "Causes one of the shaman spells to be cast."
msgstr "Causa que uno de los hechizos de chamán sea conjurado."

#: lang/json/SPELL_from_json.py
msgid "Shadow Field"
msgstr "Campo de Sombra"

#. ~ Description for Shadow Field
#: lang/json/SPELL_from_json.py
msgid "Cast a field of intense shadows."
msgstr "Conjura un campo intenso de sombras."

#: lang/json/SPELL_from_json.py
msgid "Magic Missile"
msgstr "Misil Mágico"

#: lang/json/SPELL_from_json.py
msgid "Phase Door"
msgstr "Puerta Fásica"

#: lang/json/SPELL_from_json.py
msgid "Gravity Well"
msgstr "Pozo de Gravedad"

