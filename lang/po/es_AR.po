#. ~ Use action hostile_msg for inactive nurse bot.
#: lang/json/TOOL_from_json.py
msgid "You misprogram the nurse bot.  It's looking at you funny."
msgstr "Programaste mal el enfermerobot. Te mira con cara rara."

#. ~ Description for inactive nurse bot
#: lang/json/TOOL_from_json.py
