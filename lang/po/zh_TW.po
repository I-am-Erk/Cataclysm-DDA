msgstr ""

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Combat Mechanic"
msgstr "兵工"

#. ~ Profession (male Combat Mechanic) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You failed out of high school, and joined the army.  You were soon hand "
"picked for extra training in the mechanics trade, keeping the armour "
"running.  It's been years since you last touched a rifle, and the dead men "
"are marching again…"
msgstr ""

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Combat Mechanic"
msgstr "兵工"

#. ~ Profession (female Combat Mechanic) description
