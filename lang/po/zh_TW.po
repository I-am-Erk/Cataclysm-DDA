msgstr "用於發酵醋和各種酒類釀造的可密封桶。"

#: lang/json/furniture_from_json.py
msgid "filled fermenting vat"
msgstr "裝滿的發酵池"

#: lang/json/furniture_from_json.py
msgid "butchering rack"
msgstr "屠宰架"

#. ~ Description for butchering rack
#: lang/json/furniture_from_json.py
