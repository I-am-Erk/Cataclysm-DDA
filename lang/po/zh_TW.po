msgstr "適合白天服用的感冒藥， 治療感冒與流感。不嗜睡的配方， 能抑制咳嗽、喉嚨痛、頭痛、流鼻水， 但你仍然需要補充大量的液體和休息。"

#: lang/json/COMESTIBLE_from_json.py
msgid "antiseptic"
msgid_plural "antiseptic"
msgstr[0] "消毒劑"

#. ~ Description for {'str_sp': 'antiseptic'}
