#: lang/json/GENERIC_from_json.py
msgid "A small tin can, like what tuna comes in."
msgstr "小型錫罐，通常用來裝鮪魚。"

#: lang/json/GENERIC_from_json.py
msgid "medium tin can"
msgid_plural "medium tin cans"
msgstr[0] "中型錫罐"

#. ~ Description for medium tin can
#: lang/json/GENERIC_from_json.py
