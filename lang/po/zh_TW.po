msgid "deviled kidney"
msgid_plural "deviled kidneys"
msgstr[0] ""

#. ~ Description for deviled kidney
#: lang/json/COMESTIBLE_from_json.py
msgid "A delicious way to prepare kidneys."
msgstr "腎臟的一種美味調理方式。"

#: lang/json/COMESTIBLE_from_json.py
msgid "grilled sweetbread"
msgid_plural "grilled sweetbreads"
msgstr[0] "烤胸腺"

#. ~ Description for grilled sweetbread
#: lang/json/COMESTIBLE_from_json.py
msgid "Not sweet, like the name would suggest, but delicious all the same!"
msgstr "不如名字所暗示的那樣甜，但仍然美味！"

#: lang/json/COMESTIBLE_from_json.py
msgid "canned liver"
msgid_plural "canned livers"
msgstr[0] "肝罐頭"

#. ~ Description for canned liver
#: lang/json/COMESTIBLE_from_json.py
msgid "Livers preserved in a can.  Chock-full of B vitamins!"
msgstr ""

#: lang/json/COMESTIBLE_from_json.py
msgid "lung provence"
msgid_plural "lung provences"
msgstr[0] ""

#. ~ Description for lung provence
#: lang/json/COMESTIBLE_from_json.py
msgid "A delicious way to prepare lungs."
msgstr ""

