#: lang/json/AMMO_from_json.py
msgid ".44 Magnum FMJ"
msgid_plural ".44 Magnum FMJ"
msgstr[0] ".44 麥格農全金屬披甲彈"

#. ~ Description for {'str_sp': '.44 Magnum FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
"A brass-jacketed variant of the .44 Magnum round.  This increases "
"penetration slightly at the cost of reduced damage from expansion."
msgstr "以黃銅包覆全顆彈頭的 .44 麥格農彈。藉由犧牲彈頭擴張性所帶來的破壞力，其穿透力得以稍微提升。"

#: lang/json/AMMO_from_json.py
msgid ".44 Magnum"
msgid_plural ".44 Magnums"
msgstr[0] ".44 麥格農子彈"

#. ~ Description for .44 Magnum
#: lang/json/AMMO_from_json.py
msgid ""
".44 magnum ammunition with 240gr JHP bullets.  The .44 magnum round is one "
"of the most powerful handgun cartridges available.  It has excellent "
"stopping power but suffers from extremely high recoil for a handgun round."
msgstr ".44 麥格農子彈使用 240 格令空尖彈頭，在手槍彈種中有著最強的破壞力。抑止力相當優秀，但同時亦帶來極大的後座力。"

#: lang/json/AMMO_from_json.py
msgid ".44 Magnum FMJ, reloaded"
msgid_plural ".44 Magnum FMJ, reloaded"
msgstr[0] ".44 麥格農全金屬披甲彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".44 Magnum, reloaded"
msgid_plural ".44 Magnum, reloaded"
msgstr[0] ".44 麥格農子彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".44 Magnum, black powder"
msgid_plural ".44 Magnum, black powder"
msgstr[0] ".44 麥格農子彈（黑火藥）"

#: lang/json/AMMO_from_json.py
msgid ".44 Magnum FMJ, black powder"
msgid_plural ".44 Magnum FMJ, black powder"
msgstr[0] ".44 麥格農全金屬披甲彈（黑火藥）"

#: lang/json/AMMO_from_json.py
msgid ".44 paper cartridge"
msgid_plural ".44 paper cartridges"
msgstr[0] ".44 紙卷彈"

#. ~ Description for .44 paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and a .44 "
"projectile.  Used by the Colt M1860 Army."
msgstr "一個內含定量黑火藥與 .44 彈丸的紙卷子彈。適用於柯爾特 M1860 陸軍手槍。"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP FMJ"
msgid_plural ".45 ACP FMJ"
msgstr[0] ".45 ACP 全金屬披甲彈"

#. ~ Description for {'str_sp': '.45 ACP FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
".45 ACP ammunition with 230gr FMJ bullets.  Noted for its stopping power, "
"the .45 ACP round has been common for over a century."
msgstr ".45 ACP 全金屬彈使用 230 格令彈頭，全彈以金屬包覆。.45 彈因優秀的抑止力而聞名， 風行了接近 一世紀。"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP JHP"
msgid_plural ".45 ACP JHP"
msgstr[0] ".45 ACP 空尖彈"

#. ~ Description for {'str_sp': '.45 ACP JHP'}
#: lang/json/AMMO_from_json.py
msgid ""
".45 ACP ammunition with 185gr JHP bullets.  The .45 ACP round was developed "
"to replace the .38 Long Colt cartridge in the early 20th century.  It has "
"good stopping power but above average recoil."
msgstr ""
".45 ACP 空尖彈使用 185 格令空尖彈頭。在二十世紀初，新研發的 .45 ACP 子彈取代了舊式的 .38 "
"柯爾特子彈。它具有卓越的抑止力，但後座力略高。"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP +P"
msgid_plural ".45 ACP +P"
msgstr[0] ".45 ACP 高壓彈"

#. ~ Description for {'str_sp': '.45 ACP +P'}
#: lang/json/AMMO_from_json.py
msgid ""
"Overpressure .45 ACP ammunition with 185gr JHP bullets.  This +P ammunition "
"has higher muzzle energy than typical loads leading to greater damage, "
"accuracy and recoil."
msgstr ".45 ACP 高壓彈使用 185 格令空尖彈頭。高壓彈擁有較高的動能，使得它具有更高的準確度和破壞力，但後座力亦隨之而上升。"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP FMJ, black powder"
msgid_plural ".45 ACP FMJ, black powder"
msgstr[0] ".45 ACP 全金屬披甲彈（黑火藥）"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP JHP, black powder"
msgid_plural ".45 ACP JHP, black powder"
msgstr[0] ".45 ACP 空尖彈（黑火藥）"

#: lang/json/AMMO_from_json.py
msgid ".45 FMJ, reloaded"
msgid_plural ".45 FMJ, reloaded"
msgstr[0] ".45 全金屬彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP JHP, reloaded"
msgid_plural ".45 ACP JHP, reloaded"
msgstr[0] ".45 ACP 空尖彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".45 ACP +P, reloaded"
msgid_plural ".45 ACP +P, reloaded"
msgstr[0] ".45 ACP 高壓彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".454 Casull"
msgid_plural ".454 Casull"
msgstr[0] ".454 卡蘇爾子彈"

#. ~ Description for {'str_sp': '.454 Casull'}
#: lang/json/AMMO_from_json.py
msgid ""
".454 Casull ammunition with 300gr jacketed soft point bullets.  The .454 "
"Casull round is derived from .45 Long Colt with a stronger, lengthened case."
"  It is an exceptionally powerful cartridge with higher stopping power than "
"many rifle rounds, although it suffers from extreme recoil making it "
"unsuitable for most purposes."
msgstr ""
".454 卡蘇爾子彈使用 300 格令彈頭，軟尖彈頭外露而其餘部分以金屬包覆。.454 卡蘇爾子彈衍生自 .45 "
"柯爾特子彈，而彈殼更長更強。它擁有極強的破壞力，抑止力比不少步槍子彈還要強，但誇張的後座力使它的實用性受限。"

#: lang/json/AMMO_from_json.py
msgid ".454 Casull, reloaded"
msgid_plural ".454 Casull, reloaded"
msgstr[0] ".454 卡蘇爾子彈（重填彈）"

#: lang/json/AMMO_from_json.py
msgid ".454 Casull, black powder"
msgid_plural ".454 Casull, black powder"
msgstr[0] ".454 卡蘇爾子彈（黑火藥）"

#: lang/json/AMMO_from_json.py
msgid ".45-70 SP"
msgid_plural ".45-70 SP"
msgstr[0] ".45-70 SP"

#. ~ Description for {'str_sp': '.45-70 SP'}
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government ammunition loaded with a 305 grain soft point round.  One "
"of the oldest cartridges still in use, it is still a favorite for large game"
" hunting at short ranges."
msgstr ".45-70 政府彈藥裝有 305 喱軟尖彈頭。這是目前仍在使用的最古老的彈藥之一，它仍然是短距離大型狩獵物的最愛。"

#: lang/json/AMMO_from_json.py
msgid ".45-70 +P penetrator"
msgid_plural ".45-70 +P penetrators"
msgstr[0] ".45-70 超高壓穿甲彈"

#. ~ Description for .45-70 +P penetrator
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government +P ammunition loaded with a 305 grain solid copper "
"penetrator projectile.  Designed for maximum penetration through thick hide "
"and bone while maintaining ideal wounding characteristics."
msgstr ".45-70 政府高壓彈裝有 305 喱實心穿甲彈丸。設計在穿透厚重的毛皮和骨頭時還能保持造成重傷的特性。"

#: lang/json/AMMO_from_json.py
msgid ".45-70 LFN cowboy"
msgid_plural ".45-70 LFN cowboy"
msgstr[0] ".45-70 LFN 牛仔子彈"

#. ~ Description for {'str_sp': '.45-70 LFN cowboy'}
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government ammunition loaded with a 405 grain lead flat nose bullet "
"to original specifications for safe use in antique firearms.  Quite a bit "
"less powerful than modern ammo, but still packs a punch."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid ".45-70 SP, reloaded"
msgid_plural ".45-70 SP, reloaded"
msgstr[0] ""

#. ~ Description for {'str_sp': '.45-70 SP, reloaded'}
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government ammunition loaded with a 305 grain soft point round.  One "
"of the oldest cartridges still in use, it is still a favorite for large game"
" hunting at short ranges.  This one has been hand-loaded."
msgstr ".45-70 制式彈藥裝有 305 喱軟尖彈頭。這是目前仍在使用的最古老的彈藥之一，它仍然是短距離大型狩獵物的最愛。這是重填彈。"

#: lang/json/AMMO_from_json.py
msgid ".45-70 +P penetrator, reloaded"
msgid_plural ".45-70 +P penetrators, reloaded"
msgstr[0] ""

#. ~ Description for .45-70 +P penetrator, reloaded
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government +P ammunition loaded with a 305 grain solid copper "
"penetrator projectile.  Designed for maximum penetration through thick hide "
"and bone while maintaining ideal wounding characteristics.  This one has "
"been hand-loaded."
msgstr ".45-70 制式高壓彈裝有 305 喱實心穿甲彈丸。設計在穿透厚重的毛皮和骨頭時還能保持造成重傷的特性。這是重填彈。"

#: lang/json/AMMO_from_json.py
msgid ".45-70 LFN cowboy, reloaded"
msgid_plural ".45-70 LFN cowboy, reloaded"
msgstr[0] ""

