#: lang/json/COMESTIBLE_from_json.py
msgid "peanut butter spread"
msgid_plural "peanut butter spreads"
msgstr[0] "花生抹醬"

#. ~ Description for peanut butter spread
#: lang/json/COMESTIBLE_from_json.py
msgid "Processed peanut butter spread.."
msgstr "處理過的花生抹醬..."

#: lang/json/COMESTIBLE_from_json.py
msgid "acorns"
msgid_plural "acorns"
msgstr[0] "橡實"

#. ~ Description for {'str_sp': 'acorns'}
#: lang/json/COMESTIBLE_from_json.py
