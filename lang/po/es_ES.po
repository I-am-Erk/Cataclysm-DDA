"Causes an existing hologram to explode into burning light, harming and "
"stunning enemies close to it."
msgstr ""
"Hace que un holograma existente explote en una luz ardiente, dañando y "
"aturdiendo a los enemigos cercanos."

#: lang/json/SPELL_from_json.py
msgid "Holographic Flash Explosion"
msgstr "Explosión de Flash Holográfico"

#: lang/json/SPELL_from_json.py
msgid "Holographic Transposition"
msgstr "Transposición holográfica"

