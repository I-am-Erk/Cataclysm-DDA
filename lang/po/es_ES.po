"planes para siempre."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Ahistorical Reenactor"
msgstr "Recreador Ahistórico"

#. ~ Profession (Ahistorical Reenactor) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were on your way to the Annual All New England Revolutionary War Living "
"History exhibition when the end of the world made traditional gender roles "
"obsolete."
msgstr ""
"Estabas yendo a la exhibición anual de la Historia Viva de la Guerra "
"Revolucionaria de Nueva Inglaterra, cuando el fin del mundo volvió obsoletos"
" los roles tradicionales de los géneros."

#: lang/json/professions_from_json.py
