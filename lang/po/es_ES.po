msgid "Novice"
msgstr "Novato"

#. ~ Profession (male Novice) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid "You're a merely competent survivor so far.  Let's change that, yeah?"
msgstr ""
"Eres un superviviente meramente competente hasta ahora. Cambiemos eso, ¿Sí?"

