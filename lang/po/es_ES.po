#. ~ Description for {'str_sp': '.45 ACP FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
".45 ACP ammunition with 230gr FMJ bullets.  Noted for its stopping power, "
"the .45 ACP round has been common for over a century."
msgstr ""
"Munición .45 ACP con bala de 230gr FMJ. Conocida por su potencia de parada, "
"la bala .45 ACP ha sido utilizada desde hace casi un siglo."

