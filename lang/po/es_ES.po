#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "CBM Engineer"
msgstr "Ingeniero CBM"

#. ~ Profession (male CBM Engineer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You worked as a technician in a sterile, high-security facility concerned "
"with the fabrication of bionic implants.  The final evacuation order caught "
"you in the middle of your 16 hour extended shift, and you barely managed to "
"escape the building, tools in hand."
msgstr ""
"Trabajabas como técnico en una instalación estéril de alta seguridad "
"dedicada a la fabricación de implantes biónicos. La última orden de "
"evacuación te sorprendió en medio de tu turno prolongado de 16 horas, y "
"apenas lograste escapar del edificio, con las herramientas en la mano."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "CBM Engineer"
msgstr "Ingeniero CBM"

#. ~ Profession (female CBM Engineer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"You worked as a technician in a sterile, high-security facility concerned "
"with the fabrication of bionic implants.  The final evacuation order caught "
"you in the middle of your 16 hour extended shift, and you barely managed to "
"escape the building, tools in hand."
msgstr ""
"Trabajabas como técnico en una instalación estéril de alta seguridad "
"dedicada a la fabricación de implantes biónicos. La última orden de "
"evacuación te sorprendió en medio de tu turno prolongado de 16 horas, y "
"apenas lograste escapar del edificio, con las herramientas en la mano."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Wraitheon Executive"
msgstr "Ejecutivo Wraitheon"

#. ~ Profession (male Wraitheon Executive) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were one of the chief executives of the Megacorporation Wraitheon "
"Robotics ltd. and consistently ranked among the most powerful and "
"influential persons of the world.  Still, the apocalypse has caught you "
"unprepared, and now after the dissolution of your company and the crumbling "
"of your network of influence, you are left powerless and destitute, and must"
" rely on your two robotic bodyguards to survive."
msgstr ""
"Eras uno de los principales ejecutivos de la megacorporación Wraitheon "
"Robotics ltd. y siempre estabas entre las personas más poderosas e "
"influyentes del mundo. Sin embargo, el apocalipsis te ha pillado "
"desprevenido, y ahora, tras la disolución de tu empresa y el desmoronamiento"
" de tu red de influencia, te has quedado sin poder y sin recursos, y debes "
"confiar en tus dos guardaespaldas robóticos para sobrevivir."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Wraitheon Executive"
msgstr "Ejecutivo Wraitheon"

#. ~ Profession (female Wraitheon Executive) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
