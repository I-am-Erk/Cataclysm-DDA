msgstr ""
"Una tosca y puntiaguda varilla de madera con una muesca en la parte "
"posterior."

#: lang/json/AMMO_from_json.py
msgid "wooden bodkin arrow"
msgid_plural "wooden bodkin arrows"
msgstr[0] "flecha de madera bodkin"
msgstr[1] "flechas de madera bodkin"

#. ~ Description for wooden bodkin arrow
#: lang/json/AMMO_from_json.py
msgid "A fletched wooden arrow shaft with a pointed tip."
msgstr "Una flecha emplumada de madera con una punta afilada."

#: lang/json/AMMO_from_json.py
msgid "wooden rubber blunt arrow"
msgid_plural "wooden rubber blunt arrows"
msgstr[0] "flecha de madera con punta de goma"
msgstr[1] "flechas de madera con punta de goma"

#. ~ Description for wooden rubber blunt arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched wooden arrow shaft with a blunt rubber tip.  Can stun weaker "
"enemies."
msgstr ""
"Una flecha emplumada de madera con una punta de goma. Puede aturdir a los "
"enemigos más débiles."

#: lang/json/AMMO_from_json.py
msgid "simple wooden small game arrow"
msgid_plural "simple wooden small game arrows"
msgstr[0] "flecha de madera simple para caza menor"
msgstr[1] "flechas de madera simple para caza menor"

#. ~ Description for simple wooden small game arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A simple fletched wooden arrow shaft with a blunted tip.  Useful for hunting"
" small woodland creatures without splattering them all over the ground."
msgstr ""
"Una simple flecha emplumada de madera con una punta roma. Útil para cazar "
"pequeñas criaturas del bosque sin esparcirlas por todo el suelo."

#: lang/json/AMMO_from_json.py
msgid "wooden broadhead arrow"
msgid_plural "wooden broadhead arrows"
msgstr[0] "flecha de madera de punta ancha"
msgstr[1] "flechas de madera de punta ancha"

#. ~ Description for wooden broadhead arrow
#: lang/json/AMMO_from_json.py
msgid "A fletched wooden arrow shaft with a bladed tip."
msgstr "Una flecha de madera emplumada con punta de una cuchilla."

#: lang/json/AMMO_from_json.py
msgid "simple wooden arrow"
msgid_plural "simple wooden arrows"
msgstr[0] "flecha de madera simple"
msgstr[1] "flechas de madera simple"

#. ~ Description for simple wooden arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A simple fletched wooden arrow shaft with a fire-hardened and sharpened tip."
msgstr ""
"Un simple flecha de madera emplumada con una punta afilada y endurecida por "
"el fuego."

#: lang/json/AMMO_from_json.py
msgid "wooden small game arrow"
msgid_plural "wooden small game arrows"
msgstr[0] "flecha de madera para caza menor"
msgstr[1] "flechas de madera para caza menor"

#. ~ Description for wooden small game arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched wooden arrow shaft with a blunt tip.  Useful for hunting small "
"woodland creatures without splattering them all over the ground."
msgstr ""
"Una simple flecha emplumada de madera con una punta roma. Útil para cazar "
"pequeñas criaturas del bosque sin esparcirlas por todo el suelo."

#: lang/json/AMMO_from_json.py
msgid "makeshift wooden arrow"
msgid_plural "makeshift wooden arrows"
msgstr[0] "flecha improvisada de madera"
msgstr[1] "flechas improvisadas de madera"

#. ~ Description for makeshift wooden arrow
#: lang/json/AMMO_from_json.py
msgid "A simple fletched wooden arrow shaft with a makeshift arrowhead."
msgstr ""
"Un simple flecha de madera emplumada con una punta de flecha improvisada."

#: lang/json/AMMO_from_json.py
msgid "simple metal arrow"
msgid_plural "simple metal arrows"
msgstr[0] "flecha de metal simple"
msgstr[1] "flechas de metal simple"

#. ~ Description for simple metal arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A simple fletched steel arrow shaft with a flattened and sharpened tip."
msgstr "Un simple flecha de acero emplumada con una punta aplanada y afilada."

#: lang/json/AMMO_from_json.py
msgid "aluminum broadhead arrow"
msgid_plural "aluminum broadhead arrows"
msgstr[0] "flecha de aluminio broadhead"
msgstr[1] "flechas de aluminio broadhead"

#. ~ Description for aluminum broadhead arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched aluminum arrow shaft with a bladed tip.  Useful for maximizing "
"damage to the target."
msgstr ""
"Un flecha de aluminio emplumada con una punta de cuchilla. Útil para "
"maximizar el daño al objetivo."

#: lang/json/AMMO_from_json.py
msgid "aluminum field point arrow"
msgid_plural "aluminum field point arrows"
msgstr[0] "flecha de aluminio con field point"
msgstr[1] "flechas de aluminio con field point"

#. ~ Description for aluminum field point arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched aluminum arrow shaft with a pointed tip.  Useful for piercing "
"armor."
msgstr ""
"Un flecha de aluminio emplumada con una punta afilada. Útil para perforar "
"armadura."

#: lang/json/AMMO_from_json.py
msgid "aluminum small game arrow"
msgid_plural "aluminum small game arrows"
msgstr[0] "flecha de aluminio para caza menor"
msgstr[1] "flechas de aluminio para caza menor"

#. ~ Description for aluminum small game arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched aluminum arrow shaft with a blunt tip.  Useful for hunting small "
"woodland creatures without splattering them all over the ground."
msgstr ""
"Una simple flecha emplumada de aluminio con una punta roma. Útil para cazar "
"pequeñas criaturas del bosque sin esparcirlas por todo el suelo."

#: lang/json/AMMO_from_json.py
msgid "carbon fiber hunting arrow"
msgid_plural "carbon fiber hunting arrows"
msgstr[0] "flecha de fibra de carbono para caza"
msgstr[1] "flechas de fibra de carbono para caza"

#. ~ Description for carbon fiber hunting arrow
#: lang/json/AMMO_from_json.py
msgid "A fletched carbon fiber arrow shaft with an expanding broadhead tip."
msgstr ""
"Una flecha de fibra de carbono emplumada con una punta expanding broadhead."

#: lang/json/AMMO_from_json.py
msgid "explosive arrow"
msgid_plural "explosive arrows"
msgstr[0] "flecha explosiva"
msgstr[1] "flechas explosivas"

#. ~ Description for explosive arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow has a small IED strapped to its tip.  Horribly inaccurate, heavy,"
" and bulky, not only does this contraption require expert hands to pull off "
"a shot, it requires one to loose this with a small measure of confidence "
"that the shooter won't be caught in the blast radius."
msgstr ""
"Flecha que tiene un pequeño artefacto explosivo improvisado en la punta. "
"Horriblemente imprecisa, pesada e incómoda, no solo requiere de manos "
"expertas para dispararla, también requiere tener una mínima confianza en que"
" al dispararla, el tirador no será alcanzado en el radio de la explosión."

#: lang/json/AMMO_from_json.py
msgid "flaming arrow"
msgid_plural "flaming arrows"
msgstr[0] "flecha flameante"
msgstr[1] "flechas flameantes"

#. ~ Description for flaming arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow has a flaming rag wrapped around the shaft near the head.  You "
"should shoot it soon before it burns your bow."
msgstr ""
"Esta flecha tiene un trapo envuelto alrededor de la varilla cerca de la "
"punta. Tienes que dispararla rápido antes de que empiece a quemarte el arco."

#: lang/json/AMMO_from_json.py
msgid "crude wooden bolt"
msgid_plural "crude wooden bolts"
msgstr[0] "saeta de madera tosca"
msgstr[1] "saetas de madera tosca"

#. ~ Description for crude wooden bolt
#: lang/json/AMMO_from_json.py
msgid "A crude pointed wooden crossbow bolt with a notch at the back."
msgstr ""
"Una saeta de madera tosca y puntiaguda con una muesca en la parte posterior."

#: lang/json/AMMO_from_json.py
msgid "simple wooden bolt"
msgid_plural "simple wooden bolts"
msgstr[0] "saeta simple de madera"
msgstr[1] "saetas simple de madera"

#. ~ Description for simple wooden bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A simple fletched wooden crossbow bolt with a fire-hardened and sharpened "
"tip."
msgstr ""
"Una saeta de madera emplumada simple con una punta afilada y endurecida por "
"el fuego."

#: lang/json/AMMO_from_json.py
msgid "simple wooden small game bolt"
msgid_plural "simple wooden small game bolts"
msgstr[0] "perno simple para caza menor de madera"
msgstr[1] "pernos simples para caza menor de madera"

#. ~ Description for simple wooden small game bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A simple fletched wooden crossbow bolt with a blunted tip.  Useful for "
"hunting small woodland creatures without splattering them all over the "
"ground."
msgstr ""
"Una simple saeta de madera emplumada con una punta roma. Útil para cazar "
"pequeñas criaturas del bosque sin esparcirlas por todo el suelo."

#: lang/json/AMMO_from_json.py
msgid "makeshift wooden bolt"
msgid_plural "makeshift wooden bolts"
msgstr[0] "saeta de madera improvisada"
msgstr[1] "saetas de madera improvisada"

#. ~ Description for makeshift wooden bolt
#: lang/json/AMMO_from_json.py
msgid "A simple fletched wooden crossbow bolt with a makeshift head."
msgstr "Una saeta de madera emplumada simple con una punta improvisada."

#: lang/json/AMMO_from_json.py
msgid "wooden broadhead bolt"
msgid_plural "wooden broadhead bolts"
msgstr[0] "perno de madera de punta ancha"
msgstr[1] "pernos de madera de punta ancha"

#. ~ Description for wooden broadhead bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched wooden crossbow bolt with a bladed tip.  Useful for maximising "
"damage to the target."
msgstr ""
"Un saeta de madera emplumada con una punta de cuchilla. Útil para maximizar "
"el daño al objetivo."

#: lang/json/AMMO_from_json.py
msgid "wooden bodkin bolt"
msgid_plural "wooden bodkin bolts"
msgstr[0] "saeta de madera bodkin"
msgstr[1] "saetas de madera bodkin"

#. ~ Description for wooden bodkin bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched wooden crossbow bolt with a pointed tip.  Useful for piercing "
"armor."
msgstr ""
"Un saeta de madera emplumada con una punta afilada. Útil para perforar "
"armadura."

#: lang/json/AMMO_from_json.py
msgid "wooden small game bolt"
msgid_plural "wooden small game bolts"
msgstr[0] "saeta de madera para caza menor"
msgstr[1] "saetas de madera para caza menor"

#. ~ Description for wooden small game bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched wooden crossbow bolt with a blunt tip.  Useful for hunting small "
