msgstr ""
"\"¡Juro por Dios que he visto estas plantas antes! ¡En un libro, o algo así!"
" Juro...\""

#: lang/json/snippet_from_json.py
msgid "\"Is robbing a bank easier or harder now that all the guards are undead?\""
msgstr ""
