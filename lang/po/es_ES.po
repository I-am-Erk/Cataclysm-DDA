#: lang/json/ARMOR_from_json.py lang/json/GENERIC_from_json.py
msgid "A magical flexible stonelike substance for protection and attack."
msgstr ""
"Una sustancia mágica flexible parecida a la piedra para la protección y el "
"ataque."

#: lang/json/ARMOR_from_json.py
msgid "magic lamp"
msgid_plural "magic lamps"
msgstr[0] "lámpara mágica"
msgstr[1] "lámparas mágicas"

#. ~ Description for magic lamp
#: lang/json/ARMOR_from_json.py
msgid "A magical light source that will light up a small area."
msgstr "una fuente de luz mágica que iluminará una pequeña área."

#: lang/json/ARMOR_from_json.py
msgid "magic light"
msgid_plural "magic lights"
msgstr[0] "luz mágica"
msgstr[1] "luces mágicas"

#. ~ Description for magic light
#: lang/json/ARMOR_from_json.py
msgid "A small magical light that you can read by."
msgstr "Una pequeña luz mágica con la que puedes leer."

#: lang/json/ARMOR_from_json.py
msgid "large shield of magical ice"
msgid_plural "large shields of magical ice"
msgstr[0] "gran escudo de hielo mágico"
msgstr[1] "grandes escudos de hielo mágico"

#. ~ Description for large shield of magical ice
#: lang/json/ARMOR_from_json.py
msgid "A lightweight but tough shield crafted entirely of magical ice."
msgstr ""
"Es un escudo liviano pero resistente, fabricado íntegramente de hielo "
"mágico."

#: lang/json/ARMOR_from_json.py
msgid "slick icy coatings"
msgid_plural "slick icy coatings"
msgstr[0] "capa de hielo resbaladiza"
msgstr[1] "capas de hielo resbaladizas"

#. ~ Description for {'str_sp': 'slick icy coatings'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A magical slick icy coating on your feet.  While quite fast on flat floors, "
"they make it difficult to move on rough terrain."
msgstr ""
"Un mágico y resbaladizo recubrimiento de hielo en tus pies. Aunque son "
"bastante rápidos en los pisos planos, dificultan el movimiento en terrenos "
"accidentados."

#: lang/json/ARMOR_from_json.py
msgid "flesh pouch"
msgid_plural "flesh pouches"
msgstr[0] "bolsa de carne"
msgstr[1] "bolsas de carne"

#. ~ Description for flesh pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A large pouch of tough flesh on your back, filled with tiny tentacles that "
"grasp and hold anything you place inside.  It shifts and adjusts itself to "
"minimize encumbrance."
msgstr ""
"Una gran bolsa de carne dura en la espalda, llena de pequeños tentáculos que"
" agarran y sostienen cualquier cosa que se coloque en su interior. Se "
"desplaza y se ajusta a sí misma para minimizar la incomódidad."

#: lang/json/ARMOR_from_json.py
msgid "obfuscating aura"
msgid_plural "obfuscating auras"
msgstr[0] "aura de ofuscamiento"
msgstr[1] "auras de ofuscamiento"

#. ~ Description for obfuscating aura
#: lang/json/ARMOR_from_json.py
msgid ""
"An all-encompassing, invisible layer of magic distorts light around your "
"body.  Allows you to dodge two extra attacks in a given turn."
msgstr ""
"Es una capa de magia envolvente e invisible que distorsiona la luz alrededor"
" de tu cuerpo. Te permite esquivar dos ataques extra por turno."

#: lang/json/ARMOR_from_json.py
msgid "acid resistance aura"
msgid_plural "acid resistance auras"
msgstr[0] "aura de resistencia al ácido"
msgstr[1] "auras de resistencia al ácido"

#. ~ Description for acid resistance aura
#. ~ Description for greater acid resistance aura
#: lang/json/ARMOR_from_json.py
msgid "An all-encompassing, invisible layer of protection against acid."
msgstr "Una capa invisible de protección contra el ácido que lo abarca todo."

#: lang/json/ARMOR_from_json.py
msgid "greater acid resistance aura"
msgid_plural "greater acid resistance auras"
msgstr[0] "aura de resistencía ácida mayor"
msgstr[1] "auras de resistencía ácida mayor"

#: lang/json/ARMOR_from_json.py
