#. ~ Description for acetylene lamp (off)
#: lang/json/TOOL_from_json.py
msgid ""
"An antique brass lamp designed to run from a pressurized cylinder of "
"acetylene.  It is an efficient, if somewhat dangerous, light source."
msgstr ""
"Una antigua lámpara de latón diseñada para funcionar con un cilindro de "
"acetileno a presión. Es una fuente de luz eficaz, aunque algo peligrosa."

