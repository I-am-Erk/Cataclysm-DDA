msgid_plural "aluminum small game bolts"
msgstr[0] "saeta de aluminio para caza menor"
msgstr[1] "saetas de aluminio para caza menor"

#. ~ Description for aluminum small game bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched aluminum crossbow bolt with a blunt tip.  Useful for hunting "
"small woodland creatures without splattering them all over the ground."
msgstr ""
"Una saeta de aluminio emplumada con una punta roma. Útil para cazar pequeñas"
" criaturas del bosque sin esparcirlas por todo el suelo."

#: lang/json/AMMO_from_json.py
msgid "carbon fiber hunting bolt"
msgid_plural "carbon fiber hunting bolts"
msgstr[0] "saeta de fibra de carbono para caza"
msgstr[1] "saetas de fibra de carbono para caza"

#. ~ Description for carbon fiber hunting bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A fletched carbon fiber crossbow bolt shaft with an expanding broadhead tip."
"  Deals impressive damage to targets."
msgstr ""
"Una saeta de fibra de carbono emplumada con una punta broadhead expansiva. "
"Hace un daño impresionante a los objetivos."

#: lang/json/AMMO_from_json.py
msgid "explosive crossbow bolt"
msgid_plural "explosive crossbow bolts"
msgstr[0] "saeta de ballesta explosiva"
msgstr[1] "saetas de ballesta explosiva"

#. ~ Description for explosive crossbow bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A lightweight, sharpened bolt made from some kind of metal.  It is fairly "
"unwieldy and only provides moderate accuracy, due to being filled with "
"explosives and fitted with an impact trigger."
msgstr ""
"Saeta ligera y afilada hecha de algún tipo de metal. Es un poco inmanejable "
"y tiene una precisión mediocre, debido a que está cargado de explosivos para"
" provocar un gran impacto."

#: lang/json/AMMO_from_json.py
msgid "wooden fishing spear"
msgid_plural "wooden fishing spears"
msgstr[0] "lanza de pesca de madera"
msgstr[1] "lanzas de pesca de madera"

#. ~ Description for wooden fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from wood tipped with steel.  It's very "
"light, but doesn't have much range."
msgstr ""
"Un lanza para pescar submarina hecha de madera con punta de acero. Es muy "
"ligera pero no tiene mucho alcance."

#: lang/json/AMMO_from_json.py
msgid "carbon fiber fishing spear"
msgid_plural "carbon fiber fishing spears"
msgstr[0] "lanza de pesca de carbono"
msgstr[1] "lanzas de pesca de carbono"

#. ~ Description for carbon fiber fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from carbon fiber.  It's very light, but "
"doesn't have much range."
msgstr ""
"Un lanza para pescar submarina hecha de fibra de carbono. Es muy ligera pero"
" no tiene mucho alcance."

#: lang/json/AMMO_from_json.py
msgid "metal fishing spear"
msgid_plural "metal fishing spears"
msgstr[0] "lanza de pesca de metal"
msgstr[1] "lanzas de pesca de metal"

#. ~ Description for metal fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from metal.  It's light, but doesn't have "
"much range."
msgstr ""
"Un lanza para pescar submarina hecha de metal. Es ligera pero no tiene mucho"
" alcance."

#: lang/json/AMMO_from_json.py
msgid "bolas"
msgid_plural "bolases"
msgstr[0] "boleadora"
msgstr[1] "boleadoras"

#. ~ Description for bolas
#: lang/json/AMMO_from_json.py
msgid ""
"Some ropes with weights, designed to tangle the legs of a target when "
"thrown, usually at an animal.  Used by the Gauchos of Argentina."
msgstr ""
"Cuerdas con pesos, diseñadas para enredarse en las patas de un objetivo "
"cuando se lanzan, generalmente un animal. Utilizadas por los Gauchos de "
"Argentina."

#: lang/json/AMMO_from_json.py
msgid "net"
msgid_plural "nets"
msgstr[0] "red"
msgstr[1] "redes"

#. ~ Description for net
#: lang/json/AMMO_from_json.py
msgid ""
"A mesh of string and weights, traditionally used to catch fish, and to "
"entangle opponents in combat."
msgstr ""
"Malla de cuerdas y pesos, tradicionalmente utilizadas para pescar y para "
"atrapar oponentes en combate."

#: lang/json/AMMO_from_json.py
msgid "throwing stick"
msgid_plural "throwing sticks"
msgstr[0] "palo arrojadizo"
msgstr[1] "palos arrojadizos"

#. ~ Description for throwing stick
#: lang/json/AMMO_from_json.py
msgid ""
"A stick carved into a shape suitable for throwing at a target.  Not a "
"boomerang, so don't expect it to return to your hand."
msgstr ""
"Palo tallado con una forma adecuada para ser lanzada. No es un búmeran, así "
"que no esperes que vuelva a tus manos."

#: lang/json/AMMO_from_json.py
msgid "potassium alum"
msgid_plural "potassium alums"
msgstr[0] "alumbre de potasio"
msgstr[1] "alumbre de potasio"

#. ~ Description for potassium alum
#: lang/json/AMMO_from_json.py
msgid ""
"Small water-soluble white crystals with watery metallic odor, historically "
"used for many different purposes.  Also known as potash alum and potassium "
"aluminum sulfate; often called simply alum, as it's the most important "
"member of the generic class of compounds called alums."
msgstr ""
"Pequeños cristales blancos solubles en agua con olor metálico acuoso, "
"históricamente utilizados para muchos propósitos diferentes. También "
"conocido como alumbre de potasa y sulfato de aluminio y potasio; a menudo "
"llamado simplemente alumbre, ya que es el miembro más importante de la clase"
" genérica de compuestos llamados alumbre."

#: lang/json/AMMO_from_json.py
msgid "cloth dye powder"
msgid_plural "cloth dye powders"
msgstr[0] "tinte en polvo para ropa"
msgstr[1] "tinte en polvo para ropa"

#. ~ Description for cloth dye powder
#: lang/json/AMMO_from_json.py
msgid ""
"This is a powdered colorful cloth dye, which can be used to dye many fabrics"
" if combined with water and some mordant."
msgstr ""
"Este es un colorante en polvo para telas, que puede utilizarse para teñir "
"muchas telas si se combina con agua y algún mordiente (sustancia para fijar "
"colores en la ropa)."

#: lang/json/AMMO_from_json.py
msgid "steel buckle"
msgid_plural "steel buckles"
msgstr[0] "hebilla de acero"
msgstr[1] "hebillas de acero"

#. ~ Description for steel buckle
#: lang/json/AMMO_from_json.py
msgid "A steel buckle, like that usually found on belts."
msgstr "Hebilla de acero, como la que se suele encontrarse en los cinturones."

#: lang/json/AMMO_from_json.py
