#: lang/json/GENERIC_from_json.py
msgid "huge rifle casing"
msgid_plural "huge rifle casings"
msgstr[0] "casquillo rifle grande"
msgstr[1] "casquillos rifle grande"

#. ~ Description for huge rifle casing
#: lang/json/GENERIC_from_json.py
msgid "An empty casing from a huge rifle round."
msgstr "Un casquillo vacío de un cartucho de una pistola mágnum."

#: lang/json/GENERIC_from_json.py
msgid "shotshell hull"
msgid_plural "shotshell hulls"
msgstr[0] "carcasa de bala"
msgstr[1] "carcasas de bala"

#. ~ Description for shotshell hull
#: lang/json/GENERIC_from_json.py
msgid ""
"A shotshell's casing, a plastic tube with a brass casehead, commonly "
"referred to as a hull."
msgstr ""
"Un casquillo de un cartucho de escopeta, un tubo de plástico con una cabeza "
"de latón, comúnmente conocido como casco."

#: lang/json/GENERIC_from_json.py
msgid "grenade casing"
msgid_plural "grenade casings"
msgstr[0] "carcasa de granada"
msgstr[1] "carcasas de granada"

#. ~ Description for grenade casing
#: lang/json/GENERIC_from_json.py
msgid "A large casing from a grenade round."
msgstr "Un gran casquillo de un cartucho de granada."

#: lang/json/GENERIC_from_json.py
msgid "rifle belt linkage"
msgid_plural "rifle belt linkages"
msgstr[0] "eslabón del cinturón de fusil"
msgstr[1] "eslabones del cinturón de fusil"

#: lang/json/GENERIC_from_json.py
msgid "grenade belt linkage"
msgid_plural "grenade belt linkages"
msgstr[0] "eslabón del cinturón de granadas"
msgstr[1] "eslabones del cinturón de granadas"

#: lang/json/GENERIC_from_json.py
