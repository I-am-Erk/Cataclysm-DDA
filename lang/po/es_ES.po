msgid "Splatters sludge along the ground in a cone."
msgstr "Salpica cieno por el suelo en forma de cono."

#: lang/json/SPELL_from_json.py
msgid "Blinding spray"
msgstr "Spray cegador"

#. ~ Description for Blinding spray
#: lang/json/SPELL_from_json.py
msgid "Blinds enemy for a short time."
msgstr "Ciega al enemigo por un corto tiempo."

#: lang/json/SPELL_from_json.py
msgid "Cranial Explosion"
msgstr "Explosión Craneal"

#. ~ Description for Cranial Explosion
#: lang/json/SPELL_from_json.py
msgid "This fake spell occurs on cranial bomb activation.  Likely fatal."
msgstr ""
"Este falso hechizo se produce al activar la bomba craneal. Es probable que "
"sea fatal."

#: lang/json/SPELL_from_json.py
msgid "Skullgun Snapback"
msgstr "Sacudida de Pistola Calavera"

#. ~ Description for Skullgun Snapback
#: lang/json/SPELL_from_json.py
msgid ""
"This fake spell occurs on skullgun activation.  May be fatal if done in "
"critical condition."
msgstr ""
"Este hechizo falso se produce al activar la pistola calavera. Puede ser "
"mortal si se realiza en estado crítico."

#. ~ Message for SPELL 'Skullgun Snapback'
#: lang/json/SPELL_from_json.py
msgid "Your head snaps back from the force of the shot."
msgstr "Tu cabeza se retrae por la fuerza del disparo."

#: lang/json/SPELL_from_json.py
msgid "Aftershock Extra Turn"
msgstr "Turno Extra Réplica"

#. ~ Description for Aftershock Extra Turn
#: lang/json/SPELL_from_json.py
msgid "Grants you an extra turn."
msgstr "Te concede un turno extra."

#: lang/json/SPELL_from_json.py
msgid "Aftershock Stacking Speed Bonus"
msgstr "Bonus de Velocidad Acumulable Réplica"

#. ~ Description for Aftershock Stacking Speed Bonus
#: lang/json/SPELL_from_json.py
msgid "Grants you a stackable speed bonus."
msgstr "Te otorga una bonificación de velocidad acumulable."

#. ~ Description for heat retention cream
#: lang/json/SPELL_from_json.py
msgid ""
"You rub the thick cream all over your body in preparation for the expected "
"cold."
msgstr ""
"Te frotas la espesa crema por todo el cuerpo para prepararse para el "
"esperado frío."

#. ~ Description for heat retention cream xtreme
#: lang/json/SPELL_from_json.py
msgid ""
"You rub the thick cream all over your body in preparation for unbearable "
"cold."
msgstr ""
"Te frotas la espesa crema por todo el cuerpo para prepararse para el "
"insoportable frío."

#: lang/json/SPELL_from_json.py
msgid "emergency insulation"
msgstr "aislamientos de emergencia"

#. ~ Description for emergency insulation
#: lang/json/SPELL_from_json.py
