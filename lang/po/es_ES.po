msgid "Grotesque Enhancement"
msgstr "Mejora Grotesco"

#: lang/json/SPELL_from_json.py
msgid "Acidic Spray"
msgstr "Rocio Ácido"

#: lang/json/SPELL_from_json.py
msgid "Flesh Pouch"
msgstr "Bolsa De Carne"

#: lang/json/SPELL_from_json.py
msgid "Conjure Bonespear"
msgstr "Conjurar Lanza de Huesos"

#: lang/json/SPELL_from_json.py
msgid "Biomancer Rune"
msgstr "Runa Biomante"

#. ~ Description for Biomancer Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Biomancers.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los biománticos. Puedes"
" usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Paralytic Dart"
msgstr "Dardo Paralizante"

#: lang/json/SPELL_from_json.py
msgid "Visceral Projection"
msgstr "Proyección Visceral"

#: lang/json/SPELL_from_json.py
msgid "Visceral Paralysis"
msgstr "Parálisis Viral"

#. ~ Description for Visceral Paralysis
#: lang/json/SPELL_from_json.py
msgid "Paralytic side effect of Projection."
msgstr "Efecto secundario paralizante de la Proyección."

#: lang/json/SPELL_from_json.py
msgid "Visceral Backlash"
msgstr "Retroceso Visceral"

#. ~ Description for Visceral Backlash
#: lang/json/SPELL_from_json.py
msgid "Hits the user with side effects too."
msgstr "También tiene efectos secundarios para el usuario."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Coagulant Weave"
msgstr "Tejido coagulante"

#: lang/json/SPELL_from_json.py
msgid "Caustic Feedback"
msgstr "Retroalimentación Cáustica"

#. ~ Description for Caustic Feedback
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of the Caustic Aura spell."
msgstr "Esto es un subhechizo del hechizo Aura Cáustica."

#. ~ description for the sound of spell 'Caustic Feedback'
#: lang/json/SPELL_from_json.py
msgid "acidic sizzle!"
msgstr "¡chispas acidas!"

#: lang/json/SPELL_from_json.py
msgid "Caustic Aura"
msgstr "Aura Cáustica"

#. ~ Description for Caustic Aura
#: lang/json/SPELL_from_json.py
msgid ""
"This spell suspends acid in a layer around you, corroding melee attackers "
"when struck and enhancing your melee damage."
msgstr ""
"Este hechizo suspende el ácido en una capa a tu alrededor, corroyendo a los "
"atacantes cuerpo a cuerpo cuando te golpean y aumentando tu daño cuerpo a "
"cuerpo."

#: lang/json/SPELL_from_json.py
msgid "Acid Claw"
msgstr "Garra Ácida"

#. ~ Description for Acid Claw
#: lang/json/SPELL_from_json.py
msgid ""
"Your claws glow with yellow acid energy, and as you swipe your claw a wave "
"of acid sweeps forth from it."
msgstr ""
"Tus garras brillan con energía ácida amarilla, y al deslizar tu garra una "
"ola de ácido sale de ella."

#: lang/json/SPELL_from_json.py
msgid "Acid Bite"
msgstr "Mordisco Ácido"

#. ~ Description for Acid Bite
#: lang/json/SPELL_from_json.py
msgid "Your maw drips with acid as you make a bite attack."
msgstr "Tus fauces gotean ácido mientras haces un ataque de mordisco."

#: lang/json/SPELL_from_json.py
msgid "Dragon's Bite"
msgstr "Mordisco de Dragón"

#. ~ Description for Dragon's Bite
#: lang/json/SPELL_from_json.py
msgid "The bite damage in Acid Bite."
msgstr "El daño por mordedura de Mordisco Ácida."

#. ~ Description for Black Dragon Shell
#: lang/json/SPELL_from_json.py
msgid ""
"You channel your inner draconic magic to protect yourself from damage and "
"reflect some back as acid damage."
msgstr ""
"Canalizas tu magia dracónica interior para protegerte del daño y reflejar "
"una parte como daño de ácido."

#: lang/json/SPELL_from_json.py
msgid "Black Dragon Shell Retaliation"
msgstr "Represalia de Dragón Negro"

#. ~ Description for Black Dragon Shell Retaliation
#: lang/json/SPELL_from_json.py
msgid "Acid burst that punishes attackers."
msgstr "Ráfagas de ácido que castiga a los atacantes."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Terror"
msgstr "Terror de Dragón"

#. ~ Description for Dragon Terror
#: lang/json/SPELL_from_json.py
msgid ""
"With an ear piercing roar, you channel the inner power of dragons and strike"
" fear into those who stand before you, slowing their escape from your "
"terror."
msgstr ""
"Con un rugido desgarrador, canalizas el poder interior de los dragones e "
"infundes miedo a los que se encuentran ante ti, frenando su huida de tu "
"terror."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dragon Boost"
msgstr "Impulso de Dragón"

#. ~ Description for Dragon Boost
#: lang/json/SPELL_from_json.py
msgid ""
"You let out a mighty roar as you infuse yourself with the power of Dragons."
msgstr ""
"Dejas escapar un poderoso rugido mientras te infundes con el poder de los "
"Dragones."

#: lang/json/SPELL_from_json.py
msgid "Health recovery"
msgstr "Recuperación de Salud"

#. ~ Description for Health recovery
#: lang/json/SPELL_from_json.py
msgid "minor health recovery spell associated with Dragon Boost."
msgstr "hechizo de recuperación de salud menor asociado a Impulso de Dragón."

#: lang/json/SPELL_from_json.py
msgid "Stamina recovery"
msgstr "Recuperación de vigor"

#. ~ Description for Stamina recovery
#: lang/json/SPELL_from_json.py
msgid "minor stamina recovery spell associated with Dragon Boost."
msgstr "hechizo menor de recuperación de vigor asociado a Impulso de Dragón"

#: lang/json/SPELL_from_json.py
msgid "Dragon Acid Spit"
msgstr "Saliva Ácida de Dragón"

#. ~ Description for Dragon Acid Spit
#: lang/json/SPELL_from_json.py
msgid ""
"You conjur up acidic spittle that you can shoot long distances as you close "
"on your terrified prey."
msgstr ""
"Conjuras saliva ácida que puedes disparar a larga distancia mientras te "
"acercas a tu aterrorizada presa."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Black Dragon Breath"
msgstr "Aliento de Dragón Negro"

#. ~ Description for Black Dragon Breath
#. ~ Description for Black Dragons' Breath
#: lang/json/SPELL_from_json.py
msgid "Spews a line of acid from your mouth."
msgstr "Echa una línea de ácido por la boca."

#: lang/json/SPELL_from_json.py
msgid "Crystallize Mana"
msgstr "Cristalizar Mana"

#. ~ Description for Crystallize Mana
#: lang/json/SPELL_from_json.py
msgid "Crystallizes mana into solid form"
msgstr "Cristaliza el maná en forma sólida"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Mana Fatigue"
msgstr "Cansancio de Mana"

#. ~ Description for Mana Fatigue
#: lang/json/SPELL_from_json.py
msgid "Secondary effect of Crystallize Mana"
msgstr "Efecto secundario de cristalizar el maná"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Dark Sight"
msgstr "Visión Oscura"

#. ~ Description for Dark Sight
#: lang/json/SPELL_from_json.py
msgid "Gives you the power to see in the dark"
msgstr "Te da el poder de ver en la oscuridad"

#. ~ Message for SPELL 'Dark Sight'
#: lang/json/SPELL_from_json.py
msgid ""
"Your eyes glow green for a moment.  Now your sight can pierce the darkest "
"shadows."
msgstr ""
"Tus ojos brillan en verde por un momento. Ahora tu vista puede atravesar las"
" sombras más oscuras."

#: lang/json/SPELL_from_json.py
msgid "Megablast"
msgstr "MegaImpacto"

#: lang/json/SPELL_from_json.py
msgid "Magical Light"
msgstr "Luz Mágica"

#: lang/json/SPELL_from_json.py
msgid "Blinding Flash"
msgstr "Flash Cegador"

#: lang/json/SPELL_from_json.py
msgid "Ethereal Grasp"
msgstr "Agarre Etéreo"

#: lang/json/SPELL_from_json.py
msgid "Obfuscated Body"
msgstr "Cuerpo Ofuscado"

#. ~ Description for Obfuscated Body
#: lang/json/SPELL_from_json.py
msgid ""
"A magical aura distorts light around your body, increasing the amount of "
"attacks you might dodge in a given turn."
msgstr ""
"Un aura mágica distorsiona la luz alrededor de tu cuerpo, aumentando la "
"cantidad de ataques que puedes esquivar en un turno determinado."

#: lang/json/SPELL_from_json.py
msgid "Aura of Protection"
msgstr "Aura de Protección"

#: lang/json/SPELL_from_json.py
msgid "Translocate Self"
msgstr "Teletransportarse"

#. ~ Description for Translocate Self
#: lang/json/SPELL_from_json.py
msgid "Translocates the user to an attuned gate."
msgstr "Traslada al usuario a una puerta sintonizada."

#: lang/json/SPELL_from_json.py
msgid "Acid Resistance"
msgstr "Resistencia al Ácido"

#. ~ Description for Acid Resistance
#. ~ Description for Greater Acid Resistance
#: lang/json/SPELL_from_json.py
msgid "Protects the user from acid."
msgstr "Protege al usuario del ácido."

#: lang/json/SPELL_from_json.py
msgid "Greater Acid Resistance"
msgstr "Resistencia al Ácido Mayor"

#: lang/json/SPELL_from_json.py
msgid "Template Spell"
msgstr "Hechizo de plantilla"

#. ~ Description for Template Spell
#: lang/json/SPELL_from_json.py
msgid "This is a template to show off all the available values"
msgstr "Esta es una plantilla para mostrar todos los valores disponibles"

#. ~ Message for SPELL 'Template Spell'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "As you cast %s, your ears pops!"
msgstr "¡Al lanzar %s tus oídos se destapan!"

#: lang/json/SPELL_from_json.py
msgid "debug push no aoe"
msgstr "depurar empuje no aoe"

#. ~ Description for debug push no aoe
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 0"
msgstr "empuja todos los tipos de objetos con un área de efecto de 0"

#: lang/json/SPELL_from_json.py
msgid "debug push blast"
msgstr "depurar empuje explosión"

#. ~ Description for debug push blast
#: lang/json/SPELL_from_json.py
msgid "pushes all types of objects with an aoe of 3 in a blast pattern"
msgstr ""
"empuja todos los tipos de objetos con un área de efecto de 3 en un patrón de"
" explosión"

#: lang/json/SPELL_from_json.py
msgid "Spawn Debug Monsters"
msgstr "Crear Monstruos de Depurar"

#. ~ Description for Spawn Debug Monsters
#: lang/json/SPELL_from_json.py
msgid "Set level to number of monsters spawned."
msgstr "Pone el nivel del número de monstruos engendrados."

#. ~ Message for SPELL 'Spawn Debug Monsters'
#. ~ Message for SPELL 'Debug HP Spell'
#. ~ Message for SPELL 'Debug Bionic Spell'
#. ~ Message for SPELL 'Debug effect spell'
#. ~ Message for SPELL 'Test Area Pull'
#. ~ Message for SPELL 'Test Area Pull (Field)'
#. ~ Message for SPELL 'Test Area Push'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "Debug spell %s cast."
msgstr "Depurar lanzamiento de hechizo %s."

#: lang/json/SPELL_from_json.py
msgid "Debug Stamina Spell"
msgstr "Depurar Hechizo Vigor"

#. ~ Description for Debug Stamina Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little stamina"
msgstr "Usa un poco de vigor"

#. ~ Message for SPELL 'Debug Stamina Spell'
#: lang/json/SPELL_from_json.py
#, python-format
msgid "Debug spell [ %s ] has no effect.  Debug warning is expected."
msgstr ""
"Depurar hechizo [ %s] no tiene efecto. Se espera una advertencia de "
"depuración."

#: lang/json/SPELL_from_json.py
msgid "Debug polymorph"
msgstr "Depurar polimorfia"

#. ~ Description for Debug polymorph
#: lang/json/SPELL_from_json.py
msgid "Well you wanted to lose weight, right?"
msgstr "Bueno, querías perder peso, ¿verdad?"

#: lang/json/SPELL_from_json.py
msgid "Debug HP Spell"
msgstr "Depurar Hechizo PS"

#. ~ Description for Debug HP Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little HP"
msgstr "Usa un poco de PS"

#: lang/json/SPELL_from_json.py
msgid "Debug Bionic Spell"
msgstr "Depurar un hechizo biónico"

#. ~ Description for Debug Bionic Spell
#: lang/json/SPELL_from_json.py
msgid "Uses a little Bionic Power"
msgstr "Usa un poco de poder biónico"

#: lang/json/SPELL_from_json.py
msgid "Debug effect spell"
msgstr "Depurar efecto de hechizo"

#. ~ Description for Debug effect spell
#: lang/json/SPELL_from_json.py
msgid "Adds an effect to the target"
msgstr "Añade un efecto al objetivo"

#: lang/json/SPELL_from_json.py
msgid "Test Area Pull"
msgstr "Testar Area Tirón"

#. ~ Description for Test Area Pull
#: lang/json/SPELL_from_json.py
msgid "Pulls all objects inside."
msgstr "Tira de todos los objetos en su interior."

#: lang/json/SPELL_from_json.py
msgid "Test Area Pull (Field)"
msgstr "Testar Area Tirón (Campo)"

#. ~ Description for Test Area Pull (Field)
#: lang/json/SPELL_from_json.py
msgid "Pulls field contents tiles inside."
msgstr "Tira de los azulejos del contenido del campo en el interior."

#: lang/json/SPELL_from_json.py
msgid "Test Area Push"
msgstr "Testar Area Empujar"

#. ~ Description for Test Area Push
#: lang/json/SPELL_from_json.py
msgid "Pushes all objects outside."
msgstr "Empuja todos los objetos hacia afuera."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Debug Full Protection"
msgstr "Depurar la Protección Completa"

#. ~ Description for Debug Full Protection
#. ~ Description of effect 'Debug Full Protection'.
#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "You can not be harmed by anything."
msgstr "No puedes ser dañado por nada."

#. ~ Message for SPELL 'Debug Full Protection'
#: lang/json/SPELL_from_json.py
msgid "You are invulnerable, nothing can harm you!"
msgstr "Eres invulnerable, ¡nada puede hacerte daño!"

#: lang/json/SPELL_from_json.py
msgid "Debug Feather Falling"
msgstr "Depurar Pluma Cayendo"

#. ~ Description for Debug Feather Falling
#: lang/json/SPELL_from_json.py
msgid "You  are light as a feather and fall like."
msgstr "Eres ligero como una pluma y caes como una."

#. ~ Message for SPELL 'Debug Feather Falling'
#: lang/json/SPELL_from_json.py
msgid "You eat a feather!"
msgstr "¡Comes una pluma!"

#: lang/json/SPELL_from_json.py
msgid "Black Dragons' Breath"
msgstr "Aliento de Dragón Negro"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Vegetative Grasp"
msgstr "Agarre Vegetal"

#: lang/json/SPELL_from_json.py
msgid "Root Strike"
msgstr "Golpe de raíz"

#: lang/json/SPELL_from_json.py
msgid "Wooden Shaft"
msgstr "Asta de Madera"

#: lang/json/SPELL_from_json.py
msgid "Nature's Bow"
msgstr "Arco de la Naturaleza"

#: lang/json/SPELL_from_json.py
msgid "Nature's Trance"
msgstr "Trance de la Naturaleza"

#: lang/json/SPELL_from_json.py
msgid "Bag of Cats"
msgstr "Bolsa de Gatos"

#: lang/json/SPELL_from_json.py
msgid "Cause Bear"
msgstr "Causa Perror"

#. ~ Description for Cause Bear
#: lang/json/SPELL_from_json.py
msgid ""
"This spell appears to be very smudged.  You're fairly sure the name should "
"be Cause Fear, but you're also fairly sure it won't have the desired effect "
"because the instructions are hardly legible.  No time like the Cataclysm to "
"find out, though!"
msgstr ""
"Este hechizo parece estar muy manchado. Estás bastante seguro de que el "
"nombre debería ser Causa Terror, pero también estás bastante seguro de que "
"no tendrá el efecto deseado porque las instrucciones son apenas legibles. "
"Sin embargo, no hay mejor momento que el Cataclismo para averiguarlo."

#: lang/json/SPELL_from_json.py
msgid "Kill Fungus"
msgstr "Matar Hongos"

#. ~ Description for Kill Fungus
#: lang/json/SPELL_from_json.py
msgid "Kills fungus affected areas"
msgstr "Mata hongos en las zonas afectadas"

#: lang/json/SPELL_from_json.py
msgid "Druid Rune"
msgstr "Runa Druida"

#. ~ Description for Druid Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Druids.  You can use the rune "
"as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los druidas. Puedes "
"usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Purification Seed"
msgstr "Semillas de purificación"

#. ~ Description for Purification Seed
#: lang/json/SPELL_from_json.py
msgid ""
"You summon a gift of the earth which will purify water.  Rapidly degrades if"
" not utilized."
msgstr ""
"Invoca un regalo de la tierra que purificará el agua. Se degrada rápidamente"
" si no se utiliza."

#: lang/json/SPELL_from_json.py
msgid "Sacrificial Regrowth"
msgstr "Crecimiento Sacrificado"

#: lang/json/SPELL_from_json.py
msgid "Sacrificial Healing"
msgstr "Curación por Sacrificio"

#: lang/json/SPELL_from_json.py
msgid "Tornskin"
msgstr "Piel de Espino"

#. ~ Description for Tornskin
#: lang/json/SPELL_from_json.py
msgid ""
"This spell, which resembles Thornskin through the sap & needles covering the"
" page, seemed to involve thorns and bleeding wounds.  The marred words may "
"have altered the function."
msgstr ""
"Este hechizo, que se parece a Piel de Espino por la savia y las agujas que "
"cubren la hoja, parecía implicar espinas y heridas sangrantes. Las palabras "
"estropeadas pueden haber alterado la función."

#: lang/json/SPELL_from_json.py
msgid "Feral Form"
msgstr "Forma Salvaje"

#. ~ Description for Feral Form
#: lang/json/SPELL_from_json.py
msgid ""
"This spell unleashes your inner beast, growing claws & fangs to rend your "
"foes limb from limb."
msgstr ""
"Este hechizo desata tu bestia interna, creciéndote garras y colmillos para "
"desgarrar a tus enemigos miembro a miembro."

#: lang/json/SPELL_from_json.py
msgid "Summon Wolf"
msgstr "Invocar Lobo"

#. ~ Description for Summon Wolf
#: lang/json/SPELL_from_json.py
msgid "Call to the wilds for aid from some wolves."
msgstr "Llama a los salvajes para pedir ayuda a algunos lobos."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Nature's Commune"
msgstr "Comunión con la Naturaleza"

#. ~ Description for Nature's Commune
#: lang/json/SPELL_from_json.py
msgid ""
"You concentrate on the nature around you and commune with it, improving your"
" health and calming the nearby wildlife."
msgstr ""
"Te concentras en la naturaleza que te rodea y entras en comunión con ella, "
"mejorando tu salud y calmando la fauna cercana."

#: lang/json/SPELL_from_json.py
msgid "Seed of Growth"
msgstr "Semilla de Crecimiento"

#: lang/json/SPELL_from_json.py
msgid "Stonefist"
msgstr "Puño de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Seismic Stomp"
msgstr "Pisotón Sísmico"

#: lang/json/SPELL_from_json.py
msgid "Stone's Endurance"
msgstr "Resistencia de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Shardspray"
msgstr "Rocio de Esquirlas"

#: lang/json/SPELL_from_json.py
msgid "Piercing Bolt"
msgstr "Rayo Penetrante"

#: lang/json/SPELL_from_json.py
msgid "Shardstorm"
msgstr "Tormenta de Esquirlas"

#: lang/json/SPELL_from_json.py
msgid "Rockbolt"
msgstr "Saeta de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Move Earth"
msgstr "Mover la Tierra"

#. ~ Description for Move Earth
#: lang/json/SPELL_from_json.py
msgid "Your essense flows around you, and the earth follows."
msgstr "Tu esencia fluye a tu alrededor, y la tierra te sigue."

#: lang/json/SPELL_from_json.py
msgid "Earthshaper Rune"
msgstr "Runa del Terraformante"

#. ~ Description for Earthshaper Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Earthshapers.  You can use the"
" rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los Terraformantes. "
"Puedes usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Clairvoyance"
msgstr "Clarividencia"

#: lang/json/SPELL_from_json.py
msgid "Stoneskin"
msgstr "Piel de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Pillar of Stone"
msgstr "Pilar de Piedra"

#: lang/json/SPELL_from_json.py
msgid "Pillar Side Effect"
msgstr "Pilar de Efecto Lateral"

#. ~ Description for Pillar Side Effect
#: lang/json/SPELL_from_json.py
msgid "Bash effect that follows, levels reduce damage and AoE."
msgstr ""
"El efecto de choque que sigue, los niveles reducen el daño y el área de "
"efecto."

#: lang/json/SPELL_from_json.py
msgid "Twisted Restoration"
msgstr "Curación Perversa"

#. ~ Description for Twisted Restoration
#: lang/json/SPELL_from_json.py
msgid ""
"This spell overclocks your heart, generating new flesh and muscle.  It is "
"unwise to use this in immediate danger, and may be fatal if done in critical"
" condition."
msgstr ""
"Este hechizo bloquea tu corazón, generando nueva carne y músculo. No es "
"prudente usar esto en peligro inmediato, y puede ser fatal si se hace en "
"condiciones críticas."

#: lang/json/SPELL_from_json.py
msgid "Improved Twisted Restoration"
msgstr "Curación Perversa Mayor"

#. ~ Description for Improved Twisted Restoration
#: lang/json/SPELL_from_json.py
msgid ""
"This spell overclocks your heart, generating new flesh and muscle.  It is "
"unwise to use this in immediate danger, and may be fatal if done in critical"
" condition.  Improved brewing mitigates the strain of the spell."
msgstr ""
"Este hechizo sobrecarga tu corazón, generando nueva carne y músculo. No es "
"prudente usar esto en peligro inmediato, y puede ser fatal si se hace en "
"condiciones críticas. La mejora en la en la creación mitiga la tensión del "
"hechizo."

#: lang/json/SPELL_from_json.py
msgid "Conjure Throwing Blade I"
msgstr "Conjurar Lanzar Cuchilla I"

#. ~ Description for Conjure Throwing Blade I
#: lang/json/SPELL_from_json.py
msgid "conjures 3 throwing knives"
msgstr "conjura 3 cuchillos lanzadores"

#. ~ Message for SPELL 'Conjure Throwing Blade I'
#: lang/json/SPELL_from_json.py
msgid ""
"You activate your ring and three throwing knives appear, ready to throw!"
msgstr ""
"Activas tu anillo y aparecen tres cuchillos lanzadores, ¡listos para lanzar!"

#: lang/json/SPELL_from_json.py
msgid "Recover Mana"
msgstr "Recuperar Mana"

#. ~ Description for Recover Mana
#: lang/json/SPELL_from_json.py
msgid "You regain mana."
msgstr "Recuperas mana."

#. ~ Message for SPELL 'Recover Mana'
#: lang/json/SPELL_from_json.py
msgid "You start regenerating mana!"
msgstr "¡Empiezas a regenerar maná!"

#. ~ Message for SPELL '{'str': 'Pain'}'
#: lang/json/SPELL_from_json.py
msgid ""
"Your veins feel like they are on fire!\n"
"You start regenerating mana!"
msgstr ""
"¡Sientes que tus venas arden!\n"
"¡Comienzas a regenerar maná!"

#: lang/json/SPELL_from_json.py
msgid "Lupercalian Release"
msgstr "Liberación Lupina"

#. ~ Description for Lupercalian Release
#: lang/json/SPELL_from_json.py
msgid ""
"This spell transforms you into a werewolf.  There may be some cons to this."
msgstr ""
"Este hechizo te transforma en un hombre lobo. Esto puede tener algunos "
"contras."

#. ~ Description for Wolfsbane
#: lang/json/SPELL_from_json.py
msgid "The tip of the spear glows white hot as you strike."
msgstr "La punta de la lanza brilla al rojo vivo cuando golpea."

#: lang/json/SPELL_from_json.py
msgid "Point Flare"
msgstr "Punto de Inflamación"

#: lang/json/SPELL_from_json.py
msgid "Nova Flare"
msgstr "Nova de Llamas"

#: lang/json/SPELL_from_json.py
msgid "Finger Firelighter"
msgstr "Dedo Encendedor de Fuegos"

#: lang/json/SPELL_from_json.py
msgid "Ice Spike"
msgstr "Espina de Hielo"

#: lang/json/SPELL_from_json.py
msgid "Fireball"
msgstr "Bola de Fuego"

#: lang/json/SPELL_from_json.py
msgid "Cone of Cold"
msgstr "Cono de Hielo"

#: lang/json/SPELL_from_json.py
msgid "Burning Hands"
msgstr "Manos Ardientes"

#: lang/json/SPELL_from_json.py
msgid "Frost Spray"
msgstr "Rociado de Escarcha"

#: lang/json/SPELL_from_json.py
msgid "Chilling Touch"
msgstr "Toque Escalofriante"

#: lang/json/SPELL_from_json.py
msgid "Glide on Ice"
msgstr "Deslizado de Hielo"

#: lang/json/SPELL_from_json.py
msgid "Hoary Blast"
msgstr "Explosión de Escarcha"

#: lang/json/SPELL_from_json.py
msgid "Ice Shield"
msgstr "Escudo de Hielo"

#: lang/json/SPELL_from_json.py
msgid "Frost Armor"
msgstr "Armadura de Escarcha"

#: lang/json/SPELL_from_json.py
msgid "Kelvinist Rune"
msgstr "Runa Kelvinista"

#. ~ Description for Kelvinist Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Kelvinists.  You can use the "
"rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los kelvinistas. Puedes"
" usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Flamesword"
msgstr "Espada Flamígera"

#. ~ Description for Flamesword
#: lang/json/SPELL_from_json.py
msgid ""
"This spell ignites a wooden sword, creating a flaming blade able to burn, "
"bruise, and chop."
msgstr ""
"Este hechizo enciende una espada de madera, creando una hoja en llamas capaz"
" de quemar, magullar y cortar."

#: lang/json/SPELL_from_json.py
msgid "Flamebreath"
msgstr "Aliento de Llama"

#. ~ Description for Flamebreath
#: lang/json/SPELL_from_json.py
msgid ""
"This spell ignites dust scattered in the air, creating a cone of flame.  The"
" hot ashes can cling to targets, causing additional burns over time."
msgstr ""
"Este hechizo enciende el polvo disperso en el aire, creando un cono de "
"llamas. Las cenizas calientes pueden adherirse a los objetivos, causando "
"quemaduras adicionales con el tiempo."

#: lang/json/SPELL_from_json.py
msgid "Freezing Touch"
msgstr "Toque Congelante"

#. ~ Description for Freezing Touch
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of Freezing touch."
msgstr "Este es un subhechizo de Toque Congelante."

#: lang/json/SPELL_from_json.py
msgid "Summon Crocodile"
msgstr "Invocar Cocodrilo"

#. ~ Description for Summon Crocodile
#: lang/json/SPELL_from_json.py
msgid "Summons a permanent crocodile."
msgstr "Invoca un cocodrilo permanente"

#. ~ Message for SPELL 'Summon Crocodile'
#: lang/json/SPELL_from_json.py
msgid "The shaman summons a crocodile!"
msgstr "¡El chamán invoca un cocodrilo!"

#: lang/json/SPELL_from_json.py
msgid "an ancient reptilian spell"
msgstr "un viejo hechizo reptiliano"

#. ~ Description for an ancient reptilian spell
#: lang/json/SPELL_from_json.py
msgid "Causes one of the shaman spells to be cast."
msgstr "Hace que uno de los hechizos de chamán sea lanzado."

#: lang/json/SPELL_from_json.py
msgid "Shadow Field"
msgstr "Campo de Sombras"

#. ~ Description for Shadow Field
#: lang/json/SPELL_from_json.py
msgid "Cast a field of intense shadows."
msgstr "Lanza un campo de sombras."

#: lang/json/SPELL_from_json.py
msgid "Magic Missile"
msgstr "Misil Mágico"

#: lang/json/SPELL_from_json.py
msgid "Phase Door"
msgstr "Puerta de fase"

#: lang/json/SPELL_from_json.py
msgid "Gravity Well"
msgstr "Pozo de Gravedad"

#: lang/json/SPELL_from_json.py
msgid "Mana Blast"
msgstr "Explosión de Mana"

#: lang/json/SPELL_from_json.py
msgid "Mana Bolt"
msgstr "Saeta de Mana"

#: lang/json/SPELL_from_json.py
msgid "Haste"
msgstr "Apresurarse"

#: lang/json/SPELL_from_json.py
msgid "Baleful Polymorph"
msgstr "Polimorfia Maligna"

#: lang/json/SPELL_from_json.py
msgid "Mana Beam"
msgstr "Rayo de Mana"

#: lang/json/SPELL_from_json.py
msgid "Escape"
msgstr "Escapar"

#: lang/json/SPELL_from_json.py
msgid "Magus Rune"
msgstr "Runa Magus"

#. ~ Description for Magus Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Magi.  You can use the rune as"
" a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los Magi. Puedes usar "
"la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Cat's Grace"
msgstr "Gracia de Gato"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Eagle's Sight"
msgstr "Vista de Aguila"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Ogre's Strength"
msgstr "Fuerza de Ogro"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Fox's Cunning"
msgstr "Astucia de Zorro"

#: lang/json/SPELL_from_json.py
msgid "Jar of Force"
msgstr "Tarro de Fuerza"

#. ~ Description for Jar of Force
#: lang/json/SPELL_from_json.py
msgid "Summon a jar of force in which you can store liquids."
msgstr "Invoca un tarro de fuerza en el cual puedes almacenar líquidos."

#: lang/json/SPELL_from_json.py
msgid "Impact Sling"
msgstr "Honda de Impacto"

#. ~ Description for Impact Sling
#: lang/json/SPELL_from_json.py
msgid ""
"This spell infuses a sling with tremendous force, delivering devastating "
"pebble shots until the energy tears it apart."
msgstr ""
"Este hechizo infunde a una honda con una fuerza tremenda, lanzando "
"devastadores disparos de guijarros hasta que la energía se deshace."

#. ~ Description for Crystallize Mana
#: lang/json/SPELL_from_json.py
msgid ""
"Crystallizes mana into solid form.  Your physiological changes have made "
"this spell much more efficient and easier to cast."
msgstr ""
"Cristaliza maná en forma sólida. Sus cambios fisiológicos han hecho que este"
" hechizo sea mucho más eficiente y fácil de lanzar."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Seeker Bolts"
msgstr "Saetas Buscadoras"

#. ~ Description for Seeker Bolts
#: lang/json/SPELL_from_json.py
msgid ""
"Fires bolts of mana from your fingertips that home in on randomly selected "
"targets in range."
msgstr ""
"Dispara saetas de maná desde la punta de tus dedos que se dirigen a "
"objetivos seleccionados al azar dentro del alcance."

#. ~ description for the sound of spell 'Seeker Bolts'
#: lang/json/SPELL_from_json.py
msgid "a zing"
msgstr "una chispa"

#: lang/json/SPELL_from_json.py
msgid "Blood Suck"
msgstr "Chupa la Sangre"

#. ~ Description for Blood Suck
#: lang/json/SPELL_from_json.py
msgid "Sucks blood from one foe."
msgstr "Chupa la sangre de un enemigo."

#: lang/json/SPELL_from_json.py
msgid "Bear Trap"
msgstr "Trampa de Oso"

#. ~ Description for Bear Trap
#: lang/json/SPELL_from_json.py
msgid "A trap that summons bears!  Not what you were expecting, is it?"
msgstr "¡Una trampa que invoca osos! No es lo que esperabas, ¿verdad?"

#. ~ description for the sound of spell 'Bear Trap'
#. ~ description for the sound of spell 'Forge Trap'
#: lang/json/SPELL_from_json.py
msgid "\"It's a trap!\""
msgstr "\"¡Es una trampa!\""

#: lang/json/SPELL_from_json.py
msgid "Forge Trap"
msgstr "Trampa de Forja"

#. ~ Description for Forge Trap
#: lang/json/SPELL_from_json.py
msgid "A trap that summons forge hounds!  Not what you were expecting, is it?"
msgstr ""
"¡Una trampa que convoca los perros forja! No es lo que esperabas, ¿verdad?"

#: lang/json/SPELL_from_json.py
msgid "Rocket Punch"
msgstr "Golpe de Cohete"

#. ~ Description for Rocket Punch
#: lang/json/SPELL_from_json.py
msgid "Ejects giant fist from arm."
msgstr "Echa el puño gigante del brazo."

#: lang/json/SPELL_from_json.py
msgid "Leprechaun prank"
msgstr "broma Leprechaum"

#. ~ Description for Leprechaun prank
#: lang/json/SPELL_from_json.py
msgid "Pranks the PC.  Gag humor."
msgstr "Bromas al PC. Humor visual."

#: lang/json/SPELL_from_json.py
msgid "Gas Attack"
msgstr "Ataque de Gas"

#. ~ Description for Gas Attack
#: lang/json/SPELL_from_json.py
msgid "Spreads toxic gas around itself."
msgstr "Esparce el gas tóxico alrededor de sí mismo."

#: lang/json/SPELL_from_json.py
msgid "Demon Fireball"
msgstr "Bola de Fuego Demoníaca"

#. ~ Description for Demon Fireball
#: lang/json/SPELL_from_json.py
msgid "This is a monster only spell."
msgstr "Este es un hechizo sólo para monstruos."

#: lang/json/SPELL_from_json.py
msgid "Summon Demon Spiderlings"
msgstr "Invocar Arañitas Demoníacas"

#. ~ Description for Summon Demon Spiderlings
#: lang/json/SPELL_from_json.py
msgid "Summons 4 permanent demon spiderlings."
msgstr "Convocar 4 arañitas demonio permanentes."

#: lang/json/SPELL_from_json.py
msgid "Hellfire Belch"
msgstr "Eructo de Fuego Infernal"

#. ~ Description for Hellfire Belch
#: lang/json/SPELL_from_json.py
msgid "Spits supernatural napalm from your mouth."
msgstr "Escupe napalm sobrenatural por la boca."

#: lang/json/SPELL_from_json.py
msgid "Jolt"
msgstr "Sacudida"

#. ~ description for the sound of spell 'Jolt'
#. ~ description for the sound of spell 'Shocking Lash Base'
#. ~ description for the sound of spell 'Lightning Bolt'
#. ~ description for the sound of spell 'Lightning Blast'
#. ~ description for the sound of spell 'Storm Chain'
#. ~ description for the sound of spell 'Storm Chain 1'
#. ~ description for the sound of spell 'Storm Chain 2'
#. ~ description for the sound of spell 'Storm Chain 3'
#. ~ Mutation class: Manatouched iv_sound_message
#: lang/json/SPELL_from_json.py lang/json/mutation_category_from_json.py
msgid "a crackle"
msgstr "un crujido"

#: lang/json/SPELL_from_json.py
msgid "Shocking Lash Base"
msgstr "Base de Azote Eléctrico"

#. ~ Description for Shocking Lash Base
#: lang/json/SPELL_from_json.py
msgid ""
"Reference spell definition used for Shocking Lash and Shocking Lash Jump"
msgstr ""
"definición del hechizo de Referencia utilizado para Azote Eléctrico y Salto "
"de Azote Eléctrico"

#: lang/json/SPELL_from_json.py
msgid "Shocking Lash"
msgstr "Azote Eléctrico"

#: lang/json/SPELL_from_json.py
msgid "Shocking Lash Jump"
msgstr "Salto de Azote Eléctrico"

#. ~ Description for Shocking Lash Jump
#: lang/json/SPELL_from_json.py
msgid "The secondary jump from Shocking Lash."
msgstr "El salto secundario de Azote Eléctrico."

#: lang/json/SPELL_from_json.py
msgid "Lightning Bolt"
msgstr "Relámpago"

#: lang/json/SPELL_from_json.py
msgid "Windstrike"
msgstr "Golpe de Viento"

#. ~ description for the sound of spell 'Windstrike'
#. ~ description for the sound of spell 'Frozen Winds'
#: lang/json/SPELL_from_json.py
msgid "a whoosh"
msgstr "Un silbido"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Windrunning"
msgstr "Viento Corredor"

#: lang/json/SPELL_from_json.py
msgid "Call Stormhammer"
msgstr "Llama al Martillo de Trueno"

#: lang/json/SPELL_from_json.py
msgid "Stormshaper Rune"
msgstr "Runa del Moldeador de Tormentas"

#. ~ Description for Stormshaper Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Stormshapers.  You can use the"
" rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los Moldeadores de "
"Tormentas. Puedes usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Lightning Blast"
msgstr "Explosión de Relampago"

#: lang/json/SPELL_from_json.py lang/json/weather_type_from_json.py
#: lang/json/weather_type_from_json.py
msgid "Lightning Storm"
msgstr "Lluvia con rayos"

#. ~ Description for Lightning Storm
#: lang/json/SPELL_from_json.py
msgid ""
"You call the power of the sky to strike the earth.  Several lightning blasts"
" fire from your finger tips to strike the target."
msgstr ""
"Llamas al poder del cielo para golpear la tierra. Varios relámpagos disparan"
" desde las puntas de los dedos para golpear el objetivo."

#: lang/json/SPELL_from_json.py
msgid "Ionization"
msgstr "Ionización"

#: lang/json/SPELL_from_json.py
msgid "Ionization Thunderclap"
msgstr "Trueno con Ionización"

#. ~ Description for Ionization Thunderclap
#: lang/json/SPELL_from_json.py
msgid "Adds the actual flashbang effect."
msgstr "Añade el efecto de explosión del destello."

#: lang/json/SPELL_from_json.py
msgid "Wall of Fog"
msgstr "Muro de Nieve"

#: lang/json/SPELL_from_json.py
msgid "Repelling Arc Aura"
msgstr "Aura de Arco Repelente"

#. ~ Description for Repelling Arc Aura
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell of the Repelling Arc spell."
msgstr "Este es un subhechizo del hechizo Arco Repelente."

#. ~ description for the sound of spell 'Repelling Arc Aura'
#: lang/json/SPELL_from_json.py
msgid "arcing electricity!"
msgstr "¡arcos eléctricos!"

#: lang/json/SPELL_from_json.py
msgid "Repelling Arc"
msgstr "Arco Repelente"

#. ~ Description for Repelling Arc
#: lang/json/SPELL_from_json.py
msgid ""
"Manifests an aura of crackling electricity around you to strike attackers "
"with baleful lightning."
msgstr ""
"Manifiesta un aura de electricidad crepitante a tu alrededor para golpear a "
"los atacantes con un relámpago tortuoso."

#: lang/json/SPELL_from_json.py
msgid "Bless"
msgstr "Bendición"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Invisibility"
msgstr "Invisibilidad"

#. ~ Description for Invisibility
#: lang/json/SPELL_from_json.py
msgid ""
"Creates a magical field that hides your visual presence to others.  "
"Colloquially known as invisibility, but without all the science mumbo jumbo."
msgstr ""
"Crea un campo mágico que oculta tu presencia visual a los otros "
"Coloquialmente conocido como invisibilidad, pero sin toda la jerga de la "
"ciencia."

#. ~ Message for SPELL 'Invisibility'
#: lang/json/SPELL_from_json.py
msgid "To the outside world, your body fades away and you cease to exist!"
msgstr "¡Al mundo exterior, tu cuerpo se desvanece y dejas de existir!"

#: lang/json/SPELL_from_json.py
msgid "Holy Blade"
msgstr "Cuchilla Sagrada"

#: lang/json/SPELL_from_json.py
msgid "Spiritual Armor"
msgstr "Armadura Espiritual"

#: lang/json/SPELL_from_json.py
msgid "Lamp"
msgstr "Lámpara"

#: lang/json/SPELL_from_json.py
msgid "Manatricity"
msgstr "Manatricidad"

#: lang/json/SPELL_from_json.py
msgid "Technomancer Rune"
msgstr "Runa del Tecnomante"

#. ~ Description for Technomancer Rune
#: lang/json/SPELL_from_json.py
msgid ""
"This ritual creates a small pebble attuned to Technomancers.  You can use "
"the rune as a catalyst for recipes."
msgstr ""
"Este ritual crea un pequeño guijarro en sintonía con los Tecnomantes. Puedes"
" usar la runa como catalizador para las recetas."

#: lang/json/SPELL_from_json.py
msgid "Taze"
msgstr "Tasear"

#: lang/json/SPELL_from_json.py
msgid "Lesser Quantum Tunnel"
msgstr "Túnel Cuántico Menor"

#: lang/json/SPELL_from_json.py lang/json/effects_from_json.py
msgid "Synaptic Stimulation"
msgstr "Estimulación Sináptica"

#: lang/json/SPELL_from_json.py
msgid "Laze"
msgstr "Holgazanear"

#: lang/json/SPELL_from_json.py
msgid "Animated Blade"
msgstr "Hoja Animada"

#: lang/json/SPELL_from_json.py
msgid "Mirror Image"
msgstr "Imagen Espejo"

#: lang/json/SPELL_from_json.py
msgid "Summon floating disk"
msgstr "Invocar disco flotante"

#: lang/json/SPELL_from_json.py
msgid "Summon Mojocycle"
msgstr "Invocar Mojocicleta"

#. ~ Description for Summon Mojocycle
#: lang/json/SPELL_from_json.py
msgid "You're not a cowboy, but on a steel horse you ride regardless."
msgstr ""
"No eres un vaquero, pero en un caballo de acero cabalgas a pesar de todo."

#: lang/json/SPELL_from_json.py
msgid "Overcharge Burn"
msgstr "Quemadura sobrecargada"

#. ~ Description for Overcharge Burn
#: lang/json/SPELL_from_json.py
msgid "The side effects of casting the overcharge spell."
msgstr "Los efectos secundarios de lanzar el hechizo de sobrecarga."

#: lang/json/SPELL_from_json.py
msgid "Optical Sneeze Beam"
msgstr "Haz de Estornudo Óptico"

#. ~ Description for Optical Sneeze Beam
#: lang/json/SPELL_from_json.py
msgid ""
"You overcharge your internal batteries to send a semi-directed beam from "
"your face.  The inventor of this spell must have had some weird sense of "
"humor."
msgstr ""
"Sobrecargas tus baterías internas para enviar un rayo semidirigido desde tu "
"cara. El inventor de este hechizo debió de tener un extraño sentido del "
"humor."

#. ~ description for the sound of spell 'Optical Sneeze Beam'
#: lang/json/SPELL_from_json.py
msgid "bzzzzzzt!"
msgstr "¡bzzzzzzt!"

#. ~ Message for SPELL 'Optical Sneeze Beam'
#: lang/json/SPELL_from_json.py
msgid ""
"You overcharge your bionic energy through what ley lines you have left, and "
"channel it through the center of your face."
msgstr ""
"Sobrecargas tu energía biónica a través de las líneas ley que te quedan, y "
"las canalizas por el centro de tu cara."

#: lang/json/SPELL_from_json.py
msgid "X-ray Vision"
msgstr "Visión Rayos X"

#: lang/json/SPELL_from_json.py
msgid "Knock"
msgstr "Toque De Puerta"

#. ~ Description for Knock
#: lang/json/SPELL_from_json.py
msgid ""
"You channel magic into a force capable of opening doors.  This variant can "
"only open wooden doors."
msgstr ""
"Canalizas la magia en una fuerza capaz de abrir puertas. Esta variante solo "
"puede abrir puertas de madera."

#: lang/json/SPELL_from_json.py
msgid "Improved Knock"
msgstr "Toque De Puerta Mejorado"

#. ~ Description for Improved Knock
#: lang/json/SPELL_from_json.py
msgid ""
"You channel magic into a force capable of opening doors.  This variant can "
"open any locked door."
msgstr ""
"Canalizas la magia en una fuerza capaz de abrir puertas. Esta variante puede"
" abrir cualquier puerta cerrada."

#: lang/json/SPELL_from_json.py
msgid "Knifeshot"
msgstr "Tiro Cuchillo"

#. ~ Description for Knifeshot
#: lang/json/SPELL_from_json.py
msgid ""
"This spell generates a magnetic field around a knife, before launching it at"
" high speed."
msgstr ""
"Este hechizo genera un campo magnético alrededor de un cuchillo, antes de "
"lanzarlo a gran velocidad."

#: lang/json/SPELL_from_json.py
msgid "Hypervelocity Knifeshot"
msgstr "Tiro Cuchillo Hiperveloz"

#. ~ Description for Hypervelocity Knifeshot
#: lang/json/SPELL_from_json.py
msgid ""
"This spell goes even further beyond, launching a knife so fast it can pierce"
" through targets."
msgstr ""
"Este hechizo va más allá, lanzando un cuchillo tan rápido que puede "
"atravesar objetivos."

#: lang/json/SPELL_from_json.py
msgid "Spy Wasp"
msgstr "Avispa Espia"

#. ~ Description for Spy Wasp
#: lang/json/SPELL_from_json.py
msgid ""
"Sends out a partly magical, partly electronic spy drone shaped like a wasp "
"that reveals terrain in a line in front of you.  The wasp can travel through"
" walls."
msgstr ""
"Envía un dron espía en parte mágico y en parte electrónico con forma de "
"avispa que revela el terreno en una línea delante de ti. La avispa puede "
"viajar a través de las paredes."

#: lang/json/SPELL_from_json.py
msgid "Artificer's Toolkit"
msgstr "Herramientas de Artifice"

#. ~ Description for Artificer's Toolkit
#: lang/json/SPELL_from_json.py
msgid ""
"Artificers have a special pocket dimension with a magical tool that can "
"cover a wide variety of tasks.  It is only a matter of temporarily summoning"
" the item for use."
msgstr ""
"Los artífices tienen una dimensión de bolsillo especial con una herramienta "
"mágica que puede cubrir una gran variedad de tareas. Solo es cuestión de "
"invocar temporalmente el objeto para utilizarlo."

#: lang/json/SPELL_from_json.py
msgid "Nitro Boost"
msgstr "Empuje Nitro"

#. ~ Description for Nitro Boost
#: lang/json/SPELL_from_json.py
msgid ""
"You overclock your flesh and bionics, charging so fast the friction can "
"ignite the air, to wind up for a skull-cracking punch."
msgstr ""
"Aceleras tu carne y tus biónicos, cargando tan rápido que la fricción puede "
"incendiar el aire, para dar un golpe rompedor de cráneos."

#: lang/json/SPELL_from_json.py
msgid "Jury Rig"
msgstr "Aparejo de Jurado"

#: lang/json/SPELL_from_json.py
msgid "Greater Banishment"
msgstr "Destierro Mayor"

#. ~ Description for Greater Banishment
#: lang/json/SPELL_from_json.py
msgid ""
"A more advanced version of Banishment, which is a ritual spell that attempts"
" to banish a monster.  Being closely related to blood magic, the Blood Mage "
"is much more specialized to use a spell like this."
msgstr ""
"Una versión más avanzada del Destierro, que es un hechizo ritual que intenta"
" desterrar a un monstruo. Al estar estrechamente relacionado con la magia de"
" sangre, el Mago de Sangre está mucho más especializado para utilizar un "
"hechizo como este."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Demonic Possession"
msgstr "Posesión Demoniaca"

#. ~ Description for Demonic Possession
#: lang/json/SPELL_from_json.py
msgid ""
"You allow a demon to possess your body for a short time, giving you great "
"combat abilities.  You still retain control, though lose your spellcasting "
"abilities temporarily."
msgstr ""
"Permites que un demonio posea tu cuerpo durante un breve periodo de tiempo, "
"lo que te proporciona grandes habilidades de combate. Sigues manteniendo el "
"control, pero pierdes temporalmente tus habilidades de lanzamiento de "
"hechizos."

#: lang/json/SPELL_from_json.py
msgid "Auroral Wave"
msgstr "Onda Aurora"

#. ~ Description for Auroral Wave
#: lang/json/SPELL_from_json.py
msgid ""
"A rippling wave of luminous energy spreads from your hands, a beautiful "
"torrent of magnetic force and chill wind."
msgstr ""
"Una onda ondulante de energía luminosa se extiende desde tus manos, un "
"hermoso torrente de fuerza magnética y viento helado."

#. ~ description for the sound of spell 'Auroral Wave'
#: lang/json/SPELL_from_json.py
msgid "a faint shimmering crackle"
msgstr "un débil crujido brillante"

#. ~ Description for Auroral Wave
#: lang/json/SPELL_from_json.py
msgid ""
"This is the cold damage portion of the Auroral Wave spell, it is a wider "
"blast around the central high damage cone."
msgstr ""
"Esta es la parte de daño por frío del hechizo Onda Auroral, es una ráfaga "
"más amplia alrededor del cono central de alto daño."

#: lang/json/SPELL_from_json.py
msgid "Immolate Transform"
msgstr "Transformación de Inmolación"

#. ~ Description for Immolate Transform
#: lang/json/SPELL_from_json.py
msgid "The part of the Immolate spell that causes the transform."
msgstr "La parte del hechizo de inmolación que causa la transformación."

#: lang/json/SPELL_from_json.py
msgid "Immolate"
msgstr "Inmolar"

#. ~ Description for Immolate
#: lang/json/SPELL_from_json.py
msgid ""
"A purifying blast of raw elemental heat wipes the slate clean, searing the "
"Earth back to her most original state: a barren ball of burning rock."
msgstr ""
"Una ráfaga purificadora de calor elemental en bruto hace borrón y cuenta "
"nueva, devolviendo la Tierra a su estado más original: una bola estéril de "
"roca ardiente."

#. ~ description for the sound of spell 'Immolate'
#: lang/json/SPELL_from_json.py
msgid "a searing whoosh"
msgstr "un silbido abrasador"

#: lang/json/SPELL_from_json.py
msgid "Immolate push effect"
msgstr "Empuje de inmolación"

#. ~ Description for Immolate push effect
#: lang/json/SPELL_from_json.py
msgid ""
"The immolate spell is powerful enough to push targets from its epicenter."
msgstr ""
"El hechizo de inmolación es lo suficientemente poderoso como para empujar a "
"los objetivos desde su epicentro."

#: lang/json/SPELL_from_json.py lang/json/TOOL_ARMOR_from_json.py
msgid "Holy Shield"
msgid_plural "Holy Shields"
msgstr[0] "Escudo Sagrado"
msgstr[1] "Escudos Sagrados"

#. ~ Description for Holy Shield
#: lang/json/SPELL_from_json.py
msgid ""
"Crusaders have the ability to summon a magically enhanced shield to their "
"arm to protect them in armed combat."
msgstr ""
"Los cruzados tienen la habilidad de invocar un escudo mejorado mágicamente "
"en su brazo para protegerse en el combate armado."

#: lang/json/SPELL_from_json.py
msgid "Quake"
msgstr "Terremoto"

#. ~ Description for Quake
#: lang/json/SPELL_from_json.py
msgid ""
"Cause a localized earthquake, knocking down enemies and overturning the "
"earth."
msgstr ""
"Provoca un terremoto localizado, derribando a los enemigos y volcando la "
"tierra."

#. ~ description for the sound of spell 'Quake'
#: lang/json/SPELL_from_json.py
msgid "a deep rumbling"
msgstr "un profundo estruendo"

#: lang/json/SPELL_from_json.py
msgid "Quake Transform"
msgstr "Transformación de Terremoto"

#. ~ Description for Quake Transform
#: lang/json/SPELL_from_json.py
msgid "causes rubble to be spawned occasionally"
msgstr "causa que aparezcan escombros ocasionalmente"

#: lang/json/SPELL_from_json.py
msgid "Rock Blast"
msgstr "Explosión de Roca"

#. ~ Description for Rock Blast
#: lang/json/SPELL_from_json.py
msgid ""
"Fire three large rocks at an enemy, causing blunt damage and knocking it "
"back."
msgstr ""
"Dispara tres grandes rocas a un enemigo, causando daño de impacto y "
"haciéndolo retroceder."

#: lang/json/SPELL_from_json.py
msgid "Single Rock Blast"
msgstr "Explosión de Roca Singular"

#. ~ Description for Single Rock Blast
#: lang/json/SPELL_from_json.py
msgid "A single portion of the rock blast spell"
msgstr "Una sola porción del hechizo de explosión de roca"

#: lang/json/SPELL_from_json.py
msgid "Rock Blast Push"
msgstr "Empuje de Explosión de Roca"

#. ~ Description for Rock Blast Push
#: lang/json/SPELL_from_json.py
msgid "The push portion of the rock blast spell"
msgstr "La porción de empuje del hechizo explosión de roca"

#: lang/json/SPELL_from_json.py
msgid "Flareup"
msgstr "Incinerar"

#. ~ Description for Flareup
#: lang/json/SPELL_from_json.py
msgid ""
"You channel heat through your hands to severely burn a target you touch."
msgstr ""
"Canalizas el calor a través de tus manos para quemar gravemente al objetivo "
"que toques."

#. ~ description for the sound of spell 'Flareup'
#. ~ description for the sound of spell 'Burn at Both Ends'
#: lang/json/SPELL_from_json.py
msgid "skin crackling"
msgstr "piel crepitante"

#: lang/json/SPELL_from_json.py
msgid "Flarewhip"
msgstr "látigo de llamas"

#. ~ Description for Flarewhip
#: lang/json/SPELL_from_json.py
msgid "You conjure a whip made of solid flame."
msgstr "Conjuras un látigo hecho de llamas sólidas."

#. ~ description for the sound of spell 'Flarewhip'
#: lang/json/SPELL_from_json.py
msgid "whoosh"
msgstr "whoosh"

#: lang/json/SPELL_from_json.py
msgid "Force Blade"
msgstr "Cuchilla de Fuerza"

#. ~ Description for Force Blade
#: lang/json/SPELL_from_json.py
msgid ""
"You shoot a blade of concentrated force in a straight line, cutting "
"everything in its path."
msgstr ""
"Disparas una hoja de fuerza concentrada en línea recta, cortando todo a su "
"paso."

#. ~ Description for Force Shield
#: lang/json/SPELL_from_json.py
msgid ""
"Adds a shield of pure force that protects your body and your clothing from "
"attacks."
msgstr ""
"Añade un escudo de fuerza pura que protege tu cuerpo y tu ropa de los "
"ataques."

#: lang/json/SPELL_from_json.py
msgid "Ice Clave"
msgstr "Garra de Hielo"

#. ~ Description for Ice Clave
#: lang/json/SPELL_from_json.py
msgid "Use the unstoppable force from a glacier to cause severe damage."
msgstr "Utiliza la fuerza imparable de un glaciar para causar graves daños."

#. ~ Description for Ice Clave
#: lang/json/SPELL_from_json.py
msgid "This is the blunt damage portion of the Ice Clave spell"
msgstr "Esta es la parte de daño de impacto del hechizo Garra de Hielo"

#: lang/json/SPELL_from_json.py
msgid "Frozen Winds"
msgstr "Vientos Helados"

#. ~ Description for Frozen Winds
#: lang/json/SPELL_from_json.py
msgid ""
"A gust of wind, colder than any Earthly mountaintop, spirals from your "
"fingers, damaging and pushing anything in its path."
msgstr ""
"Una ráfaga de viento, más fría que la cima de cualquier montaña terrestre, "
"sale en espiral de tus dedos, dañando y empujando todo lo que encuentra a su"
" paso."

#: lang/json/SPELL_from_json.py
msgid "Frozen Winds push effect"
msgstr "empuje de Vientos Helados"

#. ~ Description for Frozen Winds push effect
#: lang/json/SPELL_from_json.py
msgid "This is the push effect portion of the Frozen Winds spell."
msgstr "Esta es la porción de efecto de empeje del hechizo Vientos Helados."

#: lang/json/SPELL_from_json.py
msgid "Summon Claygolem"
msgstr "Invocar Golem de Arcilla"

#. ~ Description for Summon Claygolem
#: lang/json/SPELL_from_json.py
msgid ""
"Use a golem core as a focus to shape clay into a roughly humanoid shape and "
"animate it for some time."
msgstr ""
"Utiliza un núcleo de gólem como centro para moldear arcilla con una forma "
"aproximadamente humanoide y animarla durante algún tiempo."

#: lang/json/SPELL_from_json.py
msgid "Give back core"
msgstr "Devolver núcleo"

#. ~ Description for Give back core
#: lang/json/SPELL_from_json.py
msgid "Gives back a golem's core.  You should not see this spell"
msgstr "Devuelve el núcleo de un golem. No deberías ver este hechizo"

#: lang/json/SPELL_from_json.py
msgid "Golem Push"
msgstr "Empuje de Golem"

#. ~ Description for Golem Push
#: lang/json/SPELL_from_json.py
msgid "You channel the strength of a golem to push an enemy backward."
msgstr ""
"Canalizas la fuerza de un gólem para empujar a un enemigo hacia atrás."

#: lang/json/SPELL_from_json.py
msgid "Graviton Polarization Damage"
msgstr "Daño Polarización de Gravitón"

#. ~ Description for Graviton Polarization Damage
#: lang/json/SPELL_from_json.py
msgid ""
"handles the damage part of Graviton Polarization - if you see this something"
" went wrong"
msgstr ""
"se encarga del daño de la Polarización de Gravitón - si ves esto, algo salió"
" mal"

#: lang/json/SPELL_from_json.py
msgid "Graviton Polarization"
msgstr "Polarización de Gravitón"

#. ~ Description for Graviton Polarization
#: lang/json/SPELL_from_json.py
msgid ""
"Changes and amplifies gravitational pull towards a point you choose even "
"through walls.  Pulls in items and deals bashing damage in its center."
msgstr ""
"Cambia y amplifica la atracción gravitatoria hacia un punto que elijas, "
"incluso a través de las paredes. Atrae objetos e inflige daño de golpe en su"
" centro."

#. ~ description for the sound of spell 'Graviton Polarization'
#: lang/json/SPELL_from_json.py
msgid "a crack"
msgstr "una rotura"

#: lang/json/SPELL_from_json.py
msgid "Graviton Polarization centerdamage"
msgstr "Daño Central Pol. de Gravitón "

#. ~ Description for Graviton Polarization centerdamage
#: lang/json/SPELL_from_json.py
msgid "handles damage in the extreme center of the Graviton"
msgstr "maneja el daño en el centro extremo del Gravitón"

#: lang/json/SPELL_from_json.py
msgid "Subzero Talons"
msgstr "Garras Bajo Cero"

#. ~ Description for Subzero Talons
#: lang/json/SPELL_from_json.py
msgid ""
"Your fingers stiffen as condensation freezes into claws, intensifying your "
"naturally cold touch and protecting your hands from damage."
msgstr ""
"Tus dedos se endurecen a medida que la condensación se congela en garras, "
"intensificando tu tacto naturalmente frío y protegiendo tus manos de daños."

#: lang/json/SPELL_from_json.py
msgid "Spear of Light"
msgstr "Lanza de Luz"

#. ~ Description for Spear of Light
#: lang/json/SPELL_from_json.py
msgid ""
"Shoot directed light from your fingertips that is so bright you can see "
"through the skin of the targets for an instant."
msgstr ""
"Dispara una luz dirigida desde la punta de tus dedos que es tan brillante "
"que puede ver a través de la piel de los objetivos por un instante."

#: lang/json/SPELL_from_json.py lang/json/bionic_from_json.py
msgid "Railgun"
msgstr "Cañón de Riel"

#. ~ Description for Railgun
#: lang/json/SPELL_from_json.py
msgid ""
"Magnetize a bullet, and fire it at supersonic speeds by applying an opposite"
" magnetic force to the bullet.  Leaves a trail of sparks"
msgstr ""
"Magnetiza una bala y dispára a velocidades supersónicas aplicando una fuerza"
" magnética opuesta a la bala. Deja un rastro de chispas"

#: lang/json/SPELL_from_json.py
msgid "Railgun Sparks"
msgstr "Chispas de Cañón de Riel"

#. ~ Description for Railgun Sparks
#: lang/json/SPELL_from_json.py
msgid "The spark portion of the Railgun spell"
msgstr "La porción eléctrica del hechizo Cañón de Riel"

#: lang/json/SPELL_from_json.py
msgid "Overaccelerate"
msgstr "Sobreacelerar"

#. ~ Description for Overaccelerate
#: lang/json/SPELL_from_json.py
msgid ""
"This drastically increases one target's metabolism to dangerous levels, "
"causing its body to tear itself apart"
msgstr ""
"Esto aumenta drásticamente el metabolismo de un objetivo a niveles "
"peligrosos, haciendo que su cuerpo se desgarre"

#: lang/json/SPELL_from_json.py
msgid "Shortwave"
msgstr "Onda Corta"

#. ~ Description for Shortwave
#. ~ Description for Shortwave 2
#: lang/json/SPELL_from_json.py
msgid "Cook nearby monsters (and yourself to an extent)"
msgstr "Cocina a los monstruos cercanos (y a ti mismo hasta cierto punto)"

#: lang/json/SPELL_from_json.py
msgid "Shortwave 2"
msgstr "Onda Corta 2"

#: lang/json/SPELL_from_json.py
msgid "Gamma Burst"
msgstr "Quemadura Gamma"

#. ~ Description for Gamma Burst
#: lang/json/SPELL_from_json.py
msgid ""
"Cause cell damage to everything in a wide area.  Fast to cast, but does "
"damage slowly."
msgstr ""
"Causa daño celular a todo lo que se encuentra en un área amplia. Es rápido "
"de lanzar, pero hace daño lentamente."

#: lang/json/SPELL_from_json.py
msgid "Burn at Both Ends"
msgstr "Quemadura de Dos Extremos"

#. ~ Description for Burn at Both Ends
#: lang/json/SPELL_from_json.py
msgid ""
"A candle burns the most brightly at both ends, and yet it burns twice as "
"fast."
msgstr ""
"Una vela arde con más fuerza por los dos extremos y, sin embargo, arde el "
"doble de rápido."

#. ~ Description for Soul Burn
#: lang/json/SPELL_from_json.py
msgid "This is a description for a spell the player will never see."
msgstr "Esta es una descripción para un hechizo que el jugador nunca verá."

#: lang/json/SPELL_from_json.py
msgid "Soul Afterburner"
msgstr "Postcombustión de Alma"

#. ~ Description for Soul Afterburner
#: lang/json/SPELL_from_json.py
msgid "You burn a small portion of your soul to gain a large burst of speed."
msgstr ""
"Quemas una pequeña porción de tu alma para ganar una gran ráfaga de "
"velocidad."

#: lang/json/SPELL_from_json.py
msgid "Storm Chain"
msgstr "Cadena de Tormentas"

#. ~ Description for Storm Chain
#: lang/json/SPELL_from_json.py
msgid ""
"You touch an unwilling subject and lightning dances from you to multiple "
"nearby enemies."
msgstr ""
"Tocas a un sujeto involuntario y un rayo baila desde ti hacia varios "
"enemigos cercanos."

#: lang/json/SPELL_from_json.py
msgid "Storm Chain 1"
msgstr "Cadena de Tormentas 1"

#. ~ Description for Storm Chain 1
#: lang/json/SPELL_from_json.py
msgid "#1 in the storm chain series of effects"
msgstr "#1 de la serie de efectos de la cadena de tormentas"

#: lang/json/SPELL_from_json.py
msgid "Storm Chain 2"
msgstr "Cadena de Tormentas 2"

#. ~ Description for Storm Chain 2
#: lang/json/SPELL_from_json.py
msgid "#2 in the storm chain series of effects"
msgstr "#2 de la serie de efectos de la cadena de tormentas"

#: lang/json/SPELL_from_json.py
msgid "Storm Chain 3"
msgstr "Cadena de Tormentas 3"

#. ~ Description for Storm Chain 3
#: lang/json/SPELL_from_json.py
msgid "#3 in the storm chain series of effects"
msgstr "#3 de la serie de efectos de la cadena de tormentas"

#: lang/json/SPELL_from_json.py
msgid "Solar Beam"
msgstr "Rayo Solar"

#. ~ Description for Solar Beam
#: lang/json/SPELL_from_json.py
msgid ""
"Fire a blast of sunlight in a wide beam, blinding everything in its path and"
" leaving it bright enough for you to see for a few seconds."
msgstr ""
"Dispara una ráfaga de luz solar en un amplio haz, cegando todo a su paso y "
"quedando lo suficientemente brillante como para que puedas ver durante unos "
"segundos."

#: lang/json/SPELL_from_json.py
msgid "Cold Snap"
msgstr "Chasquido Frio"

#. ~ Description for Cold Snap
#: lang/json/SPELL_from_json.py
msgid ""
"With a snap of your fingers, a target takes cold damage and freezes in "
"place."
msgstr ""
"Con un chasquido de dedos, un objetivo recibe daño por frío y se congela en "
"el lugar."

#: lang/json/SPELL_from_json.py
msgid "Cold Snap Freeze"
msgstr "Congelación de Chasquido Frio"

#. ~ Description for Cold Snap Freeze
#: lang/json/SPELL_from_json.py
msgid "Freezes the target monster in place"
msgstr "Congela al monstruo objetivo en su lugar"

#: lang/json/SPELL_from_json.py
msgid "Winter Wolf's Call"
msgstr "Llamada del Lobo de Invierno"

#. ~ Description for Winter Wolf's Call
#: lang/json/SPELL_from_json.py
msgid ""
"Summon your personal pack of winter wolves to freeze and maul your foes."
msgstr ""
"Invoca tu manada personal de lobos de invierno para congelar y destrozar a "
"tus enemigos."

#: lang/json/SPELL_from_json.py
msgid "Lava Bomb Shrapnel"
msgstr "Bomba de Lava Metralla"

#. ~ Description for Lava Bomb Shrapnel
#. ~ Description for Lava Bomb Heat
#. ~ Description for Lava Bomb Terrain
#: lang/json/SPELL_from_json.py
msgid "This is a sub spell for the Lava Bomb spell."
msgstr "Este es un subhechizo para el hechizo de Bomba de Lava."

#: lang/json/SPELL_from_json.py
msgid "Lava Bomb Heat"
msgstr "Calor de la Bomba de Lava"

#: lang/json/SPELL_from_json.py
msgid "Lava Bomb Terrain"
msgstr "Terreno de Bomba de Lava"

#: lang/json/SPELL_from_json.py
msgid "Lava Bomb"
msgstr "Bomba Lava"

#. ~ Description for Lava Bomb
#: lang/json/SPELL_from_json.py
msgid ""
"You tear up the ground beneath you to fire a lava bomb: a globe of lava "
"surrounded by hot, solid rock.  It shatters upon impact, spraying shards of "
"rock and lava everywhere."
msgstr ""
"Desgarras el suelo debajo de ti para disparar una bomba de lava: un globo de"
" lava rodeado de roca caliente y sólida. Se rompe en el impacto, rociando "
"fragmentos de roca y lava por todas partes."

#: lang/json/SPELL_from_json.py
msgid "Assassin Teleport"
msgstr "Teletransporte Asesino"

#. ~ Description for Assassin Teleport
#: lang/json/SPELL_from_json.py
msgid "This is a sub-spell for Assassin Strike.  It teleports you."
msgstr "Este es un subhechizo de Golpe de Asesino. Te teletransporta."

#: lang/json/SPELL_from_json.py
msgid "Assassin Toxic Smoke"
msgstr "Humo Tóxico Asesino"

#. ~ Description for Assassin Toxic Smoke
#: lang/json/SPELL_from_json.py
msgid ""
"This is a sub-spell for Assassin Strike.  It generates toxic smoke in an "
"area."
msgstr ""
"Este es un subhechizo de Golpe Asesino. Genera humo tóxico en un área."

#: lang/json/SPELL_from_json.py
msgid "Assassin Strike"
msgstr "Golpe Asesino"

#. ~ Description for Assassin Strike
#: lang/json/SPELL_from_json.py
msgid "You strike a poisonous blow and disappear in a puff of toxic smoke."
msgstr "Das un golpe venenoso y desapareces en una bocanada de humo tóxico."

#: lang/json/SPELL_from_json.py
msgid "Fire Elemental Burnback"
msgstr "Quemadura Elemental de Fuego"

#. ~ Description for Fire Elemental Burnback
#: lang/json/SPELL_from_json.py
msgid "The burnback effect from the Fire Elemental Attunement."
msgstr "El efecto quemadura de Sintonia Elemental de Fuego."

#: lang/json/SPELL_from_json.py
msgid "Gaia's Chosen Thorns"
msgstr "Espinas Elegidas de Gaia"

#. ~ Description for Gaia's Chosen Thorns
#: lang/json/SPELL_from_json.py
msgid "The thorns effect from the Gaia's Chosen Attunement."
msgstr "El efecto de las espinas de la Sintonia de los Elegidos de Gaia."

#: lang/json/SPELL_from_json.py
msgid "Ice Elemental Cold Damage"
msgstr "Daño Frío Elemental de Hielo"

#. ~ Description for Ice Elemental Cold Damage
#: lang/json/SPELL_from_json.py
msgid "The cold damage effect from the Ice Elemental Attunement."
msgstr "El efecto de daño de frio de la Sintonia Elemental de Hielo."

#: lang/json/SPELL_from_json.py
msgid "Soul Pressure"
msgstr "Presión de Alma"

#. ~ Description for Soul Pressure
#: lang/json/SPELL_from_json.py
msgid ""
"This is a spell that represents the Soulfire putting a burning pressure on "
"nearby opponents.  If you are seeing this spell, you have debugged it in."
msgstr ""
"Este es un hechizo que representa al Fuego del Alma ejerciendo una presión "
"ardiente sobre los oponentes cercanos. Si estás viendo este hechizo, lo "
"estas depurando."

#. ~ description for the sound of spell 'Soul Pressure'
#: lang/json/SPELL_from_json.py
msgid "a grunt and a sizzle"
msgstr "un gruñido y un chisporroteo"

#: lang/json/SPELL_from_json.py
msgid "Fire Elemental Zapback"
msgstr "Electricidad de Elem. Tormenta"

#. ~ Description for Fire Elemental Zapback
#: lang/json/SPELL_from_json.py
msgid "The zapback effect from the Storm Elemental Attunement."
msgstr "El efecto eléctrico de la Sintonia Elemental de la Tormenta."

#: lang/json/SPELL_from_json.py
msgid "Void Claws"
msgstr "Garras del Vacío"

#. ~ Description for Void Claws
#: lang/json/SPELL_from_json.py
msgid "This is a spell that causes a DoT effect whenever you hit."
msgstr ""
"Este es un hechizo que causa un efecto Daño durante un Tiempo (DoT) cada vez"
" que golpea."

#: lang/json/SPELL_from_json.py lang/json/mutation_from_json.py
msgid "Mana Siphon"
msgstr "Sifón de Mana"

#. ~ Description for Mana Siphon
#: lang/json/SPELL_from_json.py
msgid ""
"This is the spell portion of the mana siphon series of mutations.  If you "
"have this spell you probably debugged it in."
msgstr ""
"Esta es la parte del hechizo de sifón de maná de una serie de mutaciones. Si"
" tienes este hechizo probablemente lo hayas depurado."

#: lang/json/TOOLMOD_from_json.py
msgid "reactor core expansion device"
msgid_plural "reactor core expansion devices"
msgstr[0] "dispositivo de expansión de núcleo de reactor"
msgstr[1] "dispositivos de expansión de núcleo de reactor"

#. ~ Description for reactor core expansion device
#: lang/json/TOOLMOD_from_json.py
msgid ""
"This is an expansion device for use on plutonium-powered equipment.  With "
"enough electronics skill, you could attach this to an atomic tool to double "
"the amount of plutonium it can hold.  Note that this device is incompatible "
"with the atomic battery mod."
msgstr ""
"Es un dispositivo de expansión para utilizar en un equipo alimentado por "
"plutonio. Con la suficiente habilidad en electrónica, podrías agregar esto a"
" cualquier herramienta atómica para duplicar la capacidad de plutonio que "
"puede llevar. Fijate que este dispositivo es incompatible con la "
"modificación de batería atómica."

#: lang/json/TOOLMOD_from_json.py
msgid "base toolmod"
msgid_plural "base toolmods"
msgstr[0] "herramienta personalizada base"
msgstr[1] "herramientas personalizadas base"

#: lang/json/TOOLMOD_from_json.py
msgid "UPS conversion mod"
msgid_plural "UPS conversion mods"
msgstr[0] "modificación de UPS"
msgstr[1] "modificaciones de UPS"

#. ~ Description for UPS conversion mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"This device replaces conventional battery connections with a connector port "
"that can plug into a UPS.  Any device modified with this can be used without"
" a battery as long as you have a charged UPS with you."
msgstr ""
"Este dispositivo reemplaza las conexiones convencionales de la batería con "
"un puerto conector que se puede conectar a un SAI. Cualquier dispositivo "
"modificado con esto puede ser usado sin una batería siempre y cuando tenga "
"un SAI cargado."

#: lang/json/TOOLMOD_from_json.py
msgid "battery compartment mod"
msgid_plural "battery compartment mods"
msgstr[0] "Compartimento de batería modificado"
msgstr[1] "Compartimentos de baterías modificados"

#. ~ Description for battery compartment mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"A battery compartment mod that allows using vehicle batteries and small "
"storage batteries in regular tools."
msgstr ""
"Es una modificación de compartimiento para batería que te permite utilizar "
"las baterías de vehículos y baterías pequeñas en herramientas comunes."

#: lang/json/TOOLMOD_from_json.py
msgid "light battery mod"
msgid_plural "light battery mods"
msgstr[0] "modificador de batería ligera"
msgstr[1] "modificadores de baterías ligeras"

#. ~ Description for light battery mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"A battery compartment mod that allows the use of light batteries in tools "
"that otherwise could not."
msgstr ""
"Un modificador de compartimiento de batería que permite el uso de baterías "
"ligeras en herramientas que de otro modo no podrían."

#: lang/json/TOOLMOD_from_json.py
msgid "medium battery mod"
msgid_plural "medium battery mods"
msgstr[0] "mod de batería media"
msgstr[1] "mods de batería media"

#. ~ Description for medium battery mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"A battery compartment mod that allows the use of medium batteries in tools "
"that otherwise could not."
msgstr ""
"Un mod de compartimento de baterías que permite el uso de baterías medianas "
"en herramientas que de otra manera no podrían."

#: lang/json/TOOLMOD_from_json.py
msgid "heavy battery mod"
msgid_plural "heavy battery mods"
msgstr[0] "mod de batería pesada"
msgstr[1] "mods de batería pesada"

#. ~ Description for heavy battery mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"A battery compartment mod that allows the use of heavy batteries in tools "
"that otherwise could not."
msgstr ""
"Un compartimento de baterías mod que permite el uso de baterías pesadas en "
"herramientas que de otra manera no podrían."

#: lang/json/TOOLMOD_from_json.py
msgid "cybernetic power port mod"
msgid_plural "cybernetic power port mods"
msgstr[0] "mod de puerto de energía cibernética"
msgstr[1] "mods de puerto de energía cibernética"

#. ~ Description for cybernetic power port mod
#: lang/json/TOOLMOD_from_json.py
msgid ""
"This device replaces standard power connections and battery ports for "
"electronic devices with a carefully-shaped port that hooks into bionic "
"implants.  When applied, it will convert an item to run directly off of "
"bionic power."
msgstr ""
"Este dispositivo sustituye las conexiones de alimentación estándar y los "
"puertos de batería para dispositivos electrónicos por un puerto de forma "
"cuidadosa que se engancha a los implantes biónicos. Cuando se aplique, "
"convertirá un artículo para que funcione directamente con energía biónica."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "travel wallet"
msgid_plural "travel wallets"
msgstr[0] "cartera de viaje"
msgstr[1] "carteras de viaje"

#. ~ Description for travel wallet
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A flat case with neck strap used to carry items such as currency, "
"identification documents, laminated cards, and other small items."
msgstr ""
"Una caja plana con correa usada para llevar objetos como dinero, documentos "
"de identificación, tarjetas laminadas y otras cosas pequeñas."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "lanyard"
msgid_plural "lanyards"
msgstr[0] "acollador"
msgstr[1] "acolladores"

#. ~ Description for lanyard
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A flat clear plastic sleeve for identification documents, laminated cards, "
"and other small items.  It has a neck strap attached."
msgstr ""
"Una funda plana de plástico transparente para documentos de identidad, "
"tarjetas plastificadas y otros objetos pequeños. Lleva una correa para el "
"cuello."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "quantum solar backpack (folded)"
msgid_plural "quantum solar backpacks (folded)"
msgstr[0] "mochila solar de quántum (plegada)"
msgstr[1] "mochilas solares de quántum (plegadas)"

#. ~ Description for quantum solar backpack (folded)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"Personal portable charging system consisting of an array of quantum solar "
"panels neatly folded in a form of a large backpack.  It can be worn as one, "
"and has an integrated cable to plug it into a cable charger system.  Cutting"
" edge technology."
msgstr ""
"Sistema de carga portátil personal que consiste en un conjunto de paneles "
"solares cuánticos cuidadosamente plegados en forma de una gran mochila. Se "
"puede llevar como uno solo, y tiene un cable integrado para conectarlo a un "
"sistema de cargador de cable. Tecnología punta."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "quantum solar backpack (unfolded)"
msgid_plural "quantum solar backpacks (unfolded)"
msgstr[0] "mochila solar cuántica (desplegada)"
msgstr[1] "mochilas solares cuánticas (desplegadas)"

#. ~ Description for quantum solar backpack (unfolded)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"Unfolded array of portable quantum solar panels ready to push some power "
"into an active cable charger system."
msgstr ""
"Son varios paneles solares de quántum portátiles desplegados, listos para "
"generar energía para algún sistema de recarga."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "mining helmet"
msgid_plural "mining helmets"
msgstr[0] "casco de minero"
msgstr[1] "cascos de minero"

#. ~ Use action msg for mining helmet.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You turn the helmet on."
msgstr "Enciendes la luz del casco."

#. ~ Use action need_charges_msg for mining helmet.
#. ~ Use action need_charges_msg for military flight helmet.
#. ~ Use action need_charges_msg for hazardous environment helmet.
#. ~ Use action need_charges_msg for CRIT helmet (off).
#: lang/json/TOOL_ARMOR_from_json.py
msgid "The helmet's batteries are dead."
msgstr "La batería del casco está descargada."

#. ~ Description for mining helmet
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a mining helmet with a heavy-duty LED flashlight.  Using this will "
"turn the flashlight on and provide light, assuming it is charged with "
"batteries."
msgstr ""
"Este es un casco de minería con una linterna LED de alta potencia. Usar esto"
" encenderá la linterna y proporcionará luz, suponiendo que esté cargada con "
"baterías."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "mining helmet (on)"
msgid_plural "mining helmets (on)"
msgstr[0] "casco de minero (encendido)"
msgstr[1] "cascos de minero (encendidos)"

#. ~ Use action menu_text for mining helmet (on).
#. ~ Use action menu_text for pair of thermal electric socks (on).
#. ~ Use action menu_text for thermal electric suit (on).
