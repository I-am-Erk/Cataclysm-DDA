msgstr[1] "guanteletes de golpeo"

#. ~ Description for gauntlet of pounding
#: lang/json/GENERIC_from_json.py
msgid ""
"A large gleaming metal gauntlet covered in magical symbols that allows you "
"to land astoundingly powerful blows."
msgstr ""
"Un gran guantelete de metal reluciente cubierto de símbolos mágicos que "
"permite asestar golpes asombrosamente poderosos."

#: lang/json/GENERIC_from_json.py
