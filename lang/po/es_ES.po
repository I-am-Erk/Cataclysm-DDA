#. ~ Name for scenario 'The Sweet Life' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "The Sweet Life"
msgstr "La dulce vida"

#. ~ Name for scenario 'The Sweet Life' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "The Sweet Life"
msgstr "La dulce vida"

#. ~ Description for scenario 'The Sweet Life' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You open your eyes as if for the first time.  Looking at yourself, you can "
"see your skin glisten in the light.  One word come to your mind \"sugar\" "
"you don't remember where you learned it, and in fact you don't seem to "
"remember anything.  Despite the circumstances, you feel quite hopeful.  "
"Everything feels new and you're going to make the best of it!"
msgstr ""
"Abres tus ojos como por primera vez. Viéndote a ti mismo, puedes ver tu piel"
" resplandecer bajo la luz. Una palabra viene a tu mente \"azúcar\" y no "
"recuerdas donde la aprendiste, de hecho, no pareces recordar nada. A pesar "
"de la situación, te sientes esperanzado. Todo se siente nuevo, ¡y vas a "
"aprovecharlo al máximo!"

#. ~ Description for scenario 'The Sweet Life' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
msgid ""
"You open your eyes as if for the first time.  Looking at yourself, you can "
"see your skin glisten in the light.  One word come to your mind \"sugar\" "
"you don't remember where you learned it, and in fact you don't seem to "
"remember anything.  Despite the circumstances, you feel quite hopeful.  "
"Everything feels new and you're going to make the best of it!"
msgstr ""
"Abres tus ojos como por primera vez. Viéndote a ti misma, puedes ver tu piel"
" resplandecer bajo la luz. Una palabra viene a tu mente \"azúcar\" y no "
"recuerdas donde la aprendiste, de hecho, no pareces recordar nada. A pesar "
"de la situación, te sientes esperanzada. Todo se siente nuevo, ¡y vas a "
"aprovecharlo al máximo!"

