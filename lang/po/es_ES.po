#: lang/json/dream_from_json.py
msgid ""
"You have a strange dream about being a patient in a frightening hospital."
msgstr ""
"Tienes un extraño sueño acerca de ser paciente en un hospital terrorífico."

#: lang/json/dream_from_json.py
msgid "Your dreams give you an oddly medicated feeling."
msgstr "Tus sueños te dan una sensación rara sobre medicación."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about birds."
msgstr "Tienes un extraño sueño con pájaros."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange feathered feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación emplumada."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about fish."
msgstr "Tienes un extraño sueño con peces."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange wet, scaly feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación húmeda y escamosa."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about animals."
msgstr "Tienes un extraño sueño con animales."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange furry feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación peluda."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about bears."
msgstr "Tienes un extraño sueño con osos."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a rough furry feeling."
msgstr "Tus sueños te hacen sentir una sensación peluda y áspera."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about cats."
msgstr "Tienes un extraño sueño con gatos."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a sleek furry feeling."
msgstr "Tus sueños te hacen sentir una sensación peluda y lisa."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about wolves."
msgstr "Tienes un extraño sueño con lobos."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a thick furry feeling."
msgstr "Tus sueños te hacen sentir una sensación peluda y gruesa."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about cattle."
msgstr "Tienes un extraño sueño con ganado."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange content, furry feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación peluda y contenta."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about insects."
msgstr "Tienes un extraño sueño con insectos."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange chitinous feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación quitinosa."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about plants."
msgstr "Tienes un extraño sueño con plantas."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange plantlike feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación vegetal."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about slime."
msgstr "Tienes un extraño sueño con slimes."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange slimy feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación de slime."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about living in a cave."
msgstr "Tienes un extraño sueño acerca de vivir en una cueva."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange reclusive feeling."
msgstr "Tus sueños te dan un extraño sentimiento de soledad."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about sea creatures."
msgstr "Tienes un extraño sueño con criaturas marinas."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange wet feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación húmeda."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about spiders."
msgstr "Tienes un extraño sueño con arañas."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange webbed feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación telarañosa."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about rats."
msgstr "Tienes un extraño sueño con ratas."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange fuzzy feeling."
msgstr "Tus sueños te hacen sentir una extraña sensación peluda y rizada."

#: lang/json/dream_from_json.py
msgid "You have a strange dream."
msgstr "Tienes un extraño sueño."

#: lang/json/dream_from_json.py
msgid "You feel… OK."
msgstr "Te sientes... bien. "

#: lang/json/dream_from_json.py
msgid "You have a puckish dream."
msgstr "Tienes un sueño muy especial."

#: lang/json/dream_from_json.py
msgid "You dream of the changeling.  Again."
msgstr "Sueñas con el cambiante. Otra vez."

#: lang/json/dream_from_json.py
msgid "You feel a yearning…"
msgstr "Sientes un anhelo..."

#: lang/json/dream_from_json.py
msgid "You dream about the zoo, for some reason."
msgstr "Sueñas con el zoológico, por alguna razón."

#: lang/json/dream_from_json.py
msgid "Your dreams… are complex and multifaceted."
msgstr "Tus sueños... son complejos y multifacéticos."

#: lang/json/dream_from_json.py
msgid "You dream of the tropics."
msgstr "Sueñas con el trópico."

#: lang/json/dream_from_json.py
msgid "You feel warm."
msgstr "Sientes calor."

#: lang/json/dream_from_json.py
msgid "You dream of a massive block of cheese bigger than you."
msgstr "Sueñas con un enorme bloque de queso más grande que tú."

#: lang/json/dream_from_json.py
msgid "You dream of being cozy in a dark place."
msgstr "Sueñas con ser cómodo en un lugar oscuro."

#: lang/json/dream_from_json.py
msgid "You dream of a strange quest for a bush that grows gray apples."
msgstr ""
"Sueñas con una misión extraña en búsqueda de un arbusto del que crecen "
"manzanas grises."

#: lang/json/dream_from_json.py
msgid "You feel like you're cracking a combination lock."
msgstr "Te sientes como si estuvieras abriendo una cerradura con combinación."

#: lang/json/dream_from_json.py
msgid "Red, blue, and yellow cancel each other out, don't they?"
msgstr "Rojo, azul y amarillo se cancelan entre ellos, ¿verdad?"

#: lang/json/dream_from_json.py
msgid "Red, blue, and yellow add together, don't they?"
msgstr "Rojo, azul y amarillo se añaden entre ellos, ¿verdad?"

#: lang/json/dream_from_json.py
msgid "You have a disturbing dream of bathing in the sun on a rock."
msgstr ""
"Tienes un sueño perturbador acerca de tomar sol acostado en una piedra."

#: lang/json/dream_from_json.py
msgid ""
"While dreaming, you see a distinctively lizard-like reflection of yourself."
msgstr ""
"Mientras sueñas, ves un reflejo de ti mismo pero con apariencia de lagarto."

#: lang/json/dream_from_json.py
msgid "You have a disturbing dream of undergoing strange medical procedures."
msgstr ""
"Tienes un sueño perturbador de ser sometido a extraños procedimientos "
"médicos."

#: lang/json/dream_from_json.py
msgid ""
"While dreaming, you see yourself dressed in a hospital gown, receiving "
"treatment."
msgstr ""
"Mientras sueñas, te ves a ti mismo vestido con una bata de hospital, "
"recibiendo tratamiento."

#: lang/json/dream_from_json.py
msgid "You have strange dreams of soaring through the sky."
msgstr "Tienes extraños sueños acerca de planear por el cielo."

#: lang/json/dream_from_json.py
msgid "In a dream, you see a curiously birdlike reflection of yourself."
msgstr ""
"En un sueño, ves un reflejo de ti mismo con una curiosa apariencia de "
"pájaro."

#: lang/json/dream_from_json.py
msgid "You dream of swimming in the open ocean"
msgstr "Tienes un sueño acerca de nadar en mar abierto."

#: lang/json/dream_from_json.py
msgid "In your dream, you see a strangely fishlike image of yourself."
msgstr "En tu sueño, ves una imagen tuya con una extraña apariencia de pez."

#: lang/json/dream_from_json.py
msgid "You have a vivid dream of hunting in the woods."
msgstr "Tienes un sueño vívido de estar cazando en el bosque."

#: lang/json/dream_from_json.py
msgid "Whilst dreaming, you see a disturbingly bestial version of yourself."
msgstr ""
"Mientras sueñas, ves una versión perturbadoramente bestial de ti mismo."

#: lang/json/dream_from_json.py
msgid "You dream of foraging in the woods… mouth-first?"
msgstr "¿Sueñas con buscar comida en el bosque... con la boca primero?"

#: lang/json/dream_from_json.py
msgid "Your dream-reflection is rather bearish."
msgstr "En tu sueño, tu reflejo es más bien el de un oso."

#: lang/json/dream_from_json.py
msgid "You easily bound from the street to a roof..oh, only a dream."
msgstr ""
"Y fácilmente saltás desde la calle hasta el techo... ah, estás soñando."

#: lang/json/dream_from_json.py
msgid "As you dream, your reflection looks rather catlike."
msgstr "En tu sueño, tu reflejo tiene una apariencia felina."

#: lang/json/dream_from_json.py
msgid "You have a disturbing dream of someone invading your territory."
msgstr ""
"Tienes un sueño perturbador acerca de alguien que invade tu territorio."

#: lang/json/dream_from_json.py
msgid "Your dream-self's muzzle looks… wait, muzzle?"
msgstr "El bozal de tu yo de ensueño parece... espera, ¿bozal?"

#: lang/json/dream_from_json.py
msgid "You dream of grazing in an open field."
msgstr "Sueñas con estar pastoreando en el campo."

#: lang/json/dream_from_json.py
msgid ""
"In a dream you catch a glimpse of a strangely cattle-like image of yourself."
msgstr ""
"En un sueño, ves un destello de tu propia imagen con una apariencia que "
"recuerda al ganado."

#: lang/json/dream_from_json.py
msgid "You have a dream of working in a hive."
msgstr "Tienes un sueño acerca de trabajar en un panal."

#: lang/json/dream_from_json.py
msgid ""
"While dreaming you look into a mirror and see a frighteningly insectoid "
"reflection."
msgstr ""
"Mientras sueñas, miras el espejo y ves un aterrador reflejo insectoide."

#: lang/json/dream_from_json.py
msgid "You have a confusing dream of growing in a garden."
msgstr "Tienes un confuso sueño acerca de crecer en un jardín."

#: lang/json/dream_from_json.py
msgid "You are confused by a plantlike image of yourself in a dream."
msgstr ""
"Estás confundido con la imagen similar a una planta que tuviste de ti mismo "
"en un sueño."

#: lang/json/dream_from_json.py
msgid "You have a strange dream of living in sludge."
msgstr "Tienes un extraño sueño acerca de vivir en el cieno."

#: lang/json/dream_from_json.py
msgid "In your dream you see an odd, slimy reflection of yourself."
msgstr "En tu sueño ves un raro reflejo viscos de ti mismo."

#: lang/json/dream_from_json.py
msgid "You dream of living deep inside a dark cave."
msgstr "Sueñas con estar viviendo en lo profundo de una oscura cueva."

#: lang/json/dream_from_json.py
msgid ""
"You dream you crawl out from under a rock.  And then immediately crawl back "
"in."
msgstr ""
"Sueñas que sales arrastrándote de debajo de una piedra. Y luego vuelves a "
"arrastrarte inmediatamente."

#: lang/json/dream_from_json.py
msgid "You dream of being a primitive cave dweller."
msgstr "Sueñas con ser un primitivo habitante de una cueva."

#: lang/json/dream_from_json.py
msgid "You dream of living on the ocean floor."
msgstr "Sueñas con vivir en el fondo del océano."

#: lang/json/dream_from_json.py
msgid ""
"While dreaming, a reflection of yourself appears almost like an octopus."
msgstr "Mientras sueñas, un reflejo de ti mismo parece casi un pulpo."

#: lang/json/dream_from_json.py
msgid "You have a strange dream of spinning webs"
msgstr "Tienes un extraño sueño acerca de tejer telarañas."

#: lang/json/dream_from_json.py
msgid "In your dream you see a very spiderlike version of yourself."
msgstr "En tu sueño ves una versión de ti mismo muy similar a una araña."

#: lang/json/dream_from_json.py
msgid "You vividly dream of living in the sewers."
msgstr "Sueñas vívidamente acerca de vivir en las cloacas."

#: lang/json/dream_from_json.py
msgid "In your dream you see a group of rats that look almost like yourself."
msgstr "En tu sueño ves un grupo de ratas que son muy similares a ti mismo."

#: lang/json/dream_from_json.py
msgid ""
"You dream of having that success you knew you deserved, back before all "
"this."
msgstr ""
"Sueñas con tener el éxito que sabes que te mereces, antes de que pase todo "
"esto."

#: lang/json/dream_from_json.py
msgid "Your dream-self looks competent and in control."
msgstr "La versión de tu persona en el sueño parece competente y en control."

#: lang/json/dream_from_json.py
msgid "You dream of a home in the forests."
msgstr "Sueñas con un hogar en los bosques."

#: lang/json/dream_from_json.py
msgid "You dream you are lithe in the sunlight and radiant with grace."
msgstr ""
"Sueñas que eres flexible a la luz del sol y que estás radiante con gracia."

#: lang/json/dream_from_json.py
msgid "You feel beautiful, and yet riven with worry…"
msgstr "Te sientes hermosa, y a la vez desgarrada por la preocupación..."

#: lang/json/dream_from_json.py
msgid ""
"You can't quite work out what the dream is about… it just keeps changing."
msgstr ""
"El hocico de tu sueño parece... espera, ¿hocico? No puedes saber de qué se "
"trata el sueño... sigue cambiando."

#: lang/json/dream_from_json.py
msgid "Your dream is filled with creatures, and yet all seem like you."
msgstr "Tu sueño está repleto de criaturas, y todas se parecen a ti."

#: lang/json/dream_from_json.py
msgid ""
"You dream of stalking some sort of lizard… no, that can't be right, can it?"
msgstr ""
"Sueñas con acechar a algún tipo de lagarto... no, eso no puede estar bien, "
"¿verdad?"

#: lang/json/dream_from_json.py
msgid ""
"For some reason you dream of your shoes.  They don't fit, and nothing seems "
"to help…"
msgstr ""
"Por alguna razón sueñas con tus zapatos. No te quedan bien, y nada parece "
"ayudar..."

#: lang/json/dream_from_json.py
msgid "You dream of… sneaking."
msgstr "Sueñas con... escabullirte."

#: lang/json/dream_from_json.py
msgid "You dream of a cold winter night.  Your jacket is too big to put on."
msgstr ""
"Sueñas con una fría noche de invierno. Tu chaqueta es demasiado grande para "
"ponértela."

#: lang/json/dream_from_json.py
msgid "You are terrified by a dream of becoming a lizard hybrid."
msgstr ""
"Estás aterrado por un sueño en el que te convertías en un híbrido de "
"lagarto."

#: lang/json/dream_from_json.py
msgid "You have a disturbingly lifelike dream of living as a lizard."
msgstr "Tienes un perturbador sueño vívido acerca de vivir como un lagarto."

#: lang/json/dream_from_json.py
msgid ""
"You have a dream of doctors and nurses doing unnatural things to your body, "
"which brings you perverse pleasure."
msgstr ""
"Sueñas con doctores y enfermeras haciendo cosas antinaturales en tu cuerpo, "
"lo que te causa un placer perverso."

#: lang/json/dream_from_json.py
msgid ""
"You have a vivid dream of being a medical anomaly, as your heartbeat syncs "
"with the steady drip of an IV line."
msgstr ""
"Tienes un sueño vívido acerca de ser una anomalía médica, mientras los "
"latidos de tu corazón se sincronizan con el goteo constante de la vía "
"intravenosa."

#: lang/json/dream_from_json.py
msgid ""
"You have a realistic dream of flying south with your flock for the winter."
msgstr ""
"Tienes un sueño muy real acerca de volar al sur con tu bandada durante el "
"invierno."

#: lang/json/dream_from_json.py
msgid ""
"You are disturbed when your birdlike dreams are more lifelike than reality."
msgstr ""
"Estás perturbado porque tus sueños de pájaro se sienten más reales que la "
"realidad."

#: lang/json/dream_from_json.py
msgid "You have a disturbing dream of swimming with a school of fish."
msgstr "Tienes un sueño perturbador acerca de nadar con un banco de peces."

#: lang/json/dream_from_json.py
msgid "When you wake up you panic about drowning from being out of water."
msgstr ""
"Cuando te despiertas, sientes pánico por el miedo de ahogarte al estar fuera"
" del agua."

#: lang/json/dream_from_json.py
msgid "You vividly dream of running with your pack, hunting a wild animal."
msgstr ""
"Sueñas vívidamente acerca de correr con tu manada, cazando algún animal "
"salvaje."

#: lang/json/dream_from_json.py
msgid "A terrifyingly real dream has you killing game with your bare teeth."
msgstr ""
"Tienes un sueño terriblemente real en el que cazás animales solamente con "
"tus dientes."

#: lang/json/dream_from_json.py
msgid ""
"Your dream of raiding a giant beehive has you licking your… muzzle in "
"anticipation."
msgstr ""
"Tu sueño de asaltar una colmena gigante te hace lamer tu... hocico con "
"anticipación."

#: lang/json/dream_from_json.py
msgid ""
"In your dream, you stalk and kill a young wolf, using only your teeth and "
"claws."
msgstr ""
"En tu sueño, acechás y matas a un lobo cachorro, usando solo tus dientes y "
"garras."

#: lang/json/dream_from_json.py
msgid ""
"A warm, sunny spot high up where you can watch your prey.  What a great "
"dream!"
msgstr ""
"Un lugar alto, soleado y templado, desde donde puedes lanzarte a cazar tu "
"presa. ¡Qué buen sueño!"

#: lang/json/dream_from_json.py
msgid "You dream of pursuing and killing a rat, for some reason."
msgstr "Sueñas con perseguir y matar una rata, por alguna razón."

#: lang/json/dream_from_json.py
msgid "You dream of tearing into a fresh kill."
msgstr "Sueñas con lograr ferozmente una nueva caza."

#: lang/json/dream_from_json.py
msgid "You dream of finally finding the perfect place to make your den."
msgstr ""
"Sueñas acerca de encontrar finalmente el lugar perfecto para construir tu "
"madriguera."

#: lang/json/dream_from_json.py
msgid "You terrifyingly dream of being led to a slaughterhouse by a farmer."
msgstr ""
"Tienes un sueño aterrador acerca de ser llevado al matadero por un granjero."

#: lang/json/dream_from_json.py
msgid "You find it hard to wake from a vivid dream of grazing on a farm."
msgstr ""
"Te cuesta despertarte de un sueño vívido acerca de pastorear en una granja."

#: lang/json/dream_from_json.py
msgid "You are terrified by a dream of serving the hive queen mindlessly."
msgstr ""
"Estás aterrorizado por un sueño acerca de fecundar a la reina del panal una "
"y otra vez."

#: lang/json/dream_from_json.py
msgid "Your disturbingly lifelike dream has you pollinating plants."
msgstr "Tienes un perturbador sueño vívido acerca de polinizar plantas."

#: lang/json/dream_from_json.py
msgid "You have a confusing and scary dream of becoming a plant."
msgstr "Tienes un confuso y aterrador sueño acerca de convertirte en planta."

#: lang/json/dream_from_json.py
msgid ""
"The transition from your lifelike dreams of living as a plant to reality "
"shocks you."
msgstr ""
"La transición desde tus sueños vívidos acerca de vivir como una planta, a la"
" vida real te conmociona."

#: lang/json/dream_from_json.py
msgid "Your vivid dream of living as a slime blob frightens you."
msgstr ""
"Te aterra tu sueño vívido acerca de vivir como un monstruo masa amorfa "
"gelatinosa viscoso."

#: lang/json/dream_from_json.py
msgid ""
"You find it hard to control your limbs after dreaming of amorphous blob "
"life."
msgstr ""
"Te cuesta controlar tus miembros después de haber soñado con ser un monstruo"
" masa amorfa gelatinosa."

#: lang/json/dream_from_json.py
msgid "Your dream of living in the dark for years is almost real."
msgstr ""
"Tu sueño acerca de vivir en la oscuridad por años, casi se siente real."

#: lang/json/dream_from_json.py
msgid "You are frightened of the outside after your vivid dream of cave life."
msgstr ""
"Estás aterrado de salir al exterior después de tu sueño vívido acerca de "
"vivir en una cueva."

#: lang/json/dream_from_json.py
msgid ""
"Your dreams of living on the ocean floor seem more lifelike than reality."
msgstr ""
"Tus sueños acerca de vivir en el fondo del océano parecen más reales que la "
"misma realidad."

#: lang/json/dream_from_json.py
msgid "You dream of living as a terrifying octopus mutant."
msgstr "Sueñas con vivir como un aterrador pulpo mutante."

#: lang/json/dream_from_json.py
msgid "You vividly dream of living in a web and consuming insects."
msgstr ""
"Sueñas vívidamente acerca de vivir en una telaraña, consumiendo insectos."

#: lang/json/dream_from_json.py
msgid "Your dreams of fully turning into a spider frighten you."
msgstr ""
"Tus sueños acerca de convertirte completamente en una araña te aterran."

#: lang/json/dream_from_json.py
msgid "You scream in fear while you dream of being chased by a cat"
msgstr "Gritas de miedo mientras sueñas con ser perseguido por un gato."

#: lang/json/dream_from_json.py
msgid "Your lifelike dreams have you scavenging food with a pack of rats."
msgstr "Tus sueños vívidos son acerca de buscar comida con un grupo de ratas."

#: lang/json/dream_from_json.py
msgid ""
"You see yourself, five years from now, as the leader of a successful city."
msgstr ""
"Te ves a ti mismo, dentro de cinco años, como líder de una ciudad exitosa."

#: lang/json/dream_from_json.py
msgid "Your success in restoring civilization was only a dream.  For now."
msgstr "Tu éxito en recuperar la civilización era solo un sueño. Por ahora."

#: lang/json/dream_from_json.py
msgid "NO!  You will not allow this corruption to prevail!"
msgstr "¡NO! ¡No vas a permitir que esta corrupción de la tierra prevalezca!"

#: lang/json/dream_from_json.py
msgid "You see yourself reflected in the beauty of the forest."
msgstr "Te ves a ti mismo reflejado en la belleza del bosque."

#: lang/json/dream_from_json.py
msgid "In your sleep you feel verdant energy growing within you."
msgstr "En tu sueño sientes que la energía verde crece en tu interior."

#: lang/json/dream_from_json.py
msgid "You dream of the hunt to end all hunts."
msgstr "Sueñas con la caza que acabará con todas las cazas."

#: lang/json/dream_from_json.py
msgid "You are many animals, and yet one."
msgstr "Eres muchos animales, y aun así, ninguno."

#: lang/json/dream_from_json.py
msgid ""
"You swim with fish.  You fly with birds.  You run with the beasts of the "
"land.  You change with the changing of seasons.  You are everything."
msgstr ""
"Nadas con los peces. Vuelas con los pájaros. Corres con las bestias de la "
"tierra. Cambias con el cambio de las estaciones. Lo eres todo."

#: lang/json/dream_from_json.py
msgid "Hoof.  Talon.  Tooth.  Fight.  Feed.  Forward."
msgstr "Pezuña. Garra. Diente. Lucha. Comer. Avanzar."

#: lang/json/dream_from_json.py
msgid "You've never felt so lithe and powerful."
msgstr "Nunca te habías sentido tan ágil y poderoso."

#: lang/json/dream_from_json.py
msgid ""
"After an exciting and tasty hunt, you retire to your nest.  Mmm, yes, nest."
msgstr ""
"Después de una caza sabrosa y excitante, te volvés a tu madriguera. Mmm, sí,"
" madriguera."

#: lang/json/dream_from_json.py
msgid ""
"You weave between the zombies' legs, too small for them to catch.  The gas "
"station isn't far now, with all its soda and chips and- UGH, dream…"
msgstr ""
"Te mueves entre las piernas de los zombis, demasiado pequeño para que te "
"atrapen. La gasolinera ya no está lejos, con sus refrescos y patatas fritas "
"y- UGH, sueño..."

#: lang/json/dream_from_json.py
msgid ""
"Once you finish your tasty dinner of seeds, you look around for your drink, "
"but you already ate it."
msgstr ""
"Una vez que terminaste con tu sabrosa cena de semillas, buscás algo para "
"tomar pero ya te lo comiste."

#: lang/json/dream_from_json.py
msgid "You are terrified by a dream of becoming an ape hybrid."
msgstr ""
"Estás aterrado por un sueño acerca de convertirte en un híbrido de simio."

#: lang/json/dream_from_json.py
msgid "You blissfully recall days spent lounging in the sun."
msgstr "Recordás felizmente aquellos días que pasabas recostado al sol."

#: lang/json/dream_from_json.py
msgid ""
"You dream of your legions of undead admirers, their attentions, and the "
"wonderful pain."
msgstr ""
"Sueñas con tus legiones de admiradores de muertos vivientes, sus atenciones,"
" y el maravilloso dolor."

#: lang/json/dream_from_json.py
msgid "You wonder if your nest will be good enough."
msgstr "Te preguntás si tu madriguera será suficientemente buena."

#: lang/json/dream_from_json.py
msgid ""
"Your dream of soaring over the landscape becomes a nightmare when you find "
"yourself with arms and a glider!"
msgstr ""
"¡Tu sueño acerca de estar planeando sobre el paisaje se convierte en una "
"pesadilla cuando e encuentras con brazos y un ala delta!"

#: lang/json/dream_from_json.py
msgid "You have a comforting dream of swimming with a school of fish."
msgstr "Tienes un sueño confortable acerca de nadar con un banco de peces."

#: lang/json/dream_from_json.py
msgid ""
"The thought of being out of water, forced to crawl unsupported, terrifies "
"you."
msgstr ""
"El pensamiento de estar fuera del agua, forzado a arrastrarte sin soporte, "
"te aterra."

#: lang/json/dream_from_json.py
msgid "You vividly dream of sharing a kill with your pack."
msgstr "Sueñas vívidamente acerca de compartir una presa con tu manada."

#: lang/json/dream_from_json.py
msgid "A fond memory of throating some prey animal bubbles up."
msgstr ""
"Un recuerdo agradable de tragar algún animal que cazaste se te asoma por la "
"garganta."

#: lang/json/dream_from_json.py
msgid ""
"You wonder if you could find one of those 'salmon runs', or if they were "
"just a legend…"
msgstr ""
"Uno se pregunta si podría encontrar una de esas \"carreras de salmones\", o "
"si eran sólo una leyenda..."

#: lang/json/dream_from_json.py
msgid "Ah, the wolf-slaying dream again.  That's a good one…"
msgstr "Oh, otra vez el sueño acerca de matar al lobo. Ese es uno bueno..."

#: lang/json/dream_from_json.py
msgid "Boing!  and you've pounced another yummy critter."
msgstr "¡Boing! y se te abalanzó otro bicho yummy."

#: lang/json/dream_from_json.py
msgid ""
"Your nightmare of sentient rats turns successful, as you grab their King and"
" shake it apart!"
msgstr ""
"Tu pesadilla acerca de ratas sentientes ha sido un éxito, ¡mientras agarras "
"a su Rey y lo destrozas!"

#: lang/json/dream_from_json.py
msgid "You dream of the hunt, the feed, and your pack."
msgstr "Sueñas con la caza, el alimento y tu manada."

#: lang/json/dream_from_json.py
msgid ""
"You lead the pack on a glorious hunt, knowing that they will all have your "
"back as you have theirs!"
msgstr ""
"Diriges la manada en una gloriosa cacería, sabiendo que todos ellos te "
"cubrirán la espalda como tú a ellos."

#: lang/json/dream_from_json.py
msgid "Oh, you should really patrol your territory again, maybe expand."
msgstr "Ah, deberías patrullar tu territorio otra vez, y tal vez expandirlo."

#: lang/json/dream_from_json.py
msgid "You dream of jumping the gate and leading your herd to freedom."
msgstr "Sueñas con saltar la cerca y liderar a tu manada hacia la libertad."

#: lang/json/dream_from_json.py
msgid ""
"You belllow on a knoll against the sky, having feasted on the apple time "
"cider."
msgstr ""
"Te acuestas en una loma contra el cielo, después de haberte dado un festín "
"con la sidra del tiempo de las manzanas."

#: lang/json/dream_from_json.py
msgid "The herd moves along and you with them, finding greener pastures."
msgstr "La manada se traslada y tú entre ellos, buscando pasturas más verdes."

#: lang/json/dream_from_json.py
msgid "You feel smug, knowing that the Queen is dependent on you."
msgstr "Te sientes engreído, sabiendo que la Reina depende de ti."

#: lang/json/dream_from_json.py
msgid "You relax and enjoy the humming adulation of all your followers."
msgstr ""
"Te relajas y disfrutas del murmullo de adulación de todos tus seguidores."

#: lang/json/dream_from_json.py
msgid ""
"You dream of a weirdly shaped plant, whose nectar surpassed your every wish…"
msgstr ""
"Sueñas con una planta de forma extraña, cuyo néctar supera cualquiera de tus"
" deseos..."

#: lang/json/dream_from_json.py
msgid "You dream of bees fighting over your sweet nectar.  Mmm."
msgstr "Sueñas con abejas luchando por tu dulce néctar. Mmm."

#: lang/json/dream_from_json.py
msgid ""
"How grand it would be to sink your roots deep into the soil as the seasons "
"pass you by."
msgstr ""
"Qué grandioso sería hundir tus raíces profundamente en el suelo a medida que"
" las estaciones pasan."

#: lang/json/dream_from_json.py
msgid "You dream of a gigantic knot of roots, beating like a heart."
msgstr "Sueñas con un gigantesco nudo de raíces, que late como un corazón."

#: lang/json/dream_from_json.py
msgid "You have a disturbing dream of termites chewing all over your body."
msgstr "Tienes un sueño perturbador de termitas masticando todo tu cuerpo."

#: lang/json/dream_from_json.py
msgid ""
"You dream of sharing your roots with a vast forest, all plants provided for "
"as the canopy grows ever upwards."
msgstr ""
"Sueñas con compartir tus raíces con un vasto bosque, todas las plantas "
"provistas como el dosel crece siempre hacia arriba."

#: lang/json/dream_from_json.py
msgid "A family of caterpillars munches away at your leaves."
msgstr "Una familia de orugas mastica tus hojas."

#: lang/json/dream_from_json.py
msgid ""
"Fire rages around you, licking at your bark and engulfing the saplings and "
"bushes near your roots.  The once chatty forest is quiet in its wake."
msgstr ""
"El fuego ruge a tu alrededor, lamiendo tu corteza y engullendo los arbolitos"
" y arbustos cerca de tus raíces. El una vez parlanchín bosque esta sile en "
"su despertar."

#: lang/json/dream_from_json.py
msgid ""
"You dream of communing with an ancient pine.  Trees are the true survivors "
"of this world, it tells you."
msgstr ""
"Sueñas con estar en comunión con un antiguo pino. Los árboles son los "
"verdaderos supervivientes de este mundo, te lo dice."

#: lang/json/dream_from_json.py
msgid ""
"A rather attractive triffid offers you a bouquet of ape heads.  How "
"thoughtful!"
msgstr ""
"Un trífido bastante atractivo te ofrece un ramo de cabezas de mono. ¡Qué "
"considerado!"

#: lang/json/dream_from_json.py
msgid ""
"Your vivid dream of your pseudopods calcifying into rigid structures "
"terrifies you."
msgstr ""
"Tu sueño vívido acerca de tus pseudópodos calcificándose en estructuras "
"rígidas, te aterra."

#: lang/json/dream_from_json.py
msgid ""
"Ah, the painting-the-planet dream again.  Maybe if you assimilated more…"
msgstr ""
"Oh, otra vez el sueño de pintar el planeta. Tal vez si hubieras asimilado "
"más..."

#: lang/json/dream_from_json.py
msgid ""
"The years seem to fly past as you dream of carving great underground "
"fastnesses."
msgstr ""
"Los años parecen pasar volando mientras sueñas acerca de cavar una gran "
"fortaleza subterránea."

#: lang/json/dream_from_json.py
msgid "You have a horrible nightmare of being caught out in the sunlight."
msgstr ""
"Tienes una pesadilla horrible acerca de ser capturado por la luz del sol."

#: lang/json/dream_from_json.py
msgid "Mmm.  The shellfish dream again.  Yum!"
msgstr "Mmm. Otra vez el sueño de los moluscos. ¡Rico!"

#: lang/json/dream_from_json.py
msgid "You dream of recruiting a cult of fishfolk to serve your needs."
msgstr ""
"Sueñas con reclutar un culto de hombres-peces para que atiendan tus "
"necesidades."

#: lang/json/dream_from_json.py
msgid "You excitedly web up an interloper and prepare to feast… nope, dream."
msgstr ""
"Conmovedoramente tejes una red de intrusos y te preparas para el festín... "
"no, sueñas."

#: lang/json/dream_from_json.py
msgid ""
"You relax in your web; it's not vibrating, so dinner hasn't arrived yet."
msgstr ""
"Te relajas en tu telaraña; no está vibrando, así que la cena aún no ha "
"llegado."

#: lang/json/dream_from_json.py
msgid "Your dreams of having to live without a web frighten you."
msgstr "Tus sueños acerca de tener que vivir sin telaraña te aterran,"

#: lang/json/dream_from_json.py
msgid "The Fury is so big!  It's GONNA GET YOAAAAAH!  *pant* only a dream."
msgstr ""
"¡La Furia es tan grande! ¡Te VOY A COGER Y AAAAH ! *jadeas* sólo era un "
"sueño."

#: lang/json/dream_from_json.py
msgid "You find your paws twitching.  There's a cave.  You should go."
msgstr "Sientes que se te retuercen las garras. Hay una cueva. Deberías ir."

#: lang/json/dream_from_json.py
msgid ""
"You dream of the peaceful world you'll give humankind.  Because no one else "
"can."
msgstr ""
"Sueñas acerca del mundo pacífico que le darás a la humanidad. Porque ningún "
"otro podría hacerlo."

#: lang/json/dream_from_json.py
msgid ""
"You crush those who would disagree with the leadership.  Humanity must be "
"united; independence will get you all killed!"
msgstr ""
"Aplastas a los que no están de acuerdo con el liderazgo. La humanidad debe "
"estar unida; ¡la independencia hará que os maten a todos!"

#: lang/json/dream_from_json.py
msgid "There are underground Faults in the world.  Faults you should remedy."
msgstr ""
"Hay Fallas subterráneas en el mundo. Fallas que tú deberías solucionar."

#: lang/json/dream_from_json.py
msgid ""
"You pant, terrified at the thought of that FUNGUS destroying your home!"
msgstr ""
"Jadeás, aterrado por el pensamiento de ¡ese HONGO destrozando tu hogar!"

#: lang/json/dream_from_json.py
msgid "You wish others could understand, and join your struggle…"
msgstr "Te gustaría que otros pudieran entender, y unirse a tu lucha..."

#: lang/json/dream_from_json.py
msgid "Your body flows slightly faster than you expected… oh, just a dream."
msgstr ""
"Tu cuerpo fluye un poco más rápido de lo que esperabas... oh, sólo un sueño."

#: lang/json/dream_from_json.py
msgid "FIGHT.  FEED.  FORWARD."
msgstr "LUCHAR. COMER. AVANZAR."

#: lang/json/dream_from_json.py
msgid "Oh.  No, that 'rex' thing was only a myth."
msgstr "Ah. No, ese coso 'rex' era solo un mito."

#: lang/json/dream_from_json.py
msgid "You stir, saddened that your beautiful hatchlings were only a dream."
msgstr ""
"Te despiertas, entristecida porque tus hermosos retoños eran solo parte de "
"un sueño."

#: lang/json/dream_from_json.py
msgid ""
"You curl up some more in your nest.  Geez, shredded paper really *is* comfy."
msgstr ""
"Te acurrucas un poco más en tu nido. Caray, el papel triturado es muy "
"cómodo."

#: lang/json/dream_from_json.py
msgid "Oh boy!  This hidey hole sure is swell."
msgstr "¡Oh, Chico! Este escondite seguro que es genial."

#: lang/json/dream_from_json.py
msgid ""
"Once we finish the burrow we'll settle down and start a little family.  "
"Maybe just a dozen boys and a dozen girls.  Nice and cosy."
msgstr ""
"Una vez que terminemos la madriguera nos estableceremos y empezaremos una "
"pequeña familia. Tal vez sólo una docena de niños y una docena de niñas. "
"Agradable y acogedor."

#: lang/json/dream_from_json.py
msgid ""
"In your dreams, you blindly run through the pipes of the city, navigating "
"the familiar byways via smell alone."
msgstr ""
"En tus sueños, corres a ciegas por las tuberías de la ciudad, navegando por "
"las vías conocidas sólo a través del olfato."

#: lang/json/dream_from_json.py
msgid ""
"Sneaky sneak under the floorboards.  We will sneak all their crumbs for us."
"  But later, back to sleep for now."
msgstr ""
"Colarse a hurtadillas bajo las tablas del suelo. Vamos a colar todas sus "
"migajas para nosotros. Pero más tarde, de nuevo a dormir por ahora."

#: lang/json/dream_from_json.py
msgid ""
"You hear the sirens again, but this time you stay in your hole in the wall."
"  Nobody will think to look there!"
msgstr ""
"Oyes las sirenas de nuevo, pero esta vez te quedas en tu agujero en la "
"pared. ¡Nadie pensará en mirar allí!"

#: lang/json/dream_from_json.py
msgid "We have been waiting a long time for a place such as this."
msgstr "Hemos esperado mucho tiempo encontrar un lugar como este."

#: lang/json/dream_from_json.py
msgid "We will raise bountiful orchards and beautiful gardens."
msgstr "Crearemos abundantes huertos de árboles frutales y hermosos jardines."

#: lang/json/dream_from_json.py
msgid ""
"The walking plants seek to harness us as a food source.  We will not allow "
"that."
msgstr ""
"Las plantas caminantes quieren utilizarnos como su fuente de alimentación. "
"No vamos a permitir eso."

#: lang/json/dream_from_json.py
msgid ""
"Our colonists are limitless.  We shall adapt to this world, as we adapt to "
"all."
msgstr ""
"Nuestros colonizadores no tienen límites. Nos adaptaremos a este mundo, así "
"como nos adaptamos a todo."

#: lang/json/dream_from_json.py
msgid ""
"Non-Mycus sometimes reject the Marloss.  Our colonial efforts flourish with "
"broad-minded guidance."
msgstr ""
"Los No-Mycus a veces rechazan el Marloss. Nuestros esfuerzos coloniales "
"florecen guiando a los demás con mente abierta."

#: lang/json/dream_from_json.py
msgid ""
"The seething masses attempt to wall non-Mycus away from the Marloss.  We "
"will adapt and defeat them."
msgstr ""
"Las furiosas masas intenta levantar un muro para alejar a los No-Mycus del "
"Marloss. Nos adaptaremos y los derrotaremos."

#: lang/json/dream_from_json.py
msgid "You dream of warm, alien winds."
msgstr "Sueñas con vientos cálidos y alienígenas."

#: lang/json/dream_from_json.py
msgid "You dream of landscapes lit by the light of alien moons."
msgstr "Sueñas con paisajes iluminados por la luz de lunas alienígenas."

#: lang/json/dream_from_json.py
msgid ""
"You stand at the edge of a fissure into strange earth.  Mustard brown gasses"
" caress and lift your fronds"
msgstr ""
"Te encuentras al borde de una fisura en una tierra extraña. Los gases de "
"color marrón mostaza acarician y levantan tus frondas"

#: lang/json/dream_from_json.py
msgid ""
"You dream of being vivsected by humans.  One asks if the other thinks you "
"can feel pain."
msgstr ""
"Sueñas que los humanos te viviseccionan. Uno pregunta si el otro cree que "
"puedes sentir dolor."

#: lang/json/dream_from_json.py
msgid ""
"Trapped in a cage, you mimic the sounds of your guard's spawn.  He threatens"
" you and enters the cage.  He screams, you recall."
msgstr ""
"Atrapado en una jaula, imitas los sonidos del engendro de tu guardia. Te "
"amenaza y entra en la jaula. El grita, tu recuerdas."

#: lang/json/dream_from_json.py
msgid ""
"It's your birthday.  But everyone has given you these hideous metal and "
"plastic objects."
msgstr ""
"Es tu cumpleaños. Pero todo el mundo te ha regalado estos horribles objetos "
"de metal y plástico."

#: lang/json/dream_from_json.py
msgid ""
"The stars await you, your chariot of fire is ready.  The holds are full of "
"slaves."
msgstr ""
"Las estrellas te esperan, tu carro de fuego está listo. Las bodegas están "
"llenas de esclavos."

#: lang/json/dream_from_json.py
msgid "You have transitioned from a dying race to a glorious future."
msgstr "Has pasado de una raza moribunda a un futuro glorioso."

#: lang/json/dream_from_json.py
msgid ""
"You have a strange dream about thundering ponderously through ancient, "
"brittle tundras that crackle under your thick round feet."
msgstr ""
"Tienes un extraño sueño en el que atraviesas atronadoramente antiguas y "
"quebradizas tundras que crujen bajo tus gruesos y redondos pies."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a strange, langourous, heavy feeling."
msgstr "Tus sueños le producen una sensación extraña, lánguida y pesada."

#: lang/json/dream_from_json.py
msgid ""
"You dream of swinging your heavy head to shake the clinging snow and ice "
"from your large, limpid brown eyes.  The weight is off, as if you had "
"something… extra on either side of your mouth, and though you are surrounded"
" by snow and bitter pelting winds, you feel confident and toasty-warm "
"beneath your shaggy coat."
msgstr ""
"Sueñas con mover tu pesada cabeza para sacudir la nieve y el hielo de tus "
"grandes y límpidos ojos marrones. No tienes peso, como si tuvieras algo... "
"de más a ambos lados de la boca, y aunque estás rodeado de nieve y de "
"vientos amargos, te sientes confiado y calentito bajo tu peludo abrigo."

#: lang/json/dream_from_json.py
msgid ""
"Your dream is a stream of shaggy loam-brown fur trailing into an ocean of "
"punishing, icy white.  Together, you are all strong.  When you look around, "
"you see elephantine faces looking back from all angles and you know they "
"mirror your own.  You just… know."
msgstr ""
"Tu sueño es una corriente de pelaje desgreñado de color marrón marengo que "
"se adentra en un océano de blanco gélido. Juntos, todos sois fuertes. Cuando"
" miras a tu alrededor, ves rostros elefantiásicos que te miran desde todos "
"los ángulos y sabes que son un reflejo del tuyo. Simplemente... lo sabes."

#: lang/json/dream_from_json.py
msgid ""
"You dream of your usual patient languor being interrupted by a flash of "
"white teeth against a carmine-soaked muzzle.  In an instant a thunderous "
"fury overtakes you and you trumpet your rage… right before you bring that "
"trumpeting snout, bring down those heavy spears of ivory on either side of "
"it, down upon your attacker.  They lie, bones shattered, bleeding out their "
"red into the icy white and causing it to steam  Just like that, your calm is"
" restored."
msgstr ""
"Sueñas que tu paciente languidez habitual se ve interrumpida por un destello"
" de dientes blancos contra un hocico empapado de carmín. En un instante, una"
" furia atronadora se apodera de ti y haces sonar tu rabia... justo antes de "
"que ese hocico trompeado, haga caer esas pesadas lanzas de marfil a ambos "
"lados, sobre tu atacante. Yacen, con los huesos destrozados, desangrando su "
"rojo en el blanco gélido y haciendo que éste eche vapor. Así, tu calma se "
"restablece."

#: lang/json/dream_from_json.py
msgid ""
"You dream of slowly, patiently, plodding through the world to go from goal "
"to goal, unrushed and unworried, for you are far too large and tough to kill"
" for anyone or anything to bother trying to attack.  And if they do… it'll "
"be the last mistake of their life.  Waking up gives you a brief jolt of fear"
" and dysphoria, for your body feels so weak and fragile and incorrect "
"compared to the powerful thing you know you are."
msgstr ""
"Sueñas con avanzar lenta y pacientemente por el mundo para ir de objetivo en"
" objetivo, sin prisas ni preocupaciones, porque eres demasiado grande y duro"
" para matar como para que nadie ni nada se moleste en intentar atacarte. Y "
"si lo hacen... será el último error de su vida. El despertar te produce una "
"breve sacudida de miedo y disforia, ya que tu cuerpo se siente tan débil y "
"frágil e incorrecto comparado con lo poderoso que sabes que eres."

#: lang/json/dream_from_json.py
msgid ""
"Your thoughts within your dream may be slow, and it may take you some time "
"to reach a conclusion, but what's the rush?  What's the hurry?  You are a "
"huge and ancient thing with a pedigree that stretches back to a time before "
"sapient life first had the gall to raise a sharpened stick and call itself "
"superior.  You are huge and powerful and all that work against you shall "
"fall.  You… you have all the time in the world, now."
msgstr ""
"Puede que tus pensamientos dentro de tu sueño sean lentos, y que te lleve "
"algún tiempo llegar a una conclusión, pero ¿cuál es la prisa? ¿Cuál es la "
"prisa? Eres una cosa enorme y antigua con un pedigrí que se remonta a una "
"época anterior a que la vida sapiente tuviera el descaro de levantar un palo"
" afilado y llamarse superior. Eres enorme y poderoso y todo lo que trabaje "
"contra ti caerá. Tú... tienes todo el tiempo del mundo, ahora."

#: lang/json/dream_from_json.py
msgid ""
"Life is lonely without a family of Tusked Ones beside you, thundering as one"
" through this desolate world in search of the hidden places.  Perhaps… "
"perhaps you should start your family."
msgstr ""
"La vida es solitaria sin una familia de Colmillos a tu lado, tronando como "
"uno solo a través de este mundo desolado en busca de los lugares ocultos. "
"Tal vez... tal vez deberías formar tu familia."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about the shadows."
msgstr "Tienes un extraño sueño sobre las sombras."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a peculiar feeling of sinking into the dark."
msgstr "Tus sueños te dan una peculiar sensación de hundirte en la oscuridad."

#: lang/json/dream_from_json.py
msgid "You have a vivid dream of talking a midnight stroll."
msgstr "Tienes un sueño vívido de hablar de un paseo de medianoche."

#: lang/json/dream_from_json.py
msgid "You dream of drinking copious amounts of warm water."
msgstr "Sueñas con beber copiosas cantidades de agua caliente."

#: lang/json/dream_from_json.py
msgid ""
"You have a dream of being chased by dogs as something warm drips from your "
"mouth."
msgstr ""
"Sueñas con ser perseguido por perros mientras algo caliente gotea de tu "
"boca."

#: lang/json/dream_from_json.py
msgid "Snippets of stalking something in the star-lit night shakes you awake."
msgstr "Fragmentos de acechar algo en la noche estrellada te despiertan."

#: lang/json/dream_from_json.py
msgid "You dream of sinking your fangs into more and more enemies."
msgstr "Sueñas con hundir tus colmillos en más y más enemigos."

#: lang/json/dream_from_json.py
msgid ""
"You have a lucid dream where streams of blood are slowly pooling around your"
" feet."
msgstr ""
"Tienes un sueño lúcido en el que se acumulan lentamente charcos de sangre "
"alrededor de tus pies."

#: lang/json/dream_from_json.py
msgid "You have a strange dream about the mountain forests."
msgstr "Tienes un extraño sueño sobre los bosques de la montaña."

#: lang/json/dream_from_json.py
msgid "Your dreams give you a peculiar feeling of sinking into the treelines."
msgstr ""
"Tus sueños te dan una peculiar sensación de hundirse en las lineas de "
"arboles."

#: lang/json/dream_from_json.py
msgid "You have a vivid dream of strolling through the woods."
msgstr "Tienes el vívido sueño de pasear por el bosque."

#: lang/json/dream_from_json.py
msgid "You have a dream of chasing something as a raw hunger sears your mind."
msgstr "Sueñas con perseguir algo cuando un hambre cruda te quema la mente."

#: lang/json/dream_from_json.py
msgid "Recollections of stalking a human shakes you awake."
msgstr "Los recuerdos de acechar a un humano te despiertan."

#: lang/json/dream_from_json.py
msgid "You dream of tearing into more and more enemies."
msgstr "Sueñas con destrozar más y más enemigos."

#: lang/json/dream_from_json.py
msgid "You have a lucid dream where nature carefully welcomes your body."
msgstr ""
"Tienes un sueño lúcido donde la naturaleza acoge cuidadosamente tu cuerpo."

#: lang/json/dream_from_json.py
msgid "You dream of a strange jungle with giant ferns."
msgstr "Sueñas con una extraña jungla con helechos gigantes."

#: lang/json/dream_from_json.py
msgid "Dreams of being the king are all you can remember."
msgstr "Los sueños de ser el rey son todo lo que puedes recordar."

#: lang/json/dream_from_json.py
msgid ""
"You brush through tree sized ferns as you hunt for your prey.  The rain "
"falls slick upon your skin."
msgstr ""
"Te mueves entre helechos del tamaño de un árbol mientras cazas a tu presa. "
"La lluvia cae resbalando sobre tu piel."

#: lang/json/dream_from_json.py
msgid "Thunderous footsteps shake the earth, are they yours?"
msgstr "Unos pasos estruendosos sacuden la tierra, ¿son los tuyos?"

#: lang/json/dream_from_json.py
msgid "Your teeth, how do you have so many teeth?  Am I growing extra teeth?"
msgstr ""
"Tus dientes, ¿cómo es que tienes tantos dientes? ¿Me están creciendo dientes"
" de más?"

#: lang/json/dream_from_json.py
msgid "The hairless apes around you smell like food.  Are they?"
msgstr "Los monos sin pelo que te rodean huelen a comida. ¿Lo son?"

