msgid_plural "heavy machinegun belt linkages"
msgstr[0] "eslabón del cinturón de ametralladora pesada"
msgstr[1] "eslabones del cinturón de ametralladora pesada"

#: lang/json/GENERIC_from_json.py
msgid "broken CROWS II"
msgid_plural "broken CROWS II"
msgstr[0] "CROWS II roto"
msgstr[1] "CROWS II rotos"

#: lang/json/GENERIC_from_json.py
