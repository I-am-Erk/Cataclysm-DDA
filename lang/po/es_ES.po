"Un trozo de hierro en forma de alfiler, puede usarse para construir varias "
"cosas con un martillo."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "paintball"
msgid_plural "paintball"
msgstr[0] "bolas de pintura"
msgstr[1] "bolas de pintura"

#. ~ Description for {'str_sp': 'paintball'}
#: lang/json/AMMO_from_json.py
msgid "A tube of small paintballs.  They deal virtually no damage."
msgstr "Un tubo de bolas de paintball. Prácticamente no causan daño."

#: lang/json/AMMO_from_json.py
