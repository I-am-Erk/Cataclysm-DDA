msgid_plural "sets of Battlehammer 20k"
msgstr[0] "Battlehammer 20k"
msgstr[1] "juegos de Battlehammer 20k"

#. ~ Description for Battlehammer 20k
#: lang/json/GENERIC_from_json.py
