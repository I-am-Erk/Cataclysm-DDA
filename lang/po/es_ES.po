#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Military Corpse Disposal"
msgstr "Eliminador de Cadáveres Militar"

#. ~ Profession (male Military Corpse Disposal) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"In response to the outbreak, you were dispatched to contain the infection by"
" burning the corpses.  With command consumed by the undead, your priorities "
"have shifted to basic survival."
msgstr ""
"En respuesta al brote, te enviaron a contener la infección quemando los "
"cadáveres. Con el mando consumido por los muertos vivientes, tus prioridades"
" han cambiado a la supervivencia básica."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Military Corpse Disposal"
msgstr "Eliminador de Cadáveres Militar"

