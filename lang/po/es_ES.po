#: lang/json/GENERIC_from_json.py
msgid "Merch"
msgid_plural "Merchs"
msgstr[0] "Mercader"
msgstr[1] "Mercaderes"

#. ~ Description for Merch
#: lang/json/GENERIC_from_json.py
msgid ""
"The Free Merchant Certified Note, also known by names such as a 'c-note' or "
"'merch', is a currency based on old American bills.  Fifty dollar bills and "
"larger are printed with a promissory note signed by the treasurer of the "
"Free Merchants, along with a complex design.  The note explains that this "
"can be exchanged for food, water, and other services through the Free "
"Merchants in the Refugee Center."
msgstr ""
"El Billete Certificado de Libre Comercio, también conocido por nombres como "
"\"c-note\" o \"merch\", es una moneda basada en antiguos billetes "
"americanos. Los billetes de 50 dólares y más grandes se imprimen con un "
"pagaré firmado por el tesorero de los Comerciantes Libres, junto con un "
"diseño complejo. El billete explica que puede ser cambiado por comida, agua "
"y otros servicios a través de los Comerciantes Libres del Centro de "
"Refugiados."

#: lang/json/GENERIC_from_json.py
