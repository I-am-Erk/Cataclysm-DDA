#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Unsorted"
msgstr "botín: Sin clasificar"

#. ~ Description for Loot: Unsorted
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Place to drop unsorted loot.  You can use \"sort out loot\" zone-action to "
"sort items inside.  It can overlap with Loot zones of different types."
msgstr ""
"Lugar para dejar el botín sin clasificar. Puedes usar la acción de zona "
"\"clasificar el botín\" para clasificar los artículos dentro. Puede "
"superponerse con zonas de botín de diferentes tipos."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Food"
msgstr "Cosas: Comida"

#. ~ Description for Loot: Food
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for comestibles.  If more specific food zone is not defined, all"
" food is moved here."
msgstr ""
"Destino de los comestibles. Si no se define una zona de alimentos más "
"específica, todos los alimentos se trasladan aquí."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: P.Food"
msgstr "Cosas: P.Comida"

#. ~ Description for Loot: P.Food
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for perishable comestibles.  Does include perishable drinks if "
"such zone is not specified."
msgstr ""
"Destino de los comestibles perecederos. Incluye las bebidas perecederas si "
"no se especifica dicha zona."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Drink"
msgstr "Cosas: Bebidas"

#. ~ Description for Loot: Drink
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for drinks.  Does include perishable drinks if such zone is not "
"specified."
msgstr ""
"Destino de las bebidas. Incluye las bebidas perecederas si no se especifica "
"esa zona."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: P.Drink"
msgstr "Cosas: P.Bebidas"

#. ~ Description for Loot: P.Drink
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for perishable drinks."
msgstr "Destino de las bebidas perecederas."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Containers"
msgstr "Cosas: Recipientes"

#. ~ Description for Loot: Containers
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for empty containers."
msgstr "Destino de los contenedores vacíos."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Guns"
msgstr "Cosas: Armas de Fuego"

#. ~ Description for Loot: Guns
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for guns, bows and similar weapons."
msgstr "Destino de las pistolas, arcos y armas similares."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Magazines"
msgstr "Cosas: Cargadores"

#. ~ Description for Loot: Magazines
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for gun magazines."
msgstr "Destino de los cargadores de armas."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Ammo"
msgstr "Cosas: Munición"

#. ~ Description for Loot: Ammo
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for ammo."
msgstr "Lugar para la munición."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Weapons"
msgstr "Botín: Armas"

#. ~ Description for Loot: Weapons
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for melee weapons."
msgstr "Destino de las armas de combate cuerpo a cuerpo."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Tools"
msgstr "Cosas: Herramientas"

#. ~ Description for Loot: Tools
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for tools."
msgstr "Destino de las herramientas."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Clothing"
msgstr "Cosas: Ropa"

#. ~ Description for Loot: Clothing
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for clothing.  Does include filthy clothing if such zone is not "
"specified."
msgstr "Destino de la ropa. Incluye ropa sucia si no se especifica esa zona."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: F.Clothing"
msgstr "Botín: F. Ropa"

#. ~ Description for Loot: F.Clothing
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for filthy clothing."
msgstr "Lugar para la ropa sucia."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Drugs"
msgstr "Cosas: Drogas"

#. ~ Description for Loot: Drugs
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for drugs and other medical items."
msgstr "Lugar para drogas y otros objetos médicos."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Books"
msgstr "Cosas: Libros"

#. ~ Description for Loot: Books
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for books and magazines."
msgstr "Lugar para libros y revistas."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Mods"
msgstr "Cosas: Modificaciones"

#. ~ Description for Loot: Mods
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for firearm modifications and similar items."
msgstr "Lugar para modificaciones de armas de fuego y similares."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Mutagens"
msgstr "Botín: Mutágenos"

#. ~ Description for Loot: Mutagens
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for mutagens, serums, and purifiers."
msgstr "Lugar para mutágenos, sueros y purificantes."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Bionics"
msgstr "Cosas: Biónicos"

#. ~ Description for Loot: Bionics
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for Compact Bionics Modules, a.k.a. CBMS."
msgstr ""
"Destino de los módulos compactos de biónica, también conocidos como CBMS."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: V.Parts"
msgstr "Cosas: Partes de Vehículos"

#. ~ Description for Loot: V.Parts
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for vehicle parts."
msgstr "Destino de las piezas del vehículo."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Other"
msgstr "Cosas: Otros"

#. ~ Description for Loot: Other
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for other miscellaneous items."
msgstr "Lugar para otros objetos varios."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Fuel"
msgstr "Cosas: Combustible"

#. ~ Description for Loot: Fuel
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for gasoline, diesel, lamp oil and other substances used as a "
"fuel."
msgstr ""
"Destino de la gasolina, el diésel, el aceite para lámparas y otras "
"sustancias utilizadas como combustible."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Seeds"
msgstr "Cosas: Semillas"

#. ~ Description for Loot: Seeds
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for seeds, stems and similar items."
msgstr "Lugar para semillas, tallos y similares."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Chemical"
msgstr "Cosas: Químicos"

#. ~ Description for Loot: Chemical
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for chemicals."
msgstr "Lugar para químicos."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: S.Parts"
msgstr "Cosas: S.Partes"

#. ~ Description for Loot: S.Parts
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for spare parts."
msgstr "Lugar para partes sueltas."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Artifacts"
msgstr "Botín: Artefactos"

#. ~ Description for Loot: Artifacts
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for artifacts"
msgstr "Destino de los artefactos"

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Corpses"
msgstr "Botín: Cadáveres"

#. ~ Description for Loot: Corpses
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for corpses"
msgstr "Destino de los cuerpos"

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Armor"
msgstr "Botín: Armadura"

#. ~ Description for Loot: Armor
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Destination for armor.  Does include filthy armor if such zone is not "
"specified."
msgstr ""
"Destino de la armadura. Incluye la armadura sucia si no se especifica esa "
"zona."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: F.Armor"
msgstr "Botín: F. Armadura"

#. ~ Description for Loot: F.Armor
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for filthy armor."
msgstr "Destino de la armadura sucia."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Wood"
msgstr "Cosas: Madera"

#. ~ Description for Loot: Wood
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for firewood and items that can be used as such."
msgstr "Lugar para leña y objetos que pueden usarse como tal."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Custom"
msgstr "Botín: Personalizado"

#. ~ Description for Loot: Custom
#: lang/json/LOOT_ZONE_from_json.py
msgid "Destination for loot with a custom filter that you can modify"
msgstr "Destino del botín con un filtro personalizado que puede modificar"

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Ignore"
msgstr "Cosas: Ignorar"

#. ~ Description for Loot: Ignore
#: lang/json/LOOT_ZONE_from_json.py
msgid "Items inside of this zone are ignored by \"sort out loot\" zone-action."
msgstr ""
"Los objetos dentro de esta zona son ignorados por la acción \"ordenar "
"cosas\"."

#: lang/json/LOOT_ZONE_from_json.py
msgid "Loot: Ignore Favorites"
msgstr "Botín: Ignorar Favoritos"

#. ~ Description for Loot: Ignore Favorites
#: lang/json/LOOT_ZONE_from_json.py
msgid ""
"Favorite items inside of this zone are ignored by \"sort out loot\" zone-"
"action."
msgstr ""
"Los artículos favoritos dentro de esta zona son ignorados por la acción de "
"la zona \"clasificar el botín\"."

#: lang/json/MOD_INFO_from_json.py src/color.cpp src/color.cpp src/options.cpp
msgid "default"
msgstr "predeterminado"

#. ~ Description for default
#: lang/json/MOD_INFO_from_json.py
msgid "contains all the mods recommended by the developers"
msgstr "contiene todos los mods recomendados por los desarrolladores"

#: lang/json/MOD_INFO_from_json.py
msgid "Aftershock"
msgstr "Réplica"

#. ~ Description for Aftershock
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Moving towards a survival horror full conversion mod set in a mostly "
"abandoned extrasolar colony far from Earth hundreds of years from today."
msgstr ""
"Avanzando hacia un mod de conversión completa de survival horror ambientado "
"en una colonia extrasolar mayoritariamente abandonada y alejada de la Tierra"
" dentro de cientos de años."

#: lang/json/MOD_INFO_from_json.py
msgid "Blaze Industries"
msgstr "Blaze Industries"

#. ~ Description for Blaze Industries
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Introduces the fictional corporation Blaze Industries, bringing advanced "
"vehicle modification to the consumer."
msgstr ""
"Presenta la corporación ficticia Blaze Industries, aportando la modificación"
" avanzada de vehículos al consumidor."

#: lang/json/MOD_INFO_from_json.py
msgid "C.R.I.T Expansion Mod"
msgstr "Mod de Expansión C.R.I.T."

#. ~ Description for C.R.I.T Expansion Mod
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds a plethora of content: professions, guns/mods/weapons, WIP mobs, "
"mutations, MA styles, and some QOL innawoods changes.  Use the readme to see"
" more details!"
msgstr ""
"Añade una plétora de contenidos: profesiones, armas/mods, WIP mobs, "
"mutaciones, estilos MA, y algunos cambios de QOL innawoods. ¡Utiliza el "
"léeme para ver más detalles!"

#: lang/json/MOD_INFO_from_json.py
msgid "Chibi Ultica"
msgstr "Chibi Ultica"

#. ~ Description for Chibi Ultica
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Uses Character, and Monster sprites from MSX with the UlticaShell tileset."
msgstr ""
"Utiliza Caracteres y sprites de Monstruos de MSX con el teselado "
"UlticaShell."

#: lang/json/MOD_INFO_from_json.py
msgid "Crazy Cataclysm"
msgstr "Cataclismo Loco"

#. ~ Description for Crazy Cataclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Want a little crazy in your Cataclysm?  Try this one."
msgstr "¿Quieres un poco de locura en tu Cataclysm? Prueba este mod."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Skies Above"
msgstr "Cielos Oscuros"

#. ~ Description for Dark Skies Above
#: lang/json/MOD_INFO_from_json.py
msgid ""
"A total conversion that shifts the Cataclysm towards an alien occupation "
"survival scenario.  THIS MOD WILL BREAK INTENDED FUNCTIONALITY OF OTHER "
"MODS!  USE OTHER MODS AT YOUR OWN RISK."
msgstr ""
"Una conversión total que cambia el Cataclismo hacia un escenario de "
"supervivencia de una ocupación alienígena. ¡ESTE MOD ROMPERÁ LA "
"FUNCIONALIDAD PREVISTA DE OTROS MODS! USE OTROS MODS BAJO SU PROPIO RIESGO."

#: lang/json/MOD_INFO_from_json.py
msgid "DinoMod"
msgstr "DinoMod"

#. ~ Description for DinoMod
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds dinosaurs.  Some rideable, others less friendly.  Life will find a way."
msgstr ""
"Añade los dinosaurios. Algunos se pueden montar, otros son menos amistosos. "
"La vida encontrará un camino."

#: lang/json/MOD_INFO_from_json.py
msgid "Fuji's Military Profession Pack"
msgstr "Paquete de la profesión militar de Fuji"

#. ~ Description for Fuji's Military Profession Pack
#: lang/json/MOD_INFO_from_json.py
msgid "Numerous military themed professions"
msgstr "Numerosas profesiones de temática militar"

#: lang/json/MOD_INFO_from_json.py
msgid "Fuji's More Buildings"
msgstr "Más Edificios de Fuji"

#. ~ Description for Fuji's More Buildings
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds more buildings and more variations to existing buildings.  (Requires "
"More Locations)"
msgstr ""
"Añade más edificios y más variaciones a los edificios existentes. (Requiere "
"más ubicaciones)"

#: lang/json/MOD_INFO_from_json.py
msgid "Generic Guns"
msgstr "Armas Genéricas"

#. ~ Description for Generic Guns
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Replaces guns and ammo with generic types.  Warning: can cause issues with "
"other gun mods."
msgstr ""
"Sustituye las armas y municiones por tipos genéricos. Advertencia: puede "
"causar problemas con otros mods de armas."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap"
msgstr "Mapa Gráfico"

#. ~ Description for Graphical Overmap
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Gives the overmap a graphical overhaul.  Please refer to readme for "
"installation."
msgstr ""
"Le da al mapa una revisión gráfica. Por favor, refiérase al readme para la "
"instalación."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Fujistruct"
msgstr "Mapa Gráfico Fujistruct"

#. ~ Description for Graphical Overmap Fujistruct
#: lang/json/MOD_INFO_from_json.py
msgid "Fuji Structures mod support for Graphical Overmap."
msgstr "Mod de Estructuras Fuji soporte para el Sobremapa Gráfico."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Magiclysm"
msgstr "Mapa Gráfico del Magiclismo "

#. ~ Description for Graphical Overmap Magiclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Magiclysm support for Graphical Overmap."
msgstr "Soporte de Magiclismo para el Mapa Gráfico."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap More Locations"
msgstr "Mapa Gráfica Más Ubicaciones"

#. ~ Description for Graphical Overmap More Locations
#: lang/json/MOD_INFO_from_json.py
msgid "More Locations mod support for Graphical Overmap."
msgstr "Mod de mas localizaciones de soporte de Sobreimpresión Gráfica."

#: lang/json/MOD_INFO_from_json.py
msgid "Graphical Overmap Urban Development"
msgstr "Mapa Gráfico de Desarrollo Urbano"

#. ~ Description for Graphical Overmap Urban Development
#: lang/json/MOD_INFO_from_json.py
msgid "Urban Development mod support for Graphical Overmap."
msgstr "Mod de Desarrollo Urbano para soporte de Mapa Gráfico."

#: lang/json/MOD_INFO_from_json.py
msgid "Mythical Martial Arts"
msgstr "Artes Marciales Míticas"

#. ~ Description for Mythical Martial Arts
#: lang/json/MOD_INFO_from_json.py
msgid ""
"A collection of fictional, mythologically inspired or otherwise unrealistic "
"martial arts."
msgstr ""
"Una colección de artes marciales ficticias, inspiradas en la mitología poco "
"realistas."

#: lang/json/MOD_INFO_from_json.py
msgid "Magiclysm"
msgstr "Magiclismo"

#. ~ Description for Magiclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Cataclysm but with magic spells!"
msgstr "¡Cataclysm pero con hechizos mágicos!"

#: lang/json/MOD_INFO_from_json.py
msgid "More Locations"
msgstr "Más Lugares"

#. ~ Description for More Locations
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds new Z-level buildings and dungeons.  Still unpolished.  Before "
"generating a world, you can remove subfolders to nix unwanted locations."
msgstr ""
"Agrega edificios con niveles Z y calabozos. Todavía está sin pulir. Antes de"
" crear un mundo, puedes borrar subdirectorios para prohibir lugares."

#: lang/json/MOD_INFO_from_json.py
msgid "Mutant NPCs"
msgstr "PNJs mutantes"

#. ~ Description for Mutant NPCs
#: lang/json/MOD_INFO_from_json.py
msgid ""
"NPCs wandering the wasteland will occasionally have mutations --- your foes "
"included.  Beware!"
msgstr ""
"Los PNJs que vagan por el páramo ocasionalmente tienen mutaciones... tus "
"enemigos incluidos. ¡Cuidado!"

#: lang/json/MOD_INFO_from_json.py
msgid "My Sweet Cataclysm"
msgstr "Mi Dulce Cataclismo"

#. ~ Description for My Sweet Cataclysm
#: lang/json/MOD_INFO_from_json.py
msgid ""
"In the wake of the Cataclysm, sweets and snacks are coming to life.  You "
"could be one of them and walk through the Cataclysm as a human shaped piece "
"of sugar with your pet necco wafer, or you could just hunt them for some "
"sweet treats."
msgstr ""
"Tras el cataclismo, los dulces y los bocadillos están cobrando vida. Podrías"
" ser uno de ellos y caminar a través del Cataclismo como un cacho de azúcar "
"con forma humana con tu mascota necco wafer, o podrías simplemente cazarlos "
"por algunos dulces."

#: lang/json/MOD_INFO_from_json.py
msgid "Beta National Guard Camp"
msgstr "Beta Guardia Nacional"

#. ~ Description for Beta National Guard Camp
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Help test the national guard camp before inclusion into the base game.  "
"Provide feedback in the thread under 'The Lab'"
msgstr ""
"Ayude a probar el campamento de la guardia nacional antes de incluirlo en el"
" juego base. Proporcionar retroalimentación en el hilo de \"El Laboratorio\""

#: lang/json/MOD_INFO_from_json.py
msgid "No Fungal Monsters"
msgstr "Sin Monstruos Fúngicos"

#. ~ Description for No Fungal Monsters
#: lang/json/MOD_INFO_from_json.py
msgid "Removes fungal monsters and regions from the game."
msgstr "Saca del juego las regiones y los monstruos fúngicos."

#: lang/json/MOD_INFO_from_json.py
msgid "Disable NPC Needs"
msgstr "Necesidades de PNJs Desactivadas"

#. ~ Description for Disable NPC Needs
#: lang/json/MOD_INFO_from_json.py
msgid "Makes NPCs not require food, water or rest."
msgstr "Hace que los PNJ no necesiten ni comida, ni agua ni descansar."

#: lang/json/MOD_INFO_from_json.py
msgid "No Rail Stations"
msgstr "Sin Estaciones de Tren"

#. ~ Description for No Rail Stations
#: lang/json/MOD_INFO_from_json.py
msgid "Removes above-ground rail stations from the game."
msgstr "Quita del juego las estaciones de tren sobre tierra."

#: lang/json/MOD_INFO_from_json.py
msgid "No Monsters"
msgstr "Sin Monstruos"

#. ~ Description for No Monsters
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Removes all monsters from the game, save for those in the WILDLIFE category."
msgstr ""
"Saca del juego todos los monstruos excepto los que pertenecen a la categoría"
" FAUNA SALVAJE."

#: lang/json/MOD_INFO_from_json.py
msgid "Stats Through Skills"
msgstr "Atributos a Través de las Habilidades"

#. ~ Description for Stats Through Skills
#: lang/json/MOD_INFO_from_json.py
msgid "Allows stats to raise via skill progression."
msgstr ""
"Permite que los atributos aumenten a través de la progresión de las "
"habilidades."

#: lang/json/MOD_INFO_from_json.py
msgid "Urban Development"
msgstr "Desarrollo Urbano"

#. ~ Description for Urban Development
#: lang/json/MOD_INFO_from_json.py
msgid "Holder for suburban and urban buildings."
msgstr "Soporte para edificios suburbanos y urbanos."

#: lang/json/MOD_INFO_from_json.py
msgid "Aftershock: Exoplanet"
msgstr "Réplica: Exoplaneta"

#. ~ Description for Aftershock: Exoplanet
#: lang/json/MOD_INFO_from_json.py
msgid ""
"An experimental implementation of Aftershock's exoplanet region, not "
"recommended for actual playthroughs.  Adds no new content by itself, and "
"requires the main mod to function correctly."
msgstr ""
"Una implementación experimental de la región de exoplanetas de Réplica, no "
"recomendada para partidas reales. No añade ningún contenido nuevo por sí "
"mismo, y requiere el mod principal para funcionar correctamente."

#: lang/json/MOD_INFO_from_json.py
msgid "Alternative Map Key"
msgstr "Símbolos de Mapa Alternativos"

#. ~ Description for Alternative Map Key
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Changes the overmap to be more readable.  Buildings are color coded by type "
"and use initial letter of their names instead of ^v<>."
msgstr ""
"Cambia el sobremapa para que sea más legible. Los edificios están "
"codificados por color según el tipo y usan la letra inicial de sus nombres "
"en lugar de ^v<>."

#: lang/json/MOD_INFO_from_json.py
msgid "Bionic Slots"
msgstr "Ranuras Biónicas"

#. ~ Description for Bionic Slots
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Enables the bionic slots system, which limits the number of CBMs you can "
"install in each bodypart."
msgstr ""
"Habilita el sistema de ranuras biónicas, que limita el número de CBM que se "
"pueden instalar en cada pieza del cuerpo."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Days of the Dead"
msgstr "Días Oscuros de la Muerte"

#. ~ Description for Dark Days of the Dead
#: lang/json/MOD_INFO_from_json.py
msgid ""
"(Formerly Classic Zombies): Only spawn classic zombies (normal zombies and "
"zombie animals) and natural wildlife.  Zombies do not revive and do not need"
" pulping.  This disables certain buildings and map extras.  The long term "
"plan is to make this a classic zombie movie simulator set in the present "
"day.  If you have this mod enabled in experimental, some items may "
"disappear."
msgstr ""
"(Anteriormente Zombis clásicos): Sólo engendran zombis clásicos (zombis "
"normales y animales zombis) y fauna natural. Los zombis no reviven y no "
"necesitan pulpa. Esto deshabilita ciertos edificios y los extras del mapa. "
"El plan a largo plazo es hacer de este un clásico simulador de películas de "
"zombis en el presente. Si tienes este mod habilitado en experimental, "
"algunos elementos pueden desaparecer."

#: lang/json/MOD_INFO_from_json.py
msgid "Dark Days Ahead"
msgstr "Futuros Días Oscuros"

#. ~ Description for Dark Days Ahead
#: lang/json/MOD_INFO_from_json.py
msgid "Core content for Cataclysm-DDA"
msgstr "Contenido básico para Cataclysm-DDA"

#: lang/json/MOD_INFO_from_json.py
msgid "Desert Region"
msgstr "Región Desértica"

#. ~ Description for Desert Region
#: lang/json/MOD_INFO_from_json.py
msgid "A testbed/WIP mod to showcase regional_map_settings JSON changes."
msgstr ""
"Un mod de prueba/WIP para mostrar los cambios en el JSON de "
"regional_map_settings."

#: lang/json/MOD_INFO_from_json.py
msgid "Extra Mutated Scenarios"
msgstr "Escenarios ExtraMutados"

#. ~ Description for Extra Mutated Scenarios
#: lang/json/MOD_INFO_from_json.py
msgid "Extra scenarios with all possible mutation traits and thresholds."
msgstr ""
"Escenarios adicionales con todos los rasgos y umbrales de mutación posibles."

#: lang/json/MOD_INFO_from_json.py
msgid "Bionic Professions"
msgstr "Profesiones Biónicas"

#. ~ Description for Bionic Professions
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Numerous bionic starting professions.  Disable for a more real-world "
"experience."
msgstr ""
"Numerosas profesiones iniciales biónicas. Desactivar para una experiencia "
"más real."

#: lang/json/MOD_INFO_from_json.py
msgid "Rural-Only Mapgen"
msgstr "Generación de Mapa Solo Rural"

#. ~ Description for Rural-Only Mapgen
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Play in the boonies: nothing but farms, forests, and villages.  Recommended "
"city size set to 1 and spacing set to 8."
msgstr ""
"Jugar en el quinto pino: nada más que granjas, bosques y aldeas. El tamaño "
"recomendado de la ciudad es de 1 y el espaciado de 8."

#: lang/json/MOD_INFO_from_json.py
msgid "sees-player icon, HitButton_iso"
msgstr "Ver icono de jugador, HitButton_iso"

#. ~ Description for sees-player icon, HitButton_iso
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds indicator icon if a creature sees the player.  Designed for the "
"HitButton isometric tileset."
msgstr ""
"Añade un icono indicador si una criatura ve al jugador. Diseñado para el "
"teselado isométrico de HitButton."

#: lang/json/MOD_INFO_from_json.py
msgid "sees-player icon, retrodays"
msgstr "Ver icono del jugador, retrodays"

#. ~ Description for sees-player icon, retrodays
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds indicator icon if a creature sees the player.  Designed for the "
"retrodays tileset."
msgstr ""
"Añade un icono indicador si una criatura ve al jugador. Diseñado para el "
"juego de azulejos retrodays."

#: lang/json/MOD_INFO_from_json.py
msgid "SpeedyDex"
msgstr "SpeedyDex"

#. ~ Description for SpeedyDex
#: lang/json/MOD_INFO_from_json.py
msgid "Higher dex increases your speed."
msgstr "Una destreza más alta aumenta tu velocidad."

#: lang/json/MOD_INFO_from_json.py
msgid "Stats Through Kills"
msgstr "Atributos a Través de las Muertes"

#. ~ Description for Stats Through Kills
#: lang/json/MOD_INFO_from_json.py
msgid "You gain XP from kills that you can spend on increasing your stats."
msgstr "Ganas XP de las muertes que puedes gastar en aumentar tus atributos."

#: lang/json/MONSTER_from_json.py
msgid "huge dragonfly"
msgid_plural "huge dragonflies"
msgstr[0] "libélula enorme"
msgstr[1] "libélulas enormes"

#. ~ Description for huge dragonfly
#: lang/json/MONSTER_from_json.py
msgid ""
"A brightly colored, winged mutant dragonfly the size of a cat with sharp "
"fangs."
msgstr "Una libélula mutante del tamaño de un gato con colmillos afilados."

#: lang/json/MONSTER_from_json.py
msgid "chicken"
msgid_plural "chickens"
msgstr[0] "pollo"
msgstr[1] "pollos"

#. ~ Description for chicken
#: lang/json/MONSTER_from_json.py
msgid ""
"A domesticated descendant of junglefowl, it may still be the most numerous "
"bird in the world.  Before the Cataclysm, it was raised by humans as a "
"source of meat, eggs, and early morning wakeup calls."
msgstr ""
"Un descendiente domesticado de los gallus, y puede que sea el pájaro más "
"numeroso en el mundo. Antes del Cataclismo, era criado por los humanos como "
"una fuente de carne, huevos y despertadores."

#: lang/json/MONSTER_from_json.py
msgid "grouse"
msgid_plural "grouses"
msgstr[0] "urogallo"
msgstr[1] "urogallos"

#. ~ Description for grouse
#: lang/json/MONSTER_from_json.py
msgid ""
"A very common game bird, these creatures remind you of what a wild chicken "
"must have been like."
msgstr ""
"Un ave de caza muy común, estas criaturas te recuerdan cómo debe haber sido "
"un pollo salvaje."

#: lang/json/MONSTER_from_json.py
msgid "crow"
msgid_plural "crows"
msgstr[0] "cuervo"
msgstr[1] "cuervos"

#. ~ Description for crow
#: lang/json/MONSTER_from_json.py
msgid ""
"A small, elegant black bird, famous for its distinctive call.  An "
"intelligent bird, there is a glitter of mischief behind its eyes."
msgstr ""
"Un pequeño pájaro elegante, famoso por su canto distintivo. Es un pájaro "
"inteligente, tiene un brillo travieso en sus ojos."

#: lang/json/MONSTER_from_json.py
msgid "duck"
msgid_plural "ducks"
msgstr[0] "pato"
msgstr[1] "patos"

#. ~ Description for duck
#: lang/json/MONSTER_from_json.py
msgid ""
"A mallard duck, often seen around rivers and other bodies of water.  It "
"feeds primarily on insects, seeds, roots, and, pre-Cataclysm, bread scraps."
msgstr ""
"Un pato real, a menudo visto alrededor de ríos y otras masas de agua. Se "
"alimenta principalmente de insectos, semillas, raíces y, antes del "
"cataclismo, restos de pan."

#: lang/json/MONSTER_from_json.py
msgid "goose"
msgid_plural "geese"
msgstr[0] "ganso"
msgstr[1] "gansos"

#. ~ Description for goose
#: lang/json/MONSTER_from_json.py
msgid "A Canadian goose, a common waterfowl that regrets leaving Canada."
msgstr ""
"Es un ganso canadiense, un ave acuática común que se arrepiente de haberse "
"ido de Canadá."

#: lang/json/MONSTER_from_json.py
msgid "turkey"
msgid_plural "turkeys"
msgstr[0] "pavo"
msgstr[1] "pavos"

#. ~ Description for turkey
#: lang/json/MONSTER_from_json.py
msgid ""
"A large and colorful game bird native to the forests of North America.  Its "
"head and beak are covered in fleshy protuberances."
msgstr ""
"Un pájaro grande y colorido, nativo de los bosques de América del Norte. Su "
"cabeza y pico están cubiertos con protuberancias carnosas."

#: lang/json/MONSTER_from_json.py
msgid "pheasant"
msgid_plural "pheasants"
msgstr[0] "faisan"
msgstr[1] "faisanes"

#. ~ Description for pheasant
#: lang/json/MONSTER_from_json.py
msgid ""
"A medium-sized game bird that can have bright feathers depending on the sex "
"and species."
msgstr ""
"Un ave de caza de tamaño medio que puede tener plumas brillantes según el "
"sexo y la especie."

#: lang/json/MONSTER_from_json.py
msgid "cockatrice"
msgid_plural "cockatrices"
msgstr[0] "Cocatriz"
msgstr[1] "cocatrices"

#. ~ Description for cockatrice
#: lang/json/MONSTER_from_json.py
msgid ""
"This strange mutant bird gains its name from its odd appearance.  Although "
"its features seem to be becoming more reptilian, it doesn't appear "
"dangerous."
msgstr ""
"Este extraño ave mutante recibe su nombre de su extravagante apariencia. "
"Aunque pareciera que sus características se vuelven más reptilianas, no "
"parece ser peligroso."

#: lang/json/MONSTER_from_json.py
msgid "yellow chick"
msgid_plural "yellow chicks"
msgstr[0] "pollo amarillo"
msgstr[1] "pollos amarillos"

#. ~ Description for yellow chick
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny yellow and brown chick, it could be from a number of different "
"species."
msgstr ""
"Es un pequeño pollito amarillo y marrón, puede ser de cualquiera de las "
"especies que hay."

#: lang/json/MONSTER_from_json.py
msgid "brown chick"
msgid_plural "brown chicks"
msgstr[0] "pollo marrón"
msgstr[1] "pollos marrones"

#: lang/json/MONSTER_from_json.py
msgid "strange chick"
msgid_plural "strange chicks"
msgstr[0] "pollo extraño"
msgstr[1] "pollos extraños"

#. ~ Description for strange chick
#: lang/json/MONSTER_from_json.py
msgid "A strange tiny chick, it could be from a number of different species."
msgstr ""
"Es un pequeño pollito raro, puede ser de cualquiera de las especies que hay."

#: lang/json/MONSTER_from_json.py
msgid "waterfowl chick"
msgid_plural "waterfowl chicks"
msgstr[0] "pollo de aves acuáticas"
msgstr[1] "pollos de aves acuáticas"

#. ~ Description for waterfowl chick
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny yellow and brown waterfowl chick, it could be from a number of "
"different species."
msgstr ""
"Es un pequeño pollito acuático amarillo y marrón, puede ser de cualquiera de"
" las especies que hay."

#: lang/json/MONSTER_from_json.py
msgid "oversized crow"
msgid_plural "oversized crows"
msgstr[0] "cuervo de gran tamaño"
msgstr[1] "cuervos de gran tamaño"

#. ~ Description for oversized crow
#: lang/json/MONSTER_from_json.py
msgid ""
"A horrible bird grown three or four times bigger than ought to be possible "
"and sporting a swollen gut that might look comical if it weren't for the "
"razor sharp beak and the madness in its beady eyes."
msgstr ""
"Un horrible pájaro tres o cuatro veces más grande de lo que debería ser "
"posible y con una tripa hinchada que podría parecer cómica si no fuera por "
"el pico afilado y la locura en sus ojos brillantes."

#: lang/json/MONSTER_from_json.py
msgid "bloated corvid"
msgid_plural "bloated corvids"
msgstr[0] "córvido hinchado"
msgstr[1] "córvidos hinchados"

#. ~ Description for bloated corvid
#: lang/json/MONSTER_from_json.py
msgid ""
"This may have once been a crow or a raven, but now it's a deformed "
"monstrosity nearly the size of a man.  It heaves its sable bulk awkwardly "
"along the ground, too overfed on carrion to fly."
msgstr ""
"Esto puede haber sido una vez un tipo de cuervo, pero ahora es una "
"monstruosidad deforme del tamaño de un hombre. Lleva su cuerpo en el suelo, "
"demasiado alimentado con carroña para volar."

#: lang/json/MONSTER_from_json.py
msgid "pigeon"
msgid_plural "pigeons"
msgstr[0] "paloma"
msgstr[1] "palomas"

#. ~ Description for pigeon
#: lang/json/MONSTER_from_json.py
msgid ""
"Pigeons are gentle, plump, small-billed birds with a skin saddle (cere) "
"between the bill and forehead.  All pigeons strut about with a "
"characteristic bobbing of the head.  Because of their long wings and "
"powerful flight muscles, they are strong, swift fliers."
msgstr ""
"Las palomas son aves suaves, gordas, de pico pequeño con una silla de piel "
"(cere) entre el pico y la frente. Todas las palomas se pavonean con un "
"característico balanceo de la cabeza. Debido a sus largas alas y a sus "
"poderosos músculos de vuelo, son fuertes y veloces voladoras."

#: lang/json/MONSTER_from_json.py
msgid "broken cyborg"
msgid_plural "broken cyborgs"
msgstr[0] "cyborg roto"
msgstr[1] "cyborgs rotos"

#. ~ Description for broken cyborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A robot body with the head of a human.  All kinds of electronic wires and "
"devices are implanted in its head.  Patches of skin look diseased or "
"rotting.  This cyborg moves erratically and has a confused and deranged look"
" in its eyes."
msgstr ""
"Es un cuerpo robótico con cabeza humana. Tiene toda clase de cables y "
"dispositivos eléctricos implantados en la cabeza. Los parches de piel "
"parecen enfermos o podridos. El cíborg se mueve erráticamente y tiene una "
"mirada confusa y perturbada."

#: lang/json/MONSTER_from_json.py
msgid "prototype cyborg"
msgid_plural "prototype cyborgs"
msgstr[0] "prototipo de ciborg"
msgstr[1] "prototipos de ciborg"

#. ~ Description for prototype cyborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A human fused with a mess of metal parts and wires.  While its eyes are "
"empty, flashes of pain pass across its face reminiscent of the person "
"trapped in this grotesque body.  With enough surgical skills one might be "
"able to give them back some humanity.  If only they cared…"
msgstr ""
"Un humano fusionado con un montón de piezas de metal y cables. Mientras sus "
"ojos están vacíos, destellos de dolor pasan a través de su cara, recordando "
"a la persona atrapada en este grotesco cuerpo. Con suficientes habilidades "
"quirúrgicas uno podría ser capaz de devolverles algo de humanidad. Si sólo "
"les importara..."

#: lang/json/MONSTER_from_json.py
msgid "Exodii worker"
msgid_plural "Exodii workers"
msgstr[0] "trabajador Exodii"
msgstr[1] "trabajadores Exodii"

#. ~ Description for Exodii worker
#: lang/json/MONSTER_from_json.py
msgid ""
"This is a mostly humanoid robot equipped with various construction tools."
msgstr ""
"Se trata de un robot mayoritariamente humanoide equipado con varias "
"herramientas de construcción."

#: lang/json/MONSTER_from_json.py
msgid "Exodii quadruped"
msgid_plural "Exodii quadrupeds"
msgstr[0] "cuadrupedo exodii"
msgstr[1] "cuadrupedos exodii"

#. ~ Description for Exodii quadruped
#: lang/json/MONSTER_from_json.py
msgid ""
"This enormous quadrupedal robot seems to be cobbled together from parts, "
"most of them unfamiliar to you.  It moves with a heavy, oddly graceful gait,"
" its footsteps leaving shallow craters behind.  It bristles with an arsenal "
"of weaponry, but doesn't seem in a particular rush to target you."
msgstr ""
"Este enorme robot cuadrúpedo parece estar empedrado de partes, la mayoría de"
" ellas desconocidas para ti. Se mueve con un pesado y extrañamente elegante "
"andar, sus pasos dejan atrás cráteres poco profundos. Se eriza con un "
"arsenal de armas, pero no parece tener mucha prisa en apuntarte."

#: lang/json/MONSTER_from_json.py lang/json/MONSTER_from_json.py
#: src/monattack.cpp src/monattack.cpp
msgid "a chk!"
msgstr "a chk!"

#: lang/json/MONSTER_from_json.py
msgid "zomborg"
msgid_plural "zomborgs"
msgstr[0] "zomborg"
msgstr[1] "zomborgs"

#. ~ Description for zomborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A mix of dead human and even deader technology, this twisted mess of steel "
"and flesh moves like a puppet in the hands of an angry toddler.  Its robotic"
" components seem to have shut down, and new bands of flesh have wrapped "
"around them, tugging and pulling them in awkward directions.  Bits of "
"metallic skeleton and armor plating jut from its decaying flesh."
msgstr ""
"Una mezcla de humano muerto y tecnología aún más muerta, este retorcido lío "
"de acero y carne se mueve como una marioneta en las manos de un niño "
"enojado. Sus componentes robóticos parecen haberse apagado, y nuevas bandas "
"de carne se han envuelto alrededor de ellos, tirando y arrastrando de ellos "
"en direcciones extrañas. Trozos de esqueleto metálico y blindaje sobresalen "
"de su carne en descomposición."

#: lang/json/MONSTER_from_json.py
msgid "police bot"
msgid_plural "police bots"
msgstr[0] "policíabot"
msgstr[1] "policíabots"

#. ~ Description for police bot
#: lang/json/MONSTER_from_json.py
msgid ""
"One of the many models of armored law enforcement robots employed shortly "
"before the collapse of civilization.  Solar powered like many other robots, "
"it maintains its programmed pursuit of law and order, propelled on a trio of"
" omni wheels."
msgstr ""
"Uno de los muchos modelos de robots armados para las fuerzas de la ley, "
"comenzados a utilizar poco después del colapso de la civilización. Se "
"alimenta con luz solar como muchos robots, y mantiene su deber programado "
"sobre la ley y el orden, propulsado por un trío de ruedas "
"multidireccionales."

#: lang/json/MONSTER_from_json.py
msgid "riot control bot"
msgid_plural "riot control bots"
msgstr[0] "antidisturbot"
msgstr[1] "antidisturbots"

#. ~ Description for riot control bot
#: lang/json/MONSTER_from_json.py
msgid ""
"Nonviolent riot-control bot.  Designed to suppress riots and make mass "
"arrests of those participating.  Though its relaxation gas is by far its "
"best-known weapon, it carries a blinding flash and a low-powered stungun for"
" self-defense--in addition to its supply of electronic handcuffs."
msgstr ""
"Un robot no violento antidisturbios. Diseñado para contener disturbios y "
"hacer arrestos masivos de los participantes. Aunque su arma más conocida es "
"el gas relajante, también lleva una luz deslumbrante y un arma paralizante "
"de bajo poder como defensas, además de su equipo de esposas electrónicas."

#: lang/json/MONSTER_from_json.py
msgid "M16A4 autonomous TALON UGV"
msgid_plural "M16A4 autonomous TALON UGVs"
msgstr[0] "TALÓN UGV M16A4 autonomo"
msgstr[1] "TALÓN UGV M16A4 autonomos"

#. ~ Description for M16A4 autonomous TALON UGV
#: lang/json/MONSTER_from_json.py
msgid ""
"A TALON unmanned ground vehicle equipped with an M16A4.  It is a small "
"tracked UGV with an array of motors and sensors covering its weapon mount."
msgstr ""
"Es un vehículo terrestre no tripulado TALON equipado con una M16A4. Es un "
"pequeño UGV rastreado con un conjunto de motores y sensores que cubren la "
"montura del arma."

#: lang/json/MONSTER_from_json.py
msgid "\"Hostile detected.\""
msgstr "\"Hostil detectado\"."

#: lang/json/MONSTER_from_json.py
msgid "M202A1 autonomous TALON UGV"
msgid_plural "M202A1 autonomous TALON UGVs"
msgstr[0] "TALÓN UGV M202A1 autonomo"
msgstr[1] "TALÓN UGV M202A1 autonomos"

#. ~ Description for M202A1 autonomous TALON UGV
#: lang/json/MONSTER_from_json.py
msgid ""
"A TALON unmanned ground vehicle equipped with an M202A1 FLASH.  It is a "
"small tracked UGV with an array of motors and sensors covering its weapon "
"mount."
msgstr ""
"Un vehículo terrestre no tripulado TALON equipado con un M202A1 FLASH. Es un"
" pequeño UGV de orugas con un conjunto de motores y sensores que cubren la "
"montura de su arma."

#: lang/json/MONSTER_from_json.py
msgid "skitterbot"
msgid_plural "skitterbots"
msgstr[0] "arañabot"
msgstr[1] "arañabots"

#. ~ Description for skitterbot
#: lang/json/MONSTER_from_json.py
msgid ""
"An insectoid robot the size of a small dog, designed for home security.  "
"Armed with two close-range tazers, it can skate across the ground with great"
" speed."
msgstr ""
"Un robot insectoide del tamaño de un perro chico, diseñado para la seguridad"
" en el hogar. Armado con dos pistolas eléctricas de corto alcance, puede "
"deslizarse por el suelo a gran velocidad."

#: lang/json/MONSTER_from_json.py
msgid "experimental lab bot"
msgid_plural "experimental lab bots"
msgstr[0] "robot de laboratorio experimental"
msgstr[1] "robots de laboratorio experimental"

#. ~ Description for experimental lab bot
#: lang/json/MONSTER_from_json.py
msgid ""
"This robot looks like a large metal spider, a bit bigger than a person, with"
" its thorax covered in tiny holes.  An ominous buzzing emanates from it."
msgstr ""
"Este robot parece una gran araña de metal, un poco más grande que una "
"persona, con su tórax cubierto de pequeños agujeros. Un zumbido ominoso "
"emana de ella."

#: lang/json/MONSTER_from_json.py
msgid "prototype robot"
msgid_plural "prototype robots"
msgstr[0] "robot prototipo"
msgstr[1] "robots prototipos"

#. ~ Description for prototype robot
#: lang/json/MONSTER_from_json.py
msgid ""
"The single glowing eye of this robot surveys the landscape periodically, as "
"it performs the endless slaughter dictated by a misinterpreted and cruel "
"routine.  Between half-built plates, you can see the machinery and cables "
"that animate it, and yet it moves deftly as it switches between one target "
"and the next."
msgstr ""
"El ojo único y brillante de este robot observa el paisaje periódicamente, "
"mientras realiza la interminable matanza dictada por una rutina mal "
"interpretada y cruel. Entre las placas a medio construir, puede ver la "
"maquinaria y los cables que lo animan, y sin embargo se mueve hábilmente "
"mientras cambia de un objetivo a otro."

#: lang/json/MONSTER_from_json.py
msgid "NR-031 Dispatch"
msgid_plural "NR-031 Dispatches"
msgstr[0] "NR-031 despachador"
msgstr[1] "NR-031 despachadores"

#. ~ Description for NR-031 Dispatch
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northrop Dispatch, designed for crowd control situations, carries and "
"deploys kamikaze drones of various types.  The bright green-and-yellow paint"
" marks a low-force variant - *comparatively* low-force, anyways - typically "
"deployed as guards after an area has been cleared."
msgstr ""
"El despachador Northrop, diseñado para situaciones de control de multitudes,"
" transporta y despliega drones kamikaze de varios tipos. La pintura verde y "
"amarilla brillante marca una variante de baja fuerza - *comparativamente* "
"baja fuerza, de todos modos- típicamente desplegada como guardias después de"
" que un área ha sido despejada."

#: lang/json/MONSTER_from_json.py
msgid "NR-V05-M Dispatch"
msgid_plural "NR-V05-M Dispatches"
msgstr[0] "NR-V05-M despachador"
msgstr[1] "NR-V05-M despachadores"

#. ~ Description for NR-V05-M Dispatch
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northrop Dispatch, designed for crowd control situations, carries and "
"deploys kamikaze drones of various types.  The dark green paint job marks "
"the lethal and feared military variant, carrying extreme and deadly "
"firepower."
msgstr ""
"El Despacho Northrop, diseñado para situaciones de control de multitudes, "
"transporta y despliega drones kamikaze de varios tipos. La pintura verde "
"oscuro marca la letal y temida variante militar, que lleva una potencia de "
"fuego extrema y mortal."

#: lang/json/MONSTER_from_json.py
msgid "autonomous drone"
msgid_plural "autonomous drones"
msgstr[0] "dron autónomo"
msgstr[1] "drones autónomos"

#: lang/json/MONSTER_from_json.py
msgid "EMP hack"
msgid_plural "EMP hacks"
msgstr[0] "hack EMP"
msgstr[1] "hacks EMP"

#. ~ Description for EMP hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have an "
"EMP grenade inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada EMP en su interior."

#: lang/json/MONSTER_from_json.py
msgid "C-4 hack"
msgid_plural "C-4 hacks"
msgstr[0] "hack C-4"
msgstr[1] "hacks C-4"

#. ~ Description for C-4 hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have "
"some C-4 inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" algo de C-4 en su interior."

#: lang/json/MONSTER_from_json.py
msgid "flashbang hack"
msgid_plural "flashbang hacks"
msgstr[0] " hack explosión cegadora"
msgstr[1] " hacks explosión cegadora"

#. ~ Description for flashbang hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"flashbang inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada cegadora en su interior."

#: lang/json/MONSTER_from_json.py
msgid "tear gas hack"
msgid_plural "tear gas hacks"
msgstr[0] "hack gas lacrimógeno"
msgstr[1] "hacks gas lacrimógeno"

#. ~ Description for tear gas hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"tear gas canister inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" un contenedor de gas lacrimógeno en su interior."

#: lang/json/MONSTER_from_json.py
msgid "grenade hack"
msgid_plural "grenade hacks"
msgstr[0] "hack granada"
msgstr[1] "hacks granada"

#. ~ Description for grenade hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have a "
"grenade inside."
msgstr ""
"Un dron kamikaze automatizado, este pequeño robot cuadricóptero parece tener"
" una granada en su interior."

#: lang/json/MONSTER_from_json.py
msgid "manhack"
msgid_plural "manhacks"
msgstr[0] "manhack"
msgstr[1] "manhacks"

#. ~ Description for manhack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated anti-personnel drone, a small quadcopter robot surrounded by "
"whirring blades."
msgstr ""
"Un dron antipersona automatizado, un pequeño robot cuadricóptero rodeado de "
"cuchillas zumbantes."

#: lang/json/MONSTER_from_json.py
msgid "mininuke hack"
msgid_plural "mininuke hacks"
msgstr[0] "hack mininuke"
msgstr[1] "hacks mininuke"

#. ~ Description for mininuke hack
#: lang/json/MONSTER_from_json.py
msgid ""
"Many times as large as a normal manhack, this flying quadcopter drone "
"appears to have a mininuke inside.  If this is targeting you…  Run."
msgstr ""
"Muchas veces más grande que una manhack normal, este avión teledirigido "
"parece tener un mininuke en su interior. Si esto te está apuntando... Corre."

#: lang/json/MONSTER_from_json.py
msgid "balloon sniper-drone"
msgid_plural "balloon sniper-drones"
msgstr[0] "globo francotiradore-dron"
msgstr[1] "globos francotiradore-dron"

#. ~ Description for balloon sniper-drone
#: lang/json/MONSTER_from_json.py
msgid ""
"This unusual contraption looks like a combination of a weather balloon and a"
" quadcopter.  Beneath the crude box containing its components hangs a small "
"articulated rig wielding an integrated rifle.  Its propellers flicker to "
"life briefly, then shut down again, keeping it mostly stationary despite the"
" air currents.  It looks capable of hanging in the air for quite a long time"
" before running out of power."
msgstr ""
"Este inusual artilugio parece una combinación de un globo meteorológico y un"
" cuadricóptero. Debajo de la caja cruda que contiene sus componentes cuelga "
"un pequeño aparejo articulado con un rifle integrado. Sus hélices parpadean "
"brevemente y luego se apagan de nuevo, manteniéndolo casi inmóvil a pesar de"
" las corrientes de aire. Parece capaz de permanecer en el aire durante mucho"
" tiempo antes de quedarse sin energía."

#: lang/json/MONSTER_from_json.py
msgid "tick!"
msgstr "¡tick!"

#: lang/json/MONSTER_from_json.py
msgid "tazer hack"
msgid_plural "tazer hacks"
msgstr[0] "tazer-hack"
msgstr[1] "tazer-hacks"

#. ~ Description for tazer hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated drone, this small quadcopter robot appears to have a tazer "
"strapped to the front.  While extremely fast, it is very fragile."
msgstr ""
"Un dron automatizado, este pequeño robot cuadricóptero parece tener un tazer"
" sujeto a la parte delantera. Aunque es extremadamente rápido, es muy "
"frágil."

#: lang/json/MONSTER_from_json.py
msgid "feral human"
msgid_plural "feral humans"
msgstr[0] "humano salvaje"
msgstr[1] "humanos salvajes"

#. ~ Description for feral human
#: lang/json/MONSTER_from_json.py
msgid ""
"Their pupils are dilated and what remains to be seen of the iris and sclera "
"are bloodshot.  This pipe-wielding maniac still breathes, but the zombies "
"treat them like one of their own."
msgstr ""
"Sus pupilas están dilatadas y lo que queda visible del iris y la esclerótica"
" aparece ensangrentado. Este maníaco que empuña la tubería todavía respira, "
"pero los zombis lo tratan como a uno de los suyos."

#: lang/json/MONSTER_from_json.py
msgid "The feral human throws a rock!"
msgstr "¡El humano salvaje lanza una piedra!"

#: lang/json/MONSTER_from_json.py
msgid ""
"Their pupils are dilated and what remains to be seen of the iris and sclera "
"are bloodshot.  This crowbar-wielding maniac still breathes, but the zombies"
" treat them like one of their own."
msgstr ""
"Sus pupilas están dilatadas y lo que queda visible del iris y la esclerótica"
" aparece ensangrentado. Este maníaco que empuña una palanca todavía respira,"
" pero los zombis lo tratan como a uno de los suyos."

#: lang/json/MONSTER_from_json.py
msgid ""
"Their pupils are dilated and what remains to be seen of the iris and sclera "
"are bloodshot.  This axe-wielding maniac still breathes, but the zombies "
"treat them like one of their own."
msgstr ""
"Sus pupilas están dilatadas y lo que queda visible del iris y la esclerótica"
" aparece ensangrentado. Este maníaco que empuña un hacha todavía respira, "
"pero los zombis lo tratan como a uno de los suyos."

#: lang/json/MONSTER_from_json.py
msgid "mad scientist"
msgid_plural "mad scientists"
msgstr[0] "científico loco"
msgstr[1] "científicos locos"

#. ~ Description for mad scientist
#: lang/json/MONSTER_from_json.py
msgid ""
"A researcher who has stared too long into the abyss, and now shambles about "
"muttering nonsense under their breath.  For some reason, the zombies don't "
"seem to mind that this person is obviously still alive.  They're clutching a"
" tiny but razor-sharp blade in one shaky hand."
msgstr ""
"Un investigador que ha mirado demasiado tiempo al abismo, y que ahora se "
"tambalea murmurando sin sentidos bajo su respiración. Por alguna razón, a "
"los zombis no parece importarles que esta persona esté obviamente viva. Los "
"suyos sostienen una hoja diminuta pero afilada en su mano temblorosa."

#: lang/json/MONSTER_from_json.py
msgid "feral security guard"
msgid_plural "feral security guards"
msgstr[0] "guardia de seguridad salvaje"
msgstr[1] "guardias de seguridad salvajes"

#. ~ Description for feral security guard
#: lang/json/MONSTER_from_json.py
msgid ""
"This security guard still breathes, but has been lost to some terrible "
"madness.  They move among the undead, handgun at the ready and saucer pupils"
" scanning for threats in a mockery of their former duty."
msgstr ""
"Este guardia de seguridad aún respira, pero se ha perdido en medio de una "
"terrible locura. Los suyos se mueven entre los muertos vivientes, con la "
"pistola en ristre y las pupilas en forma de platillos escudriñando en busca "
"de amenazas en un remedo de su antiguo deber."

#: lang/json/MONSTER_from_json.py
msgid "The feral security guard fires their Beretta M9A1!"
msgstr "¡El guardia de seguridad salvaje dispara su Beretta M9A1!"

#: lang/json/MONSTER_from_json.py
msgid ""
"At first glance, this disheveled figure could almost pass for a survivor, "
"but the bloodshot eyes give them away as one of the humans who have gone "
"feral and joined the undead without dying.  Their uniform suggests that this"
" was at some point a security guard, and they still carry a stun gun and a "
"heavy-duty flashlight that looks like it could easily double as a club."
msgstr ""
"A primera vista, esta figura desaliñada casi podría pasar por un "
"superviviente, pero los ojos inyectados en sangre lo delatan como uno de los"
" humanos que se han vuelto salvajes y se han unido a los no muertos sin "
"morir. Su uniforme sugiere que en algún momento fue un guardia de seguridad,"
" y todavía lleva una pistola de aturdimiento y una linterna de gran potencia"
" que parece que podría servir de garrote."

#: lang/json/MONSTER_from_json.py
msgid "alpha razorclaw"
msgid_plural "alpha razorclaws"
msgstr[0] "alfa garracuchilla"
msgstr[1] "alfa garracuchillas"

#. ~ Description for alpha razorclaw
#: lang/json/MONSTER_from_json.py
msgid ""
"A blood-red, gigantic razorclaw.  Its sword-like pincers serve as the "
"keepers of the nest."
msgstr ""
"Un garracuchilla gigante de color rojo sangre. Sus pinzas en forma de espada"
" sirven como guardianes del nido."

