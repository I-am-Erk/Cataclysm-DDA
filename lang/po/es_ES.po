"protegiéndola a la vez que aumenta el poder de ataque. Hay una runa de "
"Terraformante incrustada en la palma."

#: lang/json/GENERIC_from_json.py
msgid "The Stormhammer"
msgid_plural "The Stormhammers"
msgstr[0] " El martillo de la tormenta"
msgstr[1] "Los martillos de la tormenta"

#. ~ Description for The Stormhammer
#: lang/json/GENERIC_from_json.py
msgid ""
"A crackling magical warhammer full of lightning to smite your foes with, and"
" of course, smash things to bits!"
msgstr ""
"Un crepitante martillo mágico lleno de relámpagos para golpear a tus "
"enemigos y, por supuesto, aplastar cosas en trocitos."

#: lang/json/GENERIC_from_json.py lang/json/SPELL_from_json.py
