#: lang/json/ARMOR_from_json.py
msgid "plug"
msgid_plural "plugs"
msgstr[0] "carrete de oreja"
msgstr[1] "carretes de oreja"

#. ~ Description for plug
#: lang/json/ARMOR_from_json.py
msgid ""
"Those round things people plug into their earlobes as earrings, also called "
"\"ear plug\" or \"ear spool.\"  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Esas cosas redondas que la gente se enchufa en los lóbulos de las orejas "
"como pendientes, también llamados \"tapones de oreja\" o \"carretes de "
"oreja\". Puedes usarlo si quieres, pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold bracelet"
msgid_plural "gold bracelets"
msgstr[0] "pulsera de oro"
msgstr[1] "pulseras de oro"

#. ~ Description for gold bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A fancy golden bracelet.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Una elegante pulsera de oro. Te la puedes poner si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold dental grill"
msgid_plural "gold dental grills"
msgstr[0] "parrilla dental de oro"
msgstr[1] "parrillas dentales de oro"

#. ~ Description for gold dental grill
#: lang/json/ARMOR_from_json.py
msgid ""
"Fake golden teeth, worn over the teeth.  Fits horribly, but looks very "
"shiny."
msgstr ""
"Dientes falsos de oro que se llevan sobre los dientes. Quedan horribles, "
"pero son muy brillantes."

#: lang/json/ARMOR_from_json.py
msgid "pair of gold earrings"
msgid_plural "pairs of gold earrings"
msgstr[0] "par de pendientes de oro"
msgstr[1] "pares de pendientes de oro"

#. ~ Description for pair of gold earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of shiny gold earrings.  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Un par de pendientes de oro brillante. Puedes ponértelo si quieres, pero no "
"te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold hairpin"
msgid_plural "gold hairpins"
msgstr[0] "horquilla de oro"
msgstr[1] "horquillas de oro"

#. ~ Description for gold hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold hairpin, designed by the rich, for the rich.  You can wear it if you "
"like, but it won't provide any effects."
msgstr ""
"Una horquilla de oro, diseñada por los ricos, para los ricos. Puedes usarla "
"si quieres, pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold locket"
msgid_plural "gold lockets"
msgstr[0] "medallón de oro"
msgstr[1] "medallones de oro"

#. ~ Description for gold locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A heart-shaped, gold locket with a frame inside to store photographs or "
"small objects.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Un medallón de oro en forma de corazón con un marco en su interior para "
"guardar fotografías u objetos pequeños. Puedes usarlo si quieres, pero no te"
" proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold medal"
msgid_plural "gold medals"
msgstr[0] "medalla de oro"
msgstr[1] "medallas de oro"

#. ~ Description for gold medal
#: lang/json/ARMOR_from_json.py
msgid ""
"A medal awarded for achieving first place in some event.  Before everything "
"fell apart, this could be a source of pride for its owner.  Now it's just "
"another shiny bauble."
msgstr ""
"Una medalla otorgada por alcanzar el primer lugar en algún evento. Antes de "
"que todo se desmoronara, esto podría ser un motivo de orgullo para su "
"propietario. Ahora es sólo otra brillante baratija."

#: lang/json/ARMOR_from_json.py
msgid "gold necklace"
msgid_plural "gold necklaces"
msgstr[0] "collar de oro"
msgstr[1] "collares de oro"

#. ~ Description for gold necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A shiny, unadorned gold necklace.  You can wear it if you like, but it won't"
" provide any effects."
msgstr ""
"Un collar de oro brillante y sin adornos. Puedes usarlo si quieres, pero no "
"te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold ring"
msgid_plural "gold rings"
msgstr[0] "anillo de oro"
msgstr[1] "anillos de oro"

#. ~ Description for gold ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A flashy gold ring.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Un llamativo anillo de oro. Te lo puedes poner si quieres, pero no te "
"proporcionará ningun efecto."

#: lang/json/ARMOR_from_json.py
msgid "gold watch"
msgid_plural "gold watches"
msgstr[0] "reloj de oro"
msgstr[1] "relojes de oro"

#. ~ Description for gold watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold-plated steel self-winding wristwatch, suitable for a retirement "
"present.  Tells the time and looks good."
msgstr ""
"Un reloj automático de acero recubierto en oro, muy adecuado como regalo de "
"jubilación. Nos dice la hora y es bonito."

#: lang/json/ARMOR_from_json.py
msgid "tie clip"
msgid_plural "tie clips"
msgstr[0] "alfiler de corbata"
msgstr[1] "alfileres de corbata"

#. ~ Description for tie clip
#: lang/json/ARMOR_from_json.py
msgid ""
"A fancy silver tie clip, a great match for your skinny tie.  You can wear it"
" if you like, but it won't provide any effects."
msgstr ""
"Un elegante clip de plata para la corbata, un gran complemento para tu "
"corbata delgada. Puedes usarlo si quieres, pero no te proporcionará ningún "
"efecto."

#: lang/json/ARMOR_from_json.py
msgid "silver watch"
msgid_plural "silver watches"
msgstr[0] "reloj de plata"
msgstr[1] "relojes de plata"

#. ~ Description for silver watch
#: lang/json/ARMOR_from_json.py
msgid ""
"An elegant silver watch, crafted from silver-plated stainless steel.  It's "
"much cheaper than other metal watches, and more classy than an ordinary "
"wristwatch."
msgstr ""
"Un elegante reloj de plata, hecho a mano con acero inoxidable plateado. Es "
"mucho más barato que otros relojes de metal, y más elegante que un reloj de "
"pulsera ordinario."

#: lang/json/ARMOR_from_json.py
msgid "silver bracelet"
msgid_plural "silver bracelets"
msgstr[0] "pulsera de plata"
msgstr[1] "pulseras de plata"

#. ~ Description for silver bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A nice silver bracelet.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Una bonita pulsera de plata. Te la puedes poner si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "pair of silver earrings"
msgid_plural "pairs of silver earrings"
msgstr[0] "par de pendientes de plata"
msgstr[1] "pares de pendientes de plata"

#. ~ Description for pair of silver earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of beautiful silver earrings.  You can wear it if you like, but it "
"won't provide any effects."
msgstr ""
"Un par de hermosos pendientes de plata. Puedes ponértelos si quieres, pero "
"no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "fancy watch"
msgid_plural "fancy watches"
msgstr[0] "reloj de lujo"
msgstr[1] "relojes de lujo"

#. ~ Description for fancy watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A rather large and expensively made wristwatch.  Tells the time in elegantly"
" wrought gold with silver detailing.  It's really the only timepiece "
"suitable for someone of your exquisitely discerning tastes."
msgstr ""
"Un reloj de pulsera bastante grande y caro. Da la hora en oro elegantemente "
"forjado con detalles en plata. Es realmente el único reloj adecuado para "
"alguien de tus exquisitos gustos."

#: lang/json/ARMOR_from_json.py
msgid "small relic"
msgid_plural "small relics"
msgstr[0] "pequeña reliquia"
msgstr[1] "pequeñas reliquias"

#. ~ Description for small relic
#: lang/json/ARMOR_from_json.py
msgid ""
"A small relic from a forgotten saint.  As extraordinary as the world has "
"become it may have some power yet."
msgstr ""
"Una pequeña reliquia de algún santo ya olvidado. Pero como el mundo se ha "
"convertido en algo tan extraordinario, quizás esto tenga algún poder."

#: lang/json/ARMOR_from_json.py
msgid "holy symbol"
msgid_plural "holy symbols"
msgstr[0] "símbolo sagrado"
msgstr[1] "símbolos sagrados"

#. ~ Description for holy symbol
#: lang/json/ARMOR_from_json.py
msgid ""
"A necklace made of fine gold chain bearing the symbol of a forgotten faith."
msgstr ""
"Un collar hecho con una buena cadena de oro, y con el símbolo de alguna fe "
"ya olvidada."

#: lang/json/ARMOR_from_json.py
msgid "handmade holy symbol"
msgid_plural "handmade holy symbols"
msgstr[0] "símbolo sagrado hecho a mano"
msgstr[1] "símbolos sagrados hechos a mano"

#. ~ Description for handmade holy symbol
#: lang/json/ARMOR_from_json.py
msgid "A simple necklace representing a religious faith."
msgstr "Un collar simple que representa alguna fe religiosa."

#: lang/json/ARMOR_from_json.py
msgid "jade brooch"
msgid_plural "jade brooches"
msgstr[0] "broche de jade"
msgstr[1] "broches de jade"

#. ~ Description for jade brooch
#: lang/json/ARMOR_from_json.py
msgid ""
"A hand-crafted jade brooch of Oriental origin.  You can wear it if you like,"
" but it won't provide any effects."
msgstr ""
"Un broche de jade hecho a mano de origen oriental. Puedes usarlo si quieres,"
" pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "pearl collar"
msgid_plural "pearl collars"
msgstr[0] "collar de perlas"
msgstr[1] "collares de perlas"

#. ~ Description for pearl collar
#: lang/json/ARMOR_from_json.py
msgid ""
"A collar made from round and lustrous pearls, its former owner must be a "
"wealthy individual."
msgstr ""
"Un collar hecho de refulgentes perlas redondas, su antiguo propietario debió"
" ser un individuo rico."

#: lang/json/ARMOR_from_json.py
msgid "platinum watch"
msgid_plural "platinum watches"
msgstr[0] "reloj de platino"
msgstr[1] "relojes de platino"

#. ~ Description for platinum watch
#: lang/json/ARMOR_from_json.py
msgid ""
"Flex on those gold-watch wearers with the rare, expensive and superior "
"platinum watch.  This one is made from solid platinum."
msgstr ""
"Impresiona a los que usan relojes de oro con el raro, caro y superior reloj "
"de platino. Este está hecho de platino sólido."

#: lang/json/ARMOR_from_json.py
msgid "platinum bracelet"
msgid_plural "platinum bracelets"
msgstr[0] "pulsera de platino"
msgstr[1] "pulseras de platino"

#. ~ Description for platinum bracelet
#: lang/json/ARMOR_from_json.py
msgid ""
"A flawless platinum bracelet.  You can wear it if you like, but it won't "
"provide any effects."
msgstr ""
"Una perfecta pulsera de platino. Puedes usarla si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "platinum dental grill"
msgid_plural "platinum dental grills"
msgstr[0] "parrila dental de platino"
msgstr[1] "parrilas dentales de platino"

#. ~ Description for platinum dental grill
#: lang/json/ARMOR_from_json.py
msgid ""
"Fake platinum-and-silver teeth.  They may be cheaper than fake gold teeth, "
"but they're much more rare.  Fits horribly, but looks very shiny."
msgstr ""
"Dientes falsos de platino y plata. Pueden ser más baratos que los dientes de"
" oro falsos, pero son mucho más raros. Quedan horribles, pero son muy "
"brillantes."

#: lang/json/ARMOR_from_json.py
msgid "pair of platinum earrings"
msgid_plural "pairs of platinum earrings"
msgstr[0] "par de pendientes de platino"
msgstr[1] "pares de pendientes de platino"

#. ~ Description for pair of platinum earrings
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of plain platinum earrings - if gold is getting boring, just use "
"another rare metal.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Un par de pendientes de platino simple. Si el oro se está volviendo "
"aburrido, solo usa otro metal raro. Puedes usarlo si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "platinum hairpin"
msgid_plural "platinum hairpins"
msgstr[0] "horquilla de platino"
msgstr[1] "horquillas de platino"

#. ~ Description for platinum hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"The ultimate in esoteric, metal hair accessories, this hairpin is made from "
"pure platinum.  You can wear it if you like, but it won't provide any "
"effects."
msgstr ""
"Lo último en accesorios esotéricos de metal para el cabello, esta horquilla "
"está hecha de platino puro. Puedes usarla si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "platinum locket"
msgid_plural "platinum lockets"
msgstr[0] "medallón de platino"
msgstr[1] "medallones de platino"

#. ~ Description for platinum locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A small, platinum locket for storing photographs or other small objects.  "
"You can wear it if you like, but it won't provide any effects."
msgstr ""
"Un pequeño medallón de platino para almacenar fotografías u otros objetos "
"pequeños. Puedes usarlo si quieres, pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "platinum necklace"
msgid_plural "platinum necklaces"
msgstr[0] "collar de platino"
msgstr[1] "collares de platino"

#. ~ Description for platinum necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A platinum necklace, with a small, empty heart frame hanging from a chain.  "
"You can wear it if you like, but it won't provide any effects."
msgstr ""
"Un collar de platino, con un pequeño marco con forma de corazón vacío "
"colgando de una cadena. Puedes usarlo si quieres, pero no te proporcionará "
"ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "platinum ring"
msgid_plural "platinum rings"
msgstr[0] "anillo de platino"
msgstr[1] "anillos de platino"

#. ~ Description for platinum ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A platinum ring, engraved with all manner of swirls and spirals.  You can "
"wear it if you like, but it won't provide any effects."
msgstr ""
"Un anillo de platino, grabado con todo tipo de remolinos y espirales. Puedes"
" usarlo si quieres, pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "engagement ring"
msgid_plural "engagement rings"
msgstr[0] "anillo de compromiso"
msgstr[1] "anillos de compromiso"

#. ~ Description for engagement ring
#: lang/json/ARMOR_from_json.py
msgid ""
"This ring is an intricate gold band, with a small cluster of diamonds set in"
" the center.  Before the world broke down, this ring would've cost a small "
"fortune."
msgstr ""
"Este anillo es una intrincada banda de oro, con un pequeño grupo de "
"diamantes en el centro. Antes de que el mundo se descompusiera, este anillo "
"habría costado una pequeña fortuna."

#: lang/json/ARMOR_from_json.py
msgid "purity ring"
msgid_plural "purity rings"
msgstr[0] "anillo de pureza"
msgstr[1] "anillos de pureza"

#. ~ Description for purity ring
#: lang/json/ARMOR_from_json.py
msgid ""
"Also known as a promise ring, this ring is worn as a sign of chastity.  This"
" one bears the inscription, \"Love is patient.\""
msgstr ""
"También conocido como anillo de promesa, este anillo se lleva como signo de "
"castidad. Este lleva la inscripción, \"El amor es paciente\"."

#: lang/json/ARMOR_from_json.py
msgid "signet ring"
msgid_plural "signet rings"
msgstr[0] "anillo de sello"
msgstr[1] "anillos de sello"

#. ~ Description for signet ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A gold and silver ring with a wide stamp attached to the band.  A long time "
"ago, the stamp was legible, but now the pattern is too worn to discern its "
"former use."
msgstr ""
"Un anillo de oro y plata con un amplio sello unido a la banda. Hace mucho "
"tiempo, el sello era legible, pero ahora el patrón está demasiado gastado "
"para conocer su uso previo."

#: lang/json/ARMOR_from_json.py
msgid "wedding ring"
msgid_plural "wedding rings"
msgstr[0] "anillo de boda"
msgstr[1] "anillos de boda"

#. ~ Description for wedding ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A flawless ring, ensnaring a diamond with twists of pure gold.  It's a "
"constant reminder that the wearer is married."
msgstr ""
"Un anillo perfecto, con un diamante incrustado en oro puro. Un recordatorio "
"constante de que quien lo lleva está casado."

#: lang/json/ARMOR_from_json.py
msgid "silver necklace"
msgid_plural "silver necklaces"
msgstr[0] "collar de plata"
msgstr[1] "collares de plata"

#. ~ Description for silver necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A nice silver necklace.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Un lindo collar de plata. Te lo puedes poner si quieres, pero no te "
"proporcionará ningun efecto."

#: lang/json/ARMOR_from_json.py
msgid "silver hairpin"
msgid_plural "silver hairpins"
msgstr[0] "horquilla de plata"
msgstr[1] "horquillas de plata"

#. ~ Description for silver hairpin
#: lang/json/ARMOR_from_json.py
msgid ""
"A shiny, silver hairpin with a tiny bee engraved onto it.  You can wear it "
"if you like, but it won't provide any effects."
msgstr ""
"Una brillante horquilla plateada con una pequeña abeja grabada en ella. "
"Puedes usarla si quieres, pero no te proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "silver locket"
msgid_plural "silver lockets"
msgstr[0] "medallón de plata"
msgstr[1] "medallones de plata"

#. ~ Description for silver locket
#: lang/json/ARMOR_from_json.py
msgid ""
"A small, silver locket with a frame inside to store photographs or small "
"objects.  You can wear it if you like, but it won't provide any effects."
msgstr ""
"Un pequeño medallón de plata con un marco en su interior para guardar "
"fotografías u objetos pequeños. Puedes usarlo si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "silver medal"
msgid_plural "silver medals"
msgstr[0] "medalla de plata"
msgstr[1] "medallas de plata"

#. ~ Description for silver medal
#: lang/json/ARMOR_from_json.py
msgid ""
"A medal awarded for achieving second place in some event.  Before everything"
" fell apart, this could be a source of pride for its owner.  Now it's just "
"another shiny bauble."
msgstr ""
"Una medalla otorgada por alcanzar el segundo lugar en algún evento. Antes de"
" que todo se desmoronara, esto podría ser un motivo de orgullo para su "
"propietario. Ahora es sólo otra brillante baratija."

#: lang/json/ARMOR_from_json.py
msgid "silver ring"
msgid_plural "silver rings"
msgstr[0] "anillo de plata"
msgstr[1] "anillos de plata"

#. ~ Description for silver ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple, silver ring.  You can wear it if you like, but it won't provide "
"any effects."
msgstr ""
"Un simple anillo de plata. Puedes usarlo si quieres, pero no te "
"proporcionará ningún efecto."

#: lang/json/ARMOR_from_json.py
msgid "leather collar"
msgid_plural "leather collars"
msgstr[0] "collar de cuero"
msgstr[1] "collares de cuero"

#. ~ Description for leather collar
#: lang/json/ARMOR_from_json.py
msgid ""
"A black leather 'collar' with a bell dangling from the front.  Don't worry, "
"the bell is silent."
msgstr ""
"Un collar negro de cuero con una campana colgando en la parte de adelante. "
"No te preocupes,  la campana no hace ruido."

#: lang/json/ARMOR_from_json.py
msgid "wrist watch"
msgid_plural "wrist watches"
msgstr[0] "reloj de pulsera"
msgstr[1] "relojes de pulsera"

#. ~ Description for wrist watch
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple wristwatch on a plastic band.  Tells the time and has an alarm "
"clock feature."
msgstr ""
"Un reloj de pulsera normal, con correa de plástico. Además de mostrarte la "
"hora tiene alarma."

#: lang/json/ARMOR_from_json.py
msgid "radiation badge"
msgid_plural "radiation badges"
msgstr[0] "placa dosimétrica"
msgstr[1] "placas dosimétricas"

#. ~ Description for radiation badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic badge with an embedded filmstrip.  The filmstrip changes color as "
"it is exposed to radiation.  Wear on your lapel so you can notice if it "
"changes."
msgstr ""
"Una placa de plástico con una tira de película incrustada. La tira de "
"película cambia de color cuando se expone a la radiación. Llévalo en tu "
"solapa para que puedas notar si cambia."

#: lang/json/ARMOR_from_json.py
msgid "badge template"
msgid_plural "badge templates"
msgstr[0] "plantilla de placa"
msgstr[1] "plantillas de placas"

#. ~ Description for badge template
#: lang/json/ARMOR_from_json.py
msgid ""
"This is a template for police/medical badges.  If found in a game, it is a "
"bug."
msgstr ""
"Esta es una plantilla para las insignias de policía/médico. Si se encuentra "
"en un juego, es un error."

#: lang/json/ARMOR_from_json.py
msgid "cybercop badge"
msgid_plural "cybercop badges"
msgstr[0] "placa de ciberpolicía"
msgstr[1] "placas de ciberpolicía"

#. ~ Description for cybercop badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A chromed silver shield identifies the wearer as an authority even the cop-"
"killers couldn't kill."
msgstr ""
"Un escudo plateado cromado identifica al portador como una autoridad que ni "
"siquiera los asesinos de policías podrían matar."

#: lang/json/ARMOR_from_json.py
msgid "deputy badge"
msgid_plural "deputy badges"
msgstr[0] "placa de ayudante de sheriff"
msgstr[1] "placas de ayudante de sheriff"

#. ~ Description for deputy badge
#: lang/json/ARMOR_from_json.py
msgid "A tarnished silver star gives an air of authority to the wearer."
msgstr ""
"Una estrella de plata sin brillo, pero otorga un aire de autoridad a quien "
"la lleva."

#: lang/json/ARMOR_from_json.py
msgid "detective badge"
msgid_plural "detective badges"
msgstr[0] "placa de detective"
msgstr[1] "placas de detective"

#. ~ Description for detective badge
#: lang/json/ARMOR_from_json.py
msgid "A tarnished golden shield gives an air of authority to the wearer."
msgstr ""
"Una estrella dorada sin brillo, pero otorgua un aire de autoridad a quien la"
" lleva."

#: lang/json/ARMOR_from_json.py
msgid "marshal badge"
msgid_plural "marshal badges"
msgstr[0] "placa de alguacil"
msgstr[1] "placas de alguacil"

#. ~ Description for marshal badge
#: lang/json/ARMOR_from_json.py
msgid "A bright silver star strikes fear into the eyes of ne'er-do-wells."
msgstr ""
"Una estrella de plata brillante infunde miedo en los ojos de los "
"malhechores."

#: lang/json/ARMOR_from_json.py
msgid "SWAT badge"
msgid_plural "SWAT badges"
msgstr[0] "placa SWAT"
msgstr[1] "placas SWAT"

#. ~ Description for SWAT badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A matte-finish silver shield identifies the wearer as an authority who goes "
"in when the bots just aren't enough."
msgstr ""
"Una placa plateada con acabado mate identifica a quien la lleva como uno de "
"esos oficiales que va donde los robots no son suficientes."

#: lang/json/ARMOR_from_json.py
msgid "doctor badge"
msgid_plural "doctor badges"
msgstr[0] "placa de médico"
msgstr[1] "placas de médico"

#. ~ Description for doctor badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic name tag marking the wearer as a real doctor of the medical kind."
msgstr ""
"Una etiqueta de plástico con el nombre que marca al portador como un "
"verdadero doctor del tipo médico."

#: lang/json/ARMOR_from_json.py
msgid "Foodkid badge"
msgid_plural "Foodkid badges"
msgstr[0] "placa de NiñoComida"
msgstr[1] "placas de NiñoComida"

#. ~ Description for Foodkid badge
#: lang/json/ARMOR_from_json.py
msgid ""
"A star shaped badge.  On it, you can read \"Foodkid\" in bold letters.  This"
" is Foodperson's trusty sidekick's badge."
msgstr ""
"Una insignia con forma de estrella. En ella se puede leer \"NiñoComida\" en "
"negrita. Esta es la insignia del fiel compañero de PersonaComida."

#: lang/json/ARMOR_from_json.py
msgid "pair of fuzzy cat ears"
msgid_plural "pairs of fuzzy cat ears"
msgstr[0] "par de orejas peludas de gato"
msgstr[1] "pares de orejas peludas de gato"

#. ~ Description for pair of fuzzy cat ears
#: lang/json/ARMOR_from_json.py
msgid ""
"A fuzzy pair of brownish cat ears on a headband.  It does nothing, but "
"there's no reason not to look good even if no one's looking."
msgstr ""
"Un par de orejas marrones peluditas de gato en una diadema. No sirve para "
"nada, pero uno puede verse bien incluso cuando nadie mira."

