msgid_plural ".308 Winchester"
msgstr[0] ".308 Winchester"
msgstr[1] ".308 Winchester"

#. ~ Description for {'str_sp': '.308 Winchester'}
#: lang/json/AMMO_from_json.py
msgid ""
".308 Winchester ammunition with 168gr hollow point bullets.  The .308 round "
"is one of the most popular hunting cartridges in the world due to its "
"accuracy and power."
msgstr ""
"Munición .308 Winchester con bala de punta hueca de 168gr. La munición .308 "
"es una de las más populares en el mundo para la caza debido a su precisión y"
" poder."

#: lang/json/AMMO_from_json.py
