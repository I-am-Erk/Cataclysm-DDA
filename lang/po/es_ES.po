msgstr[0] "saco de dormir enrollado"
msgstr[1] "sacos de dormir enrollados"

#. ~ Use action menu_text for rolled sleeping bag.
#. ~ Use action menu_text for rolled fur sleeping bag.
#: lang/json/ARMOR_from_json.py
msgid "Unroll"
msgstr "Desenrollar"

#. ~ Use action msg for rolled sleeping bag.
#: lang/json/ARMOR_from_json.py
msgid "You unroll the sleeping bag."
msgstr "Desenrollas el saco de dormir."

#. ~ Description for rolled sleeping bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A large sleeping bag rolled up for transport.  It has a strap to carry it "
"with."
msgstr ""
"Un gran saco de dormir enrollado para su transporte. Tiene una correa para "
"cargarlo."

#: lang/json/ARMOR_from_json.py
msgid "fur sleeping bag"
msgid_plural "fur sleeping bags"
msgstr[0] "saco de dormir de piel"
msgstr[1] "sacos de dormir de piel"

#. ~ Use action menu_text for fur sleeping bag.
#. ~ Use action menu_text for sleeping bag.
#: lang/json/ARMOR_from_json.py
msgid "Roll up"
msgstr "Enrollar"

#. ~ Use action msg for fur sleeping bag.
#: lang/json/ARMOR_from_json.py
msgid "You roll up the fur sleeping bag, preparing it for transport."
msgstr "Enrollas el saco de dormir de piel, preparándolo para su transporte."

#. ~ Description for fur sleeping bag
#: lang/json/ARMOR_from_json.py
msgid "A large sleeping bag lined with fur.  Who needs a tent?"
msgstr ""
"Un saco de dormir grande forrado de piel. ¿Quién necesita una tienda de "
"campaña?"

#: lang/json/ARMOR_from_json.py
msgid "rolled fur sleeping bag"
msgid_plural "rolled fur sleeping bags"
msgstr[0] "saco de dormir de piel enrollado"
msgstr[1] "sacos de dormir de piel enrollados"

#. ~ Use action msg for rolled fur sleeping bag.
#: lang/json/ARMOR_from_json.py
msgid "You unroll up the fur sleeping bag."
msgstr "Desenrollas el saco de dormir de piel."

#. ~ Description for rolled fur sleeping bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A large sleeping bag lined with fur, rolled for transport.  It has a strap "
"to carry it with."
msgstr ""
"Una bolsa de dormir grande forrada de piel, enrollada para su transporte. "
"Tiene una correa para cargarla."

#: lang/json/ARMOR_from_json.py
msgid "bow tie"
msgid_plural "bow ties"
msgstr[0] "pajarita"
msgstr[1] "pajaritas"

#. ~ Description for bow tie
#: lang/json/ARMOR_from_json.py
msgid "A simple black bow tie.  Best worn with a suit."
msgstr "Una simple pajarita negra. Mejor con un traje."

#: lang/json/ARMOR_from_json.py
msgid "clip-on tie"
msgid_plural "clip-on ties"
msgstr[0] "corbata de clip"
msgstr[1] "corbatas de clip"

#. ~ Description for clip-on tie
#: lang/json/ARMOR_from_json.py
msgid ""
"A clip-on necktie, with blue and silver stripes.  It's quick and easy to put"
" on, and much better than the necktie."
msgstr ""
"Una corbata de clip, con rayas azules y plateadas. Rápida y fácil de "
"colocar, y mucho mejor que la corbata."

#: lang/json/ARMOR_from_json.py
msgid "necktie"
msgid_plural "neckties"
msgstr[0] "corbata"
msgstr[1] "corbatas"

#. ~ Description for necktie
#: lang/json/ARMOR_from_json.py
msgid ""
"An ordinary, green necktie.  It's more difficult to put on, but it takes "
"real skill to do so.  Wearing a necktie is much better than wearing a clip-"
"on tie."
msgstr ""
"Una corbata verde común y corriente. Más difícil de poner, pero se necesita "
"verdadera habilidad para hacerlo correctamente. Llevar una corbata es mucho "
"mejor que llevar una corbata de clip."

#: lang/json/ARMOR_from_json.py
msgid "wedding veil"
msgid_plural "wedding veils"
msgstr[0] "velo de boda"
msgstr[1] "velos de boda"

#. ~ Description for wedding veil
#: lang/json/ARMOR_from_json.py
msgid "A lacy white wedding veil."
msgstr "Un velo de encaje blanco de boda."

#: lang/json/ARMOR_from_json.py
msgid "tarpaulin"
msgid_plural "tarpaulins"
msgstr[0] "lona impermeable"
msgstr[1] "lonas impermeables"

#. ~ Description for tarpaulin
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic sheet with several grommets for securing it with rope or cord.  "
"Useful for improvised rain protection."
msgstr ""
"Una tela plástica con varias arandelas para asegurarla con una soga o una "
"cuerda. Útil para improvisar un techo durante la lluvia."

#: lang/json/ARMOR_from_json.py
msgid "pair of saddle bags"
msgid_plural "pairs of saddle bags"
msgstr[0] "par de alforjas"
msgstr[1] "pares de alforjas"

#. ~ Description for pair of saddle bags
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of covered pouches laid across the back of a horse behind the saddle."
msgstr ""
"Un par de bolsas cubiertas puestas en la espalda de un caballo detrás de la "
"silla de montar."

#: lang/json/ARMOR_from_json.py
msgid "salvaged power armor"
msgid_plural "salvaged power armors"
msgstr[0] "armadura de energia reciclada"
msgstr[1] "armaduras de energia recicladas"

#. ~ Description for salvaged power armor
#: lang/json/ARMOR_from_json.py
msgid ""
"This used to be a powered exoskeleton with a set of heavy armor plates, made"
" wearable by the assist of the servos.  Now it's just the armor plating and "
"a stripped down chassis: as one might expect, it's a lot harder to wear."
msgstr ""
"Este solía ser un exoesqueleto de energia con un conjunto de pesadas placas "
"de armadura, que se podían llevar con la asistencia de servos. Ahora es sólo"
" el blindaje y un chasis desmontado: como se podría esperar, es mucho más "
"difícil de llevar."

#: lang/json/ARMOR_from_json.py
msgid "salvaged power armor helmet"
msgid_plural "salvaged power armor helmets"
msgstr[0] "casco de arm. de energía reciclado"
msgstr[1] "cascos de arm. de energía reciclados"

#. ~ Description for salvaged power armor helmet
#: lang/json/ARMOR_from_json.py
msgid ""
"This used to be a military-grade full-head helmet with advanced optics and "
"environmental filters.  It looks like it was decommissioned or otherwise "
"stripped for parts; now it's a very expensive hat.  It's still quite "
"durable, but quite hard to see out of."
msgstr ""
"Este solía ser un casco de cabeza completa de grado militar con óptica "
"avanzada y filtros ambientales. Parece que fue retirado del servicio o "
"desarmado por partes; ahora es un sombrero muy caro. Sigue siendo bastante "
"resistente, pero es bastante difícil ver a través de él."

#: lang/json/ARMOR_from_json.py
msgid "power armor hauling frame"
msgid_plural "power armor hauling frames"
msgstr[0] "armazón de armadura de energía"
msgstr[1] "armazones de armadura de energía"

#. ~ Description for power armor hauling frame
#: lang/json/ARMOR_from_json.py
msgid ""
"A heavy duty hauling frame designed to interface with military exoskeletons."
msgstr ""
"Un armazón de gran resistencia diseñada para conectarse a exoesqueletos "
"militares."

#: lang/json/ARMOR_from_json.py
msgid "environmental combat helmet"
msgid_plural "environmental combat helmets"
msgstr[0] "casco de combate ambiental"
msgstr[1] "cascos de combate ambiental"

#. ~ Description for environmental combat helmet
#: lang/json/ARMOR_from_json.py
msgid ""
"A fully enclosed combat helmet for hazardous environments, this was designed"
" to fit with a powered exoskeleton, using cameras to expand visual range.  "
"In practice, the cameras were unreliable and easily fouled.  The "
"environmental controls function best with direct-skin contact."
msgstr ""
"Un casco de combate totalmente cerrado para entornos peligrosos, diseñado "
"para acoplarse a un exoesqueleto motorizado, que utiliza cámaras para "
"ampliar el alcance visual. En la práctica, las cámaras eran poco fiables y "
"se ensuciaban con facilidad. Los controles ambientales funcionan mejor con "
"contacto directo con la piel."

#: lang/json/ARMOR_from_json.py
msgid "heavy environmental combat helmet"
msgid_plural "heavy environmental combat helmets"
msgstr[0] "casco de combate ambiental pesado"
msgstr[1] "cascos de combate ambiental pesado"

#. ~ Description for heavy environmental combat helmet
#: lang/json/ARMOR_from_json.py
msgid ""
"An extremely heavy-duty fully enclosed combat helmet for hazardous "
"environments, this was designed to fit with a powered exoskeleton.  In the "
"field, soldiers reported that the protection was not worth the awkward size "
"and limited visuals.  The environmental controls function best with direct-"
"skin contact."
msgstr ""
"Un casco de combate extremadamente resistente y totalmente cerrado para "
"entornos peligrosos, diseñado para adaptarse a un exoesqueleto motorizado. "
"En el campo, los soldados informaron de que la protección no merecía la pena"
" por su incómodo tamaño y su limitada visibilidad. Los controles ambientales"
" funcionan mejor con contacto directo con la piel."

#: lang/json/ARMOR_from_json.py
msgid "light environmental combat helmet"
msgid_plural "light environmental combat helmets"
msgstr[0] "casco de combate ambiental ligero"
msgstr[1] "cascos de combate ambiental ligero"

#. ~ Description for light environmental combat helmet
#: lang/json/ARMOR_from_json.py
msgid ""
"This full-enclosure helmet was designed based on commercial diving "
"equipment, in response to complaints that earlier designs were impossible to"
" use in combat.  While still a little more restrictive than regular combat "
"headgear - and frustrating should your nose itch - this one received far "
"better reviews from soldiers.  Sadly, civilization ended before they could "
"roll out in significant numbers.  The environmental controls function best "
"with direct-skin contact."
msgstr ""
"Este casco de totalmente cerrado fue diseñado sobre la base de equipos "
"comerciales de buceo, en respuesta a las quejas de que los diseños "
"anteriores eran imposibles de usar en combate. Aunque sigue siendo un poco "
"más restrictivo que los cascos de combate normal - y frustrante si te pica "
"la nariz - este recibió de lejos mejores críticas de los soldados. "
"Lamentablemente, la civilización terminó antes de que pudieran desplegarse "
"en cantidades significativas. Los controles ambientales funcionan mejor en "
"contacto directo con la piel."

#: lang/json/ARMOR_from_json.py
msgid "knit cowl"
msgid_plural "knit cowls"
msgstr[0] "cuello vuelto de lana"
msgstr[1] "cuellos vueltos de lana"

#. ~ Description for knit cowl
#: lang/json/ARMOR_from_json.py
msgid ""
"A snuggly woolen cowl.  It's one of those stylish and bulky cowls you see in"
" fashion magazines."
msgstr ""
"Un cuello abrigado de lana. Es uno de esos cuellos con estilo y voluminosos "
"que ves en las revistas de moda."

#: lang/json/ARMOR_from_json.py
msgid "headscarf"
msgid_plural "headscarfs"
msgstr[0] "pañuelo para la cabeza"
msgstr[1] "pañuelos para la cabeza"

#. ~ Description for headscarf
#: lang/json/ARMOR_from_json.py
msgid "A loose cloth worn over the head and around the neck."
msgstr "Una tela suelta que se usa sobre la cabeza y alrededor del cuello."

#: lang/json/ARMOR_from_json.py
msgid "keffiyeh"
msgid_plural "keffiyehs"
msgstr[0] "kufiyya"
msgstr[1] "kufiyyas"

#. ~ Description for keffiyeh
#: lang/json/ARMOR_from_json.py
msgid ""
"A type of headdress traditionally used in the Middle East.  It can be used "
"in different ways to protect the head and mouth from the elements."
msgstr ""
"Un tipo tradicional pañuelo de Oriente Medio que se usa en la cabeza. Puede "
"ser usado de distintas maneras para cubrir la cabeza y boca de la "
"intemperie."

#: lang/json/ARMOR_from_json.py
msgid "cyan scarf"
msgid_plural "cyan scarfs"
msgstr[0] "pañuelo cian"
msgstr[1] "pañuelos cian"

#. ~ Description for cyan scarf
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple cloth scarf worn by Marloss Voices.  Wherever the Voices go, long "
"sought peace soon follows, for better or for worse."
msgstr ""
"Un simple pañuelo de tela usado por las Voces de Marloss. Dondequiera que "
"las Voces vayan, la paz largamente buscada pronto les sigue, para mejor o "
"peor."

#: lang/json/ARMOR_from_json.py
msgid "axe ring holster"
msgid_plural "axe ring holsters"
msgstr[0] "funda de anillo para hachas"
msgstr[1] "fundas de anillo para hachas"

#. ~ Use action holster_prompt for axe ring holster.
#: lang/json/ARMOR_from_json.py
msgid "Sheath axe"
msgstr "Enfundar hacha"

#. ~ Description for axe ring holster
#: lang/json/ARMOR_from_json.py
msgid ""
"A combination of leather and a metal ring to hold an axe on your waist."
msgstr ""
"Una combinación de cuero y un anillo de metal para sostener un hacha en tu "
"cintura."

#: lang/json/ARMOR_from_json.py
msgid "baldric"
msgid_plural "baldrics"
msgstr[0] "tahalí"
msgstr[1] "tahalíes"

#. ~ Use action holster_prompt for baldric.
#. ~ Use action holster_prompt for back scabbard.
#. ~ Use action holster_prompt for scabbard.
#. ~ Use action holster_prompt for hollow cane.
#: lang/json/ARMOR_from_json.py lang/json/ARMOR_from_json.py
#: lang/json/GENERIC_from_json.py
msgid "Sheath sword"
msgstr "Enfundar espada"

#. ~ Description for baldric
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for anything up to a longsword, or even a bit"
" larger than that.  Designed to be worn at the waist, secured by a shoulder "
"belt.  Activate to sheath/draw a sword."
msgstr ""
"Una vaina de cuero suficientemente grande como para una espada larga, o "
"incluso algo un poco más grande que eso. Diseñado para ser puesto en la "
"cintura, y asegurada con una correa al hombro. Activar para enfundar/sacar "
"una espada."

#: lang/json/ARMOR_from_json.py
msgid "ankle sheath"
msgid_plural "ankle sheaths"
msgstr[0] "funda de tobillo"
msgstr[1] "fundas de tobillo"

#. ~ Use action holster_prompt for ankle sheath.
#. ~ Use action holster_prompt for birchbark ankle sheath.
#. ~ Use action holster_prompt for sheath.
#. ~ Use action holster_prompt for birchbark sheath.
#: lang/json/ARMOR_from_json.py
msgid "Sheath knife"
msgstr "Enfundar cuchillo"

#. ~ Description for ankle sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A small concealed knife sheath worn on the ankle.  It is awkward to use "
"without practice.  Activate to sheathe/draw a weapon."
msgstr ""
"Una pequeña funda para cuchillo que se oculta en el tobillo. Es difícil de "
"usar sin práctica. Activar para enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "birchbark ankle sheath"
msgid_plural "birchbark ankle sheathes"
msgstr[0] "funda de tobillo de abedul"
msgstr[1] "fundas de tobillo de abedul"

#. ~ Description for birchbark ankle sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A handcrafted small concealed knife sheath worn on the ankle, made from "
"birch bark.  It is awkward to use without practice.  Activate to "
"sheathe/draw a weapon."
msgstr ""
"Una pequeña funda de cuchillo oculta, hecha a mano, que se lleva en el "
"tobillo, de corteza de abedul. Es difícil de usar sin práctica. Activar para"
" enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "back scabbard"
msgid_plural "back scabbards"
msgstr[0] "fundas de espalda"
msgstr[1] "fundas de espalda"

#. ~ Description for back scabbard
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for almost any sword.  Designed to be "
"strapped to the back, it's very difficult to draw from without considerable "
"practice.  Activate to sheath/draw a sword."
msgstr ""
"Una funda de cuero lo suficientemente grande para poner cualquier espada. "
"Diseñada para ser colgada en la espalda, pero es bastante difícil de usar "
"sin una práctica considerable. Activar para enfundar/sacar una espada."

#: lang/json/ARMOR_from_json.py
msgid "scabbard"
msgid_plural "scabbards"
msgstr[0] "funda rígida"
msgstr[1] "fundas rígidas"

#. ~ Description for scabbard
#: lang/json/ARMOR_from_json.py
msgid ""
"A large, adjustable sheath for holding swords and other large blades.  "
"Activate to sheathe/draw a weapon."
msgstr ""
"Una funda larga y ajustable para espadas y otras armas blancas grandes. "
"Activar para enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "sheath"
msgid_plural "sheathes"
msgstr[0] "funda flexible"
msgstr[1] "fundas flexibles"

#. ~ Description for sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather sheath for holding knives and other small blades.  It is easy to "
"use without much practice.  Activate to sheathe/draw a weapon."
msgstr ""
"Una funda de cuero para poner cuchillos u otras armas blancas pequeñas. "
"Fácil de usar sin mucha práctica. Activar para enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "birchbark sheath"
msgid_plural "birchbark sheathes"
msgstr[0] "funda de corteza de abedul"
msgstr[1] "fundas de corteza de abedul"

#. ~ Description for birchbark sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A handcrafted sheath made from birch bark, for holding knives and other "
"small blades, with a strap attached.  Activate to sheathe/draw a weapon."
msgstr ""
"Una funda hecha a mano de corteza de abedul, para guardar cuchillos y otras "
"pequeñas cuchillas, con una correa. Activar para enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "spear strap"
msgid_plural "spear straps"
msgstr[0] "correa para lanza"
msgstr[1] "correas para lanza"

#. ~ Use action holster_msg for spear strap.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You holster your %s."
msgstr "Enfundas tu %s."

#. ~ Use action holster_prompt for spear strap.
#: lang/json/ARMOR_from_json.py
msgid "Holster spear"
msgstr "Enfundar lanza"

#. ~ Description for spear strap
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather strap tied around the torso for toting spears while keeping your "
"hands free.  You have to duck to get through doors while one's in it, "
"though.  Activate to holster/draw a weapon."
msgstr ""
"Una correa de cuero atada alrededor del torso para llevar lanzas manteniendo"
" las manos libres. Te tienes que agachar para pasar por las puertas cuando "
"la estas usando.  Activar para enfundar/sacar un arma."

#: lang/json/ARMOR_from_json.py
msgid "backpack"
msgid_plural "backpacks"
msgstr[0] "mochila"
msgstr[1] "mochilas"

#. ~ Description for backpack
#: lang/json/ARMOR_from_json.py
msgid "A small backpack.  Good storage for a little encumbrance."
msgstr "Una mochila pequeña. Buen almacenamiento por poca incomodidad."

#: lang/json/ARMOR_from_json.py
msgid "hiking backpack"
msgid_plural "hiking backpacks"
msgstr[0] "mochila de senderismo"
msgstr[1] "mochilas de senderismo"

#. ~ Description for hiking backpack
#: lang/json/ARMOR_from_json.py
msgid "A large sized hiking backpack with plenty of storage space."
msgstr ""
"Una mochila de senderismo de gran tamaño con mucho espacio de "
"almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "giant novelty backpack"
msgid_plural "giant novelty backpacks"
msgstr[0] "mochila innovadora gigante"
msgstr[1] "mochilas innovadoras gigantes "

#. ~ Description for giant novelty backpack
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge fabric backpack made mostly as a joke before the Cataclysm.  Now, "
"it's still rather silly, but it can store a lot of stuff."
msgstr ""
"Una enorme mochila de tela hecha más que nada como broma antes del "
"Cataclismo. Ahora, sigue siendo bastante absurda, pero puede almacenar un "
"montón de cosas."

#: lang/json/ARMOR_from_json.py
msgid "leather backpack"
msgid_plural "leather backpacks"
msgstr[0] "mochila de cuero"
msgstr[1] "mochilas de cuero"

#. ~ Description for leather backpack
#: lang/json/ARMOR_from_json.py
msgid "A small leather backpack.  Good storage for a little encumbrance."
msgstr "Una mochila pequeña de cuero. Buena capacidad por poca incomodidad."

#: lang/json/ARMOR_from_json.py
msgid "large tactical backpack"
msgid_plural "large tactical backpacks"
msgstr[0] "mochila táctica grande"
msgstr[1] "mochilas tácticas grandes"

#. ~ Description for large tactical backpack
#: lang/json/ARMOR_from_json.py
msgid ""
"A large tactical multi-compartment backpack that has great lower back "
"support."
msgstr ""
"Una gran mochila táctica multi-compartimentada que tiene un gran apoyo en la"
" parte baja de la espalda."

#: lang/json/ARMOR_from_json.py
msgid "laundry basket"
msgid_plural "laundry baskets"
msgstr[0] "cesta de la colada"
msgstr[1] "cestas de la colada"

#. ~ Description for laundry basket
#: lang/json/ARMOR_from_json.py
msgid "A plastic basket meant for storing and hauling clothing."
msgstr "Una cesta de plástico pensada para almacenar y transportar ropa."

#: lang/json/ARMOR_from_json.py
msgid "high-volume rucksack"
msgid_plural "high-volume rucksacks"
msgstr[0] "morral de gran volumen"
msgstr[1] "morrales de gran volumen"

#. ~ Description for high-volume rucksack
#: lang/json/ARMOR_from_json.py
msgid ""
"Also known as a \"bigpack\", this rucksack is prized by pack rats but may "
"lead to a bad back."
msgstr ""
"También conocida como \"gran mochila\", este morral es muy apreciado por las"
" ratas de carga, pero puede provocar problemas en la espalda."

#: lang/json/ARMOR_from_json.py
msgid "bindle"
msgid_plural "bindles"
msgstr[0] "hatillo"
msgstr[1] "hatillos"

#. ~ Description for bindle
#: lang/json/ARMOR_from_json.py
msgid ""
"You're ready for a trip down some train tracks.  Also known as a hobo stick."
msgstr ""
"Estás listo para un viaje por las vías del tren. También conocido como palo "
"de vagabundo."

#: lang/json/ARMOR_from_json.py
msgid "box backpack"
msgid_plural "box backpacks"
msgstr[0] "mochila caja"
msgstr[1] "mochilas caja"

#. ~ Description for box backpack
#: lang/json/ARMOR_from_json.py
msgid "A makeshift backpack comprised of a wooden box and a pair of ropes."
msgstr ""
"Una mochila improvisada compuesta de una caja de madera y un par de sogas."

#: lang/json/ARMOR_from_json.py
msgid "briefcase"
msgid_plural "briefcases"
msgstr[0] "maletín"
msgstr[1] "maletines"

#. ~ Description for briefcase
#: lang/json/ARMOR_from_json.py
msgid "Useful for carrying money, documents, or smuggled goods."
msgstr "Útil para llevar dinero, documentos, o contrabando."

#: lang/json/ARMOR_from_json.py
msgid "violin case"
msgid_plural "violin cases"
msgstr[0] "estuche de violín"
msgstr[1] "estuches de violín"

#. ~ Description for violin case
#: lang/json/ARMOR_from_json.py
msgid ""
"Useful to carry your precious musical instrument around protected from any "
"harm."
msgstr ""
"Útil para transportar tu preciado instrumento musical por ahí, protegido "
"contra cualquier daño."

#: lang/json/ARMOR_from_json.py
msgid "daypack"
msgid_plural "daypacks"
msgstr[0] "mochila de día"
msgstr[1] "mochilas de día"

#. ~ Description for daypack
#: lang/json/ARMOR_from_json.py
msgid ""
"An ultralight nylon backpack intended for one-day hiking trips.  Waterproof,"
" slim, and spacious."
msgstr ""
"Una mochila ultraligera de nylon destinada a excursiones de un día de "
"duración. Impermeable, delgada y espaciosa."

#: lang/json/ARMOR_from_json.py
msgid "dive bag"
msgid_plural "dive bags"
msgstr[0] "bolsa de buceo"
msgstr[1] "bolsas de buceo"

#. ~ Description for dive bag
#: lang/json/ARMOR_from_json.py
msgid "A lightweight mesh backpack, commonly worn by swimmers and divers."
msgstr ""
"Una mochila de red ligera comunmente utilizada por los nadadores y los "
"buzos."

#: lang/json/ARMOR_from_json.py
msgid "duffel bag"
msgid_plural "duffel bags"
msgstr[0] "petate militar"
msgstr[1] "petates militares"

#. ~ Description for duffel bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge duffel bag.  Provides plenty of storage, but is severely encumbering."
msgstr ""
"Un enorme petate militar. Tiene mucha capacidad de almacenamiento pero es "
"muy incómodo."

#: lang/json/ARMOR_from_json.py
msgid "tactical dump pouch"
msgid_plural "tactical dump pouches"
msgstr[0] "bolsa táctica de descarga"
msgstr[1] "bolsas tácticas de descarga"

#. ~ Description for tactical dump pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"An expandable pouch secured with straps.  Provides a bit of extra storage "
"with minimal encumbrance."
msgstr ""
"Un bolso expandible asegurado con correas. Proporciona un poco más de "
"almacenamiento con una mínima incomodidad."

#: lang/json/ARMOR_from_json.py
msgid "fanny pack"
msgid_plural "fanny packs"
msgstr[0] "riñonera"
msgstr[1] "riñoneras"

#. ~ Description for fanny pack
#: lang/json/ARMOR_from_json.py
msgid "Provides a bit of extra storage, with minimal encumbrance."
msgstr "Proporciona un poco más de almacenamiento con una mínima incomodidad."

#: lang/json/ARMOR_from_json.py
msgid "golf bag"
msgid_plural "golf bags"
msgstr[0] "bolsa de golf"
msgstr[1] "bolsas de golf"

#. ~ Use action holster_msg for golf bag.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You awkwardly sheath your %s"
msgstr "Embarazosamente enfundas tu %s."

#. ~ Use action holster_prompt for golf bag.
#: lang/json/ARMOR_from_json.py
msgid "Sheath golf club"
msgstr "Enfundar palo de golf"

#. ~ Description for golf bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A tall canvas and plastic bag with fold-out legs used for golfing.  It even "
"has straps to be worn on the back and a slot for an umbrella."
msgstr ""
"Una lona alta y una bolsa de plástico con patas plegables que se usa para "
"jugar al golf. Incluso tiene correas para llevar en la espalda y una ranura "
"para un paraguas."

#: lang/json/ARMOR_from_json.py
msgid "H&K operational briefcase (empty)"
msgid_plural "H&K operational briefcases (empty)"
msgstr[0] "Maletin de operaciones H&K (vacio)"
msgstr[1] "Maletines de operaciones H&K (vacios)"

#. ~ Description for H&K operational briefcase (empty)
#: lang/json/ARMOR_from_json.py
msgid ""
"This is a plain, hard-sided black briefcase with a trigger in the handle and"
" a concealed hole in the side.  Squeezing the trigger would currently do "
"nothing, as it is empty.  Don't forget to put a suitable MP5 back inside "
"before you try to pay any ransom fees with lead."
msgstr ""
"Este es un maletín duro negro con un gatillo en el mango y un agujero oculto"
" en un lateral. Apretar el gatillo no hará nada, ya que está vacío. No "
"olvides poner un MP5  convenientemente dentro antes de intentar pagar "
"cualquier rescate con plomo."

#: lang/json/ARMOR_from_json.py
msgid "jerrypack"
msgid_plural "jerrypacks"
msgstr[0] "bidonchila"
msgstr[1] "bidonchilas"

#. ~ Description for jerrypack
#: lang/json/ARMOR_from_json.py
msgid "A jerrycan modified to be worn in a similar manner to a backpack."
msgstr "Un bidón modificado para ser llevado de manera similar a una mochila."

#: lang/json/ARMOR_from_json.py
msgid "leather pouch"
msgid_plural "leather pouches"
msgstr[0] "bolso de cuero"
msgstr[1] "bolsos de cuero"

#. ~ Description for leather pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A bag stitched together from leather scraps.  Doesn't hold an awful lot but "
"is easy to wear."
msgstr ""
"Un bolso hecho con restos de cuero cosido. No puedes meterle una barbaridad "
"de cosas, pero es cómodo de llevar."

#: lang/json/ARMOR_from_json.py
msgid "pair of drop leg pouches"
msgid_plural "pairs of drop leg pouches"
msgstr[0] "par de pierneras"
msgstr[1] "pares de pierneras"

#. ~ Description for pair of drop leg pouches
#: lang/json/ARMOR_from_json.py
msgid ""
"A set of pouches that can be worn on the thighs using buckled straps.  This "
"variety is favored by the military."
msgstr ""
"Un conjunto de bolsas que se pueden llevar en los muslos mediante correas "
"con hebillas. Esta variedad es la preferida por los militares."

#: lang/json/ARMOR_from_json.py
msgid "armband pouch"
msgid_plural "armband pouches"
msgstr[0] "bolsa de brazo"
msgstr[1] "bolsas de brazo"

#. ~ Description for armband pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A small pouch that can be worn on the upper arm using buckled straps.  This "
"is a favoured item among sports & camping enthusiasts."
msgstr ""
"Una pequeña bolsa que puede llevarse en la parte superior del brazo mediante"
" correas con hebilla. Es un artículo muy apreciado por los aficionados al "
"deporte y al camping."

#: lang/json/ARMOR_from_json.py
msgid "makeshift knapsack"
msgid_plural "makeshift knapsacks"
msgstr[0] "mochila pantalón"
msgstr[1] "mochila pantalones"

#. ~ Description for makeshift knapsack
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of pants with the bottom ends tied with string, and then passed "
"through the belt loops so the knapsack can be carried on the back."
msgstr ""
"Un par de pantalones con los extremos inferiores atados con una cuerda, y "
"luego pasados por los lazos del cinturón para que la mochila pueda ser "
"llevada en la espalda."

#: lang/json/ARMOR_from_json.py
msgid "makeshift sling"
msgid_plural "makeshift slings"
msgstr[0] "cabestrillo improvisado"
msgstr[1] "cabestrillos improvisados"

#. ~ Description for makeshift sling
#: lang/json/ARMOR_from_json.py
msgid "A large sheet tied into a crude, over-the-shoulder sling."
msgstr "Una gran sábana atada a un burdo cabestrillo sobre el hombro."

#: lang/json/ARMOR_from_json.py
msgid "messenger bag"
msgid_plural "messenger bags"
msgstr[0] "mochila de mensajero"
msgstr[1] "mochilas de mensajero"

#. ~ Description for messenger bag
#: lang/json/ARMOR_from_json.py
msgid "Light and easy to wear, but doesn't offer much storage."
msgstr ""
"Ligero y fácil de llevar, pero no tiene mucha capacidad de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "MOLLE pack"
msgid_plural "MOLLE packs"
msgstr[0] "mochila MOLLE"
msgstr[1] "mochilas MOLLE"

#. ~ Description for MOLLE pack
#: lang/json/ARMOR_from_json.py
msgid ""
"The Modular Lightweight Load-carrying Equipment is an advanced military "
"backpack.  Covered with pockets and straps, it strikes a fine balance "
"between storage space and encumbrance."
msgstr ""
"La Modular Ligera Larga Equipación es una mochila militar avanzada. Cubierta"
" de bolsillos y correas, logra un fino equilibrio entre el espacio de "
"almacenamiento y la incomodidad."

#: lang/json/ARMOR_from_json.py
msgid "net backpack"
msgid_plural "net backpacks"
msgstr[0] "mochila de red"
msgstr[1] "mochilas de red"

#. ~ Description for net backpack
#: lang/json/ARMOR_from_json.py
msgid ""
"A bag woven together from strings, with straps to wear it on back.  Lighter "
"than a standard backpack, but more awkward to carry when loaded and unable "
"to hold small or heavy items."
msgstr ""
"Una bolsa tejida junta de cuerdas, con correas para llevar a la espalda. Más"
" ligera que una mochila estándar, pero más incómoda de llevar cuando está "
"cargada y no puede contener objetos pequeños o pesados."

#: lang/json/ARMOR_from_json.py
msgid "petpack"
msgid_plural "petpacks"
msgstr[0] "mochila mascota"
msgstr[1] "mochilas mascota"

#. ~ Description for petpack
#: lang/json/ARMOR_from_json.py
msgid ""
"Before the Cataclysm this would allow your four-legged friend to see the "
"world, now it's used to shield them from the world."
msgstr ""
"Antes del Cataclismo esto le permitiría a tu amigo de cuatro patas ver el "
"mundo, ahora se usa para protegerlos del mundo."

#: lang/json/ARMOR_from_json.py
msgid "plastic shopping bag"
msgid_plural "plastic shopping bags"
msgstr[0] "bolsa de plástico para compras"
msgstr[1] "bolsas de plástico para compras"

#. ~ Description for plastic shopping bag
#: lang/json/ARMOR_from_json.py
msgid "A bag used to carry groceries home."
msgstr "Una bolsa utilizada para llevar la compra a casa."

#: lang/json/ARMOR_from_json.py
msgid "purse"
msgid_plural "purses"
msgstr[0] "monedero"
msgstr[1] "monederos"

#. ~ Description for purse
#: lang/json/ARMOR_from_json.py
msgid "A bit cumbersome to wear, but provides some storage."
msgstr "Un poco incómodo de llevar, pero proporciona algo de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "pouch"
msgid_plural "pouches"
msgstr[0] "bolso"
msgstr[1] "bolsos"

#. ~ Description for pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A makeshift bag, cobbled together from rags.  Really gets in the way, but "
"provides a decent amount of storage."
msgstr ""
"Una bolsa improvisada, hecha con trapos. Realmente incomoda, pero "
"proporciona una cantidad decente de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "military rucksack"
msgid_plural "military rucksacks"
msgstr[0] "morral militar"
msgstr[1] "morrales militares"

#. ~ Description for military rucksack
#: lang/json/ARMOR_from_json.py
msgid "A huge military rucksack, provides a lot of storage."
msgstr "Un morral militar enorme, proporciona un montón de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "runner pack"
msgid_plural "runner packs"
msgstr[0] "mochila para correr"
msgstr[1] "mochilas para correr"

#. ~ Description for runner pack
#: lang/json/ARMOR_from_json.py
msgid ""
"The obvious choice for outdoor athletes, this ergonomic backpack is light "
"and easy to wear, ensuring comfort when carrying heavy and bulky items."
msgstr ""
"La elección obvia para los deportistas al aire libre, esta mochila "
"ergonómica es ligera y fácil de llevar, lo que garantiza la comodidad al "
"transportar objetos pesados y voluminosos."

#: lang/json/ARMOR_from_json.py
msgid "sling pack"
msgid_plural "sling packs"
msgstr[0] "mochila cruzada"
msgstr[1] "mochilas cruzadas"

#. ~ Description for sling pack
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple single-sling backpack.  Easier to access than a normal backpack, "
"but can't comfortably hold as much."
msgstr ""
"Una simple mochila con una correa cruzada al cuerpo. Más fácil para acceder "
"que una mochila normal, pero no puede cargar cómodamente tanto."

#: lang/json/ARMOR_from_json.py
msgid "straw basket"
msgid_plural "straw baskets"
msgstr[0] "cesta de mimbre"
msgstr[1] "cestas de mimbre"

#. ~ Description for straw basket
#: lang/json/ARMOR_from_json.py
msgid "Hand made straw basket.  Carry it with you for extra storage."
msgstr ""
"Una cesta de mimbre hecha a mano. La puedes llevar para tener extra de "
"almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "suitcase"
msgid_plural "suitcases"
msgstr[0] "maleta"
msgstr[1] "maletas"

#. ~ Description for suitcase
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge wheeled suitcase used mainly for transporting clothes and other "
"possessions during trips, provides a decent amount of storage but hauling it"
" around is neither fast nor comfortable."
msgstr ""
"Una enorme maleta con ruedas que se usa principalmente para transportar ropa"
" y otras posesiones durante los viajes, proporciona una cantidad decente de "
"almacenamiento, pero transportarla no es ni rápido ni cómodo."

#. ~ Description for suitcase
#: lang/json/ARMOR_from_json.py
msgid ""
"A mid-sized wheeled suitcase used mainly for transporting clothes and other "
"possessions during trips, provides a decent amount of storage but hauling it"
" around is not exactly comfortable."
msgstr ""
"Una maleta de tamaño medio con ruedas, utilizada principalmente para "
"transportar ropa y otras posesiones durante los viajes, proporciona una "
"cantidad decente de almacenamiento, pero transportarla no es precisamente "
"cómoda."

#: lang/json/ARMOR_from_json.py
msgid "survivor duffel bag"
msgid_plural "survivor duffel bags"
msgstr[0] "petate de superviviente"
msgstr[1] "petates de superviviente"

#. ~ Description for survivor duffel bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built heavy duffel bag.  Durable and carefully crafted to hold as "
"much stuff as possible."
msgstr ""
"Un petate pesado personalizado. Duradera y diseñada cuidadosamente para "
"contener la mayor cantidad de cosas posibles."

#: lang/json/ARMOR_from_json.py
msgid "survivor backpack"
msgid_plural "survivor backpacks"
msgstr[0] "mochila de superviviente"
msgstr[1] "mochilas de superviviente"

#. ~ Description for survivor backpack
#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built backpack.  Durable and carefully crafted to hold as much "
"stuff as possible."
msgstr ""
"Una mochila personalizada. Duradera y diseñada cuidadosamente para contener "
"la mayor cantidad de cosas posibles."

#: lang/json/ARMOR_from_json.py
msgid "survivor rucksack"
msgid_plural "survivor rucksacks"
msgstr[0] "morral de superviviente"
msgstr[1] "morrales de superviviente"

#. ~ Description for survivor rucksack
#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built heavy backpack.  Durable and carefully crafted to hold as "
"much stuff as possible."
msgstr ""
"Una mochila pesada personalizadoa. Duradera y diseñada cuidadosamente para "
"contener la mayor cantidad de cosas posibles."

#: lang/json/ARMOR_from_json.py
msgid "survivor runner pack"
msgid_plural "survivor runner packs"
msgstr[0] "mochila de corredor superviviente"
msgstr[1] "mochilas de corredor superviviente"

#. ~ Description for survivor runner pack
#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built lightweight runner pack.  Durable and carefully crafted to "
"hold as much stuff as possible."
msgstr ""
"Una mochila ligera que se utiliza para llevar cosas mientras corres. "
"Duradera y diseñada cuidadosamente para contener la mayor cantidad de cosas "
"posibles."

#: lang/json/ARMOR_from_json.py
msgid "swag bag"
msgid_plural "swag bags"
msgstr[0] "bolsa de ladrón"
msgstr[1] "bolsas de ladrón"

#. ~ Description for swag bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A large canvas sack, re-purposed for makeshift storage.  Goes well with a "
"striped shirt and a domino mask."
msgstr ""
"Un saco de lona grande, readaptado para almacenar cosas de forma "
"improvisada. Combina muy bien con una camiseta a rayas blancas y negras  y "
"un antifaz."

#: lang/json/ARMOR_from_json.py
msgid "travelpack"
msgid_plural "travelpacks"
msgstr[0] "mochila de viaje"
msgstr[1] "mochilas de viaje"

#. ~ Description for travelpack
#: lang/json/ARMOR_from_json.py
msgid "A hiking pack used for short trips."
msgstr "Una mochila de excursionismo usada para viajes cortos."

#: lang/json/ARMOR_from_json.py
msgid "utility vest"
msgid_plural "utility vests"
msgstr[0] "chaleco utilitario"
msgstr[1] "chalecos utilitarios"

#. ~ Description for utility vest
#: lang/json/ARMOR_from_json.py
msgid "A light vest covered in pockets and straps for storage."
msgstr "Un chaleco ligero lleno de bolsillos y correas para almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "wicker backpack"
msgid_plural "wicker backpacks"
msgstr[0] "mochila de mimbre"
msgstr[1] "mochilas de mimbre"

#. ~ Description for wicker backpack
#: lang/json/ARMOR_from_json.py
msgid ""
"A large handmade straw basket with a lid and shoulder straps to wear it like"
" a backpack.  Less comfortable than a proper backpack, but will do the job."
msgstr ""
"Una gran cesta de mimbre hecha a mano con una tapa y correas para llevarla "
"como una mochila. Menos cómoda que una mochila apropiada, pero hará el "
"trabajo."

#: lang/json/ARMOR_from_json.py
msgid "debug pocket universe"
msgid_plural "debug pocket universes"
msgstr[0] "depurar universo de bolsillo"
msgstr[1] "depurar universos de bolsillos"

#. ~ Description for debug pocket universe
#: lang/json/ARMOR_from_json.py
msgid "A pocket universe.  Can store approximately 384 * 10^6 bugs."
msgstr ""
"Un universo de bolsillo. Puede almacenar aproximadamente 384* 10^6 de "
"errores."

#: lang/json/ARMOR_from_json.py
msgid "longarm bag"
msgid_plural "longarm bags"
msgstr[0] "bolsa de brazos largos"
msgstr[1] "bolsas de brazos largos"

#. ~ Description for longarm bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A long duffel bag.  Provides storage for long arms and rifles.  Quite "
"cumbersome."
msgstr ""
"Una larga bolsa de lona. Proporciona almacenamiento para armas largas y "
"rifles. Bastante incómoda."

#: lang/json/ARMOR_from_json.py
msgid "rifle case"
msgid_plural "rifle cases"
msgstr[0] "funda de rifle"
msgstr[1] "fundas de rifles"

#. ~ Description for rifle case
#: lang/json/ARMOR_from_json.py
msgid ""
"A long soft rifle case.  Provides storage for long arms and rifles.  "
"Includes a small pocket, strap and handle."
msgstr ""
"Una larga y suave funda para rifles. Proporciona almacenamiento para armas "
"largas y rifles. Incluye un pequeño bolsillo, una correa y un asa."

#: lang/json/ARMOR_from_json.py
msgid "leather rifle case"
msgid_plural "leather rifle cases"
msgstr[0] "funda de rifle de cuero"
msgstr[1] "fundas de rifle de cuero"

#. ~ Description for leather rifle case
#: lang/json/ARMOR_from_json.py
msgid ""
"A long soft leather rifle case.  Provides storage for long arms and rifles."
"  Includes a small pocket, strap and handle."
msgstr ""
"Una larga y suave funda de cuero para rifles. Proporciona almacenamiento "
"para armas largas y rifles. Incluye un pequeño bolsillo, una correa y un "
"asa."

#: lang/json/ARMOR_from_json.py
msgid "double rifle case"
msgid_plural "double rifle cases"
msgstr[0] "funda de rifle doble"
msgstr[1] "fundas de rifle doble"

#. ~ Description for double rifle case
#: lang/json/ARMOR_from_json.py
msgid ""
"A long soft rifle case.  Provides storage for 2 long arms and rifles.  "
"Includes 3 accessory pockets and a strap."
msgstr ""
"Una larga y suave funda para rifles. Proporciona almacenamiento para 2 armas"
" largas y rifles. Incluye 3 bolsillos para accesorios y una correa."

#: lang/json/ARMOR_from_json.py
msgid "leather double rifle case"
msgid_plural "leather double rifle cases"
msgstr[0] "funda de cuero de rifle doble"
msgstr[1] "fundas de cuero de rifle doble"

#. ~ Description for leather double rifle case
#: lang/json/ARMOR_from_json.py
msgid ""
"A long soft leather rifle case.  Provides storage for 2 long arms and "
"rifles.  Includes 3 accessory pockets and a strap."
msgstr ""
"Una larga y suave funda de cuero para rifles. Proporciona almacenamiento "
"para 2 armas largas y rifles. Incluye 3 bolsillos para accesorios y una "
"correa."

#: lang/json/ARMOR_from_json.py
msgid "long leather rifle case"
msgid_plural "long leather rifle cases"
msgstr[0] "funda larga de cuero para rifles"
msgstr[1] "fundas largas de cuero para rifles"

#. ~ Description for long leather rifle case
#: lang/json/ARMOR_from_json.py
msgid ""
"An extra long soft leather rifle case.  Provides storage for long arms and "
"rifles.  Includes a small pocket, strap and handle."
msgstr ""
"Una funda de cuero suave y extra larga para rifles. Proporciona "
"almacenamiento para armas largas y rifles. Incluye un pequeño bolsillo, una "
"correa y un asa."

#: lang/json/ARMOR_from_json.py
msgid "camera bag"
msgid_plural "camera bags"
msgstr[0] "bolsa de cámara"
msgstr[1] "bolsas de cámara"

#. ~ Description for camera bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple bag used to hold a camera, with a small pocket on the side for "
"accessories.  Comes with a carry strap."
msgstr ""
"Una simple bolsa que se utiliza para sostener una cámara, con un pequeño "
"bolsillo en el lado para los accesorios. Viene con una correa de transporte."

#: lang/json/ARMOR_from_json.py
msgid "bookstrap"
msgid_plural "bookstraps"
msgstr[0] "correa de libro"
msgstr[1] "correas de libro"

#. ~ Description for bookstrap
#: lang/json/ARMOR_from_json.py
msgid ""
"An old-fashioned book strap carrier.  Guaranteed to make you feel like a "
"proper scholar."
msgstr ""
"Un portalibros a la antigua usanza. Garantiza que te sientas como un "
"auténtico erudito."

#: lang/json/ARMOR_from_json.py
msgid "bondage suit"
msgid_plural "bondage suits"
msgstr[0] "vestimenta bondage"
msgstr[1] "vestimenta bondage"

#. ~ Description for bondage suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A suit of snug, black leather.  Has no pockets, but does feature an "
"abundance of unusually located zippers."
msgstr ""
"Un traje ajustado de cuero negro. No tiene bolsillos, pero ofrece una gran "
"variedad de cierres en lugares inusuales."

#: lang/json/ARMOR_from_json.py
msgid "clown suit"
msgid_plural "clown suits"
msgstr[0] "disfraz de payaso"
msgstr[1] "disfraces de payaso"

#. ~ Description for clown suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A colorful and ridiculous costume fit for a clown.  Provides decent storage."
msgstr ""
"Un disfraz de payaso muy colorido y muy ridículo. Proporciona un "
"almacenamiento decente."

#: lang/json/ARMOR_from_json.py
msgid "dinosaur suit"
msgid_plural "dinosaur suits"
msgstr[0] "disfraz de dinosaurio"
msgstr[1] "disfraces de dinosaurio"

#. ~ Description for dinosaur suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A full-body costume in the form of an anthropomorphic dinosaur.  It is quite"
" encumbering and has little storage but is very warm."
msgstr ""
"Un disfraz de cuerpo entero con la forma de un dinosaurio antropomórfico. "
"Bastante incómodo de usar y tiene poca capacidad de almacenamiento, pero es "
"muy calentito."

#: lang/json/ARMOR_from_json.py
msgid "jumpsuit"
msgid_plural "jumpsuits"
msgstr[0] "traje de paracaidista"
msgstr[1] "trajes de paracaidista"

#. ~ Description for jumpsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved jumpsuit; similar to those worn by prisoners.  "
"Provides decent storage and is not very encumbering."
msgstr ""
"Un mono delgado de mangas cortas. parecido al que usan los prisioneros. "
"Proporciona una capacidad de almacenamiento decente y no es muy incómodo."

#: lang/json/ARMOR_from_json.py
msgid "XL jumpsuit"
msgid_plural "XL jumpsuits"
msgstr[0] "traje de salto XL"
msgstr[1] "trajes de salto XL"

#. ~ Description for XL jumpsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved jumpsuit updated for the trans-human who needs full-"
"body clothing.  Provides some storage and is adjustable to minimize "
"encumbrance."
msgstr ""
"Un traje de manga corta y delgado actualizado para el trans-humano que "
"necesita ropa de cuerpo entero. Proporciona algo de almacenamiento y se "
"ajusta para minimizar la incomódidad."

#: lang/json/ARMOR_from_json.py
msgid "Hub 01 jumpsuit"
msgid_plural "Hub 01 jumpsuits"
msgstr[0] "traje de salto Hub 01"
msgstr[1] "trajes de salto Hub 01"

#. ~ Description for Hub 01 jumpsuit
#: lang/json/ARMOR_from_json.py
msgid "A brown jumpsuit worn by the staff of Hub 01."
msgstr "Un mono marrón usado por el personal del Hub 01."

#: lang/json/ARMOR_from_json.py
msgid "subject suit"
msgid_plural "subject suits"
msgstr[0] "ropa de paciente"
msgstr[1] "ropas de paciente"

#. ~ Description for subject suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved and short-legged one-piece suit.  Judging by the odd "
"tailoring and adjustment points… maybe you don't want to know who wore it.  "
"Provides nominal storage and is not very encumbering."
msgstr ""
"Un vestimenta de una sola pieza, delgado, de manga corta y de piernas "
"cortas. A juzgar por la extraña confección y los puntos de ajuste... tal vez"
" no quieras saber quién lo usó. Proporciona un almacenamiento normal y no es"
" muy incómodo."

#: lang/json/ARMOR_from_json.py
msgid "union suit"
msgid_plural "union suits"
msgstr[0] "pijama de una sola pieza"
msgstr[1] "pijamas de una sola pieza"

#. ~ Description for union suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A one-piece suit of full-body long underwear that helps to maintain body "
"temperature.  It laces closed in the front."
msgstr ""
"Una prenda que cubre el torso y las piernas, que sirve para mantener la "
"temperatura del cuerpo. Se cierra por la parte de adelante."

#: lang/json/ARMOR_from_json.py
msgid "wolf suit"
msgid_plural "wolf suits"
msgstr[0] "disfraz de lobo"
msgstr[1] "disfraces de lobo"

#. ~ Description for wolf suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A full body fursuit in the form of an anthropomorphic wolf.  It is quite "
"encumbering and has little storage but is very warm."
msgstr ""
"Un traje de piel de cuerpo entero con la forma de un lobo antropomórfico. Es"
" bastante incómodo y tiene poco almacenamiento, pero es muy calentito."

#: lang/json/ARMOR_from_json.py
msgid "thick wool onesie"
msgid_plural "thick wool onesies"
msgstr[0] "mono de lana gruesa"
msgstr[1] "monos de lana gruesa"

#. ~ Description for thick wool onesie
#: lang/json/ARMOR_from_json.py
msgid ""
"An encumbering wool suit covered in nice patterns.  It looks like full body "
"armor but it only protects against cold, sadly."
msgstr ""
"Un incomodo traje de lana, cubierto con lindos diseños. Parece una armadura "
"de cuerpo completo, pero solo puede protege contra el frío, lamentablemente."

#: lang/json/ARMOR_from_json.py
msgid "zentai"
msgid_plural "zentais"
msgstr[0] "zentai"
msgstr[1] "zentais"

#. ~ Description for zentai
#: lang/json/ARMOR_from_json.py
msgid ""
"Short for 'zenshin taitsu', a zentai is a form fitting full body nylon and "
"spandex garment.  Though it covers your face, you can see through the "
"integrated hood.  With a couple of these and some friends and you could put "
"on some kabuki."
msgstr ""
"Abreviatura de \"zenshin taitsu\", un zentai es una prenda de nylon y "
"spandex de cuerpo entero. Aunque cubre tu cara, puedes ver a través de la "
"capucha integrada. Con un par de estos y algunos amigos y podrías ponerte un"
" poco de kabuki."

#: lang/json/ARMOR_from_json.py
msgid "boiled leather armor"
msgid_plural "boiled leather armors"
msgstr[0] "armadura de cuero hervido"
msgstr[1] "armaduras de cuero hervido"

#. ~ Description for boiled leather armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Thick leather body armor that has been hardened via chemical treatment.  "
"Light and strong."
msgstr ""
"Armadura para el torso de cuero grueso que ha sido endurecida mediante un "
"tratamiento químico previo. Ligera y fuerte."

#: lang/json/ARMOR_from_json.py
msgid "chitinous armor"
msgid_plural "chitinous armors"
msgstr[0] "armadura de quitina"
msgstr[1] "armaduras de quitina"

#. ~ Description for chitinous armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Leg and body armor made from the exoskeletons of insects.  Light and "
"durable."
msgstr ""
"Armadura de torso y piernas hecha de exoesqueletos de insectos. Ligera y "
"duradera."

#: lang/json/ARMOR_from_json.py
msgid "XL chitinous armor"
msgid_plural "XL chitinous armors"
msgstr[0] "armadura de quitina XL"
msgstr[1] "armaduras de quitina XL"

#: lang/json/ARMOR_from_json.py
msgid "biosilicified chitin armor"
msgid_plural "biosilicified chitin armors"
msgstr[0] "armadura de quitina biosilicificada"
msgstr[1] "armaduras de quitina biosilicificada"

#. ~ Description for biosilicified chitin armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Leg and body armor crafted from the carefully cleaned and pruned "
"biosilicified exoskeletons of acidic ants.  Acid-resistant and very durable."
msgstr ""
"Armadura de torso y piernas fabricada a partir de exoesqueletos "
"biosilicificados de las hormigas ácidas. Resistente a los ácidos y muy "
"duraderas."

#: lang/json/ARMOR_from_json.py
msgid "XL biosilicified chitin armor"
msgid_plural "XL biosilicified chitin armors"
msgstr[0] "armadura de quitina biosilicificada XL"
msgstr[1] "armaduras de quitina biosilicificada XL"

#: lang/json/ARMOR_from_json.py
msgid "fur body armor"
msgid_plural "fur body armors"
msgstr[0] "armadura de piel"
msgstr[1] "armaduras de piel"

#. ~ Description for fur body armor
#: lang/json/ARMOR_from_json.py
msgid "Thick body armor made from furs.  Warm and comfortable."
msgstr "Armadura para el cuerpo hecha de pieles. Abrigada y cómoda."

#: lang/json/ARMOR_from_json.py
msgid "XL fur body armor"
msgid_plural "XL fur body armors"
msgstr[0] "armadura de piel XL"
msgstr[1] "armaduras de piel XL"

#: lang/json/ARMOR_from_json.py
msgid "leather body armor"
msgid_plural "leather body armors"
msgstr[0] "armadura de cuero"
msgstr[1] "armaduras de cuero"

#. ~ Description for leather body armor
#: lang/json/ARMOR_from_json.py
msgid "Thick leather body armor.  Light and comfortable."
msgstr "Armadura para el torso hecha de cuero resistente. Ligera y cómoda."

#: lang/json/ARMOR_from_json.py
msgid "XL leather body armor"
msgid_plural "XL leather body armors"
msgstr[0] "armadurasde cuero XL"
msgstr[1] "armaduras de cuero XL"

#: lang/json/ARMOR_from_json.py
msgid "plate armor"
msgid_plural "plate armors"
msgstr[0] "armadura de placas"
msgstr[1] "armaduras de placas"

#. ~ Description for plate armor
#: lang/json/ARMOR_from_json.py
msgid "A suit of Gothic plate armor."
msgstr "Una armadura de placas gótica."

#: lang/json/ARMOR_from_json.py
msgid "XL plate armor"
msgid_plural "XL plate armors"
msgstr[0] "armadura de placas XL"
msgstr[1] "armaduras de placas XL"

#: lang/json/ARMOR_from_json.py
msgid "nomad gear"
msgid_plural "nomad gears"
msgstr[0] "equipo nómada"
msgstr[1] "equipos nómada"

#. ~ Description for nomad gear
#: lang/json/ARMOR_from_json.py
msgid ""
"A makeshift outfit made from pre-Cataclysm clothing designed for long "
"travels.  It has a lot of storage space."
msgstr ""
"Un traje improvisado hecho con ropa pre-Cataclismo, diseñado para viajes "
"largos. Tiene mucha capacidad de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "light nomad gear"
msgid_plural "light nomad gears"
msgstr[0] "equipo ligero de nómada"
msgstr[1] "equipos ligeros de nómada"

#. ~ Description for light nomad gear
#: lang/json/ARMOR_from_json.py
msgid ""
"A light makeshift outfit made from pre-Cataclysm clothing designed for long "
"summer travels.  It offers less storage space and armor compared to regular "
"nomad gear."
msgstr ""
"Un traje improvisado ligero hecho con ropa pre-Cataclismo, diseñado para "
"viajes largos de verano. Ofrece menos espacio de almacenamiento y armadura "
"en comparación con el equipo nómada normal."

#: lang/json/ARMOR_from_json.py
msgid "plated leather armor"
msgid_plural "plated leather armors"
msgstr[0] "armadura de cuero con placas"
msgstr[1] "armaduras de cuero con placas"

#. ~ Description for plated leather armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Thick leather body armor that has been reinforced with strategically-placed "
"metal plates.  Strong and comfortable."
msgstr ""
"Armadura de cuero grueso para el torso que ha sido blindada con placas de "
"metal estratégicamente colocadas. Fuerte y cómoda."

#: lang/json/ARMOR_from_json.py
msgid "XL plated leather armor"
msgid_plural "XL plated leather armors"
msgstr[0] "armadura de cuero con placas XL"
msgstr[1] "armaduras de cuero con placas XL"

#: lang/json/ARMOR_from_json.py
msgid "ornamental plate armor"
msgid_plural "ornamental plate armors"
msgstr[0] "armadura de placas ornamentales"
msgstr[1] "armaduras de placas ornamentales"

#. ~ Description for ornamental plate armor
#: lang/json/ARMOR_from_json.py
msgid "An extremely heavy suit of ornamental armor."
msgstr "Una armadura decorada, extremadamente pesada."

#: lang/json/ARMOR_from_json.py
msgid "XL ornamental plate armor"
msgid_plural "XL ornamental plate armors"
msgstr[0] "armadura de placas ornamentales XL"
msgstr[1] "armaduras de placas ornamentales XL"

#: lang/json/ARMOR_from_json.py
msgid "riot armor"
msgid_plural "riot armors"
msgstr[0] "armadura antidisturbios"
msgstr[1] "armaduras antidisturbios"

#. ~ Description for riot armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Black armor used by riot police officers.  The padded layers and hard "
"plastic shoulder guards offer good protection without much encumbrance.  The"
" word POLICE is emblazoned across the front."
msgstr ""
"Armadura negra utilizada por agentes de la policía antidisturbios. Las capas"
" acolchadas y los protectores de hombros de plástico duro ofrecen una buena "
"protección sin demasiada incomódidad. La palabra POLICÍA está blasonada en "
"el frente. "

#: lang/json/ARMOR_from_json.py
msgid "O-yoroi"
msgid_plural "O-yorois"
msgstr[0] "O-yoroi"
msgstr[1] "O-yoroi"

#. ~ Description for O-yoroi
#: lang/json/ARMOR_from_json.py
msgid "An ornamental suit of Japanese samurai armor."
msgstr "Una armadura samurai japonesa ornamentada."

#: lang/json/ARMOR_from_json.py
msgid "scavenger gear"
msgid_plural "scavenger gears"
msgstr[0] "equipo de carroñero"
msgstr[1] "equipos de carroñero"

#. ~ Description for scavenger gear
#: lang/json/ARMOR_from_json.py
msgid ""
"A sturdy scavenger's outfit made from refitted pre-Cataclysm protective "
"gear.  It has a lot of storage space."
msgstr ""
"Un robusto traje de carroñero hecho con equipo de protección reajustado "
"previo al cataclismo. Tiene mucho espacio de almacenamiento."

#: lang/json/ARMOR_from_json.py
msgid "scrap suit"
msgid_plural "scrap suits"
msgstr[0] "traje chatarra"
msgstr[1] "trajes chatarra"

#. ~ Description for scrap suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A suit of armor made from scraps of metal secured by simple strings; the "
"loose collection of plates provides decent but not the most convenient "
"protection."
msgstr ""
"Una armadura hecha de chatarra asegurada por simples cuerdas; la colección "
"suelta de placas proporciona una protección decente pero no la más "
"conveniente."

#: lang/json/ARMOR_from_json.py
msgid "beekeeping suit"
msgid_plural "beekeeping suits"
msgstr[0] "traje de apicultor"
msgstr[1] "trajes de apicultor"

#. ~ Description for beekeeping suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A white suit commonly worn by professional beekeepers with straps on your "
"ankles and wrists to prevent bees from flying in.  It's not a very tough "
"fabric, but it's lightweight and has plenty of storage thanks to a chest "
"pocket."
msgstr ""
"Es un traje blanco comúnmente utilizado por los apicultores profesionales, "
"con correas en los tobillos y muñecas para prevenir que las abejas se metan."
" No está hecho de una tela muy resistente, pero es ligero y tiene mucha "
"capacidad de almacenamiento gracias al bolsillo en el pecho."

#: lang/json/ARMOR_from_json.py
msgid "chainmail hauberk"
msgid_plural "chainmail hauberks"
msgstr[0] "hauberk de malla"
msgstr[1] "hauberks de malla"

#. ~ Description for chainmail hauberk
#: lang/json/ARMOR_from_json.py
msgid ""
"A fully customized chainmail outfit, leaving the head uncovered.  The shirt,"
" arms, and leggings have been modified with straps and combined with a "
"gambeson to deal with uneven weight distribution, cold environments and to "
"allow them to be used separately."
msgstr ""
"Un traje de mallas de cadena totalmente personalizado, dejando la cabeza al "
"descubierto. La camisa, los brazos y los leggings han sido modificados con "
"correas y combinados con un gambesón para hacer frente a la distribución "
"desigual del peso, los ambientes fríos y para permitir su uso por separado."

#: lang/json/ARMOR_from_json.py
msgid "XL chainmail hauberk"
msgid_plural "XL chainmail hauberks"
msgstr[0] "hauberk de malla XL"
msgstr[1] "hauberks de malla XL"

#: lang/json/ARMOR_from_json.py
msgid "chainmail armor"
msgid_plural "chainmail armors"
msgstr[0] "armadura de cota de malla"
msgstr[1] "armaduras de cota de malla"

#. ~ Description for chainmail armor
#: lang/json/ARMOR_from_json.py
msgid ""
"A fully customized chainmail suit.  The coif, shirt, arms, and leggings have"
" been modified with straps and combined with a gambeson to deal with uneven "
"weight distribution, cold environments and to allow them to be used "
"separately."
msgstr ""
"Un traje de cota de malla totalmente personalizado. El peto, la camisa, los "
"brazos y las polainas se han modificado con correas y se han combinado con "
"un gambesón para hacer frente a la distribución desigual del peso, los "
"ambientes fríos y para permitir su uso por separado."

#: lang/json/ARMOR_from_json.py
msgid "XL chainmail armor"
msgid_plural "XL chainmail armors"
msgstr[0] "armadura de cota de malla XL"
msgstr[1] "armaduras de cota de malla XL"

#: lang/json/ARMOR_from_json.py
msgid "faraday chainmail suit"
msgid_plural "faraday chainmail suits"
msgstr[0] "traje de cota de malla Faraday"
msgstr[1] "trajes de cota de malla Faraday"

#. ~ Description for faraday chainmail suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A fully customized chainmail suit that can be worn over your normal "
"clothing.  The suit is conductively interconnected, protecting against "
"electricity."
msgstr ""
"Es un traje entero de cota de malla que se puede usar sobre la ropa común. "
"Ha sido interconectado conductivamente, lo que brinda protección contra la "
"electricidad."

#: lang/json/ARMOR_from_json.py
msgid "cleansuit"
msgid_plural "cleansuits"
msgstr[0] "mono impermeable"
msgstr[1] "mono impermeables"

#. ~ Description for cleansuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple hazardous materials handling suit.  Though somewhat restrictive and"
" fragile, wearing it will provide excellent protection against ambient "
"radiation."
msgstr ""
"Un mono simple para manejo de sustancias peligrosas. Aunque es un poco "
"incómodo y frágil, ofrece excelente protección contra la radiación del "
"ambiente."

#: lang/json/ARMOR_from_json.py
msgid "entry suit"
msgid_plural "entry suits"
msgstr[0] "traje de reentrada"
msgstr[1] "trajes de reentrada"

#. ~ Description for entry suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A flame-resistant whole-body garment worn by firefighters as protection "
"against extreme heat.  Though very restrictive, wearing it will provide "
"excellent protection against fire and smoke.  It requires a separate gas "
"mask for full protection."
msgstr ""
"Es un traje ignífugo que cubre completamente el cuerpo, utilizado por los "
"bomberos como protección contra el calor extremo. Son un poco restrictivos, "
"pero ofrecen una excelente protección contra el fuego y el humo. Necesita "
"una máscara de gas para brindar una protección completa."

#: lang/json/ARMOR_from_json.py
msgid "XL entry suit"
msgid_plural "XL entry suits"
msgstr[0] "traje de reentrada XL"
msgstr[1] "trajes de reentrada XL"

#: lang/json/ARMOR_from_json.py
msgid "survivor firesuit"
msgid_plural "survivor firesuits"
msgstr[0] "trajes ignífugos de superviviente"
msgstr[1] "trajes ignífugos de superviviente"

#. ~ Description for survivor firesuit
#: lang/json/ARMOR_from_json.py
msgid ""
"Heavy, hand-built combination armor made from a cut-down bulletproof vest "
"and a reinforced flame-resistant Nomex jumpsuit.  Protects the wearer from "
"fire and the elements."
msgstr ""
"Una pesada armadura combinada hecha a mano con un chaleco a prueba de balas "
"y un mono de Nomex reforzado y resistente a las llamas. Protege al portador "
"del fuego y de  la intemperie."

#: lang/json/ARMOR_from_json.py
msgid "XL survivor firesuit"
msgid_plural "XL survivor firesuits"
msgstr[0] "traje ignífugo XL de superviviente"
msgstr[1] "trajes ignífugos XL de superviviente"

#: lang/json/ARMOR_from_json.py
msgid "winter survivor suit"
msgid_plural "winter survivor suits"
msgstr[0] "traje de invierno de superviviente"
msgstr[1] "trajes de invierno de superviviente"

#. ~ Description for winter survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A warm and heavy hand-built combination armor made from a reinforced "
"bulletproof vest and a faux fur insulated leather jumpsuit.  Protects from "
"the elements as well as from harm."
msgstr ""
"Una armadura combinada, cálida y pesada, hecha con un chaleco antibalas "
"reforzado y un mono de piel aislante de imitación. Protege tanto de la "
"intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "XL winter survivor suit"
msgid_plural "XL winter survivor suits"
msgstr[0] "traje de invierno XL de superviviente"
msgstr[1] "trajes de invierno XL de superviviente"

#. ~ Description for XL winter survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A warm, heavy and oversized hand-built combination armor made from a "
"reinforced bulletproof vest and a faux fur insulated leather jumpsuit.  "
"Protects from the elements as well as from harm."
msgstr ""
"Una armadura combinada, cálida, pesada y grande hecha con un chaleco "
"antibalas reforzado y un mono de piel aislante de imitación. Protege tanto "
"de la intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "gambeson"
msgid_plural "gambesons"
msgstr[0] "gambesón"
msgstr[1] "gambesones"

#. ~ Description for gambeson
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick jacket of quilted fabric, designed to be worn underneath mail or "
"other armor.  Or worn on its own, if you can't afford proper armor."
msgstr ""
"Es un abrigo grueso de tela acolchada, diseñado para ser utilizado debajo de"
" la cota de malla y otra armadura. O para ser usado solo, si no te puedes "
"pagar una armadura apropiada."

#: lang/json/ARMOR_from_json.py
msgid "XL gambeson"
msgid_plural "XL gambesons"
msgstr[0] "gambeson XL"
msgstr[1] "gambesones XL"

#: lang/json/ARMOR_from_json.py
msgid "hazmat suit"
msgid_plural "hazmat suits"
msgstr[0] "traje para materiales peligrosos"
msgstr[1] "trajes para materiales peligrosos"

#. ~ Description for hazmat suit
#: lang/json/ARMOR_from_json.py
msgid ""
"An impermeable whole-body garment worn as protection against hazardous "
"materials.  Though very restrictive and fragile, wearing it will provide "
"complete protection against ambient radiation.  It requires a separate gas "
"mask for full protection."
msgstr ""
"Una prenda impermeable de cuerpo entero que se usa como protección contra "
"materiales peligrosos. Aunque es muy restrictiva y frágil, el uso de la "
"misma proporcionará una protección completa contra la radiación ambiental. "
"Requiere una máscara de gas separada para una protección completa."

#: lang/json/ARMOR_from_json.py
msgid "heavy survivor suit"
msgid_plural "heavy survivor suits"
msgstr[0] "traje pesado de superviviente"
msgstr[1] "trajes pesados de superviviente"

#. ~ Description for heavy survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A heavy, hand-built combination armor made from a reinforced bulletproof "
"vest and a metal-plated leather jumpsuit.  Protects from the elements as "
"well as from harm."
msgstr ""
"Una pesada armadura combinada hecha a mano con un chaleco antibalas "
"reforzado y un mono de cuero chapado en metal. Protege de la intemperie así "
"como del daño."

#: lang/json/ARMOR_from_json.py
msgid "light survivor suit"
msgid_plural "light survivor suits"
msgstr[0] "traje ligero de superviviente"
msgstr[1] "trajes ligeros de superviviente"

#. ~ Description for light survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A lightweight, hand-built combination armor made from a cut-down bulletproof"
" vest and a reinforced fabric jumpsuit.  Protects from the elements as well "
"as from harm."
msgstr ""
"Es un traje ligero hecho a mano, es una combinación entre un chaleco "
"antibalas cortado y un mono de tela reforzado. Protege tanto de la "
"intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "XL light survivor suit"
msgid_plural "XL light survivor suits"
msgstr[0] "traje ligero XL de superviviente"
msgstr[1] "trajes ligeros XL de superviviente"

#: lang/json/ARMOR_from_json.py
msgid "flame-resistant suit"
msgid_plural "flame-resistant suits"
msgstr[0] "traje ignífugo"
msgstr[1] "trajes ignífugos"

#. ~ Description for flame-resistant suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A snug body suit made from thin and lightweight Nomex fire-resistant fabric."
"  Tough yet breathable, it is light and comfortable to wear under clothing."
msgstr ""
"Un traje ajustado, ligero y fino, hecho de Nomex, una tela ignífuga. Fuerte,"
" deja pasar el aire y es liviano y cómodo para usar debajo de otra ropa."

#: lang/json/ARMOR_from_json.py
msgid "XL flame-resistant suit"
msgid_plural "XL flame-resistant suits"
msgstr[0] "traje resistentes al fuego XL"
msgstr[1] "trajes resistentes al fuego XL"

#: lang/json/ARMOR_from_json.py
msgid "Hub 01 environmental suit"
msgid_plural "Hub 01 environmental suits"
msgstr[0] "traje ambiental Hub 01"
msgstr[1] "trajes ambientales Hub 01"

#. ~ Description for Hub 01 environmental suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A lightweight environmental suit worn by Hub personnel in their rare forays "
"aboveground.  Colored brown and blue, the white seal of Hub 01 is "
"embroidered on both of its upper arms.  It requires a separate gas mask for "
"full protection."
msgstr ""
"Un traje ambiental ligero usado por el personal del Hub en sus raras "
"incursiones en la superficie. De color marrón y azul, el sello blanco del "
"Hub 01 está bordado en la parte superior de sus dos brazos. Requiere una "
"máscara de gas separada para una protección completa."

#: lang/json/ARMOR_from_json.py
msgid "WS-47G moisture retention suit"
msgid_plural "WS-47G moisture retention suits"
msgstr[0] "traje de retención de humedad WS-47G"
msgstr[1] "trajes de retención de humedad WS-47G"

#. ~ Description for WS-47G moisture retention suit
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid ""
"The WebbStar moisture retention suit utilizes advanced technology to prevent"
" up to 30% of moisture loss through perspiration.  The suit is powered by "
"the micro-motions of the body, especially breathing and walking motions.  "
"Because of this, your walking speed is impaired while wearing it."
msgstr ""
"El traje de retención de humedad WebbStar utiliza tecnología avanzada para "
"prevenir hasta un 30% de pérdida de humedad a través de la transpiración. El"
" traje es impulsado por los micro-movimientos del cuerpo, especialmente los "
"movimientos de respiración y de caminar. Debido a esto, su velocidad de "
"marcha se ve afectada mientras lo lleva puesto."

#: lang/json/ARMOR_from_json.py
msgid "suit"
msgid_plural "suits"
msgstr[0] "traje"
msgstr[1] "trajes"

#. ~ Description for suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A full-body cotton suit.  Makes the apocalypse a truly gentlemanly "
"experience."
msgstr ""
"Un traje de algodón de cuerpo entero. Hace que el apocalipsis también sea "
"una experiencia elegante."

#: lang/json/ARMOR_from_json.py
msgid "survivor suit"
msgid_plural "survivor suits"
msgstr[0] "traje de superviviente"
msgstr[1] "trajes de superviviente"

#. ~ Description for survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A hand-built combination armor made from a bulletproof vest and a reinforced"
" leather jumpsuit.  Protects from the elements as well as from harm."
msgstr ""
"Un traje hecho a mano, una combinación entre un chaleco antibalas y un mono "
"de cuero reforzado. Protege tanto de  la intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "SWAT armor"
msgid_plural "SWAT armors"
msgstr[0] "armadura SWAT"
msgstr[1] "armaduras SWAT"

#. ~ Description for SWAT armor
#: lang/json/ARMOR_from_json.py
msgid ""
"A suit of black bulletproof armor with lots of pockets.  The word SWAT is "
"emblazoned across the back."
msgstr ""
"Un traje antibalas negro con muchos bolsillos. La palabra SWAT resalta en la"
" espalda."

#: lang/json/ARMOR_from_json.py
msgid "leather touring suit"
msgid_plural "leather touring suits"
msgstr[0] "traje de cuero de motociclista"
msgstr[1] "trajes de cuero de motociclista"

#. ~ Description for leather touring suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick leather body suit made for protection while riding motorcycles.  "
"Light and very comfortable."
msgstr ""
"Es un traje de cuerpo entero de cuero resistente, que funciona como "
"protección al andar en moto. Liviano y muy cómodo."

#. ~ Description for winter survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A warm and heavy hand-built combination armor made from a reinforced "
"bulletproof vest and an insulated leather jumpsuit.  Protects from the "
"elements as well as from harm."
msgstr ""
"Una cálida y pesada armadura combinada hecha a mano con un chaleco antibalas"
" reforzado y un mono de cuero aislado. Protege de la intemperie así como del"
" daño."

#: lang/json/ARMOR_from_json.py
msgid "XL survivor suit"
msgid_plural "XL survivor suits"
msgstr[0] "traje XL de superviviente"
msgstr[1] "trajes XL de superviviente"

#. ~ Description for XL survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A massive hand-built combination armor made from a bulletproof vest and a "
"reinforced leather jumpsuit.  Protects from the elements as well as from "
"harm."
msgstr ""
"Es un enorme traje hecho a mano, una combinación entre un chaleco antibalas "
"y un mono de cuero reforzado. Protege tanto de la intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "XL heavy survivor suit"
msgid_plural "XL heavy survivor suits"
msgstr[0] "traje pesado XL de superviviente"
msgstr[1] "trajes pesados XL de superviviente"

#. ~ Description for XL heavy survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A massive, heavy, hand-built combination armor made from a reinforced "
"bulletproof vest and a metal-plated leather jumpsuit.  Protects from the "
"elements as well as from harm."
msgstr ""
"Una enorme y pesada armadura combinada hecha a mano, con un chaleco "
"antibalas reforzado y un mono de cuero chapado en metal. Protege de los "
"elementos así como de los daños."

#: lang/json/ARMOR_from_json.py
msgid "military flight suit"
msgid_plural "military flight suits"
msgstr[0] "traje militar de vuelo"
msgstr[1] "trajes militares de vuelo"

#. ~ Description for military flight suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A sage-green US military flight suit.  It has various insignia embroidered "
"onto it."
msgstr ""
"Un traje de vuelo militar estadounidense de color verde salvia. Lleva "
"bordadas varias insignias."

#: lang/json/ARMOR_from_json.py
msgid "bikini bottom"
msgid_plural "bikini bottoms"
msgstr[0] "tanga de bikini"
msgstr[1] "tangas de bikini"

#. ~ Description for bikini bottom
#: lang/json/ARMOR_from_json.py
msgid "A simple bikini bottom."
msgstr "Un tanga común de un bikini."

#: lang/json/ARMOR_from_json.py
msgid "pair of swimming trunks"
msgid_plural "pairs of swimming trunks"
msgstr[0] "bañador de hombre"
msgstr[1] "bañadores de hombre"

#. ~ Description for pair of swimming trunks
#: lang/json/ARMOR_from_json.py
msgid "A pair of swimming trunks, with netting."
msgstr "Un bañador de hombre, con malla interior."

#: lang/json/ARMOR_from_json.py
msgid "wetsuit"
msgid_plural "wetsuits"
msgstr[0] "traje de buceo"
msgstr[1] "trajes de buceo"

#. ~ Description for wetsuit
#: lang/json/ARMOR_from_json.py
msgid "A full-body neoprene wetsuit."
msgstr "Un traje de neopreno de cuerpo entero."

#: lang/json/ARMOR_from_json.py
msgid "wetsuit hood"
msgid_plural "wetsuit hoods"
msgstr[0] "capucha acuática"
msgstr[1] "capuchas acuáticas"

#. ~ Description for wetsuit hood
#: lang/json/ARMOR_from_json.py
msgid "A neoprene hood, commonly worn by divers."
msgstr "Una capucha de neopreno, generalmente utilizada por buzos."

#: lang/json/ARMOR_from_json.py
msgid "survivor wetsuit hood"
msgid_plural "survivor wetsuit hoods"
msgstr[0] "capucha de buzo de superviviente"
msgstr[1] "capuchas de buzo de superviviente"

#. ~ Description for survivor wetsuit hood
#: lang/json/ARMOR_from_json.py
msgid ""
"A customized armored neoprene and Kevlar hood, very strong and durable."
msgstr ""
"Es una capucha personalizada de neopreno reforzada con kevlar, muy "
"resistente y duradera."

#: lang/json/ARMOR_from_json.py
msgid "survivor wetsuit"
msgid_plural "survivor wetsuits"
msgstr[0] "traje de buzo de superviviente"
msgstr[1] "trajes de buzo de superviviente"

#. ~ Description for survivor wetsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A lightweight, hand-built combination armor made from a cut-down bulletproof"
" vest and a reinforced neoprene wetsuit.  Protects from the elements as well"
" as from harm."
msgstr ""
"Un traje ligero hecho a mano, es una combinación entre un chaleco antibalas "
"cortado y un traje acuático de neopreno reforzado. Protege tanto de la "
"intemperie como del daño."

#: lang/json/ARMOR_from_json.py
msgid "pair of survivor wetsuit gloves"
msgid_plural "pairs of survivor wetsuit gloves"
msgstr[0] "par de guantes de buzo de superviviente"
msgstr[1] "pares de guantes de buzo de superviviente"

#. ~ Description for pair of survivor wetsuit gloves
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of customized, Kevlar armored neoprene gloves, modified to be easy to"
" wear while providing maximum protection under extreme conditions."
msgstr ""
"Un par de guantes personalizados de neopreno reforzados con kevlar. Están "
"modificados para ser cómodos y brindar la máxima protección en condiciones "
"extremas."

#: lang/json/ARMOR_from_json.py
msgid "spring suit"
msgid_plural "spring suits"
msgstr[0] "traje acuático corto"
msgstr[1] "trajes acuáticos cortos"

#. ~ Description for spring suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A long-sleeved spring wetsuit with pink color details and cleavage-"
"enhancing, hip-accentuating construction.  Not as protective as a full-body "
"suit, but also less restrictive."
msgstr ""
"Es un traje de neopreno corto con mangas largas y detalles en rosa, y "
"entallado a la cadera y el escote. No protege tanto como el traje largo, "
"pero es más cómodo."

#: lang/json/ARMOR_from_json.py
msgid "faraday shark suit"
msgid_plural "faraday shark suits"
msgstr[0] "traje anti-tiburón faraday"
msgstr[1] "trajes anti-tiburón faraday"

#. ~ Description for faraday shark suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A one piece chainmail suit used by scuba divers for protection against shark"
" bites.  It has been conductively interconnected, protecting against "
"electricity."
msgstr ""
"Un traje entero de cota de malla que usan los buzos para protegerse contra "
"las mordidas de tiburón. Ha sido interconectado conductivamente, lo que "
"brinda protección contra la electricidad."

#: lang/json/ARMOR_from_json.py
msgid "shark suit"
msgid_plural "shark suits"
msgstr[0] "traje anti-tiburón"
msgstr[1] "trajes anti-tiburón"

#. ~ Description for shark suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A one piece chainmail suit used by scuba divers for protection against shark"
" bites.  It comes with attached plastic helmet and booties."
msgstr ""
"Un traje entero de cota de malla que usan los buzos para protegerse contra "
"las mordidas de tiburón. Viene con un casco de plástico y botas."

#: lang/json/ARMOR_from_json.py
msgid "pair of swim goggles"
msgid_plural "pairs of swim goggles"
msgstr[0] "par de gafas de nadar"
msgstr[1] "pares de gafas de nadar"

#. ~ Description for pair of swim goggles
#: lang/json/ARMOR_from_json.py
msgid "A small pair of goggles made for swimming."
msgstr "Un par de gafas pequeñas para nadar."

#: lang/json/ARMOR_from_json.py
msgid "pair of swimming gloves"
msgid_plural "pairs of swimming gloves"
msgstr[0] "par de guantes de nado"
msgstr[1] "pares de guantes de nado"

#. ~ Description for pair of swimming gloves
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of very flexible neoprene-silicone rubber gloves, suitable for "
"underwater use."
msgstr ""
"Es un par de guantes muy flexibles de neopreno y goma de silicona. Perfectos"
" para usar debajo del agua."

#: lang/json/ARMOR_from_json.py
msgid "bell cuirass"
msgid_plural "bell cuirasses"
msgstr[0] "coraza campana"
msgstr[1] "corazas campanas"

#. ~ Description for bell cuirass
#: lang/json/ARMOR_from_json.py
msgid "An ancient Greek breastplate, made of bronze."
msgstr "Un antiguao peto griego, hecho de bronce."

#: lang/json/ARMOR_from_json.py
msgid "XL bell cuirass"
msgid_plural "XL bell cuirasses"
msgstr[0] "coraza de campana XL"
msgstr[1] "corazas de campana XL"

#: lang/json/ARMOR_from_json.py
msgid "lamellar cuirass"
msgid_plural "lamellar cuirasses"
msgstr[0] "corazas laminar"
msgstr[1] "corazas laminares"

#. ~ Description for lamellar cuirass
#: lang/json/ARMOR_from_json.py
msgid ""
"A cuirass made of multiple pieces of tough leather, laced together for "
"durable yet flexible protection."
msgstr ""
"Una coraza hecha de múltiples piezas de cuero resistente, unidas para una "
"protección duradera y flexible."

#: lang/json/ARMOR_from_json.py
msgid "XL lamellar cuirass"
msgid_plural "XL lamellar cuirasses"
msgstr[0] "coraza laminar XL"
msgstr[1] "corazas laminares XL"

#: lang/json/ARMOR_from_json.py
msgid "lorica segmentata"
msgid_plural "lorica segmentata"
msgstr[0] "lorica segmentata"
msgstr[1] "lorica segmentata"

#. ~ Description for {'str_sp': 'lorica segmentata'}
#: lang/json/ARMOR_from_json.py
msgid ""
"An ancient Roman laminar armor, made of overlapping metal strips connected "
"to internal leather straps."
msgstr ""
"Es una antigua armadura romana de láminas, hecha superponiendo bandas de "
"metal, conectadas a correas de cuero internas."

#: lang/json/ARMOR_from_json.py
msgid "XL lorica segmentata"
msgid_plural "XL lorica segmentata"
msgstr[0] "lorica segmentata XL"
msgstr[1] "lorica segmentata XL"

#: lang/json/ARMOR_from_json.py
msgid "bookplate"
msgid_plural "bookplates"
msgstr[0] "armadura de libros"
msgstr[1] "armaduras de libros"

#. ~ Description for bookplate
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude form of armor made from stacked paper and rolls of duct tape, this "
"breastplate offers a surprising amount of protection."
msgstr ""
"Una armadura primitiva, hecha con montones de hojas y rollos de cinta "
"americana. Sorprendentemente, brinda buena protección."

#: lang/json/ARMOR_from_json.py
msgid "chainmail vest"
msgid_plural "chainmail vests"
msgstr[0] "chaleco de cota de malla"
msgstr[1] "chalecos de cota de malla"

#. ~ Description for chainmail vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A customized chainmail vest.  It's a sleeveless piece of chainmail with "
"small straps designed to better distribute the weight."
msgstr ""
"Es un chaleco de cota de malla. No tiene mangas pero tiene pequeñas correas "
"diseñadas para distribuir mejor el peso."

#: lang/json/ARMOR_from_json.py
msgid "XL chainmail vest"
msgid_plural "XL chainmail vests"
msgstr[0] "chaleco de cota de malla XL"
msgstr[1] "chalecos de cota de malla XL"

#: lang/json/ARMOR_from_json.py
msgid "hard chest guard"
msgid_plural "hard chest guards"
msgstr[0] "protector de pecho pesado"
msgstr[1] "protectores de pecho pesados"

#. ~ Description for hard chest guard
#: lang/json/ARMOR_from_json.py
msgid "A plastron of interlocking plastic plate protecting your torso."
msgstr "Un plastrón de placa plástica entrelazada protegiendo tu torso."

#: lang/json/ARMOR_from_json.py
msgid "cuirass"
msgid_plural "cuirasses"
msgstr[0] "coraza"
msgstr[1] "corazas"

#. ~ Description for cuirass
#: lang/json/ARMOR_from_json.py
msgid ""
"A steel breastplate, and a vital part of plate armor.  Even as full armor "
"went into decline, cuirasses remained in use among cavalry in Europe."
msgstr ""
"Un peto de acero, y una parte vital de la armadura de placas. Aunque como "
"armadura completa perdieron popularidad, las corazas permanecieron en uso "
"entre la caballería en Europa."

#: lang/json/ARMOR_from_json.py
msgid "XL cuirass"
msgid_plural "XL cuirasses"
msgstr[0] "coraza XL"
msgstr[1] "corazas XL"

#: lang/json/ARMOR_from_json.py
msgid "scrap cuirass"
msgid_plural "scrap cuirasses"
msgstr[0] "coraza de chatarra"
msgstr[1] "corazas de chatarra"

#. ~ Description for scrap cuirass
#: lang/json/ARMOR_from_json.py
msgid ""
"A cuirass made from scraps of metal secured by simple strings; the loose "
"collection of plates provides decent but not the most convenient protection."
msgstr ""
"Una coraza hecha de trozos de metal asegurados por simples cuerdas; la "
"colección suelta de placas proporciona una protección decente pero no la más"
" conveniente."

#: lang/json/ARMOR_from_json.py
msgid "XL scrap cuirass"
msgid_plural "XL scrap cuirasses"
msgstr[0] "coraza de chatarra XL"
msgstr[1] "corazas de chatarra XL"

#: lang/json/ARMOR_from_json.py
msgid "fencing jacket"
msgid_plural "fencing jackets"
msgstr[0] "chaleco de esgrima"
msgstr[1] "chalecos de esgrima"

#. ~ Description for fencing jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A padded jacket with the zipper on the back used by fencers to prevent "
"accidents.  It doesn't have any storage room, but it is very comfortable."
msgstr ""
"Es un chaleco acolchado con el cierre en la espalda que utilizan los "
"esgrimistas para prevenir accidentes. No tiene capacidad de almacenamiento, "
"pero es muy cómodo."

#: lang/json/ARMOR_from_json.py
msgid "armored leather jacket"
msgid_plural "armored leather jackets"
msgstr[0] "chaqueta reforzada de cuero"
msgstr[1] "chaquetas reforzadas de cuero"

#. ~ Description for armored leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"An armored jacket made from thick leather and metal plates.  Cumbersome, but"
" offers excellent protection from harm."
msgstr ""
"Es una chaqueta reforzada hecha de cuero resistente y placas de metal. "
"Incómoda, pero ofrece una excelente protección contra el daño."

#: lang/json/ARMOR_from_json.py
msgid "occult bone armor"
msgid_plural "occult bone armors"
msgstr[0] "armadura de hueso ocultista"
msgstr[1] "armaduras de hueso ocultistas"

#. ~ Description for occult bone armor
#: lang/json/ARMOR_from_json.py
msgid ""
"A black jacket made from thick leather and covered with intricately carved "
"bones.  You've never seen patterns like those before, each time you look at "
"them you spot a new one as if they were changing on their own."
msgstr ""
"Una chaqueta negra hecha de cuero grueso y cubierta con huesos "
"intrincadamente tallados. Nunca habías visto patrones como esos antes, cada "
"vez que los miras ves uno nuevo como si estuvieran cambiando por sí mismos."

#: lang/json/ARMOR_from_json.py
msgid "lamé (foil)"
msgid_plural "lamés (foil)"
msgstr[0] "Camisa de aluminio de esgrima(lamés)"
msgstr[1] "Camisas de aluminio de esgrima(lamés)"

#. ~ Description for lamé (foil)
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, lightweight conductive vest with the zipper on the back used by "
"fencers for electronic scoring.  Its outer layer is a woven mix of sturdy "
"cotton and stainless steel strands."
msgstr ""
"Un chaleco conductor delgado y ligero con la cremallera en la espalda "
"utilizado por los esgrimistas para la puntuación electrónica. Su capa "
"exterior es una mezcla tejida de hilos de algodón resistente y acero "
"inoxidable."

#: lang/json/ARMOR_from_json.py
msgid "lamé (saber)"
msgid_plural "lamés (saber)"
msgstr[0] "lamés (sable)"
msgstr[1] "lameses (sable)"

#. ~ Description for lamé (saber)
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, lightweight conductive jacket used by fencers for electronic "
"scoring.  Its outer layer is a woven mix of sturdy cotton and stainless "
"steel strands."
msgstr ""
"Una chaqueta conductora delgada y ligera utilizada por los esgrimistas para "
"la puntuación electrónica. Su capa exterior es una mezcla tejida de hilos de"
" algodón resistente y acero inoxidable."

#: lang/json/ARMOR_from_json.py
msgid "football armor"
msgid_plural "football armors"
msgstr[0] "hombreras de fútbol americano"
msgstr[1] "hombreras de fútbol americano"

#. ~ Description for football armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Heavy polycarbonate armor for your upper torso.  Normally worn by football "
"players."
msgstr ""
"Armadura pesada de policarbonato para la parte superior del torso. "
"Normalmente lo llevan los jugadores de fútbol."

#: lang/json/ARMOR_from_json.py
msgid "Kevlar vest"
msgid_plural "Kevlar vests"
msgstr[0] "chaleco de Kevlar"
msgstr[1] "chalecos de Kevlar"

#. ~ Description for Kevlar vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A lightweight, bullet resistant vest.  Suitable for wearing under clothing."
msgstr ""
"Es un chaleco ligero y anti-balas. Perfecto para utilizar debajo de la ropa."

#: lang/json/ARMOR_from_json.py
msgid "light survivor body armor"
msgid_plural "light survivor body armors"
msgstr[0] "armadura ligera de superviviente"
msgstr[1] "armaduras ligeras de superviviente"

#. ~ Description for light survivor body armor
#: lang/json/ARMOR_from_json.py
msgid ""
"Lightweight, custom-built body armor made from Kevlar and tough fabric.  "
"Mostly waterproof."
msgstr ""
"Una armadura ligera, hecha a medida, de Kevlar y tela resistente. En su "
"mayoría impermeable."

#: lang/json/ARMOR_from_json.py
msgid "XL light survivor body armor"
msgid_plural "XL light survivor body armors"
msgstr[0] "armadura ligera XL de superviviente"
msgstr[1] "armaduras ligeras  XL de superviviente"

#: lang/json/ARMOR_from_json.py
msgid "motorcycle armor"
msgid_plural "motorcycle armors"
msgstr[0] "traje de moto"
msgstr[1] "trajes de moto"

#. ~ Description for motorcycle armor
#: lang/json/ARMOR_from_json.py
msgid "A suit of armor used by dirt bikers and motorcyclists."
msgstr ""
"Una armadura usada por los motociclistas y los motociclistas de tierra."

#: lang/json/ARMOR_from_json.py
msgid "underarm protector"
msgid_plural "underarm protectors"
msgstr[0] "protector de axilas"
msgstr[1] "protectores de axilas"

#. ~ Description for underarm protector
#: lang/json/ARMOR_from_json.py
msgid ""
"A sturdy cotton plastron that protects much of the torso, the dominant "
"shoulder, and underarm while fencing."
msgstr ""
"Un robusto plastrón de algodón que protege gran parte del torso, el hombro "
"dominante, y la axila mientras se hace la valla."

#: lang/json/ARMOR_from_json.py
msgid "plastic chest protector"
msgid_plural "plastic chest protectors"
msgstr[0] "protector plástico de torso"
msgstr[1] "protectores plásticos de torso"

#. ~ Description for plastic chest protector
#: lang/json/ARMOR_from_json.py
msgid ""
"A rigid plastic plastron with molded cups to be worn by female fencers for "
"protection while fencing."
msgstr ""
"Un plastrón de plástico rígido con vasos moldeados para ser usado por las "
"esgrimistas femeninas como protección durante la esgrima."

#: lang/json/ARMOR_from_json.py
msgid "armored leather vest"
msgid_plural "armored leather vests"
msgstr[0] "chaleco reforzado de cuero"
msgstr[1] "chalecos reforzados de cuero"

#. ~ Description for armored leather vest
#: lang/json/ARMOR_from_json.py
msgid ""
"An armored vest made from thick leather and metal plates.  Cumbersome, but "
"offers excellent protection from harm."
msgstr ""
"Es un chaleco reforzado hecho de cuero resistente y placas de metal. "
"Incómodo, pero ofrece una excelente protección contra el daño."

#: lang/json/ARMOR_from_json.py
msgid "leather apron"
msgid_plural "leather aprons"
msgstr[0] "delantal de cuero"
msgstr[1] "delantales de cuero"

#. ~ Description for leather apron
#: lang/json/ARMOR_from_json.py
msgid "An apron made of thick leather."
msgstr "Un delantal de cuero grueso."

#: lang/json/ARMOR_from_json.py
msgid "cut-resistant apron"
msgid_plural "cut-resistant aprons"
msgstr[0] "delantal resistente a cortes"
msgstr[1] "delantales resistentes a cortes"

#. ~ Description for cut-resistant apron
#: lang/json/ARMOR_from_json.py
msgid ""
"An apron made of Kevlar fabric which provides excellent protection from "
"cuts."
msgstr ""
"Un delantal fabricado con tejido Kevlar que proporciona una excelente "
"protección contra cortes."

#: lang/json/ARMOR_from_json.py
msgid "blazer"
msgid_plural "blazers"
msgstr[0] "bléiser"
msgstr[1] "bléiseres"

#. ~ Description for blazer
#: lang/json/ARMOR_from_json.py
msgid "A professional-looking wool blazer.  Quite cumbersome."
msgstr ""
"Un bléiser de lana de los que usan los profesionales. Bastante incómodo."

#: lang/json/ARMOR_from_json.py
msgid "dress"
msgid_plural "dresses"
msgstr[0] "vestido"
msgstr[1] "vestidos"

#. ~ Description for dress
#: lang/json/ARMOR_from_json.py
msgid ""
"A long cotton dress.  Though comfortable to wear, it lacks any storage "
"space."
msgstr ""
