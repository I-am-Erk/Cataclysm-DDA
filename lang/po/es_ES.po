#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government ammunition loaded with a 405 grain lead flat nose bullet "
"to original specifications for safe use in antique firearms.  Quite a bit "
"less powerful than modern ammo, but still packs a punch."
msgstr ""
"Munición .45-70 Government cargada con una bala de 405 granos con punta "
"plana de plomo según las especificaciones originales para su uso seguro en "
"armas de fuego antiguas. Bastante menos potente que la munición moderna, "
"pero aún así tiene un gran impacto."

