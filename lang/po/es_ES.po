msgid_plural "chitin dog mesh harnesses"
msgstr[0] "arnés de malla para perros chitina"
msgstr[1] "arneses de malla para perros chitina"

#. ~ Description for chitin dog mesh harness
#: lang/json/PET_ARMOR_from_json.py
msgid ""
"A makeshift harness of chitin fitted to a thin mesh protecting the neck to "
"flank of canines.  You could put this on a friendly dog."
msgstr ""
"Un arnés improvisado de quitina ajustado a una fina malla que protege el "
"cuello al flanco de los caninos. Podrías ponerle esto a un perro amistoso."

#: lang/json/PET_ARMOR_from_json.py
msgid "chainmail dog coat"
msgid_plural "chainmail dog coats"
