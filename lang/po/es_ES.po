#: lang/json/GENERIC_from_json.py
msgid "broken C-4 hack"
msgid_plural "broken C-4 hacks"
msgstr[0] "C4-hack roto"
msgstr[1] "C4-hacks rotos"

#. ~ Description for broken C-4 hack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken C-4 hack.  Much less threatening now that it lies quiet on solid "
"ground.  Could be gutted for parts."
msgstr ""
"Un C4-hack roto. Ahora que está tirado quieto en el suelo no es tan "
"amenazante. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken loudspeaker"
msgid_plural "broken loudspeakers"
msgstr[0] "altavoz roto"
msgstr[1] "altavoces rotos"

#. ~ Description for broken loudspeaker
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken loudspeaker.  It's so unusually quiet now…  Could be gutted for "
"parts."
msgstr ""
"Un altavoz roto. Está tan anormalmente silencioso ahora... Podría ser "
"desmontado por partes."

#: lang/json/GENERIC_from_json.py
msgid "processor board"
msgid_plural "processor boards"
msgstr[0] "procesador"
msgstr[1] "procesadores"

#. ~ Description for processor board
#: lang/json/GENERIC_from_json.py
msgid "A central processor unit, useful in advanced electronics crafting."
msgstr ""
"Una unidad central de procesamiento, útil para fabricar cosas electrónicas "
"avanzadas."

#: lang/json/GENERIC_from_json.py
msgid "RAM"
msgid_plural "RAMs"
msgstr[0] "RAM"
msgstr[1] "RAM"

#. ~ Description for RAM
#: lang/json/GENERIC_from_json.py
msgid "A stick of memory.  Useful in advanced electronics crafting."
msgstr ""
"Es un módulo de memoria. Útil para fabricar cosas electrónicas avanzadas."

#: lang/json/GENERIC_from_json.py
msgid "power converter"
msgid_plural "power converters"
msgstr[0] "transformador"
msgstr[1] "transformadores"

#. ~ Description for power converter
#: lang/json/GENERIC_from_json.py
msgid "A power supply unit.  Useful in lots of electronics recipes."
msgstr ""
"Una unidad de alimentación. Útil para fabricar muchas cosas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "amplifier circuit"
msgid_plural "amplifier circuits"
msgstr[0] "circuito amplificador"
msgstr[1] "circuitos amplificadores"

#. ~ Description for amplifier circuit
#: lang/json/GENERIC_from_json.py
msgid ""
"A circuit designed to amplify the strength of a signal.  Useful in lots of "
"electronics recipes."
msgstr ""
"Un circuito diseñado para amplificar la potencia de una señal. Útil para "
"fabricar muchas cosas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "transponder circuit"
msgid_plural "transponder circuits"
msgstr[0] "transpondedor"
msgstr[1] "transpondedores"

#. ~ Description for transponder circuit
#: lang/json/GENERIC_from_json.py
msgid ""
"A circuit designed to repeat a signal.  Useful for crafting communications "
"equipment."
msgstr ""
"Un circuito diseñado para repetir una señal. Útil para fabricar equipos de "
"comunicación."

#: lang/json/GENERIC_from_json.py
msgid "signal receiver"
msgid_plural "signal receivers"
msgstr[0] "receptor de señal"
msgstr[1] "receptores de señal"

#. ~ Description for signal receiver
#: lang/json/GENERIC_from_json.py
msgid ""
"A module designed to receive many forms of signals.  Useful for crafting "
"communications equipment."
msgstr ""
"Un módulo diseñado para recibir muchas formas de señales. Útil para fabricar"
" equipos de comunicación."

#: lang/json/GENERIC_from_json.py
msgid "large LCD screen"
msgid_plural "large LCD screens"
msgstr[0] "pantalla LCD grande"
msgstr[1] "pantallas LCD grandes "

#. ~ Description for large LCD screen
#: lang/json/GENERIC_from_json.py
msgid ""
"A large backlit screen, used for displaying images.  Useful in some "
"electronics recipes."
msgstr ""
"Una gran pantalla retroiluminada, utilizada para mostrar imágenes. Útil en "
"algunas recetas de electrónica."

#: lang/json/GENERIC_from_json.py
msgid "small LCD screen"
msgid_plural "small LCD screens"
msgstr[0] "pantalla LCD pequeña"
msgstr[1] "pantallas LCD pequeñas"

#. ~ Description for small LCD screen
#: lang/json/GENERIC_from_json.py
msgid ""
"A small backlit screen, used for displaying images.  Useful in some "
"electronics recipes."
msgstr ""
"Es una pequeña pantalla retroiluminada, usada para mostrar imágenes. Útil "
"para fabricar algunas cosas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "high-quality lens"
msgid_plural "high-quality lenses"
msgstr[0] "lente de alta calidad"
msgstr[1] "lentes de alta calidad"

#. ~ Description for high-quality lens
#: lang/json/GENERIC_from_json.py
msgid ""
"A high-quality lens, useful for focusing or diffusing light.  Might be "
"useful for starting a fire."
msgstr ""
"Un lente de alta calidad, útil para enfocar o dispersar la luz. Puede ser "
"útil para encender un fuego."

#: lang/json/GENERIC_from_json.py
msgid "small high-quality lens"
msgid_plural "small high-quality lenses"
msgstr[0] "lente pequeño de alta calidad"
msgstr[1] "lentes pequeños de alta calidad"

#. ~ Description for small high-quality lens
#: lang/json/GENERIC_from_json.py
msgid ""
"A small high-quality lens, useful for focusing or diffusing light.  Might be"
" useful for crafting."
msgstr ""
"Una pequeña lente de alta calidad, útil para enfocar o difundir la luz. "
"Puede ser útil para la artesanía."

#: lang/json/GENERIC_from_json.py
msgid "pair of tinted glass"
msgid_plural "pairs of tinted glass"
msgstr[0] "par de cristales tintados"
msgstr[1] "pares de cristales tintados"

#. ~ Description for pair of tinted glass
#: lang/json/GENERIC_from_json.py
msgid ""
"A pair of small darkened glass, like the one that sunglasses are made of."
msgstr "Un par de pequeños vidrios oscurecidos, como el de las gafas de sol."

#: lang/json/GENERIC_from_json.py
msgid "burnt out bionic"
msgid_plural "burnt out bionics"
msgstr[0] "biónico fundido"
msgstr[1] "biónicos fundidos"

#. ~ Description for burnt out bionic
#: lang/json/GENERIC_from_json.py
msgid ""
"Once a valuable bionic implant, it has not held up well under repeated use."
"  This object has been destroyed by excessive electric current and is now "
"useless."
msgstr ""
"Alguna vez fue un implante biónico valioso, pero no se mantuvo en buenas "
"condiciones luego de un uso repetido. Este objeto ha sido destruido por una "
"corriente eléctrica excesiva y ahora no sirve para nada."

#: lang/json/GENERIC_from_json.py
msgid "nanofabricator template"
msgid_plural "nanofabricator templates"
msgstr[0] "plantilla para nanofabricador"
msgstr[1] "plantillas para nanofabricador"

#. ~ Description for nanofabricator template
#: lang/json/GENERIC_from_json.py
msgid ""
"A state-of-the-art optical storage system.  This small slate of transparent "
"glass holds, inscribed as a miniature pattern, the instructions required to "
"create an item through a nanofabricator."
msgstr ""
"Un sistema de almacenamiento óptico de última generación. Esta pequeña "
"pizarra de cristal transparente contiene, inscrita como un patrón en "
"miniatura, las instrucciones necesarias para crear un artículo a través de "
"un nanofabricador."

#. ~ Description for nanofabricator template
#: lang/json/GENERIC_from_json.py
msgid ""
"A state-of-the-art optical storage system, containing the instruction set to"
" replicate itself."
msgstr ""
"Un sistema de almacenamiento óptico de última generación, que contiene un "
"conjunto de instrucciones para auto-replicarse."

#: lang/json/GENERIC_from_json.py
msgid "nanofabricator template (silicon photonics)"
msgid_plural "nanofabricator templates (silicon photonics)"
msgstr[0] "plantilla de nanofabricador (fotónicos de silicio)"
msgstr[1] "plantillas de nanofabricador (fotónicos de silicio)"

#. ~ Description for nanofabricator template (silicon photonics)
#: lang/json/GENERIC_from_json.py
msgid ""
"A state-of-the-art optical storage system, containing the instruction set "
"required for the fabrication of complex silicon photonic circuitry.  The "
"data within was once clearly worth millions, but now, you are not sure if "
"it's anything more than a fancy, high-tech paperweight."
msgstr ""
"Un sistema de almacenamiento óptico de última generación, que contiene el "
"conjunto de instrucciones necesarias para la fabricación de complejos "
"circuitos fotónicos de silicio. Los datos que contiene valen claramente "
"millones, pero ahora no se sabe si es algo más que un elegante pisapapeles "
"de alta tecnología."

#: lang/json/GENERIC_from_json.py
msgid "antenna"
msgid_plural "antennas"
msgstr[0] "antena"
msgstr[1] "antenas"

#. ~ Description for antenna
#: lang/json/GENERIC_from_json.py
msgid "A simple thin aluminum shaft.  Useful in lots of electronics recipes."
msgstr ""
"Es un simple palo delgado de aluminio. Útil para fabricar muchas cosas "
"electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "micro motor"
msgid_plural "micro motors"
msgstr[0] "micromotor"
msgstr[1] "micromotores"

#. ~ Description for micro motor
#: lang/json/GENERIC_from_json.py
msgid ""
"A very small electric motor like those used in RC cars.  Useful in lots of "
"electronics recipes."
msgstr ""
"Un motor eléctrico muy pequeño como los que se usan en los coches de RC. "
"Útil en muchas recetas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "circuit board"
msgid_plural "circuit boards"
msgstr[0] "placa de circuitos"
msgstr[1] "placas de circuitos"

#. ~ Description for circuit board
#: lang/json/GENERIC_from_json.py
msgid ""
"A printed card that supports and electrically connects electronic components"
" on a non-conductive substrate."
msgstr ""
"Un circuito impreso que soporta y conecta eléctricamente los componentes "
"electrónicos en un sustrato no conductivo."

#: lang/json/GENERIC_from_json.py
msgid "electronic scrap"
msgid_plural "electronic scraps"
msgstr[0] "chatarra electrónica"
msgstr[1] "chatarras electrónicas"

#. ~ Description for electronic scrap
#: lang/json/GENERIC_from_json.py
msgid ""
"A random collection of resistors, capacitors, and diodes which have been "
"stripped from printed circuits."
msgstr ""
"Una colección de resistencias, condensadores y diodos que han sido sacados "
"de circuitos impresos."

#: lang/json/GENERIC_from_json.py
msgid "radio repeater mod"
msgid_plural "radio repeater mods"
msgstr[0] "modificación de repetidor"
msgstr[1] "modificaciones de repetidor"

#. ~ Description for radio repeater mod
#: lang/json/GENERIC_from_json.py
msgid ""
"A system designed to convert a radio station into an autonomous repeater."
msgstr ""
"Es un sistema diseñado para convertir una estación de radio en un repetidor "
"autónomo."

#: lang/json/GENERIC_from_json.py
msgid "desk fan"
msgid_plural "desk fans"
msgstr[0] "ventilador de escritorio"
msgstr[1] "ventiladores de escritorio"

#. ~ Description for desk fan
#: lang/json/GENERIC_from_json.py
msgid "A small fan, used to propel air around a room."
msgstr "Un ventilador pequeño, usado para tirar aire por toda la habitación."

#: lang/json/GENERIC_from_json.py
msgid "ceramic armor plate"
msgid_plural "ceramic armor plates"
msgstr[0] "placa cerámica de armadura"
msgstr[1] "placas cerámicas de armadura"

#. ~ Description for ceramic armor plate
#: lang/json/GENERIC_from_json.py
msgid ""
"A ceramic armor plate, specifically engineered for use in a bullet resistant"
" vest."
msgstr ""
"Es una placa cerámica de armadura, específicamente diseñada para usarse en "
"un chaleco antibalas."

#: lang/json/GENERIC_from_json.py
msgid "fishbowl"
msgid_plural "fishbowls"
msgstr[0] "pecera"
msgstr[1] "peceras"

#. ~ Description for fishbowl
#: lang/json/GENERIC_from_json.py
msgid ""
"A filled fishbowl, the tag says 'to Ed' and the fish's name, 'Hoss'.  The "
"fish appears to have tiny antlers."
msgstr ""
"Una pecera llena, la etiqueta dice \"a Ed\" y el nombre del pez, \"Hoss\". "
"El pez parece tener pequeños cuernos."

#: lang/json/GENERIC_from_json.py
msgid "pipe cleaner"
msgid_plural "pipe cleaners"
msgstr[0] "limpiador de tuberías"
msgstr[1] "limpiadores de tuberías"

#. ~ Description for pipe cleaner
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a tool designed to clean interior surface of pipes, bottles, and "
"similar objects.  This one is thin enough to be used for cleaning firearm "
"barrels from dirt and fouling."
msgstr ""
"Esta es una herramienta diseñada para limpiar la superficie interior de "
"tuberías, botellas y objetos similares. Es lo suficientemente delgada como "
"para ser usada para limpiar los barriles de armas de fuego de suciedad e "
"incrustaciones."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
msgid "clock"
msgid_plural "clocks"
msgstr[0] "reloj"
msgstr[1] "relojes"

#. ~ Description for clock
#: lang/json/GENERIC_from_json.py
msgid "A small mechanical clock, it's stopped at 10:10."
msgstr "Un pequeño reloj mecánico de pared. Está frenado en las 10:10."

#: lang/json/GENERIC_from_json.py
msgid "clockworks"
msgid_plural "clockworks"
msgstr[0] "mecanismo de relojería"
msgstr[1] "mecanismos de relojería"

#. ~ Description for {'str_sp': 'clockworks'}
#: lang/json/GENERIC_from_json.py
msgid "A small assortment of gears and other clockwork gubbins."
msgstr "Un pequeño surtido de engranajes y otros cacharros de relojería."

#: lang/json/GENERIC_from_json.py
msgid "SD-Memory card"
msgid_plural "SD-Memory cards"
msgstr[0] "tarjeta de memoria SD"
msgstr[1] "tarjetas de memoria SD"

#. ~ Description for SD-Memory card
#: lang/json/GENERIC_from_json.py
msgid "A memory card, used.  Might be worth a look."
msgstr "Una tarjeta de memoria usada. Vale la pena mirar qué tiene."

#: lang/json/GENERIC_from_json.py
msgid "SD-Memory card (clean)"
msgid_plural "SD-Memory cards (clean)"
msgstr[0] "tarjeta de memoria SD (vacía)"
msgstr[1] "tarjetas de memoria SD (vacías)"

#. ~ Description for SD-Memory card (clean)
#: lang/json/GENERIC_from_json.py
msgid ""
"This memory card is either unused or has been wiped clean.  You could use it"
" to store your data, though!"
msgstr ""
"Esta tarjeta de memoria está sin usar o se ha borrado su contenido. Puedes "
"usarla para guardar tu información."

#: lang/json/GENERIC_from_json.py
msgid "SD-Memory card (encrypted)"
msgid_plural "SD-Memory cards (encrypted)"
msgstr[0] "tarjeta de memoria SD (encriptada)"
msgstr[1] "tarjetas de memoria SD (encriptadas)"

#. ~ Description for SD-Memory card (encrypted)
#: lang/json/GENERIC_from_json.py
msgid ""
"This memory card appears to have the firmware encryption set.  Hopefully it "
"contains something worth encrypting."
msgstr ""
"Esta tarjeta de memoria parece tener un firmware de encriptación. Debe "
"contener algo importante."

#: lang/json/GENERIC_from_json.py
msgid "Science SD-Memory card"
msgid_plural "Science SD-Memory cards"
msgstr[0] "tarjeta de memoria SD científica"
msgstr[1] "tarjetas de memoria SD científicas"

#. ~ Description for Science SD-Memory card
#: lang/json/GENERIC_from_json.py
msgid ""
"This memory card appears to be related to 'XEDRA', and is certainly "
"encrypted.  Looks *Interesting*, though…"
msgstr ""
"Esta tarjeta de memoria parece estar relacionada con 'XEDRA', y está "
"ciertamente encriptada. Parece *interesante*, sin embargo..."

#: lang/json/GENERIC_from_json.py
msgid "hand mirror"
msgid_plural "hand mirrors"
msgstr[0] "espejo de mano"
msgstr[1] "espejos de mano"

#. ~ Description for hand mirror
#: lang/json/GENERIC_from_json.py
msgid "A small hand mirror."
msgstr "Un pequeño espejo de mano."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
msgid "manhole cover"
msgid_plural "manhole covers"
msgstr[0] "tapa de la alcantarilla"
msgstr[1] "tapas de las alcantarillas"

#. ~ Description for manhole cover
#: lang/json/GENERIC_from_json.py
msgid ""
"A heavy iron disc that typically covers a ladder into the sewers.  Lifting "
"it from the manhole is impossible without a crowbar."
msgstr ""
"Es un disco pesado de hierro que comúnmente cubre la escalera que baja a las"
" cloacas. No se puede abrir la alcantarilla sin una palanca."

#: lang/json/GENERIC_from_json.py
msgid "pine bough"
msgid_plural "pine boughs"
msgstr[0] "rama de pino"
msgstr[1] "ramas de pino"

#. ~ Description for pine bough
#: lang/json/GENERIC_from_json.py
msgid ""
"A branch from a pine tree, oozing sticky sap and bristling with prickly "
"needles."
msgstr ""
"Una rama de un pino, con pegajosa savia goteando y cubierto de espinas "
"puntiagudas."

#: lang/json/GENERIC_from_json.py
msgid "pinecone"
msgid_plural "pinecones"
msgstr[0] "piña"
msgstr[1] "piñas"

#. ~ Description for pinecone
#: lang/json/GENERIC_from_json.py
msgid ""
"A spiny pod from a pine tree.  Dry seeds rattle around inside when you shake"
" it."
msgstr ""
"Es una cápsula espinosa de un pino. Adentro, se escuchan las semillas secas "
"cuando la agitás."

#: lang/json/GENERIC_from_json.py
msgid "poppy bud"
msgid_plural "poppy buds"
msgstr[0] "capullo de amapola"
msgstr[1] "capullos de amapola"

#. ~ Description for poppy bud
#: lang/json/GENERIC_from_json.py
msgid ""
"A poppy bud.  Contains some substances commonly produced by a mutated poppy "
"flower."
msgstr ""
"Un capullo de amapola. Contiene algunas sustancias comúnmente producidas por"
" una flor de amapola mutada."

#. ~ Description for sunflower
#: lang/json/GENERIC_from_json.py
msgid ""
"The top of a sunflower, with yellow pedals and some seeds that have yet to "
"be eaten by animals."
msgstr ""
"La parte superior de un girasol, con pedales amarillos y algunas semillas "
"que aún no han sido comidas por los animales."

#: lang/json/GENERIC_from_json.py
msgid "chamomile flowers"
msgid_plural "chamomile flowers"
msgstr[0] "flor de manzanilla"
msgstr[1] "flores de manzanilla"

#. ~ Description for {'str_sp': 'chamomile flowers'}
#: lang/json/GENERIC_from_json.py
msgid ""
"White chamomile flowers, used as a herbal remedy since the ancient times."
msgstr ""
"Flores de manzanilla blanca, usadas como remedio herbal desde la antigüedad."

#: lang/json/GENERIC_from_json.py
msgid "lotus flower"
msgid_plural "lotus flowers"
msgstr[0] "flor de loto"
msgstr[1] "flores de loto"

#. ~ Description for lotus flower
#. ~ Description for lotus
#: lang/json/GENERIC_from_json.py lang/json/furniture_from_json.py
msgid ""
"A lovely flower that grows on the surface of bodies of freshwater.  "
"Traditionally connected with many Eastern cultures."
msgstr ""
"Una hermosa flor que crece en la superficie de los cuerpos de agua dulce. "
"Tradicionalmente conectada con muchas culturas orientales."

#: lang/json/GENERIC_from_json.py
msgid "spurge flowers"
msgid_plural "spurge flowers"
msgstr[0] "flor de euphorbias"
msgstr[1] "flores de euphorbias"

#. ~ Description for {'str_sp': 'spurge flowers'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A handful of yellow-green flowers.  Can be brewed into a tea that prevents "
"asthma attacks."
msgstr ""
"Un puñado de flores amarillo-verdes. Se puede preparar en un té que previene"
" los ataques de asma."

#: lang/json/GENERIC_from_json.py
msgid "lump of clay"
msgid_plural "lumps of clay"
msgstr[0] "masa de arcilla"
msgstr[1] "masas de arcilla"

#. ~ Description for lump of clay
#: lang/json/GENERIC_from_json.py
msgid "A fresh piece of clay.  Useful for some crafting recipes."
msgstr "Una masa de arcilla fresca. Útil para fabricar algunas cosas."

#: lang/json/GENERIC_from_json.py
msgid "brick"
msgid_plural "bricks"
msgstr[0] "ladrillo"
msgstr[1] "ladrillos"

#. ~ Description for brick
#: lang/json/GENERIC_from_json.py
msgid "A fire hardened building block used in masonry construction."
msgstr ""
"Un bloque de construcción endurecido al fuego, utilizado en albañilería."

#: lang/json/GENERIC_from_json.py
msgid "mortar"
msgid_plural "mortar"
msgstr[0] "mortero"
msgstr[1] "mortero"

#. ~ Description for {'str_sp': 'mortar'}
#: lang/json/GENERIC_from_json.py
msgid "Some mortar, ready to be used in building projects."
msgstr "Es un poco de mortero, listo para ser usado en alguna construcción."

#: lang/json/GENERIC_from_json.py
msgid "soft adobe brick"
msgid_plural "soft adobe bricks"
msgstr[0] "ladrillo de adobe blando"
msgstr[1] "ladrillos de adobe blandos"

#. ~ Use action msg for soft adobe brick.
#: lang/json/GENERIC_from_json.py
msgid "You test the brick, and it seems solid enough to use."
msgstr ""
"Pruebe el ladrillo, y parece lo suficientemente sólido como para usarlo."

#. ~ Use action not_ready_msg for soft adobe brick.
#: lang/json/GENERIC_from_json.py
msgid "The brick is still too damp to bear weight."
msgstr "El ladrillo todavía está demasiado húmedo para soportar el peso."

#. ~ Description for soft adobe brick
#: lang/json/GENERIC_from_json.py
msgid ""
"A compacted mass of soil and natural fibers, still too wet to build with.  "
"Load it onto a pallet and leave it to dry."
msgstr ""
"Una masa compactada de suelo y fibras naturales, todavía demasiado húmeda "
"para construir con ella. Cárguelo en un palé y déjelo secar."

#: lang/json/GENERIC_from_json.py
msgid "adobe brick"
msgid_plural "adobe bricks"
msgstr[0] "ladrillo de adobe"
msgstr[1] "ladrillos de adobe"

#. ~ Description for adobe brick
#: lang/json/GENERIC_from_json.py
msgid ""
"A compacted mass of soil and natural fibers, baked dry enough to harden into"
" a brick."
msgstr ""
"Una masa compactada de tierra y fibras naturales, horneada lo "
"suficientemente seca como para endurecerse en un ladrillo."

#: lang/json/GENERIC_from_json.py
msgid "adobe mortar"
msgid_plural "adobe mortar"
msgstr[0] "mortero de adobe"
msgstr[1] "mortero de adobe"

#. ~ Description for {'str_sp': 'adobe mortar'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A thick, pasty mud, low in sand content to reduce crumbling once dry.  Used "
"to glue larger, heavier pieces of mud and clay together."
msgstr ""
"Un barro espeso y pastoso, con bajo contenido de arena para reducir el "
"desmoronamiento una vez seco. Se utiliza para pegar piezas más grandes y "
"pesadas de barro y arcilla."

#: lang/json/GENERIC_from_json.py
msgid "tanbark"
msgid_plural "tanbark"
msgstr[0] "corteza de curtido"
msgstr[1] "cortezas de curtido"

#. ~ Description for {'str_sp': 'tanbark'}
#: lang/json/GENERIC_from_json.py
msgid "A sheet of tannin-rich bark from a tree, useful for tanning leather"
msgstr ""
"Un lamina rica en taninos de la corteza de un árbol, útil para el curtido de"
" cuero."

#: lang/json/GENERIC_from_json.py
msgid "birchbark"
msgid_plural "birchbarks"
msgstr[0] "corteza de abedul"
msgstr[1] "cortezas de abedul"

#. ~ Description for birchbark
#: lang/json/GENERIC_from_json.py
msgid "A sheet of tough, water-resistant bark taken from a birch tree."
msgstr ""
"Una corteza laminada dura y resistente al agua, obtenida de un abedul."

#: lang/json/GENERIC_from_json.py
msgid "willowbark"
msgid_plural "willowbark"
msgstr[0] "corteza de sauce"
msgstr[1] "cortezas de sauce"

#. ~ Description for {'str_sp': 'willowbark'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A sheet of bark taken from a willow tree.  Used in the production of "
"aspirin."
msgstr ""
"Una lamina de corteza obtenida de un sauce. Utilizada en la producción de "
"aspirinas."

#: lang/json/GENERIC_from_json.py
msgid "diamond"
msgid_plural "diamonds"
msgstr[0] "diamante"
msgstr[1] "diamantes"

#. ~ Description for diamond
#: lang/json/GENERIC_from_json.py
msgid "A sparkling diamond."
msgstr "Un diamante brillante."

#: lang/json/GENERIC_from_json.py
msgid "garnet"
msgid_plural "garnets"
msgstr[0] "granate"
msgstr[1] "granates"

#. ~ Description for garnet
#: lang/json/GENERIC_from_json.py
msgid "A sparkling garnet."
msgstr "Un granate brillante."

#: lang/json/GENERIC_from_json.py
msgid "amethyst"
msgid_plural "amethysts"
msgstr[0] "amatista"
msgstr[1] "amatistas"

#. ~ Description for amethyst
#: lang/json/GENERIC_from_json.py
msgid "A sparkling amethyst."
msgstr "Una amatista brillante."

#: lang/json/GENERIC_from_json.py
msgid "aquamarine"
msgid_plural "aquamarines"
msgstr[0] "aguamarina"
msgstr[1] "aguamarinas"

#. ~ Description for aquamarine
#: lang/json/GENERIC_from_json.py
msgid "A sparkling aquamarine."
msgstr "Un aguamarina brillante."

#: lang/json/GENERIC_from_json.py
msgid "emerald"
msgid_plural "emeralds"
msgstr[0] "esmeralda"
msgstr[1] "esmeraldas"

#. ~ Description for emerald
#: lang/json/GENERIC_from_json.py
msgid "A sparkling emerald."
msgstr "Una esmeralda brillante."

#: lang/json/GENERIC_from_json.py
msgid "alexandrite"
msgid_plural "alexandrites"
msgstr[0] "alejandrita"
msgstr[1] "alejandritas"

#. ~ Description for alexandrite
