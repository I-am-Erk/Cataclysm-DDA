#: lang/json/AMMO_from_json.py
msgid "fusion pack"
msgid_plural "fusion packs"
msgstr[0] "paquete de fusión"
msgstr[1] "paquetes de fusión"

#. ~ Description for fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil."
msgstr ""
"A mediados del siglo XXI, las fuerzas militares comenzaron a interesarse en "
"las armas de energía. El resultado fue el paquete de fusión, capaz de emitir"
" bolas de gas supercaliente a casi la velocidad de la luz, sin causar "
"retroceso."

#: lang/json/AMMO_from_json.py
msgid "bootleg fusion pack"
msgid_plural "bootleg fusion packs"
msgstr[0] "réplica de paquete de fusión"
msgstr[1] "réplicas de paquetes de fusión"

#. ~ Description for bootleg fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil.  "
"This one has been hand-crafted from spare parts."
msgstr ""
"A mediados del siglo XXI, las fuerzas militares comenzaron a interesare en "
"las armas de energía. El resultado fue el paquete de fusión, capaz de emitir"
" bolas de gas supercaliente a casi la velocidad de la luz, sin causar "
"retroceso. Este paquete ha sido creado manualmente con repuestos."

#: lang/json/AMMO_from_json.py
msgid "battery"
msgid_plural "battery"
msgstr[0] "batería"
msgstr[1] "baterías"

#. ~ Description for {'str_sp': 'battery'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some free-floating battery charge.  This can be reloaded into rechargable "
"battery cells, but can never be unloaded."
msgstr ""
"Una carga de batería flotante. Se puede recargar en celdas de batería "
"recargables, pero nunca puede ser descargada."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "butane"
msgid_plural "butane"
msgstr[0] "butano"
msgstr[1] "butano"

#. ~ Description for {'str_sp': 'butane'}
#: lang/json/AMMO_from_json.py
msgid "A common flammable liquid used in lighters."
msgstr "Liquido común usado en encendedores."

#: lang/json/AMMO_from_json.py
msgid "aerosol paint"
msgid_plural "aerosol paint"
msgstr[0] "pintura en aerosol"
msgstr[1] "pintura en aerosol"

#. ~ Description for {'str_sp': 'aerosol paint'}
#: lang/json/AMMO_from_json.py
msgid ""
"A paint that comes in a sealed, pressurized container and is released in an "
"aerosol spray when a valve button is depressed."
msgstr ""
"Una pintura que viene en un contenedor sellado y presurizado y se libera en "
"aerosol cuando se presiona el botón de la válvula."

#: lang/json/AMMO_from_json.py
msgid "permanent ink"
msgid_plural "permanent ink"
msgstr[0] "tinta permanente."
msgstr[1] "tinta permanente"

#. ~ Description for {'str_sp': 'permanent ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"A ink comprises a main carrier solvent, a glyceride, a pyrrolidone, a resin "
"and a colorant, making it water resistant."
msgstr ""
"La tinta está compuesta por un disolvente principal, un glicérido, una "
"pirrolidona, una resina y un colorante, lo que la hace resistente al agua."

#: lang/json/AMMO_from_json.py
msgid "candle wax"
msgid_plural "candle wax"
msgstr[0] "cera de vela"
msgstr[1] "cera de vela"

#. ~ Description for {'str_sp': 'candle wax'}
#: lang/json/AMMO_from_json.py
msgid "A flammable solid substance used to make candles."
msgstr "Una sustancia sólida inflamable utilizada para hacer velas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "flare pyrotechnic"
msgid_plural "flare pyrotechnic"
msgstr[0] "pirotécnico de bengala"
msgstr[1] "pirotécnico de bengala"

#. ~ Description for {'str_sp': 'flare pyrotechnic'}
#: lang/json/AMMO_from_json.py
msgid "A pyrotechnic chemical used in flares."
msgstr "Un químico pirotécnico utilizado en bengalas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "match"
msgid_plural "matches"
msgstr[0] "cerilla"
msgstr[1] "cerillas"

#. ~ Description for match
#: lang/json/AMMO_from_json.py
msgid ""
"A small stick with a red part at the end.  Strike it against a matchbook to "
"light it."
msgstr ""
"Un pequeño palo con una parte roja en el extremo. Golpéalo contra una caja "
"de fósforos para encenderlo."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "oxygen"
msgid_plural "oxygen"
msgstr[0] "oxígeno"
msgstr[1] "oxígeno"

#. ~ Description for {'str_sp': 'oxygen'}
#: lang/json/AMMO_from_json.py
msgid "Compressed medical oxygen."
msgstr "Oxigeno medico comprimido."

#: lang/json/AMMO_from_json.py
msgid "aluminum foil"
msgid_plural "aluminum foil"
msgstr[0] "papel de aluminio"
msgstr[1] "papel de aluminio"

#. ~ Description for {'str_sp': 'aluminum foil'}
#: lang/json/AMMO_from_json.py
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr ""
"Una lámina fina hecha de aluminio. A veces se lo llama 'papel estaño' debido"
" a que antes se hacía con estaño."

#: lang/json/AMMO_from_json.py
msgid "cent"
msgid_plural "cents"
msgstr[0] "centavo"
msgstr[1] "centavos"

#. ~ Description for cent
#: lang/json/AMMO_from_json.py
msgid "A unit of currency equivalent to 0.01 US dollars."
msgstr "Una unidad monetaria equivalente a 0.01 dólares americanos."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "thread"
msgid_plural "thread"
msgstr[0] "hilo"
msgstr[1] "hilos"

#. ~ Description for {'str_sp': 'thread'}
#: lang/json/AMMO_from_json.py
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr ""
"Una cantidad pequeña de hilo que se puede usar para rellenar un kit de "
"costura."

#: lang/json/AMMO_from_json.py
msgid "sinew"
msgid_plural "sinews"
msgstr[0] "tendón"
msgstr[1] "tendones"

#. ~ Description for sinew
#: lang/json/AMMO_from_json.py
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "Un tendón duro cortado de un cadáver, puede ser usado como hilo."

#: lang/json/AMMO_from_json.py
msgid "plant fiber"
msgid_plural "plant fibers"
msgstr[0] "fibra vegetal"
msgstr[1] "fibras vegetales"

#. ~ Description for plant fiber
#: lang/json/AMMO_from_json.py
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr ""
"Fibras finas y resistentes, tomadas de una planta. Pueden utilizarse como "
"hilos."

#: lang/json/AMMO_from_json.py
msgid "yarn"
msgid_plural "yarn"
msgstr[0] "hilo de lana"
msgstr[1] "hilos de lana"

#. ~ Description for {'str_sp': 'yarn'}
#: lang/json/AMMO_from_json.py
msgid "Wool yarn, could be used to knit wool clothing."
msgstr "Hilo de lana, podría ser utilizado para hacer ropa con punto de lana."

#: lang/json/AMMO_from_json.py
msgid "soap bar"
msgid_plural "soap bars"
msgstr[0] "pastilla de jabón"
msgstr[1] "pastillas de jabón"

#. ~ Description for soap bar
#: lang/json/AMMO_from_json.py
msgid "A cleansing agent made into bars."
msgstr "Un producto de limpieza en pastillas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "duct tape"
msgid_plural "duct tape"
msgstr[0] "cinta americana"
msgstr[1] "cintas americanas"

#. ~ Description for {'str_sp': 'duct tape'}
#: lang/json/AMMO_from_json.py
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Un rollo de cinta adhesiva increíblemente fuerte. Sus usos son innumerables."

#: lang/json/AMMO_from_json.py
msgid "rolling paper"
msgid_plural "rolling papers"
msgstr[0] "papel de liar"
msgstr[1] "papel de liar"

#. ~ Description for rolling paper
#: lang/json/AMMO_from_json.py
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "Estas son finas tiras de papel destinadas a liar cigarrillos."

#: lang/json/AMMO_from_json.py
msgid "copper wire"
msgid_plural "copper wires"
msgstr[0] "cable de cobre"
msgstr[1] "cables de cobre"

#. ~ Description for copper wire
#: lang/json/AMMO_from_json.py
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr ""
"Cable de cobre con cubierta de plástico del tipo utilizado en la "
"microelectrónica."

#: lang/json/AMMO_from_json.py
msgid "raw copper wire"
msgid_plural "raw copper wires"
msgstr[0] "cable de cobre desnudo"
msgstr[1] "cables de cobre desnudos"

#. ~ Description for raw copper wire
#: lang/json/AMMO_from_json.py
msgid "Copper wire ready to be covered with plastic."
msgstr "Alambre de cobre listo para ser cubierto con plástico."

#: lang/json/AMMO_from_json.py
msgid "plutonium fuel cell"
msgid_plural "plutonium fuel cells"
msgstr[0] "celda de combustible de plutonio"
msgstr[1] "celdas de combustible de plutonio"

#. ~ Description for plutonium fuel cell
#: lang/json/AMMO_from_json.py
msgid ""
"This is neither a fuel cell, nor nuclear, but the name stuck.  It uses "
"plutonium-244 as a catalyst to stabilize a complicated nanocompound that can"
" store enormous amounts of power.  Unfortunately it cannot be recharged by "
"conventional means: expended cells had to be sent to a central reprocessing "
"facility that almost certainly doesn't exist anymore."
msgstr ""
"Esto no es ni una célula de combustible, ni una nuclear, pero el nombre le "
"pega. Utiliza plutonio-244 como catalizador para estabilizar un complicado "
"nanocompuesto que puede almacenar enormes cantidades de energía. "
"Desafortunadamente no puede ser recargado por medios convencionales: las "
"células gastadas deben ser enviadas a una instalación central de "
"reprocesamiento que con toda seguridad ya no existe."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "plutonium slurry"
msgid_plural "plutonium slurry"
msgstr[0] "lodo de plutonio"
msgstr[1] "lodo de plutonio"

#. ~ Description for {'str_sp': 'plutonium slurry'}
#. ~ Description for {'str_sp': 'watery plutonium slurry'}
#: lang/json/AMMO_from_json.py
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr ""
"Lodo altamente radioactivo. Probablemente sea lo mejor alejarse de el."

#: lang/json/AMMO_from_json.py
msgid "watery plutonium slurry"
msgid_plural "watery plutonium slurry"
msgstr[0] "lodo acuoso de plutonio"
msgstr[1] "lodo acuoso de plutonio"

#: lang/json/AMMO_from_json.py lang/json/snippet_from_json.py
msgid "rock"
msgid_plural "rocks"
msgstr[0] "piedra"
msgstr[1] "piedras"

#. ~ Description for rock
#: lang/json/AMMO_from_json.py
msgid ""
"A rock the size of a baseball.  Makes a decent melee weapon, and is also "
"good for throwing at enemies."
msgstr ""
"Una roca del tamaño de una pelota de tenis. Una decente arma cuerpo a "
"cuerpo, y también útil como arma arrojadiza."

#: lang/json/AMMO_from_json.py
msgid "pebble"
msgid_plural "pebbles"
msgstr[0] "guijarro"
msgstr[1] "guijarros"

#. ~ Description for pebble
#: lang/json/AMMO_from_json.py
msgid "A small rock, useful as ammunition for slingshots."
msgstr "Una pequeña roca, útil como munición para hondas."

#: lang/json/AMMO_from_json.py
msgid "clay pellet"
msgid_plural "clay pellets"
msgstr[0] "perdigón de arcilla"
msgstr[1] "perdigones de arcilla"

#. ~ Description for clay pellet
#: lang/json/AMMO_from_json.py
msgid "A handful of round projectiles made of clay, useful for slingshots."
msgstr ""
"Un puñado de proyectiles redondos hechos de arcilla, útiles para tirachinas."

#: lang/json/AMMO_from_json.py
msgid "marble"
msgid_plural "marbles"
msgstr[0] "canica"
msgstr[1] "canicas"

#. ~ Description for marble
#: lang/json/AMMO_from_json.py
msgid "A handful of glass marbles, useful as ammunition for slingshots."
msgstr "Un puñado de canicas de vidrio, útiles como munición para tirachinas."

#: lang/json/AMMO_from_json.py
msgid "bearings"
msgid_plural "bearings"
msgstr[0] "rodamientos"
msgstr[1] "rodamientos"

#. ~ Description for {'str_sp': 'bearings'}
#: lang/json/AMMO_from_json.py
msgid "A box of ball bearings, useful as ammunition for slingshots."
msgstr "Una caja de rodamientos, útiles como munición para tirachinas."

#: lang/json/AMMO_from_json.py
msgid "BB"
msgid_plural "BBs"
msgstr[0] "balín"
msgstr[1] "balines"

#. ~ Description for BB
#: lang/json/AMMO_from_json.py
msgid ""
"A box of small steel balls that can be fired from a BB gun.  They deal "
"virtually no damage."
msgstr ""
"Una caja de pequeñas bolas de acero que pueden ser disparadas con una "
"pistola de balines. Prácticamente no causan daño."

#: lang/json/AMMO_from_json.py
msgid "feather"
msgid_plural "feathers"
msgstr[0] "pluma"
msgstr[1] "plumas"

#. ~ Description for feather
#: lang/json/AMMO_from_json.py
msgid "Feathers from a bird.  Useful for fletching arrows."
msgstr "Plumas de un pájaro. Útiles para emplumar flechas."

#: lang/json/AMMO_from_json.py
msgid "down feather"
msgid_plural "down feathers"
msgstr[0] "plumón"
msgstr[1] "plumones"

#. ~ Description for down feather
#: lang/json/AMMO_from_json.py
msgid "Fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr "Suaves plumones de un ave. Útiles para hacer ropa de cama acogedora."

#: lang/json/AMMO_from_json.py
msgid "120mm HEAT"
msgid_plural "120mm HEAT"
msgstr[0] "120mm HEAT"
msgstr[1] "120mm HEAT"

#. ~ Description for {'str_sp': '120mm HEAT'}
#: lang/json/AMMO_from_json.py
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr ""
"Un cohete de 120mm anti-tanque de alta-explosividad. Podría arruinar a "
"cualquiera el dia."

#: lang/json/AMMO_from_json.py
msgid "hydrogen canister"
msgid_plural "hydrogen canisters"
msgstr[0] "tanque de hidrogeno"
msgstr[1] "tanques de hidrogeno"

#. ~ Description for hydrogen canister
#: lang/json/AMMO_from_json.py
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated to plasma."
msgstr ""
"Un tanque de hidrógeno presurizado, tan comprimido que se ha vuelto sólido. "
"Con el equipo adecuado, podria ser calentado hasta convertirse en plasma."

#: lang/json/AMMO_from_json.py
msgid "mixed smokeless gunpowder"
msgid_plural "mixed smokeless gunpowder"
msgstr[0] "pólvora sin humo mezclada"
msgstr[1] "pólvora sin humo mezclada"

#. ~ Description for {'str_sp': 'mixed smokeless gunpowder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder, mixed without concern for composition, burn rate "
"or shape.  It has been slightly ground to make its properties more uniform."
"  Only the truly desperate would attempt to reload with this."
msgstr ""
"Pólvora para armas de fuego, mezclada sin preocupación por la composición, "
"velocidad de combustión o forma. Se ha rectificado ligeramente para que sus "
"propiedades sean más uniformes. Solo los verdaderamente desesperados "
"intentarían recargar con esto."

#: lang/json/AMMO_from_json.py
msgid "smokeless shotgun powder"
msgid_plural "smokeless shotgun powder"
msgstr[0] "pólvora sin humo para escopeta"
msgstr[1] "pólvora sin humo para escopeta"

#. ~ Description for {'str_sp': 'smokeless shotgun powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in shotgun shells."
msgstr ""
"Pólvora para armas de fuego, diseñada para usar en cartuchos de escopeta."

#: lang/json/AMMO_from_json.py
msgid "smokeless pistol powder"
msgid_plural "smokeless pistol powder"
msgstr[0] "pólvora sin humo para pistola"
msgstr[1] "pólvora sin humo para pistola"

#. ~ Description for {'str_sp': 'smokeless pistol powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in pistol ammunition."
msgstr ""
"Pólvora para armas de fuego, diseñada para usar en munición de pistolas."

#: lang/json/AMMO_from_json.py
msgid "smokeless magnum powder"
msgid_plural "smokeless magnum powder"
msgstr[0] "pólvora sin humo para magnum"
msgstr[1] "pólvora sin humo para magnum"

#. ~ Description for {'str_sp': 'smokeless magnum powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder intended for use in magnum pistol ammunition."
msgstr ""
"Pólvora para armas de fuego diseñada para usar en munición de pistola "
"magnum."

#: lang/json/AMMO_from_json.py
msgid "smokeless rifle powder"
msgid_plural "smokeless rifle powder"
msgstr[0] "pólvora sin humo para rifle"
msgstr[1] "pólvora sin humo para rifle"

#. ~ Description for {'str_sp': 'smokeless rifle powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in rifle ammunition."
msgstr "Pólvora para armas de fuego diseñada para usar en munición de rifle."

#: lang/json/AMMO_from_json.py
msgid "smokeless overbore rifle powder"
msgid_plural "smokeless overbore rifle powder"
msgstr[0] "polvora sobrecargada de rifle sin humo"
msgstr[1] "polvora sobrecargada de rifle sin humo"

#. ~ Description for {'str_sp': 'smokeless overbore rifle powder'}
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in large rifle ammunition."
msgstr ""
"Pólvora de calidad para armas de fuego diseñada para ser usada en munición "
"para rifles grandes."

#: lang/json/AMMO_from_json.py
msgid "artillery propellant"
msgid_plural "artillery propellant"
msgstr[0] "propelente de artillería"
msgstr[1] "propelente de artillería"

#. ~ Description for {'str_sp': 'artillery propellant'}
#: lang/json/AMMO_from_json.py
msgid ""
"Single base smokeless gunpowder intended for use in artillery propelling "
"charges."
msgstr ""
"Pólvora sin humo de base única diseñada para ser usada en cargas de "
"propulsión de artillería."

#: lang/json/AMMO_from_json.py
msgid "oxidizer powder"
msgid_plural "oxidizer powder"
msgstr[0] "polvo oxidante"
msgstr[1] "polvo oxidante"

#. ~ Description for {'str_sp': 'oxidizer powder'}
#: lang/json/AMMO_from_json.py
msgid "Volatile powdered chemical oxidizer."
msgstr "Oxidante químico en polvo volátil."

#: lang/json/AMMO_from_json.py
msgid "lye powder"
msgid_plural "lye powder"
msgstr[0] "lejia en polvo"
msgstr[1] "lejia en polvo"

#. ~ Description for {'str_sp': 'lye powder'}
#: lang/json/AMMO_from_json.py
msgid "Powdered caustic soda."
msgstr "Sosa cáustica en polvo."

#: lang/json/AMMO_from_json.py
msgid "shotgun primer"
msgid_plural "shotgun primers"
msgstr[0] "pistón de cartucho"
msgstr[1] "pistones de cartucho"

#. ~ Description for shotgun primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a shotgun shell."
msgstr "Pistón de un cartucho de escopeta."

#: lang/json/AMMO_from_json.py
msgid "small pistol primer"
msgid_plural "small pistol primers"
msgstr[0] "pistón de pistola pequeña"
msgstr[1] "pistones de pistola pequeña"

#. ~ Description for small pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber pistol round."
msgstr "Pistón para una bala de pistola de calibre pequeño."

#: lang/json/AMMO_from_json.py
msgid "large pistol primer"
msgid_plural "large pistol primers"
msgstr[0] "pistón de pistola grande"
msgstr[1] "pistones de pistola grande"

#. ~ Description for large pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber pistol round."
msgstr "Pistón para una bala de pistola de gran calibre."

#: lang/json/AMMO_from_json.py
msgid "small rifle primer"
msgid_plural "small rifle primers"
msgstr[0] "pistón de rifle pequeño"
msgstr[1] "pistones de rifle pequeño"

#. ~ Description for small rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber rifle round."
msgstr "Pistón para una bala de rifle de calibre pequeño."

#: lang/json/AMMO_from_json.py
msgid "large rifle primer"
msgid_plural "large rifle primers"
msgstr[0] "pistón para rifle grande"
msgstr[1] "pistones para rifle grande"

#. ~ Description for large rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber rifle round."
msgstr "Pistón para una bala de rifle de gran calibre."

#: lang/json/AMMO_from_json.py
msgid "rubber slug"
msgid_plural "rubber slugs"
msgstr[0] "bala de goma"
msgstr[1] "balas de goma"

#. ~ Description for rubber slug
#: lang/json/AMMO_from_json.py
msgid ""
"Rubber slugs from a shotgun beanbag round.  You could use them to make new "
"beanbag rounds."
msgstr ""
"Bala de goma dentro de un cartucho beanbag para escopeta. Las puedes usar "
"para hacer unos nuevos cartuchos beanbag."

#: lang/json/AMMO_from_json.py
msgid "chunk of rubber"
msgid_plural "chunks of rubber"
msgstr[0] "trozo de goma"
msgstr[1] "trozos de goma"

#. ~ Description for chunk of rubber
#: lang/json/AMMO_from_json.py
msgid "A chunk of useful rubber, can be molded easily."
msgstr "Un trozo de útil goma que puede ser moldeada fácilmente."

#: lang/json/AMMO_from_json.py
msgid "copper"
msgid_plural "copper"
msgstr[0] "cobre"
msgstr[1] "cobre"

#. ~ Description for {'str_sp': 'copper'}
#: lang/json/AMMO_from_json.py
msgid ""
"Copper bits.  Could be used to craft something, for example makeshift "
"shotgun shells."
msgstr ""
"Pedacitos de cobre. Se puede usar para fabricar algo, por ejemplo, unos "
"cartuchos de escopeta improvisados."

#: lang/json/AMMO_from_json.py
msgid "medical tape"
msgid_plural "medical tape"
msgstr[0] "esparadrapo"
msgstr[1] "esparadrapo"

#. ~ Description for {'str_sp': 'medical tape'}
#: lang/json/AMMO_from_json.py
msgid "A roll of medical tape, similar to duct tape."
msgstr "Un rollo de esparadrapo, parecido a la cinta americana."

#: lang/json/AMMO_from_json.py
msgid "placeholder ammunition"
msgid_plural "placeholder ammunitions"
msgstr[0] "munición de referencia"
msgstr[1] "munición de referencia"

#. ~ Description for placeholder ammunition
#. ~ Description for {'str_sp': 'software'}
#: lang/json/AMMO_from_json.py lang/json/GENERIC_from_json.py
msgid "IF YOU ARE SEEING THIS IT IS A BUG."
msgstr "SI ESTAS VIENDO ESTO, ES UN BUG."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "charcoal"
msgid_plural "charcoal"
msgstr[0] "carbón vegetal"
msgstr[1] "carbón vegetal"

#. ~ Description for {'str_sp': 'charcoal'}
#: lang/json/AMMO_from_json.py
msgid ""
"A flammable carbon-based material produced by slowly burning wood.  Utilized"
" in recipes requiring a pure, hot flame.  Can also be used in filters to "
"remove contaminants out of air and water."
msgstr ""
"Un material inflamable a base de carbono producido por la combustión lenta "
"de la madera. Se utiliza en recetas que requieren una llama pura y caliente."
" También se puede utilizar en filtros para eliminar los contaminantes del "
"aire y el agua."

#: lang/json/AMMO_from_json.py
msgid "calcium carbide premix"
msgid_plural "calcium carbide premix"
msgstr[0] "premezcla de carburo de calcio"
msgstr[1] "premezcla de carburo de calcio"

#. ~ Description for {'str_sp': 'calcium carbide premix'}
#: lang/json/AMMO_from_json.py
msgid ""
"A powdered mixture of coke and lime ready to be smelted into usable calcium "
"carbide in an arc furnace."
msgstr ""
"Una mezcla en polvo de coque y cal lista para ser fundida en carburo de "
"calcio utilizable en un horno de arco eléctrico."

#: lang/json/AMMO_from_json.py
msgid "coal"
msgid_plural "lumps of coal"
msgstr[0] "carbón"
msgstr[1] "pedazos de carbón"

#. ~ Description for coal
#: lang/json/AMMO_from_json.py
msgid ""
"Flammable black chunks of carbon-based material commonly used for cooking "
"and heating."
msgstr ""
"Trozos negros inflamables de material a base de carbono comúnmente "
"utilizados para cocinar y calentar."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "albuterol"
msgid_plural "albuterol"
msgstr[0] "albuterol"
msgstr[1] "albuteroles"

#. ~ Description for {'str_sp': 'albuterol'}
#: lang/json/AMMO_from_json.py
msgid ""
"A bronchodilator that relaxes muscles in the airways and increases air flow "
"to the lungs."
msgstr ""
"Un broncodilatador que relaja los músculos de las vías respiratorias e "
"incrementa el flujo de aire a los pulmones."

#: lang/json/AMMO_from_json.py
msgid "RA21E medical ampoule"
msgid_plural "RA21E medical ampoules"
msgstr[0] "ampolla médica RA21E"
msgstr[1] "ampollas médicas RA21E"

#. ~ Description for RA21E medical ampoule
#: lang/json/AMMO_from_json.py
msgid ""
"A tiny glass vial filled with advanced fast-healing chemicals which can only"
" be activated by a Rivtech jet injector device.  The packaged instructions "
"describe its efficacy in dealing with infections, wounds, intoxications, "
"envenomations, and general tiredness in enthusiastic detail.  A short safety"
" section at the end warn - in much smaller typeface - against using more "
"than two doses per hour."
msgstr ""
"Un pequeño frasco de vídrio lleno de químicos de curación rápida avanzada "
"que sólo pueden ser activados por un dispositivo de inyección de presión "
"Rivtech. Las instrucciones del paquete describen con todo detalle su "
"eficacia en el tratamiento de infecciones, heridas, intoxicaciones, "
"envenenamientos y cansancio general con un detalle entusiasta. Una corta "
"sección de seguridad al final advierte - en un tipo de letra mucho más "
"pequeño - contra el uso de más de dos dosis por hora."

#: lang/json/AMMO_from_json.py
msgid "RA10K stimulant module"
msgid_plural "RA10K stimulant modules"
msgstr[0] "módulo estimulante RA10K"
msgstr[1] "módulos estimulantes RA10K"

#. ~ Description for RA10K stimulant module
#: lang/json/AMMO_from_json.py
msgid ""
"A pressurized multi-chamber glass vial filled with powerful chemical "
"stimulants which can only be activated by a Rivtech stimulant delivery "
"system."
msgstr ""
"Vial multicámara presurizado de cristal, lleno con estimulantes químicos "
"potentes que solo pueden ser activados por el sistema de entrega de "
"estimulantes de Rivtech."

#: lang/json/AMMO_from_json.py
msgid "rebreather filter cartridge"
msgid_plural "rebreather filter cartridges"
msgstr[0] "cartucho de filtro rebreather"
msgstr[1] "cartuchos de filtros rebreather"

#. ~ Description for rebreather filter cartridge
#: lang/json/AMMO_from_json.py
msgid "A replacement filter cartridge for a rebreather."
msgstr "Un cartucho de filtro de repuesto para el rebreather."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "filter mask cartridge"
msgid_plural "filter mask cartridges"
msgstr[0] "cartucho de máscara para filtro"
msgstr[1] "cartuchos de máscara para filtro"

#. ~ Description for filter mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Small replacement filter cartridge for air filtration masks."
msgstr ""
"Pequeño cartucho de filtro de repuesto para las máscaras de filtración de "
"aire."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "gas mask cartridge"
msgid_plural "gas mask cartridges"
msgstr[0] "cartucho para máscara de gas"
msgstr[1] "cartuchos para máscara de gas"

#. ~ Description for gas mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Medium replacement filter cartridge for air filtration masks."
msgstr ""
"Cartucho de filtro de repuesto mediano para máscaras de filtración de aire."

#: lang/json/AMMO_from_json.py
msgid "chemical mask cartridge"
msgid_plural "chemical mask cartridges"
msgstr[0] "cartucho de máscara química"
msgstr[1] "cartuchos de máscara química"

#. ~ Description for chemical mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Heavy replacement filter cartridge for air filtration masks."
msgstr ""
"Cartucho de filtro de repuesto pesado para las máscaras de filtración de "
"aire."

#: lang/json/AMMO_from_json.py
msgid "nicotine liquid"
msgid_plural "nicotine liquid"
msgstr[0] "nicotina líquida"
msgstr[1] "nicotina líquida"

#. ~ Description for {'str_sp': 'nicotine liquid'}
#: lang/json/AMMO_from_json.py
msgid ""
"A liquid that is made up of propylene glycol, vegetable glycerin, "
"flavorings, and nicotine."
msgstr ""
"Un líquido compuesto por propilenglicol, glicerina vegetal, aromatizantes y "
"nicotina."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "fish bait"
msgid_plural "fish bait"
msgstr[0] "cebo de pesca"
msgstr[1] "cebos de pesca"

#. ~ Description for {'str_sp': 'fish bait'}
#: lang/json/AMMO_from_json.py
msgid "A bait used in traps to lure fish."
msgstr "Un cebo utilizado en trampas para atraer peces."

#: lang/json/AMMO_from_json.py
msgid "spiked homemade rocket"
msgid_plural "spiked homemade rockets"
msgstr[0] "misil casero con pua"
msgstr[1] "misiles caseros con puas"

#. ~ Description for spiked homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a spike welded onto a pipe that was "
"filled with improvised rocket fuel.  Horribly inaccurate, as can be expected"
" of this grade of weapon, but packs a fierce punch… if it hits."
msgstr ""
"Un cohete construido a mano, que consiste en una púa soldada a un tubo que "
"se llenó con combustible de cohete improvisado. Horriblemente inexacto, como"
" puede esperarse de este tipo de arma, pero tiene una feroz pegada... si "
"golpea."

#: lang/json/AMMO_from_json.py
msgid "explosive homemade rocket"
msgid_plural "explosive homemade rockets"
msgstr[0] "misil casero explosivo"
msgstr[1] "misiles caseros explosivos"

#. ~ Description for explosive homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a simple explosive warhead attached onto "
"a pipe, filled with improvised rocket fuel.  Not very powerful, but can be "
"made from scratch."
msgstr ""
"Un cohete construido a mano, que consiste en una simple ojiva explosiva "
"unida a un tubo, lleno de combustible de cohete improvisado. No es muy "
"poderoso, pero puede ser hecho desde cero."

#: lang/json/AMMO_from_json.py
msgid "incendiary homemade rocket"
msgid_plural "incendiary homemade rockets"
msgstr[0] "misil casero incendiario"
msgstr[1] "misiles caseros incendiarios"

#. ~ Description for incendiary homemade rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand built rocket, consisting of a container of flammable gel attached "
"onto a pipe, filled with improvised rocket fuel.  Short-range incendiary - "
"handle with care!"
msgstr ""
"Un cohete construido a mano, que consiste en un contenedor de gel inflamable"
" adherido a un tubo, lleno de combustible de cohete improvisado. Incendiario"
" de corto alcance - ¡manejar con cuidado!"

#: lang/json/AMMO_from_json.py
msgid "unfinished charcoal"
msgid_plural "unfinished charcoal"
msgstr[0] "carbón vegetal incompleto"
msgstr[1] "carbón vegetal incompleto"

#. ~ Description for {'str_sp': 'unfinished charcoal'}
#: lang/json/AMMO_from_json.py
msgid ""
"The result of an interrupted charcoal making process.  Useless, except as "
"fuel in a charcoal kiln."
msgstr ""
"El resultado de una interrupción en el proceso de fabricación de carbón "
"vegetal. Sin utilidad, salvo como combustible en un horno de carbón."

#: lang/json/AMMO_from_json.py
msgid "unfinished calcium carbide"
msgid_plural "unfinished calcium carbide"
msgstr[0] "carburo de calcio sin terminar"
msgstr[1] "carburo de calcio sin terminar"

#. ~ Description for {'str_sp': 'unfinished calcium carbide'}
#: lang/json/AMMO_from_json.py
msgid ""
"The incomplete process of converting coal and lime into calcium carbide.  "
"Useless in this state."
msgstr ""
"El proceso inacabado de convertir el carbón y la cal en carburo de calcio. "
"Sin utilidad en este estado."

#: lang/json/AMMO_from_json.py
msgid "chain link"
msgid_plural "chain links"
msgstr[0] "eslabón de cadena"
msgstr[1] "eslabones de cadena"

#. ~ Description for chain link
#: lang/json/AMMO_from_json.py
msgid "Small metal rings, suitable for constructing chainmail."
msgstr "Pequeños anillos de metal, adecuados para fabricar una cota de malla."

#: lang/json/AMMO_from_json.py
msgid "nitrox"
msgid_plural "nitrox"
msgstr[0] "nitrox"
msgstr[1] "nitrox"

#. ~ Description for {'str_sp': 'nitrox'}
#: lang/json/AMMO_from_json.py
msgid "Mixture of oxygen and nitrogen in proportions suitable for diving."
msgstr "Mezcla de oxígeno y nitrógeno en proporciones adecuadas para bucear."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "extinguishing agent"
msgid_plural "extinguishing agent"
msgstr[0] "agente extintor"
msgstr[1] "agente extintor"

#. ~ Description for {'str_sp': 'extinguishing agent'}
#: lang/json/AMMO_from_json.py
msgid "Dry chemical solution effective in extinguishing fires."
msgstr "Solución química seca eficaz en la extinción de incendios."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "tinder"
msgid_plural "tinder"
msgstr[0] "yesca"
msgstr[1] "yesca"

#. ~ Description for {'str_sp': 'tinder'}
#: lang/json/AMMO_from_json.py
msgid "Flammable material, finely divided for easy combustion."
msgstr ""
"Material inflamable, dividido en finas partes para una combustión fácil."

#: lang/json/AMMO_from_json.py
msgid "RPG die"
msgid_plural "RPG dice"
msgstr[0] "dado de rol"
msgstr[1] "dados de rol"

#. ~ Description for RPG die
#: lang/json/AMMO_from_json.py
msgid "A die used to play various role-playing games."
msgstr "Un dado usado para jugar a varios juegos de rol."

#: lang/json/AMMO_from_json.py
msgid "metal RPG die"
msgid_plural "metal RPG dice"
msgstr[0] "dado de rol de metal"
msgstr[1] "dados de rol de metal"

#. ~ Description for metal RPG die
#: lang/json/AMMO_from_json.py
msgid "A metal die used to play various role-playing games"
msgstr "Un dado de metal usado para jugar a varios juegos de rol"

#: lang/json/AMMO_from_json.py
msgid "bronze"
msgid_plural "bronze"
msgstr[0] "bronce"
msgstr[1] "bronce"

#. ~ Description for {'str_sp': 'bronze'}
#: lang/json/AMMO_from_json.py
msgid "Decent-sized chunks of bronze, for fashioning some old-school items."
msgstr ""
"Unos trozos de tamaño considerable de bronce, para adornar algunos objetos "
"de apariencia antigua."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "glowstick juice"
msgid_plural "glowstick juice"
msgstr[0] "zumo de barra luminosa"
msgstr[1] "zumo de barra luminosa"

#. ~ Description for {'str_sp': 'glowstick juice'}
#: lang/json/AMMO_from_json.py
msgid ""
"A mix of blue dye, base catalyst, and diphenyl oxalate used in glowsticks."
msgstr ""
"Una mezcla de colorante azul, catalizador de base y oxalato de difenilo "
"utilizado en las barras luminosas."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "graphite"
msgid_plural "graphite"
msgstr[0] "grafito"
msgstr[1] "grafito"

#. ~ Description for {'str_sp': 'graphite'}
#: lang/json/AMMO_from_json.py
msgid ""
"Graphite powder mixed with a clay binder.  Produces grey or black marks that"
" are easily erased, but otherwise resistant to moisture, most chemicals, "
"ultraviolet radiation and natural aging."
msgstr ""
"Polvo de grafito mezclado con un aglutinante de arcilla. Produce marcas "
"grises o negras que se borran fácilmente, pero que por lo demás son "
"resistentes a la humedad, a la mayoría de los productos químicos, a la "
"radiación ultravioleta y al envejecimiento natural."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "black pen ink"
msgid_plural "black pen ink"
msgstr[0] "tinta de bolígrafo negro"
msgstr[1] "tinta de bolígrafo negro"

#. ~ Description for {'str_sp': 'black pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Carbon black pigment infused with polymers, stabilizers and water to help "
"the ink flow properly."
msgstr ""
"Pigmento negro de carbón infundido con polímeros, estabilizadores y agua "
"para ayudar a que la tinta fluya adecuadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "blue pen ink"
msgid_plural "blue pen ink"
msgstr[0] "tinta de bolígrafo azul"
msgstr[1] "tinta de bolígrafo azul"

#. ~ Description for {'str_sp': 'blue pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Prussian blue, crystal violet and phthalocyanine blue pigments infused with "
"polymers, stabilizers and water to help the ink flow properly."
msgstr ""
"Pigmentos de azul de Prusia, violeta cristalino y azul de ftalocianina "
"infundidos con polímeros, estabilizadores y agua para ayudar a que la tinta "
"fluya adecuadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "green pen ink"
msgid_plural "green pen ink"
msgstr[0] "tinta de bolígrafo verde"
msgstr[1] "tinta de bolígrafo verde"

#. ~ Description for {'str_sp': 'green pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Chlorophyll pigment infused with polymers, stabilizers and water to help the"
" ink flow properly."
msgstr ""
"Pigmento de clorofila infundido con polímeros, estabilizadores y agua para "
"ayudar a que la tinta fluya adecuadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "red pen ink"
msgid_plural "red pen ink"
msgstr[0] "tinta de bolígrafo rojo"
msgstr[1] "tinta de bolígrafo rojo"

#. ~ Description for {'str_sp': 'red pen ink'}
#: lang/json/AMMO_from_json.py
msgid ""
"Eosin dye infused with polymers, stabilizers and water to help the ink flow "
"properly."
msgstr ""
"Tinte de eosina infundida con polímeros, estabilizadores y agua para ayudar "
"a que la tinta fluya adecuadamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "anesthetic"
msgid_plural "anesthetics"
msgstr[0] "anestésico"
msgstr[1] "anestésicos"

#. ~ Description for anesthetic
#: lang/json/AMMO_from_json.py
msgid ""
"A variety of powerful hypnotic, analgesic, and stimulative drugs.  It's "
"intended for use in specialized medical equipment, and can't be administered"
" manually.  You can reload an anesthesia kit with it."
msgstr ""
"Una variedad de poderosas drogas hipnóticas, analgésicas y estimulantes. "
"Está destinado a ser utilizado por un equipo médico especializado y no puede"
" ser administrado manualmente. Puedes recargar un kit de anestesia con él."

#: lang/json/AMMO_from_json.py
msgid "sulfur"
msgid_plural "sulfur"
msgstr[0] "azúfre"
msgstr[1] "azúfre"

#. ~ Description for {'str_sp': 'sulfur'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of pure sulfur.  Primarily used to make battery acid, sulfur is "
"sometimes used as fuel for explosives.  Can be burned to produce acidic "
"smoke that is deadly to bacteria and humans alike, or oxidized to make "
"paper-bleaching agents."
msgstr ""
"Un puñado de azufre puro. Principalmente utilizado en la fabricación de "
"ácido de batería, el azufre puede ser usado como combustible para "
"explosivos. Puede quemarse para producir humo ácido, que es mortal para "
"bacterias y  humanos por igual, u oxidarse para hacer agentes blanqueadores "
"de papel."

#: lang/json/AMMO_from_json.py
msgid "chunk of sulfur"
msgid_plural "chunks of sulfur"
msgstr[0] "trozo de azufre"
msgstr[1] "trozos de azufre"

#. ~ Description for chunk of sulfur
#: lang/json/AMMO_from_json.py
msgid "A chunk of pure sulfur.  Break it up to use it."
msgstr "Un trozo de azufre puro. Rómpelo para usarlo."

#: lang/json/AMMO_from_json.py
msgid "cement"
msgid_plural "cement"
msgstr[0] "cemento"
msgstr[1] "cemento"

#. ~ Description for {'str_sp': 'cement'}
#: lang/json/AMMO_from_json.py
msgid ""
"Portland is most likely long gone, but its memory persists in cement.  This "
"ubiquitous binder can be used for all kinds of advanced masonry.  Just add "
"water."
msgstr ""
"Lo más probable es que Portland haya desaparecido hace tiempo, pero su "
"memoria persiste en el cemento. Este ubicuo aglutinante puede ser usado para"
" todo tipo de construcciones avanzadas. Sólo hay que añadir agua."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "gravel"
msgid_plural "gravel"
msgstr[0] "gravilla"
msgstr[1] "gravilla"

#. ~ Description for {'str_sp': 'gravel'}
#: lang/json/AMMO_from_json.py
msgid "A handful of gravel, smaller than pebbles but larger than sand."
msgstr ""
"Un puñado de grava, más pequeña que los guijarros pero más grande que la "
"arena."

#: lang/json/AMMO_from_json.py
msgid "limestone"
msgid_plural "limestone"
msgstr[0] "caliza"
msgstr[1] "caliza"

#. ~ Description for {'str_sp': 'limestone'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of small chunks of limestone.  Useful for experiments at science "
"fairs, but pretty useless as ammo.  Maybe something could be crafted from "
"this stuff…"
msgstr ""
"Un puñado de pequeños trozos de piedra caliza. Útiles para experimentos en "
"ferias de ciencias, pero bastante inútiles como munición. Tal vez se pueda "
"fabricar algo con estas cosas…"

#: lang/json/AMMO_from_json.py
msgid "quicklime"
msgid_plural "quicklime"
msgstr[0] "cal"
msgstr[1] "cal"

#. ~ Description for {'str_sp': 'quicklime'}
#: lang/json/AMMO_from_json.py
msgid ""
"The product of burning limestone, this white powder is a crucial ingredient "
"in making cement.  That said, it is also extremely caustic and will cause "
"severe burns to any tissue it comes in contact with.  This property could "
"probably be exploited."
msgstr ""
"El resultado de quemar piedra caliza. Este polvo blanco es un ingrediente "
"crucial para hacer cemento. Dicho esto, también es extremadamente cáustico y"
" provocará graves quemaduras en cualquier tejido orgánico con el que entre "
"en contacto. Esta característica probablemente pueda ser explotada."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "sand"
msgid_plural "sand"
msgstr[0] "arena"
msgstr[1] "arena"

#. ~ Description for {'str_sp': 'sand'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of New England sand.  If you had a stoked furnace, you could turn "
"it into glass.  Otherwise, it's only good for making cement."
msgstr ""
"Un puñado de arena de Nueva Inglaterra. Si tienes un buen horno, podrías "
"transformarlo en vidrio. Si no, solo sirve para hacer cemento."

#: lang/json/AMMO_from_json.py
msgid "soil"
msgid_plural "soil"
msgstr[0] "tierra"
msgstr[1] "tierra"

#. ~ Description for {'str_sp': 'soil'}
#: lang/json/AMMO_from_json.py
msgid ""
"A pile of loosely-packed, slightly damp loamy soil.  This mixture of sand, "
"silt and clay is ideal for growing plants."
msgstr ""
"Una pila de tierra margosa ligeramente húmeda, no muy compactada. Esta "
"mezcla de arena, limo y arcilla es ideal para el crecimiento de plantas."

#: lang/json/AMMO_from_json.py
msgid "aluminum powder"
msgid_plural "aluminum powder"
msgstr[0] "polvo de aluminio"
msgstr[1] "polvo de aluminio"

#. ~ Description for {'str_sp': 'aluminum powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of finely-ground aluminum powder.  This strong reducing agent was "
"used in combination with various oxidants for chemical welding and "
"explosives alike.  Just before the Cataclysm, however, it was the basis of "
"virtually all commercial metallic-hued paints and anti-corrosive coatings."
msgstr ""
"Un puñado de polvo de aluminio finamente molido. Este fuerte agente reductor"
" se usa en combinación con varios oxidantes para realizar soldaduras "
"químicas y explosivos. Justo antes del Cataclismo, fue la base de "
"prácticamente todas las pinturas comerciales de tonos metálicos y "
"recubrimientos anticorrosivos."

#: lang/json/AMMO_from_json.py
msgid "zinc powder"
msgid_plural "zinc powder"
msgstr[0] "polvo de cinc"
msgstr[1] "polvo de cinc"

#. ~ Description for {'str_sp': 'zinc powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of zinc powder.  While commercially used mostly in cosmetics and "
"for paints, hobbyists used to mix it with sulfur to make basic rocket fuel "
"or a smokescreen.  When treated with a strong acid, it will produce "
"hydrogen."
msgstr ""
"Un puñado de polvo de zinc. Aunque comercialmente es usado más que nada en "
"cosméticos y pinturas, algunos aficionados lo mezclan con azufre para hacer "
"combustible de cohetes básico y pantallas de humo. Cuando se mezcla con un "
"ácido fuerte, producirá hidrógeno."

#: lang/json/AMMO_from_json.py
msgid "zinc oxide"
msgid_plural "zinc oxide"
msgstr[0] "óxido de zinc"
msgstr[1] "óxido de zinc"

#. ~ Description for {'str_sp': 'zinc oxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of zinc oxide.  It can be reduced into zinc, or used for some "
"other reactions of its own."
msgstr ""
"Un puñado de óxido de zinc. Puede ser reducido a zinc, o usado para algunas "
"otras reacciones por si solo."

#: lang/json/AMMO_from_json.py
msgid "manganese dioxide"
msgid_plural "manganese dioxide"
msgstr[0] "dióxido de manganeso"
msgstr[1] "dióxido de manganeso"

#. ~ Description for {'str_sp': 'manganese dioxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of manganese dioxide powder.  Occurring naturally in the mineral "
"pyrolusite, it is used commercially in the production of alkaline and zinc-"
"carbon batteries."
msgstr ""
"Un puñado de polvo de dióxido de manganeso. Ocurre de forma natural en el "
"mineral pirolusita y se utiliza comercialmente en la producción de baterias "
"alcalinas y de zinc-carbono."

#: lang/json/AMMO_from_json.py
msgid "potassium chloride"
msgid_plural "potassium chloride"
msgstr[0] "cloruro de potasio"
msgstr[1] "cloruro de potasio"

#. ~ Description for {'str_sp': 'potassium chloride'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of potassium chloride.  Although it occurs naturally in the "
"mineral sylvite, it can be produced as a byproduct of the reaction of "
"saltpeter and hydrochloric acid.  It can be used for making fertilizer, or "
"potassium hydroxide by way of electrolysis."
msgstr ""
"Un puñado de cloruro de potasio. Aunque se produce de forma natural en el "
"mineral silvita, puede producirse como subproducto de la reacción del "
"salitre y el ácido clorhídrico. Puede utilizarse para fabricar fertilizante,"
" o hidróxido de potasio por medio de la electrólisis."

#: lang/json/AMMO_from_json.py
msgid "potassium hydroxide"
msgid_plural "potassium hydroxide"
msgstr[0] "hidróxido de potasio"
msgstr[1] "hidróxido de potasio"

#. ~ Description for {'str_sp': 'potassium hydroxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of potassium hydroxide.  Commonly called caustic potash, it was "
"mainly used industrially for its caustic nature.  It can be used as an "
"electrolyte in alkaline batteries, among other applications."
msgstr ""
"Un puñado de hidróxido de potasio. Comúnmente llamado potasa cáustica, fue "
"utilizado principalmente en la industria por su naturaleza cáustica. Puede "
"ser usado como electrolito en las baterias alcalinas, entre otras "
"aplicaciones."

#: lang/json/AMMO_from_json.py
msgid "acetone"
msgid_plural "acetone"
msgstr[0] "acetona"
msgstr[1] "acetona"

#. ~ Description for {'str_sp': 'acetone'}
#: lang/json/AMMO_from_json.py
msgid ""
"Acetone, best known as the primary constituent of most nail polish removers."
"  Flammable, and can be easily used for potent home-made explosives, as "
"demonstrated by the terrorist attacks of 2016."
msgstr ""
"Acetona, conocida por ser el principal ingrediente de la mayoría de los "
"quitaesmaltes. Es inflamable y puede ser utilizado para hacer explosivos "
"caseros, como se demostró en los ataques terroristas del 2016."

#: lang/json/AMMO_from_json.py
msgid "chromium oxide"
msgid_plural "chromium oxide"
msgstr[0] "óxido de cromo"
msgstr[1] "óxido de cromo"

#. ~ Description for {'str_sp': 'chromium oxide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of chromium oxide.  This substance, typically known as the only "
"stable green pigment for paints, is also a mild oxidizer, which can be mixed"
" with aluminum powder to make thermite for welding.  If one had access to a "
"CVD machine and a laboratory worth of reagents, they might be able to "
"produce very durable ceramic layers."
msgstr ""
"Un puñado de óxido de cromo. Esta sustancia, conocida típicamente como el "
"único pigmento verde estable para las pinturas, es también un oxidante "
"suave, que puede mezclarse con polvo de aluminio para hacer termita para "
"soldadura. Si tuvieras acceso a una máquina CVD (Deposición Química de "
"Vapor) y a un laboratorio con reactivos, podrias producir capas de cerámica "
"muy resistentes."

#: lang/json/AMMO_from_json.py
msgid "calcium carbide"
msgid_plural "calcium carbide"
msgstr[0] "carburo de calcio"
msgstr[1] "carburo de calcio"

#. ~ Description for {'str_sp': 'calcium carbide'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of calcium carbide, giving off a faint, garlic-like smell.  "
"Commercially, calcium carbide was used for on-the-spot manufacture of "
"acetylene and historically to power acetylene lamps.  If mixed with water "
"and sealed, it will explode with little strength, but with relatively loud "
"noise and could maybe be used as a decoy."
msgstr ""
"Un puñado de carburo de calcio, que desprende un débil olor a ajo. "
"Comercialmente, el carburo de calcio se usaba para la fabricación de "
"acetileno e históricamente para encender lámparas de acetileno. Si se mezcla"
" con agua y se sella, explotará con poca fuerza, pero con un gran ruido que "
"podria ser usado como señuelo."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "hexamine"
msgid_plural "hexamine"
msgstr[0] "hexamina"
msgstr[1] "hexamina"

#. ~ Description for {'str_sp': 'hexamine'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of waxy hexamine tablets.  This ubiquitous fuel was used to start "
"up almost every garden grill, and no 'real' camping trip could do its "
"cooking without it, until the Cataclysm.  Nowadays, it is even more valuable"
" than before, being the key component in the preparation of several "
"military-grade explosives."
msgstr ""
"Un puñado de tabletas de hexamina cerosa. Este combustible omnipresente se "
"usó para encender casi todas las parrillas de jardín y ningún camping "
"\"real\" podía cocinar sin ellas, hasta el Cataclismo. Hoy en día, es aún "
"más valioso que antes, siendo el componente clave en la preparación de "
"varios explosivos de grado militar."

#: lang/json/AMMO_from_json.py
msgid "hydrogen peroxide (concentrated)"
msgid_plural "hydrogen peroxide (concentrated)"
msgstr[0] "agua oxigenada (concentrada)"
msgstr[1] "agua oxigenada (concentrada)"

#. ~ Description for {'str_sp': 'hydrogen peroxide (concentrated)'}
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated hydrogen peroxide is a powerful oxidant, violently decomposing "
"in contact with most reducing agents.  Can be used as rocket fuel or to make"
" high explosives.  Causes severe burns to any organic matter and may ignite "
"it on contact."
msgstr ""
"El peróxido de hidrógeno concentrado es un poderoso oxidante, que se "
"descompone violentamente en contacto con la mayoría de los agentes "
"reductores. Se puede usar como combustible de misiles o para hacer "
"explosivos potentes. Causa quemaduras severas a cualquier materia orgánica y"
" puede arder al contactar."

#: lang/json/AMMO_from_json.py
msgid "ammonium nitrate"
msgid_plural "ammonium nitrate"
msgstr[0] "nitrato de amonio"
msgstr[1] "nitrato de amonio"

#. ~ Description for {'str_sp': 'ammonium nitrate'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some ammonium nitrate.  This white, crystalline powder is commonly used as a"
" component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Una cantidad de nitrato de amonio. Este polvo blanco y cristalino se utiliza"
" comúnmente como componente en fertilizantes y explosivos. Puede disolverse "
"en agua para bajar bruscamente su temperatura, pero ¿Qué utilidad puede "
"tener este mundo que tenemos?"

#: lang/json/AMMO_from_json.py
msgid "ammonium nitrate pellets"
msgid_plural "ammonium nitrate pellets"
msgstr[0] "bolitas de nit. de amonio"
msgstr[1] "bolitas de nit. de amonio"

#. ~ Description for {'str_sp': 'ammonium nitrate pellets'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some ammonium nitrate pellets.  These pellets are commonly used as a "
"component of fertilizers and explosives.  Could also be dissolved in water "
"to sharply lower its temperature, but is there any use for this quality in "
"this new world?"
msgstr ""
"Algunas bolitas de nitrato de amonio. Estas bolitas se usan comúnmente como "
"componente de fertilizantes y explosivos. También podrían ser disueltos en "
"agua para bajar bruscamente su temperatura, pero ¿tiene algún uso esta "
"calidad en este nuevo mundo?"

#: lang/json/AMMO_from_json.py
msgid "saltpeter"
msgid_plural "saltpeter"
msgstr[0] "salitre"
msgstr[1] "salitre"

#. ~ Description for {'str_sp': 'saltpeter'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of saltpeter.  Sometimes used as a fertilizer, this ubiquitous "
"nitrate is the principal constituent of black gunpowder and simple rocket "
"propellants, such as rocket candy."
msgstr ""
"Un puñado de salitre. A veces usado como fertilizante, este nitrato "
"omnipresente es el constituyente principal de la pólvora negra y de los "
"propulsores de misiles, como el combustible de caramelo."

#: lang/json/AMMO_from_json.py
msgid "niter"
msgid_plural "niter"
msgstr[0] "nitro"
msgstr[1] "nitro"

#. ~ Description for {'str_sp': 'niter'}
#: lang/json/AMMO_from_json.py
msgid ""
"A large crystal of niter, the mineral form of potassium nitrate.  It can be "
"processed into saltpeter."
msgstr ""
"Un cristal grande de nitro, la forma mineral de nitrato de potasio.  Puede "
"ser procesado en salitre."

#: lang/json/AMMO_from_json.py
msgid "aluminum sulfate"
msgid_plural "aluminum sulfate"
msgstr[0] "sulfato de aluminio"
msgstr[1] "sulfato de aluminio"

#. ~ Description for {'str_sp': 'aluminum sulfate'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several crystals of aluminum sulfate.  Historically, an agent for purifying "
"water and as molluscicide, due to the fact that it degenerates their slime."
"  Just before the Cataclysm, its main uses were for adjusting the acidity of"
" the soil and as an additive to baking powder.  If mixed with a strong acid,"
" it could be used to saturate the soil with aluminum, causing all but the "
"most resistant of plants to wither and die."
msgstr ""
"Varios cristales de sulfato de aluminio. Históricamente, un agente para "
"potabilizar el agua y como molusquicida, debido a que degeneraba su "
"mucosidad. Justo antes del Cataclismo, sus usos principales eran ajustar la "
"acidez del suelo y como aditivo en polvo para hornear. Si se mezcla con un "
"ácido fuerte, puede ser usado para saturar el suelo con aluminio, lo que "
"hará que mueran o se marchiten todas las plantas excepto las más "
"resistentes."

#: lang/json/AMMO_from_json.py
msgid "acetic acid"
msgid_plural "acetic acid"
msgstr[0] "ácido acético"
msgstr[1] "ácido acético"

#. ~ Description for {'str_sp': 'acetic acid'}
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated acetic acid, typically used as a chemical reagent and "
"antifungal agent.  Despite its horrid smell, it was used to prepare several "
"types of perfumes, but would making perfume not be too fancy for "
"postapocalyptic New England?"
msgstr ""
"Ácido acético concentrado, normalmente usado como reactivo químico y agente "
"antifúngico. A pesar de su olor horrible, se usaba para preparar varios "
"tipos de perfumes, pero ¿hacer perfume no es demasiado elegante para una "
"Nueva Inglaterra post-apocalíptica?"

#: lang/json/AMMO_from_json.py
msgid "formaldehyde"
msgid_plural "formaldehyde"
msgstr[0] "formaldehído"
msgstr[1] "formaldehido"

#. ~ Description for {'str_sp': 'formaldehyde'}
#: lang/json/AMMO_from_json.py
msgid ""
"Formaldehyde, here dissolved in water, was widely used before the Cataclysm "
"as a precursor to production of many chemicals and materials and as an "
"embalming agent.  Easily identifiable by its pungent odor.  Terribly toxic, "
"carcinogenic, and volatile."
msgstr ""
"El formaldehido, aquí disuelto en agua, era usado comúnmente antes del "
"Cataclismo como precursor en la producción de muchos químicos y materiales "
"como agente enbalsamador. Facilmente identificable por su olor acre. "
"Terriblemente tóxico, cancerígeno y volátil."

#: lang/json/AMMO_from_json.py
msgid "thermite"
msgid_plural "thermite"
msgstr[0] "termita"
msgstr[1] "termita"

#. ~ Description for {'str_sp': 'thermite'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of silvery-greenish powder, produced by mixing aluminum and "
"chromium oxide.  This mixture, burning at a constant pace and at extremely "
"high temperature, was once used for on-the-spot welding.  Can be used as an "
"incendiary material in a pinch."
msgstr ""
"Un puñado de un polvo verde plateado, producido al mezclar aluminio con "
"óxido de cromo. Esta mezcla, quemada a un ritmo constante y una "
"extremadamente temperatura elevada, se utilizaba para hacer soldaduras "
"inmediatas. Puede ser usada como material incendiario en un apuro."

#: lang/json/AMMO_from_json.py
msgid "ANFO"
msgid_plural "ANFO"
msgstr[0] "NAFO"
msgstr[1] "NAFO"

#. ~ Description for {'str_sp': 'ANFO'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several brownish pellets that were made by allowing ammonium nitrate to "
"absorb an organic fuel.  This ammonium nitrate/fuel oil mixture, or ANFO, is"
" a common industrial explosive due to its stability and low price.  Burns "
"fast, but needs an explosive primer to detonate."
msgstr ""
"Varias bolitas marrones que fueron hechas absorbiendo combustible orgánico "
"en nitrato de amonio. Este mezcla de nitrato de amonio/gasolina o NAFO, es "
"un explosivo industrial común debido a su estabilidad y bajo precio. Se "
"quema rápido pero necesita un pistón explosivo para detonar."

#: lang/json/AMMO_from_json.py
msgid "black gunpowder"
msgid_plural "black gunpowder"
msgstr[0] "pólvora negra"
msgstr[1] "pólvora negra"

#. ~ Description for {'str_sp': 'black gunpowder'}
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of black gunpowder, a mix of saltpeter, charcoal and sulfur.  "
"Pretty useless for making modern cartridges, as the soot produced when it "
"burns will quickly clog any firearm, but it could be used to make some "
"vicious bombs."
msgstr ""
"Un puñado de pólvora negra, una mezcla de salitre, carbón vegetal y azufre. "
"Bastante inútil para hacer cartuchos modernos, ya que el hollín que se "
"produce al quemarse obstruirá rápidamente cualquier arma de fuego, pero "
"podría ser utilizado para hacer algunas bombas atroces."

#: lang/json/AMMO_from_json.py
msgid "match head powder"
msgid_plural "match head powder"
msgstr[0] "polvo de cabeza de cerillas"
msgstr[1] "polvo de cabeza de cerillas"

#. ~ Description for {'str_sp': 'match head powder'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some match head powder from match heads, similar to black gunpowder but a "
"bit weaker.  It can be used in crafting explosives and fuses when other, "
"more suitable candidates are less available."
msgstr ""
"Algunos coinciden que la pólvora de las cabezas de cerillas, es similar a la"
" pólvora negra pero un poco más débil. Puede utilizarse en la fabricación de"
" explosivos y mechas cuando otros candidatos más adecuados están menos "
"disponibles."

#: lang/json/AMMO_from_json.py
msgid "RDX"
msgid_plural "RDX"
msgstr[0] "RDX"
msgstr[1] "RDX"

#. ~ Description for {'str_sp': 'RDX'}
#: lang/json/AMMO_from_json.py
msgid ""
"Several off-white crystals of RDX, or hexogen: a military-grade, shelf-"
"stable high explosive.  Can be cast into shaped charges, or mixed with scrap"
" to pepper the blast area with high-velocity shrapnel."
msgstr ""
"Varios cristales blanquecinos de RDX o hexógeno: un alto explosivo de grado "
"militar, estable. Puede ser moldeado en cargas o mezclado con chatarra para "
"acribillar el área de la explosión con metralla de alta velocidad."

#: lang/json/AMMO_from_json.py
msgid "composition b"
msgid_plural "composition b"
msgstr[0] "composición B"
msgstr[1] "composición B"

#. ~ Description for {'str_sp': 'composition b'}
#: lang/json/AMMO_from_json.py
msgid ""
"Composition B is an explosive consisting of castable mixtures of RDX and "
"TNT.  It is used as the main explosive filling in artillery projectiles, "
"rockets, land mines, hand grenades and various other munitions."
msgstr ""
"La composición B es un explosivo que consiste en una mezcla fundible de RDX "
"y TNT. Se utiliza como el principal relleno explosivo en proyectiles de "
"artillería, cohetes, minas terrestres, granadas de mano y otras municiones "
"diversas."

#: lang/json/AMMO_from_json.py
msgid "HMTD"
msgid_plural "HMTD"
msgstr[0] "HMTD"
msgstr[1] "HMTD"

#. ~ Description for {'str_sp': 'HMTD'}
#: lang/json/AMMO_from_json.py
msgid ""
"Hexamine peroxide: this fine, yellowish powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, but best not store it for too long."
msgstr ""
"Peróxido de hexamina: este polvo fino amarillento es un potente explosivo "
"primario, que se usa para iniciar la detonación de explosivos más estables, "
"como el RDX. Es relativamente estable pero mejor no tenerlo guardado por "
"mucho tiempo."

#: lang/json/AMMO_from_json.py
msgid "APEX"
msgid_plural "APEX"
msgstr[0] "APEX"
msgstr[1] "APEX"

#. ~ Description for {'str_sp': 'APEX'}
#: lang/json/AMMO_from_json.py
msgid ""
"Acetone peroxide: this fine, white crystalline powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, with a fruit like smell when pure."
msgstr ""
"Peróxido de acetona: este fino,  polvo cristalino blanco es un potente "
"explosivo primario, utilizado para iniciar la detonación de explosivos más "
"estables, como el RDX. Relativamente estable, con un olor a fruta cuando "
"está puro."

#: lang/json/AMMO_from_json.py
msgid "improvised rocket fuel"
msgid_plural "improvised rocket fuel"
msgstr[0] "combustible de cohetes improvisado"
msgstr[1] "combustible de cohetes improvisado"

#. ~ Description for {'str_sp': 'improvised rocket fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A chunk of a zinc powder and sulfur mixture, bound together by superglue, "
"that can be used as an impromptu rocket fuel."
msgstr ""
"Un trozo de mezcla de polvo de zinc y azufre, unidos con superpegamento, que"
" puede ser usado como un combustible de misiles improvisado."

#: lang/json/AMMO_from_json.py
msgid "detergent"
msgid_plural "detergent"
msgstr[0] "detergente"
msgstr[1] "detergentes"

#. ~ Description for {'str_sp': 'detergent'}
#: lang/json/AMMO_from_json.py
msgid "A popular pre-Cataclysm washing powder."
msgstr "Un detergente en polvo muy popular pre-Cataclismo."

#: lang/json/AMMO_from_json.py
msgid "soap flakes"
msgid_plural "soap flakes"
msgstr[0] "escamas de jabón"
msgstr[1] "escamas de jabón"

#. ~ Description for {'str_sp': 'soap flakes'}
#: lang/json/AMMO_from_json.py
msgid "A bar of soap cut into flakes suitable for use in a washing machine."
msgstr "Una barra de jabón cortada en escamas adecuado para usar en lavadora."

#: lang/json/AMMO_from_json.py
msgid "nanomaterial canister"
msgid_plural "nanomaterial canisters"
msgstr[0] "contenedor de nanomaterial"
msgstr[1] "contenedores de nanomaterial"

#. ~ Description for nanomaterial canister
#: lang/json/AMMO_from_json.py
msgid ""
"Steel canisters containing carbon, iron, titanium, copper and other elements"
" in specifically engineered atomic-scale configurations.  A nanofabricator "
"can assemble them into usable items."
msgstr ""
"Contenedores de acero que contienen carbono, hierro, titanio, cobre y otros "
"elementos en configuraciones específicamente diseñadas en escala atómica. Un"
" nanofabricador puede ensamblar estos elementos en objetos utiles."

#: lang/json/AMMO_from_json.py
msgid "wood ash"
msgid_plural "wood ashes"
msgstr[0] "cenizas de madera"
msgstr[1] "cenizas de maderas"

#. ~ Description for wood ash
#: lang/json/AMMO_from_json.py
msgid ""
"This is almost-weightless residue left after the burning of some substance."
msgstr ""
"Esto es un residuo casi sin peso dejado después de que quemar alguna "
"sustancia."

#: lang/json/AMMO_from_json.py
msgid "wooden bead"
msgid_plural "wooden beads"
msgstr[0] "cuenta de madera"
msgstr[1] "cuentas de madera"

#. ~ Description for wooden bead
#: lang/json/AMMO_from_json.py
msgid ""
"This is a wooden bead.  It can be used to craft inscribable jewelry or "
"create a beaded curtain door."
msgstr ""
"Esto es una cuenta de madera. Puede usarse para fabricar joyería o crear una"
" puerta de cortina de cuentas."

#: lang/json/AMMO_from_json.py
msgid "rosin"
msgid_plural "rosins"
msgstr[0] "colofonia"
msgstr[1] "colofonias"

#. ~ Description for rosin
#: lang/json/AMMO_from_json.py
msgid "This is a chunk of yellowish rosin, usable as a flux for soldering."
msgstr ""
"Este es un trozo de resina amarillenta, utilizable como fundente para "
"soldar."

#: lang/json/AMMO_from_json.py
msgid "concentrated venom"
msgid_plural "concentrated venom"
msgstr[0] "veneno concentrado"
msgstr[1] "veneno concentrado"

#. ~ Description for {'str_sp': 'concentrated venom'}
#: lang/json/AMMO_from_json.py
msgid ""
"A transparent, lightly greenish liquid, refined from the venom of bees and "
"wasps.  Active ingredients include (nor-)adrenaline, dopamine, histamine and"
" protein toxins.  It is now relatively stable, but will require further "
"separation to be useful for anything other than killing you."
msgstr ""
"Un líquido transparente ligeramente verdoso, refinado a partir del veneno de"
" abejas y avispas. Los ingredientes activos incluyen (nor-)adrenalina, "
"dopamina, histamina y toxinas provenientes de proteínas. Ahora es "
"relativamente estable, pero requerirá una mayor separación para ser útil "
"para cualquier otra cosa que no sea matarte."

#: lang/json/AMMO_from_json.py
msgid "concentrated paralytic"
msgid_plural "concentrated paralytic"
msgstr[0] "concentrado paralizante"
msgstr[1] "concentrado paralizante"

#. ~ Description for {'str_sp': 'concentrated paralytic'}
#: lang/json/AMMO_from_json.py
msgid ""
"The concentrated paralytic agent, originally from a triffid.  Given your "
"experience with its effects (chiefly gathered while sourcing this batch) and"
" their striking similarity to earthly flora, you figure it's related to "
"curarines.  Might come in handy in crafting more useful things."
msgstr ""
"El agente paralizante concentrado, originalmente de un trífido. Dada tu "
"experiencia con sus efectos (principalmente reunidos mientras obtenía este "
"lote) y su sorprendente similitud con la flora terrestre, te imaginas que "
"está relacionado con las curarinas. Podría ser útil para hacer cosas más "
"útiles."

#: lang/json/AMMO_from_json.py
msgid "rocuronium"
msgid_plural "rocuronium"
msgstr[0] "rocuronio"
msgstr[1] "rocuronio"

#. ~ Description for {'str_sp': 'rocuronium'}
#: lang/json/AMMO_from_json.py
msgid ""
"Rocuronium bromide, a fast-acting muscle relaxant.  Used primarily in "
"emergency medicine because of its relative stability, it can serve as a "
"component of a balanced anesthesia in a pinch."
msgstr ""
"Bromuro de rocuronio, un relajante muscular de acción rápida. Utilizado "
"principalmente en la medicina de emergencia por su relativa estabilidad, "
"puede servir como componente de una anestesia balanceada en un apuro."

#: lang/json/AMMO_from_json.py
msgid "ethanol"
msgid_plural "ethanol"
msgstr[0] "etanol"
msgstr[1] "etanol"

#. ~ Description for {'str_sp': 'ethanol'}
#: lang/json/AMMO_from_json.py
msgid ""
"Extremely pure alcohol suitable for use as a component in chemical "
"reactions.  You could also water it down and drink it, or use it as fuel in "
"alcohol-burning stoves."
msgstr ""
"Alcohol extremadamente puro, útil para usar como componente en reacciones "
"químicas. También le puedes agregar agua para hacerlo bebible, o usarlo como"
" combustible en cocinas de alcohol."

#: lang/json/AMMO_from_json.py
msgid "denatured alcohol"
msgid_plural "denatured alcohols"
msgstr[0] "alcohol desnaturalizado"
msgstr[1] "alcohol desnaturalizado"

#. ~ Description for denatured alcohol
#: lang/json/AMMO_from_json.py
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr ""
"Una solución muy potente de etanol mezclada con metanol para convertirlo en "
"tóxico al ingerir, asi como evitar regulaciones pre-apocalípticas sobre el "
"etanol. Pensado para ser usado en cocinas de alcohol y como un solvente."

#: lang/json/AMMO_from_json.py
msgid "methanol"
msgid_plural "methanol"
msgstr[0] "metanol"
msgstr[1] "metanol"

#. ~ Description for {'str_sp': 'methanol'}
#: lang/json/AMMO_from_json.py
msgid ""
"High purity methanol suitable for use in chemical reactions.  Could be used "
"in alcohol-burning stoves.  Very toxic."
msgstr ""
"Metanol de alta pureza, útil para usar en reacciones químicas. Puede ser "
"utilizado como combustible en cocinas de alcohol. Muy tóxico."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
#: src/iexamine.cpp
msgid "diesel"
msgid_plural "diesel"
msgstr[0] "gasoil"
msgstr[1] "gasoil"

#. ~ Description for {'str_sp': 'diesel'}
#: lang/json/AMMO_from_json.py
msgid ""
"Petroleum-based fuel made from a byproduct of the gasoline making process."
msgstr ""
"Combustible a base de petróleo hecho de un subproducto del proceso de "
"fabricación de la gasolina."

#: lang/json/AMMO_from_json.py
msgid "JP8 fuel"
msgid_plural "JP8 fuel"
msgstr[0] "combustible JP8"
msgstr[1] "combustible JP8"

#. ~ Description for {'str_sp': 'JP8 fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A kerosene-based fuel used mainly by US military vehicles as a replacement "
"for diesel and jet fuel, to simplify logistics."
msgstr ""
"Combustible a base de queroseno utilizado principalmente por los vehículos "
"militares de los Estados Unidos como sustituto del gasoil y el combustible "
"para aviones, para simplificar logísticas."

#: lang/json/AMMO_from_json.py lang/json/material_from_json.py
msgid "avgas fuel"
msgid_plural "avgas fuel"
msgstr[0] "combustible avgas"
msgstr[1] "combustible avgas"

#. ~ Description for {'str_sp': 'avgas fuel'}
#: lang/json/AMMO_from_json.py
msgid "A specialized type of petroleum-based fuel used to power aircraft."
msgstr ""
"Un tipo especializado de combustible basado en el petróleo que se utiliza "
"para propulsar aeronaves."

#: lang/json/AMMO_from_json.py
msgid "biodiesel"
msgid_plural "biodiesel"
msgstr[0] "biodiésel"
msgstr[1] "biodiésel"

#. ~ Description for {'str_sp': 'biodiesel'}
#: lang/json/AMMO_from_json.py
msgid ""
"Vegetable oil- or animal fat-based diesel fuel consisting of long-chain "
"alkyl (methyl, ethyl, or propyl) esters."
msgstr ""
"Combustible diésel a base de aceite vegetal o grasa animal que consiste en "
"ésteres de alquilo de cadena larga (metilo, etilo o propilo)."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
#: src/iexamine.cpp
msgid "gasoline"
msgid_plural "gasoline"
msgstr[0] "gasolina"
msgstr[1] "gasolina"

#. ~ Description for {'str_sp': 'gasoline'}
#: lang/json/AMMO_from_json.py
msgid ""
"Gasoline is a highly flammable liquid.  When under pressure, it has the "
"potential for violent explosion."
msgstr ""
"La gasolina es un líquido muy inflamable. Cuando se le aplica presión tiene "
"el potencial de explotar violentamente."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "lamp oil"
msgid_plural "lamp oil"
msgstr[0] "aceite de lámpara"
msgstr[1] "aceite de lámpara"

#. ~ Description for {'str_sp': 'lamp oil'}
#: lang/json/AMMO_from_json.py
msgid "A thin and clean-burning oil made for use in oil lamps."
msgstr ""
"Aceite fino y de combustión limpia destinado a las lámparas de aceite."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "motor oil"
msgid_plural "motor oil"
msgstr[0] "aceite de motor"
msgstr[1] "aceite de motor"

#. ~ Description for {'str_sp': 'motor oil'}
#: lang/json/AMMO_from_json.py
msgid "An oil made for use in car engines."
msgstr "Un aceite hecho para su uso en motores de vehículos."

#: lang/json/AMMO_from_json.py
msgid "napalm"
msgid_plural "napalm"
msgstr[0] "napalm"
msgstr[1] "napalm"

#. ~ Description for {'str_sp': 'napalm'}
#: lang/json/AMMO_from_json.py
msgid ""
"This is gasoline mixed with some other components to make it stick to the "
"surface and increase burning temperature, meant to be used with a "
"flamethrower."
msgstr ""
"Esta es una mezcla de gasolina con otros componentes hecha para que se "
"adhiera a superficies e incrementar la temperatura a la que arde, creado "
"para ser utilizado por un lanzallamas."

#: lang/json/AMMO_from_json.py
msgid "gelled gasoline"
msgid_plural "gelled gasoline"
msgstr[0] "gasolina gelificada"
msgstr[1] "gasolina gelificada"

#. ~ Description for {'str_sp': 'gelled gasoline'}
#: lang/json/AMMO_from_json.py
msgid ""
"A flammable gel composed of gasoline and dissolved shavings of polystyrene, "
"roughly similar in properties to napalm b.  It's meant to be used with a "
"flamethrower."
msgstr ""
"Un gel inflamable compuesto de gasolina y virutas disueltas de poliestireno,"
" de propiedades aproximadamente similares a las del napalm b.  Creado para "
"ser utilizado por un lanzallamas."

#: lang/json/AMMO_from_json.py
msgid "flamethrower fuel"
msgid_plural "flamethrower fuel"
msgstr[0] "combustible para lanzallamas"
msgstr[1] "combustible para lanzallamas"

#. ~ Description for {'str_sp': 'flamethrower fuel'}
#: lang/json/AMMO_from_json.py
msgid ""
"A mixture of gasoline and diesel oil in equal parts.  Its combustion "
"properties make it unfit for applications where you would use any of them "
"separately, but it can be used to feed a flamethrower."
msgstr ""
"Una mezcla de gasolina y diesel a partes iguales. Sus propiedades de "
"combustión lo hacen inapropiado para aplicaciones en las que se usaría "
"cualquiera de ellos por separado, pero puede ser usado para alimentar un "
"lanzallamas."

#: lang/json/AMMO_from_json.py
msgid "autoclave pouch"
msgid_plural "autoclave pouches"
msgstr[0] "bolsa para autoclave"
msgstr[1] "bolsas para autoclave"

#. ~ Description for autoclave pouch
#: lang/json/AMMO_from_json.py
msgid ""
"This is a medical device that bears the approval of the FDA (Food and Drug "
"Administration).  If used properly, these pouches can keep things sterile "
"indefinitely."
msgstr ""
"Este es un dispositivo médico que cuenta con la aprobación de la FDA "
"(Administracion Comidas y Drogas Americana). Si se usan correctamente, estas"
" bolsas pueden mantener las cosas estériles indefinidamente."

#: lang/json/AMMO_from_json.py
msgid "shrapnel"
msgid_plural "shrapnel"
msgstr[0] "metralla"
msgstr[1] "metralla"

#. ~ Description for {'str_sp': 'shrapnel'}
#: lang/json/AMMO_from_json.py
msgid "A twisted shard of jagged metal."
msgstr "Un fragmento retorcido de metal dentado."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss slug"
msgid_plural "blunderbuss slugs"
msgstr[0] "bala de trabuco"
msgstr[1] "balas de trabuco"

#. ~ Description for blunderbuss slug
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of a large hunk of metal.  Better for distance."
msgstr ""
"Una bala para trabuco hecha con una gran pieza de metal. Mejor para la "
"distancia."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss shot"
msgid_plural "blunderbuss shots"
msgstr[0] "disparo de trabuco"
msgstr[1] "disparos de trabuco"

#. ~ Description for blunderbuss shot
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of marbles, pebbles, bearings, basically "
"whatever is at hand.  The homemade pellet spread and number makes up for the"
" shoddy quality."
msgstr ""
"Un preparado para un disparo de trabuco formado por canicas, guijarros, "
"cojinetes, básicamente lo que sea que esté a mano. La dispersión y el número"
" de perdigones caseros compensan la mala calidad."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss flechette"
msgid_plural "blunderbuss flechettes"
msgstr[0] "flechette de trabuco"
msgstr[1] "flechettes de trabuco"

#. ~ Description for blunderbuss flechette
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of homemade flechette made out of nails.  Shreds"
" armor."
msgstr ""
"Un preparado de trabuco hecho con flechettes caseros hechos a partir de "
"clavos. Destruye la armadura."

#: lang/json/AMMO_from_json.py
msgid "40mm flare"
msgid_plural "40mm flares"
msgstr[0] "40mm bengalas"
msgstr[1] "40mm bengala"

#. ~ Description for 40mm flare
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm signal flare.  It will burn brightly for up to a minute, and will "
"also leave a streak of smoke cover in its wake."
msgstr ""
"Una bengala de señalización de 40mm. Arderá brillantemente durante un "
"minuto, y también creará una cortina de humo con su estela."

#: lang/json/AMMO_from_json.py
msgid "40x46mm"
msgid_plural "40x46mms"
msgstr[0] "40x46mm"
msgstr[1] "40x46mms "

#. ~ Description for 40x46mm
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm grenade with a flashbang load.  It will detonate with a blast of "
"light and sound, designed to blind, deafen, and disorient anyone nearby."
msgstr ""
"Una granada de 40mm con carga cegadora. Detonará liberando un estallido de "
"luz y sonido, diseñada para cegar, ensordecer y desorientar."

#: lang/json/AMMO_from_json.py
msgid "40mm incendiary"
msgid_plural "40mm incendiaries"
msgstr[0] "granada incendiaria de 40mm"
msgstr[1] "granadas incendiarias de 40mm"

#. ~ Description for 40mm incendiary
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm grenade with a small napalm load, designed to create a burst of "
"flame."
msgstr ""
"Una granada 40mm con una pequeña carga de napalm, diseñada para crear una "
"explosión de llamas."

#: lang/json/AMMO_from_json.py
msgid "40mm smoke cover"
msgid_plural "40mm smoke covers"
msgstr[0] "granada de humo 40mm"
msgstr[1] "granadas de humo 40mm"

#. ~ Description for 40mm smoke cover
#: lang/json/AMMO_from_json.py
msgid "A 40mm grenade designed to provide smoke cover."
msgstr "Una granada de 40mm diseñada para crear una cortina de humo."

#: lang/json/AMMO_from_json.py
msgid "40mm slug"
msgid_plural "40mm slugs"
msgstr[0] "bala de 40 mm"
msgstr[1] "balas de 40 mm"

#. ~ Description for 40mm slug
#: lang/json/AMMO_from_json.py
msgid ""
"A 40mm shell loaded with a massive bullet.  Say goodbye to your shoulder, I "
"guess."
msgstr ""
"Un cartucho de 40mm cargado con una bala enorme. Di adios a tu hombro, "
"supongo."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "modified mininuke"
msgid_plural "modified mininukes"
msgstr[0] "bomba nuclear modificada"
msgstr[1] "bombas nucleares modificadas"

#. ~ Description for modified mininuke
#: lang/json/AMMO_from_json.py
msgid ""
"A heavily modified handheld nuclear device on a rocket.  Intended to be "
"fired from a specialized launcher, it has been rigged to explode on impact "
"instead of on a timer.  It can fly further than the explosion will reach, "
"probably."
msgstr ""
"Una pequeña bomba nuclear de mano modificada en un misil. Diseñada para ser "
"disparada desde un lanzador especializado, ha sido modificada para explotar "
"al impactar en vez de con una cuenta atras. Puede lanzarse más lejos de lo "
"que la explosión alcanza, probablemente."

#: lang/json/AMMO_from_json.py
msgid "scrap shotcanister"
msgid_plural "scrap shotcanisters"
msgstr[0] "cartucho de papel de chatarra"
msgstr[1] "cartuchos de papel de chatarra"

#. ~ Description for scrap shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with assorted pieces of scrap metal."
msgstr ""
"Este pequeño recipiente de papel que se parece a un cartucho que está lleno "
"hasta el borde de piezas de chatarra."

#: lang/json/AMMO_from_json.py
msgid "pebble shotcanister"
msgid_plural "pebble shotcanisters"
msgstr[0] "cartucho de papel de guijarros"
msgstr[1] "cartuchos de papel de guijarros"

#. ~ Description for pebble shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with tiny pebbles.  Damage is pathetic but flight is much more stable than "
"scrap."
msgstr ""
"Este pequeño recipiente de papel se parece a un cartucho lleno hasta el "
"borde de diminutos guijarros. El daño es patético pero el vuelo es mucho más"
" estable que la chatarra."

#: lang/json/AMMO_from_json.py
msgid "flechette shotcanister"
msgid_plural "flechette shotcanisters"
msgstr[0] "cartucho de papel de flechette"
msgstr[1] "cartuchos de papel de flechettes"

#. ~ Description for flechette shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with handmade flechettes, giving it some armor piercing capabilities."
msgstr ""
"Este pequeño recipiente de papel que se parece a un cartucho está lleno "
"hasta el borde con flechettes hechas a mano, lo que le da una cierta "
"capacidad de perforación de armadura."

#: lang/json/AMMO_from_json.py
msgid "bearing shotcanister"
msgid_plural "bearing shotcanisters"
msgstr[0] "cartucho de papel de cojinetes"
msgstr[1] "cartuchos de papel de cojinetes"

#. ~ Description for bearing shotcanister
#: lang/json/AMMO_from_json.py
msgid ""
"This small paper canister resembling a crude shotshell is filled to the brim"
" with handmade bearings, stabilizing its flight pattern a tiny bit."
msgstr ""
"Este pequeño recipiente de papel que se parece a un cartucho está lleno "
"hasta el borde con cojinetes hechos a mano, estabilizando su patrón de vuelo"
" un poco."

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ"
msgid_plural "10mm Auto FMJ"
msgstr[0] "10mm Auto FMJ"
msgstr[1] "10mm Auto FMJ"

#. ~ Description for {'str_sp': '10mm Auto FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
"Jacketed 10mm Auto ammunition with 180gr bullets.  The 10mm Auto cartridge "
"is a rather powerful handgun round and the progenitor to the more popular "
".40 S&W."
msgstr ""
"Una bala  de 180gr de 10mm Auto con chaqueta metálica. El cartucho Auto de "
"10mm de pistola es bastante poderoso y el progenitor del más popular .40 "
"S&W."

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ, black powder"
msgid_plural "10mm Auto FMJ, black powder"
msgstr[0] "10mm Auto FMJ, pólvora negra"
msgstr[1] "10mm Auto FMJ, pólvora negra"

#: lang/json/AMMO_from_json.py
msgid "10mm Auto FMJ, reloaded"
msgid_plural "10mm Auto FMJ, reloaded"
msgstr[0] "10mm Auto FMJ, recargado"
msgstr[1] "10mm Auto FMJ, recargado"

#: lang/json/AMMO_from_json.py
msgid "H&K 12mm"
msgid_plural "H&K 12mm"
msgstr[0] "H&K 12mm"
msgstr[1] "H&K 12mm"

#. ~ Description for {'str_sp': 'H&K 12mm'}
#: lang/json/AMMO_from_json.py
msgid ""
"The Heckler & Koch 12mm projectiles are used in H&K railguns.  It's made of "
"a ferromagnetic metal, probably cobalt."
msgstr ""
"Los proyectiles Heckler & Koch 12mm son utilizados en los cañones de riel "
"H&K. Está hecho de metal ferromagnético, probablemente cobalto."

#: lang/json/AMMO_from_json.py
msgid "20x66mm beanbag"
msgid_plural "20x66mm beanbags"
msgstr[0] "20x66mm beanbag"
msgstr[1] " 20x66mm beanbag"

#. ~ Description for 20x66mm beanbag
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, sublethal beanbag type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo 20x66mm de tipo beanbag no letal. "
"Munición exclusiva para escopetas Rivtech. Al no tener casquillo, no pueden "
"ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flechette, handmade"
msgid_plural "20x66mm flechettes, handmade"
msgstr[0] "20x66mm flechettes, hecho a mano"
msgstr[1] "20x66mm flechettes, hechos a mano"

#. ~ Description for 20x66mm flechette, handmade
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless flechette rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Réplicas hechas a mano de cartuchos de flechette de Rivtech 20x66mm sin "
"casquillo. Al no tener casquillo, no pueden ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm buckshot, handmade"
msgid_plural "20x66mm buckshot, handmade"
msgstr[0] "20x66mm postas, hecho a mano"
msgstr[1] "20x66mm postas, hechos a mano"

#. ~ Description for {'str_sp': '20x66mm buckshot, handmade'}
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless buckshot rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Réplicas hechas a mano de cartuchos de postas de Rivtech 20x66mm sin "
"casquillo. Al no tener casquillo, no pueden ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm slug, handmade"
msgid_plural "20x66mm slugs, handmade"
msgstr[0] "20x66mm bala, hecho a mano"
msgstr[1] "20x66mm bala, hechos a mano"

#. ~ Description for 20x66mm slug, handmade
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless solid projectile "
"rounds.  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"Réplicas hechas a mano de cartuchos solidas de Rivtech 20x66mm sin "
"casquillo. Al no tener casquillo, no pueden ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm explosive"
msgid_plural "20x66mm explosive"
msgstr[0] "20x66mm explosivo"
msgstr[1] "20x66mm explosivo"

#. ~ Description for {'str_sp': '20x66mm explosive'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, explosive projectile type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo de 20x66mm de tipo proyectil explosivo. "
"Munición exclusiva para escopetas Rivtech. Al no tener casquillo, no pueden "
"ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flare"
msgid_plural "20x66mm flares"
msgstr[0] "20x66mm bengala"
msgstr[1] "20x66mm bengala"

#. ~ Description for 20x66mm flare
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, signal flare type.  Proprietary ammunition "
"for Rivtech shotguns.  Being caseless rounds, these cannot be disassembled "
"or reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo 20x66mm, de tipo bengala de "
"señalización. Munición exclusiva para escopetas Rivtech.  Al no tener "
"casquillo, no pueden ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm flechette"
msgid_plural "20x66mm flechettes"
msgstr[0] "20x66mm flechettes"
msgstr[1] "20x66mm flechettes"

#. ~ Description for 20x66mm flechette
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, flechette type.  Proprietary ammunition for"
" Rivtech shotguns.  Being caseless rounds, these cannot be disassembled or "
"reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo 20x66mm  de tipo flechette. Munición "
"exclusiva para escopetas Rivtech. Al no tener casquillos, no pueden ser "
"desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm frag"
msgid_plural "20x66mm frag"
msgstr[0] "20x66mm frag"
msgstr[1] "20x66mm frag"

#. ~ Description for {'str_sp': '20x66mm frag'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, explosive fragmentation type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo 20x66mm de tipo fragmentación explosiva."
" Munición exclusiva para escopetas Rivtech. Al no tener casquillo, no pueden"
" ser desmontados ni recargados."

#: lang/json/AMMO_from_json.py
msgid "20x66mm incendiary"
msgid_plural "20x66mm incendiary"
msgstr[0] "20x66mm incendiario"
msgstr[1] "20x66mm incendiario"

#. ~ Description for {'str_sp': '20x66mm incendiary'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, incendiary type.  Proprietary ammunition "
"for Rivtech shotguns.  Being caseless rounds, these cannot be disassembled "
"or reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillos 20x66mm de tipo incendiario. Munición "
"exclusiva para escopetas Rivtech. Al no tener casquillo, no pueden ser "
"desmontadas ni recargadas."

#: lang/json/AMMO_from_json.py
msgid "20x66mm buckshot"
msgid_plural "20x66mm buckshot"
msgstr[0] "20x66mm postas"
msgstr[1] "20x66mm postas"

#. ~ Description for {'str_sp': '20x66mm buckshot'}
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, buckshot type.  Proprietary ammunition for "
"Rivtech shotguns.  Being caseless rounds, these cannot be disassembled or "
"reloaded."
msgstr ""
"Cartuchos de escopeta sin casquillo 20x66mm de tipo postas. Munición "
"exclusiva para escopetas Rivtech. Al no tener casquillo, no pueden ser "
"desmontados ni recargados."

