msgstr[0] ".45-70 +P perforante"
msgstr[1] ".45-70 +P perforante"

#. ~ Description for .45-70 +P penetrator
#: lang/json/AMMO_from_json.py
msgid ""
".45-70 Government +P ammunition loaded with a 305 grain solid copper "
"penetrator projectile.  Designed for maximum penetration through thick hide "
"and bone while maintaining ideal wounding characteristics."
msgstr ""
"Munición .45-70 Government +P cargada con un proyectil de 305 granos de "
"cobre solido perforante. Diseñada para maximizar la penetración de pellejo "
"duro y hueso manteniendo las características ideales para crear heridas."

#: lang/json/AMMO_from_json.py
