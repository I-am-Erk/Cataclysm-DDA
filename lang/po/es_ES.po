#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Dodgeball Player"
msgstr "Jugador de Balón Prisionero"

#. ~ Profession (male Dodgeball Player) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"In dodgeball, failing to dodge meant taking a ball to the head and being out"
" of the game.  In the Cataclysm, it means getting eaten by monsters.  Don't "
"slip up."
msgstr ""
"En el balón prisionero, fallar al esquivar significaba recibir un pelotazo "
"en la cabeza y quedar fuera del juego. En el Cataclismo, significa ser "
"comido por los monstruos. No te equivoques."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Dodgeball Player"
msgstr "Jugadora de Balón Prisionero"

#. ~ Profession (female Dodgeball Player) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"In dodgeball, failing to dodge meant taking a ball to the head and being out"
