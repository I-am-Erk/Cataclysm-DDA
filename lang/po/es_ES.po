#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "alumentum"
msgid_plural "alumentum"
msgstr[0] "alumento"
msgstr[1] "alumento"

#. ~ Description for {'str_sp': 'alumentum'}
#: lang/json/AMMO_from_json.py
msgid ""
"Alumentum is magically processed coal or charcoal.  It burns as hot as "
"magnesium, and for a significantly longer period of time.  One of the very "
"few magical materials that is still produced in any quantity today due to "
"its usefulness."
msgstr ""
"Alumento es un carbón procesado mágicamente. Arde a tanta temperatura como "
"el magnesio, y durante un período de tiempo significativamente más largo. "
"Uno de los pocos materiales mágicos que se sigue produciendo en cualquier "
"cantidad hoy en día debido a su utilidad."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "orichalcum arrow"
msgid_plural "orichalcum arrows"
msgstr[0] "flecha de oricalco"
msgstr[1] "flechas de oricalco"

#. ~ Description for orichalcum arrow
#: lang/json/AMMO_from_json.py
msgid ""
"An arrow composed of a sliver of orichalcum.  The arrow has a mysterious "
"glow.  Has a very high chance of staying intact when fired, however can only"
" be fired from Ichaival."
msgstr ""
"Flecha compuesta de una astilla de oricalco. La flecha tiene un brillo "
"misterioso. Tiene muchas posibilidades de permanecer intacta cuando se "
"dispara, sin embargo sólo puede ser disparada con el Ichaival."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "dragon blood"
msgid_plural "dragon blood"
msgstr[0] "sangre de dragón"
msgstr[1] "sangre de dragón"

#. ~ Description for {'str_sp': 'dragon blood'}
#: lang/json/AMMO_from_json.py
msgid ""
"Blood of a dragon, it radiates warmth and looking at it you see moving "
"patterns form and disappear in it as if looking at an actual fire."
msgstr ""
"Sangre de un dragón, irradia calor y al mirarlo se ven patrones de "
"movimiento que se forman y desaparecen en él como si se tratara de un fuego "
"real."

#: lang/json/AMMO_from_json.py lang/json/COMESTIBLE_from_json.py
#: lang/json/ammunition_type_from_json.py
msgid "tainted blood"
msgid_plural "tainted blood"
msgstr[0] "sangre contaminada"
msgstr[1] "sangre contaminada"

#: lang/json/AMMO_from_json.py lang/json/COMESTIBLE_from_json.py
#: lang/json/COMESTIBLE_from_json.py lang/json/ammunition_type_from_json.py
#: lang/json/material_from_json.py
msgid "blood"
msgid_plural "blood"
msgstr[0] "sangre"
msgstr[1] "sangre"

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "crystallized mana"
msgid_plural "crystallized mana"
msgstr[0] "mana cristalizada"
msgstr[1] "mana cristalizada"

#. ~ Description for {'str_sp': 'crystallized mana'}
#: lang/json/AMMO_from_json.py
msgid ""
"Some crystallized mana.  This can be reloaded into rechargeable mana "
"crystals, but can never be unloaded."
msgstr ""
"Una cantidad de maná cristalizada. Pueden ser recargados en cristales de "
"maná recargables, pero nunca puede ser descargado."

#: lang/json/AMMO_from_json.py
msgid "lump of orichalcum"
msgid_plural "lumps of orichalcum"
msgstr[0] "masas de oricalco"
msgstr[1] "masas de oricalco"

#. ~ Description for lump of orichalcum
#: lang/json/AMMO_from_json.py
msgid ""
"A lump of raw orichalcum.  Needs to be reformed into an ingot to be useful."
msgstr ""
"Un pedazo de oricalco en bruto. Necesita ser reformado en un lingote para "
"ser útil."

#: lang/json/AMMO_from_json.py
msgid "sliver of orichalcum"
msgid_plural "slivers of orichalcum"
msgstr[0] "astilla de oricalco"
msgstr[1] "astillas de oricalco"

#. ~ Description for sliver of orichalcum
#: lang/json/AMMO_from_json.py
msgid ""
"A sliver of orichalcum broken from a larger piece.  Needs to be reformed "
"into an ingot to be useful."
msgstr ""
"Una astilla de oricalco rota de una pieza más grande. Necesita ser reformado"
" en un lingote para ser útil."

#: lang/json/AMMO_from_json.py
msgid "liquid mercury"
msgid_plural "liquid mercury"
msgstr[0] "mercurio líquido"
msgstr[1] "mercurio líquido  "

#. ~ Description for {'str_sp': 'liquid mercury'}
#: lang/json/AMMO_from_json.py
msgid "Elemental liquid mercury.  Known for its use in thermometers."
msgstr "Mercurio líquido elemental. Conocido por su uso en los termómetros."

#: lang/json/AMMO_from_json.py
msgid "lump of mithril"
msgid_plural "lumps of mithril"
msgstr[0] "masa de mithril"
msgstr[1] "masas de mithril"

#. ~ Description for lump of mithril
#: lang/json/AMMO_from_json.py
msgid ""
"A lump of raw mithril.  Needs to be reformed into an ingot to be useful."
msgstr ""
"Un pedazo de mithril en bruto. Necesita ser reformado en un lingote para ser"
" útil."

#. ~ Description for {'str_sp': 'tainted blood'}
#: lang/json/AMMO_from_json.py
msgid ""
"Blood from a blob corrupted creature.  The surface of this black sludge "
"undulates slowly as if agitated by a soft breeze."
msgstr ""
"Sangre de una criatura glóbulo corrupta. La superficie de este cieno negro "
"se ondula lentamente como si fuera agitado por una suave brisa."

#: lang/json/AMMO_from_json.py
msgid "mana core power"
msgid_plural "mana core powers"
msgstr[0] "poder de núcleo del maná"
msgstr[1] "poderes de núcleo del maná"

#. ~ Description for mana core power
#: lang/json/AMMO_from_json.py
msgid "Seeing this is a bug."
msgstr "Ver esto es un bug."

#: lang/json/ARMOR_from_json.py
msgid "survivor utility belt"
msgid_plural "survivor utility belts"
msgstr[0] "cinturón de herramientas de superviviente"
msgstr[1] "cinturones de herramientas de superviviente"

#. ~ Use action holster_msg for survivor utility belt.
#. ~ Use action holster_msg for axe ring holster.
#. ~ Use action holster_msg for baldric.
#. ~ Use action holster_msg for ankle sheath.
#. ~ Use action holster_msg for birchbark ankle sheath.
#. ~ Use action holster_msg for back scabbard.
#. ~ Use action holster_msg for scabbard.
