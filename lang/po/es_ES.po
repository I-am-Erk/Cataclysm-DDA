msgstr[0] "salmón kokanee"
msgstr[1] "salmones kokanee"

#. ~ Description for kokanee salmon
#: lang/json/MONSTER_from_json.py
msgid ""
"A Kokanee salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr ""
"Un salmón Kokanee. Un pescado muy graso y nutritivo. Sabe muy bien ahumado."

#: lang/json/MONSTER_from_json.py
