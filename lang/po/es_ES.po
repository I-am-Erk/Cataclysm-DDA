msgstr[1] "MICROGRAFÍA DE HAADF: T-SUBSTRATOS"

#: lang/json/GENERIC_from_json.py
msgid "XEDRA document"
msgid_plural "XEDRA documents"
msgstr[0] "documento XEDRA"
msgstr[1] "documentos XEDRA"

#: lang/json/GENERIC_from_json.py
msgid "ANOMALOUS ARTIFACT REPORT"
msgid_plural "ANOMALOUS ARTIFACT REPORTs"
msgstr[0] "INFORME DE ARTEFACTOS ANÓMALOS"
msgstr[1] "INFORMES DE ARTEFACTOS ANÓMALOS"

#: lang/json/GENERIC_from_json.py
msgid "foodplace loyalty card"
msgid_plural "foodplace loyalty cards"
msgstr[0] "tarjeta de lealtad de lugarcomida"
msgstr[1] "tarjetas de lealtad de lugarcomida"

#. ~ Description for foodplace loyalty card
#: lang/json/GENERIC_from_json.py
msgid ""
"A bright pink loyalty card, all the points are stamped.  This would "
"definitely prove your fidelity to Foodplace, if it still meant anything…"
msgstr ""
"Una tarjeta de lealtad rosa brillante, todos los puntos están sellados. Esto"
" definitivamente probaría tu fidelidad a Lugarcomida, si aún significara "
"algo..."

#: lang/json/GENERIC_from_json.py
msgid "withered plant"
msgid_plural "withered plants"
msgstr[0] "planta marchita"
msgstr[1] "plantas marchitas"

#. ~ Description for withered plant
#: lang/json/GENERIC_from_json.py
msgid ""
"A dead plant.  Good for starting fires or making a pile of leaves to sleep "
"on."
msgstr ""
"Una planta muerta. Es buena para iniciar incendios o para hacer una pila de "
"hojas para dormir."

#: lang/json/GENERIC_from_json.py
msgid "fur pelt"
msgid_plural "fur pelts"
msgstr[0] "pelaje"
msgstr[1] "pelajes"

#. ~ Description for fur pelt
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of fur from an animal.  Can be made into warm clothing."
msgstr ""
"Un pequeño rollo de pelaje de un animal. Con esto puede hacerse ropa "
"abrigada."

#: lang/json/GENERIC_from_json.py
msgid "faux fur pelt"
msgid_plural "faux fur pelts"
msgstr[0] "piel de imitación de piel"
msgstr[1] "pieles de imitación de piel"

#. ~ Description for faux fur pelt
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of garishly colored faux fur.  Can be made into clothing."
msgstr ""
"Un pequeño perno de piel de imitación de color chillón. Puede convertirse en"
" ropa."

#: lang/json/GENERIC_from_json.py
msgid "leather patch"
msgid_plural "leather patches"
msgstr[0] "parche de cuero"
msgstr[1] "parches de cuero"

#. ~ Description for leather patch
#: lang/json/GENERIC_from_json.py
msgid "A smallish patch of leather, could be used to make tough clothing."
msgstr ""
"Un parche bastante pequeño de cuero, podría ser usado para hacer ropa "
"resistente."

#: lang/json/GENERIC_from_json.py
msgid "felt patch"
msgid_plural "felt patches"
msgstr[0] "parche de fieltro"
msgstr[1] "parches de fieltro"

#. ~ Description for felt patch
#: lang/json/GENERIC_from_json.py
msgid "A smallish patch of felt, could be disassembled for wool fiber."
msgstr ""
"Un pequeño trozo de fieltro, podría desmontarse para obtener fibra de lana."

#: lang/json/GENERIC_from_json.py
msgid "Nomex patch"
msgid_plural "Nomex patches"
msgstr[0] "parche de Nomex"
msgstr[1] "parches de Nomex"

#. ~ Description for Nomex patch
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of Nomex fire-resistant fabric."
msgstr "Un pequeño ovillo de Nomex, que es una tela ignífuga."

#: lang/json/GENERIC_from_json.py
msgid "superglue"
msgid_plural "superglue"
msgstr[0] "superglue"
msgstr[1] "superglue"

#. ~ Description for {'str_sp': 'superglue'}
#: lang/json/GENERIC_from_json.py
msgid "A tube of strong glue.  Used in many crafting recipes."
msgstr "Un tubo de pegamento potente. Se usa para fabricar muchas cosas."

#: lang/json/GENERIC_from_json.py
msgid "bone glue"
msgid_plural "bone glues"
msgstr[0] "pegamento de hueso"
msgstr[1] "pegamentos de hueso"

#. ~ Description for bone glue
#: lang/json/GENERIC_from_json.py
msgid ""
"Glue made from boiling animal bones.  The adhesive isn't strong enough for "
"heavy-duty usages, but it can be used as a varnish or holding together small"
" items."
msgstr ""
"Pegamento hecho de huesos de animales hirviendo. El adhesivo no es lo "
"suficientemente fuerte para usos pesados, pero puede ser usado como barniz o"
" para mantener unidos pequeños objetos."

#: lang/json/GENERIC_from_json.py
msgid "fertilizer"
msgid_plural "fertilizers"
msgstr[0] "fertilizante"
msgstr[1] "fertilizantes"

#. ~ Description for fertilizer
#: lang/json/GENERIC_from_json.py
msgid "A token, representing fertilization of a plant."
msgstr "Un símbolo, representando la fertilización de una planta."

#: lang/json/GENERIC_from_json.py
msgid "steel chain"
msgid_plural "steel chains"
msgstr[0] "cadena de acero"
msgstr[1] "cadenas de acero"

#. ~ Description for steel chain
#: lang/json/GENERIC_from_json.py
msgid ""
"A heavy steel chain.  Useful as a weapon, or for crafting.  It has a chance "
"to wrap around your target, allowing for a bonus unarmed attack."
msgstr ""
"Una cadena pesada de acero. Se puede usar como arma, o para fabricar algo. "
"Puede enroscarse en el enemigo, lo que te permite un ataque desarmado extra."

#: lang/json/GENERIC_from_json.py
msgid "chunk of chitin"
msgid_plural "chunks of chitin"
msgstr[0] "trozos de quitina"
msgstr[1] "trozos de quitina"

#. ~ Description for chunk of chitin
#: lang/json/GENERIC_from_json.py
msgid "A piece of an insect's exoskeleton.  It is light and very durable."
msgstr "Una pieza del exoesqueleto de un insecto. Es liviano y muy duradero."

#: lang/json/GENERIC_from_json.py
msgid "strand of endochitin"
msgid_plural "strands of endochitin"
msgstr[0] "hebra de endoquitina"
msgstr[1] "hebras de endoquitina"

#. ~ Description for strand of endochitin
#: lang/json/GENERIC_from_json.py
msgid "A piece of an insect's endoskeleton."
msgstr "Una pieza del endoesqueleto de un insecto. "

#: lang/json/GENERIC_from_json.py
msgid "cluster of gas sacs"
msgid_plural "clusters of gas sacs"
msgstr[0] "grupo de sacos de gas"
msgstr[1] "grupos de sacos de gas"

#. ~ Description for cluster of gas sacs
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a cluster of membranous bubbles, each about the size of a grape, "
"retrieved from inside a mutant insect.  They float like tiny helium balloons"
" - perhaps they are full of a lighter-than-air gas."
msgstr ""
"Este es un grupo de burbujas membranosas, cada una del tamaño de una uva, "
"recuperadas del interior de un insecto mutante. Flotan como diminutos globos"
" de helio, tal vez están llenos de un gas más ligero que el aire."

#: lang/json/GENERIC_from_json.py
msgid "set of 100 ceramic disk"
msgid_plural "ceramic disks"
msgstr[0] "juego de 100 discos cerámicos"
msgstr[1] "discos cerámicos"

#. ~ Description for set of 100 ceramic disk
#: lang/json/GENERIC_from_json.py
msgid ""
"A set of small slightly elongated disks, made of high-grade ceramic.  They "
"remind you of scales."
msgstr ""
"Un conjunto de pequeños discos ligeramente alargados, hechos de cerámica de "
"alto grado. Te recuerdan a las escamas."

#: lang/json/GENERIC_from_json.py
msgid "chunk of biosilicified chitin"
msgid_plural "chunks of biosilicified chitin"
msgstr[0] "trozo de quitina biosilicificada"
msgstr[1] "trozos de quitina biosilicificada"

#. ~ Description for chunk of biosilicified chitin
#: lang/json/GENERIC_from_json.py
msgid ""
"A lump of exoskeleton that has undergone biosilicification.  It is acid-"
"resistant and remarkably sturdy."
msgstr ""
"Un pedazo de exoesqueleto que ha sido biosilicificado. Es resistente al "
"ácido y sorprendentemente fuerte."

#: lang/json/GENERIC_from_json.py
msgid "bundle of rags"
msgid_plural "bundles of rags"
msgstr[0] "fardo de trapos"
msgstr[1] "fardos de trapos"

#. ~ Description for bundle of rags
#: lang/json/GENERIC_from_json.py
msgid ""
"Cotton rags, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Trapos de algodón, atados fuertemente para su almacenamiento. Desmóntalo "
"para desempaquetarlo."

#: lang/json/GENERIC_from_json.py
msgid "bundle of leather"
msgid_plural "bundles of leather"
msgstr[0] "fardo de cuero"
msgstr[1] "fardos de cuero"

#. ~ Description for bundle of leather
#: lang/json/GENERIC_from_json.py
msgid ""
"Leather patches, bundled tightly together for storage.  Disassemble to "
"unpack."
msgstr ""
"Trozos de cuero, atados para su almacenamiento. Desmóntalo para "
"desempaquetarlo."

#: lang/json/GENERIC_from_json.py
msgid "bundle of felt"
msgid_plural "bundles of felt"
msgstr[0] "fardo de fieltro"
msgstr[1] "fardos de fieltro"

#. ~ Description for bundle of felt
#: lang/json/GENERIC_from_json.py
msgid ""
"Felt patches, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Trozos de fieltro, atados fuertemente para su almacenamiento. Desmóntalo "
"para desempaquetarlo."

#: lang/json/GENERIC_from_json.py
msgid "bundle of planks"
msgid_plural "bundles of planks"
msgstr[0] "fardo de tablones"
msgstr[1] "fardos de tablones"

#. ~ Description for bundle of planks
#: lang/json/GENERIC_from_json.py
msgid ""
"Ten construction planks securely tied together for easier transport.  "
"Disassemble to untie them."
msgstr ""
"Diez tablones de construcción atados juntas para facilitar el transporte. "
"Desmóntalos para desatarlos."

#: lang/json/GENERIC_from_json.py
msgid "bundle of rebars"
msgid_plural "bundles of rebars"
msgstr[0] "fardo de barras corrugadas"
msgstr[1] "fardos de barras corrugadas"

#. ~ Description for bundle of rebars
#: lang/json/GENERIC_from_json.py
msgid ""
"Ten pieces of rebar securely tied together for easier transport.  "
"Disassemble to untie them."
msgstr ""
"Diez piezas de barras corrugadas atadas juntas para facilitar el transporte."
" Desmóntalas para desatarlas."

#: lang/json/GENERIC_from_json.py
msgid "bundle of stout branches"
msgid_plural "bundles of stout branches"
msgstr[0] "fardo de ramas robustas"
msgstr[1] "fardos de ramas robustas"

#. ~ Description for bundle of stout branches
#: lang/json/GENERIC_from_json.py
msgid ""
"Ten stout branches securely tied together for easier transport.  Disassemble"
" to untie them."
msgstr ""
"Diez ramas robustas atadas juntas para facilitar el transporte. Desmóntalas "
"para desatarlas."

#: lang/json/GENERIC_from_json.py
msgid "bundle of long stout branches"
msgid_plural "bundles of long stout branches"
msgstr[0] "fardo de ramas robustas largas"
msgstr[1] "fardos de ramas robustas largas"

#. ~ Description for bundle of long stout branches
#: lang/json/GENERIC_from_json.py
msgid ""
"Five long stout branches securely tied together for easier transport.  "
"Disassemble to untie them."
msgstr ""
"Cinco ramas robustas largas atadas juntas para facilitar el transporte. "
"Desmóntalas para desatarlas."

#: lang/json/GENERIC_from_json.py
msgid "t-substrate sample"
msgid_plural "t-substrate samples"
msgstr[0] "muestra de t-substrato"
msgstr[1] "muestras de t-substrato"

#. ~ Description for t-substrate sample
#: lang/json/GENERIC_from_json.py
msgid ""
"An acrylic cube cast around a small black crystal.  It's tepid to the touch."
msgstr ""
"Un cubo de acrílico fundido alrededor de un pequeño cristal negro. Es tibio "
"al tacto."

#: lang/json/GENERIC_from_json.py
msgid "biollante bud"
msgid_plural "biollante buds"
msgstr[0] "capullo de biollante"
msgstr[1] "capullos de biollante"

#. ~ Description for biollante bud
#: lang/json/GENERIC_from_json.py
msgid ""
"An unopened biollante flower, brilliant purple in color.  It may still have "
"its sap-producing organ intact."
msgstr ""
"Un capullo cerrado de una flor de biollante, de un púrpura brillante. Tal "
"vez todavía contenga intacto el órgano generador de savia."

#: lang/json/GENERIC_from_json.py
msgid "empty canister"
msgid_plural "empty canisters"
msgstr[0] "carcasa vacía"
msgstr[1] "carcasas vacías"

#. ~ Description for empty canister
#: lang/json/GENERIC_from_json.py
msgid ""
"An empty canister, which may have once held tear gas or other substances."
msgstr ""
"Una carcasa vacía, que alguna vez puede haber contenido gas lacrimógeno y "
"otras sustancias."

#: lang/json/GENERIC_from_json.py
msgid "petrified eye"
msgid_plural "petrified eyes"
msgstr[0] "ojo petrificado"
msgstr[1] "ojos petrificados"

#. ~ Description for petrified eye
#: lang/json/GENERIC_from_json.py
msgid ""
"A fist-sized eyeball with a cross-shaped pupil.  It seems to be made of "
"stone, but doesn't look like it was carved."
msgstr ""
"Un globo ocular del tamaño de un puño, con la pupila en forma de cruz. "
"Parece estar hecho de piedra, pero no parece estar tallado."

#: lang/json/GENERIC_from_json.py
msgid "spiral stone"
msgid_plural "spiral stones"
msgstr[0] "piedra espiral"
msgstr[1] "piedras espirales"

#. ~ Description for spiral stone
#: lang/json/GENERIC_from_json.py
msgid ""
"A rock the size of your fist.  It is covered with intricate spirals; it is "
"impossible to tell whether they are carved, naturally formed, or some kind "
"of fossil."
msgstr ""
"Una piedra del tamaño de tu puño. Está cubierta de espirales complejos. Es "
"imposible decir si están tallados, formados naturalmente, o alguna especie "
"de fósil."

#: lang/json/GENERIC_from_json.py
msgid "USB drive"
msgid_plural "USB drives"
msgstr[0] "pendrive"
msgstr[1] "pendrives"

#. ~ Description for USB drive
#: lang/json/GENERIC_from_json.py
msgid "A USB thumb drive.  Useful for holding software."
msgstr "Es un pendrive con puerto USB. Útil para almacenar software."

#: lang/json/GENERIC_from_json.py
msgid "data card"
msgid_plural "data cards"
msgstr[0] "tarjeta de datos"
msgstr[1] "tarjetas de datos"

#. ~ Description for data card
#: lang/json/GENERIC_from_json.py
msgid ""
"Some type of advanced data storage device.  Useful for storing very large "
"amounts of information."
msgstr ""
"Algún tipo de dispositivo avanzado de almacenamiento de datos. Útil para "
"almacenar grandes cantidades de información."

#: lang/json/GENERIC_from_json.py
msgid "FEMA data"
msgid_plural "FEMA data"
msgstr[0] "dato FEMA"
msgstr[1] "datos FEMA"

#. ~ Description for {'str_sp': 'FEMA data'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Evacuation plans, disaster risk projections, personnel lists and last minute"
" communications from just before the end, all scrubbed from FEMA servers and"
" stored in an external hdd."
msgstr ""
"Planes de evacuación, proyecciones de riesgo de desastres, listas de "
"personal y comunicaciones de última hora desde justo antes del final, todo "
"ello borrado de los servidores de la FEMA y almacenado en un hdd externo."

#: lang/json/GENERIC_from_json.py
msgid "candlestick"
msgid_plural "candlesticks"
msgstr[0] "candelabro"
msgstr[1] "candelabros"

#. ~ Description for candlestick
#: lang/json/GENERIC_from_json.py
msgid "A gold candlestick."
msgstr "Un candelabro de oro."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
msgid "blade"
msgid_plural "blades"
msgstr[0] "cuchilla"
msgstr[1] "cuchillas"

#. ~ Description for blade
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, relatively sharp blade.  Could be used to make bladed weaponry, or "
"attached to a car."
msgstr ""
"Es una cuchilla larga sin mango y relativamente afilada. Se puede usar para "
"hacer algún arma blanca, o puede ser puesta en un vehículo."

#: lang/json/GENERIC_from_json.py
msgid "scythe blade"
msgid_plural "scythe blades"
msgstr[0] "hoja de guadaña"
msgstr[1] "hojas de guadaña"

#. ~ Description for scythe blade
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, curved blade.  Could be used to assemble a scythe, or make an "
"improvised polearm."
msgstr ""
"Una gran hoja curva. Podría ser usada para ensamblar una guadaña, o hacer un"
" palo de armas improvisado."

#: lang/json/GENERIC_from_json.py
msgid "circular sawblade"
msgid_plural "circular sawblades"
msgstr[0] "hoja de sierra circular"
msgstr[1] "hojas de sierra circular"

#. ~ Description for circular sawblade
#: lang/json/GENERIC_from_json.py
msgid ""
"An 8\" circular sawblade.  You could make a saw with it, or throw it.  "
"Wielding it without sturdy gloves is a bad idea."
msgstr ""
"Una hoja de sierra circular de 8\". Con ella puedes hacer una sierra, o la "
"puedes lanzar. Empuñarla sin unos buenos guantes resistentes, es una mala "
"idea."

#: lang/json/GENERIC_from_json.py
msgid "tree spile"
msgid_plural "tree spiles"
msgstr[0] "grifo para árbol"
msgstr[1] "grifos para árbol"

#. ~ Description for tree spile
#: lang/json/GENERIC_from_json.py
msgid ""
"A hollow metal cylinder which is inserted in a tree crust in order to slowly"
" harvest its sap.  Can be used on a maple tree in between late winter and "
"early spring to harvest maple sap."
msgstr ""
"Un cilindro hueco de metal que se inserta en la corteza de los árboles para "
"cosechar lentamente su savia. Puede ser usado en arces entre fines de "
"invierno y comienzos de primavera para cosechar savia de arce."

#: lang/json/GENERIC_from_json.py
msgid "wire"
msgid_plural "wires"
msgstr[0] "alambre"
msgstr[1] "alambres"

#. ~ Description for wire
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of thin, relatively stiff, steel wire.  Like the sort you find in "
"wire fences."
msgstr ""
"Un alambre de acero delgado largo y relativamente rígido. Como el que se "
"encuentra en las alambradas."

#: lang/json/GENERIC_from_json.py
msgid "barbed wire"
msgid_plural "barbed wires"
msgstr[0] "alambre de púas"
msgstr[1] "alambres de púas"

#. ~ Description for barbed wire
#: lang/json/GENERIC_from_json.py
msgid "A length of stiff wire, covered in sharp barbs."
msgstr "Un alambre rígido, cubierto con púas afiladas."

#: lang/json/GENERIC_from_json.py
msgid "steel mesh"
msgid_plural "steel meshes"
msgstr[0] "malla de acero"
msgstr[1] "mallas de acero"

#. ~ Description for steel mesh
#: lang/json/GENERIC_from_json.py
msgid ""
"A mat of woven fine steel wire, useful for dryer lint traps and reusable "
"coffee filter baskets.  You could put these on a window to keep mosquitoes "
"and other bugs out, but chainlink fencing will do these days."
msgstr ""
"Una estera de alambre de acero fino tejido, útil para las trampas de pelusa "
"de los secadores y las cestas de filtro de café reutilizables. Podrías "
"ponerlas en una ventana para mantener a los mosquitos y otros bichos fuera, "
"pero las cercas de alambre de cadena sirven en estos días."

#: lang/json/GENERIC_from_json.py
msgid "rebar"
msgid_plural "rebars"
msgstr[0] "varilla corrugada"
msgstr[1] "varillas corrugadas"

#. ~ Description for rebar
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of rebar, makes a nice melee weapon, and could be handy in "
"constructing tougher walls and such."
msgstr ""
"Una varilla corrugada, útil como arma de cuerpo a cuerpo, y podría venir "
"bien para construir paredes más resistentes y cosas de ese estilo."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "small railroad track"
msgid_plural "small railroad tracks"
msgstr[0] "pequeña vía de ferrocarril"
msgstr[1] "pequeñas vías de ferrocarril"

#. ~ Description for small railroad track
#: lang/json/GENERIC_from_json.py
msgid "A length of track, made from some planks and rails."
msgstr "Un largo de vía, hecho de algunos tablones y rieles."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "concrete"
msgid_plural "concrete"
msgstr[0] "cemento"
msgstr[1] "cemento"

#. ~ Description for {'str_sp': 'concrete'}
#: lang/json/GENERIC_from_json.py
msgid "Some concrete, ready to be used in a construction project."
msgstr "Es un poco de cemento, listo para ser usado en alguna construcción."

#: lang/json/GENERIC_from_json.py
msgid "bone skewer"
msgid_plural "bone skewers"
msgstr[0] "palo brocheta de hueso"
msgstr[1] "palos brocheta de hueso"

#. ~ Description for bone skewer
#: lang/json/GENERIC_from_json.py
msgid ""
"A thin skewer carved from bone.  Sadly, it won't make squirrel on a stick "
"taste better."
msgstr ""
"Es un palito fino de brochette tallado de hueso. Lamentablemente, no va a "
"hacer que la ardilla en un palo tenga mejor gusto."

#: lang/json/GENERIC_from_json.py
msgid "burnt out torch"
msgid_plural "burnt out torches"
msgstr[0] "antorcha quemada"
msgstr[1] "antorchas quemadas"

#. ~ Description for burnt out torch
#: lang/json/GENERIC_from_json.py
msgid ""
"A torch that has consumed all its fuel; it can be recrafted into another "
"torch."
msgstr ""
"Una antorcha que ya ha consumido todo su combustible. Puede ser utilizada "
"para hacer una antorcha nueva."

#: lang/json/GENERIC_from_json.py
msgid "dead flare"
msgid_plural "dead flares"
msgstr[0] "bengala usada"
msgstr[1] "bengalas usadas"

#. ~ Description for dead flare
#: lang/json/GENERIC_from_json.py
msgid "This is a spent magnesium flare.  It is essentially trash."
msgstr "Es una bengala de magnesio usada. Prácticamente, basura."

#: lang/json/GENERIC_from_json.py
msgid "spring"
msgid_plural "springs"
msgstr[0] "muelle"
msgstr[1] "muelles"

#. ~ Description for spring
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy-duty spring.  Expands with significant force when compressed."
msgstr ""
"Un muelle grande reforzado. Se estira con mucha fuerza cuando es comprimido."

#: lang/json/GENERIC_from_json.py
msgid "lawnmower"
msgid_plural "lawnmowers"
msgstr[0] "Cortacésped"
msgstr[1] "Cortacéspedes"

#. ~ Description for lawnmower
#: lang/json/GENERIC_from_json.py
msgid ""
"A motorized pushmower that seems to be broken.  You could take it apart if "
"you had a wrench."
msgstr ""
"Un cortacésped con motor que parece estar roto. Puedes desmontarlo si tienes"
" una llave inglesa."

#: lang/json/GENERIC_from_json.py
msgid "damaged tent"
msgid_plural "damaged tents"
msgstr[0] "tienda de campaña rota"
msgstr[1] "tiendas de campaña rotas"

#. ~ Description for damaged tent
#: lang/json/GENERIC_from_json.py
msgid ""
"A small tent, just big enough to fit a person comfortably.  This tent is "
"broken and cannot be deployed."
msgstr ""
"Una tienda de campaña pequeña, solo lo suficientemente grande para que quepa"
" una persona de forma cómoda. Esta tienda está rota y no puede ser montada."

#: lang/json/GENERIC_from_json.py
msgid "large damaged tent"
msgid_plural "large damaged tents"
msgstr[0] "tienda de campaña grande rota"
msgstr[1] "tiendas de campaña grandes rotas"

#. ~ Description for large damaged tent
#: lang/json/GENERIC_from_json.py
msgid ""
"A family sized tent, very bulky but with plenty of space.  This tent is "
"broken and can not be deployed."
msgstr ""
"Una tienda de campaña tamaño familiar, muy voluminosa pero con mucho "
"espacio. Esta tienda de campaña está rota y no puede ser montada."

#: lang/json/GENERIC_from_json.py
msgid "heating element"
msgid_plural "heating elements"
msgstr[0] "resistencia térmica"
msgstr[1] "resistencias térmicas"

#. ~ Description for heating element
#: lang/json/GENERIC_from_json.py
msgid ""
"A heating element, like the ones used in hotplates or kettles.  Consists of "
"nichrome wire surrounded by electrical insulator and placed inside a steel "
"casing."
msgstr ""
"Un elemento calefactor, como los que se usan en los hornos o las calderas. "
"Consiste en un alambre de níquel rodeado por un aislante eléctrico y "
"colocado dentro de una carcasa de acero."

#: lang/json/GENERIC_from_json.py
msgid "crude heating element"
msgid_plural "crude heating elements"
msgstr[0] "resistencia térmica cruda"
msgstr[1] "resistencias térmicas crudas"

#. ~ Description for crude heating element
#: lang/json/GENERIC_from_json.py
msgid ""
"A primitive heating element made from thin coiled steel wire.  It will "
"degrade much quicker with use than normal heating elements, but it'll do for"
" some applications."
msgstr ""
"Una resistencia térmica primitiva hecho de un fino alambre de acero "
"enrollado. Se degradará mucho más rápido con el uso que las resistencias "
"térmicas normales, pero servirá para algunas aplicaciones."

#: lang/json/GENERIC_from_json.py
msgid "bimetal thermostat"
msgid_plural "bimetal thermostats"
msgstr[0] "termostato bimetálico"
msgstr[1] "termostatos bimetálicos"

#. ~ Description for bimetal thermostat
#: lang/json/GENERIC_from_json.py
msgid ""
"A simple thermostat controlled by thermal expansion of a bimetal strip."
msgstr ""
"Un simple termostato controlado por la expansión térmica de una tira "
"bimetálica."

#: lang/json/GENERIC_from_json.py
msgid "television"
msgid_plural "televisions"
msgstr[0] "televisor"
msgstr[1] "televisores"

#. ~ Description for television
#: lang/json/GENERIC_from_json.py
msgid "A large LCD television, full of delicious electronics."
msgstr "Es un televisor LCD grande , lleno de deliciosas piezas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "pilot light"
msgid_plural "pilot lights"
msgstr[0] "piloto"
msgstr[1] "pilotos"

#. ~ Description for pilot light
#: lang/json/GENERIC_from_json.py
msgid ""
"A pilot light from a gas-burning device, this particular one is a simple "
"piezoelectric igniter."
msgstr ""
"Un piloto de un aparato que funcionaba a gas, este en particular es un "
"simple encendedor piezoeléctrico."

#: lang/json/GENERIC_from_json.py
msgid "delayed fuze"
msgid_plural "delayed fuzes"
msgstr[0] "espoleta retardada"
msgstr[1] "espoletas retardadas"

#. ~ Description for delayed fuze
#: lang/json/GENERIC_from_json.py
msgid ""
"A complex mechanical fuze.  It seems it can be used to detonate stable "
"explosives after a short time by triggering it."
msgstr ""
"Una compleja espoleta mecánica. Parece que puede ser usada para detonar "
"explosivos estables después de un corto tiempo al activarla."

#: lang/json/GENERIC_from_json.py
msgid "impact fuze"
msgid_plural "impact fuzes"
msgstr[0] "espoleta de impacto"
msgstr[1] "espoletas de impacto"

#. ~ Description for impact fuze
#: lang/json/GENERIC_from_json.py
msgid ""
"A complex mechanical fuze.  It seems it can be used to detonate stable "
"explosives upon a solid impact."
msgstr ""
"Una compleja espoleta mecánica. Parece que puede usarse para detonar "
"explosivos estables en un impacto sólido."

#: lang/json/GENERIC_from_json.py
msgid "toaster"
msgid_plural "toasters"
msgstr[0] "tostadora"
msgstr[1] "tostadoras"

#. ~ Description for toaster
#: lang/json/GENERIC_from_json.py
msgid "A small two slice toaster, not much use as anything but spare parts."
msgstr ""
"Es una tostadora pequeña de dos ranuras. No sirve de mucho más que para "
"piezas de repuesto."

#: lang/json/GENERIC_from_json.py
msgid "microwave"
msgid_plural "microwaves"
msgstr[0] "microondas"
msgstr[1] "microondas"

#. ~ Description for microwave
#: lang/json/GENERIC_from_json.py
msgid ""
"A home microwave, has probably seen its share of baked beans.  Good for "
"scrap parts."
msgstr ""
"Un microondas hogareño, que ya ha calentado sus últimas alubias. Bueno para "
"usar como sus partes."

#: lang/json/GENERIC_from_json.py
msgid "broken eyebot"
msgid_plural "broken eyebots"
msgstr[0] "ojobot roto"
msgstr[1] "ojobots rotos"

#. ~ Description for broken eyebot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken eyebot.  Much less threatening now that it won't be calling for "
"backup.  Could be gutted for parts."
msgstr ""
"Un ojobot roto. Ahora ya no es tan amenazador porque no puede llamar "
"refuerzos. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken skitterbot"
msgid_plural "broken skitterbots"
msgstr[0] "arañabot roto"
msgstr[1] "arañabots rotos"

#. ~ Description for broken skitterbot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken skitterbot.  Much less threatening now that it lies limp on solid "
"ground.  Could be gutted for parts."
msgstr ""
"Un arañabot roto. Ahora ya no es tan amenazador porque está tirado en el "
"suelo con las patas flojas. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken lab defense bot"
msgid_plural "broken lab defense bots"
msgstr[0] "robot defensor de laboratorio roto"
msgstr[1] "robots defensores de laboratorio rotos"

#. ~ Description for broken lab defense bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken lab defense bot, with its casing broken and fluid drained.  Could "
"be gutted for parts."
msgstr ""
"Un robot de defensa de laboratorio roto, con su carcasa rota y el líquido "
"drenado. Podría ser destripado por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken police bot"
msgid_plural "broken police bots"
msgstr[0] "policíabot roto"
msgstr[1] "policíabots rotos"

#. ~ Description for broken police bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken police bot.  Much less threatening now that it's quiet and still.  "
"Could be gutted for parts."
msgstr ""
"Un policíabot roto. Ahora ya no es tan amenazador porque está callado y "
"quieto. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken nurse bot"
msgid_plural "broken nurse bots"
msgstr[0] "robot de enfermería roto"
msgstr[1] "robots de enfermería rotos"

#. ~ Description for broken nurse bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken nurse bot.  Its smooth face staring vacantly into empty space.  "
"Could be gutted for parts."
msgstr ""
"Un robot de enfermería roto. Su cara lisa mirando fijamente al espacio "
"vacío. Podría ser destripado por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken grocery bot"
msgid_plural "broken grocery bots"
msgstr[0] "almacénbot roto"
msgstr[1] "almacénbots rotos"

#. ~ Description for broken grocery bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken grocery bot.  Its smiling face staring vacantly into empty space.  "
"Could be gutted for parts."
msgstr ""
"Un robot de supermercado roto. Su cara sonriente mirando fijamente al "
"espacio vacío. Podría ser destripado por partes."

#. ~ Description for broken grocery bot
#: lang/json/GENERIC_from_json.py
msgid ""
"The body of a busted grocery bot.  Its tarnished face is still smiling.  "
"Could be gutted for parts."
msgstr ""
"El cuerpo de un robot de supermercado roto. Su rostro empañado aún sonríe. "
"Podría estar destripado por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken riot control bot"
msgid_plural "broken riot control bots"
msgstr[0] "antidisturbot roto"
msgstr[1] "antidisturbots rotos"

#. ~ Description for broken riot control bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken riot control bot.  Much less threatening now that it's out of gas."
"  Could be gutted for parts."
msgstr ""
"Un antidisturbot roto. Ahora ya no es tan amenazador porque no tiene más "
"combustible. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken prototype robot"
msgid_plural "broken prototype robots"
msgstr[0] "robot prototipo roto"
msgstr[1] "robots prototipo rotos"

#. ~ Description for broken prototype robot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken prototype robot, well more broken than before.  Could be gutted for"
" parts."
msgstr ""
"Un prototipo de robot roto, mucho más roto que antes. Podría ser destripado "
"por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken miner bot"
msgid_plural "broken miner bots"
msgstr[0] "minerobot roto"
msgstr[1] "minerobots rotos"

#. ~ Description for broken miner bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken miner bot.  Much less threatening now that it's no longer capable "
"of drilling anything.  Could be gutted for parts."
msgstr ""
"Un minerobot roto. Ahora ya no es tan amenazador porque no puede taladrar "
"nada. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken recon mech"
msgid_plural "broken recon mechs"
msgstr[0] "mecánico de reconocimiento roto"
msgstr[1] "mecánicos de reconocimiento rotos"

#. ~ Description for broken recon mech
#. ~ Description for broken mech lifter
#. ~ Description for broken combat mech
#: lang/json/GENERIC_from_json.py
msgid "This is a broken mech exoskeleton suit, it looks beyond repair."
msgstr "Este es un traje de exoesqueleto mecánico roto, parece irreparable."

#: lang/json/GENERIC_from_json.py
msgid "broken mech lifter"
msgid_plural "broken mech lifters"
msgstr[0] "mecánico elevador roto"
msgstr[1] "mecánicos elevadores rotos"

#: lang/json/GENERIC_from_json.py
msgid "broken combat mech"
msgid_plural "broken combat mechs"
msgstr[0] "mecha de combate roto"
msgstr[1] "mechas de combate rotos"

#: lang/json/GENERIC_from_json.py
msgid "broken riot dispatch"
msgid_plural "broken riot dispatches"
msgstr[0] "despachador de disturbios roto"
msgstr[1] "despachadores de disturbios rotos"

#. ~ Description for broken riot dispatch
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken riot dispatch, with its mesh midsection filled with fried manhacks "
"and its motor limp and still.  Could be gutted for parts."
msgstr ""
"In despachador de disturbios roto, con su sección media llena de chatarra "
"frita y su motor cojo y quieto. Podría ser destripado por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken military dispatch"
msgid_plural "broken military dispatches"
msgstr[0] "despachador militar roto"
msgstr[1] "despachadores militares rotos"

#. ~ Description for broken military dispatch
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken military dispatch.  Though the scratched, disarmed manhacks visible"
" in its belly are disarmed, their destructive potential still inspires a "
"spark of fear, even now.  Could be gutted for parts."
msgstr ""
"Un despachador militar roto. Aunque las chatarras raspadas y desarmadas "
"visibles en su vientre están desarmadas, su potencial destructivo todavía "
"inspira una chispa de miedo, incluso ahora. Podría ser destruido por partes."

#: lang/json/GENERIC_from_json.py
msgid "broken manhack"
msgid_plural "broken manhacks"
msgstr[0] "manhack roto"
msgstr[1] "manhacks rotos"

#. ~ Description for broken manhack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken manhack.  Much less threatening now that it lies limp on solid "
"ground.  Could be gutted for parts."
msgstr ""
"Un manhack roto. Ahora ya no es tan amenazador porque está todo flojito "
"tirado en el suelo. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken grenade hack"
msgid_plural "broken grenade hacks"
msgstr[0] "grana-hack roto"
msgstr[1] "grana-hacks rotos"

#. ~ Description for broken grenade hack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken grenade hack.  Much less threatening now that it lies quiet on "
"solid ground.  Could be gutted for parts."
msgstr ""
"Un grana-hack roto. Ahora que está tirado quieto en el suelo no es tan "
"amenazante. Puede ser destripado para recuperar las partes."

#: lang/json/GENERIC_from_json.py
msgid "broken mininuke hack"
msgid_plural "broken mininuke hacks"
msgstr[0] "minibom-hack roto"
msgstr[1] "minibom-hacks rotos"

#. ~ Description for broken mininuke hack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken magenta hack.  Just looking at the wreck makes you shiver.  Could "
"be gutted for parts."
msgstr ""
"Un minibomba-hack magenta dañada. Solamente mirar los restos te entran "
"escalofrios. Puede ser desmontado por sus partes."

#: lang/json/GENERIC_from_json.py
msgid "broken tear gas hack"
msgid_plural "broken tear gas hacks"
msgstr[0] "lacrimo-hack roto"
msgstr[1] "lacrimo-hacks rotos"

#. ~ Description for broken tear gas hack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken tear gas hack.  Much less threatening now that it lies quiet on "
