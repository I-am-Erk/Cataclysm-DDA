msgid_plural "Hub 01 Gold Coins"
msgstr[0] "Monedas de Oro del Hub 01"
msgstr[1] "Monedas de Oro del Hub 01"

#. ~ Description for Hub 01 Gold Coin
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a small but surprisingly heavy gold coin.  One side is etched with "
"circuitry and the other side reads 'Hub 01 exchange currency'."
msgstr ""
"Esta es una pequeña pero sorprendentemente pesada moneda de oro. Una cara "
"está grabada con circuitos y la otra cara dice \"moneda de cambio Hub 01\"."

#: lang/json/GENERIC_from_json.py
msgid "FlatCoin"
msgid_plural "FlatCoins"
msgstr[0] "FlatCoin"
msgstr[1] "FlatCoins"

#. ~ Description for FlatCoin
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a coin that has been flattened in a novelty coin flattening machine."
"  The machine has been somewhat crudely altered so that the design - which "
"appears to once have been Mickey Mouse - is overlaid with a handwritten "
"emblem of a book.  There is some text that faintly reads 'Campus Exchange "
"Token'."
msgstr ""
"Esta es una moneda que ha sido aplastada en una novedosa máquina aplanadora "
"de monedas. La máquina ha sido alterada de manera que el diseño - que parece"
" haber sido una vez Mickey Mouse - está cubierto con un emblema escrito a "
"mano de un libro. Hay un texto que dice débilmente \"Ficha de intercambio "
"del Campus\"."

