msgid_plural "XL boxer shorts"
msgstr[0] "calzoncillo corto XL"
msgstr[1] "calzoncillos cortos XL"

#. ~ Description for {'str_sp': 'XL boxer shorts'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Men's XL boxer shorts.  For the very big and tall.  More fashionable than "
"briefs and just as comfortable."
msgstr ""
"Calzoncillo corto XL para hombres. Para los muy grandes y altos. Más a la "
"moda que los largos e igual de cómodos."

#: lang/json/ARMOR_from_json.py
msgid "boy shorts"
msgid_plural "boy shorts"
msgstr[0] "culotte"
msgstr[1] "culottes"

#. ~ Description for {'str_sp': 'boy shorts'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Female underwear similar to men's boxer shorts, but much more close-fitting."
msgstr ""
"Ropa interior femenina similar al boxer masculino, pero mucho más ajustada."

#: lang/json/ARMOR_from_json.py
msgid "XL boy shorts"
msgid_plural "XL boy shorts"
msgstr[0] "pantalón corto XL"
msgstr[1] "pantalones cortos XL"

#. ~ Description for {'str_sp': 'XL boy shorts'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Female underwear similar to men's boxer shorts, but much more close-fitting."
"  This size is made for giants."
msgstr ""
"Ropa interior femenina similar a los calzoncillos de los hombres, pero mucho"
" más ajustada. Este tamaño está hecho para gigantes."

#: lang/json/ARMOR_from_json.py
msgid "bra"
msgid_plural "bras"
msgstr[0] "sujetador"
msgstr[1] "sujetadores"

#. ~ Description for bra
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple bra.  For protecting those bits you don't want zombies to look at."
msgstr ""
"Un sujetador sencillo. Para proteger aquellas partes que no quieres que te "
"miren los zombis."

#: lang/json/ARMOR_from_json.py
msgid "briefs"
msgid_plural "briefs"
msgstr[0] "calzoncillo"
msgstr[1] "calzoncillos"

#. ~ Description for {'str_sp': 'briefs'}
#: lang/json/ARMOR_from_json.py
msgid "A pair of briefs.  Comfortable underwear worn by men."
msgstr "Es un calzoncillo. Ropa interior cómoda para hombre."

#: lang/json/ARMOR_from_json.py
msgid "camisole"
msgid_plural "camisoles"
msgstr[0] "camisón"
msgstr[1] "camisones"

#. ~ Description for camisole
#: lang/json/ARMOR_from_json.py
msgid ""
"A small camisole made from silk.  Typically used as an undergarment, they "
"are light and easy to wear."
msgstr ""
"Es un pequeño camisón hecho de seda. Generalmente, se utiliza como ropa "
"interior. Es liviano y cómodo."

#: lang/json/ARMOR_from_json.py
msgid "chestwrap"
msgid_plural "chestwraps"
msgstr[0] "venda para torso"
msgstr[1] "vendas para torso"

#. ~ Description for chestwrap
#: lang/json/ARMOR_from_json.py
