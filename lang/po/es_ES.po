msgid "copper ring"
msgid_plural "copper rings"
msgstr[0] "anillo de cobre"
msgstr[1] "anillos de cobre"

#. ~ Description for copper ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A plain, copper ring.  Not very shiny, and not very popular.  You can wear "
"it if you like, but it won't provide any effects."
msgstr ""
"Un simple anillo de cobre. No muy brillante, y no muy popular. Puedes usarlo"
" si quieres, pero no te proporcionará ningún efecto."

