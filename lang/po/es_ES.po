msgstr[0] "mannbrat"
msgstr[1] "mannbrats"

#. ~ Conditional name for {'str': 'bratwurst'} when FLAG matches
#. STRICT_HUMANITARIANISM
#: lang/json/COMESTIBLE_from_json.py
msgid "frankenfurter"
msgid_plural "frankenfurters"
msgstr[0] "frankenfurter"
msgstr[1] "frankenfurters"

