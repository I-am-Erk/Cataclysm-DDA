msgstr[0] "rejilla de acero"
msgstr[1] "rejillas de acero"

#. ~ Description for steel grille
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a metal grille.  It can be used as a framework for making a chemical"
" catalyst."
msgstr ""
"Esto es una rejilla de acero. Puede ser usada como estructura para hacer un "
"catalizador químico."

#: lang/json/GENERIC_from_json.py
msgid "cobalt-60 pellet"
msgid_plural "cobalt-60 pellets"
msgstr[0] "perdigón de cobalto 60"
msgstr[1] "perdigones de cobalto 60"

#. ~ Description for cobalt-60 pellet
#: lang/json/GENERIC_from_json.py
msgid ""
"Radioactive material that used to be a part of some nuclear industry "
"equipment.  You have yet to find some use for it."
msgstr ""
"Es material radioactivo que antes era parte de algún equipamiento industrial"
" nuclear. Todavía no sabés para qué se puede usar."

#: lang/json/GENERIC_from_json.py
msgid "sandbag"
msgid_plural "sandbags"
msgstr[0] "bolsa de arena"
msgstr[1] "bolsas de arena"

#. ~ Description for sandbag
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a canvas sack filled with sand.  It can be used to construct simple "
"barricades."
msgstr ""
"Este es un saco de lona lleno de arena. Puede ser usado para construir "
"barricadas simples."

#: lang/json/GENERIC_from_json.py
msgid "gravelbag"
msgid_plural "gravelbags"
msgstr[0] "bolsa de grava"
msgstr[1] "bolsas de grava"

#. ~ Description for gravelbag
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a canvas sack filled with gravel.  It can be used to construct "
"simple barricades."
msgstr ""
"Este es un saco de lona relleno de grava. Puede utilizarse para construir "
"barricadas sencillas."

#: lang/json/GENERIC_from_json.py
msgid "earthbag"
msgid_plural "earthbags"
msgstr[0] "bolsa de tierra"
msgstr[1] "bolsas de tierra"

#. ~ Description for earthbag
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a canvas sack filled with soil.  It can be used to construct simple "
"barricades."
msgstr ""
"Este es un saco de lona lleno de tierra. Puede ser usado para construir "
"barricadas simples."

#: lang/json/GENERIC_from_json.py
msgid "2.5L canteen"
msgid_plural "2.5L canteens"
msgstr[0] "cantimplora de 2.5L"
msgstr[1] "cantimploras de 2.5L"

#. ~ Description for 2.5L canteen
#: lang/json/GENERIC_from_json.py
msgid ""
"A large plastic water canteen, with a 2.5 liter capacity and carrying strap."
msgstr ""
"Una cantimplora grande de plástico, con una capacidad de 2.5 litros y una "
"correa para colgarla."

#: lang/json/GENERIC_from_json.py
msgid "30 gallon barrel"
msgid_plural "30 gallon barrels"
msgstr[0] "barril de 110 litros"
msgstr[1] "barriles de 110 litros"

#. ~ Description for 30 gallon barrel
#: lang/json/GENERIC_from_json.py
msgid "A huge plastic barrel with a watertight lid."
msgstr "Un enorme barril de plástico con una tapa hermética."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
msgid "steel drum (100L)"
msgid_plural "steel drums (100L)"
msgstr[0] "tanque de acero (100L)"
msgstr[1] "tanques de acero (100L)"

#. ~ Description for steel drum (100L)
#: lang/json/GENERIC_from_json.py
msgid "A huge steel barrel with a watertight lid."
msgstr "Un enorme barril de acero con una tapa hermética."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
msgid "steel drum (200L)"
msgid_plural "steel drums (200L)"
msgstr[0] "tanque de acero (200L)"
msgstr[1] "tanques de acero (200L)"

#. ~ Description for steel drum (200L)
#: lang/json/GENERIC_from_json.py
msgid "A massive steel barrel with a watertight lid."
msgstr "Un enorme barril de acero con una tapa hermética."

#: lang/json/GENERIC_from_json.py
msgid "canvas sack"
msgid_plural "canvas sacks"
msgstr[0] "saco de tela"
msgstr[1] "sacos de tela"

#. ~ Description for canvas sack
#: lang/json/GENERIC_from_json.py
msgid ""
"A large and sturdy canvas sack.  Smells faintly of earth and hard work."
msgstr ""
"Un saco de tela grande y resistente. Tiene un poco de olor a tierra y "
"trabajo pesado."

#: lang/json/GENERIC_from_json.py
msgid "canvas bag"
msgid_plural "canvas bags"
msgstr[0] "bolsa de tela"
msgstr[1] "bolsas de tela"

#. ~ Description for canvas bag
#: lang/json/GENERIC_from_json.py
msgid "Small bag made of canvas.  Looks fine to store dried herbs in."
msgstr ""
"Una pequeña bolsa hecha de tela. Parece que sirve para almacenar hierbas "
"secas."

#: lang/json/GENERIC_from_json.py
msgid "plastic bag"
msgid_plural "plastic bags"
msgstr[0] "bolsa de plástico"
msgstr[1] "bolsas de plástico"

#. ~ Description for plastic bag
#: lang/json/GENERIC_from_json.py
msgid "A small, open plastic bag.  Essentially trash."
msgstr "Es una bolsa de plástico pequeña y abierta. Esencialmente, basura."

#: lang/json/GENERIC_from_json.py
msgid "small powder paper bag"
msgid_plural "small powder paper bags"
msgstr[0] "pequeñas bolsas de papel en polvo"
msgstr[1] "pequeñas bolsas de papel en polvo"

#. ~ Description for small powder paper bag
#: lang/json/GENERIC_from_json.py
msgid ""
"A small but sturdy paper bag.  Rock solid when packed full with powder."
msgstr ""
"Una pequeña pero robusta bolsa de papel. Sólida como una roca cuando está "
"llena de polvo."

#: lang/json/GENERIC_from_json.py
msgid "zipper bag"
msgid_plural "zipper bags"
msgstr[0] "bolsa con cremallera"
msgstr[1] "bolsas con cremallera"

#. ~ Description for zipper bag
#: lang/json/GENERIC_from_json.py
msgid ""
"An inexpensive flexible rectangular storage bag on its typical small size.  "
"Transparent and made of plastic, it can be sealed and opened by a slider "
"which works in a similar way to a zip fastener."
msgstr ""
"Una bolsa de almacenamiento rectangular flexible y económica en su típico "
"tamaño pequeño. Transparente y hecha de plástico, puede ser sellada y "
"abierta por un deslizador que funciona de manera similar a un cierre de "
"cremallera."

#: lang/json/GENERIC_from_json.py
msgid "body bag"
msgid_plural "body bags"
msgstr[0] "bolsa de cadáver"
msgstr[1] "bolsas de cadáveres"

#. ~ Description for body bag
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, human size, rectangular bag made of strong plastic, with a zipper "
"in the middle.  Used to hold a dead body."
msgstr ""
"Una bolsa rectangular grande, de tamaño humano, hecha de plástico "
"resistente, con una cremallera en el medio. Se usa para guardar un cadáver."

#: lang/json/GENERIC_from_json.py
msgid "IV bag"
msgid_plural "IV bags"
msgstr[0] "bolsa de intravenosa (IV)"
msgstr[1] "bolsas de intravenosas (IV)"

#. ~ Description for IV bag
#: lang/json/GENERIC_from_json.py
msgid "A small, sealed plastic bag for liquids used in intravenous therapy."
msgstr ""
"Una pequeña bolsa de plástico sellada para los líquidos utilizados en la "
"terapia intravenosa."

#: lang/json/GENERIC_from_json.py
msgid "glass bottle"
msgid_plural "glass bottles"
msgstr[0] "botella de cristal"
msgstr[1] "botellas de cristal"

#. ~ Description for glass bottle
#: lang/json/GENERIC_from_json.py
msgid "A watertight glass bottle, holds 750 ml of liquid."
msgstr "Una botella de vidrio hermética, contiene 750 ml de líquido."

#: lang/json/GENERIC_from_json.py
msgid "plastic bottle"
msgid_plural "plastic bottles"
msgstr[0] "botella de plástico"
msgstr[1] "botellas de plástico"

#. ~ Description for plastic bottle
#: lang/json/GENERIC_from_json.py
msgid ""
"A watertight plastic bottle, holds 500 ml of liquid.  Some may be factory-"
"sealed to increase shelf life."
msgstr ""
"Una botella hermética de plástico, puede contener hasta 500 ml de líquido. "
"Algunas podrian estar selladas de fábrica para aumentar su vida útil."

#: lang/json/GENERIC_from_json.py
msgid "condiment bottle"
msgid_plural "condiment bottles"
msgstr[0] "botella de condimento"
msgstr[1] "botellas de condimento"

#. ~ Description for condiment bottle
#: lang/json/GENERIC_from_json.py
msgid ""
"An inverted plastic bottle for condiments.  Preserves content from rot until"
" opened."
msgstr ""
"Una botella de plástico invertida para condimentos. Preserva el contenido de"
" la putrefacción hasta que se abre."

#: lang/json/GENERIC_from_json.py
msgid "small plastic bottle"
msgid_plural "small plastic bottles"
msgstr[0] "botella pequeña de plástico"
msgstr[1] "botellas pequeñas de plástico"

#. ~ Description for small plastic bottle
#: lang/json/GENERIC_from_json.py
msgid "A watertight plastic bottle, holds 250 ml of liquid."
msgstr "Una botella de plástico hermética, contiene 250 ml de líquido."

#: lang/json/GENERIC_from_json.py
msgid "large plastic bottle"
msgid_plural "large plastic bottles"
msgstr[0] "botella de plástico grande"
msgstr[1] "botellas de plástico grandes"

#. ~ Description for large plastic bottle
#: lang/json/GENERIC_from_json.py
msgid ""
"It's a two-liter plastic bottle that can hold a lot of soda, or, nowadays, "
"boiled water."
msgstr ""
"Es una botella de plástico de dos litros que puede contener mucha gaseosa, "
"o, por estos días, agua hervida."

#: lang/json/GENERIC_from_json.py
msgid "clay bowl"
msgid_plural "clay bowls"
msgstr[0] "tazón de arcilla"
msgstr[1] "tazones de arcilla"

#. ~ Description for clay bowl
#: lang/json/GENERIC_from_json.py
msgid ""
"A clay bowl with a waterproofed hide lid.  Can be used as a container or as "
"a tool.  Holds 250 ml of liquid."
msgstr ""
"Es un tazón de arcilla con una tapa hermética. Se puede usar como recipiente"
" o como herramienta. Tiene una capacidad de 250 ml."

#: lang/json/GENERIC_from_json.py
msgid "pack"
msgid_plural "packs"
msgstr[0] "paquete"
msgstr[1] "paquetes"

#. ~ Description for pack
#: lang/json/GENERIC_from_json.py
msgid ""
"SURGEON GENERAL'S WARNING: Smoking Causes Lung Cancer, Heart Disease, "
"Emphysema And May Complicate Pregnancy."
msgstr ""
"ADVERTENCIA DEL DIRECTOR GENERAL DE SALUD PÚBLICA: Fumar Causa Cáncer de "
"Pulmón, Enfermedades del Corazón, Enfisema y Puede Perjudicar el Embarazo."

#: lang/json/GENERIC_from_json.py
msgid "small cardboard box"
msgid_plural "small cardboard boxes"
msgstr[0] "pequeña caja de cartón"
msgstr[1] "pequeñas cajas de cartón"

#. ~ Description for small cardboard box
#: lang/json/GENERIC_from_json.py
msgid "A small cardboard box.  No bigger than a foot in dimension."
msgstr "Es una caja pequeña de cartón, de unos 30 cm."

#: lang/json/GENERIC_from_json.py
msgid "cardboard box"
msgid_plural "cardboard boxes"
msgstr[0] "caja de cartón"
msgstr[1] "cajas de cartón"

#. ~ Description for cardboard box
#: lang/json/GENERIC_from_json.py
msgid ""
"A sturdy cardboard box, about the size of a banana box.  Great for packing."
msgstr ""
"Una caja de cartón resistente, del tamaño de una caja de bananas. Genial "
"para empacar."

#: lang/json/GENERIC_from_json.py lang/json/furniture_from_json.py
msgid "large cardboard box"
msgid_plural "large cardboard boxes"
msgstr[0] "gran caja de cartón"
msgstr[1] "grandes cajas de cartón"

#. ~ Description for large cardboard box
#: lang/json/GENERIC_from_json.py
msgid ""
"A very large cardboard box, the sort children would have loved to hide in, "
"when there were still children."
msgstr ""
"Una caja de cartón muy grande, del tipo en el que a los niños les hubiera "
"gustado esconderse, cuando aún eran niños."

#: lang/json/GENERIC_from_json.py
msgid "bucket"
msgid_plural "buckets"
msgstr[0] "cubo"
msgstr[1] "cubos"

#. ~ Description for bucket
#: lang/json/GENERIC_from_json.py
msgid ""
"A galvanized bucket for peanuts, chilled wine, iced beer, lobster, crab "
"legs, French fries, animal feed, farm use, tailgating, crafts, planting "
"flowers, holding gift baskets, containing a fruit basket and herbs, loose "
"item storage or as an ice bucket."
msgstr ""
"Un cubo galvanizado para cacahuetes, vino frío, cerveza helada, langosta, "
"patas de cangrejo, patatas fritas, alimento para animales, uso en granjas, "
"colas, artesanías, plantación de flores, celebración de cestas de regalo, "
"que contiene una cesta de frutas y hierbas, almacenamiento de artículos "
"sueltos o como un cubo de hielo."

#: lang/json/GENERIC_from_json.py
msgid "hydration pack"
msgid_plural "hydration packs"
msgstr[0] "mochila contenedora de agua"
msgstr[1] "mochilas contenedoras de agua"

#. ~ Description for hydration pack
#: lang/json/GENERIC_from_json.py
msgid ""
"A slim and lightweight insulated plastic bladder worn on the back.  It has a"
" large pocket and a capped mouth for filling with liquid with a hose that "
"allows the wearer to drink hands-free."
msgstr ""
"Una bolsa de plástico, fina, liviana y aislada que se puede llevar en la "
"espalda. Tiene un bolsillo grande y un pico con tapa para llenarla de "
"líquida con una manguera, y permite beber sin usar las manos."

#: lang/json/GENERIC_from_json.py
msgid "aluminum can"
msgid_plural "aluminum cans"
msgstr[0] "lata de aluminio"
msgstr[1] "latas de aluminio"

#. ~ Description for aluminum can
#: lang/json/GENERIC_from_json.py
msgid "An aluminum can, like what soda comes in."
msgstr "Es una lata de aluminio, como la de los refrescos."

#: lang/json/GENERIC_from_json.py
msgid "paper carton"
msgid_plural "paper cartons"
msgstr[0] "cartón de papel"
msgstr[1] "cartones de papel"

#. ~ Description for paper carton
#: lang/json/GENERIC_from_json.py
msgid ""
"A half gallon carton constructed of a paper, aluminum, and plastic laminate."
"  It has a threaded cap to keep liquid from leaking out."
msgstr ""
"Una caja de medio galón construida con un laminado de papel, aluminio y "
"plástico. Tiene una tapa roscada para evitar que el líquido se escape."

#: lang/json/GENERIC_from_json.py
msgid "egg carton"
msgid_plural "egg cartons"
msgstr[0] "cartón de huevo"
msgstr[1] "cartones de huevo"

#. ~ Description for egg carton
#: lang/json/GENERIC_from_json.py
msgid "A cardboard container with 12 individual cavities for storing eggs."
msgstr ""
"Un contenedor de cartón con 12 huecos individuales para almacenar huevos."

#: lang/json/GENERIC_from_json.py
msgid "vacuum-packed bag"
msgid_plural "vacuum-packed bags"
msgstr[0] "bolsa de envasado al vacío"
msgstr[1] "bolsas de envasado al vacío"

#. ~ Description for vacuum-packed bag
#: lang/json/GENERIC_from_json.py
msgid "This is a bag of vacuum-packed food."
msgstr "Esta es una bolsa de comida envasada al vacío."

#: lang/json/GENERIC_from_json.py
msgid "small tin can"
msgid_plural "small tin cans"
msgstr[0] "pequeña lata de hojalata."
msgstr[1] "pequeñas latas de hojalata."

#. ~ Description for small tin can
#: lang/json/GENERIC_from_json.py
msgid "A small tin can, like what tuna comes in."
msgstr "Una pequeña lata, como la del atún."

#: lang/json/GENERIC_from_json.py
msgid "medium tin can"
msgid_plural "medium tin cans"
msgstr[0] "lata mediana de hojalata"
msgstr[1] "latas medianas de hojalata"

#. ~ Description for medium tin can
#: lang/json/GENERIC_from_json.py
msgid "A medium tin can, like what soup comes in."
msgstr "Una lata mediana, como la que viene en la sopa."

#: lang/json/GENERIC_from_json.py
msgid "plastic canteen"
msgid_plural "plastic canteens"
msgstr[0] "cantimplora de plástico"
msgstr[1] "cantimploras de plástico"

#. ~ Description for plastic canteen
#: lang/json/GENERIC_from_json.py
msgid ""
"A military-style water canteen with a 1.5 liter capacity.  Commonly worn at "
"the hip."
msgstr ""
"Una cantimplora de tipo militar con una capacidad de 1.5 litros. Comúnmente "
"se lleva colgada en la cadera."

#: lang/json/GENERIC_from_json.py
msgid "thermos"
msgid_plural "thermoses"
msgstr[0] "termo"
msgstr[1] "termos"

#. ~ Description for thermos
#: lang/json/GENERIC_from_json.py
msgid ""
"A Thermos brand vacuum flask.  Built for temperature retention, helps keep "
"things hot or cold.  Contains 1L of liquid."
msgstr ""
"Es un frasco de vacío de la marca Thermos. Construido para retener la "
"temperatura, ayuda a mantener las cosas frías o calientes. Puede contener "
"hasta 1L de líquido."

#: lang/json/GENERIC_from_json.py
msgid "clay canister"
msgid_plural "clay canisters"
msgstr[0] "tarro de arcilla"
msgstr[1] "tarros de arcilla"

#. ~ Description for clay canister
#: lang/json/GENERIC_from_json.py
msgid ""
"A fragile clay vessel.  It can be used to make crude impact grenades or to "
"store liquid."
msgstr ""
"Es un recipiente frágil de arcilla. Se puede usar para hacer simples "
"granadas de impacto o para almacenar líquidos."

#: lang/json/GENERIC_from_json.py
msgid "clay hydria"
msgid_plural "clay hydrias"
msgstr[0] "barrila de arcilla"
msgstr[1] "barrilas de arcilla"

#. ~ Description for clay hydria
#: lang/json/GENERIC_from_json.py
msgid "A 15-liter clay pot with three handles for carrying and for pouring."
msgstr ""
"Un tarro de arcilla de 15 litros con tres mangos para poder ser "
"transportarlo y verter el líquido."

#: lang/json/GENERIC_from_json.py
msgid "large clay pot"
msgid_plural "large clay pots"
msgstr[0] "pote grande de arcilla"
msgstr[1] "potes grandes de arcilla"

#. ~ Description for large clay pot
#: lang/json/GENERIC_from_json.py
msgid ""
"A bulky and heavy clay pot with a waterproofed hide lid, meant to store "
"water, but can carry other liquids in a pinch."
msgstr ""
"Es un pote grande y pesado de arcilla con una tapa hermética, hecho para "
"almacenar agua pero puede llevar otros líquidos si es necesario."

#: lang/json/GENERIC_from_json.py
msgid "plastic cup"
msgid_plural "plastic cups"
msgstr[0] "vaso de plástico"
msgstr[1] "vasos de plástico"

#. ~ Description for plastic cup
#: lang/json/GENERIC_from_json.py
msgid "A small, vacuum formed cup."
msgstr "Es un vaso pequeño que en algún momento estuvo sellado al vacío."

#: lang/json/GENERIC_from_json.py
msgid "glass flask"
msgid_plural "glass flasks"
msgstr[0] "frasco de cristal"
msgstr[1] "frascos de cristal"

#. ~ Description for glass flask
#: lang/json/GENERIC_from_json.py
msgid "A 250 ml laboratory conical flask, with a rubber bung."
msgstr ""
"Es un frasco cónico de laboratorio con una capacidad de 250 ml y un tapón de"
" goma."

#: lang/json/GENERIC_from_json.py
msgid "test tube"
msgid_plural "test tubes"
msgstr[0] "tubo de ensayo"
msgstr[1] "tubos de ensayo"

#. ~ Description for test tube
#: lang/json/GENERIC_from_json.py
msgid "A 10ml laboratory cylindrical test tube, with a rubber stopper."
msgstr ""
"Un tubo de ensayo cilíndrico de laboratorio de 10 ml, con un tapón de goma."

#: lang/json/GENERIC_from_json.py
msgid "beaker"
msgid_plural "beakers"
msgstr[0] "vaso de precipitado"
msgstr[1] "vasos de precipitado"

#. ~ Description for beaker
#: lang/json/GENERIC_from_json.py
msgid ""
"A 250ml laboratory beaker.  Basically a cup with delusions of grandeur."
msgstr ""
"Un vaso de laboratorio de 250 ml. Básicamente un vaso con delirios de "
"grandeza."

#: lang/json/GENERIC_from_json.py
msgid "graduated cylinder"
msgid_plural "graduated cylinders"
msgstr[0] "cilindro graduado"
msgstr[1] "cilindros graduados"

#. ~ Description for graduated cylinder
#: lang/json/GENERIC_from_json.py
msgid ""
"A tall, narrow glass cylinder with precise markings for measuring fluid "
"quantities.  An important science tool, it is also useful for anal retentive"
" chefs."
msgstr ""
"Un cilindro de vidrio alto y estrecho con marcas precisas para medir las "
"cantidades de fluidos. Una importante herramienta científica, también es "
"útil para los detallistas extremos."

#: lang/json/GENERIC_from_json.py
msgid "microcentrifuge tube"
msgid_plural "microcentrifuge tubes"
msgstr[0] "tubo de microcentrifugadora"
msgstr[1] "tubos de microcentrifugadora"

#. ~ Description for microcentrifuge tube
#: lang/json/GENERIC_from_json.py
msgid ""
"These plastic tubes, with little built in snap-caps, are a great way to "
"store a tiny amount of liquid.  Great for jello shooters if 1mL is enough "
"for a shot for you.  Cool people call these \"eppies\"."
msgstr ""
"Estos tubos de plástico, con pequeñas tapas a presión incorporadas, son una "
"gran manera de almacenar una pequeña cantidad de líquido. Es genial para los"
" tiradores de gelatina si 1mL es suficiente para un tiro para ti. La gente "
"genial los llama \"eppies\"."

#: lang/json/GENERIC_from_json.py
msgid "hip flask"
msgid_plural "hip flasks"
msgstr[0] "petaca"
msgstr[1] "petacas"

#. ~ Description for hip flask
#: lang/json/GENERIC_from_json.py
msgid ""
"A 250 ml metal flask with a hinged screw-on lid, commonly used to discreetly"
" transport alcohol."
msgstr ""
"Es un frasco de metal de 250 ml con una tapa con bisagras. Se usa comúnmente"
" para transportar alcohol de manera discreta."

#: lang/json/GENERIC_from_json.py
msgid "3L glass jar"
msgid_plural "3L glass jars"
msgstr[0] "botes de cristal de 3L"
msgstr[1] "botes de cristal de 3L"

#. ~ Description for 3L glass jar
#: lang/json/GENERIC_from_json.py
msgid ""
"A three-liter glass jar with a metal screw top lid, used for canning.  "
"Preserves content from rot until opened."
msgstr ""
"Un tarro de vidrio de tres litros con una tapa de metal con rosca, usado "
"para enlatar. Preserva el contenido de la putrefacción hasta que se abre."

#: lang/json/GENERIC_from_json.py
msgid "glass jar"
msgid_plural "glass jars"
msgstr[0] "bote de cristal"
msgstr[1] "botes de cristal"

#. ~ Description for glass jar
#: lang/json/GENERIC_from_json.py
msgid ""
"A half-liter glass jar with a metal screw top lid, used for canning.  "
"Preserves content from rot until opened (assuming it was sterile before "
"sealing)."
msgstr ""
"Un tarro de vidrio de medio litro con una tapa metálica de rosca, usado para"
" enlatar. Preserva el contenido de la putrefacción hasta que se abre "
"(asumiendo que era estéril antes de sellarlo)."

#: lang/json/GENERIC_from_json.py
msgid "plastic jerrycan"
msgid_plural "plastic jerrycans"
msgstr[0] "bidón de plástico"
msgstr[1] "bidones de plástico"

#. ~ Description for plastic jerrycan
#: lang/json/GENERIC_from_json.py
msgid ""
"A bulky plastic jerrycan, meant to carry fuel, but can carry other liquids "
"in a pinch."
msgstr ""
"Un bidón voluminoso de plástico, hecho para llevar gasolina, pero puede "
"contener otros líquidos si es necesario."

#: lang/json/GENERIC_from_json.py
msgid "steel jerrycan"
msgid_plural "steel jerrycans"
msgstr[0] "bidón de acero"
msgstr[1] "bidones de acero"

#. ~ Description for steel jerrycan
#: lang/json/GENERIC_from_json.py
msgid ""
"A steel jerrycan, meant to carry fuel, but can carry other liquids in a "
"pinch."
msgstr ""
"Un bidón de hierro, hecho para llevar gasolina, pero puede contener otros "
"líquidos si es necesario."

#: lang/json/GENERIC_from_json.py
msgid "clay jug"
msgid_plural "clay jugs"
msgstr[0] "jarra de arcilla"
msgstr[1] "jarras de arcilla"

#. ~ Description for clay jug
#: lang/json/GENERIC_from_json.py
msgid "A clay container with a lid, used to hold and pour liquids."
msgstr ""
"Un recipiente de arcilla con una tapa, usado para almacenar y servir "
"líquidos."

#: lang/json/GENERIC_from_json.py
msgid "gallon jug"
msgid_plural "gallon jugs"
msgstr[0] "jarro de galón"
msgstr[1] "jarros de galón"

#. ~ Description for gallon jug
#: lang/json/GENERIC_from_json.py
msgid ""
"A standard plastic jug used for milk and household cleaning chemicals.  Some"
" may be factory-sealed to increase shelf life."
msgstr ""
"Una jarra de plástico normal que se usa para la leche y productos de "
"limpieza del hogar. Algunas podrian estar selladas de fábrica para "
"incrementar su vida útil."

#: lang/json/GENERIC_from_json.py
msgid "aluminum keg"
msgid_plural "aluminum kegs"
msgstr[0] "barril de aluminio"
msgstr[1] "barriles de aluminio"

#. ~ Description for aluminum keg
#: lang/json/GENERIC_from_json.py
msgid ""
"A reusable lightweight aluminum keg, used for shipping beer.  It has a "
"capacity of 50 liters."
msgstr ""
"Un barril de aluminio ligero reutilizable, utilizado para el envío de "
"cerveza.  Tiene una capacidad de 50 litros."

#: lang/json/GENERIC_from_json.py
msgid "steel keg"
msgid_plural "steel kegs"
msgstr[0] "barril de acero"
msgstr[1] "barriles de acero"

#. ~ Description for steel keg
#: lang/json/GENERIC_from_json.py
msgid ""
"A reusable heavy steel keg, used for shipping beer.  It has a capacity of 50"
" liters."
msgstr ""
"Un barril reutilizable de acero pesado, utilizado para el envío de cerveza."
"  Tiene una capacidad de 50 litros."

#: lang/json/GENERIC_from_json.py
msgid "large sealed stomach"
msgid_plural "large sealed stomachs"
msgstr[0] "estómago grande sellado"
msgstr[1] "estómagos grandes sellados"

#. ~ Description for large sealed stomach
#: lang/json/GENERIC_from_json.py
msgid ""
"The stomach of a large creature, cleaned and sealed with strings.  It can "
"hold 3 liters of water."
msgstr ""
"El estómago de una criatura grande, limpiado y sellado con hillos. Puede "
"contener hasta 3 litros de agua."

#: lang/json/GENERIC_from_json.py
msgid "metal tank (60L)"
msgid_plural "metal tanks (60L)"
msgstr[0] "tanque de metal (60L)"
msgstr[1] "tanques de metal (60L)"

#. ~ Description for metal tank (60L)
#: lang/json/GENERIC_from_json.py
msgid "A large metal tank for holding liquids.  Useful for crafting."
msgstr ""
"Es un tanque grande de metal que puede contener líquidos. Se usa para "
"fabricar otras cosas."

#: lang/json/GENERIC_from_json.py
msgid "metal tank (2L)"
msgid_plural "metal tanks (2L)"
msgstr[0] "tanque de metal (2L)"
msgstr[1] "tanques de metal (2L)"

#. ~ Description for metal tank (2L)
#: lang/json/GENERIC_from_json.py
msgid "A small metal tank for gas or liquids.  Useful for crafting."
msgstr ""
"Es un tanque chico de metal que puede contener líquidos o gases. Se usa para"
" fabricar otras cosas."

#: lang/json/GENERIC_from_json.py
msgid "wooden canteen"
msgid_plural "wooden canteens"
msgstr[0] "cantimplora de madera"
msgstr[1] "cantimploras de madera"

#. ~ Description for wooden canteen
#: lang/json/GENERIC_from_json.py
msgid ""
"A water canteen made from wood, secured by metal bands and sealed with wax "
"or pitch.  Holds 1.5 liters and has a simple carry strap."
msgstr ""
"Es una cantimplora para almacenar agua hecha de madera, reforzada con bandas"
" de metal y sellada con cera o alquitrán. Puede contener hasta 1.5 litros y "
"tiene una correa para llevarla."

#: lang/json/GENERIC_from_json.py
msgid "sealed stomach"
msgid_plural "sealed stomachs"
msgstr[0] "estómago sellado"
msgstr[1] "estómagos sellados"

#. ~ Description for sealed stomach
#: lang/json/GENERIC_from_json.py
msgid ""
"The stomach of a creature, cleaned and sealed with a string.  It can hold "
"1.5 liters of water."
msgstr ""
"Es el estómago de una criatura, limpiado y sellado con un hilo. Puede "
"contener hasta 1.5 litros de agua."

#: lang/json/GENERIC_from_json.py
msgid "small waterskin"
msgid_plural "small waterskins"
msgstr[0] "odre pequeño"
msgstr[1] "odres pequeños"

#. ~ Description for small waterskin
#: lang/json/GENERIC_from_json.py
msgid ""
"A small watertight leather bag with a carrying strap, can hold 1.5 liters of"
" water."
msgstr ""
"Es una bolsa hermética pequeña de cuero con una correa para colgarla. Tiene "
"una capacidad de 1.5 litros de agua."

#: lang/json/GENERIC_from_json.py
msgid "waterskin"
msgid_plural "waterskins"
msgstr[0] "odre"
msgstr[1] "odres"

#. ~ Description for waterskin
#: lang/json/GENERIC_from_json.py
msgid ""
"A watertight leather bag with a carrying strap, can hold 3 liters of water."
msgstr ""
"Es una bolsa hermética de cuero con una correa para colgarla. Tiene una "
"capacidad de 3 litros de agua."

#: lang/json/GENERIC_from_json.py
msgid "large waterskin"
msgid_plural "large waterskins"
msgstr[0] "odre grande"
msgstr[1] "odres grandes"

#. ~ Description for large waterskin
#: lang/json/GENERIC_from_json.py
msgid ""
"A large watertight leather bag with a carrying strap, can hold 5 liters of "
"water."
msgstr ""
"Es una bolsa hermética grande de cuero con una correa para colgarla. Tiene "
"una capacidad de 5 litros de agua."

#: lang/json/GENERIC_from_json.py
msgid "wooden barrel"
msgid_plural "wooden barrels"
msgstr[0] "barril de madera"
msgstr[1] "barriles de madera"

#. ~ Description for wooden barrel
#: lang/json/GENERIC_from_json.py
msgid ""
"Traditionally made of white oak; these vessels are known for delivering "
"delicious whiskey to the future.  It has a capacity of 100 liters."
msgstr ""
"Tradicionalmente, estaban hechos de roble blanco. Estos recipientes son "
"conocidos por su capacidad de guardar deliciosos whiskys. Tiene una "
"capacidad de 100 litros."

#: lang/json/GENERIC_from_json.py
msgid "paper wrapper"
msgid_plural "paper wrappers"
msgstr[0] "papel estraza"
msgstr[1] "envoltorios de papel"

#. ~ Description for paper wrapper
#: lang/json/GENERIC_from_json.py
msgid "Just a piece of butcher's paper.  Good for starting fires."
msgstr "Un trozo de papel estraza. Útil para encender fuegos."

#: lang/json/GENERIC_from_json.py
msgid "wrapper"
msgid_plural "wrappers"
msgstr[0] "envoltorio"
msgstr[1] "envoltorios"

#. ~ Description for wrapper
#. ~ Daizu is Japanese for soy, hence DaiZoom
#: lang/json/GENERIC_from_json.py
msgid ""
"\"DaiZoom Protein Bar, brought to you by SoyPelusa\" is emblazoned proudly "
"upon this greaseproof wrapper."
msgstr ""
"\"Barra de Proteína DaiZoom, traída por SoyPelusa\" blasonada orgullosamente"
" en este envoltorio a prueba de grasa."

#: lang/json/GENERIC_from_json.py
msgid "styrofoam cup"
msgid_plural "styrofoam cups"
msgstr[0] "vaso de poliestireno extruido"
msgstr[1] "vasos de poliestireno extruido"

#. ~ Description for styrofoam cup
#: lang/json/GENERIC_from_json.py
msgid "A cheap, disposable cup with a plastic lid and straw."
msgstr "Es un vasito descartable y barato con tapa plástica y pajita."

#: lang/json/GENERIC_from_json.py
msgid "plastic tub"
msgid_plural "plastic tubs"
msgstr[0] "tubo de plástico"
msgstr[1] "tubos de plástico"

#. ~ Description for plastic tub
#: lang/json/GENERIC_from_json.py
msgid "A big, square plastic bucket usually used for carrying ice cream."
msgstr ""
"Un gran cubo cuadrado de plástico que se usa normalmente para llevar helado."

#: lang/json/GENERIC_from_json.py
msgid "condom"
msgid_plural "condoms"
msgstr[0] "condón"
msgstr[1] "condones"

#. ~ Description for condom
#: lang/json/GENERIC_from_json.py
msgid ""
"A gentleman's balloon.  A single use life preventer.  A thumbless latex "
"mitten.  This could be used as a makeshift water container, but otherwise "
"it's anyone's guess what it's for."
msgstr ""
"Un globo de caballero. Un chaleco salvavidas de un solo uso. Un guante de "
"látex sin pulgar. Podría usarse como un contenedor de agua improvisado, pero"
" por lo demás, cualquiera puede adivinar para qué sirve."

#: lang/json/GENERIC_from_json.py
msgid "balloon"
msgid_plural "balloons"
msgstr[0] "globo"
msgstr[1] "globos"

#. ~ Description for balloon
#: lang/json/GENERIC_from_json.py
msgid "A child's balloon.  This could be used as a makeshift water container."
msgstr ""
"Un globo de niño. Esto podría ser usado como un contenedor de agua "
"improvisado."

#: lang/json/GENERIC_from_json.py
msgid "large tin can"
msgid_plural "large tin cans"
msgstr[0] "gran lata de hojalata"
msgstr[1] "grandes latas de hojalata"

#. ~ Description for large tin can
#: lang/json/GENERIC_from_json.py
msgid ""
"A large tin can, like what beans come in.  Holds a substantial amount of "
"food."
msgstr ""
"Una lata grande, como las judías que vienen en ella. Contiene una cantidad "
"sustancial de comida."

#: lang/json/GENERIC_from_json.py
msgid "survival kit box"
msgid_plural "survival kit boxes"
msgstr[0] "caja de kit de supervivencia"
msgstr[1] "cajas de kit de supervivencia"

#. ~ Description for survival kit box
#: lang/json/GENERIC_from_json.py
msgid "An aluminum box that used to contain a small survival kit."
msgstr ""
"Una caja de aluminio que solía contener un pequeño kit de supervivencia."

#. ~ Description for survival kit box
#: lang/json/GENERIC_from_json.py
msgid ""
"The ultimate survival kit purchased either by the wealthy or the dedicated "
"urban survivalist.  It contains tools and items to help you survive in case "
"of an emergency."
msgstr ""
"El último kit de supervivencia comprado por los ricos o por los dedicados "
"supervivencialistas urbanos. Contiene herramientas y artículos para ayudarte"
" a sobrevivir en caso de emergencia."

#: lang/json/GENERIC_from_json.py
msgid "small cardboard box of tea bags"
msgid_plural "small cardboard boxes of tea bags"
msgstr[0] "pequeña caja de cartón de bolsas de té"
msgstr[1] "pequeñas cajas de cartón de bolsas de té"

#. ~ Description for small cardboard box of tea bags
#: lang/json/GENERIC_from_json.py
msgid "A very small cardboard box with tea brand written on it."
msgstr "Una caja de cartón muy pequeña con la marca del té escrita en ella."

#: lang/json/GENERIC_from_json.py
msgid "first aid kit box"
msgid_plural "first aid kit boxes"
msgstr[0] "caja de botiquín de primeros auxilios"
msgstr[1] "cajas de botiquín de primeros auxilios"

#. ~ Description for first aid kit box
#: lang/json/GENERIC_from_json.py
msgid "A plastic box that used to contain a first aid kit."
msgstr ""
"Una caja de plástico que solía contener un botiquín de primeros auxilios."

#: lang/json/GENERIC_from_json.py
msgid "IFAK pouch"
msgid_plural "IFAK pouches"
msgstr[0] "bolso IFAK"
msgstr[1] "bolsos IFAK"

#. ~ Description for IFAK pouch
#: lang/json/GENERIC_from_json.py
msgid "A fabric pouch that used to contain an IFAK."
msgstr ""
"Una bolsa de tela que solía contener un IFAK. (Kit Primeros Auxilios "
"Individual)"

#: lang/json/GENERIC_from_json.py
msgid "radio car box"
msgid_plural "radio car boxes"
msgstr[0] "caja de radio de coche"
msgstr[1] "cajas de radio de coche"

#. ~ Description for radio car box
#: lang/json/GENERIC_from_json.py
msgid ""
"An RC car, with radio-control and batteries included!  Unpack and enjoy."
msgstr ""
"¡Un coche RC, con radio-control y baterías incluidas! Desempaquétalo y "
"disfruta."

#: lang/json/GENERIC_from_json.py
msgid "small MRE bag"
msgid_plural "small MRE bags"
msgstr[0] "bolsa MRE pequeña"
msgstr[1] "bolsas MRE pequeñas"

#. ~ Description for small MRE bag
#: lang/json/GENERIC_from_json.py
msgid ""
"A small, sturdy, plastic and aluminum container of multi-layered "
"construction, with detailed nutritional information about its contents."
msgstr ""
"Un pequeño y robusto recipiente de plástico y aluminio de construcción "
"multicapa, con información nutricional detallada sobre su contenido."

#: lang/json/GENERIC_from_json.py
msgid "MRE bag"
msgid_plural "MRE bags"
msgstr[0] "bolsa MRE"
msgstr[1] "bolsas MRE"

#. ~ Description for MRE bag
#: lang/json/GENERIC_from_json.py
msgid ""
"A sturdy plastic and aluminum container of multi-layered construction, with "
"detailed nutritional information about its contents."
msgstr ""
"Un robusto recipiente de plástico y aluminio de construcción multicapa, con "
"información nutricional detallada sobre su contenido."

#: lang/json/GENERIC_from_json.py
msgid "MRE package"
msgid_plural "MRE packages"
msgstr[0] "paquete MRE"
msgstr[1] "paquetes MRE"

#. ~ Description for MRE package
#: lang/json/GENERIC_from_json.py
msgid ""
"The Meal, Ready-to-Eat - also known as the MRE - is an individual field "
"ration.  It is in a lightweight yet sturdy multi-layered plastic and "
"aluminum foil container - essentially a flexible can."
msgstr ""
"Se le denomina MRE ,por sus siglas en inglés (Meal, Ready-to-Eat), es una "
"ración de comida individual de campo. Este es un contenedor ligero pero "
"resistente multicapa de plástico y papel de aluminio, esencialmente una lata"
" flexible."

#: lang/json/GENERIC_from_json.py
msgid "plastic beverage bag"
msgid_plural "plastic beverage bags"
msgstr[0] "bolsa de bebida de plástico"
msgstr[1] "bolsas de bebidas de plástico"

#. ~ Description for plastic beverage bag
#: lang/json/GENERIC_from_json.py
msgid "A transparent, watertight plastic bag meant for holding drinks."
msgstr "Una bolsa de plástico transparente y hermética para guardar bebidas."

#: lang/json/GENERIC_from_json.py
msgid "microwave generator"
msgid_plural "microwave generators"
msgstr[0] "generador de microondas"
msgstr[1] "generadores de microondas"

#. ~ Description for microwave generator
#: lang/json/GENERIC_from_json.py
msgid ""
"This electrical component is designed to produce microwaves, for use in your"
" microwave."
msgstr ""
"Este componente eléctrico está diseñado para producir microondas, para su "
"uso en el microondas."

#: lang/json/GENERIC_from_json.py
msgid "explosively pumped flux compression generator"
msgid_plural "explosively pumped flux compression generators"
msgstr[0] "generador de compresión de flujo bombeados explosivamente"
msgstr[1] "generadores de compresión de flujo bombeados explosivamente"

#. ~ Description for explosively pumped flux compression generator
#: lang/json/GENERIC_from_json.py
msgid ""
"This large device consists mainly of a tube of copper wire surrounding a "
"large copper tube filled with high explosives.  When detonated properly, the"
" explosives allow the device to produce large amounts of electrical energy "
"in a very short time."
msgstr ""
"Este gran dispositivo consiste principalmente en un tubo de alambre de cobre"
" que rodea un gran tubo de cobre lleno de altos explosivos. Cuando se "
"detonan adecuadamente, los explosivos permiten al dispositivo producir "
"grandes cantidades de energía eléctrica en un tiempo muy corto."

#: lang/json/GENERIC_from_json.py
msgid "fake item"
msgid_plural "fake items"
msgstr[0] "objeto falso"
msgstr[1] "objetos falsos"

#. ~ Description for fake item
#: lang/json/GENERIC_from_json.py
msgid "Dummy item.  If you see this, then something went wrong."
msgstr "Un objeto prueba. Si lo ves, es que algo está funcionando mal."

#: lang/json/GENERIC_from_json.py
msgid "semi ground grains"
msgid_plural "semi ground grains"
msgstr[0] "granos semimolidos"
msgstr[1] "granos semimolidos"

#. ~ Description for {'str_sp': 'semi ground grains'}
#: lang/json/GENERIC_from_json.py
msgid "A paste of half-finished milled grains, not yet flour."
msgstr "Una pasta de granos molidos a medio terminar, aún sin harina."

#: lang/json/GENERIC_from_json.py
msgid "smoldering embers"
msgid_plural "smoldering embers"
msgstr[0] "brasas ardientes"
msgstr[1] "brasas ardientes"

#. ~ Description for {'str_sp': 'smoldering embers'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A handful of smoldering embers emitting smoke.  They are fading away even "
"when you look at them."
msgstr ""
"Es un puñado de brasas ardiente de las que sale humo. Se van apagando."

#: lang/json/GENERIC_from_json.py
msgid "Magic 8-Ball"
msgid_plural "Magic 8-Balls"
msgstr[0] "Bola 8 mágica"
msgstr[1] "Bolas 8 mágicas"

#. ~ Description for Magic 8-Ball
#: lang/json/GENERIC_from_json.py
msgid ""
"A fortune-telling device from the 1950s.  The kind of moral support you "
"didn't know you needed."
msgstr ""
"Un dispositivo de adivinación de la década de 1950. El tipo de apoyo moral "
"que no sabías que necesitabas."

#: lang/json/GENERIC_from_json.py
msgid "deck of cards"
msgid_plural "decks of cards"
msgstr[0] "baraja de cartas"
msgstr[1] "barajas de cartas"

#. ~ Description for deck of cards
#: lang/json/GENERIC_from_json.py
msgid "A deck of 52 playing cards."
msgstr "Una baraja de 52 cartas."

#: lang/json/GENERIC_from_json.py
msgid "coin"
msgid_plural "coins"
msgstr[0] "moneda"
msgstr[1] "monedas"

#. ~ Description for coin
#: lang/json/GENERIC_from_json.py
msgid ""
"A now-ancient form of currency.  Stripped of its original purpose, it now "
"serves, faithfully, flippant Flippists for free."
msgstr ""
"Esto ya es parte de una antigua economía. Ya despojada de su propósito "
"original, ahora sirve, fielmente, para el cara o cruz."

#. ~ Description for coin
#: lang/json/GENERIC_from_json.py
msgid "An ancient form of currency bearing the inscription \"E PLURIBUS UNUM.\""
msgstr "Una antigua forma de moneda con la inscripción \"E PLURIBUS UNUM\"."

#: lang/json/GENERIC_from_json.py
msgid "family photo"
msgid_plural "family photos"
msgstr[0] "foto de familia"
msgstr[1] "fotos de familia"

#. ~ Description for family photo
#: lang/json/GENERIC_from_json.py
msgid ""
"A photo of a smiling family on a camping trip.  One of the parents looks "
"like a cleaner, happier version of the person you know."
msgstr ""
"Una foto de una familia sonriente en un viaje de campamento. Uno de los "
"padres parece una versión más limpia y feliz de la persona que conoces."

#: lang/json/GENERIC_from_json.py
msgid "polaroid photo"
msgid_plural "polaroid photos"
msgstr[0] "foto polaroid"
msgstr[1] "fotos polaroid"

#. ~ Description for polaroid photo
#: lang/json/GENERIC_from_json.py
msgid ""
"A poorly taken polaroid photo of a young man wearing bell-bottoms and a "
"fedora.  It's pretty blurry."
msgstr ""
"Una foto polaroid mal tomada de un joven con pantalones de campana y un "
"sombrero de fieltro. Está bastante borrosa."

#: lang/json/GENERIC_from_json.py
msgid "chess set"
msgid_plural "chess sets"
msgstr[0] "juego de ajedrez"
msgstr[1] "juegos de ajedrez"

#. ~ Description for chess set
#: lang/json/GENERIC_from_json.py
msgid ""
"A wooden box containing all the equipment needed to play a game of chess."
msgstr ""
"Una caja de madera que contiene todo el equipo necesario para jugar una "
"partida de ajedrez."

#: lang/json/GENERIC_from_json.py
msgid "checkers set"
msgid_plural "checkers sets"
msgstr[0] "juego de damas"
msgstr[1] "juegos de damas"

#. ~ Description for checkers set
#: lang/json/GENERIC_from_json.py
msgid "A wooden box containing a set of round tokens used to play checkers."
msgstr ""
"Es una caja de madera con un conjunto de fichas circulares utilizadas para "
"jugar a las damas."

#: lang/json/GENERIC_from_json.py
msgid "deck of Sorcery cards"
msgid_plural "decks of Sorcery cards"
msgstr[0] "baraja de cartas de Hechicería"
msgstr[1] "barajas de cartas de Hechicería"

#. ~ Description for deck of Sorcery cards
#: lang/json/GENERIC_from_json.py
msgid ""
"A set of cards meant to play the game \"Sorcery.\"  Each card has a fun "
"picture of a different monster."
msgstr ""
"Es un conjunto de cartas hechas para jugar a \"Hechicería\". Cada carta "
"tiene una extraña imagen de un monstruo."

#: lang/json/GENERIC_from_json.py
msgid "Picturesque"
msgid_plural "sets of Picturesque"
msgstr[0] "Picturesque"
msgstr[1] "conjuntos de Picturesque"

#. ~ Description for Picturesque
#: lang/json/GENERIC_from_json.py
msgid ""
"A game where one draws an image, and the others attempt to guess what it is."
msgstr ""
"Es un juego donde uno dibuja una imagen y los demás deben intentar adivinar "
"qué es."

#: lang/json/GENERIC_from_json.py
msgid "Capitalism"
msgid_plural "sets of Capitalism"
msgstr[0] "Capitalismo"
msgstr[1] "conjuntos de Capitalismo"

#. ~ Description for Capitalism
#: lang/json/GENERIC_from_json.py
msgid ""
"A game where players traverse around the board buying property and swindling"
" their friends."
msgstr ""
"Es un juego donde los jugadores van alrededor del tablero comprando "
"propiedades y estafando a sus amigos."

#: lang/json/GENERIC_from_json.py
msgid "Blobs and Bandits"
msgid_plural "sets of Blobs and Bandits"
msgstr[0] "Glóbulos y Bandidos"
msgstr[1] "conjuntos de Glóbulos y Bandidos"

#. ~ Description for Blobs and Bandits
#: lang/json/GENERIC_from_json.py
