"You feel a jolt through your body as energy pulses through the wires in your"
" flesh."
msgstr ""
"Sientes una sacudida en todo tu cuerpo cuando la energía pulsa a través de "
"los cables en tu carne."

#: lang/json/SPELL_from_json.py
msgid "Cryokinetic blast"
msgstr "Explosión CrioKinética"

#: lang/json/SPELL_from_json.py
msgid "Holographic Field"
msgstr "Campo Holográfico"

#. ~ Description for Holographic Field
#: lang/json/SPELL_from_json.py
msgid "Creates several short-lived holograms around you."
msgstr "Crea varios hologramas de corta duración a su alrededor."

#: lang/json/SPELL_from_json.py
msgid "Holographic Decoy"
msgstr "Señuelo holográfico"

#. ~ Description for Holographic Decoy
