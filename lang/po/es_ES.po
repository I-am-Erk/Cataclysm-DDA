msgstr "Explosión eléctrica seguida de un teletransporte."

#: lang/json/SPELL_from_json.py
msgid "Dermatik Emergence"
msgstr "Emergencia Dermatik"

#. ~ Description for Dermatik Emergence
#: lang/json/SPELL_from_json.py
msgid "The incubating dermatik larvae flee their host."
msgstr "La larva dermatik incubada escapa de su huésped."

#: lang/json/SPELL_from_json.py
