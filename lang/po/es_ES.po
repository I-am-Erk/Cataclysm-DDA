#. ~ Description for plastic jack o'lantern
#: lang/json/TOOL_from_json.py
msgid ""
"This is a plastic lantern that is painted to look like a pumpkin with a "
"face.  It has a tiny LED light in it.  It doesn't provide very much light."
msgstr ""
"Esto es una linterna de plástico que está pintada para parecerse a una "
"calabaza con cara. Tiene una pequeña luz LED dentro. No proporciona mucha "
"luz."

#: lang/json/TOOL_from_json.py
msgid "spooky plastic jack o'lantern"
