msgstr "Helado con trozos de chocolate, caramelo u otros sabores mezclados."

#: lang/json/COMESTIBLE_from_json.py
msgid "fruity ice cream"
msgid_plural "fruity ice cream scoops"
msgstr[0] "bola de helado de frutas"
msgstr[1] "bolas de helado de frutas"

