msgstr "\"¡Estás bajo arresto!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity detected!\""
msgstr "\"¡Actividad criminal detectada!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity registered!\""
msgstr "\"¡Actividad criminal registrada!\""

#: lang/json/speech_from_json.py
msgid "\"Violation of law detected!\""
msgstr "\"¡Se ha detectado una violación de la ley!\""

#: lang/json/speech_from_json.py
msgid "\"Suspect on the move!\""
msgstr "\"¡Sospechoso en movimiento!\""

#: lang/json/speech_from_json.py
