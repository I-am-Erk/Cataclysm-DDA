#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s snaps its tentacle at your %2$s!"
msgstr "¡%1$s te golpea con su tentáculo tu %2$s!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s snaps its tentacle at <npcname>'s %2$s!"
msgstr "¡ %1$s golpea con su tentáculo %2$s de <npcname>!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's tentacle lashes out at you without doing any damage."
msgstr "El tentáculo de %1$s arremete contra ti sin causar ningún daño."

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's tentacle lashes out at <npcname> without doing any damage."
msgstr ""
"El tentáculo del %1$s arremete hacia <npcname> sin causar ningún daño."

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head shoots out, and its teeth sink into your %2$s!"
msgstr ""
"¡La cabeza de %1$s se lanza hacia adelante y sus dientes se hunden en tu "
"%2$s!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head shoots out, and its teeth sink into <npcname>'s %2$s!"
msgstr ""
"¡La cabeza de %1$s se lanza hacia adelante y sus dientes se hunden en  %2$s "
"de <npcname>!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s's head hits your %2$s, but glances off your armor!"
msgstr "¡La cabeza del %1$s golpea tu %2$s, pero rebota en tu armadura!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's head hits <npcname>'s %2$s, but glances off their armor!"
msgstr ""
"¡La cabeza del %1$s golpea %2$s de <npcname> pero rebota en su armadura!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts its arms at you, and its claws pierce your %2$s!"
msgstr "¡%1$s lanza sus brazos hacia ti y su garras penetran tu %2$s!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid ""
"The %1$s thrusts its arms at <npcname>, and its claws pierce their %2$s!"
msgstr "¡%1$s lanza sus brazos y sus garras penetran %2$s de <npcname>!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's arms hit your %2$s, but they glance off your armor!"
msgstr "¡Los brazos de %1$s golpean tu %2$s, pero rebota en tu armadura!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s's arms hit <npcname>'s %2$s, but they glance off their armor!"
msgstr ""
"¡Los brazos de %1$s golpean %2$s de <npcname>, pero rebotan en su armadura!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts a claw at your %2$s, slashing it!"
msgstr "¡%1$s lanza una garra a tu %2$s, acuchillándolo!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s thrusts a claw at <npcname>'s %2$s, slashing it!"
msgstr "¡%1$s lanza una garra contra %2$s de <npcname>, acuchillándolo!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s thrusts a claw at your %2$s, but glances off your armor!"
msgstr ""
"¡El %1$s impulsa una garra contra tu %2$s, pero rebota en tu armadura!"

#: lang/json/monster_attack_from_json.py src/monattack.cpp
#, c-format, no-python-format
msgid "The %1$s thrusts a claw at <npcname>'s %2$s, but glances off armor!"
msgstr ""
"¡ %1$s impulsa una garra hacia %2$s de <npcname>, pero roza contra la "
"armadura!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s slashes at your neck, cutting your throat!"
msgstr "¡ %1$s da un tajo contra tu cuello cortando tu garganta!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s slashes at <npcname>'s neck, cutting their throat!"
msgstr "¡ %1$s da un tajo contra el cuello de <npcname> cortando su garganta!"

#: lang/json/monster_attack_from_json.py
#, no-python-format
msgid "The %1$s slashes at your neck, but glances off your armor!"
msgstr "¡%1$s da un tajo contra tu cuello pero rebota en tu armadura!"

