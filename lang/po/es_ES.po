msgstr[1] "obis"

#. ~ Description for obi
#: lang/json/ARMOR_from_json.py
msgid "A broad, black obi gi."
msgstr "Un cinturón obi gi negro y amplio."

#: lang/json/ARMOR_from_json.py
msgid "police duty belt"
msgid_plural "police duty belts"
msgstr[0] "cinturón de policía"
msgstr[1] "cinturones de policía"

#. ~ Use action holster_msg for police duty belt.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You attach your %s to your %s."
msgstr "Has colocado tu %s en tu %s."

#. ~ Use action holster_prompt for police duty belt.
#: lang/json/ARMOR_from_json.py
msgid "Attach what to holder?"
msgstr "¿Qué quieres guardar en tu agarre?"

#. ~ Description for police duty belt
#: lang/json/ARMOR_from_json.py
msgid ""
"Black leather belt used by police officers.  It has several pouches and a "
"holder for a baton."
msgstr ""
"Cinturón de cuero negro usado por los oficiales de policía. Tiene varios "
"bolsillos y un agarre para una porra."

#: lang/json/ARMOR_from_json.py
msgid "survivor belt"
msgid_plural "survivor belts"
msgstr[0] "cinturón de superviviente"
msgstr[1] "cinturones de superviviente"

#. ~ Use action holster_msg for survivor belt.
#. ~ Use action holster_msg for tool belt.
#. ~ Use action holster_msg for webbing belt.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You put your %1$s in your %2$s"
msgstr "Colocas tu %1$s en tu  %2$s."

#. ~ Use action holster_prompt for survivor belt.
#. ~ Use action holster_prompt for tool belt.
#. ~ Use action holster_prompt for webbing belt.
#: lang/json/ARMOR_from_json.py
msgid "Store tool or blade"
msgstr "Almacenar herramienta o espada"

#. ~ Description for survivor belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A custom-built leather utility belt covered with straps and pouches with a "
"sheath to carry a smaller blade.  Durable and carefully crafted to be "
"comfortable to wear.  Activate to sheathe/draw a weapon."
msgstr ""
"Un cinturón de cuero cubierto con correas y bolsillos, y una funda para "
"llevar una cuchilla pequeña. Duradero y cuidadosamente diseñado para ser "
"cómodo. Activar para enfundar o sacar una arma."

#: lang/json/ARMOR_from_json.py
msgid "tool belt"
msgid_plural "tool belts"
msgstr[0] "cinturón de herramientas"
msgstr[1] "cinturones de herramientas"

#. ~ Description for tool belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A common belt with pockets, loops and sheaths to store up to six tools or "
"blades.  Widely used by handymen and electricians."
msgstr ""
"Un cinturón común con bolsillos, lazos y fundas para almacenar hasta seis "
"herramientas o cuchillas. Ampliamente utilizado por los manitas y los "
"electricistas."

#: lang/json/ARMOR_from_json.py
msgid "webbing belt"
msgid_plural "webbing belts"
msgstr[0] "cinturón de correas"
msgstr[1] "cinturones de correas"

#. ~ Description for webbing belt
#: lang/json/ARMOR_from_json.py
msgid "A 2-inch nylon webbing belt commonly used by military forces."
msgstr ""
"Un cinturón de malla de nylon de 2 pulgadas usado comúnmente por las fuerzas"
" militares."

#: lang/json/ARMOR_from_json.py
msgid "pair of cord sandals"
msgid_plural "pairs of cord sandals"
msgstr[0] "par de sandalias de cuerda"
msgstr[1] "pares de sandalias de cuerda"

#. ~ Description for pair of cord sandals
#: lang/json/ARMOR_from_json.py
msgid ""
"Lightweight sandals made from wound cord.  They offer little in the way of "
"protection, but keep you cool during warmer months."
msgstr ""
"Sandalias muy ligeras hechas con cuerdas trenzada. Ofrecen muy poca "
"protección, pero te mantendrán fresco durante los meses calurosos."

#: lang/json/ARMOR_from_json.py
msgid "pair of boots"
msgid_plural "pairs of boots"
msgstr[0] "par de botas"
msgstr[1] "pares de botas"

#. ~ Description for pair of boots
#: lang/json/ARMOR_from_json.py
msgid "Tough leather boots.  Very durable."
msgstr "Botas de cuero duras. Muy duraderas."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL boots"
msgid_plural "pairs of XL boots"
msgstr[0] "par de botas XL"
msgstr[1] "pares de botas XL"

#: lang/json/ARMOR_from_json.py
msgid "pair of occult boots"
msgid_plural "pairs of occult boots"
msgstr[0] "par de botas de ocultismo"
msgstr[1] "pares de botas de ocultismo"

#. ~ Description for pair of occult boots
#: lang/json/ARMOR_from_json.py
msgid ""
"Leather boots covered with tiny finely carved bones.  With each step the "
"bones collide with each other producing a melodic clicking"
msgstr ""
"Botas de cuero cubiertas con pequeños huesos finamente tallados. Con cada "
"paso los huesos chocan entre sí produciendo un chasquido melódico"

#: lang/json/ARMOR_from_json.py
msgid "pair of turnout boots"
msgid_plural "pairs of turnout boots"
msgstr[0] "par de botas de bombero"
msgstr[1] "pares de botas de bombero"

#. ~ Description for pair of turnout boots
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of steel-toed rubber boots, the sort worn by firefighters.  Highly "
"resistant to heat and flame, they provide excellent protection from injury."
msgstr ""
"Un par de botas de goma con punta de acero, utilizadas por los bomberos. Muy"
" resistentes al calor y al fuego. Brindan excelente protección contra "
"heridas."

#: lang/json/ARMOR_from_json.py
msgid "pair of chitinous boots"
msgid_plural "pairs of chitinous boots"
msgstr[0] "par de botas de quitina"
msgstr[1] "pares de botas de quitina"

#. ~ Description for pair of chitinous boots
#: lang/json/ARMOR_from_json.py
msgid "Boots made from the exoskeletons of insects.  Light and durable."
msgstr "Botas hechas con los exoesqueletos de insecto. Ligeras y duraderas."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL chitinous boots"
msgid_plural "pairs of XL chitinous boots"
msgstr[0] "par de botas de quitina XL"
msgstr[1] "pares de botas de quitina XL"

#: lang/json/ARMOR_from_json.py
msgid "pair of biosilicified chitin boots"
msgid_plural "pairs of biosilicified chitin boots"
msgstr[0] "par de botas de quitina biosilicificada"
msgstr[1] "pares de botas de quitina biosilicificada"

#. ~ Description for pair of biosilicified chitin boots
#: lang/json/ARMOR_from_json.py
msgid ""
"Boots crafted from carefully cleaned and pruned biosilicified exoskeletons "
"of acidic ants.  Acid-resistant and very durable."
msgstr ""
"Botas creadas con exoesqueletos de hormigas ácidas, cuidadosamente limpiados"
" y biosilicificados. Resistentes al ácido y muy duraderas."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL biosilicified chitin boots"
msgid_plural "pairs of XL biosilicified chitin boots"
msgstr[0] "par de botas de quitina biosilicificada XL"
msgstr[1] "pares de botas de quitina biosilicificada XL"

#: lang/json/ARMOR_from_json.py
msgid "pair of combat boots"
msgid_plural "pairs of combat boots"
msgstr[0] "par de botas de combate"
msgstr[1] "pares de botas de combate"

#. ~ Description for pair of combat boots
#: lang/json/ARMOR_from_json.py
msgid "Modern reinforced tactical combat boots.  Very durable."
msgstr "Botas tácticas de combate reforzadas modernas. Muy duraderas."

#: lang/json/ARMOR_from_json.py
msgid "pair of EOD foot protectors"
msgid_plural "pairs of EOD foot protectors"
msgstr[0] "par de protectores de pie EOD"
msgstr[1] "pares de protectores de pie EOD"

#. ~ Description for pair of EOD foot protectors
#: lang/json/ARMOR_from_json.py
msgid ""
"Armored foot protectors constructed from steel and nomex for explosive "
"ordnance disposal.  They are designed to protect against overpressure, "
"fragmentation, impact and heat."
msgstr ""
"Protectores de pies blindados construidos con acero y Nomex para la "
"eliminación de artefactos explosivos. Están diseñadas para proteger contra "
"la sobrepresión, la fragmentación, el impacto y el calor."

#: lang/json/ARMOR_from_json.py
msgid "pair of toecaps"
msgid_plural "pairs of toecaps"
msgstr[0] "par de punteras"
msgstr[1] "pares de punteras"

#. ~ Description for pair of toecaps
#: lang/json/ARMOR_from_json.py
msgid ""
"Rubbery overshoes that cover your toes with sturdy, ANSI compliant steel "
"toes."
msgstr ""
"Zapatos de goma que cubren los dedos de los pies con resistentes, punteras "
"de acero que cumplen con la normativa ANSI."

#: lang/json/ARMOR_from_json.py
msgid "pair of survivor fireboots"
msgid_plural "pairs of survivor fireboots"
msgstr[0] "par de botas ignífugas de superviviente"
msgstr[1] "pares de botas ignífugas de superviviente"

#. ~ Description for pair of survivor fireboots
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of customized, Kevlar armored Nomex boots, modified to provide "
"maximum protection from harm and the elements, even when knee-deep in the "
"dead."
msgstr ""
"Un par de botas de Nomex reforzadas con Kevlar. Están modificadas para "
"brindar la máxima protección contra el daño y la intemperie, incluso cuando "
"estás enterrado hasta las rodillas en muertos."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL survivor fireboots"
msgid_plural "pairs of XL survivor fireboots"
msgstr[0] "par de botas ignífugas XL de superviviente"
msgstr[1] "pares de botas ignífugas XL de superviviente"

#: lang/json/ARMOR_from_json.py
msgid "pair of fur boots"
msgid_plural "pairs of fur boots"
msgstr[0] "par de botas de piel"
msgstr[1] "pares de botas de piel"

#. ~ Description for pair of fur boots
#: lang/json/ARMOR_from_json.py
msgid "Boots lined with fur for warmth."
msgstr "Botas forradas con piel para abrigar."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL fur boots"
msgid_plural "pairs of XL fur boots"
msgstr[0] "par de botas de piel XL"
msgstr[1] "pares de botas de piel XL"

#: lang/json/ARMOR_from_json.py
msgid "pair of faux fur winter survivor boots"
msgid_plural "pairs of faux fur winter survivor boots"
msgstr[0] "par de botas de invierno del piel s. de superviviente"
msgstr[1] "pares de botas de invierno del piel s. de superviviente"

#. ~ Description for pair of faux fur winter survivor boots
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of customized, Kevlar armored faux fur boots, modified to provide "
"maximum protection from harm and the elements, even when knee-deep in the "
"dead.  While not quite as warm as real fur it's pretty good."
msgstr ""
"Un par de botas personalizadas de piel sintética blindadas con Kevlar. Están"
" modificadas para proporcionar la máxima protección contra el daño y la "
"intemperie, incluso cuando estás enterrado hasta las rodillas entre los "
"muertos. Aunque no tan cálidas como la piel real, son bastante buenas"

#: lang/json/ARMOR_from_json.py
msgid "pair of XL faux fur winter survivor boots"
msgid_plural "pairs of XL faux fur winter survivor boots"
msgstr[0] "par de botas de invierno del piel s. XL de superviviente"
msgstr[1] "pares de botas de invierno del piel s. XL de superviviente"

#. ~ Description for pair of XL faux fur winter survivor boots
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of customized and oversized, Kevlar armored faux fur boots, modified "
"to provide maximum protection from harm and the elements, even when knee-"
"deep in the dead.  While not quite as warm as real fur it's pretty good."
msgstr ""
"Un par de botas personalizadas grandes de piel sintética blindadas con "
"Kevlar. Están modificadas para proporcionar la máxima protección contra el "
