#. ~ Description for MBR vest (empty)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  It has pouches for extra armor inserts, "
"but without them provides little more protection over a regular vest.  It "
"has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Anti-balas. Tiene fundas para insertar placas de "
"armadura, pero sin ellas proporciona la misma protección que un chaleco "
"normal. Tiene cuatro bolsillos para almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "MBR vest (ceramic plates)"
msgid_plural "MBR vests (ceramic plates)"
msgstr[0] "chaleco MBR (placas de cerámica)"
msgstr[1] "chalecos MBR (placas de cerámica)"

#. ~ Description for MBR vest (ceramic plates)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  Ceramic plates have been inserted to "
"improve its protection.  The ceramic plates cannot be repaired, only "
"replaced.  It has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Anti-balas. Placas de cerámica se han insertado para "
"mejorar su protección. Las placas de cerámica no pueden ser reparadas, sólo "
"reemplazadas. Tiene cuatro bolsillos para almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "MBR vest (hard plates)"
msgid_plural "MBR vests (hard plates)"
msgstr[0] "chaleco MBR (placas endurecidas)"
msgstr[1] "chalecos MBR (placas endurecidas)"

#. ~ Description for MBR vest (hard plates)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  Hardened steel plates have been inserted, "
"greatly increasing its protection at the cost of a great deal of weight and "
"loss of flexibility.  It has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Anti-balas. Se han insertado placas de acero templado, "
"aumentando enormemente su protección a costa de una gran cantidad de peso y "
"pérdida de flexibilidad. Tiene cuatro bolsillos para almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "MBR vest (Kevlar plates)"
msgid_plural "MBR vests (Kevlar plates)"
msgstr[0] "chaleco MBR (placas de Kevlar)"
msgstr[1] "chalecos MBR (placas de Kevlar)"

#. ~ Description for MBR vest (Kevlar plates)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  Kevlar plates have been inserted to "
"improve its protection.  It has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Anti-balas. Se han insertado placas de Kevlar para "
"mejorar su protección. Tiene cuatro bolsillos para almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "MBR vest (steel plating)"
msgid_plural "MBR vests (steel plating)"
msgstr[0] "chaleco MBR (placas de acero)"
msgstr[1] "chalecos MBR (placas de acero)"

#. ~ Description for MBR vest (steel plating)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  Its armor pouches have steel plates in "
"them; this improves protection, but makes the vest much heavier and "
"encumbering.  It has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Anti-balas. Sus fundas de armadura tienen placas de acero"
" en ellas; mejora la protección, pero hace el chaleco mucho más pesado e "
"incomodo. Tiene cuatro bolsillos para almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "MBR vest (superalloy)"
msgid_plural "MBR vests (superalloy)"
msgstr[0] "chaleco MBR (superaleación)"
msgstr[1] "chalecos MBR (superaleación)"

#. ~ Description for MBR vest (superalloy)
#: lang/json/ARMOR_from_json.py
msgid ""
"A Modular Bullet Resistant Vest.  Its armor pouches have superalloy plating "
"in them, giving it extra protection with marginal flexibility loss and "
"additional weight.  It has four pouches capable of carrying magazines."
msgstr ""
"Un Chaleco Modular Antibalas. Sus fundas de armadura tienen un revestimiento"
" de superaleación en ellas, dándole protección extra con una pérdida de "
"flexibilidad marginal y peso adicional. Tiene cuatro bolsillos para "
"almacenar cargadores."

#: lang/json/ARMOR_from_json.py
msgid "arm splint"
msgid_plural "arm splints"
msgstr[0] "férula para brazo"
msgstr[1] "férulas para brazos"

#. ~ Description for arm splint
#. ~ Description for leg splint
#: lang/json/ARMOR_from_json.py
msgid "A tool to help set bones and hold them in place."
msgstr "Una herramienta para ayudar a colocar los huesos en su sitio."

#: lang/json/ARMOR_from_json.py
msgid "arm splint XL"
msgid_plural "arm splints XL"
msgstr[0] "férula de brazo XL"
msgstr[1] "férulas de brazo XL"

#. ~ Description for arm splint XL
#: lang/json/ARMOR_from_json.py
msgid ""
"A tool to help set bones and hold them in place.  It is specifically "
"designed to fit Huge survivors."
msgstr ""
"Una herramienta para ayudar a colocar los huesos en su sitio. "
"Específicamente diseñado para supervivientes Enormes."

#: lang/json/ARMOR_from_json.py
msgid "tourniquet (arm)"
msgid_plural "tourniquets (arm)"
msgstr[0] "torniquete (brazo)"
msgstr[1] "torniquetes (brazo)"

#. ~ Use action menu_text for tourniquet (arm).
#. ~ Use action menu_text for tourniquet (arm XL).
#. ~ Use action menu_text for tourniquet (leg).
#: lang/json/ARMOR_from_json.py
msgid "Adjust"
msgstr "Ajustar"

#. ~ Use action msg for tourniquet (arm).
#. ~ Use action msg for tourniquet (arm XL).
#. ~ Use action msg for tourniquet (leg).
#: lang/json/ARMOR_from_json.py
msgid "You adjust the tourniquet."
msgstr "Ajustas el torniquete."

#. ~ Description for tourniquet (arm)
#. ~ Description for tourniquet (arm XL)
#. ~ Description for tourniquet (leg)
#: lang/json/ARMOR_from_json.py
msgid ""
"First aid device used to apply pressure to a limb or extremity in order to "
"limit blood flow.  Should be employed only to manage heavy bleedings, "
"because prolonged use will harm the limb.  It can be adjusted in size to fit"
" different limbs."
msgstr ""
"Dispositivo de primeros auxilios que se utiliza para aplicar presión a una "
"extremidad o miembro con el fin de limitar el flujo sanguíneo. Debe "
"emplearse sólo para controlar hemorragias fuertes, porque el uso prolongado "
"dañará la extremidad. Puede ajustarse en tamaño para adaptarse a diferentes "
"extremidades."

#: lang/json/ARMOR_from_json.py
msgid "tourniquet (arm XL)"
msgid_plural "tourniquets (arm XL)"
msgstr[0] "torniquete (brazo XL)"
msgstr[1] "torniquetes (brazo XL)"

#: lang/json/ARMOR_from_json.py
msgid "tourniquet (leg)"
msgid_plural "tourniquets (leg)"
msgstr[0] "torniquete (pierna)"
msgstr[1] "torniquetes (pierna)"

#: lang/json/ARMOR_from_json.py
msgid "makeshift blindfold"
msgid_plural "makeshift blindfolds"
msgstr[0] "venda para ojos improvisada"
msgstr[1] "vendas para ojos improvisadas"

#. ~ Description for makeshift blindfold
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude eye covering woven from blades of grass with string attached to "
"fasten it.  Useful for sleeping in bright areas."
msgstr ""
"Una tosca cubierta para los ojos tejida con briznas de hierba con una cuerda"
" para ajustarla. Útil para dormir en zonas luminosas."

#: lang/json/ARMOR_from_json.py
msgid "blindfold"
msgid_plural "blindfolds"
msgstr[0] "venda para ojos"
msgstr[1] "vendas para ojos"

#. ~ Description for blindfold
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple fabric covering tied over the eyes to block sight.  Useful for "
"sleeping in bright areas."
msgstr ""
"Una simple tela atada sobre los ojos para bloquear la visión. Útil para "
"dormir en zonas luminosas."

#: lang/json/ARMOR_from_json.py
msgid "duct tape blindfold"
msgid_plural "duct tape blindfolds"
msgstr[0] "venda para ojos con cinta americana"
msgstr[1] "vendas para ojos con cinta americana"

#. ~ Description for duct tape blindfold
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple covering tied over the eyes to block sight, made out of duct tape."
"  Useful for sleeping in bright areas."
msgstr ""
"Una simple cubierta colocada sobre los ojos para bloquear la vista, hecha "
"con cinta americana. Útil para dormir en zonas luminosas."

#: lang/json/ARMOR_from_json.py
msgid "pair of ear plugs"
msgid_plural "pairs of ear plugs"
msgstr[0] "par de tapones de oídos"
msgstr[1] "pares de tapones de oídos"

#. ~ Description for pair of ear plugs
#: lang/json/ARMOR_from_json.py
msgid "Industrial grade ear plugs.  They fit inside the ear."
msgstr "Tapones industriales para los oídos. Se ponen dentro de la oreja."

#: lang/json/ARMOR_from_json.py
msgid "go bag"
msgid_plural "go bags"
msgstr[0] "bolso de evacuación"
msgstr[1] "bolsos de evacuación"

#. ~ Description for go bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge duffel bag with backpack attached, both packed to the gills.  Judging"
" by the feel, a National Guard soldier could have packed this to be ready "
"for deployment.  Activate to unpack and enjoy."
msgstr ""
"Una enorme bolsa de lona con mochila, ambas llenas hasta los bordes. A "
"juzgar por el tacto, un soldado de la Guardia Nacional podría haber "
"empaquetado esto para estar preparado para el despliegue. Actívar para "
"desempaquetarlo y disfrutarlo."

#: lang/json/ARMOR_from_json.py
msgid "personal go bag"
msgid_plural "personal go bags"
msgstr[0] "bolsa de emergencia personal"
msgstr[1] "bolsas de emergencia personales"

#. ~ Description for personal go bag
#: lang/json/ARMOR_from_json.py
msgid ""
"A huge duffel bag with backpack attached, both packed to the gills.  You "
"have packed this to be ready for deployment.  Activate to unpack and enjoy."
msgstr ""
"Un enorme bolsa de lona con mochila, ambas empaquetadas hasta las bordes. "
"Has empaquetado esto para estar listo para el despliegue. Activar para "
"desempaquetar y disfrutar."

#: lang/json/ARMOR_from_json.py
msgid "leg splint"
msgid_plural "leg splints"
msgstr[0] "férula para pierna"
msgstr[1] "férulas para piernas"

#: lang/json/ARMOR_from_json.py
msgid "leg splint XL"
msgid_plural "leg splints XL"
msgstr[0] "férula para pierna XL"
msgstr[1] "férulas para pierna XL"

#. ~ Description for leg splint XL
#: lang/json/ARMOR_from_json.py
msgid ""
"A tool to help set bones and hold them in place.  It is specifically "
"designed to fit Huge people."
msgstr ""
"Una herramienta para ayudar a colocar los huesos en su sitio. "
"Específicamente diseñada para personas Enormes."

#: lang/json/ARMOR_from_json.py
msgid "welding mask"
msgid_plural "welding masks"
msgstr[0] "mascara de soldador"
msgstr[1] "mascaras de soldador"

#. ~ Use action menu_text for welding mask.
#. ~ Use action menu_text for crude welding mask.
#: lang/json/ARMOR_from_json.py
msgid "Raise"
msgstr "Levantar"

#. ~ Use action msg for welding mask.
#. ~ Use action msg for crude welding mask.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You push your %s up your head."
msgstr "Empujas tu %s por encima de tu cabeza."

#. ~ Description for welding mask
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic mask with a very dark visor, meant to protect the entire face "
"while welding.  It also serves as somewhat good armor, but makes it hard to "
"see.  Activate it to push it up your head."
msgstr ""
"Una máscara de plástico con una visera muy oscura, para proteger toda la "
"cara mientras se suelda. También sirve como una buena armadura, pero hace "
"que sea difícil de ver. Actívar para empujarla hacia arriba de tu cabeza."

#: lang/json/ARMOR_from_json.py
msgid "crude welding mask"
msgid_plural "crude welding masks"
msgstr[0] "máscara de soldadura tosca"
msgstr[1] "máscaras de soldadura toscas"

#. ~ Description for crude welding mask
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude welding mask made from shaped steel.  It's less dark than a proper "
"welding mask, and therefore less difficult to see in, but also less "
"protective when welding.  Activate it to push it up your head."
msgstr ""
"Una máscara de soldadura cruda hecha a partir de acero. Es menos oscura que "
"una máscara de soldadura adecuada, y por lo tanto menos difícil de ver, pero"
" también menos protectora al soldar. Activar para empujarla hacia arriba de "
"tu cabeza."

#: lang/json/ARMOR_from_json.py
msgid "crude welding mask (raised)"
msgid_plural "crude welding masks (raised)"
msgstr[0] "máscara de soldadura tosca (levantada)"
msgstr[1] "máscaras de soldadura tosca (levantada)"

#. ~ Use action menu_text for crude welding mask (raised).
#. ~ Use action menu_text for welding mask (raised).
#: lang/json/ARMOR_from_json.py
msgid "Lower"
msgstr "Bajar"

#. ~ Use action msg for crude welding mask (raised).
#: lang/json/ARMOR_from_json.py
msgid "You lower your crude welding mask over your face."
msgstr "Te bajas la máscara de soldadura cruda sobre tu cara."

#. ~ Description for crude welding mask (raised)
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude welding mask made from shaped steel.  It's less dark than a proper "
"welding mask, and therefore less difficult to see in, but also less "
"protective when welding.  Activate it to lower it over your face."
msgstr ""
"Una máscara de soldadura tosca hecha a partir de acero. Menos oscura que una"
" máscara de soldadura, y por lo tanto menos difícil de ver, pero también "
"menos protectora al soldar. Actívarla para bajarla sobre tu cara."

#: lang/json/ARMOR_from_json.py
msgid "welding mask (raised)"
msgid_plural "welding masks (raised)"
msgstr[0] "máscara de soldadura (levantada)"
msgstr[1] "máscaras de soldadura (levantada)"

#. ~ Use action msg for welding mask (raised).
#: lang/json/ARMOR_from_json.py
msgid "You lower your welding mask over your face."
msgstr "Te bajas la máscara de soldadura sobre tu cara."

#. ~ Description for welding mask (raised)
#: lang/json/ARMOR_from_json.py
msgid ""
"A plastic mask with a very dark visor, meant to protect the entire face "
"while welding.  It also serves as somewhat good armor, but makes it hard to "
"see.  Activate it to lower it over your face."
msgstr ""
"Una máscara de plástico con una visera muy oscura, para proteger toda la "
"cara mientras se suelda. También sirve como una buena armadura, pero hace "
"que sea difícil de ver. Actívar para bajarla sobre tu cara."

#: lang/json/ARMOR_from_json.py
msgid "pair of attached ear plugs (in)"
msgid_plural "pairs of attached ear plugs (in)"
msgstr[0] "par de tapones para los oídos unidos (colocado)"
msgstr[1] "pares de tapones para los oídos unidos (colocados)"

#. ~ Use action menu_text for pair of attached ear plugs (in).
#: lang/json/ARMOR_from_json.py
msgid "Unplug"
msgstr "Quitar"

#. ~ Use action msg for pair of attached ear plugs (in).
#: lang/json/ARMOR_from_json.py
msgid "You take the ear plugs out."
msgstr "Te quitas los tapones para los oidos."

#. ~ Description for pair of attached ear plugs (in)
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of industrial grade ear plugs attached together by some string.  They"
" are inside your ears, activate them to take them out."
msgstr ""
"Un par de tapones para los oídos de calidad industrial unidos por una "
"cuerda. Están dentro de tus oídos, activar para quitártelos."

#: lang/json/ARMOR_from_json.py
msgid "pair of attached ear plugs (out)"
msgid_plural "pairs of attached ear plugs (out)"
msgstr[0] "par de tapones unidos para los oídos (no colocados)"
msgstr[1] "pares de tapones unidos para los oídos (no colocados)"

#. ~ Use action menu_text for pair of attached ear plugs (out).
#: lang/json/ARMOR_from_json.py
msgid "Plug in"
msgstr "Colocar"

#. ~ Use action msg for pair of attached ear plugs (out).
#: lang/json/ARMOR_from_json.py
msgid "You plug up your ears."
msgstr "Te colocas los tapones para los oidos."

#. ~ Description for pair of attached ear plugs (out)
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of industrial grade ear plugs, they are attached together by some "
"string.  They hang around your neck, use them to plug them in."
msgstr ""
"Un par de tapones para los oídos de calidad industrial, están unidos por una"
" cuerda. Cuelgan alrededor de tu cuello, y usalos para colocártelos."

#: lang/json/ARMOR_from_json.py
msgid "strange pressure"
msgid_plural "strange pressures"
msgstr[0] "presión extraña"
msgstr[1] "presiones extrañas"

#. ~ Description for strange pressure
#: lang/json/ARMOR_from_json.py
msgid "You feel a strange force pressing you inwards and inside-out."
msgstr ""
"Sientes una fuerza extraña que te presiona hacia adentro y hacia afuera."

#: lang/json/ARMOR_from_json.py
msgid "temporal distortion"
msgid_plural "temporal distortions"
msgstr[0] "distorsión temporal"
msgstr[1] "distorsiones temporales"

#. ~ Description for temporal distortion
#: lang/json/ARMOR_from_json.py
msgid "A slight temporal distortion appears to be centered around you."
msgstr "Una ligera distorsión temporal parece estar centrada a tu alrededor."

#: lang/json/ARMOR_from_json.py
msgid "ammo pouch"
msgid_plural "ammo pouches"
msgstr[0] "bolsa de munición"
msgstr[1] "bolsas de munición"

#. ~ Description for ammo pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A small pouch that can be used to store most types of small ammunition; "
"rockets, however, will not fit.  Use insert to store ammunition."
msgstr ""
"Una pequeña bolsa que puede ser usada para almacenar la mayoría de los tipos"
" de municiones pequeñas, los misiles sin embargo no caben. Use insertar para"
" almacenar la munición."

#: lang/json/ARMOR_from_json.py
msgid "ammo satchel"
msgid_plural "ammo satchels"
msgstr[0] "mochila de munición"
msgstr[1] "mochilas de munición"

#. ~ Description for ammo satchel
#: lang/json/ARMOR_from_json.py
msgid ""
"A fabric ammo bag worn at the waist.  It is capable of holding a single "
"large magazine close at hand."
msgstr ""
"Una bolsa de tejido para munición que se pone en la cintura y te permite "
"tener un cargador a mano."

#: lang/json/ARMOR_from_json.py
msgid "chest ammo pouch"
msgid_plural "chest ammo pouches"
msgstr[0] "pechera de munición"
msgstr[1] "pecheras de munición"

#. ~ Description for chest ammo pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A fabric ammo pouch that can be strapped to your chest and hold a single "
"magazine close at hand."
msgstr ""
"Una bolsa de tejido para munición que puede ser atada a tu pecho y permite "
"tener un cargador a mano."

#: lang/json/ARMOR_from_json.py
msgid "chest rig"
msgid_plural "chest rig"
msgstr[0] "chaleco de munición"
msgstr[1] "chaleco de munición"

#. ~ Description for {'str_sp': 'chest rig'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Popularized during the Vietnam War, chest rigs like these are typically "
"plain, barebones affairs consisting of three or more pouches in a row, with "
"straps to secure them on your chest.  This one can hold four magazines in "
"its pouches."
msgstr ""
"Popularizados durante la guerra de Vietnam, los chalecos de munición como "
"estos son tipicamente simples objetos compactos que consisten en tres o más "
"bolsillos en una fila, con correas para asegurarlos a tu pecho. Este puede "
"almacenar cuatro cargadores en sus bolsillos."

#: lang/json/ARMOR_from_json.py
msgid "XL chest rig"
msgid_plural "XL chest rigs"
msgstr[0] "chaleco de munición XL"
msgstr[1] "chalecos de munición XL"

#. ~ Description for XL chest rig
#: lang/json/ARMOR_from_json.py
msgid ""
"Popularized during the Vietnam War, chest rigs like these are typically "
"plain, barebones affairs consisting of three or more pouches in a row, with "
"straps to secure them on your chest.  This one can hold four magazines in "
"its pouches and fits larger-than-human forms."
msgstr ""
"Popularizados durante la guerra de Vietnam, los chalecos de munición como "
"estos son tipicamente simples objetos compactos que consisten en tres o más "
"bolsillos en una fila, con correas para asegurarlos a tu pecho. Este puede "
"contener cuatro cargadores en sus bolsillos y encajan en formas más grandes "
"que las humanas."

#: lang/json/ARMOR_from_json.py
msgid "javelin bag"
msgid_plural "javelin bags"
msgstr[0] "bolsa para jabalinas"
msgstr[1] "bolsas para jabalinas"

#. ~ Use action holster_prompt for javelin bag.
#: lang/json/ARMOR_from_json.py
msgid "Stash javelins"
msgstr "Almacenar jabalinas"

#. ~ Description for javelin bag
#: lang/json/ARMOR_from_json.py
msgid ""
"An open medieval-looking bag, designed to store javelins within easy reach."
msgstr ""
"Una bolsa abierta de aspecto medieval, diseñada para guardar jabalinas con "
"un fácil acceso."

#: lang/json/ARMOR_from_json.py
msgid "ankle ammo pouch"
msgid_plural "ankle ammo pouches"
msgstr[0] "tobillera de munición"
msgstr[1] "tobilleras de munición"

#. ~ Description for ankle ammo pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A small fabric ammo pouch that can be strapped to your ankle and hold a "
"single small magazine close at hand."
msgstr ""
"Una pequeña bolsa de tejido para munición que puede ser atada al tobillo y "
"permite tener un cargador pequeño a mano."

#: lang/json/ARMOR_from_json.py
msgid "leg ammo pouch"
msgid_plural "leg ammo pouches"
msgstr[0] "pernera de munición"
msgstr[1] "perneras de munición"

#. ~ Description for leg ammo pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A fabric ammo pouch that can be strapped to your leg and hold two magazines "
"close at hand."
msgstr ""
"Una bolsa de tejido para munición que puede ser atada a tu pierna y permite "
"tener dos cargadores a mano."

#: lang/json/ARMOR_from_json.py
msgid "quiver"
msgid_plural "quivers"
msgstr[0] "aljaba"
msgstr[1] "aljabas"

#. ~ Description for quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather quiver worn at the waist that can hold 20 arrows or bolts.  Use "
"insert to store arrows or bolts."
msgstr ""
"Un carcaj de cuero que se lleva a la cintura y puede almacenar hasta 20 "
"flechas o saetas. Usar para almacenar flechas o saetas."

#: lang/json/ARMOR_from_json.py
msgid "birchbark quiver"
msgid_plural "birchbark quivers"
msgstr[0] "aljaba de abedul"
msgstr[1] "aljabas de abedul"

#. ~ Description for birchbark quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A quiver woven from strips of birch bark, worn at the waist, that can hold "
"20 arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Un carcaj tejido de tiras de corteza de abedul, llevado en la cintura, que "
"puede contener 20 flechas o saetas. Usar para almacenar flechas o saetas."

#: lang/json/ARMOR_from_json.py
msgid "large quiver"
msgid_plural "large quivers"
msgstr[0] "aljaba grande"
msgstr[1] "aljabas grandes"

#. ~ Description for large quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A large leather quiver trimmed with metal, worn on the back, that can hold "
"60 arrows or bolts.  Historically used by horse archers, rather than foot "
"archers, but neither of THEM had to fight zombies.  Use insert to store "
"arrows or bolts."
msgstr ""
"Una carcaj grande de cuero adornado con metal, se usa en la espalda y puede "
"almacenar hasta 60 flechas o saetas. Históricamente fue utilizada por los "
"arqueros a caballo, más que por los que iban a pie, pero ninguno de ELLOS "
"tuvo que pelearse contra zombis. Usar para almacenar flechas o saetas."

#: lang/json/ARMOR_from_json.py
msgid "large birchbark quiver"
msgid_plural "large birchbark quivers"
msgstr[0] "aljaba de abedul grande"
msgstr[1] "aljabas de abedul grandes"

#. ~ Description for large birchbark quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A large quiver woven from strips of birchbark, worn on the back, that can "
"hold 60 arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Un carcaj tejido de tiras de corteza de abedul, llevado en la espalda, que "
"puede contener 20 flechas o saetas. Usa insertar para almacenar flechas o "
"saetas."

#: lang/json/ARMOR_from_json.py
msgid "tac vest"
msgid_plural "tac vests"
msgstr[0] "chaleco táctico"
msgstr[1] "chalecos tácticos"

#. ~ Description for tac vest
#: lang/json/ARMOR_from_json.py
msgid ""
"This light vest is meant to carry your gear and ammunition comfortably "
"distributed about your torso.  They are popular amongst law enforcement, but"
" less so than combination tactical vests incorporating Kevlar.  Lightweight "
"and easy to don, this vest can hold four magazines close at hand in its many"
" pouches."
msgstr ""
"Chaleco ligero destinado a llevar confortablemente tu equipo y municiones  "
"distribuidas por el torso. Son populares entre las fuerzas del orden, pero "
"menos que los chalecos tácticos combinados que incorporan kevlar. Ligero y "
"fácil de llevar, este chaleco puede almacenar hasta cuatro cargadores a mano"
" en sus muchos bolsillos."

#: lang/json/ARMOR_from_json.py
msgid "XL tac vest"
msgid_plural "XL tac vests"
msgstr[0] "chaleco táctico XL"
msgstr[1] "chalecos tácticos XL"

#. ~ Description for XL tac vest
#: lang/json/ARMOR_from_json.py
msgid ""
"This light vest is meant to carry your gear and ammunition comfortably "
"distributed about your torso.  They are popular amongst law enforcement, but"
" less so than combination tactical vests incorporating Kevlar.  Oversized "
"and easy to don, this vest can hold four magazines close at hand in its many"
" pouches."
msgstr ""
"Chaleco ligero destinado a llevar confortablemente tu equipo y municiones "
"distribuidas por el torso. Son populares entre las fuerzas del orden, pero "
"menos que los chalecos tácticos combinados que incorporan kevlar. De gran "
"tamaño y fácil de llevar, este chaleco puede almacenar hasta cuatro "
"cargadores a mano en sus muchos bolsillos."

#: lang/json/ARMOR_from_json.py
msgid "XL Kevlar vest"
msgid_plural "XL Kevlar vests"
msgstr[0] "chaleco de kevlar XL"
msgstr[1] "chalecos de kevlar XL"

#. ~ Description for XL Kevlar vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A massive, hand-built Kevlar vest based on the design of existing bullet-"
"resistant vests.  It has four pouches capable of carrying magazines."
msgstr ""
"Un masivo, chaleco de kevlar hecho a mano basado en el diseño de los "
"chalecos antibalas existentes. Tiene cuatro bolsillos capaces de almacenar "
"cargadores."

#: lang/json/ARMOR_from_json.py
msgid "pair of 2-by-arm guards"
msgid_plural "pairs of 2-by-arm guards"
msgstr[0] "par de guarda de 2 por brazo"
msgstr[1] "pares de guarda de 2 por brazo"

#. ~ Description for pair of 2-by-arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of improvised arm guards made from broken pieces of a plank that are "
"tied to your arms with rags and string.  They offer good protection, but are"
" really uncomfortable to wear."
msgstr ""
"Un par improvisados de guardabrazos hechos con trozos rotos de un tablón que"
" se atan a los brazos con trapos y cuerda. Ofrecen una buena protección, "
"pero son realmente incómodos de llevar."

#: lang/json/ARMOR_from_json.py
msgid "pair of chitin arm guards"
msgid_plural "pairs of chitin arm guards"
msgstr[0] "par de guardabrazos de quitina"
msgstr[1] "pares de guardabrazos de quitina"

#. ~ Description for pair of chitin arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards made from the exoskeletons of insects.  Light and "
"durable."
msgstr ""
"Un par de guardabrazos hechos de exoesqueletos de insecto. Ligero y "
"duradero."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL chitin arm guards"
msgid_plural "pairs of XL chitin arm guards"
msgstr[0] "par de guardabrazos de quitina XL"
msgstr[1] "pares de guardabrazos de quitina XL"

#. ~ Description for pair of XL chitin arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards made from the exoskeletons of insects.  Light and "
"durable.  Larger than average."
msgstr ""
"Un par de guardabrazos hechos de exoesqueleto de insectos. Ligero y "
"duradero. Más grande que la media."

#: lang/json/ARMOR_from_json.py
msgid "pair of biosilicified chitin arm guards"
msgid_plural "pairs of biosilicified chitin arm guards"
msgstr[0] "par de guardabrazos de quitina biosilicificada"
msgstr[1] "pares de guardabrazos de quitina biosilicificada"

#. ~ Description for pair of biosilicified chitin arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards crafted from the carefully cleaned and pruned "
"biosilicified exoskeletons of acidic ants.  Acid-resistant and very durable."
msgstr ""
"Un par de guardabrazos fabricado con exoesqueletos de hormigas ácidas, "
"cuidadosamente limpiados y biosilicificados. Son resistentes al ácido y muy "
"duraderos."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL biosilicified chitin arm guards"
msgid_plural "pairs of XL biosilicified chitin arm guards"
msgstr[0] "par de guardabrazos de quitina biosilicificada XL"
msgstr[1] "pares de guardabrazos de quitina biosilicificada XL"

#. ~ Description for pair of XL biosilicified chitin arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards crafted from the carefully cleaned and pruned "
"biosilicified exoskeletons of acidic ants.  Acid-resistant and very durable "
"and sized for the largest of survivors."
msgstr ""
"Un par de guardabrazos fabricado con exoesqueletos biosilicificados "
"cuidadosamente limpiados y recortados a partir de hormigas ácidas. "
"Resistente a los ácidos, muy duraderos y de tamaño para el más grande de los"
" supervivientes."

#: lang/json/ARMOR_from_json.py
msgid "pair of hard arm guards"
msgid_plural "pairs of hard arm guards"
msgstr[0] "par de guardabrazos duros"
msgstr[1] "pares de guardabrazos duros"

#. ~ Description for pair of hard arm guards
#: lang/json/ARMOR_from_json.py
msgid "A pair of neoprene arm sleeves covered with molded plastic sheaths."
msgstr ""
"Un par de protectores de brazo de neopreno recubiertos con placas de "
"plástico."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL hard arm guards"
msgid_plural "pairs of XL hard arm guards"
msgstr[0] "par de guardabrazos duros XL"
msgstr[1] "pares de guardabrazos duros XL"

#. ~ Description for pair of XL hard arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of neoprene arm sleeves covered with molded plastic sheaths.  Epic "
"sized."
msgstr ""
"Un par de protectores de brazos de neopreno recubiertas con placas moldeadas"
" de plástico. De tamaño épico."

#: lang/json/ARMOR_from_json.py
msgid "pair of leather arm guards"
msgid_plural "pairs of leather arm guards"
msgstr[0] "par de guardabrazos de cuero"
msgstr[1] "pares de guardabrazos de cuero"

#. ~ Description for pair of leather arm guards
#: lang/json/ARMOR_from_json.py
msgid "A pair of tough leather arm guards.  Light and comfortable."
msgstr "Un par de guardabrazos de cuero resistente. Ligeros y cómodos."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL leather arm guards"
msgid_plural "pairs of XL leather arm guards"
msgstr[0] "par de guardabrazos de cuero XL"
msgstr[1] "pares de guardabrazos de cuero XL"

#. ~ Description for pair of XL leather arm guards
#: lang/json/ARMOR_from_json.py
msgid "A pair of gigantic leather arm guards.  Heavy but comfortable."
msgstr ""
"Un par de guardabrazos de cuero resistente gigantes. Pesados pero cómodos."

#: lang/json/ARMOR_from_json.py
msgid "pair of steel arm guards"
msgid_plural "pairs of steel arm guards"
msgstr[0] "par de guardabrazos de acero"
msgstr[1] "pares de guardabrazos de acero"

#. ~ Description for pair of steel arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A full assembly of medieval arm protection.  Rerebraces, couters, and "
"vambraces, with leather straps to secure each piece and connect it as part "
"of a set."
msgstr ""
"Un conjunto completo de protección de brazo medieval. Rerebraces, couters, y"
" vambraces, con correas de cuero para sujetar cada pieza que se conecta como"
" parte de un conjunto."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL steel arm guards"
msgid_plural "pairs of XL steel arm guards"
msgstr[0] "par de guardabrazos de acero XL"
msgstr[1] "pares de guardabrazos de acero XL"

#. ~ Description for pair of XL steel arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A full assembly of medieval arm protection, made for Jotun.  Rerebraces, "
"couters, and vambraces, with leather straps to secure each piece and connect"
" it as part of a set."
msgstr ""
"Un conjunto completo de protecciones de brazos medievales, hecho para Jotun."
" Rerebraces, couters, and vambraces, con correas de cuero para asegurar cada"
" pieza y conectarlos como parte de un conjunto."

#: lang/json/ARMOR_from_json.py
msgid "pair of metal arm guards"
msgid_plural "pairs of metal arm guards"
msgstr[0] "par de guardabrazos de metal"
msgstr[1] "pares de guardabrazos de metal"

#. ~ Description for pair of metal arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards hammered out from metal.  Perfect for the Post-"
"Apocalyptic Warrior look."
msgstr ""
"Un par de guardabrazos martillados a partir de metal. Perfectas para tener "
"ese estilo de Guerrero Post-Apocalíptico."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL metal arm guards"
msgid_plural "pairs of XL metal arm guards"
msgstr[0] "par de guardabrazos de metal Xl"
msgstr[1] "pares de guardabrazos de metal XL"

#. ~ Description for pair of XL metal arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards hammered out from metal.  Perfect for the Post-"
"Apocalyptic Warrior look.  Larger than average."
msgstr ""
"Un par de guardabrazos martillados a partir de metal. Perfectas para tener "
"ese estilo de Guerrero Post-Apocalíptico. Más grande que la media."

#: lang/json/ARMOR_from_json.py
msgid "pair of paper arm guards"
msgid_plural "pairs of paper arm guards"
msgstr[0] "par de guardabrazos de papel"
msgstr[1] "pares de guardabrazos de papel"

#. ~ Description for pair of paper arm guards
#: lang/json/ARMOR_from_json.py
msgid "Arm guards made of stacked paper sheets held together with duct tape."
msgstr ""
"Guardabrazos hechos de montones de papel, sujetos entre sí con cinta "
"americana."

#: lang/json/ARMOR_from_json.py
msgid "pair of scrap arm guards"
msgid_plural "pairs of scrap arm guards"
msgstr[0] "par de guardabrazos de chatarra"
msgstr[1] "pares de guardabrazos de chatarra"

#. ~ Description for pair of scrap arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of arm guards made from scraps of metal secured by simple strings; "
"the loose collection of plates provides decent but not the most convenient "
"protection."
msgstr ""
"Un par de guardabrazos hechos de chatarra asegurados por simples cuerdas; la"
" colección suelta de placas proporciona una protección decente pero no la "
"más conveniente."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL scrap arm guards"
msgid_plural "pairs of XL scrap arm guards"
msgstr[0] "par de guardabrazos de chatarra XL"
msgstr[1] "pares de guardabrazos de chatarra XL"

#. ~ Description for pair of XL scrap arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of oversized arm guards made from scraps of metal secured by simple "
"strings; the loose collection of plates provides decent but not the most "
"convenient protection."
msgstr ""
"Un par de guardabrazos de gran tamaño hechos de chatarras asegurados por "
"simples cuerdas; la colección suelta de placas proporciona una protección "
"decente pero no la más conveniente."

#: lang/json/ARMOR_from_json.py
msgid "pair of neoprene arm sleeves"
msgid_plural "pairs of neoprene arm sleeves"
msgstr[0] "par de mangas de neopreno"
msgstr[1] "pares de mangas de neopreno"

#. ~ Description for pair of neoprene arm sleeves
#: lang/json/ARMOR_from_json.py
msgid "A pair of soft neoprene arm sleeves.  Often used in contact sports."
msgstr ""
"Un par de mangas suaves de neopreno. A menudo utilizadas en los deportes de "
"contacto."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL neoprene arm sleeves"
msgid_plural "pairs of XL neoprene arm sleeves"
msgstr[0] "par de mangas de neopreno XL"
msgstr[1] "pares de mangas de neopreno XL"

#. ~ Description for pair of XL neoprene arm sleeves
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of extra large soft neoprene arm sleeves.  Often used in contact "
"sports, by giants."
msgstr ""
"Un par de mangas extra grandes y suaves de neopreno. A menudo utilizadas en "
"los deportes de contacto, por gigantes."

#: lang/json/ARMOR_from_json.py
msgid "pair of chainmail sleeves"
msgid_plural "pairs of chainmail sleeves"
msgstr[0] "par de mangas de cota de malla"
msgstr[1] "pares de mangas de cota de malla"

#. ~ Description for pair of chainmail sleeves
#: lang/json/ARMOR_from_json.py
msgid ""
"Customized chainmail arms.  Each sleeve has straps to connect them with each"
" other.  The lack of fingers makes them less cumbersome and allows them to "
"be used with gloves."
msgstr ""
"Mangas de cota de malla personalizadas. Cada manga tiene correas para "
"sujetarlas. No cubren tus dedos así que no son muy incómodas y te permiten "
"usar guantes"

#: lang/json/ARMOR_from_json.py
msgid "pair of XL chainmail sleeves"
msgid_plural "pairs of XL chainmail sleeves"
msgstr[0] "par de mangas de cota de malla XL"
msgstr[1] "pares de mangas de cota de malla XL"

#. ~ Description for pair of XL chainmail sleeves
#: lang/json/ARMOR_from_json.py
msgid ""
"Customized chainmail arms.  Each sleeve has straps to connect them with each"
" other.  The lack of fingers makes them less cumbersome and allows them to "
"be used with gloves.  These are oversized."
msgstr ""
"Mangas de cota de malla personalizadas. Cada manga tiene correas para "
"sujetarlas. No cubre tus dedos así que no son muy incómodas y te permiten "
"usar guantes.  Estos son de gran tamaño."

#: lang/json/ARMOR_from_json.py
msgid "pair of elbow pads"
msgid_plural "pairs of elbow pads"
msgstr[0] "par de coderas acolchadas"
msgstr[1] "pares de coderas acolchadas"

#. ~ Description for pair of elbow pads
#: lang/json/ARMOR_from_json.py
msgid "A pair of elbow pads made of stout plastic and cloth."
msgstr "Un par de coderas hechas de plástico grueso y tela."

#: lang/json/ARMOR_from_json.py
msgid "pair of leather vambraces"
msgid_plural "pairs of leather vambraces"
msgstr[0] "par de brazales de cuero"
msgstr[1] "pares de brazales de cuero"

#. ~ Description for pair of leather vambraces
#: lang/json/ARMOR_from_json.py
msgid "A pair of light leather arm guards, made for archery."
msgstr ""
"Un par de guardabrazos ligeros de cuero para los brazos, hechos para el tiro"
" con arco."

#: lang/json/ARMOR_from_json.py
msgid "pair of XL leather vambraces"
msgid_plural "pairs of XL leather vambraces"
msgstr[0] "par de brazales de cuero XL"
msgstr[1] "pares de brazales de cuero XL"

#. ~ Description for pair of XL leather vambraces
#: lang/json/ARMOR_from_json.py
msgid "Customized oversized leather vambraces, made for archery."
msgstr ""
"Brazales de cuero de gran tamaño personalizados, hechos para el tiro con "
"arco."

#: lang/json/ARMOR_from_json.py
msgid "pair of cut-resistant arm sleeves"
msgid_plural "pairs of cut-resistant arm sleeves"
msgstr[0] "par de mangas resistentes a cortes"
msgstr[1] "pares de mangas resistentes a cortes"

#. ~ Description for pair of cut-resistant arm sleeves
#: lang/json/ARMOR_from_json.py
msgid ""
"A long pair of cut resistant sleeves, with thumbholes.  Useful for chainsaw "
"protection."
msgstr ""
"Un par de mangas largas resistentes a los cortes, con agujeros para los "
"pulgares. Son útiles como protección al usar motosierras."

#: lang/json/ARMOR_from_json.py
msgid "empty ballistic vest"
msgid_plural "empty ballistic vests"
msgstr[0] "chaleco balístico vacío"
msgstr[1] "chalecos balísticos vacíos"

#. ~ Description for empty ballistic vest
#: lang/json/ARMOR_from_json.py
msgid ""
"Ballistic armor without any armor inserts.  The soft armor plate carrier is "
"still protective but it won't stop high energy projectiles."
msgstr ""
"Armadura balística sin ningún tipo de inserción de armadura. El portaplacas "
"de blindaje blando sigue siendo protector, pero no detendrá los proyectiles "
"de alta energía."

#: lang/json/ARMOR_from_json.py
msgid "ESAPI ballistic vest"
msgid_plural "ESAPI ballistic vests"
msgstr[0] "Chaleco balístico ESAPI"
msgstr[1] "Chalecos balísticos ESAPI"

#. ~ Description for ESAPI ballistic vest
#: lang/json/ARMOR_from_json.py
msgid "Ballistic armor with ESAPI ceramic armor plates."
msgstr "Armadura balística con placas cerámicas ESAPI."

#: lang/json/ARMOR_from_json.py
msgid "dragon skin vest"
msgid_plural "dragon skin vests"
msgstr[0] "chaleco de piel de dragón"
msgstr[1] "chalecos de piel de dragón"

#. ~ Description for dragon skin vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A state-of-the-art, lightweight, flexible, bullet resistant vest.  The "
"ceramic disks used in its construction make it impossible to repair, only "
"replace."
msgstr ""
"Un chaleco de tecnología avanzada anti-balas, liviano y flexible. Los discos"
" cerámicos utilizados en su fabricación no se pueden reparar, solo "
"reemplazar."

#: lang/json/ARMOR_from_json.py
msgid "lamellar Kevlar vest"
msgid_plural "lamellar Kevlar vests"
msgstr[0] "chaleco de kevlar laminar"
msgstr[1] "chalecos de kevlar laminar"

#. ~ Description for lamellar Kevlar vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A lamellar Kevlar vest, there are intricately cut voids usually filled with "
"stitched in ceramic disks, you could repair the stitching if needed"
msgstr ""
"Un chaleco de kevlar laminar, hay vacíos específicos cortados usualmente "
"rellenados con discos de cerámica cosidos, podrías reparar las costuras si "
"fuera necesario."

#: lang/json/ARMOR_from_json.py
msgid "pistol bandolier"
msgid_plural "pistol bandoliers"
msgstr[0] "bandolera de pistola"
msgstr[1] "bandoleras de pistola"

#. ~ Description for pistol bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"An embroidered leather bandolier for keeping pistol cartridges close to "
"hand.  If this doesn't make you feel like a cowboy, nothing will."
msgstr ""
"Una bandolera de cuero bordado para tener los cartuchos de pistolas a mano. "
"Si esto no te hace sentir como un vaquero, nada lo hará."

#: lang/json/ARMOR_from_json.py
msgid "rifle bandolier"
msgid_plural "rifle bandoliers"
msgstr[0] "bandolera de rifle"
msgstr[1] "bandoleras de rifle"

#. ~ Description for rifle bandolier
#: lang/json/ARMOR_from_json.py
msgid "A leather bandolier for keeping rifle cartridges close to hand."
msgstr "Una bandolera de cuero para tener a mano cartuchos de rifle."

#: lang/json/ARMOR_from_json.py
msgid "waist shotgun bandolier"
msgid_plural "waist shotgun bandoliers"
msgstr[0] "bandolera de cintura para escopeta"
msgstr[1] "bandoleras de cintura para escopeta"

#. ~ Description for waist shotgun bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather bandolier worn around the waist for keeping shotgun shells close "
"to hand."
msgstr ""
"Una bandolera de cuero que se lleva alrededor de la cintura para tener los "
"cartuchos de las escopetas a mano."

#: lang/json/ARMOR_from_json.py
msgid "torso grenade bandolier"
msgid_plural "torso grenade bandoliers"
msgstr[0] "bandolera de granada para el torso"
msgstr[1] "bandoleras de granada para el torso"

#. ~ Description for torso grenade bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather bandolier strapped around the torso for keeping 40mm grenades "
"close to hand.  For some reason, wearing this makes you feel Austrian."
msgstr ""
"Una bandolera de cuero atada alrededor del torso para mantener las granadas "
"de 40 mm a mano. Por alguna razón, llevar esto te hace sentirte austriaco."

#: lang/json/ARMOR_from_json.py
msgid "torso shotgun bandolier"
msgid_plural "torso shotgun bandoliers"
msgstr[0] "bandolera de escopeta para el torso"
msgstr[1] "bandoleras de escopeta para el torso"

#. ~ Description for torso shotgun bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather bandolier strapped around the torso for keeping shotgun shells "
"close to hand."
msgstr ""
"Una bandolera de cuero atada alrededor del torso para mantener los cartuchos"
" de las escopeta a mano."

#: lang/json/ARMOR_from_json.py
msgid "paper cartridge pouch"
msgid_plural "paper cartridge pouches"
msgstr[0] "cartuchera para cartuchos de papel"
msgstr[1] "cartucheras para cartuchos de papel"

#. ~ Description for paper cartridge pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A covered leather pouch, worn at the waist to store and protect prepared "
"blackpowder cartridges."
msgstr ""
"Una bolsa de cuero cubierto, usada en la cintura para guardar y proteger los"
" cartuchos preparados de pólvora negra."

#: lang/json/ARMOR_from_json.py
msgid "wrist bandolier"
msgid_plural "wrist bandoliers"
msgstr[0] "bandolera de muñeca"
msgstr[1] "bandoleras de muñeca"

#. ~ Description for wrist bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"A small fabric bandolier for rifle cartridges designed to be worn around the"
" wrist."
msgstr ""
"Una bandolera pequeña de tela para cartuchos de rifle, diseñada para ponerse"
" en la muñeca."

#: lang/json/ARMOR_from_json.py
msgid "grenade pouch"
msgid_plural "grenade pouches"
msgstr[0] "cartuchera para granadas"
msgstr[1] "cartucheras para granadas"

#. ~ Description for grenade pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A small pouch for storing cartridge grenades with straps for attaching it to"
" your belt or other webbing."
msgstr ""
"Un pequeño bolso para guardar cartuchos de granada con correas para "
"engancharlo a tu cinturón o alguna otra correa."

#: lang/json/ARMOR_from_json.py
msgid "stone pouch"
msgid_plural "stone pouches"
msgstr[0] "bolsa de piedras"
msgstr[1] "bolsas de piedras"

#. ~ Description for stone pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A medium-sized pouch for storing rocks, with straps for attaching it to your"
" belt or other webbing."
msgstr ""
"Una bolsa de tamaño medio para almacenar piedras, con correas para sujetarla"
" al cinturón o a otras correas."

#: lang/json/ARMOR_from_json.py
msgid "large grenade pouch"
msgid_plural "large grenade pouches"
msgstr[0] "bolsa de granadas grandes"
msgstr[1] "bolsas de granadas grandes"

#. ~ Use action holster_prompt for large grenade pouch.
#: lang/json/ARMOR_from_json.py
msgid "Stash grenades"
msgstr "Almacenar granadas"

#. ~ Description for large grenade pouch
#: lang/json/ARMOR_from_json.py
msgid "A pouch for holding up to four full-sized grenades of various types."
msgstr "Un bolso que puede llevar hasta cuatro granadas de diferentes tipos."

