#: lang/json/TOOL_ARMOR_from_json.py
msgid "shooter's earmuffs"
msgid_plural "shooter's earmuffs"
msgstr[0] "orejeras para tirador"
msgstr[1] "orejeras para tirador"

#. ~ Use action msg for {'str_sp': "shooter's earmuffs"}.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You turn the earmuffs on."
msgstr "Enciendes las orejeras."

#. ~ Use action need_charges_msg for {'str_sp': "shooter's earmuffs"}.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "The earmuff's batteries are dead."
msgstr "Las batería de las orejeras está descargada."

#. ~ Description for {'str_sp': "shooter's earmuffs"}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A pair of earmuffs favored by shooters.  Without batteries or when turned "
"off they function like normal earmuffs and block all sound.  They will block"
" sounds over a certain decibel amount when turned on.  The earmuffs are "
"currently off."
msgstr ""
"Un par de orejeras preferidas por los tiradores. Sin baterías o cuando están"
" apagadas funcionan como las orejeras normales y bloquean todo el sonido. "
"Bloquearán los sonidos por encima de una cierta cantidad de decibelios "
"cuando se encienden. Las orejeras están actualmente apagadas."

#. ~ Description for {'str_sp': "shooter's earmuffs"}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A pair of earmuffs favored by shooters.  The earmuffs are turned on.  They "
"will block sounds over a certain decibel amount, assuming it is charged with"
" batteries."
msgstr ""
"Es un par de orejeras que utilizan los tiradores. Están encendidas. Bloquean"
" los sonidos que sobrepasan una cierta cantidad de decibeles, asumiendo que "
"tiene batería."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "stethoscope"
msgid_plural "stethoscopes"
msgstr[0] "estetoscopio"
msgstr[1] "estetoscopios"

#. ~ Description for stethoscope
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a medical listening tool.  Use it to listen to things.  Closely."
msgstr ""
"Es una herramienta médica para oir. Usalo para escuchar cosas. Más de cerca."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "makeshift stethoscope"
msgid_plural "makeshift stethoscopes"
msgstr[0] "estetoscopio improvisado"
msgstr[1] "estetoscopios improvisados"

#. ~ Description for makeshift stethoscope
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a relatively cumbersome DIY child's medical listening toy.  Use it "
"to listen to things.  Closely."
msgstr ""
"Este es un juguete de escucha médica para niños de bricolaje relativamente "
"engorroso. Úsalo para escuchar cosas. De cerca."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "solar backpack (folded)"
msgid_plural "solar backpacks (folded)"
msgstr[0] "mochila solar (plegada)"
msgstr[1] "mochilas solares (plegadas)"

#. ~ Description for solar backpack (folded)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"Personal portable charging system consisting of an array of solar panels "
"neatly folded in a form of a large backpack.  It can be worn as one, and has"
" an integrated cable to plug it into a cable charger system CBM."
msgstr ""
"Sistema de carga portátil personal que consiste en una serie de paneles "
"solares perfectamente plegados en forma de una mochila grande. Se puede "
"llevar como uno solo, y tiene un cable integrado para conectarlo a un "
"sistema de cargador de cable MCB."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "solar backpack (unfolded)"
msgid_plural "solar backpacks (unfolded)"
msgstr[0] "mochila solar (desplegada)"
msgstr[1] "mochilas solares (desplegadas)"

#. ~ Description for solar backpack (unfolded)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"Unfolded array of portable solar panels ready to push some power into an "
"active cable charger system CBM."
msgstr ""
"Varios paneles solares portátiles desplegados, listos para generar enegía "
"para algún sistema de recarga."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "riot helmet"
msgid_plural "riot helmets"
msgstr[0] "casco antidisturbios"
msgstr[1] "cascos antidisturbios"

#. ~ Description for riot helmet
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A helmet with a plastic shield that covers your entire face.  Activate to "
"raise the face shield."
msgstr ""
"Es un casco con una protección plástica que cubre la cara entera. Hay que "
"usarlo para levantar el visor protector."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "riot helmet (raised visor)"
msgid_plural "riot helmets (raised visor)"
msgstr[0] "casco antidisturbio (visor levantado)"
msgstr[1] "cascos antidisturbio (visor levantado)"

#. ~ Description for riot helmet (raised visor)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A riot helmet with a plastic face shield which is raised up.  Activate to "
"lower the shield."
msgstr ""
"Un casco antimotines con una pantalla de plástico que se levanta. Activalo "
"para bajar el escudo."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "scuba tank"
msgid_plural "scuba tanks"
msgstr[0] "tanque de buceo"
msgstr[1] "tanques de buceo"

#. ~ Description for scuba tank
#. ~ Description for scuba tank (on)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a high-pressure 232 bar diving tank that can contain up to 12L of "
"compressed mixture of oxygen and nitrogen.  It is equipped with an on-demand"
" regulator and a mouthpiece designed mostly for underwater use."
msgstr ""
"Se trata de un tanque de buceo de alta presión de 232 bares que puede "
"contener hasta 12L de mezcla comprimida de oxígeno y nitrógeno. Está "
"equipado con un regulador a demanda y una boquilla diseñada principalmente "
"para su uso bajo el agua."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "scuba tank (on)"
msgid_plural "scuba tanks (on)"
msgstr[0] "tanque de buceo (encendido)"
msgstr[1] "tanques de buceo (encendidos)"

#: lang/json/TOOL_ARMOR_from_json.py
msgid "small scuba tank"
msgid_plural "small scuba tanks"
msgstr[0] "tanque de buceo pequeño"
msgstr[1] "tanques de buceo pequeños"

#. ~ Description for small scuba tank
#. ~ Description for small scuba tank (on)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a small high-pressure 200 bar backup diving tank, that can contain "
"4L of compressed mixture of oxygen and nitrogen.  It is equipped with an on-"
"demand regulator and a mouthpiece designed mostly for underwater use."
msgstr ""
"Este es un pequeño tanque de buceo de alta presión de 200 bares de reserva, "
"que puede contener 4L de mezcla comprimida de oxígeno y nitrógeno. Está "
"equipado con un regulador a demanda y una boquilla diseñada principalmente "
"para su uso bajo el agua."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "small scuba tank (on)"
msgid_plural "small scuba tanks (on)"
msgstr[0] "tanque de buceo pequeño (encendido)"
msgstr[1] "tanques de buceo pequeños (encendidos)"

#: lang/json/TOOL_ARMOR_from_json.py
msgid "electric blanket"
msgid_plural "electric blankets"
msgstr[0] "manta eléctrica"
msgstr[1] "mantas eléctricas"

#. ~ Use action msg for electric blanket.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You turn the blanket's heating elements on."
msgstr "Encendiste la manta eléctrica."

#. ~ Use action need_charges_msg for electric blanket.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "The blanket's batteries are dead."
msgstr "La batería de la manta eléctrica está descargada."

#. ~ Description for electric blanket
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A heated blanket made of polyester.  The most comfortable thing on Earth.  "
"Its cost is usually negligible, but with the power out, it chews through "
"batteries insanely quickly."
msgstr ""
"Una manta calefactora de poliéster. La cosa más cómoda de la Tierra. Su "
"costo es usualmente insignificante, pero con la falta de energía, mastica "
"las baterías con una rapidez increíble."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "electric blanket (on)"
msgid_plural "electric blankets (on)"
msgstr[0] "manta eléctrica (encendida)"
msgstr[1] "mantas eléctricas (encendidas)"

#. ~ Use action msg for electric blanket (on).
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You turn the blanket's heating elements off."
msgstr "Apaga los elementos calefactores de la manta."

#. ~ Description for electric blanket (on)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A heated blanket made of polyster.  It's turned on, making it nice and "
"toasty while it lasts."
msgstr ""
"Una manta calefactora hecha de poliéster. Está encendida, lo que la hace "
"agradable y calentita mientras dure."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "Foodperson mask"
msgid_plural "Foodperson masks"
msgstr[0] "Máscara Personacomida"
msgstr[1] "Máscaras Personacomida"

#. ~ Use action msg for Foodperson mask.
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"Your HUD lights-up: \"Greetings Foodperson, your shift begins now.  Good "
"luck!\""
msgstr ""
"Tu HUD se enciende: \"Saludos, comensal, tu turno comienza ahora. ¡Buena "
"suerte!\""

#. ~ Use action need_charges_msg for Foodperson mask.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "The mask's batteries are dead."
msgstr "La batería de la máscara está descargada."

#. ~ Description for Foodperson mask
#: lang/json/TOOL_ARMOR_from_json.py
msgid "Foodperson, the mascot your stomach deserves!"
msgstr "PersonaComida, la mascota que tu estómago se merece!"

#: lang/json/TOOL_ARMOR_from_json.py
msgid "Foodperson mask (on)"
msgid_plural "Foodperson masks (on)"
msgstr[0] "Máscara Personacomida (encendida)"
msgstr[1] "Máscaras Personacomida (encendidas)"

#: lang/json/TOOL_ARMOR_from_json.py
msgid "military flight helmet"
msgid_plural "military flight helmets"
msgstr[0] "casco de vuelo militar"
msgstr[1] "cascos de vuelo militar"

#. ~ Use action msg for military flight helmet.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You turn the flight helmet on."
msgstr "Enciende el casco de vuelo."

#. ~ Description for military flight helmet
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A military flight helmet.  Adorned with a visor, microphone and a noise "
"dampening system.  The helmet is also fitted with plastic rails to allow for"
" different load-outs."
msgstr ""
"Un casco de vuelo militar. Adornado con una visera, un micrófono y un "
"sistema de amortiguación del ruido. El casco también está provisto de raíles"
" de plástico para permitir diferentes equipamientos extras."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "FB51 optical cloak"
msgid_plural "FB51 optical cloaks"
msgstr[0] "capa óptica FB51"
msgstr[1] "capas ópticas FB51"

#. ~ Use action msg for FB51 optical cloak.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "Your optical cloak flickers as it becomes transparent."
msgstr "Tu capa óptica parpadea a medida que se va haciendo transparente."

#. ~ Use action need_charges_msg for FB51 optical cloak.
#: lang/json/TOOL_ARMOR_from_json.py
#, no-python-format
msgid "You don't have enough UPS charges to turn on the %s"
msgstr "No tienes suficientes cargas SAI para encender el %s"

#. ~ Description for FB51 optical cloak
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A plastic cloak embedded with cameras and LEDs that will render you fully "
"invisible to normal vision when powered and worn.  You must be carrying a "
"unified power supply, or UPS, to use it.  Activate to toggle visibility."
msgstr ""
"Una capa plástica recubierta de cámaras y LEDs que te vuelven completamente "
"invisible a la vista normal cuando la tienes puesta y está encendida. Vas a "
"necesitar tener un UPS para usarla. Actívala para hacerte invisible."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "FB51 optical cloak (on)"
msgid_plural "FB51 optical cloaks (on)"
msgstr[0] "capa óptica FB51 (encendida)"
msgstr[1] "capas ópticas FB51 (encendida)"

#. ~ Use action msg for FB51 optical cloak (on).
#: lang/json/TOOL_ARMOR_from_json.py
#, no-python-format
msgid "The %s flickers for a moment as it becomes opaque."
msgstr "El %s parpadea por un momento y se vuelve opaco."

#. ~ Description for FB51 optical cloak (on)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A plastic cloak embedded with cameras and LEDs that will render you fully "
"invisible to normal vision when powered and worn.  It is turned on, and "
"continually draining power from an UPS.  Use it to turn it off."
msgstr ""
"Una capa de plástico recubierta de cámaras y LEDs que te vuelven "
"completamente invisible a la vista normal cuando la tienes puesta y está "
"encendia. Está encendida y consumiendo energía de una SAI. Usar para apagar."

#: lang/json/TOOL_ARMOR_from_json.py
