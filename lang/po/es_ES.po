#: lang/json/snippet_from_json.py
msgid "Get off."
msgstr "Bájate."

#: lang/json/snippet_from_json.py
msgid "Get the fuck out of here."
msgstr "Lárgate de una puta vez de aquí."

#: lang/json/snippet_from_json.py
msgid "Get the fuck outta here."
msgstr "Vete de una puta vez de aqui."

#: lang/json/snippet_from_json.py
msgid "Go bug someone else."
msgstr "Vete a molestar a otra parte."

#: lang/json/snippet_from_json.py
msgid "Begone!"
msgstr "¡Lárgate!"

#: lang/json/snippet_from_json.py
msgid "Begone from my sight!"
msgstr "¡Sal de mi vista!"

#: lang/json/snippet_from_json.py
msgid "Scat!"
msgstr "¡Mierda!"

#: lang/json/snippet_from_json.py
msgid "I hate thorazine!"
msgstr "¡Odio la torazina!"

#: lang/json/snippet_from_json.py
msgid "Arg thorazine, don't touch it!"
msgstr "Aaaaah torazina, ¡no la toques!"

#: lang/json/snippet_from_json.py
msgid "Thorazine is bad for you, you know."
msgstr "La torazina es mala para ti, sabes."

#: lang/json/snippet_from_json.py
msgid "Thorazine is poison."
msgstr "La torazina es un veneno."

#: lang/json/snippet_from_json.py
msgid "Thorazine?  I wouldn't if I were you."
msgstr "¿Clorpromazina? No lo haría si fuera tu."

#: lang/json/snippet_from_json.py
msgid "You don't need thorazine, it's limiting you."
msgstr "No necesitas la torazina, te está limitando."

#: lang/json/snippet_from_json.py
msgid "Thorazine…  That's what 'they' use to keep you tame."
msgstr "Torazina... Eso es lo que \"ellos\" usaban para mantenerte manso."

#: lang/json/snippet_from_json.py
msgid ""
"Don't.  This thorazine seriously clouds your mind.  You need to stay sharp."
msgstr ""
"No lo hagas. Esta torazina nubla seriamente tu mente. Necesitas estar "
"alerta."

#: lang/json/snippet_from_json.py
msgid ""
"Sure, take thorazine.  If you want to lose your mind and wander into a horde"
" of undead!"
msgstr ""
"Claro, toma una Clorpromazina. ¡Si quieres volverte loco y vagar hacia una "
"horda de zombis!"

#: lang/json/snippet_from_json.py
msgid "Pink tablets!  I love those!"
msgstr "¡Pastillas rosas! ¡Me encantan!"

#: lang/json/snippet_from_json.py
msgid "Hey there's some pink tablets, take some!"
msgstr "Hey, hay algunas pastillas rosas, ¡toma algunas!"

#: lang/json/snippet_from_json.py
msgid "Look, some LSD, let's play Cataclysm: fun times ahead!"
msgstr ""
"Mira, algo de LSD, juguemos a Cataclysm: ¡Tiempos de diversión por delante!"

#: lang/json/snippet_from_json.py
msgid "Say yes to LSD, say yes to Fun!"
msgstr "¡Dile sí al LSD, dile sí a la diversión!"

#: lang/json/snippet_from_json.py
msgid "Perfect, those pink tablets will keep us going, take some!"
msgstr ""
"Perfecto, esas pastillas rosas nos van a mantener en movimiento, ¡Tómate "
"algunas!"

#: lang/json/snippet_from_json.py
msgid "You know what would make all this more bearable?  Pink Tablets!"
msgstr "¿Sabes qué haría todo esto más soportable? ¡Las pastillas rosas!"

#: lang/json/snippet_from_json.py
msgid "An odd pink tablet from the ground?  I don't see why not!"
msgstr "¿Una extraña pastilla rosa del suelo? ¡No veo por qué no!"

#: lang/json/snippet_from_json.py
msgid "Finally, something to take the edge off."
msgstr "Por último, algo para matar el gusanillo."

#: lang/json/snippet_from_json.py src/talker_npc.cpp
msgid "No thanks, I'm good."
msgstr "No gracias, estoy bien."

#: lang/json/snippet_from_json.py
msgid "I don't want to trade with you."
msgstr "No quiero comerciar contigo."

#: lang/json/snippet_from_json.py
msgid "I have the best stuff.  And I'm keeping it!"
msgstr "Tengo lo mejor. ¡Y me lo quedo!"

#: lang/json/snippet_from_json.py
msgid "No trading, that's my rule."
msgstr "Nada de intercambios, esa es mi regla."

#: lang/json/snippet_from_json.py
msgid "I'm not interested."
msgstr "No me interesa."

#: lang/json/snippet_from_json.py
msgid "How about no?"
msgstr "¿Qué tal si no?"

#: lang/json/snippet_from_json.py
msgid "I'm sorry <name_g>. I'm afraid I can't do that."
msgstr "Lo siento <name_g>. Me temo que no puedo hacerlo."

#: lang/json/snippet_from_json.py
msgid "Wish I could, <name_g>."
msgstr "Ojala pudiera, <name_g>."

#: lang/json/snippet_from_json.py
msgid "Nothing to trade, sorry <name_g>."
msgstr "Nada que comerciar, lo siento <name_g>."

#: lang/json/snippet_from_json.py
msgid "I don't want to trade right now."
msgstr ""

#: lang/json/snippet_from_json.py
msgid "Maybe next time?"
msgstr "¿Quizas la próxima vez?"

#: lang/json/snippet_from_json.py
msgid "No thanks, I really don't feel like it."
msgstr "No gracias, no tengo ganas."

#: lang/json/snippet_from_json.py
msgid "Well, I would, but I don't want to right now."
msgstr "Bueno, lo haría, pero no quiero hacerlo ahora mismo."

#: lang/json/snippet_from_json.py
msgid "I have better things to do."
msgstr "Tengo mejores cosas que hacer."

#: lang/json/snippet_from_json.py
msgid "I'll pass; it's too much work."
msgstr "Paso, demasiado trabajo."

#: lang/json/snippet_from_json.py
msgid "Who put you in charge of what I do?"
msgstr "¿Quién te puso a cargo de lo que hago?"

#: lang/json/snippet_from_json.py
msgid "Great idea!  Call me when you find SOMEONE ELSE to do it."
msgstr "¡Gran idea! Llámame cuando encuentres a ALGUIEN MÁS para hacerlo."

#: lang/json/snippet_from_json.py
msgid "I'm afraid I can't help you there."
msgstr "Me temo que no puedo ayudarte con eso."

#: lang/json/snippet_from_json.py
msgid "Not exactly the settlin' type."
msgstr "No exactamente el tipo que se asienta."

#: lang/json/snippet_from_json.py
msgid "I can't help you with that right now."
msgstr ""

#: lang/json/snippet_from_json.py
msgid "I'm more of a free spirit, can't settle, sorry."
msgstr "Soy más bien un espíritu libre, no puedo apalancarme, lo siento."

