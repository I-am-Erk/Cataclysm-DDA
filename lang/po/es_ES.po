msgid "Clean gun"
msgstr "Limpiar arma"

#. ~ name of mending method for fault '{'str': 'Fouling'}'
#: lang/json/fault_from_json.py
msgid "Clean gun and lubricate"
msgstr "Limpiar alma y lubricar"

