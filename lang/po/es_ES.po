#: lang/json/TOOL_from_json.py
msgid "finger firelighter"
msgid_plural "finger firelighters"
msgstr[0] "dedo encendedor"
msgstr[1] "dedos encendedores"

#. ~ Description for finger firelighter
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small flame you can hold in your hand.  With a thought, you can "
"cause it to light something on fire."
msgstr ""
"Esta es una pequeña llama que puedes sostener en tu mano. Con un "
"pensamiento, puedes hacer que encienda algo en el fuego."

#: lang/json/TOOL_from_json.py
msgid "seed of purification"
msgid_plural "seeds of purification"
msgstr[0] "semilla de purificación"
msgstr[1] "semillas de purificación"

#. ~ Use action menu_text for seed of purification.
#: lang/json/TOOL_from_json.py
msgid "Squeeze seed"
msgstr "Exprime la semilla"

#. ~ Use action msg for seed of purification.
#: lang/json/TOOL_from_json.py
msgid ""
"You squeeze the seed in your palm, and it begins to turn to a fine dust."
msgstr ""
"Aprietas la semilla en la palma de tu mano, y comienza a convertirse en un "
"fino polvo."

#. ~ Description for seed of purification
#: lang/json/TOOL_from_json.py
msgid ""
"A magical seed that can be squeezed to release purifying dust, which can "
"then be used to purify up to a gallon of water"
msgstr ""
"Una semilla mágica que puede ser exprimida para liberar polvo purificador, "
"que puede ser usado para purificar hasta un galón de agua."

#: lang/json/TOOL_from_json.py
msgid "faintly glowing dust"
msgid_plural "faintly glowing dusts"
msgstr[0] "polvo ligeramente brillante"
msgstr[1] "polvos ligeramente brillantes"

#. ~ Description for faintly glowing dust
#: lang/json/TOOL_from_json.py
msgid "This fine dust glows with a growing intensity"
msgstr "Este polvo fino brilla con una intensidad creciente"

#: lang/json/TOOL_from_json.py
msgid "orichalcum combat knife"
msgid_plural "orichalcum combat knives"
msgstr[0] "cuchillo de combate de oricalco"
msgstr[1] "cuchillos de combate de oricalco"

#. ~ Description for orichalcum combat knife
#: lang/json/TOOL_from_json.py
msgid ""
"A variant of the combat knife that is made of orichalcum instead of steel.  "
"Sharper and easier to maintain than steel while just as dense, this knife "
"also has a thinner blade, which shaves off some weight."
msgstr ""
"Una variante del cuchillo de combate que está hecha de oricalco en lugar de "
"acero. Más afilado y fácil de mantener que el acero, aunque igual de denso, "
"este cuchillo también tiene una hoja más delgada, lo que ahorra algo de "
"peso."

#: lang/json/TOOL_from_json.py
msgid "orichalcum longsword"
msgid_plural "orichalcum longswords"
msgstr[0] "espada larga de oricalco"
msgstr[1] "espadas largas de oricalco"

#. ~ Description for orichalcum longsword
#: lang/json/TOOL_from_json.py
msgid ""
"A variant of the longsword that is made of orichalcum instead of steel.  "
"Sharper and easier to maintain than steel while just as dense, this "
"longsword also has a thinner blade, which shaves off some weight."
msgstr ""
"Una variante de la espada larga hecha de oricalco en lugar de acero. Más "
"afilada y fácil de mantener que el acero, aunque igual de densa, esta espada"
" larga también tiene una hoja más fina, lo que ahorra algo de peso."

#: lang/json/TOOL_from_json.py
msgid "orichalcum fire axe"
msgid_plural "orichalcum fire axes"
msgstr[0] "hacha de fuego oricalco"
msgstr[1] "hachas de fuego oricalco"

#. ~ Description for orichalcum fire axe
#: lang/json/TOOL_from_json.py
msgid ""
"A fire axe made with orichalcum instead of steel.  This makes it possible to"
" chop through harder materials, and in the very well-funded fire stations is"
" preferred."
msgstr ""
"Un hacha de fuego hecha con oricalco en lugar de acero. Esto permite cortar "
"materiales más duros, y en los parques de bomberos muy bien dotados se "
"prefiere."

#: lang/json/TOOL_from_json.py
msgid "wand of fireballs"
msgid_plural "wands of fireballs"
msgstr[0] "varita de bolas de fuego"
msgstr[1] "varitas de bolas de fuego"

#. ~ Description for wand of fireballs
#: lang/json/TOOL_from_json.py
msgid ""
"A classic, this wand shoots fireballs without fail.  A more skilled "
"Kelvinist could cast them more efficiently, though."
msgstr ""
"Un clásico, esta varita dispara bolas de fuego sin fallar. Sin embargo, un "
"kelvinista más hábil podría lanzarlas más eficientemente."

#: lang/json/TOOL_from_json.py
msgid "wand of magic missiles"
msgid_plural "wands of magic missiles"
msgstr[0] "varita de misiles mágicos"
msgstr[1] "varitas de misiles mágicos"

#. ~ Description for wand of magic missiles
#: lang/json/TOOL_from_json.py
msgid ""
"A classic, this wand shoots magic missiles without fail.  A more skilled "
"Magus could cast them more efficiently, though."
msgstr ""
"Un clásico, esta varita dispara misiles mágicos sin fallar. Sin embargo, un "
"mago más hábil podría lanzarlos de manera más eficiente."

#: lang/json/TOOL_from_json.py lang/json/furniture_from_json.py
msgid "demon forge"
msgid_plural "demon forges"
msgstr[0] "forja de demonio"
msgstr[1] "forjas de demonio"

#. ~ Description for demon forge
#: lang/json/TOOL_from_json.py
msgid ""
"This is a portable version of the charcoal forge that is magically enhanced "
"and fortified with demon spider chitin in order to be able to resmelt "
"magical metals into their workable ingot form."
msgstr ""
"Esta es una versión portátil de la fragua de carbón vegetal que está "
"mejorada mágicamente y fortificada con quitina de araña demoníaca para poder"
" refundir metales mágicos en forma de lingote."

#: lang/json/TOOL_from_json.py
msgid "glassteel shard"
msgid_plural "glassteel shards"
msgstr[0] "fragmento de cristal de acero"
msgstr[1] "fragmentos de cristal de acero"

#. ~ Description for glassteel shard
#: lang/json/TOOL_from_json.py
msgid ""
"A broken shard of glassteel covered in sharp edges.  You could use it as a "
"weapon, but you might want to wear gloves."
msgstr ""
"Un fragmento roto de cristal de acero cubierto de bordes afilados. Podrías "
"usarlo como arma, pero quizá quieras usar guantes."

#: lang/json/TOOL_from_json.py
msgid "rock candy chunk"
msgid_plural "rock candy chunks"
msgstr[0] "trozo de caramelo piedra"
msgstr[1] "trozos de caramelo piedra"

#. ~ Description for rock candy chunk
#: lang/json/TOOL_from_json.py
msgid "This is a chunk of hard rock candy.  It can be broken down into sugar."
msgstr ""
"Este es un trozo de caramelo de roca dura. Se puede descomponer en azúcar."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "yoke and harness"
msgid_plural "yokes and harnesses"
msgstr[0] "yugo y arnés"
msgstr[1] "yugos y arneses"

#. ~ Description for yoke and harness
#: lang/json/WHEEL_from_json.py
msgid ""
"A bar and harness to attach a creature to a wheeled vehicle, they then "
"should be able to pull it."
msgstr ""
"Una barra y un arnés para sujetar a una criatura a un vehículo con ruedas, "
"entonces deberían ser capaces de tirar de él."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "wheel"
msgid_plural "wheels"
msgstr[0] "rueda"
msgstr[1] "ruedas"

#. ~ Description for wheel
#: lang/json/WHEEL_from_json.py
msgid "A car wheel."
msgstr "Una rueda de coche."

#: lang/json/WHEEL_from_json.py
msgid "racing wheel"
msgid_plural "racing wheels"
msgstr[0] "rueda de carreras"
msgstr[1] "ruedas de carreras"

#. ~ Description for racing wheel
#: lang/json/WHEEL_from_json.py
msgid ""
"A wide, smooth wheel intended for racing.  The slick surface provides better"
" speed on pavement but penalizes off-road speed."
msgstr ""
"Una rueda lisa y ancha, diseñada para carreras. La superficie resbaladiza "
"brinda mayor velocidad en el pavimento pero menor en otros terrenos."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "armored wheel"
msgid_plural "armored wheels"
msgstr[0] "rueda blindada"
msgstr[1] "ruedas blindadas"

#. ~ Description for armored wheel
#: lang/json/WHEEL_from_json.py
msgid "A wide military grade wheel."
msgstr "Una rueda ancha de grado militar."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "wheelbarrow wheel"
msgid_plural "wheelbarrow wheels"
msgstr[0] "rueda de carretilla"
msgstr[1] "ruedas de carretilla"

#. ~ Description for wheelbarrow wheel
#: lang/json/WHEEL_from_json.py
msgid "A small wheel from a common garden wheelbarrow."
msgstr "Una rueda pequeña como la de una carretilla normal de jardinería."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "bicycle wheel"
msgid_plural "bicycle wheels"
msgstr[0] "rueda de bicicleta"
msgstr[1] "ruedas de bicicleta"

#. ~ Description for bicycle wheel
#: lang/json/WHEEL_from_json.py
msgid "A bicycle wheel."
msgstr "Una rueda de bicicleta."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
#: lang/json/vehicle_part_from_json.py
msgid "off-road bicycle wheel"
msgid_plural "off-road bicycle wheels"
msgstr[0] "rueda de bicicleta todoterreno"
msgstr[1] "ruedas de bicicleta todoterreno"

#. ~ Description for off-road bicycle wheel
#: lang/json/WHEEL_from_json.py
msgid "A wide, studded, bicycle wheel intended for off-road biking."
msgstr ""
"Una rueda de bicicleta ancha y tachonada destinada a la bicicleta todo "
"terreno."

#: lang/json/WHEEL_from_json.py
msgid "set of casters"
msgid_plural "sets of casters"
msgstr[0] "kit de rueditas"
msgstr[1] "kits de rueditas"

#. ~ Description for set of casters
#: lang/json/WHEEL_from_json.py
msgid "A set of casters, like on a shopping cart."
msgstr "Un juego de ruedas, como en un carrito de la compra."

#: lang/json/WHEEL_from_json.py
msgid "set of wheels"
msgid_plural "sets of wheels"
msgstr[0] "juego de ruedas"
msgstr[1] "juegos de ruedas"

#. ~ Description for set of wheels
#: lang/json/WHEEL_from_json.py
msgid "A set of four small wheels with tough rubber tires."
msgstr ""
"Un juego de cuatro pequeñas ruedas con neumáticos resistentes de goma."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "metal wheel"
msgid_plural "metal wheels"
msgstr[0] "rueda de metal"
msgstr[1] "ruedas de metal"

#. ~ Description for metal wheel
#: lang/json/WHEEL_from_json.py
msgid "A simple metal wheel."
msgstr "Un sencilla rueda de metal."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "rail wheel"
msgid_plural "rail wheels"
msgstr[0] "rueda de raíl"
msgstr[1] "ruedas de railes"

#. ~ Description for rail wheel
#: lang/json/WHEEL_from_json.py
msgid ""
"A strong rail wheel.  A flange helps keep it on a rail, but makes it perform"
" terribly when not on a rail."
msgstr ""
"Una fuerte rueda de ferrocarril. Una pestaña ayuda a mantenerla en un riel, "
"pero hace que funcione terriblemente cuando no está en un riel."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "pair of small rail wheels"
msgid_plural "pairs of small rail wheels"
msgstr[0] "par de pequeñañ ruedas de rail"
msgstr[1] "pares de pequeñas ruedas de rail"

#. ~ Description for pair of small rail wheels
#: lang/json/WHEEL_from_json.py
msgid ""
"A pair of small rail wheels.  It fits small railroad rails found in places "
"like amusement parks.  Mostly for hobby purposes rather than transportation."
msgstr ""
"Un par de pequeñas ruedas de rieles. Se ajusta a los pequeños rieles de "
"ferrocarril que se encuentran en lugares como parques de diversiones. En su "
"mayoría para fines de hobby más que de transporte."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "motorbike wheel"
msgid_plural "motorbike wheels"
msgstr[0] "rueda de moto"
msgstr[1] "ruedas de moto"

#. ~ Description for motorbike wheel
#: lang/json/WHEEL_from_json.py
msgid "A motorbike wheel."
msgstr "Una rueda de moto."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
#: lang/json/vehicle_part_from_json.py
msgid "off-road motorbike wheel"
msgid_plural "off-road motorbike wheels"
msgstr[0] "rueda de moto todoterreno"
msgstr[1] "ruedas de moto todoterreno"

#. ~ Description for off-road motorbike wheel
#: lang/json/WHEEL_from_json.py
msgid "A motorbike wheel, studded for improved off-road performance."
msgstr ""
"Una rueda de motocicleta, tachonada para mejorar el rendimiento fuera de la "
"carretera."

#: lang/json/WHEEL_from_json.py
msgid "large steel drum"
msgid_plural "large steel drums"
msgstr[0] "tambor grande de acero"
msgstr[1] "bidón grande de acero"

#. ~ Description for large steel drum
#: lang/json/WHEEL_from_json.py
msgid ""
"A large cylinder fashioned out of thick plates of hardened steel, that is "
"normally found on road rollers.  Numerous massive spokes, attached to a "
"central axis, reinforce its structure even further, making it an unstoppable"
" force once it starts rolling."
msgstr ""
"Un cilindro grande hecho con placas gruesas de acero endurecido. Es de los "
"que tienen comúnmente las aplanadoras. Tiene varios rayos enormes conectados"
" al eje central, reforzando aún más la estructura, convirtiéndolo en una "
"fuerza indetenible una vez que empieza a girar."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "small wheel"
msgid_plural "small wheels"
msgstr[0] "rueda pequeña"
msgstr[1] "ruedas pequeñas"

#. ~ Description for small wheel
#: lang/json/WHEEL_from_json.py
msgid ""
"A pretty small wheel.  Probably from one of those Segway things.  It is not "
"very menacing."
msgstr ""
"Una rueda bastante pequeña. Probablemente, sea de uno de esos trasportadores"
" personales Segway. No es la gran cosa."

#: lang/json/WHEEL_from_json.py
msgid "skate wheel"
msgid_plural "skate wheels"
msgstr[0] "rueda de skate"
msgstr[1] "ruedas de skate"

#. ~ Description for skate wheel
#: lang/json/WHEEL_from_json.py
msgid ""
"A very small plastic wheel with a punk attitude.  This wheel was made for "
"skating."
msgstr ""
"Una rueda de plástico muy pequeña con una actitud punk. Esta rueda fue hecha"
" para hacer skating."

#: lang/json/WHEEL_from_json.py
msgid "set of tricycle wheels"
msgid_plural "sets of tricycle wheels"
msgstr[0] "juego de ruedas de triciclo"
msgstr[1] "juegos de ruedas de triciclo"

#. ~ Description for set of tricycle wheels
#: lang/json/WHEEL_from_json.py
msgid ""
"A set of hard plastic wheels with one larger than the other two.  Proudly "
"made in the USA by Double Dango Productions."
msgstr ""
"Un juego de ruedas de plástico duro con una más grande que las otras dos. "
"Orgullosamente fabricadas en los EE.UU. por Double Dango Productions."

#: lang/json/WHEEL_from_json.py
msgid "pair of wheelchair wheels"
msgid_plural "pairs of wheelchair wheels"
msgstr[0] "par de ruedas de silla de ruedas"
msgstr[1] "pares de ruedas de silla de ruedas"

#. ~ Description for pair of wheelchair wheels
#: lang/json/WHEEL_from_json.py
msgid "A pair of wheels for a wheelchair."
msgstr "Un par de ruedas de una silla de ruedas."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "wide wheel"
msgid_plural "wide wheels"
msgstr[0] "rueda ancha"
msgstr[1] "ruedas anchas"

#. ~ Description for wide wheel
#: lang/json/WHEEL_from_json.py
msgid "A wide wheel.  \\o/ This wide."
msgstr "Una rueda ancha. Así de ancha  \\o/ ."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "off-road wide wheel"
msgid_plural "off-road wide wheels"
msgstr[0] "rueda ancha todoterreno"
msgstr[1] "ruedas anchas todoterreno"

#. ~ Description for off-road wide wheel
#: lang/json/WHEEL_from_json.py
msgid ""
"A wide wheel.  \\o/ This wide.  It's studded to provide better grip off-road"
" at the cost of some performance on pavement."
msgstr ""
"Es una rueda ancha. Así de ancha \\o/ . Tiene tacos grandes para brindar "
"mejor agarre en todo terreno, pero tiene un menor rendimiento en pavimento."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "wooden cart wheel"
msgid_plural "wooden cart wheels"
msgstr[0] "rueda de madera para carro"
msgstr[1] "ruedas de madera para carro"

#. ~ Description for wooden cart wheel
#: lang/json/WHEEL_from_json.py
msgid "A wooden cart wheel, hand made."
msgstr "Una rueda de madera para carro, hecha a mano."

#: lang/json/WHEEL_from_json.py lang/json/vehicle_part_from_json.py
msgid "banded wooden cart wheel"
msgid_plural "banded wooden cart wheels"
msgstr[0] "rueda reforzada de madera para carro"
msgstr[1] "ruedas reforzada de madera para carro"

#. ~ Description for banded wooden cart wheel
#: lang/json/WHEEL_from_json.py
msgid "A wooden cart wheel with metal bands for durability, hand made."
msgstr ""
"Una rueda de madera para carro, que está reforzada con cintas de metal, y "
"hecha a mano."

#: lang/json/WHEEL_from_json.py
msgid "mana wheel"
msgid_plural "mana wheels"
msgstr[0] "rueda de mana"
msgstr[1] "ruedas de mana"

#. ~ Description for mana wheel
#: lang/json/WHEEL_from_json.py
msgid "A column of mana energy that enables a floating disk to move."
msgstr ""
"Una columna de energía de maná que permite que un disco flotante se mueva."

#: lang/json/achievement_from_json.py
msgid "One down, billions to go…"
msgstr "Uno menos, faltan miles de millones..."

#: lang/json/achievement_from_json.py
msgid "Resistance is not futile"
msgstr "La resistencia no es fútil"

#: lang/json/achievement_from_json.py
