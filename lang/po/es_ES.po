msgstr[1] "balas de escopeta, pólvora negra"

#: lang/json/AMMO_from_json.py
msgid "00 shot"
msgid_plural "00 shot"
msgstr[0] "cartucho 00"
msgstr[1] "cartuchos 00"

#. ~ Description for {'str_sp': '00 shot'}
#: lang/json/AMMO_from_json.py
msgid ""
"A shell filled with metal pellets.  Extremely damaging, plus the spread "
"makes it very accurate at short range.  Favored by SWAT forces."
msgstr ""
"Un cartucho lleno de perdigones de metal. Extremadamente dañino, además de "
"la difusión hace que sea muy preciso a corta distancia. El favorito de las "
"fuerzas SWAT."

#: lang/json/AMMO_from_json.py
msgid "shotgun beanbag"
msgid_plural "shotgun beanbags"
msgstr[0] "cartucho de beanbag"
msgstr[1] "cartuchos de beanbag"

#. ~ Description for shotgun beanbag
#. ~ Description for {'str_sp': 'shotshell, beanbag'}
#: lang/json/AMMO_from_json.py
msgid "A beanbag round for shotguns, not deadly but designed to disable."
msgstr ""
"Un cartucho de escopeta beanbag, no mortalmente pero diseñado para "
"incapacitar."

#: lang/json/AMMO_from_json.py
msgid "birdshot"
msgid_plural "birdshot"
msgstr[0] "perdigón"
msgstr[1] "perdigones"

#. ~ Description for {'str_sp': 'birdshot'}
#: lang/json/AMMO_from_json.py
msgid ""
"Weak shotgun ammunition.  Designed for hunting birds and other small game, "
"its applications in combat are very limited."
msgstr ""
"Munición débil para escopetas. Diseñada para cazar pájaros u otros pequeños "
"animales, sus aplicaciones en combate son bastante pobres."

#: lang/json/AMMO_from_json.py
msgid "dragon's breath shell"
msgid_plural "dragon's breath shells"
msgstr[0] "cartucho de aliento de dragón"
msgstr[1] "cartuchos de aliento de dragón"

#. ~ Description for dragon's breath shell
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with magnesium pellets or shards, used mostly as a "
"distress flare or pyrotechnics tool.  When the round is fired, high "
"temperature sparks and flames shoot out of the barrel, igniting everything "
"in their path."
msgstr ""
"Un proyectil de escopeta lleno de perdigones de magnesio o fragmentos, "
"utilizado principalmente como bengala de auxilio o herramienta pirotécnica. "
"Cuando se dispara el cartucho, chispas de alta temperatura y llamas salen "
"del cañón, encendiendo todo a su paso."

#: lang/json/AMMO_from_json.py
msgid "flechette shell"
msgid_plural "flechette shells"
msgstr[0] "cartucho de flechette"
msgstr[1] "cartuchos de flechette"

#. ~ Description for flechette shell
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with tiny steel darts.  Extremely damaging, plus the "
"spread makes it very accurate at short range.  Slices through most forms of "
"armor with ease."
msgstr ""
"Un cartucho de escopeta lleno de pequeños dardos de acero. Causa muchísimo "
"daño, y su dispersión lo hace muy certero. Penetra sin problemas la mayoría "
"de las armaduras."

#: lang/json/AMMO_from_json.py
msgid "explosive slug"
msgid_plural "explosive slugs"
msgstr[0] "cartucho explosivo"
msgstr[1] "cartuchos explosivos"

#. ~ Description for explosive slug
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell shooting a small explosive.  Damaging, but rather inaccurate"
" and short ranged.  Banned in several states."
msgstr ""
"Cartucho de escopeta con una pequeña carga explosiva. Hace bastante daño "
"pero es poco precisa y de corto alcance. Prohibida en varios estados."

#: lang/json/AMMO_from_json.py
msgid "00 shot, scrap loaded"
msgid_plural "00 shot, scrap loaded"
msgstr[0] "cartucho 00, cargado con chatarra"
msgstr[1] "cartuchos 00, cargado con chatarra"

#. ~ Description for {'str_sp': '00 shot, scrap loaded'}
#. ~ Description for {'str_sp': 'shotshell, junk'}
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with whatever was lying around.  They are more "
"damaging than birdshot, but fairly inaccurate."
msgstr ""
"Cartucho de escopeta lleno con cosas que estaban tiradas por ahí. Causan más"
" daño que los perdigones, pero bastante impreciso."

#: lang/json/AMMO_from_json.py
msgid "00 shot, black powder, scrap loaded"
msgid_plural "00 shot, black powder, scrap loaded"
msgstr[0] "cartucho 00, pólvora negra, cargada con chatarra"
msgstr[1] "cartuchos 00, pólvora negra, cargada con chatarra"

#: lang/json/AMMO_from_json.py
msgid "shotgun slug"
msgid_plural "shotgun slugs"
msgstr[0] "cartucho bala"
msgstr[1] "cartuchos bala"

#. ~ Description for shotgun slug
#: lang/json/AMMO_from_json.py
msgid ""
"A heavy metal slug used with shotguns to give them the range capabilities of"
" a rifle.  Extremely damaging but rather inaccurate."
msgstr ""
"Una bala pesada utilizada en escopetas para que tenga el alcance de un "
"rifle. Causa muchísimo daño pero es imprecisa."

#: lang/json/AMMO_from_json.py
msgid "birdshot paper cartridge"
msgid_plural "birdshot paper cartridges"
msgstr[0] "cartucho de papel con perdigones"
msgstr[1] "cartuchos de papel con perdigones"

#. ~ Description for birdshot paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and an "
"equal volume of birdshot.  Used mostly for hunting small game or fowl."
msgstr ""
"Un cartucho de papel que contiene una cantidad medida previamente de pólvora"
" negra y un volumen igual de perdigones. Se utiliza principalmente para caza"
" menor o aves de corral."

#: lang/json/AMMO_from_json.py
msgid "pyrotechnic paper cartridge"
msgid_plural "pyrotechnic paper cartridges"
msgstr[0] "cartucho de papel pirotécnico"
msgstr[1] "cartuchos de papel pirotécnico"

#. ~ Description for pyrotechnic paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and an "
"equal volume of flammable metals.  When fired, burning chunks of metal and "
"sparks will shoot out of the barrel, igniting everything in their path."
msgstr ""
"Un cartucho de papel que contiene una cantidad medida de pólvora negra y un "
"volumen igual de metales inflamables. Cuando se dispara, los trozos de metal"
" y las chispas se disparan fuera del cañón, encendiendo todo a su paso."

#: lang/json/AMMO_from_json.py
msgid "buckshot paper cartridge"
msgid_plural "buckshot paper cartridges"
msgstr[0] "cartucho de papel de postas"
msgstr[1] "cartuchos de papel de postas"

#. ~ Description for buckshot paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and an "
"equal volume of 00 buckshot."
msgstr ""
"Un cartucho de papel que contiene una cantidad medida de pólvora negra y un "
"volumen igual de postas 00."

#: lang/json/AMMO_from_json.py
msgid ".62 paper cartridge"
msgid_plural ".62 paper cartridges"
msgstr[0] "cartucho de papel de .62"
msgstr[1] "cartuchos de papel de .62"

#. ~ Description for .62 paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and a .605"
" inch lead ball."
msgstr ""
"Un cartucho de papel que contiene una cantidad medida de pólvora negra y una"
" bola de plomo de 1.5 cm."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "signal flare"
msgid_plural "signal flares"
msgstr[0] "bengala"
msgstr[1] "bengalas"

#. ~ Description for signal flare
#: lang/json/AMMO_from_json.py
msgid ""
"A heavy plastic cartridge made for use in flare guns.  It appears to be a "
"modified 12 gauge shotgun shell."
msgstr ""
"Un cartucho de plástico pesado hecho para usar en las pistolas de bengala. "
"Parece ser un cartucho de escopeta calibre 12 modificado."

#: lang/json/AMMO_from_json.py
msgid "oxyacetylene"
msgid_plural "oxyacetylene"
msgstr[0] "oxiacetileno"
msgstr[1] "oxiacetileno"

#. ~ Description for {'str_sp': 'oxyacetylene'}
#: lang/json/AMMO_from_json.py
msgid ""
"A highly explosive fuel mixture composed of equal parts of oxygen and "
"acetylene gas."
msgstr ""
"Una mezcla de combustible altamente explosivo, compuesto por medidas iguales"
" de oxígeno y gas acetileno."

#: lang/json/AMMO_from_json.py
