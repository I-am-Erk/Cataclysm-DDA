msgid_plural "wooden buttons"
msgstr[0] "botón de madera"
msgstr[1] "botones de madera"

#. ~ Description for wooden button
#: lang/json/AMMO_from_json.py
msgid "A crude wooden button, usually found on very old clothing."
msgstr ""
"Un botón de madera tosco, que se encuentra generalmente en la ropa muy "
"vieja."

#: lang/json/AMMO_from_json.py
msgid "steel snap fastener"
msgid_plural "steel snap fasteners"
msgstr[0] "cierre a presión de acero"
msgstr[1] "cierres a presión de acero"

#. ~ Description for steel snap fastener
#: lang/json/AMMO_from_json.py
msgid "A steel snap fastener, usually found on clothing."
msgstr "Un cierre de presión de cero, usualmente encontrado en la ropa."

#: lang/json/AMMO_from_json.py
msgid "touch fastener"
msgid_plural "touch fasteners"
msgstr[0] "velcro"
msgstr[1] "velcros"

#. ~ Description for touch fastener
#: lang/json/AMMO_from_json.py
msgid ""
"This is a pair of cloth strips, one of which has tiny hooks and another has "
"tiny loops.  Useful as a fastener for clothing and footwear."
msgstr ""
"Este es un par de tiras de tela, una de las cuales tiene pequeños ganchos y "
"otra tiene pequeños bucles. Útiles como abrochadores para la ropa y el "
"calzado."

#: lang/json/AMMO_from_json.py
msgid "long plastic zipper"
msgid_plural "long plastic zippers"
msgstr[0] "cremallera de plástico larga"
msgstr[1] "cremalleras de plástico larga"

#. ~ Description for long plastic zipper
#: lang/json/AMMO_from_json.py
msgid "A long zipper made from plastic, usually found on clothing."
msgstr ""
"Cremallera larga fabricada con plástico, normalmente se encuentra en ropa."

#: lang/json/AMMO_from_json.py
msgid "short plastic zipper"
msgid_plural "short plastic zippers"
msgstr[0] "cremallera de plástico corta"
msgstr[1] "cremalleras de plástico corta"

#. ~ Description for short plastic zipper
#: lang/json/AMMO_from_json.py
msgid ""
"A short zipper made from plastic, usually found on footwear or clothing "
