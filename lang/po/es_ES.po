msgstr "Miembro de platino"

#: src/iexamine.cpp
msgid "Gold member"
msgstr "Miembro dorado"

#: src/iexamine.cpp
msgid "Silver member"
msgstr "Miembro plateado"

#: src/iexamine.cpp
msgid "Beloved customer"
msgstr "Cliente querido"

#: src/iexamine.cpp
msgid "You're illiterate, and can't read the screen."
msgstr "Eres analfabeto, no puedes leer la pantalla."

#: src/iexamine.cpp
#, c-format
msgid "Failure!  No %s pumps found!"
msgstr "¡Error! ¡No se encontraron surtidores de %s!"

