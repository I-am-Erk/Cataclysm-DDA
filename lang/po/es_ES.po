#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A milkshake made by freezing a premade mix.  Tastes better due to how much "
"sugar is in it, but is bad for your health."
msgstr ""
"Un batido hecho por la congelación de una mezcla prefabricada. Sabe mejor "
"debido a la cantidad de azúcar que contiene, pero es malo para la salud."

#: lang/json/COMESTIBLE_from_json.py
msgid "chocolate milkshake"
msgid_plural "chocolate milkshakes"
msgstr[0] "batido de chocolate"
msgstr[1] "batidos de chocolate"

#. ~ Description for chocolate milkshake
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"An all-natural cold beverage made with chocolate milk and sweeteners.  "
"Tastes great when frozen."
msgstr ""
"Una bebida fría totalmente natural hecha con leche chocolateada y "
"edulcorantes. Sabe bien cuando está congelado."

#: lang/json/COMESTIBLE_from_json.py
