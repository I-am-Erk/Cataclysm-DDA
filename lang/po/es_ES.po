msgid_plural "paper cartridges"
msgstr[0] "cartucho de papel"
msgstr[1] "cartuchos de papel"

#. ~ Description for paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing black powder and a metallic projectile.  "
"Historically used to reload muzzleloaders in a more reasonable time."
msgstr ""
"Un cartucho de papel que contiene pólvora negra y un proyectil metálico. "
"Históricamente utilizado para recargar los mosquetes en un tiempo más "
"razonable."

#: lang/json/AMMO_from_json.py
msgid "paper shot cartridge"
msgid_plural "paper shot cartridges"
msgstr[0] "cartucho de papel de escopeta"
msgstr[1] "cartuchos de papel de escopeta"

#. ~ Description for paper shot cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing black powder and metallic shot.  Historically "
"used to reload muzzleloaders in a more reasonable time."
msgstr ""
"Un cartucho de papel que contiene pólvora negra y un proyectil metálico. "
"Históricamente utilizado para recargar los mosquetes en un tiempo más "
"razonable."

#: lang/json/AMMO_from_json.py
msgid "rebar rail"
msgid_plural "rebar rails"
msgstr[0] "varilla de acero corrugado"
msgstr[1] "varillas de acero corrugado"

#. ~ Description for rebar rail
#: lang/json/AMMO_from_json.py
msgid ""
"A short piece of ferromagnetic rebar which has been straightened and "
"sharpened on one end.  Could be used as a projectile by a sufficiently "
"powerful electromagnetic weapon."
msgstr ""
"Una pieza corta de acero ferromagnético corrugado que ha sido enderezado y "
"afilado en punta. Puede ser utilizado como proyectil por un arma "
"electromagnética lo suficientemente fuerte."

#: lang/json/AMMO_from_json.py
msgid "steel rail"
msgid_plural "steel rails"
msgstr[0] "varilla de acero"
msgstr[1] "varillas de acero"

#. ~ Description for steel rail
#: lang/json/AMMO_from_json.py
msgid ""
"A short piece of steel which has been forged true and sharpened on one end."
"  Could be used as a projectile by a sufficiently powerful electromagnetic "
"weapon."
msgstr ""
"Una corta pieza de acero que ha sido afilada en punta.  Puede ser utilizado "
"como proyectil por un arma electromagnética lo suficientemente potente."

#: lang/json/AMMO_from_json.py
