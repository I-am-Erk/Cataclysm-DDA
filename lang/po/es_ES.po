msgstr[1] "conjuntos de Colonos del Rancho"

#. ~ Description for Settlers of the Ranch
#: lang/json/GENERIC_from_json.py
msgid ""
"A strategy game where players build settlements and trade for supplies."
msgstr ""
"Un juego de estrategia donde los jugadores construyen asentamientos y "
"comercian por suministros."

#: lang/json/GENERIC_from_json.py
msgid "Warships"
msgid_plural "sets of Warships"
msgstr[0] "Buques de Guerra"
msgstr[1] "colección de Buques de Guerra"

#. ~ Description for Warships
#: lang/json/GENERIC_from_json.py
