#. ~ Description for {'str': 'Psychology Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in psychology, a PhD or equivalent."
msgstr ""
"Este superviviente tiene una amplia experiencia en psicología, un doctorado "
"o equivalente."

#: lang/json/mutation_from_json.py
msgid "Sanitation Training"
msgstr "Formación en Saneamiento"

#. ~ Description for {'str': 'Sanitation Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in sanitation, but not much "
"experience."
msgstr ""
"Este superviviente tiene cierta formación formal en saneamiento, pero no "
"mucha experiencia."

#: lang/json/mutation_from_json.py
msgid "Sanitation Expert"
msgstr "Especialista en Saneamiento"

#. ~ Description for {'str': 'Sanitation Expert'}
#: lang/json/mutation_from_json.py
msgid "This survivor has extensive experience in sanitation."
msgstr "Este superviviente tiene mucha experiencia en saneamiento."

#: lang/json/mutation_from_json.py
msgid "Teaching Training"
msgstr "Formación en Docencia"

#. ~ Description for {'str': 'Teaching Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in teaching, but not much experience."
msgstr ""
"Este superviviente tiene algo de entrenamiento formal en la enseñanza, pero "
"no mucha experiencia."

#: lang/json/mutation_from_json.py
msgid "Teaching Expert"
msgstr "Experto en Enseñanza"

#. ~ Description for {'str': 'Teaching Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in teaching, a PhD or equivalent."
msgstr ""
"Este superviviente tiene una amplia experiencia en la enseñanza, un "
"doctorado o equivalente."

#: lang/json/mutation_from_json.py
msgid "Veterinary Training"
msgstr "Formación en Veterinaria"

#. ~ Description for {'str': 'Veterinary Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in veterinary medicine, but not much "
"experience."
msgstr ""
"Este superviviente tiene alguna formación formal en medicina veterinaria, "
"pero no mucha experiencia."

#: lang/json/mutation_from_json.py
msgid "Veterinary Expert"
msgstr "Experto en Veterinaria"

#. ~ Description for {'str': 'Veterinary Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in veterinary medicine, a DVM or "
"equivalent."
msgstr ""
"Este superviviente tiene mucha experiencia en medicina veterinaria, un "
"doctorado o algo así."

#: lang/json/mutation_from_json.py
msgid "Mark of the Seer"
msgstr "Marca del Visionario"

#. ~ Description for {'str': 'Mark of the Seer'}
#: lang/json/mutation_from_json.py
msgid "A strange occult symbol carved into your hand by Brigitte LaCroix."
msgstr "Un extraño símbolo oculto grabado en tu mano por Brigitte LaCroix."

#: lang/json/mutation_from_json.py
msgid "PrepNet Tag"
msgstr "Etiqueta PrepNet"

#. ~ Description for {'str': 'PrepNet Tag'}
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes monsters see it as a Prepnet.  It is a bug if you have "
"it."
msgstr ""
"Rasgo del PNJ que hace que los monstruos lo vean como un Prepnet. Es un "
"error si lo tienes."

#: lang/json/mutation_from_json.py
msgid "Killophant"
msgstr "Kilofante"

#. ~ Description for {'str': 'Killophant'}
#: lang/json/mutation_from_json.py
msgid ""
"Your species was created as the ultimate shock troop.  Inherit the earth, "
"pedigree your ancestors, crush the foe."
msgstr ""
"Tu especie fue creada como la última tropa de choque. Heredar la tierra, "
"hacer pedigrí de tus ancestros, aplastar al enemigo."

#: lang/json/mutation_from_json.py
msgid "Mi-go acclimatization"
msgstr "aclimatización Mi-go"

#. ~ Description for Mi-go acclimatization
#: lang/json/mutation_from_json.py
msgid ""
"Fleshy fronds grown from your scalp function like organic heat sinks.  They "
"allow you to live comfortably within the mi-go atmosphere."
msgstr ""
"Frondas carnosas que crecen de tu cuero cabelludo que funcionan como "
"disipadores de calor orgánicos. Permiten vivir cómodamente dentro de la "
"atmósfera de mi-go."

#: lang/json/mutation_from_json.py
msgid "Facial Tentacles"
msgstr "Tentáculos Faciales"

#: lang/json/mutation_from_json.py
msgid "Mouth Tendrils"
msgstr "Zarcillos Bucales"

#: lang/json/mutation_from_json.py
msgid "Warm Natured"
msgstr "Naturaleza Cálida"

#. ~ Description for Warm Natured
#: lang/json/mutation_from_json.py
msgid ""
"Your body becomes much more efficient at distributing heat from itself."
msgstr ""
"Tu cuerpo se vuelve mucho más eficiente al distribuir el calor por sí mismo."

#: lang/json/mutation_from_json.py
msgid "Neural Improvement"
msgstr "Mejora Neural"

#. ~ Description for Neural Improvement
#: lang/json/mutation_from_json.py
msgid "You see the world a little differently today.  Intelligence + 1"
msgstr "Hoy ves el mundo de forma diferente. Inteligencia + 1"

#: lang/json/mutation_from_json.py
msgid "Expanded Consciousness"
msgstr "Conciencia Expandida"

#. ~ Description for Expanded Consciousness
#: lang/json/mutation_from_json.py
msgid "You are beginning to see a way off this planet.  Intelligence + 2"
msgstr "Empiezas a ver una forma de salir de este planeta. Inteligencia + 2"

#. ~ Description for Extremely Smart
#: lang/json/mutation_from_json.py
msgid ""
"As humans uplifted our pets in the final years this process is lifting you "
"to a new level of intelligence.  Intelligence + 4"
msgstr ""
"Al igual que los humanos ascendieron a nuestras mascotas en los últimos "
"años, este proceso te ha ascendido a un nuevo nivel de inteligencia. "
"Inteligencia + 4"

#: lang/json/mutation_from_json.py
msgid "Alien Intelligence"
msgstr "Inteligencia Alienígena"

#. ~ Description for Alien Intelligence
#: lang/json/mutation_from_json.py
msgid ""
"You can see the connections from A to B to C to D.  You look at fellow "
"survivors like you are imagining taking them apart.  Intelligence + 5"
msgstr ""
"Puedes ver las conexiones de A a B a C a D. Miras a los compañeros "
"supervivientes como si estuvieras imaginando cómo desmontarlos. Inteligencia"
" + 5"

#: lang/json/mutation_from_json.py
msgid "Enhanced Reactions"
msgstr "Reacciones Mejoradas"

#. ~ Description for Enhanced Reactions
#: lang/json/mutation_from_json.py
msgid "Today is the day to start juggling.  Dexterity + 1"
msgstr "Hoy es el día de empezar a hacer malabares. Destreza + 1"

#: lang/json/mutation_from_json.py
msgid "Quickening"
msgstr "Aceleración"

#. ~ Description for Quickening
#: lang/json/mutation_from_json.py
msgid "You are starting to move like they do.  Dexterity + 2"
msgstr "Empiezas a moverte como ellos. Destreza + 2"

#: lang/json/mutation_from_json.py
msgid "Otherworldly Grace"
msgstr "Gracia de Otro Mundo"

#. ~ Description for Otherworldly Grace
#: lang/json/mutation_from_json.py
msgid ""
"You no longer move like a human, others find it disconcerting.  Dexterity + "
"4"
msgstr ""
"Ya no te mueves como un humano, los demás lo encuentran desconcertante. "
"Destreza + 4"

#: lang/json/mutation_from_json.py
msgid "New Muscles"
msgstr "Músculos Nuevos"

#. ~ Description for New Muscles
#: lang/json/mutation_from_json.py
msgid ""
"You see some new muscles that you aren't sure you've seen on humans before."
"  Strength + 1"
msgstr ""
"Ves algunos músculos nuevos que no estás seguro de haber visto antes en los "
"humanos. Fuerza + 1"

#: lang/json/mutation_from_json.py
msgid "Muscle Fiber"
msgstr "Fibra Muscular"

#. ~ Description for Muscle Fiber
#: lang/json/mutation_from_json.py
msgid "Fibrous tissue seems to be spreading through your body.  Strength + 2"
msgstr ""
"El tejido fibroso parece estar extendiéndose por tu cuerpo. Fuerza + 2"

#: lang/json/mutation_from_json.py
msgid "Mi-go Ears"
msgstr "Orejas Mi-go"

#. ~ Description for Mi-go Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have split into a series of tuberous projections.  They waggle "
"towards far away sounds."
msgstr ""
"Sus orejas se han dividido en una serie de proyecciones tuberosas. Se agitan"
" hacia los sonidos lejanos."

#: lang/json/mutation_from_json.py
msgid "Detachment"
msgstr "Distanciamiento"

#. ~ Description for Detachment
#: lang/json/mutation_from_json.py
msgid ""
"When were you ever like these creatures, helpless before the changes "
"ravaging this world."
msgstr ""
"¿Cuándo fuiste como estas criaturas, indefensas ante los cambios que asolan "
"este mundo?"

#: lang/json/mutation_from_json.py
msgid "Eldritch"
msgstr "Sobrenatural"

#. ~ Description for Eldritch
#: lang/json/mutation_from_json.py
msgid ""
"You have a sinister aspect to your demeanor, no longer part of this world.  "
"You feel no sorrow at the deaths of humans and your brain now processes "
"combat skills more efficiently as you mentally dissect your opponents."
msgstr ""
"Tienes un aspecto siniestro en tu comportamiento, que ya no forma parte de "
"este mundo. No sientes pena por la muerte de los humanos y tu cerebro "
"procesa ahora las habilidades de combate con mayor eficacia al diseccionar "
"mentalmente a tus oponentes."

#. ~ Description for YUGGOTH
#: lang/json/mutation_from_json.py
msgid "This death throes of this world are the birthing pangs of yours."
msgstr "Los estertores de este mundo son los dolores de parto del tuyo."

#: lang/json/mutation_from_json.py
msgid "Fetid scent"
msgstr "Olor fétido"

#. ~ Description for Fetid scent
#: lang/json/mutation_from_json.py
msgid ""
"Your sweat now smells otherworldly, and not in a good way.  The mi-go still "
"hate you but at least they aren't offended by your smell."
msgstr ""
"Tu sudor ahora huele a otro mundo, y no en el buen sentido. Los mi-go siguen"
" odiándote, pero al menos no se ofenden por tu olor."

#: lang/json/mutation_from_json.py
msgid "Eerie"
msgstr "Espeluznante"

#. ~ Description for Eerie
#: lang/json/mutation_from_json.py
msgid ""
"You are off-putting to others.  Your mannerisms have changed as if human "
"interaction is becoming foreign."
msgstr ""
"Te sientes molesto con los demás. Tus maneras han cambiado como si la "
"interacción humana se hubiera convertido en algo extraño."

#: lang/json/mutation_from_json.py
msgid "Mi-go Wings"
msgstr "Alas Mi-go"

#. ~ Description for Mi-go Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, veiny wings.  They don't appear to be made for "
"this atmosphere but they grant a powerful buffeting attack."
msgstr ""
"Tienes un par de alas grandes y venosas. No parecen estar hechas para esta "
"atmósfera, pero otorgan un poderoso ataque de golpeo."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You buffet %s with your wings"
msgstr "Abofeteas a %s con tus alas"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s buffets %2$s with their wings"
msgstr "%1$s abofetea a %2$s con sus alas"

#: lang/json/mutation_from_json.py
msgid "Mi-go breathe"
msgstr "respiración Mi-go"

#. ~ Description for Mi-go breathe
#: lang/json/mutation_from_json.py
msgid "You can now breathe the gasses the mi-go thrive in."
msgstr "Ahora puedes respirar los gases que los mi-go se crecen."

#: lang/json/mutation_from_json.py
msgid "Uplifted"
msgstr "Ascendido"

#. ~ Description for Uplifted
#: lang/json/mutation_from_json.py
msgid ""
"You come from uplifted animal stock.  This decreases morale penalties for "
"being wet."
msgstr ""
"Provienes de una estirpe de animales ascendidos. Esto disminuye las "
"penalizaciones de moral por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Hauler"
msgstr "Cargador"

#. ~ Description for Hauler
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 60%."
msgstr ""
"Eres capaz de cargar mucho más de lo que podría alguien con una fuerza "
"similar. Tu peso máximo transportado se incrementa en un 60%."

#: lang/json/mutation_from_json.py
msgid "Patched Fur"
msgstr "Piel Parcheada"

#. ~ Description for Patched Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your skin has patches of light fur.  This has no impact on your life except "
"marking you as not fully human."
msgstr ""
"Tu piel tiene manchas de pelo claro. Esto no tiene ningún impacto en tu "
"vida, excepto que te marca como no completamente humano."

#: lang/json/mutation_from_json.py
msgid "Crushing Feet"
msgstr "Pies aplastantes"

#. ~ Description for Crushing Feet
#: lang/json/mutation_from_json.py
msgid ""
"Your feet have grown massive and ready to support huge weight.  This allows "
"kicking attacks to do much more damage, provides natural armor, and removes "
"the need to wear shoes; however, you cannot wear normal size shoes.  Reduces"
" wet effects."
msgstr ""
"Tus pies han crecido de forma masiva y están preparados para soportar un "
"gran peso. Esto permite que los ataques con patadas hagan mucho más daño, "
"proporciona una armadura natural y elimina la necesidad de usar zapatos; sin"
" embargo, no puedes usar zapatos de tamaño normal. Reduce los efectos por "
"estar mojado."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You kick %s with your massive feet"
msgstr "Pateas a  %s con tus masivos pies"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s kicks %2$s with their massive feet"
msgstr "%1$s patea al %2$s con sus masivos pies"

#: lang/json/mutation_from_json.py
msgid "Face Bumps"
msgstr "Bultos de Cara"

#. ~ Description for Face Bumps
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of bumps on your face above your mouth and beside your nose."
msgstr ""
"Tienes un par de bultos en la cara por encima de tu boca y al lado de tu "
"nariz."

#: lang/json/mutation_from_json.py
msgid "Tusks"
msgstr "Colmillos"

#. ~ Description for Tusks
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of small tusks on your face.  They allow you to make a weak "
"piercing goring attack."
msgstr ""
"Tienes un par de pequeños colmillos en la cara. Te permiten realizar un "
"débil ataque de cornada perforante."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You gore %s with your tusks"
msgstr "Corneas a %s con tus colmillos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s gores %2$s with their tusks"
msgstr "%1$s cornea %2$s con sus colmillos"

#: lang/json/mutation_from_json.py
msgid "Pointed Tusks"
msgstr "Colmillos Puntiagudos"

#. ~ Description for Pointed Tusks
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of long, pointed tusks, like someone weaponized an elephant."
"  They allow you to make a strong piercing headbutt attack, but prevent "
"wearing mouthgear that is not made of fabric."
msgstr ""
"Tienes un par de colmillos largos y puntiagudos, como si alguien hubiera "
"armado a un elefante. Te permiten realizar un fuerte ataque de cabeza "
"perforante, pero impiden llevar un aparato bucal que no sea de tejido."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You stab %s with your pointed tusks"
msgstr "Apuñalas a%s con tus colmillos puntiagudos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stabs %2$s with their pointed tusks"
msgstr "%1$s apuñala a %2$s con sus colmillos puntiagudos"

#: lang/json/mutation_from_json.py
msgid "Elephant Trunk"
msgstr "Trompa de Elefante"

#. ~ Description for {'str': 'Elephant Trunk'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face resembles that of an elephant, with a significant trunk.  It looks"
" fierce but prevents wearing mouthgear.  Prehensile and able to perform some"
" fine detail work."
msgstr ""
"Tu cara se parece a la de un elefante, con una trompa importante. Tienes un "
"aspecto feroz, pero no te permite llevar aparatos bucales. Es prensil y "
"capaz de realizar algunos trabajos de detalle."

#: lang/json/mutation_from_json.py
msgid "Three Fingered"
msgstr "Tres Dedos"

#. ~ Description for Three Fingered
#: lang/json/mutation_from_json.py
msgid ""
"Your hands have fused into three fingered paws.  Fine manipulation is a "
"challenge: permanent hand encumbrance of 10, difficulty with delicate "
"craftwork, and your gloves don't fit.  But they handle water better."
msgstr ""
"Tus manos se han fusionado en patas de tres dedos. La manipulación precisa "
"es un reto: incomodidad permanente de 10 en las manos, dificultad para la "
"fabricación delicada, y tus guantes no te sirven. Pero se manejan mejor en "
"el agua."

#: lang/json/mutation_from_json.py
msgid "Trumpeting Voice"
msgstr "Voz de Trompeta"

#. ~ Description for Trumpeting Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a trumpeting, elephantine voice.  Threatening NPCs will be easier, "
"but lying will be very hard."
msgstr ""
"Tienes una voz de elefante. Amenazar a los NPCs será más fácil, pero mentir "
"será muy difícil."

#: lang/json/mutation_from_json.py
msgid "Brutal Strength"
msgstr "Fuerza Brutal"

#. ~ Description for {'str': 'Brutal Strength'}
#: lang/json/mutation_from_json.py
msgid "Genetic tampering made your body incredibly strong.  Strength + 7."
msgstr ""
"La manipulación genética hizo que tu cuerpo fuera increíblemente fuerte. "
"Fuerza + 7."

#: lang/json/mutation_from_json.py
msgid "Cryoadaptation"
msgstr "Crioadaptación"

#. ~ Description for {'str': 'Cryoadaptation'}
#: lang/json/mutation_from_json.py
msgid ""
"An experimental cryosleep procedure has permanently altered your body, "
"allowing you to better tolerate cold temperatures."
msgstr ""
"Un procedimiento experimental de crio-sueño ha alterado permanentemente tu "
"cuerpo, permitiéndote tolerar mejor las temperaturas frías."

#: lang/json/mutation_from_json.py
msgid "Alpine Conditioning"
msgstr "Acondicionamiento Alpino"

#. ~ Description for {'str': 'Alpine Conditioning'}
#: lang/json/mutation_from_json.py
msgid ""
"Time spent in high altitudes and low temperatures have adapted you to them, "
"and you're slightly better at resisting the cold."
msgstr ""
"El tiempo pasado en altas altitudes y bajas temperaturas te han adaptado a "
"ellas, y eres ligeramente mejor para resistir el frío."

#. ~ Description for {'str': 'Brutal Strength'}
#: lang/json/mutation_from_json.py
msgid "Genetic defects have made your body incredibly strong.  Strength + 7."
msgstr ""
"Defectos Genéticos han hecho que tu cuerpo tenga una fuerza increiblemente "
"fuerte.  Fuerza + 7."

#: lang/json/mutation_from_json.py
msgid "Leathered Feet"
msgstr "Pies de Cuero"

#. ~ Description for Leathered Feet
#: lang/json/mutation_from_json.py
msgid ""
"The bottoms of your feet are tough like an animals.  You receive no movement"
" penalty for not wearing shoes."
msgstr ""
"Las plantas de tus pies son duras como las de los animales. No recibes "
"ninguna penalización de movimiento por no llevar zapatos."

#: lang/json/mutation_from_json.py
msgid "Skinfolds"
msgstr "Pliegues de Piel"

#. ~ Description for Skinfolds
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is tough.  Cutting damage is slightly reduced for you.  Slightly "
"decreases wet penalties."
msgstr ""
"Tu piel es resistente. El daño cortante es reducido levemente. También "
"reduce las penalidades por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Weak Joints"
msgstr "Articulaciones Débiles"

#. ~ Description for {'str': 'Weak Joints'}
#: lang/json/mutation_from_json.py
msgid ""
"A common flaw in your genemod, brought on by increased muscle mass and bone "
"density.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Un defecto común en tu genemod, provocado por el aumento de la masa muscular"
" y la densidad ósea. Moverte por terrenos accidentados  te ralentizará más "
"de lo normal."

#: lang/json/mutation_from_json.py
msgid "Herbivorous Ancestry"
msgstr "Ancestros Herbívoros"

#. ~ Description for Strong Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is particularly strong.  It's vaguely offensive to humans, and "
"animals that track your scent will do so more easily."
msgstr ""
"Tu olor es particularmente fuerte. Es vagamente ofensivo para los humanos, y"
" los animales que rastreen tu olor lo harán más fácilmente."

#: lang/json/mutation_from_json.py
msgid "Giant Step"
msgstr "Paso Gigante"

#: lang/json/mutation_from_json.py
msgid "Slow and Steady"
msgstr "Lento y Firme"

#. ~ Description for Slow and Steady
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can't move as fast as most, resulting in a 10% speed penalty on flat "
"ground."
msgstr ""
"No puedes moverte tan rápido como la mayoría, lo que supone una penalización"
" de velocidad del 10% en terreno llano."

#: lang/json/mutation_from_json.py
msgid "Short Fur Coat"
msgstr "Abrigo de Pelo Corto"

#. ~ Description for {'str': 'Short Fur Coat'}
#: lang/json/mutation_from_json.py
msgid ""
"Short fur has grown to cover your entire body, providing slight protection "
"from cold."
msgstr ""
"Pelaje corto ha crecido hasta cubrir todo tu cuerpo, proporcionando una "
"ligera protección contra el frío."

#. ~ Description for {'str': 'Furry'}
#: lang/json/mutation_from_json.py
msgid ""
"Thick brown fur has grown to cover your entire body, providing a slight "
"protection against attacks, and some protection from cold."
msgstr ""
"Grueso pelaje marrón ha crecido hasta cubrir todo tu cuerpo, "
"proporcionándote una ligera protección contra los ataques, y cierta "
"protección contra el frío."

#: lang/json/mutation_from_json.py
msgid "Immovable"
msgstr "Inamovible"

#: lang/json/mutation_from_json.py
msgid "Unstoppable"
msgstr "Imparable"

#: lang/json/mutation_from_json.py
msgid "Meatshield"
msgstr "Escudo de Carne"

#: lang/json/mutation_from_json.py
msgid "Elephantine"
msgstr "Elefantino"

#: lang/json/mutation_from_json.py
msgid "Freakishly Gigantic"
msgstr "Peculiarmente Gigante"

#: lang/json/mutation_from_json.py
msgid "Gigantic"
msgstr "Gigante"

#: lang/json/mutation_from_json.py
msgid "Terrible Odor"
msgstr "Olor Terrible"

#. ~ Description for Terrible Odor
#: lang/json/mutation_from_json.py
msgid ""
"You smell exactly like a shaggy elephant would, assuming it sweated, which "
"you do.  Monsters that track scent will find you very easily, and humans "
"will react poorly."
msgstr ""
"Hueles exactamente como lo haría un elefante peludo, suponiendo que sudara, "
"que es lo que haces. Los monstruos que rastrean el olor te encontrarán muy "
"fácilmente, y los humanos reaccionarán mal."

#: lang/json/mutation_from_json.py
msgid "Constant Eater"
msgstr "Comedor Constante"

#: lang/json/mutation_from_json.py
msgid "Large Diet"
msgstr "Dieta Grande"

#. ~ Description for Large Diet
#: lang/json/mutation_from_json.py
msgid ""
"You require more food than others but your ability to go the distance in "
"both combat and athleticism is expanded."
msgstr ""
"Necesitas más comida que los demás, pero tu capacidad de llegar más lejos "
"tanto en el combate como en el atletismo se amplía."

#. ~ Description for High Thirst
#: lang/json/mutation_from_json.py
msgid ""
"Your body needs more water than usual to flush the denser waste products."
msgstr ""
"Su cuerpo necesita más agua de lo habitual para eliminar los productos de "
"desecho más densos."

#: lang/json/mutation_from_json.py
msgid "Giant Thirst"
msgstr "Sed Gigante"

#. ~ Description for Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your weight must be delicately placed lest the ground give way.  You move "
"10% slower."
msgstr ""
"Tu peso debe ser colocado con delicadeza para que el suelo no ceda. Te "
"mueves un 10% más lento."

#: lang/json/mutation_from_json.py
msgid "Very Deliberate"
msgstr "Muy Deliberado"

#. ~ Description for Very Deliberate
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are quite slow to move.  You move 25% slower."
msgstr ""
"Tus músculos son bastante lentos en sus movimientos. Te mueves un 25% más "
"lento."

#: lang/json/mutation_from_json.py
msgid "Whately Story"
msgstr "Historia Whately"

#: lang/json/mutation_from_json.py
msgid "Sadie Story"
msgstr "Historia Sadie"

#: lang/json/mutation_from_json.py
msgid "CRIT Melee Training"
msgstr "Armas Cuerpo a Cuerpo CRIT"

#. ~ Description for CRIT Melee Training
#: lang/json/mutation_from_json.py
msgid ""
"You have received CQB training.  For every hit you land, gain themed combat "
"bonuses."
msgstr ""
"Has recibido entrenamiento CEC. Por cada golpe que recibes, obtienes "
"bonificaciones de combate relacionados."

#: lang/json/mutation_from_json.py
msgid "Shadow Meld"
msgstr "Unión de las Sombras"

#. ~ Description for Shadow Meld
#: lang/json/mutation_from_json.py
msgid ""
"The light around you bends strangely, making it harder for enemies to notice"
" you."
msgstr ""
"La luz que te rodea se curva de forma extraña, haciendo más difícil que los "
"enemigos se fijen en ti."

#: lang/json/mutation_from_json.py
msgid "Moon-lit Grace"
msgstr "Gracia de Luz de Luna"

#. ~ Description for Moon-lit Grace
#: lang/json/mutation_from_json.py
msgid ""
"Aside from your appearances, your movements are incredibly graceful and "
"allow you to seemingly glide through every task."
msgstr ""
"Aparte de su apariencia, sus movimientos son increíblemente elegantes y le "
"permiten deslizarse aparentemente a través de cada tarea."

#: lang/json/mutation_from_json.py
msgid "Red Iris"
msgstr "Iris Rojo"

#. ~ Description for Red Iris
#: lang/json/mutation_from_json.py
msgid ""
"You eyes are a pleasant shade of hypnotic scarlet.  People feel mildly "
"persuaded by you."
msgstr ""
"Tus ojos son de un agradable tono de escarlata hipnótico. La gente se siente"
" ligeramente persuadida por usted."

#: lang/json/mutation_from_json.py
msgid "Night Walker"
msgstr "Caminador de la Noche"

#. ~ Description for Night Walker
#: lang/json/mutation_from_json.py
msgid ""
"Emerge from the grave of the old world, and become the night once again."
msgstr ""
"Emerges de la tumba del viejo mundo, y te conviertes en la noche una vez "
"más."

#: lang/json/mutation_from_json.py
msgid "Forest Guardian"
msgstr "Guardian del Bosque"

#. ~ Description for Forest Guardian
#: lang/json/mutation_from_json.py
msgid ""
"The forests have longed for your help, and this last cry shook the world."
msgstr ""
"Los bosques han anhelado tu ayuda, y este último llanto sacudió el mundo."

#: lang/json/mutation_from_json.py
msgid "Nature's Boon"
msgstr "La Bendición de la Naturaleza"

#. ~ Description for Nature's Boon
#: lang/json/mutation_from_json.py
msgid ""
"Your very presence is masked by nature itself.  You are slightly harder to "
"detect."
msgstr ""
"Tu propia presencia está enmascarada por la propia naturaleza. Eres un poco "
"más difícil de detectar."

#: lang/json/mutation_from_json.py
msgid "Slashers"
msgstr "Acuchilladores"

#. ~ Description for Slashers
#: lang/json/mutation_from_json.py
msgid ""
"Your torso has an extra set of appendages that have burst out of your back, "
"they are tipped with massive bone blades at the end, and look like they can "
"do some serious damage with the thick acid that they secrete."
msgstr ""
"El torso tiene un conjunto extra de apéndices que han estallado de la "
"espalda, están inclinados con cuchillas de hueso masivo en el extremo, y "
"parece que pueden hacer algún daño serio con el ácido espeso que secretan."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your blades"
msgstr "Desgarras %s con tus cuchillas"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their blades"
msgstr "%1$s  desgarra %2$s con sus espadas"

#: lang/json/mutation_from_json.py
msgid "Spurs"
msgstr "Espuelas"

#. ~ Description for Spurs
#: lang/json/mutation_from_json.py
msgid ""
"Spurs of bone have erupted all across your arms.  A thick, biological "
"secretion oozes out of them promising extra harm to enemies."
msgstr ""
"Han surgido espolones de hueso por todos tus brazos. De ellos rezuma una "
"espesa secreción biológica que promete un daño extra a los enemigos."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You ravage %s with your arms"
msgstr "Devastas a%s con tus brazos"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s ravages %2$s with their arm spurs"
msgstr "%1$s devasta a %2$s con sus espolones de brazos"

#: lang/json/mutation_from_json.py
msgid "Persistent Body"
msgstr "Cuerpo Persistente"

#. ~ Description for Persistent Body
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"As you move, the world seems to breath life and energy into your limbs.  You"
" simply rarely tire less readily than others.  Your maximum stamina is 50% "
"higher than usual."
msgstr ""
"Mientras te mueves, el mundo parece insuflar vida y energía a tus "
"extremidades. Simplemente, te cansas menos que los demás. Tu vigor máximo es"
" un 50% mayor a lo normal."

#: lang/json/mutation_from_json.py
msgid "RP: Combatant"
msgstr "Alias: Combatiente"

#. ~ Description for RP: Combatant
#: lang/json/mutation_from_json.py
msgid ""
"You've seen your fair share of scruffs and scrapes, and when the Cataclysm "
"hit, you fought the Occupiers and managed to survive to tell the tale.  Has "
"no direct skill benefit, but allows you to present yourself as a fighter to "
"certain NPCs.  Some might even recognize you."
msgstr ""
"Has visto tu parte justa de desgarros y rasguños, y cuando el Cataclismo "
"golpeó, luchaste contra los Ocupantes y lograste sobrevivir para contarlo. "
"No tiene ningún beneficio directo en tus habilidades, pero te permite "
"presentarte como un luchador ante ciertos PNJs. Algunos podrían incluso "
"reconocerte."

#: lang/json/mutation_from_json.py
msgid "RP: Medic"
msgstr "Alias: Médico"

#. ~ Description for RP: Medic
#: lang/json/mutation_from_json.py
msgid ""
"Your job or experiences had you seeing all sorts of trauma, both physical "
"and mental, and you were trusted during the Cataclysm to provide life-saving"
" care.  Has no direct skill benefit, but allows you to present yourself as a"
" healer to certain NPCs.  Some might even recognize you."
msgstr ""
"Tu trabajo o tus experiencias te han llevado a ver todo tipo de traumas, "
"tanto físicos como mentales, y se ha confiado en ti durante el Cataclismo "
"para proporcionar cuidados que salvaron vidas. No tiene ningún beneficio "
"directo a habilidades, pero te permite presentarte como médico ante ciertos "
"PNJs. Algunos podrían incluso reconocerte."

#: lang/json/mutation_from_json.py
msgid "RP: Leader"
msgstr "Alias: Lider"

#. ~ Description for RP: Leader
#: lang/json/mutation_from_json.py
msgid ""
"Whether or not you like it, you've always had a knack for managing people "
"and have some hard-won skill in doing so.  During the arrival and the "
"ensuing chaos, you helped lead people around you to safety.  Has no direct "
"skill benefit, but allows you to present yourself as a leader to certain "
"NPCs.  Some might even recognize you."
msgstr ""
"Te guste o no, siempre has tenido un don para dirigir a la gente y tienes "
"cierta habilidad para hacerlo. Durante la llegada y el consiguiente caos, "
"ayudaste a poner a salvo a la gente que te rodeaba. No tiene ningún "
"beneficio de habilidad directo, pero te permite presentarte como líder ante "
"ciertos PNJs. Algunos podrían incluso reconocerte."

#: lang/json/mutation_from_json.py
msgid "Tyrano Sapien"
msgstr "Tyrano Sapiens"

#. ~ Description for {'str': 'Tyrano Sapien'}
#: lang/json/mutation_from_json.py
msgid ""
"Thunder lizard, dragon, tyrant.  All these names pale before your majesty."
msgstr ""
"Lagarto del trueno, dragón, tirano. Todos estos nombres palidecen ante tu "
"majestad."

#. ~ Description for {'str': 'Stego'}
#: lang/json/mutation_from_json.py
msgid "Slow, methodical, heavily armored.  A walking tank."
msgstr "Lento, metódico, fuertemente blindado. Un tanque andante."

#: lang/json/mutation_from_json.py
msgid "Tough-Skinned"
msgstr "Piel Dura"

#. ~ Description for {'str': 'Tough-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is getting tougher.  Cutting and bash damage are more reduced for "
"you.  Makes you less dextrous though."
msgstr ""
"Tu piel se vuelve más dura. El daño por corte e impacto se ha reducido más "
"para ti. Sin embargo, te hace menos diestro."

#: lang/json/mutation_from_json.py
msgid "Diamond-Skinned"
msgstr "Piel de Diamante"

#. ~ Description for {'str': 'Diamond-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is developing kevlar-like qualities.  Makes you slower though."
msgstr ""
"Tu piel está desarrollando cualidades similares al kevlar. Aunque te hace "
"más lento."

#: lang/json/mutation_from_json.py
msgid "Apatosaurus Back"
msgstr "Vuelta del Apatosaurus"

#. ~ Description for {'str': 'Apatosaurus Back'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying inhuman amounts - more than others with similar "
"strength could.  Your maximum weight carried is increased by 70%."
msgstr ""
"Eres capaz de cargar cantidades inhumanas, más de lo que podrían otros con "
"una fuerza similar. Tu peso máximo transportado se incrementa en un 70%."

#: lang/json/mutation_from_json.py
msgid "Serrated Teeth"
msgstr "Dientes Aserrados"

#. ~ Description for {'str': 'Serrated Teeth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mouth has reshaped to accomodate many serrated teeth.  They make it "
"impossible to wear mouthgear and difficult to eat… but tear giant wounds in "
"your prey."
msgstr ""
"Tu boca se ha reformado para acomodar muchos dientes aserrados. "
"Imposibilitan el uso de un aparato bucal y dificultan la alimentación... "
"pero desgarran heridas gigantescas en tus presas."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your serrated teeth"
msgstr "Desgarras a %s con tus dientes aserrados"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their serrated teeth"
msgstr "%1$s desgarra a %2$s con sus dientes aserrados"

#: lang/json/mutation_from_json.py
msgid "Horned Tail"
msgstr "Cola Cuerno"

#. ~ Description for {'str': 'Horned Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, tail with sharp pointed horns.  It helps you balance"
" a bit but also makes a heavy bludgeon.  Prevents wearing non-fabric pants."
msgstr ""
"Tienes una cola larga y gruesa con cuernos puntiagudos. Te ayuda a "
"equilibrarte un poco, pero también hace de garrote pesado. Impide llevar "
"pantalones que no sean de tejido."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You smash %s with your tail"
msgstr "Aplastas a %s con tu cola"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s smashes %2$s with their tail"
msgstr "%1$s aplasta a %2$s con su cola"

#: lang/json/mutation_from_json.py
msgid "Künstler"
msgstr "Artista"

#. ~ Description for {'str': 'Künstler'}
#: lang/json/mutation_from_json.py
msgid ""
"You have lingering memories of training to fight cyborgs and war machines in"
" zero gravity using the obscure Panzer Kunst."
msgstr ""
"Tienes recuerdos persistentes de entrenamiento para luchar contra cyborgs y "
"máquinas de guerra en gravedad cero usando el oscuro Panzer Kunst."

#: lang/json/mutation_from_json.py
msgid "Drunken Master"
msgstr "Maestro Borracho"

#. ~ Description for {'str': 'Drunken Master'}
#: lang/json/mutation_from_json.py
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr ""
"¡El antiguo arte de las peleas de borrachos es natural para ti! Mientras "
"estás bajo la influencia del alcohol, tu habilidad de cuerpo a cuerpo se "
"incrementa considerablemente, especialmente en el combate sin armas."

#: lang/json/mutation_from_json.py
msgid "Hero's Spirit"
msgstr "Espiritú de Heroe"

#. ~ Description for {'str': "Hero's Spirit"}
#: lang/json/mutation_from_json.py
msgid ""
"You have studied the deeds and legends of ancient heroes.  From your "
"research, you have learned an ancient form of combat called Hylian "
"Swordsmanship."
msgstr ""
"Has estudiado las hazañas y leyendas de antiguos héroes. De tu "
"investigación, has aprendido una antigua forma de combate llamada Manejo de "
"Espada Hylian."

#: lang/json/mutation_from_json.py
msgid "Ki Strike"
msgstr "Golpe Ki"

#. ~ Description for {'str': 'Ki Strike'}
#: lang/json/mutation_from_json.py
msgid ""
"Who needs weapons?  You deal more melee damage while unarmed.  This damage "
"improves as your unarmed skill increases."
msgstr ""
"¿Quién necesita armas? Causás más daño de cuerpo a cuerpo cuando estás "
"desarmado. Este daño aumenta a medida que lo hace tu habilidad desarmado."

#: lang/json/mutation_from_json.py
msgid "Jedi Training"
msgstr "Entrenamiento Jedi"

#. ~ Description for {'str': 'Jedi Training'}
#: lang/json/mutation_from_json.py
msgid ""
"You are trained in the ways of the Jedi.  Your knowledge allows you to "
"utilize a form of lightsaber combat."
msgstr ""
"Estás entrenado en los caminos de los Jedi. Tus conocimientos te permiten "
"utilizar una forma de combate con sable láser."

#: lang/json/mutation_from_json.py
msgid "Pokken Master"
msgstr "Maestro Pokken"

#. ~ Description for {'str': 'Pokken Master'}
#: lang/json/mutation_from_json.py
msgid ""
"You are well versed in the monsterous Pocket Fist martial art.  Train well, "
"because it is your destiny to be a master."
msgstr ""
"Estás bien versado en el monstruoso arte marcial del Puño de Bolsillo. "
"Entrena bien, porque tu destino es ser un maestro."

#: lang/json/mutation_from_json.py
msgid "Martial Adept"
msgstr "Adepto Marcial"

#. ~ Description for {'str': 'Martial Adept'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a martial adept and learned one of the martial disciplines of the "
"Sublime Way.  You start with your choice of Desert Wind, Diamond Mind, Iron "
"Heart, Setting Sun, Stone Dragon, or Tiger Claw."
msgstr ""
"Eres un adepto marcial y has aprendido una de las disciplinas marciales del "
"Camino Sublime. Empiezas con tu elección de Viento del Desierto, Mente de "
"Diamante, Corazón de Hierro, Sol Poniente, Dragón de Piedra o Garra de "
"Tigre."

#. ~ Description for {'str': 'Black Dragon'}
#: lang/json/mutation_from_json.py
msgid ""
"You sometimes think back about the world you left behind.  You're glad you "
"burned it in your wake."
msgstr ""
" A veces piensas en el mundo que dejaste atrás. Te alegras de haberlo "
"quemado a tu paso."

#: lang/json/mutation_from_json.py
msgid "Black Dragon Scales"
msgstr "Escamas de Dragón Negro"

#. ~ Description for {'str': 'Black Dragon Scales'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of heavy black scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also greatly limits your "
"flexibility, resulting in a -4 penalty to Dexterity.  Greatly reduces wet "
"effects."
msgstr ""
"Un conjunto de pesadas escamas negras ha crecido hasta cubrir tu cuerpo, "
"actuando como armadura natural. Aunque es difícil de penetrar, también "
"limita en gran medida tu flexibilidad, lo que supone una penalización de -4 "
"a la Destreza. Reduce en gran medida los efectos por estar mojado."

#: lang/json/mutation_from_json.py
msgid "Clawed Feet"
msgstr "Pies de Garra"

#. ~ Description for {'str': 'Clawed Feet'}
#: lang/json/mutation_from_json.py
msgid ""
"Your toenails have grown long and sharp, preventing you from wearing shoes, "
"but providing you with a set of powerful claws on your feet.  Fortunately "
"they don't impede your movement."
msgstr ""
"Las uñas de tus pies han crecido largas y afiladas, lo que te impide llevar "
"zapatos, pero te proporciona un conjunto de poderosas garras en los pies. "
"Afortunadamente no te impiden el movimiento."

#: lang/json/mutation_from_json.py
msgid "Dragon Clawed Feet"
msgstr "Pies de Garra de Dragón"

#. ~ Description for {'str': 'Dragon Clawed Feet'}
#: lang/json/mutation_from_json.py
msgid ""
"The claws on your toes have developed in to incredibly tough talons.  These "
"are fearsome and powerful, but still prevent you from wearing shoes and "
"slighly impede your movement."
msgstr ""
"Las garras de tus dedos se han convertido en garras increíblemente "
"resistentes. Son temibles y poderosas, pero te impiden llevar calzado y lte "
"dificultan ligeramente el movimiento."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slash %s with your clawed feet"
msgstr "Cortas a %s con tus pies de garra"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slashes %2$s with their clawed feet"
msgstr "%1$s corta a %2$s con sus pies de garra"

#: lang/json/mutation_from_json.py
msgid "Inconvenient Draconic Growth"
msgstr "Crecimiento Dracónico Inconveniente"

#. ~ Description for {'str': 'Inconvenient Draconic Growth'}
#: lang/json/mutation_from_json.py
msgid ""
"You have grown noticeably taller, broader, and menacing.  Much of it is "
"useful muscle mass (Strength +2), but you find it throws off your balance "
"and you get in your own way (+10 torso and arm encumbrance), and you notice "
"people are starting to treat you differently."
msgstr ""
"Has crecido notablemente, eres más ancho y amenazante. Gran parte de ello es"
" masa muscular útil (Fuerza +2), pero te das cuenta de que te hace perder el"
" equilibrio y te incomoda (+10 de incomodidad en el torso y los brazos), y "
"notas que la gente empieza a tratarte de forma diferente."

#: lang/json/mutation_from_json.py
msgid "Draconic Growth"
msgstr "Crecimiento Dracónico"

#. ~ Description for {'str': 'Draconic Growth'}
#: lang/json/mutation_from_json.py
msgid ""
"You carry your rugged body with the dignity you deserve, but are all the "
"more menacing for it.  Strength +2."
msgstr ""
"Llevas tu cuerpo robusto con la dignidad que mereces, pero eres aún más "
"amenazante por ello. Fuerza +2."

#: lang/json/mutation_from_json.py
msgid "Freakish Draconic Maturity"
msgstr "Madurez Draconica Peculiar "

#: lang/json/mutation_from_json.py
msgid "Wyrmling Strength"
msgstr "Fuerza De Nacimiento de Dragón"

#. ~ Description for {'str': 'Wyrmling Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"Your muscles are enhanced by some growing innate magic.  You are slightly "
"stronger.  Strength + 1"
msgstr ""
"Tus músculos están mejorados por una magia innata creciente. Eres "
"ligeramente más fuerte. Fuerza + 1"

#: lang/json/mutation_from_json.py
msgid "Young Dragon Strength"
msgstr "Fuerza de Dragón Joven"

#. ~ Description for {'str': 'Young Dragon Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"The connection to your inner magic is growing and your muscles are stronger,"
" but you're a little more clumsy.  Strength + 3, Dexterity - 1"
msgstr ""
"La conexión con tu magia interior crece y tus músculos son más fuertes, pero"
" eres un poco más torpe. Fuerza + 3, Destreza - 1"

#: lang/json/mutation_from_json.py
msgid "Draconic Strength"
msgstr "Fuerza Dracónica"

#. ~ Description for {'str': 'Draconic Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"The magic within you courses through your muscles, greatly empowering them."
"  This costs you valuable flexibility and coordination, however.  Strength +"
" 5, Dexterity - 2"
msgstr ""
"La magia que hay en tu interior fluye a través de tus músculos, "
"potenciándolos en gran medida. Sin embargo, esto te cuesta una valiosa "
"flexibilidad y coordinación. Fuerza + 5, Destreza - 2"

#: lang/json/mutation_from_json.py
msgid "Ancient Draconic Strength"
msgstr "Fuerza Dracónica Antigua"

#. ~ Description for {'str': 'Ancient Draconic Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"Your internal magic has filled you with unimaginable strength, but you can't"
" move as freely as your form once could.  This is no problem.  Strength + 8,"
" Dexterity - 3"
msgstr ""
"Tu magia interna te ha llenado de una fuerza inimaginable, pero no puedes "
"moverte con la misma libertad que antes. Esto no es un problema. Fuerza + 8,"
" Destreza - 3"

#: lang/json/mutation_from_json.py
msgid "Draconic Maturity"
msgstr "Madurez Dracónica"

#: lang/json/mutation_from_json.py
msgid "Black Dragon Wings"
msgstr "Alas de Dragón Negro"

#. ~ Description for {'str': 'Black Dragon Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, black scaled dragon wings.  While you have control"
" of them and can make attacks with them, they are not large enough nor "
"strong enough to allow you to fly and they throw your off balance, greatly "
"reducing your ability to dodge.  They can be used to cast a protective spell"
" on yourself however."
msgstr ""
"Tienes un par de grandes alas de dragón con escamas negras. Aunque las "
"controlas y puedes atacar con ellas, no son lo suficientemente grandes ni "
"fuertes como para permitirte volar y te desequilibran, reduciendo en gran "
"medida tu capacidad de esquiva. Sin embargo, se pueden utilizar para lanzar "
"un hechizo de protección sobre ti."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bash %s with your powerful wings"
msgstr "Impactas a %s con tus alas poderosas"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bashes %2$s with their powerful wings"
msgstr "%1$s impacta a %2$s con sus poderosas alas"

#: lang/json/mutation_from_json.py
msgid "Overly Acidic Digestion"
msgstr "Digestión Super Ácida"

#. ~ Description for {'str': 'Overly Acidic Digestion'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive issues have developed to become overly acidic which greatly "
"impacts your ability to normally digest food, resulting in getting far less "
"nutrition from the food you eat and making your need to eat more often."
msgstr ""
"Tus órganos digestivos se han desarrollado hasta volverse excesivamente "
"ácidos, lo que afecta en gran medida a tu capacidad para digerir normalmente"
" los alimentos, lo que hace que obtengas mucha menos nutrición de los "
"alimentos que ingiere y que necesites comer más frecuentemente."

#. ~ Description for {'str': 'Black Dragon Breath'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive issues may not have settled entirely, but you can somewhat "
"control them and now you have the ability to spit acid!"
msgstr ""
"¡Tus órganos digestivos no se han resuelto del todo, pero puedes "
"controlarlos un poco y ahora tienes la capacidad de escupir ácido!."

#: lang/json/mutation_from_json.py
msgid "Draconic Heat Dependence"
msgstr "Dependencia de Calor Dracónico"

#. ~ Description for {'str': 'Draconic Heat Dependence'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  Unfortunately, "
"this doesn't seem to help you conserve any energy."
msgstr ""
"La respuesta de tus músculos depende de la temperatura ambiente. Pierdes un "
"1% de tu velocidad por cada 5 (2,8) grados por debajo de 18,3 C (65 F). Por "
"desgracia, esto no parece ayudarte a conservar la energía."

#: lang/json/mutation_from_json.py
msgid "High Draconic Heat Dependence"
msgstr "Dependencia de Calor Dracónico Alta"

#. ~ Description for {'str': 'High Draconic Heat Dependence'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C).  "
"Unfortunately, it seems you have to exert more energy to keep moving."
msgstr ""
"La respuesta de tus músculos depende en gran medida de la temperatura "
"ambiente. Pierdes un 1% de tu velocidad por cada 3 (1,7) grados por debajo "
"de 18,3 C (65 F). Desgraciadamente, parece que tienes que esforzarte más "
"para seguir moviéndote."

#: lang/json/mutation_from_json.py
msgid "Draconic Ectothermia"
msgstr "Sangre Fría Dracónica"

#. ~ Description for {'str': 'Draconic Ectothermia'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  All this and you"
" need even more food to maintain your energy."
msgstr ""
"Tu cuerpo se ha vuelto permanentemente de sangre fría. Tu velocidad baja o "
"sube un 1% por cada 2 (1,1) grados por debajo o por encima de 18,3 C (65 F)."
" Todo esto y necesitas aún más comida para mantener tu energía."

#: lang/json/mutation_from_json.py
msgid "Draconic Magic"
msgstr "Magia Dracónica"

#. ~ Description for {'str': 'Draconic Magic'}
#: lang/json/mutation_from_json.py
msgid ""
"You are imbued with with the ancient magic powers of black dragons, "
"improving your mana reserves and opening your mind to amazing feats of "
"magic."
msgstr ""
"Estás imbuido con los antiguos poderes mágicos de los dragones negros, "
"mejorando tus reservas de maná y abriendo tu mente a asombrosas hazañas de "
"magia."

#: lang/json/mutation_from_json.py
msgid "Draconic Spellcasting"
msgstr "Lanzamiento de Hechizos Dracónicos"

#. ~ Description for {'str': 'Draconic Spellcasting'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mind has fully opened to the power and ancient heritage of dragons.  "
"You can access even greater quantities of mana and you have access to more "
"dragon spells."
msgstr ""
"Tu mente se ha abierto completamente al poder y a la antigua herencia de los"
" dragones. Puedes acceder a cantidades aún mayores de maná y tienes acceso a"
" más hechizos de dragón."

#: lang/json/mutation_from_json.py
msgid "Scaled Mouth"
msgstr "Boca Escamada"

#. ~ Description for {'str': 'Scaled Mouth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scales have grown up and around your mouth, digging into your gums and "
"retracting your lips.  On the down side, it makes speaking difficult.  On "
"the positive side, it makes it very easy to bite things, though what's "
"driving you to do that?"
msgstr ""
"Las escamas han crecido alrededor de tu boca, hundiéndose en tus encías y "
"retrayendo tus labios. En el lado negativo, hace que sea difícil hablar. En "
"el lado positivo, hace que sea muy fácil morder cosas, aunque ¿qué te "
"impulsa a hacer eso?"

#: lang/json/mutation_from_json.py
msgid "Black Dragon Maw"
msgstr "Fauces de Dragón Negro"

#. ~ Description for {'str': 'Black Dragon Maw'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaws have extended to a long, toothy dragon maw.  It's "
"fearsome and causes grievous wounds, but prevents wearing mouth gear."
msgstr ""
"Tu cara y tus mandíbulas se han extendido hasta convertirse en unas largas y"
" dentadas fauces de dragón. Es temible y causa graves heridas, pero impide "
"llevar equipo bucal."

#: lang/json/mutation_from_json.py
msgid "Stubby Reptile Tail"
msgstr "Cola de Reptil Regordeta"

#. ~ Description for {'str': 'Stubby Reptile Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a short, stubby tail that has strange bumps and ridges.  You can "
"wiggle it, but it serves no purpose."
msgstr ""
"Tienes una cola corta y rechoncha con extrañas protuberancias y crestas. "
"Puedes moverla, pero no sirve para nada."

#: lang/json/mutation_from_json.py
msgid "Scaled Reptile Tail"
msgstr "Cola de Reptil Escamada"

#. ~ Description for {'str': 'Scaled Reptile Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, reptile tail.  You can use it decently as a club of "
"sorts, but it's not doing anything to help you balance.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Tienes una larga y gruesa cola de reptil. Puedes usarla decentemente como "
"una especie de garrote, pero no hace nada para ayudarte a mantener el "
"equilibrio. Impide llevar pantalones que no sean de tejido."

#: lang/json/mutation_from_json.py lang/json/technique_from_json.py
msgid "Dragon Tail"
msgstr "Cola de Dragón"

#. ~ Description for {'str': 'Dragon Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, dragonlike tail.  It doesn't help you balance or "
"dodge any better, but it is a powerful bashing weapon.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Tienes una cola larga y gruesa como la de un dragón. No te ayuda a mantener "
"el equilibrio ni a esquivar mejor, pero es un arma poderosa para golpear. "
"Impide llevar pantalones que no sean de tejido."

#: lang/json/mutation_from_json.py
msgid "Scaled Hands"
msgstr "Manos Escamosas"

#. ~ Description for {'str': 'Scaled Hands'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scales have grown to cover your hands and elongate the tips in to "
"jagged claws that can be servicable as cutting and piercing weapons in "
"unarmed combat.  You can still use them normally, but you can't wear gloves."
msgstr ""
"Tus escamas han crecido hasta cubrir tus manos y alargar las puntas en forma"
" de garras dentadas que pueden servir como armas cortantes y perforantes en "
"el combate sin armas. Puedes seguir usándolas normalmente, pero no puedes "
"usar guantes."

#: lang/json/mutation_from_json.py
msgid "Black Dragon Talons"
msgstr "Talones de Dragón Negro"

#. ~ Description for {'str': 'Black Dragon Talons'}
#: lang/json/mutation_from_json.py
msgid ""
"All of your fingers have developed into huge scaled talons.  They prevent "
"wearing gloves, but you can use them to powerful effect in melee combat and "
"you appear to have uncovered some secrets about black dragons."
msgstr ""
"Todos tus dedos se han convertido en enormes garras con escamas. Impiden el "
"uso de guantes, pero puedes utilizarlas con gran efecto en el combate cuerpo"
" a cuerpo y parece que has descubierto algunos secretos sobre los dragones "
"negros."

#: lang/json/mutation_from_json.py
msgid "Artificer"
msgstr "Artifice"

#. ~ Description for {'str': 'Artificer'}
#: lang/json/mutation_from_json.py
msgid ""
"With the mechanically-minded Technomancer and the sheer power of lightning "
"from a Stormshaper, the Artificer has a unique confluence of skills and "
"spells to be perfect for invention.  While modern inventions and machines "
"have won out in a modern society, after a cataclysm one has a chance to go "
"back to roots of things.  To make weird gadgets that are just as likely to "
"explode as explode the thing you're pointing at."
msgstr ""
"Con la mentalidad mecánica del Tecnomante y el gran poder del rayo de un "
"Moldeador de Tormentas, el Artifice tiene una confluencia única de "
"habilidades y hechizos para ser perfecto para la invención. Mientras que los"
" inventos y las máquinas modernas han triunfado en una sociedad moderna, "
"tras un cataclismo se tiene la oportunidad de volver a las raíces de las "
"cosas. De fabricar artilugios extraños que tengan la misma probabilidad de "
"explotarte a ti que a la cosa a la que estas apuntando."

#: lang/json/mutation_from_json.py
msgid "Aura Mage"
msgstr "Aura de Mago"

#: lang/json/mutation_from_json.py
msgid "Biotek"
msgstr "Biotécnico"

#. ~ Description for {'str': 'Biotek'}
#: lang/json/mutation_from_json.py
msgid ""
"The Biotek is quite simply the marriage of technology and flesh.  It was not"
" even discovered as an attunement until recent times due to the great "
"advancements in technology in the last 50 years.  The Biotek is unique as it"
" is the only known attunement that warps the Aethereum in such a way as to "
"allow cybernetics to coincide with magical abilities, to an extent."
msgstr ""
"El Biotécnico es simplemente la unión de la tecnología y la carne. No se "
"descubrió como una sintonía hasta hace poco, debido a los grandes avances "
"tecnológicos de los últimos 50 años. El Biotécnico es único, ya que es la "
"única sintonización conocida que deforma el Aethereum de tal manera que "
"permite que la cibernética coincida con las habilidades mágicas, hasta "
"cierto punto."

#: lang/json/mutation_from_json.py
msgid "Blood Mage"
msgstr "Maga de Sangre"

#. ~ Description for {'str': 'Blood Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Animists are known for their blood magic, and being a Biomancer you are able"
" to take it another step further by strengthening your blood.  The dark arts"
" have opened to you, and while dangerous, are incredible to behold."
msgstr ""
"Los animistas son conocidos por su magia de sangre, y al ser un Biomántico "
"eres capaz de llevarla un paso más allá fortaleciendo tu sangre. Las artes "
"oscuras se han abierto para ti, y aunque son peligrosas, son increíbles de "
"presenciar."

#: lang/json/mutation_from_json.py
msgid "Boreal Mage"
msgstr "Mago Boreal"

#. ~ Description for {'str': 'Boreal Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Named for the auroras that grace the poles of the earth, the Boreal mage "
"specializes in auras that protect ethereally.  Boreal mages definitely know "
"their way around cold spells, but their real strength is protection."
msgstr ""
"Llamado así por las auroras que adornan los polos de la tierra, el mago "
"Boreal se especializa en auras que protegen de forma etéreamente. Los magos "
"Boreales conocen bien los hechizos de frío, pero su verdadero punto fuerte "
"es la protección."

#: lang/json/mutation_from_json.py
msgid "Cleansing Flame"
msgstr "Llama Purificadora"

#. ~ Description for {'str': 'Cleansing Flame'}
#: lang/json/mutation_from_json.py
msgid ""
"The Cleansing Flame is the fire that burns away the chaff, in preparation "
"for the regrowth of new life."
msgstr ""
"La Llama Purificadora es el fuego que quema la paja, en preparación para el "
"rebrote de la nueva vida."

#: lang/json/mutation_from_json.py
msgid "Crusader"
msgstr "Cruzado"

#. ~ Description for {'str': 'Crusader'}
#: lang/json/mutation_from_json.py
msgid ""
"The Crusader attunement is a clashing dichotomy of Man and Nature.  "
"Utilizing man's propensity for tools and nature's resilience, the Crusader "
"is a juggernaut in armed combat."
msgstr ""
"La sintonía del Cruzado es una dicotomía de choque entre el Hombre y la "
"Naturaleza. Utilizando la propensión del hombre a las herramientas y la "
"adaptación de la naturaleza, el Cruzado es un monstruo en el combate armado."

#: lang/json/mutation_from_json.py
msgid "Earth Elemental"
msgstr "Elemental de Tierra"

#. ~ Description for {'str': 'Earth Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"Stone is superior to flesh.  You have allowed this axiom into your life, and"
" work to correct your own weakness with biomancy.  The strength of the Earth"
" rushed up to meet you with open arms."
msgstr ""
"La piedra es superior a la carne. Has permitido que este axioma entre en tu "
"vida, y trabajas para corregir tu propia debilidad con la biomancia. La "
"fuerza de la Tierra se apresuró a recibirte con los brazos abiertos."

#: lang/json/mutation_from_json.py
msgid "Fire Elemental"
msgstr "Elemental de Fuego"

#. ~ Description for {'str': 'Fire Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"You have used your expertise in Biomancy to change your body more toward "
"your affinity for fire as a Kelvinist.  Fire doesn't bother you as much "
"anymore, and your blood is flammable when it touches the air, resulting in a"
" gout of flame when something hurts you.  You are also starting to study "
"more spells that focus on using your own body's affinity for fire."
msgstr ""
"Has utilizado tu experiencia en Biomancia para cambiar tu cuerpo más hacia "
"tu afinidad por el fuego como Kelvinista. El fuego ya no te molesta tanto, y"
" tu sangre es inflamable cuando entra en contacto con el aire, lo que da "
"lugar a una ráfaga de llamas cuando algo te hiere. También empiezas a "
"estudiar más hechizos que se centran en utilizar la afinidad de tu propio "
"cuerpo por el fuego."

#: lang/json/mutation_from_json.py
msgid "Force Mage"
msgstr "Mago  de Fuerza"

#. ~ Description for {'str': 'Force Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Force = Mass x Acceleration.  This is the typical thing that people think of"
" nowadays when the word is used, but Force Mages have a different meaning, "
"coming from traditional roots: untyped magical damage appears to be a "
"ghostly \"force.\"  This might be the effect of the attunement, but the "
"cause is even more intriguing: they appear to turn Newton's Third Law on its"
" head.  Magical scholars of the 21st century have theorized that this isn't "
"really the case; instead of the opposite reaction happening on this plane of"
" existence, a Force Mage uses the Aetherium's alternate Laws to rebound the "
"force back upon itself, effectively doubling the force in the same direction"
" instead.  However this ability comes with limitations, as the Force Mage "
"can only do this for melee damage."
msgstr ""
"Fuerza = Masa x Aceleración. Esto es lo típico en lo que piensa la gente hoy"
" en día cuando se usa la palabra, pero los Magos de la Fuerza tienen un "
"significado diferente, que proviene de raíces tradicionales: el daño mágico "
"no tipificado parece ser una \"fuerza\" fantasmal. Esto podría ser el efecto"
" de la sintonía, pero la causa es aún más intrigante: parecen darle la "
"vuelta a la Tercera Ley de Newton. Los estudiosos de la magia del siglo XXI "
"han teorizado que esto no es realmente así; en lugar de que la reacción "
"opuesta se produzca en este plano de existencia, un Mago de la Fuerza "
"utiliza las Leyes alternativas del Aetherium para hacer rebotar la fuerza "
"sobre sí mismo, duplicando efectivamente la fuerza en la misma dirección. "
"Sin embargo, esta habilidad tiene sus limitaciones, ya que el Mago de la "
"Fuerza sólo puede hacer esto para el daño cuerpo a cuerpo."

#: lang/json/mutation_from_json.py
msgid "Gaia's Chosen"
msgstr "Elegido de Gaia"

#. ~ Description for {'str': "Gaia's Chosen"}
#: lang/json/mutation_from_json.py
msgid ""
"The Champion of the Earth, Gaia's Chosen is blessed on all things nature, "
"animate and inanimate."
msgstr ""
"El Campeón de la Tierra, el Elegido de Gaia está bendecido por todas las "
"cosas de la naturaleza, animadas e inanimadas."

#: lang/json/mutation_from_json.py
msgid "Glacier Mage"
msgstr "Mago Glacial"

#. ~ Description for {'str': 'Glacier Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The power of a Glacier Mage is backed by a thousand tons of ice and snow, "
"with a brutal might in their spells.  While they are skilled with cold "
"spells, their greatest strength is in offense."
msgstr ""
"El poder de un Mago Glaciar está respaldado por mil toneladas de hielo y "
"nieve, con una fuerza brutal en sus hechizos. Aunque son hábiles con los "
"hechizos de frío, su mayor fuerza está en la ofensiva."

#: lang/json/mutation_from_json.py
msgid "Golemancer"
msgstr "Golemántico"

#. ~ Description for {'str': 'Golemancer'}
#: lang/json/mutation_from_json.py
msgid ""
"The Golemancer is the ancient myth of the clay golem, made reality from "
"constant use of Animist summons and Earthshaper self-strengthening spells.  "
"Takes some traits from the golems they create, such as immunity to slowing "
"effects."
msgstr ""
"El Golemántico es el antiguo mito del gólem de arcilla, hecho realidad por "
"el uso constante de invocaciones animistas y hechizos de autofortalecimiento"
" del Terraformante. Toma algunos rasgos de los gólems que crea, como la "
"inmunidad a los efectos de ralentización."

#: lang/json/mutation_from_json.py
msgid "Gravity Mage"
msgstr "Mago de Gravedad"

#. ~ Description for {'str': 'Gravity Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The fundamental Laws of the universe are thought of as the end-all-be-all in"
" magical circles, and the Gravity Mage is a result of mages mucking around "
"with those laws.  Unfortunately, this attunement does not give supreme "
"control over gravity as a fundamental force, though the affinity is "
"prominent and comes with some non-negligible benefits."
msgstr ""
"En los círculos mágicos se considera que las Leyes fundamentales del "
"universo son el fin de todo, y el Mago de la Gravedad es el resultado de los"
" magos que juegan con esas leyes. Desgraciadamente, esta sintonía no da un "
"control supremo sobre la gravedad como fuerza fundamental, aunque la "
"afinidad es prominente y viene con algunos beneficios no despreciables."

#: lang/json/mutation_from_json.py
msgid "Overclocker"
msgstr "Overclocker"

#. ~ Description for {'str': 'Overclocker'}
#: lang/json/mutation_from_json.py
msgid ""
"The Technomancer specializes in augmenting humans without actually modifying"
" them; and the Overclocker takes the heat aptitude of a Kelvinist and puts "
"that to work.  You are able to think significantly faster, and are able to "
"align your leylines for spellcasting faster as a result."
msgstr ""
"El Tecnomante se especializa en aumentar a los humanos sin modificarlos "
"realmente; y el Overclocker toma la aptitud térmica de un Kelvinista y la "
"pone en práctica. Es capaz de pensar mucho más rápido y, como resultado, "
"puede alinear sus líneas maestras para lanzar hechizos con mayor rapidez."

#: lang/json/mutation_from_json.py
msgid "Ice Elemental"
msgstr "Elemental de Hielo"

#. ~ Description for {'str': 'Ice Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"Through your power in Biomancy, you have changed your body towards your "
"Kelvinist affinity for ice.  Extreme cold has less effect on you, and your "
"superchilled skin causes frostbite when touching others.  You're also "
"starting to research more magic that focuses on your body's inherent ice "
"affinity."
msgstr ""
"Gracias a tu poder en Biomancia, has cambiado tu cuerpo hacia tu afinidad "
"kelvinista por el hielo. El frío extremo te afecta menos, y tu piel "
"supercongelada provoca congelaciones al tocar a otros. También estás "
"empezando a investigar más magia que se centra en la afinidad de hielo "
"inherente a tu cuerpo."

#: lang/json/mutation_from_json.py
msgid "Illusionist"
msgstr "Ilusionista"

#. ~ Description for {'str': 'Illusionist'}
#: lang/json/mutation_from_json.py
msgid ""
"Through the fine manipulation of light, an Illusionist might craft "
"deceptively convincing and dangerous illusions.  An Illusionist excels at "
"avoiding direct confrontation, instead relying on decoys and traps to slip "
"by undetected."
msgstr ""
"A través de la manipulación de la luz, el ilusionista puede fabricar "
"ilusiones convincentes y peligrosas. Un ilusionista es excelente para evitar"
" la confrontación directa y, en su lugar, confía en los señuelos y las "
"trampas para pasar desapercibido."

#: lang/json/mutation_from_json.py
msgid "Magnetism Mage"
msgstr "Mago Magnético"

#: lang/json/mutation_from_json.py
msgid "Permafrost Mage"
msgstr "Mago Permafrost"

#: lang/json/mutation_from_json.py
msgid "Radiation Mage"
msgstr "Mago de Radiación"

#. ~ Description for {'str': 'Radiation Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The Radiation mage was discovered as an attunement in the 20th century, "
"closely guarded as a military secret in close relation to the Manhatten "
"Project.  It was declassified in 1989 as a part of the attunement awareness "
"movement, but it is still poorly understood even by the very few researchers"
" that wrote books on attunements."
msgstr ""
"El Mago de Radiación fue descubierto como una sintonía en el siglo XX, "
"guardado como un secreto militar en estrecha relación con el Proyecto "
"Manhattan. Fue desclasificado en 1989 como parte del movimiento de "
"concienciación de la sintonía, pero sigue siendo poco conocido incluso por "
"los pocos investigadores que escribieron libros sobre las sintonías."

#: lang/json/mutation_from_json.py
msgid "Shaman"
msgstr "Chamán"

#. ~ Description for {'str': 'Shaman'}
#: lang/json/mutation_from_json.py
msgid ""
"Deeply attuned to the spiritual fabric that shapes and nurtures the natural "
"world.  Shamans call upon the primeval spirits of nature for aid and advice."
"  Be careful however, for ancient spirits are fickle and unknowable things."
msgstr ""
"Profundamente en sintonía con el tejido espiritual que da forma y nutre el "
"mundo natural. Los chamanes invocan a los espíritus primigenios de la "
"naturaleza en busca de ayuda y consejo. Sin embargo, hay que tener cuidado, "
"ya que los espíritus ancestrales son cosas volubles e incognoscibles."

#: lang/json/mutation_from_json.py
msgid "Shapeshifter"
msgstr "Cambiaformas"

#. ~ Description for {'str': 'Shapeshifter'}
#: lang/json/mutation_from_json.py
msgid ""
"The shapeshifter is the Biomancer refined - able to use a flicker of mana to"
" change shape at the drop of a hat to make yourself more inviting or shape "
"others into desired shapes."
msgstr ""
"El cambiaformas es el Biomántico refinado, capaz de utilizar un destello de "
"maná para cambiar de forma a la primera de cambio para hacerse más atractivo"
" o moldear a otros en formas deseadas."

#: lang/json/mutation_from_json.py
msgid "Soulfire"
msgstr "Alma de Fuego"

#. ~ Description for {'str': 'Soulfire'}
#: lang/json/mutation_from_json.py
msgid ""
"The Soulfire is a phenomena of the caster's spirit binding to a fragment of "
"a spirit of flame.  This makes it possible for the Soulfire to use its "
"namesake as an element - much like fire, it does burn, but it burns away at "
"the soul instead of the flesh."
msgstr ""
"El Alma de Fuego es un fenómeno del espíritu del lanzador que se une a un "
"fragmento de un espíritu de llama. Esto hace posible que el Alma de Fuego "
"utilice su homónimo como elemento - como el fuego, quema, pero quema el alma"
" en lugar de la carne."

#: lang/json/mutation_from_json.py
msgid "Storm Elemental"
msgstr "Elemental de Tormenta"

#. ~ Description for {'str': 'Storm Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"You've used your knowledge of Biomancy to change your body into a form "
"befitting a Stormshaper.  You can better withstand the power of electricity,"
" and sparks leap from your skin when something hits you.  You're beginning "
"to study spells that utilize your body's affinity for the electric."
msgstr ""
"Has utilizado tus conocimientos de Biomancia para transformar tu cuerpo en "
"una forma propia de un Moldeador de Tormentas. Puedes soportar mejor el "
"poder de la electricidad y las chispas saltan de tu piel cuando algo te "
"golpea. Estás empezando a estudiar hechizos que utilizan la afinidad de tu "
"cuerpo con la electricidad."

#: lang/json/mutation_from_json.py
msgid "Stormcaller"
msgstr "Invocador de Tormentas"

#. ~ Description for {'str': 'Stormcaller'}
#: lang/json/mutation_from_json.py
msgid ""
"A stormcaller is a stormshaper with an additional affinity toward the "
"weather in a localized area.  Historians agree that the druid requirement "
"has something to do with the Druid's affinity for nature, just like their "
"ability to summon animals.  You will know a stormcaller is in the room if "
"your ears pop and your hair stands straight on end.  Stormcallers are not "
"known for their subtlety."
msgstr ""
"Un invocador de tormentas es un moldeador de tormentas con una afinidad "
"adicional hacia el clima en un área localizada. Los historiadores coinciden "
"en que el requisito de druida tiene algo que ver con la afinidad del druida "
"por la naturaleza, al igual que su capacidad de invocar animales. Sabrás que"
" hay un invocador de tormentas en la habitación si se te erizan las orejas y"
" se te ponen los pelos de punta. Los invocadores de tormentas no son "
"conocidos por su sutileza."

#: lang/json/mutation_from_json.py
msgid "Sun Mage"
msgstr "Mago de Sol"

#. ~ Description for {'str': 'Sun Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The Sun Mage has been studying the Laws governing heat, and has attained a "
"special relationship with that life-giving yellow orb in the sky.  Glimpses "
"of the Sun meet its foes, and its own burning light pierces the darkness."
msgstr ""
"El Mago del Sol ha ido estudiando las leyes que rigen el calor, y ha "
"alcanzado una relación especial con ese orbe amarillo que da vida en el "
"cielo. Los destellos del Sol se encuentran con tus enemigos, y su propia luz"
" ardiente atraviesa la oscuridad."

#: lang/json/mutation_from_json.py
msgid "Tundra Mage"
msgstr "Mago de la Tundra"

#. ~ Description for {'str': 'Tundra Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The barren cold of the world's far reaches flows through the Tundra Mage.  "
"They find power in the all-pervasive frost of the North and in the creatures"
" that defy its deathly chill."
msgstr ""
"El frío estéril de los confines del mundo fluye a través del Mago de la "
"Tundra. Encuentran su poder en la helada omnipresente del Norte y en las "
"criaturas que desafían su frío mortal."

#: lang/json/mutation_from_json.py
msgid "Void Mage"
msgstr "Mago de Vacio"

#. ~ Description for {'str': 'Void Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Where there is nothing, there is still power, and the Void Mages embody that"
" power.  The ability to wield emptiness itself is at their fingertips, and "
"no living creature can withstand the call of the void."
msgstr ""
"Donde no hay nada, sigue habiendo poder, y los Magos del Vacío encarnan ese "
"poder. La capacidad de manejar el vacío mismo está en la punta de sus dedos,"
" y ninguna criatura viviente puede resistir la llamada del vacío."

#: lang/json/mutation_from_json.py
msgid "Vulcanist"
msgstr "Vulcanista"

#. ~ Description for {'str': 'Vulcanist'}
#: lang/json/mutation_from_json.py
msgid ""
"One of the most destructive forces on earth, a Volcano Mage takes some "
"aspect of its namesake.  Their spells tend to be a little slow, but their "
"resilience in proximity to a volcano is legendary."
msgstr ""
"Una de las fuerzas más destructivas de la tierra, un Mago Volcán toma algún "
"aspecto de su homónimo. Sus hechizos suelen ser un poco lentos, pero su "
"resistencia en las proximidades de un volcán es legendaria."

#: lang/json/mutation_from_json.py
msgid "Wither Mage"
msgstr "Mago Marchitador"

#. ~ Description for {'str': 'Wither Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"While biomancers focus on both life and death; Wither Mages set their sights"
" on the transitional period between these two stages.  They wield entropy "
"and decay hand and hand, using it to enhance their combat prowess to "
"surgical precision.  This confluence of abilities are what lead to assassin "
"mages gaining this attunement."
msgstr ""
"Mientras que los biománticos se centran en la vida y en la muerte, los Magos"
" Marchitadores se centran en el periodo de transición entre estas dos "
"etapas. Manejan la entropía y la decadencia mano a mano, y la utilizan para "
"mejorar su destreza en el combate con una precisión quirúrgica. Esta "
"confluencia de habilidades es lo que lleva a los magos asesinos a obtener "
"esta sintonía."

#: lang/json/mutation_from_json.py
msgid "Magus"
msgstr "Magus"

#. ~ Description for Magus
#: lang/json/mutation_from_json.py
msgid ""
"A tradition as old as magic, the Magus focuses on binding and shaping the "
"energy of the universe to their will."
msgstr ""
"Una tradición tan antigua como la magia, el Magus se centra en unir y dar "
"forma a la energía del universo a su voluntad."

#: lang/json/mutation_from_json.py
msgid "Animist"
msgstr "Animista"

#. ~ Description for {'str': 'Animist'}
#: lang/json/mutation_from_json.py
msgid ""
"The animist tradition is a relatively new school of magical thought, formed "
"through combination of many older ways that focus on harmony and connection "
"to the natural world.  This does not mean that animists are passive: the "
"natural world is a savage place."
msgstr ""
"La tradición animista es una escuela relativamente nueva de pensamiento "
"mágico, formada a través de la combinación de muchas formas antiguas que se "
"centran en la armonía y la conexión con el mundo natural. Esto no significa "
"que los animistas sean pasivos: el mundo natural es un lugar salvaje."

#: lang/json/mutation_from_json.py
msgid "Kelvinist"
msgstr "Kelvinista"

#. ~ Description for Kelvinist
#: lang/json/mutation_from_json.py
msgid ""
"Disciples of the great Archwizard Lord Kelvin.  Kelvinists focus their magic"
" on manipulation and control of the temperature of their environment, "
"leading to spectacularly powerful explosions or bone-chilling cold."
msgstr ""
"Discípulos del gran Archimago Lord Kelvin. Los kelvinistas centran su magia "
"en la manipulación y el control de la temperatura de su entorno, lo que "
"lleva a explosiones espectacularmente poderosas o a un frío escalofriante."

#: lang/json/mutation_from_json.py
msgid "Stormshaper"
msgstr "Moldeador de Tormentas"

#. ~ Description for Stormshaper
#: lang/json/mutation_from_json.py
msgid ""
"Stormshapers follow ancient arcane disciplines of meditation and harmony "
"with the winds and tides that shape the planet.  Through their deep "
"connection to these forces, they can request powerful changes."
msgstr ""
"Los Moldeadores de Tormentas siguen antiguas disciplinas arcanas de "
"meditación y armonía con los vientos y las mareas que dan forma al planeta. "
"A través de su profunda conexión con estas fuerzas, pueden solicitar cambios"
" poderosos."

#: lang/json/mutation_from_json.py
msgid "Technomancer"
msgstr "Tecnomante"

#. ~ Description for Technomancer
#: lang/json/mutation_from_json.py
msgid ""
"Technomancers are the new breed of modern magician, blending their arcane "
"might with their advanced knowledge of the fundamental nature of the "
"universe.  They use technology to enhance their magic and vice versa."
msgstr ""
"Los tecnomantes son la nueva raza de magos modernos, que combinan su poder "
"arcano con su avanzado conocimiento de la naturaleza fundamental del "
"universo. Utilizan la tecnología para mejorar su magia y viceversa."

#: lang/json/mutation_from_json.py
msgid "Earthshaper"
msgstr "Terraformante"

#. ~ Description for Earthshaper
#: lang/json/mutation_from_json.py
msgid ""
"Earthshapers have allowed their minds to sink deep within the stones and "
"metals of the planet, and become one with its secrets.  To a master "
"Earthshaper, spells can be as permanent as the stones they are created from,"
" and time is measured in geological eras."
msgstr ""
"Los Terraformantes han permitido que sus mentes se hundan en lo profundo de "
"las piedras y metales del planeta, y se conviertan en uno con sus secretos. "
"Para un maestro Terraformante, los hechizos pueden ser tan permanentes como "
"las piedras de las que se crean, y el tiempo se mide en eras geológicas."

#: lang/json/mutation_from_json.py
msgid "Biomancer"
msgstr "Biomántico"

#. ~ Description for {'str': 'Biomancer'}
#: lang/json/mutation_from_json.py
msgid ""
"The Biomancer focuses on manipulating and even absorbing flesh; their own, "
"and that of other living or dead things.  Most other wizards find their "
"powers gross and disturbing, but no one can question the potency of their "
"abilities, and certainly not their adaptability to any situation."
msgstr ""
"El Biomántico se centra en manipular e incluso absorber la carne; la suya "
"propia y la de otras cosas vivas o muertas. La mayoría de los otros magos "
"encuentran sus poderes burdos y perturbadores, pero nadie puede cuestionar "
"la potencia de sus habilidades, y ciertamente no su adaptabilidad a "
"cualquier situación."

#: lang/json/mutation_from_json.py
msgid "Druid"
msgstr "Druida"

#. ~ Description for Druid
#: lang/json/mutation_from_json.py
msgid ""
"Druids follow a wild tradition of allegiance and rebirth within the world of"
" nature, especially the cycle of death and rebirth that is the plant world."
"  A powerful Druid is as much a part of that world as the human one."
msgstr ""
"Los Druidas siguen una tradición salvaje de lealtad y renacimiento dentro "
"del mundo de la naturaleza, especialmente el ciclo de muerte y renacimiento "
"que es el mundo vegetal. Un poderoso Druida es tan parte de este mundo como "
"el humano."

#. ~ Description for {'str': 'Manatouched'}
#: lang/json/mutation_from_json.py
msgid "Magic is in you.  Magic is you."
msgstr "La magia está en ti. La magia eres tú."

#: lang/json/mutation_from_json.py
msgid "Mana Solidification"
msgstr "Solidificación de Maná"

#. ~ Description for {'str': 'Mana Solidification'}
#: lang/json/mutation_from_json.py
msgid ""
"Your internal ley lines have become much easier for you to control, "
"resulting in you being able to naturally create crystallized mana."
msgstr ""
"Tus líneas de ley internas se han vuelto mucho más fáciles de controlar, lo "
"que te permite crear maná cristalizado de forma natural."

#. ~ Description for {'str': 'Seeker Bolts'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hands glow with mana energy.  You can fire seeker bolts from your "
"fingertips."
msgstr ""
"Tus manos brillan con energía de maná. Puedes disparar saetas buscadores "
"desde la punta de tus dedos."

#: lang/json/mutation_from_json.py
msgid "Subtle Spell"
msgstr "Hechizo Sutil"

#. ~ Description for {'str': 'Subtle Spell'}
#: lang/json/mutation_from_json.py
msgid ""
"You no longer need to move your arms to cast spells, due to your ley lines "
"becoming untethered from your arms.  Arm encumbrance no longer applies to "
"spell failure chance."
msgstr ""
"Ya no necesitas mover los brazos para lanzar hechizos, ya que tus líneas ley"
" se han desvinculado de tus brazos. La incomodidad de tus brazos ya no se "
"aplica a la probabilidad de fallo de los hechizos."

#: lang/json/mutation_from_json.py
msgid "Silent Spell"
msgstr "Hechizo Silencioso"

#. ~ Description for {'str': 'Silent Spell'}
#: lang/json/mutation_from_json.py
msgid ""
"You no longer need to use your voice to enforce your will upon the world.  "
"Mouth encumbrance no longer applies to spell failure chance."
msgstr ""
"Ya no necesitas usar tu voz para imponer tu voluntad al mundo. La "
"incomodidad de la boca ya no se aplica a la probabilidad de fallo del "
"hechizo."

#: lang/json/mutation_from_json.py
msgid "Weak"
msgstr "Débil"

#. ~ Description for {'str': 'Weak'}
#: lang/json/mutation_from_json.py
msgid "Your body is unnaturally weak.  -2 Strength."
msgstr "Tu cuerpo es anormalmente débil. -2 Fuerza."

#: lang/json/mutation_from_json.py
msgid "Mana Luminance"
msgstr "Luminosidad del maná"

#. ~ Description for {'str': 'Mana Luminance'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body discards unusable mana as light and heat, making you glow softly."
msgstr ""
"Tu cuerpo desecha el maná inutilizable de manera de luz y calor, haciendo "
"que brilles levemente."

#. ~ Description for {'str': 'Mana Siphon'}
#. ~ Description for {'str': 'Mana Drain'}
#. ~ Description for {'str': 'Mana Vortex'}
#: lang/json/mutation_from_json.py
msgid ""
"Violence excites your ley lines.  Whenever you hit an enemy in melee, you "
"have a chance of regaining some mana."
msgstr ""
"La violencia excita tus líneas ley. Cada vez que golpeas a un enemigo en el "
"cuerpo a cuerpo, tienes la posibilidad de recuperar algo de maná."

#: lang/json/mutation_from_json.py
msgid "Mana Drain"
msgstr "Drenaje de Maná"

#: lang/json/mutation_from_json.py
msgid "Mana Vortex"
msgstr "Vortice de Maná"

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Efficiency"
msgstr "Eficiencia de Maná  Tocado por Maná"

#. ~ Description for {'str': 'Manatouched Mana Efficiency'}
#. ~ Description for Greater Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a lot more mana in your body than usual."
msgstr "Eres capaz de almacenar mucho más maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Regeneration"
msgstr " Regeneración de Maná de Tocado por Maná"

#. ~ Description for Manatouched Mana Regeneration
#. ~ Description for Greater Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is much faster than normal."
msgstr "La regeneración natural de maná es mucho más rápida de lo normal."

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Sensitivity"
msgstr "Sensibilidad de Maná de Tocado por Maná"

#. ~ Description for Manatouched Mana Sensitivity
#. ~ Description for Greater Mana Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"You can sense the mana in your body much better than normal, allowing you to"
" tap into more of your reserves."
msgstr ""
"Puedes sentir el maná en tu cuerpo mucho mejor de lo normal, permitiéndote "
"aprovechar más de tus reservas."

#: lang/json/mutation_from_json.py
msgid "Lesser Mana Efficiency"
msgstr "Eficiencia de Maná Menor"

#. ~ Description for Lesser Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a little more mana in your body than usual."
msgstr ""
"Eres capaz de almacenar un poco más de maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Mana Efficiency"
msgstr "Eficiencia de Maná"

#. ~ Description for Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store more mana in your body than usual."
msgstr "Eres capaz de almacenar más maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Greater Mana Efficiency"
msgstr "Eficiencia de Maná Mayor"

#: lang/json/mutation_from_json.py
msgid "Lesser Mana Inefficiency"
msgstr "Ineficiencia de Maná Menor"

#. ~ Description for Lesser Mana Inefficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a little less mana in your body than usual."
msgstr ""
"Eres capaz de almacenar un poco menos de maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Mana Inefficiency"
msgstr "Ineficiencia de Maná"

#. ~ Description for Mana Inefficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store less mana in your body than usual."
msgstr "Eres capaz de almacenar menos maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Greater Mana Inefficiency"
msgstr "Ineficiencia de Maná Mayor"

#. ~ Description for Greater Mana Inefficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a lot less mana in your body than usual."
msgstr "Eres capaz de almacenar mucho menos maná en tu cuerpo de lo habitual."

#: lang/json/mutation_from_json.py
msgid "Lesser Mana Regeneration"
msgstr "Regeneración menor de maná"

#. ~ Description for Lesser Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is slightly faster than normal."
msgstr ""
"La regeneración natural del maná es ligeramente más rápida de lo normal."

#: lang/json/mutation_from_json.py
msgid "Mana Regeneration"
msgstr "Regeneración de Maná"

#. ~ Description for Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is faster than normal."
msgstr "Tu regeneración de maná natural es más rápida de lo normal."

#: lang/json/mutation_from_json.py
msgid "Greater Mana Regeneration"
msgstr "Gran Regeneración de Maná"

#: lang/json/mutation_from_json.py
msgid "Poor Mana Regeneration"
msgstr "Regeneración Pobre de Maná"

#. ~ Description for Poor Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is slightly slower than normal."
msgstr ""
"La regeneración natural del maná es ligeramente más lenta de lo normal."

#: lang/json/mutation_from_json.py
msgid "Very Poor Mana Regeneration"
msgstr "Regeneración Mínima de Maná "

#. ~ Description for Very Poor Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is slower than normal."
msgstr "Se frena la regeneración de Maná."

#: lang/json/mutation_from_json.py
msgid "Abysmal Mana Regeneration"
msgstr "Frenado Abismal de Maná"

#. ~ Description for {'str': 'Abysmal Mana Regeneration'}
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is much slower than normal."
msgstr "Se frena una gran cantidad la regeneración de Manáe"

#: lang/json/mutation_from_json.py
msgid "Lesser Mana Sensitivity"
msgstr "Sensibilidad Menor al Maná"

#. ~ Description for Lesser Mana Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"You can sense the mana in your body slightly better than normal, allowing "
"you to tap into more of your reserves."
msgstr ""
"Puedes sentir el maná en tu cuerpo un poco mejor de lo normal, lo que te "
"permite aprovechar más tus reservas."

#: lang/json/mutation_from_json.py
msgid "Mana Sensitivity"
msgstr "Sensibilidad al Maná"

#. ~ Description for Mana Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"You can sense the mana in your body better than normal, allowing you to tap "
"into more of your reserves."
msgstr ""
"Puedes sentir el maná en tu cuerpo mejor de lo normal, lo que te permite "
"aprovechar más tus reservas."

#: lang/json/mutation_from_json.py
msgid "Greater Mana Sensitivity"
msgstr "Gran Sensibilidad al Maná"

#: lang/json/mutation_from_json.py
msgid "Poor Mana Sensitivity"
msgstr "Sensibilidad Pobre de Maná"

#. ~ Description for Poor Mana Sensitivity
#. ~ Description for Very Poor Mana Sensitivity
#. ~ Description for {'str': 'Abysmal Mana Sensitivity'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time sensing the mana in your body, making less of your "
"reserves available for use."
msgstr ""
"Te cuesta sentir el maná en tu cuerpo, lo que hace que menos de tus reservas"
" estén disponibles para su uso."

#: lang/json/mutation_from_json.py
msgid "Very Poor Mana Sensitivity"
msgstr "Sensibilidad Muy Pobre de Maná"

#: lang/json/mutation_from_json.py
msgid "Abysmal Mana Sensitivity"
msgstr "Insensibilidad Abismal de Maná"

#: lang/json/mutation_from_json.py
msgid "Debug Spell Mutation"
msgstr "Depurar Hechizo Mutación "

#. ~ Description for Debug Spell Mutation
#: lang/json/mutation_from_json.py
msgid "Gives all of the debug spells at max level."
msgstr "Otorga todos los hechizos de depuración al máximo nivel."

#: lang/json/mutation_from_json.py
msgid "Wildshape: Fish"
msgstr "Forma Salvaje: Pescado"

#. ~ Description for {'str': 'Wildshape: Fish'}
#: lang/json/mutation_from_json.py
msgid ""
"You are fish-like, making dexterous manipulation with your hands extremely "
"difficult."
msgstr ""
"Tienes forma de pez, lo que dificulta enormemente la manipulación diestra "
"con tus manos."

#: lang/json/mutation_from_json.py
msgid "Wildshape: Bear"
msgstr "Forma Salvaje: Oso"

#. ~ Description for {'str': 'Wildshape: Bear'}
#: lang/json/mutation_from_json.py
msgid ""
"You are bear-like, granting you raw power in exchange for intelligence.  "
"Also, using a gun is extremely difficult."
msgstr ""
"Eres parecido a un oso, lo que te otorga un gran poder a cambio de "
"inteligencia. Además, usar un arma es extremadamente difícil."

#: lang/json/mutation_from_json.py
msgid "Wildshape: Deer"
msgstr "Forma Salvaje: Ciervo"

#. ~ Description for {'str': 'Wildshape: Deer'}
#: lang/json/mutation_from_json.py
msgid ""
"You are deer-like, giving you the ability to move quickly and escape danger."
"  However, this takes a great toll on your body, and you don't think you "
"should maintain this form for long."
msgstr ""
"Eres como un ciervo, lo que te da la capacidad de moverte rápidamente y "
"escapar del peligro. Sin embargo, esto supone un gran desgaste para tu "
"cuerpo, y no crees que debas mantener esta forma durante mucho tiempo."

#: lang/json/mutation_from_json.py
msgid "Demon Horns"
msgstr "Cuernos de Demonio"

#. ~ Description for Demon Horns
#: lang/json/mutation_from_json.py
msgid ""
"Large ram horns curl around your ears on each side of your head.  Gives you "
"a headbutt attack and head protection."
msgstr ""
"Grandes cuernos de carnero se enroscan alrededor de tus orejas a cada lado "
"de la cabeza. Te dan un ataque de cabezazo y te protege la cabeza."

#: lang/json/mutation_from_json.py
msgid "Demon Hooves"
msgstr "Pezuñas de Demonio"

#. ~ Description for Demon Hooves
#: lang/json/mutation_from_json.py
msgid ""
"Your toes have merged into cloven hooves, like that of a goat.  You also "
"have coarse brown fur from the waist down."
msgstr ""
"Tus dedos se han fusionado en pezuñas hendidas, como las de una cabra. "
"También tienes un pelaje áspero y marrón de la cintura para abajo."

#. ~ Description for Demonic Possession
#: lang/json/mutation_from_json.py
msgid ""
"You are possessed by a greater demon, giving you great strength and combat "
"abilities but reducing your fine motor control skills.  This gives you a "
"slower crafting speed and the inability to cast spells."
msgstr ""
"Estás poseído por un demonio mayor, lo que te da una gran fuerza y "
"habilidades de combate, pero reduce tu capacidad de control motor preciso. "
"Esto te da una velocidad de elaboración más lenta y la incapacidad de lanzar"
" hechizos."

#: lang/json/mutation_from_json.py
msgid "Demon Claws"
msgstr "Garras de Demonio"

#: lang/json/mutation_from_json.py
msgid "Demon Skin"
msgstr "Piel de Demonio"

#. ~ Description for {'str': 'Demon Skin'}
#: lang/json/mutation_from_json.py
msgid "Your skin is crimson."
msgstr "Tu piel es carmesíe"

#: lang/json/mutation_from_json.py
msgid "Goat Tail"
msgstr "Cola de Cabra"

#. ~ Description for {'str': 'Goat Tail'}
#: lang/json/mutation_from_json.py
msgid "You have a short, stubby goat tail."
msgstr "Tienes una cola de cabra corta y rechoncha."

#: lang/json/mutation_from_json.py
msgid "Made Of Sugar"
msgstr "Hecho De Azucar"

#. ~ Description for {'str': 'Made Of Sugar'}
#: lang/json/mutation_from_json.py
msgid "You are literally made of sugar."
msgstr "Eres literalmente de azúcar."

#: lang/json/npc_class_from_json.py
msgid "No class"
msgstr "Sin clase"

#: lang/json/npc_class_from_json.py
msgid "I'm just wandering."
msgstr "Solo estoy dando vueltas."

#: lang/json/npc_class_from_json.py
msgid "Debug Dude"
msgstr "Depurar Tio"

#: lang/json/npc_class_from_json.py
msgid "I'm helping you test the game."
msgstr "Te estoy ayudando a que pruebes el juego."

#: lang/json/npc_class_from_json.py
msgid "Shopkeep"
msgstr "Tendero"

#: lang/json/npc_class_from_json.py
msgid "I'm a local shopkeeper."
msgstr "Soy un comerciante local."

#: lang/json/npc_class_from_json.py
msgid "Hacker"
msgstr "Hacker"

#: lang/json/npc_class_from_json.py
msgid "I'm looking for some choice systems to hack."
msgstr "Estoy buscando algún sistema de elección para hackear."

#: lang/json/npc_class_from_json.py lang/json/npc_from_json.py
#: lang/json/npc_from_json.py
msgid "Doctor"
msgstr "Doctor"

#: lang/json/npc_class_from_json.py
msgid "I'm looking for wounded to help."
msgstr "Estoy buscando heridos para ayudarlos."

#: lang/json/npc_class_from_json.py
msgid "Trader"
msgstr "Comerciante"

#: lang/json/npc_class_from_json.py
msgid "I'm collecting gear and selling it."
msgstr "Estoy juntando equipamiento para venderlo."

#: lang/json/npc_class_from_json.py
msgid "Ninja"
msgstr "Ninja"

#: lang/json/npc_class_from_json.py
msgid "I'm a wandering master of martial arts."
msgstr "Soy un maestro de artes marciales ambulante."

#: lang/json/npc_class_from_json.py
msgid "Cowboy"
msgstr "Vaquero"

#: lang/json/npc_class_from_json.py
