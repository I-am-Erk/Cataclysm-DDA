#. ~ Name for scenario 'Evacuee' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Evacuee"
msgstr "Evacuado"

#. ~ Name for scenario 'Evacuee' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Evacuee"
msgstr "Evacuada"

#. ~ Description for scenario 'Evacuee' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in one of the many government evac shelters."
msgstr ""
"Sobreviviste a la primera oleada de pánico, y has conseguido (relativamente)"
" la seguridad en uno de los diversos refugios de evacuación que dispuso el "
"gobierno."

#. ~ Description for scenario 'Evacuee' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in one of the many government evac shelters."
msgstr ""
"Sobreviviste a la primera oleada de pánico, y has conseguido (relativamente)"
" la seguridad en uno de los diversos refugios de evacuación que dispuso el "
"gobierno."

#. ~ Starting location for scenario 'Evacuee'.
#. ~ Starting location for scenario 'Squatter'.
#. ~ Starting location for scenario 'Challenge - Bordered'.
#: lang/json/scenario_from_json.py
msgctxt "start_name"
msgid "Evac Shelter"
msgstr "Refugio de Evacuación"

#. ~ Name for scenario 'Squatter' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Squatter"
msgstr "Okupa"

#. ~ Name for scenario 'Squatter' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Squatter"
msgstr "Okupa"

#. ~ Description for scenario 'Squatter' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in an abandoned building.  Unfortunately, while you're the only one "
"here now, you are definitely not the first person to be here, and in its "
"current state this building no longer seems nearly as secure as one might "
"have hoped."
msgstr ""
"Has sobrevivido a la oleada inicial de pánico y has logrado una (relativa) "
"seguridad en un edificio abandonado. Desgraciadamente, aunque eres el único "
"que está aquí ahora, no eres la primera persona que está aquí, y en su "
"estado actual este edificio ya no parece tan seguro como podrías haber "
"esperado."

#. ~ Description for scenario 'Squatter' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in an abandoned building.  Unfortunately, while you're the only one "
"here now, you are definitely not the first person to be here, and in its "
"current state this building no longer seems nearly as secure as one might "
"have hoped."
msgstr ""
"Has sobrevivido a la oleada inicial de pánico y has logrado una (relativa) "
"seguridad en un edificio abandonado. Desgraciadamente, aunque eres lal única"
" que está aquí ahora, no eres la primera persona que está aquí, y en su "
"estado actual este edificio ya no parece tan seguro como podrías haber "
"esperado."

#. ~ Name for scenario 'Missed' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Missed"
msgstr "Perdido"

#. ~ Name for scenario 'Missed' for a female character
