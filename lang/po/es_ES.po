#: lang/json/GENERIC_from_json.py lang/json/GENERIC_from_json.py
#: lang/json/TOOL_from_json.py lang/json/TOOL_from_json.py
msgid "Extinguish"
msgstr "Extinguir"

#. ~ Use action msg for cigar.
#: lang/json/GENERIC_from_json.py
msgid "You extinguish the cigar."
msgstr "Apagas el puro."

#. ~ Description for cigar
#: lang/json/GENERIC_from_json.py
msgid "The smoke billowing from this cigar has a sweet, musty odor."
msgstr "El humo de este cigarro forma una nube con aroma dulce y húmedo."

#: lang/json/GENERIC_from_json.py
msgid "cigar butt"
msgid_plural "cigar butts"
msgstr[0] "colilla de cigarros"
msgstr[1] "colillas de cigarros"

#. ~ Description for cigar butt
#: lang/json/GENERIC_from_json.py
msgid "A true gentleman always finishes his cigars."
msgstr "Un verdadero caballero siempre se termina sus cigarros."

#. ~ Use action msg for cigarette.
#: lang/json/GENERIC_from_json.py
msgid "You extinguish the cigarette."
msgstr "Apagas el cigarrillo."

#. ~ Description for cigarette
#: lang/json/GENERIC_from_json.py
msgid ""
"Smoke swirls from the lit end of this cigarette, filling the air with the "
"thrilling smell of burning chemicals."
msgstr ""
"El humo forma un espiral desde la punta encendida de este cigarrillo, "
"llenando el aire con el apasionante olor de los químicos quemados."

#: lang/json/GENERIC_from_json.py
msgid "cigarette butt"
msgid_plural "cigarette butts"
msgstr[0] "colilla de cigarrillo"
msgstr[1] "colillas de cigarrillos"

#. ~ Description for cigarette butt
#: lang/json/GENERIC_from_json.py
msgid ""
"What was once a wonderfully addictive tube of dried tobacco leaf is now just a smelly piece of trash.  What a tragedy!\n"
"The leftover tobacco in a few of these could probably be used to roll another cigarette.  If you're willing to go that far…"
msgstr ""
"Lo que una vez fue un maravilloso y adictivo tubo de hoja de tabaco seco es ahora sólo una olorosa basura. ¡Qué tragedia!\n"
"El tabaco sobrante en unos pocos de estos probablemente podría ser usado para enrollar otro cigarrillo. Si estás dispuesto a llegar tan lejos..."

#. ~ Use action msg for joint.
#: lang/json/GENERIC_from_json.py
msgid "You extinguish the joint."
msgstr "Apagas el porro"

#. ~ Description for joint
#: lang/json/GENERIC_from_json.py
msgid ""
"The smell of skunk permeates the air as a thin trail of smoke floats off of "
"this joint."
msgstr ""
"El olor a mofeta penetra en el aire mientras el fino rastro de humo flota "
"desde este porro."

#: lang/json/GENERIC_from_json.py
msgid "joint roach"
msgid_plural "joint roaches"
msgstr[0] "chusta"
msgstr[1] "chustas"

#. ~ Description for joint roach
#: lang/json/GENERIC_from_json.py
msgid ""
"The smoked-down butt of a joint, a reminder of some good times.  Pretty much trash now.  Bummer, man.\n"
"A few of these could probably be used to roll another joint."
msgstr ""
"Es la parte final de un porro fumado, un souvenir de tiempos mejores. Esto es casi basura. Qué bajón, loco.\n"
"Con varios de estos probablemente te puedas liar otro porro."

#: lang/json/GENERIC_from_json.py
msgid "cannabis plant"
msgid_plural "cannabis plants"
msgstr[0] "planta de cannabis"
msgstr[1] "plantas de cannabis"

#. ~ Description for cannabis plant
#: lang/json/GENERIC_from_json.py
msgid ""
"A psychoactive plant indigenous to Central Asia and the Indian subcontinent "
"traditionally cultivated for its fiber, oil, for medicinal purposes, and for"
" use as a recreational drug.  It requires further processing to be useful."
msgstr ""
"Una planta psicoactiva nativa de Asia central y del subcontinente indio, "
"tradicionalmente cultivada por su fibra, aceite, para uso medicinal y como "
"droga recreativa. Necesita ser procesada para poder usarse."

#: lang/json/GENERIC_from_json.py
msgid "raw tobacco"
msgid_plural "raw tobacco"
msgstr[0] "tabaco crudo"
msgstr[1] "tabaco crudo"

#. ~ Description for {'str_sp': 'raw tobacco'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Various parts of tobacco plant, full of nicotine.  They need to be dried to "
"become smokable."
msgstr ""
"Varias partes de la planta de tabaco, llenas de nicotina. Necesitan ser "
"secadas para poder ser fumadas."

#: lang/json/GENERIC_from_json.py
msgid "drone memory bank"
msgid_plural "drone memory banks"
msgstr[0] "banco de memoria dron"
msgstr[1] "bancos de memoria dron"

#. ~ Description for drone memory bank
#: lang/json/GENERIC_from_json.py
msgid ""
"Allows for storage and recovery of information.  Found in meteorologist "
"drone."
msgstr ""
"Permite almacenar y recuperar información. Encontrado en un dron "
"meteorológico."

#: lang/json/GENERIC_from_json.py
msgid "science ID card"
msgid_plural "science ID cards"
msgstr[0] "carné de científico"
msgstr[1] "carnés de científicos"

#. ~ Description for science ID card
#: lang/json/GENERIC_from_json.py
msgid ""
"This ID card once belonged to a scientist.  The reverse side describes "
"protocol for using it; this could grant access at one control panel, if you "
"can find one."
msgstr ""
"Esta tarjeta de identificación perteneció una vez a un científico. En la "
"parte de atrás se describe el protocolo para usarla. Esto podría darte "
"acceso a un panel de control, si lo encuentras."

#: lang/json/GENERIC_from_json.py
msgid "military ID card"
msgid_plural "military ID cards"
msgstr[0] "carné de militar"
msgstr[1] "carnés de militares"

#. ~ Description for military ID card
#: lang/json/GENERIC_from_json.py
msgid ""
"This ID card once belonged to a military officer.  The reverse side "
"describes protocol for using it; this could grant access at one control "
"panel, if you can find one."
msgstr ""
"Esta tarjeta de identificación perteneció una vez a un oficial militar. En "
"la parte de atrás se describe el protocolo para usarla. Esto podría darte "
"acceso a un panel de control, si lo encuentras."

#: lang/json/GENERIC_from_json.py
msgid "industrial ID card"
msgid_plural "industrial ID cards"
msgstr[0] "tarjeta de identificación industrial"
msgstr[1] "tarjetas de identificación industrial"

#. ~ Description for industrial ID card
#: lang/json/GENERIC_from_json.py
msgid ""
"This ID card once belonged to a high level technician.  The reverse side "
"describes protocol for using it; this could grant access at one control "
"panel, if you can find one."
msgstr ""
"Esta tarjeta de identificación perteneció una vez a un técnico de alto "
"nivel. En el reverso se describe el protocolo para utilizarla; esto podría "
"dar acceso a un panel de control, si es que lo encuentra."

#: lang/json/GENERIC_from_json.py
msgid "neoprene patch"
msgid_plural "neoprene patches"
msgstr[0] "parche de neopreno"
msgstr[1] "parches de neopreno"

#. ~ Description for neoprene patch
#: lang/json/GENERIC_from_json.py
msgid ""
"A moderately sized sheet of neoprene.  Can be used to craft light and "
"stretchable clothing."
msgstr ""
"Es una lámina de neopreno de tamaño medio. Puede ser utilizada para fabricar"
" ropa liviana y elastizada."

#: lang/json/GENERIC_from_json.py
msgid "light bulb"
msgid_plural "light bulbs"
msgstr[0] "bombilla"
msgstr[1] "bombillas"

#. ~ Description for light bulb
#: lang/json/GENERIC_from_json.py
msgid "A rather outdated light bulb used in all sorts of light equipment."
msgstr ""
"Es una bombilla bastante antigua que se usaba en toda clase de equipamiento "
"lumínico."

#: lang/json/GENERIC_from_json.py
msgid "clay flower pot"
msgid_plural "clay flower pots"
msgstr[0] "maceta de arcilla"
msgstr[1] "macetas de arcilla"

#. ~ Description for clay flower pot
#: lang/json/GENERIC_from_json.py
msgid "A nice looking clay pot used for planting."
msgstr "Es una linda maceta de arcilla en la que se puede plantar algo."

#: lang/json/GENERIC_from_json.py
msgid "plastic flower pot"
msgid_plural "plastic flower pots"
msgstr[0] "maceta de plástico"
msgstr[1] "macetas de plástico"

#. ~ Description for plastic flower pot
#: lang/json/GENERIC_from_json.py
msgid "A cheap plastic pot used for planting."
msgstr "Una maceta de plástico barato usada para plantar."

#: lang/json/GENERIC_from_json.py
msgid "fluid preserved brain"
msgid_plural "fluid preserved brains"
msgstr[0] "cerebro preservado en fluido"
msgstr[1] "cerebros preservados en fluido"

#. ~ Description for fluid preserved brain
#: lang/json/GENERIC_from_json.py
msgid ""
"This 3L jar contains a human brain preserved in a formaldehyde solution."
msgstr ""
"Este tarro de 3 litros contiene un cerebro humano preservado en una solución"
" de formaldehído."

#: lang/json/GENERIC_from_json.py
msgid "evaporator coil"
msgid_plural "evaporator coils"
msgstr[0] "bobina de evaporador"
msgstr[1] "bobinas de evaporador"

#. ~ Description for evaporator coil
#: lang/json/GENERIC_from_json.py
msgid "A set of long, snakelike tubes for evaporating refrigerant."
msgstr ""
"Es un conjunto de tubos largos, serpentinos, que se usa para los "
"refrigerantes de evaporación."

#: lang/json/GENERIC_from_json.py
msgid "condensor coil"
msgid_plural "condensor coils"
msgstr[0] "bobina condensador"
msgstr[1] "bobinas condensadoras"

#. ~ Description for condensor coil
#: lang/json/GENERIC_from_json.py
msgid "A compressor and a fan work together to cool down the refrigerant."
msgstr ""
"Un compresor y un ventilador trabajan juntos para enfriar el refrigerante."

#: lang/json/GENERIC_from_json.py
msgid "refrigerant tank"
msgid_plural "refrigerant tanks"
msgstr[0] "tanque de refrigerante"
msgstr[1] "tanques de refrigerante"

#. ~ Description for refrigerant tank
#: lang/json/GENERIC_from_json.py
msgid ""
"A small tank containing some sort of refrigerant often used in devices such "
"as freezers.  Hermetically sealed to prevent evaporation - cannot be opened "
"without prior connection to compatible valve."
msgstr ""
"Un pequeño tanque que contiene algún tipo de refrigerante que se utiliza a "
"menudo en dispositivos como los congeladores. Sellado herméticamente para "
"evitar la evaporación - no puede ser abierto sin una conexión previa a una "
"válvula compatible."

#: lang/json/GENERIC_from_json.py
msgid "hard steel plate"
msgid_plural "hard steel plates"
msgstr[0] "placa dura de acero"
msgstr[1] "placas duras de acero"

#. ~ Description for hard steel plate
#: lang/json/GENERIC_from_json.py
msgid ""
"An armor plating made of a very thick steel, specifically engineered for use"
" in a bullet resistant vest."
msgstr ""
"Un blindaje hecho de un acero muy grueso, específicamente diseñado para ser "
"usado en un chaleco antibalas."

#: lang/json/GENERIC_from_json.py
msgid "steel plate"
msgid_plural "steel plates"
msgstr[0] "placa de acero"
msgstr[1] "placas de acero"

#. ~ Description for steel plate
#: lang/json/GENERIC_from_json.py
msgid ""
"A steel armor plate, specifically engineered for use in a bullet resistant "
"vest."
msgstr ""
"Es una placa hecha de acero, específicamente pensada para usarse en chalecos"
" antibalas."

#: lang/json/GENERIC_from_json.py
msgid "small lock and key"
msgid_plural "small locks and keys"
msgstr[0] "pequeña cerradura y llave"
msgstr[1] "pequeñas cerraduras y llaves"

#. ~ Description for small lock and key
#: lang/json/GENERIC_from_json.py
msgid "A small lock, with a set of keys still inserted."
msgstr "Una pequeña cerradura, con un juego de llaves todavía insertado."

#: lang/json/GENERIC_from_json.py
msgid "in progress craft"
msgid_plural "in progress crafts"
msgstr[0] "fabricación en curso"
msgstr[1] "fabricaciones en curso"

#. ~ Description for in progress craft
#: lang/json/GENERIC_from_json.py
msgid "This is an in progress craft."
msgstr "Esta es una fabricación en curso."

#: lang/json/GENERIC_from_json.py
msgid "in progress disassembly"
msgid_plural "in progress disassemblies"
msgstr[0] "desmontaje en curso"
msgstr[1] "desmontajes en curso"

#. ~ Description for in progress disassembly
#: lang/json/GENERIC_from_json.py
msgid "This is an in progress disassembly."
msgstr "Este es un desmontaje en curso."

#: lang/json/GENERIC_from_json.py
msgid "spare tire carrier"
msgid_plural "spare tire carriers"
msgstr[0] "soporte de la rueda de repuesto"
msgstr[1] " soportes de la rueda de repuesto"

#. ~ Description for spare tire carrier
#: lang/json/GENERIC_from_json.py
msgid ""
"A bumper mounted rig for attaching and storing a spare tire on the back of a"
" vehicle.  Combine it with a wheel to get a mountable piece."
msgstr ""
"Un equipo montado en el parachoques para fijar y almacenar una rueda de "
"repuesto en la parte trasera de un vehículo. Combínalo con una rueda para "
"obtener una pieza montable."

#: lang/json/GENERIC_from_json.py
msgid "welding component kit"
msgid_plural "welding component kits"
msgstr[0] "kit de componente de soldadura"
msgstr[1] "kits de componentes de soldadura"

#. ~ Description for welding component kit
#: lang/json/GENERIC_from_json.py
msgid ""
"A set of components useful for constructing a full-featured welding station,"
" complete with soldering capability."
msgstr ""
"Un conjunto de componentes útiles para la construcción de una estación de "
"soldadura con todas las funciones, con capacidad para soldar."

#: lang/json/GENERIC_from_json.py
msgid "amplifier head"
msgid_plural "amplifier heads"
msgstr[0] "cabezal de amplificador"
msgstr[1] "cabezales de amplificador"

#. ~ Description for amplifier head
#: lang/json/GENERIC_from_json.py
msgid ""
"An amplifier head.  Typically paired with a speaker cabinet for amplifying "
"musical instruments.  Basically only good for spare parts now."
msgstr ""
