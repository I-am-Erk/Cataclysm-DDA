msgid_plural "flechettes"
msgstr[0] "flechette"
msgstr[1] "flechettes"

#. ~ Description for flechette
#: lang/json/AMMO_from_json.py
msgid ""
"A tiny steel dart.  Can be fired from a nail gun or similar weapon or used "
"when crafting ammunition"
msgstr ""
"Un pequeño dardo de acero.Puede dispararse con una pistola de clavos o un "
"arma similar, o utilizarse para fabricar munición"

