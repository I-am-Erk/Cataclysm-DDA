#: src/game.cpp
msgid "Choose corpse to butcher / item to disassemble"
msgstr "Elige un cadáver para descuartizar / objeto para desmontar"

#: src/game.cpp
msgid "Butcher everything"
msgstr "Descuartizar todo"

