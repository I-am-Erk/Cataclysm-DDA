msgstr "¡Error! ¡No se encontró ningún tanque de %s!"

#: src/iexamine.cpp
#, c-format
msgid "This station is out of %s.  We apologize for the inconvenience."
msgstr ""
"Esta estación se ha quedado sin %s. Le pedimos disculpas por las molestias."

#: src/iexamine.cpp
msgid "Welcome to AutoGas!"
msgstr "¡Bienvenido a AutoGas!"

#: src/iexamine.cpp
msgid "What would you like to do?"
msgstr "¿Qué acción quieres realizar?"

#: src/iexamine.cpp
#, c-format
msgid "Buy %s."
msgstr "Comprar %s."

#: src/iexamine.cpp
msgid "Refund cash."
msgstr "Reembolso de dinero."

#: src/iexamine.cpp
#, c-format
msgid "Current %s pump: "
msgstr "Surtido de %s actual:"

