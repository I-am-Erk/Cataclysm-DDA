#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Assistant Sub-Executive"
msgstr "Asistente del Subdirector Ejecutivo"

#. ~ Profession (male Assistant Sub-Executive) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Through a lifetime of hard work, dedication, boot-licking and immense luck, "
"you achieved the almost impossible, and were promoted from an indentured "
"clerk to a minor managerial position.  Although you were still an expendable"
" peon among the ranks of the corporation, you earned numbers most people "
"could only dream of, and you savored it."
msgstr ""
"A través de una vida de trabajo duro, dedicación, lamida de botas e inmensa "
"suerte, lograste lo casi imposible, y fuiste promovido de un empleado "
"contratado a un puesto directivo menor. Aunque todavía eras un peón "
"prescindible entre las filas de la corporación, ganaste números que la "
"mayoría de la gente sólo podía soñar, y lo saboreaste."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Assistant Sub-Executive"
msgstr "Asistente del Subdirector Ejecutivo"

#. ~ Profession (female Assistant Sub-Executive) description
#: lang/json/professions_from_json.py
