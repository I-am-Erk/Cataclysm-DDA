#: lang/json/COMESTIBLE_from_json.py
msgid "beef stew entree"
msgid_plural "beef stew entrees"
msgstr[0] "MRE 主菜（炖牛肉）"

#. ~ Description for beef stew entree
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"The beef stew entree from an MRE.  Sterilized using radiation, so it's safe "
