msgstr "光线不足，你无法阅读！"

#: src/activity_handlers.cpp
msgid "You finish reading."
msgstr "你结束了阅读。"

#: src/activity_handlers.cpp
msgid "You finish waiting."
msgstr "你结束了等待。"

#: src/activity_handlers.cpp
#, c-format
msgid "%s finishes with you…"
msgstr "%s 完成了和你的工作……"

#: src/activity_handlers.cpp
