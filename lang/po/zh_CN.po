msgid "Small But Deadly"
msgstr "细小但致命"

#: lang/json/achievement_from_json.py
msgid "Caliber doesn't count when you're on the receiving end of the barrel."
msgstr "当你成为被枪管指着的一方时，口径无所谓。"

