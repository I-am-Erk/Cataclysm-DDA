msgid "HEY DUMBASSES!"
msgstr "嘿，蠢货！"

#: lang/json/snippet_from_json.py
msgid "HEY DUMBHEADS!"
msgstr "嘿，笨蛋！"

#: lang/json/snippet_from_json.py
msgid "HEY MORONS!"
msgstr "嘿，傻瓜！"

#: lang/json/snippet_from_json.py
