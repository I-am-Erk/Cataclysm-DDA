msgstr "%s去清理战场，整理战利品。"

#: src/faction_camp.cpp
msgid "Forests and swamps are the only valid cutting locations."
msgstr "只有森林与沼泽地形可作为伐木地点。"

#: src/faction_camp.cpp
#, c-format
msgid ""
"Trip Estimate:\n"
