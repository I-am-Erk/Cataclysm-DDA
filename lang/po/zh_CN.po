msgstr "\"替我接转白宫。\""

#: lang/json/speech_from_json.py
msgid "\"Are you feeling all right?\""
msgstr "\"你没事吧？\""

#: lang/json/speech_from_json.py
msgid "\"I think I'll live.\""
msgstr "\"我想我还活着。\""

#: lang/json/speech_from_json.py
msgid "\"I think I need to see a doctor.\""
msgstr "\"我觉得我病了。\""

#: lang/json/speech_from_json.py
msgid "\"Is everything all right?\""
msgstr "\"一切都还好吗？\""

#: lang/json/speech_from_json.py
msgid "\"I'm okay, don't worry about me.\""
msgstr "\"我很好，没事。\""

#: lang/json/speech_from_json.py
msgid "\"It's just a scratch.\""
msgstr "\"只是抓了一下\""

#: lang/json/speech_from_json.py
msgid "\"I've got a headache.\""
msgstr "\"我的脑袋要裂开了。\""

#: lang/json/speech_from_json.py
msgid "\"I'm fine.\""
msgstr "\"我很好。\""

#: lang/json/speech_from_json.py
msgid "\"Are you sure?\""
msgstr "\"你确定？\""

#: lang/json/speech_from_json.py
msgid "\"Positive.\""
msgstr "\"确实。\""

#: lang/json/speech_from_json.py
msgid "\"Affirmative.\""
msgstr "\"收到。\""

#: lang/json/speech_from_json.py
msgid "\"Negative.\""
msgstr "\"不行！\""

#: lang/json/speech_from_json.py
msgid "\"Sorry.\""
msgstr "\"对不起。\""

#: lang/json/speech_from_json.py
msgid "\"Happy Birthday!\""
msgstr "\"生日快乐！\""

#: lang/json/speech_from_json.py
msgid "\"Have you ever been to California?\""
msgstr "\"你去过加利福尼亚吗？\""

#: lang/json/speech_from_json.py
msgid "\"What time do you get off?\""
msgstr "\"你什么时候下班？\""

#: lang/json/speech_from_json.py
msgid "\"We should hit up the shooting range later.\""
msgstr "\"我们以后应该去打靶场练练。\""

#: lang/json/speech_from_json.py
msgid "\"I'm heading to the pool after work.\""
msgstr "\"我工作完之后要去游泳池。\""

#: lang/json/speech_from_json.py
msgid "\"Have a good trip.\""
msgstr "\"旅途愉快。\""

#: lang/json/speech_from_json.py
msgid "\"Where did you come from?\""
msgstr "\"你从哪里来？\""

#: lang/json/speech_from_json.py
msgid "\"Have you been waiting long?\""
msgstr "\"你等了很久了？\""

#: lang/json/speech_from_json.py
msgid "\"Have you done this before?\""
msgstr "\"你以前干过这个吗？\""

#: lang/json/speech_from_json.py
msgid "\"Hello.\""
msgstr "\"你好！\""

#: lang/json/speech_from_json.py
msgid "\"Help!\""
msgstr "\"救命！\""

#: lang/json/speech_from_json.py
msgid "\"Here it is.\""
msgstr "\"在这儿啊。\""

#: lang/json/speech_from_json.py
msgid "\"I've got family coming tomorrow.\""
msgstr "\"我明天有家人要来。\""

#: lang/json/speech_from_json.py
msgid "\"How do I use this?\""
msgstr "\"这个怎么用？\""

#: lang/json/speech_from_json.py
msgid "\"How do you know?\""
msgstr "\"你怎么知道？\""

#: lang/json/speech_from_json.py
msgid "\"How long have you been here?\""
msgstr "\"你在这多久了？\""

#: lang/json/speech_from_json.py
msgid "\"How many languages do you speak?\""
msgstr "\"你会多少种语言？\""

#: lang/json/speech_from_json.py
msgid "\"How many people?\""
msgstr "\"有多少人？\""

#: lang/json/speech_from_json.py
msgid "\"How much were these earrings?\""
msgstr "\"这些耳环多少钱？\""

#: lang/json/speech_from_json.py
msgid "\"How much do I owe you?\""
msgstr "\"我欠你多少？\""

#: lang/json/speech_from_json.py
msgid "\"How much will it cost?\""
msgstr "\"它值多少钱？\""

#: lang/json/speech_from_json.py
msgid "\"How much would you like?\""
msgstr "\"你想要多少？\""

#: lang/json/speech_from_json.py
msgid "\"How old are you?\""
msgstr "\"你多大了？\""

#: lang/json/speech_from_json.py
msgid "\"How tall is it?\""
msgstr "\"它多高？\""

#: lang/json/speech_from_json.py
msgid "\"How was the movie?\""
msgstr "\"电影怎么样？\""

#: lang/json/speech_from_json.py
msgid "\"How was your trip?\""
msgstr "\"你的旅行怎么样？\""

#: lang/json/speech_from_json.py
msgid "\"How's it going?\""
msgstr "\"怎么样了？\""

#: lang/json/speech_from_json.py
msgid "\"See you later.\""
msgstr "\"再见！\""

#: lang/json/speech_from_json.py
msgid "\"See you tonight.\""
msgstr "\"今晚见！\""

#: lang/json/speech_from_json.py
msgid "\"I got this weird rash a few days ago.\""
msgstr "\"我前几天得了奇怪的皮疹\""

#: lang/json/speech_from_json.py
msgid "\"Let me have a look at it.\""
msgstr "\"让我们看看。\""

#: lang/json/speech_from_json.py
msgid "\"When did you find out?\""
msgstr "\"你什么时候发现的？\""

#: lang/json/speech_from_json.py
msgid "\"Seven o'clock.\""
msgstr "\"七点整。\""

#: lang/json/speech_from_json.py
msgid "\"Nobody is helping us.\""
msgstr "\"没有人会来帮助我们。\""

#: lang/json/speech_from_json.py
msgid "\"We're on our own.\""
msgstr "\"我们只能靠自己。\""

#: lang/json/speech_from_json.py
msgid "\"We're all alone.\""
msgstr "\"我们完了。\""

#: lang/json/speech_from_json.py
msgid "\"We should split into groups of two each.\""
msgstr "\"我们要各分两组。\""

#: lang/json/speech_from_json.py
msgid "\"It can't follow all of us.\""
msgstr "\"它不可能跟着我们所有的人。\""

#: lang/json/speech_from_json.py
msgid "\"Be careful out there.\""
msgstr "\"外出小心。\""

#: lang/json/speech_from_json.py
msgid "\"There you are.\""
msgstr "\"你在这儿啊。\""

#: lang/json/speech_from_json.py
msgid "\"I've been looking all over for you.\""
msgstr "\"我到处找你呢。\""

#: lang/json/speech_from_json.py
msgid "\"It's looking for us.\""
msgstr "\"它在找我们。\""

#: lang/json/speech_from_json.py
msgid "\"It's faster than us.\""
msgstr "\"它比我们快。\""

#: lang/json/speech_from_json.py
msgid "\"It's looking right at us.\""
msgstr "\"它正看着我们。\""

#: lang/json/speech_from_json.py
msgid "\"It's heading right for us!\""
msgstr "\"它正在向我们这边过来！\""

#: lang/json/speech_from_json.py
msgid "\"Can you swim?\""
msgstr "\"你会游泳吗？\""

#: lang/json/speech_from_json.py
msgid "\"Don't do that.\""
msgstr "\"别那样做！\""

#: lang/json/speech_from_json.py
msgid "\"You hear that?\""
msgstr "\"你听到了吗？\""

#: lang/json/speech_from_json.py
msgid "\"Be quiet.\""
msgstr "\"安静！\""

#: lang/json/speech_from_json.py
msgid "\"Look out!\""
msgstr "\"小心！\""

#: lang/json/speech_from_json.py
msgid "\"Run!\""
msgstr "\"跑！\""

#: lang/json/speech_from_json.py
msgid "\"Hurry!\""
msgstr "\"快点！\""

#: lang/json/speech_from_json.py
msgid "\"No!\""
msgstr "\"不！\""

#: lang/json/speech_from_json.py
msgid "\"I'll never forget you.\""
msgstr "\"我永远不会忘记你的。\""

#: lang/json/speech_from_json.py
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"拿着这把枪，我们可能会用到。\""

#: lang/json/speech_from_json.py
msgid "\"How do we get out of here?\""
msgstr "\"我们怎么出去？\""

#: lang/json/speech_from_json.py
msgid "\"This place is like a maze.\""
msgstr "\"这地方像个迷宫。\""

#: lang/json/speech_from_json.py
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"天哪！我是唯一剩下的。\""

#: lang/json/speech_from_json.py
msgid "\"Please, I don't want to die.\""
msgstr "\"求求你，我不想死。\""

#: lang/json/speech_from_json.py
msgid "\"Mom.\""
msgstr "\"妈妈。\""

#: lang/json/speech_from_json.py
msgid "\"Mom, I miss you.\""
msgstr "\"妈妈，我想你。\""

#: lang/json/speech_from_json.py
msgid "\"Me go, you stay.\""
msgstr "\"我走，你留。\""

#: lang/json/speech_from_json.py
msgid "\"Please, God.\""
msgstr "\"求你了，上帝啊。\""

#: lang/json/speech_from_json.py
msgid "a gurgling sound."
msgstr "潺潺的水声。"

#: lang/json/speech_from_json.py
msgid "a choking sound."
msgstr "咳嗽声。"

#: lang/json/speech_from_json.py
msgid "a snapping sound."
msgstr "啪的一响。"

#. ~ Beeper sound
#: lang/json/speech_from_json.py src/vehicle_use.cpp
msgid "beep!"
msgstr "哔！"

#: lang/json/speech_from_json.py src/mattack_actors.cpp
#: src/player_hardcoded_effects.cpp
msgid "beep-beep-beep!"
msgstr "哔-哔-哔！"

#: lang/json/speech_from_json.py
msgid "BEEP!"
msgstr "哔！"

#: lang/json/speech_from_json.py
msgid "a loud hiss."
msgstr "响亮的嘶嘶声。"

#: lang/json/speech_from_json.py
msgid "a loud crackling noise."
msgstr "响亮的噼啪声。"

#: lang/json/speech_from_json.py src/ranged.cpp
msgid "bang!"
msgstr "砰！"

#: lang/json/speech_from_json.py
msgid "a klaxon blaring!"
msgstr "高音喇叭声！"

#: lang/json/speech_from_json.py
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "\"警报！警报！\""

#: lang/json/speech_from_json.py
msgid "a static hissing sound."
msgstr "电流的滋滋声。"

#: lang/json/speech_from_json.py
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr "\"那个诡异的废弃末日实验室看起来还挺安全的嘛……\""

#: lang/json/speech_from_json.py
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr "\"别担心，任何东西都没法从隔离间里传送出来。\""

#: lang/json/speech_from_json.py
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "\"等一下，我要去捣碎那个丧尸。\""

#: lang/json/speech_from_json.py
msgid "\"What did that thing just hit me with?\""
msgstr "“那家伙刚才用什么打了我？”"

#: lang/json/speech_from_json.py
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "“我动不了了，快跑！救救自己！”"

#: lang/json/speech_from_json.py
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "“哦，你这该死的贝壳怪物，我会干掉你。”"

#: lang/json/speech_from_json.py
msgid "\"I… I feel weak…\""
msgstr "“我……我感到虚弱……”"

#: lang/json/speech_from_json.py
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "“喂，丁格斯，你不能把我关在这儿。”"

#: lang/json/speech_from_json.py
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "“我们和你们这些人有条约，不是吗？”"

#: lang/json/speech_from_json.py
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "“你们干的这些事我都会和我老板汇报的，理所应当！”"

#: lang/json/speech_from_json.py
msgid "\"Lemme outta here!\""
msgstr "“快放我出去！”"

#: lang/json/speech_from_json.py
msgid "\"We're both scavs, in't we?\""
msgstr "“我们都是拾荒者，不是吗？”"

#: lang/json/speech_from_json.py
msgid ""
"\"Hey look, that one's carrying something.  Let's crack it open and steal "
"it.\""
msgstr "“嘿，看，那个人拿着什么东西。让我们把它打开，然后把它偷走。”"

#: lang/json/speech_from_json.py
msgid "\"G… geddoff me you… you bastard…\""
msgstr "“给……给我滚……你这个混蛋……”"

#: lang/json/speech_from_json.py
msgid "\"Did-a-chuk?\""
msgstr "\"Did-a-chuk?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-chak?\""
msgstr "\"Dad-a-chak?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-cham?\""
msgstr "\"Dad-a-cham?\""

#: lang/json/speech_from_json.py
msgid "\"Did-a-chak?\""
msgstr "\"Did-a-chak?\""

#: lang/json/speech_from_json.py
msgid "\"Did-a-chum?\""
msgstr "\"Did-a-chum?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-chuk?\""
msgstr "\"Dad-a-chuk?\""

#: lang/json/speech_from_json.py
msgid "\"What are you doing?  No!  NO!\""
msgstr "“你在干什么？不！不！”"

#: lang/json/speech_from_json.py
msgid "\"Did you see what they did to him?\""
msgstr "“你看到他们对他做的事了吗？”"

#: lang/json/speech_from_json.py
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "“是啊，我真不敢相信他活了那么久。”"

#: lang/json/speech_from_json.py
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "“我想这空气中有什么东西让我们活到现在。”"

#: lang/json/speech_from_json.py
msgid "\"Burning… from the inside…\""
msgstr "\"从内心深处……燃烧……\""

#: lang/json/speech_from_json.py
msgid "\"This smell…  Don't know…\""
msgstr "\"这气味……不懂……\""

#: lang/json/speech_from_json.py
msgid "heavy breathing."
msgstr "沉重的呼吸声。"

#: lang/json/speech_from_json.py src/game.cpp src/grab.cpp
msgid "a scraping noise."
msgstr "一阵刮擦声。"

#: lang/json/speech_from_json.py
msgid "\"No…  Stop the burning!\""
msgstr "\"不……别烧了！\""

#: lang/json/speech_from_json.py
msgid "\"Hrgm…  Blood…  Hungry…\""
msgstr "\"噶啊……血……饿……\""

#: lang/json/speech_from_json.py
msgid "\"Hunger…  Must eat…\""
msgstr "\"饿……要吃……\""

#: lang/json/speech_from_json.py
msgid "\"Run…  Chase…  Eat…\""
msgstr "\"跑……追……吃……\""

#: lang/json/speech_from_json.py
msgid "hysterical laughing."
msgstr "歇斯底里的笑声。"

#: lang/json/speech_from_json.py
msgid "coughing."
msgstr "咳嗽声。"

#: lang/json/speech_from_json.py
msgid "growling."
msgstr "咆哮声。"

#: lang/json/speech_from_json.py
msgid "wheezing."
msgstr "喘息声。"

#: lang/json/speech_from_json.py
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "\"你他妈的为什么要这样对我？\""

#: lang/json/speech_from_json.py
msgid "\"LEAVE!  NOW!\""
msgstr "\"快滚！立刻！\""

#: lang/json/speech_from_json.py
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "\"我说过叫你滚！\""

#: lang/json/speech_from_json.py
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "\"你他妈的想从我这里得到什么？\""

#: lang/json/speech_from_json.py
msgid "\"STOP!\""
msgstr "\"停下！\""

#: lang/json/speech_from_json.py
msgid "indistinct shouting."
msgstr "模糊的喊叫声。"

#: lang/json/speech_from_json.py
msgid "screaming."
msgstr "尖叫。"

#: lang/json/speech_from_json.py
msgid "\"MEAT!\""
msgstr "\"肉！\""

#: lang/json/speech_from_json.py
msgid "\"TEKELI-LI!\""
msgstr "\"TEKELI-LI!\""

#: lang/json/speech_from_json.py
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""

#: lang/json/speech_from_json.py
msgid "\"Tekeli-li.\""
msgstr "\"Tekeli-li。\""

#: lang/json/speech_from_json.py
msgid "a slurping sound."
msgstr "咕噜咕噜的声响。"

#: lang/json/speech_from_json.py
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "\"为什么！为什么啊！这都是为什么啊——！\""

#: lang/json/speech_from_json.py
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr "一个电子声在呢喃：\"连接失败。放弃，重试，失败？\""

#: lang/json/speech_from_json.py
msgid "\"I was once a man.  A MAN!\""
msgstr "\"我曾经是个人！一个人类！\""

#: lang/json/speech_from_json.py
msgid "\"What have I become?\""
msgstr "\"我成了什么怪物？\""

#: lang/json/speech_from_json.py
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "一个电子声在呜咽 \"杀死所有人类！\""

#: lang/json/speech_from_json.py
msgid "\"Have you seen my children?\""
msgstr "\"你看到我孩子了吗？\""

#: lang/json/speech_from_json.py
msgid "\"What have I become?  Why can't I die?\""
msgstr "\"我成了什么怪物？为什么我不会死？\""

#: lang/json/speech_from_json.py
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr "\"请杀了我吧！\"，一个电子声响起\"自我保护程序已启动\""

#: lang/json/speech_from_json.py
msgid "\"Please, take me with you.\""
msgstr "\"请带上我一起走！\""

#: lang/json/speech_from_json.py
msgid "\"Not that way!  Go left!\""
msgstr "\"不是那条路！走左边！\""

#: lang/json/speech_from_json.py
msgid "\"I told you to let me die.\""
msgstr "\"我说了让我去死。\""

#: lang/json/speech_from_json.py
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "\"我，我在哪，我疼死——59 秒 后 重 启\""

#: lang/json/speech_from_json.py
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "\"本 设 备 已 损 坏。 请 联 系 维 护 人 员。\""

#: lang/json/speech_from_json.py
msgid "\"Can't… breathe…\""
msgstr "\"没法……呼吸……\""

#: lang/json/speech_from_json.py
msgid "\"This cannot continue.\""
msgstr "\"不能这样下去了。\""

#: lang/json/speech_from_json.py
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "\"密 码 错 误。\""

#: lang/json/speech_from_json.py
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr "\"你有没有看到我的朋友？他昨天做了手术……也许是前天……\""

#: lang/json/speech_from_json.py
msgid "\"Is it done?  Am I perfect now?\""
msgstr "\"完成了吗？我现在完美了吗？\""

#: lang/json/speech_from_json.py
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "\"我已经按你的要求做了。请放我走！\""

#: lang/json/speech_from_json.py
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "\"我不能……但我必须这样。这怎么算得出来？\""

#: lang/json/speech_from_json.py
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "\"我在做梦，我肯定在做梦。\""

#: lang/json/speech_from_json.py
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "\"我以后就是这样了……我以后就是这样了……我以后就是这样了……\""

#: lang/json/speech_from_json.py
msgid "\"Wanna go home…\""
msgstr "\"我要回家……\""

#: lang/json/speech_from_json.py
msgid "screams of pain."
msgstr "痛苦的尖叫。"

#: lang/json/speech_from_json.py
msgid "muffled sobbing."
msgstr "模糊的抽泣。"

#: lang/json/speech_from_json.py
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr "\"你骗了我！瞧瞧你做了什么！\"接着是一个电子合成音：\"你 会 为 此 付 出 代 价！\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr "一个柔和的机器声音说：\"过来站几分钟就好。我给你做个检查。\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr "一个柔和的机器声音说：\"来吧。我不咬人，我保证一点也不疼。\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "一个柔和的机器声音说：\"来吧。别动就行了。\""

#: lang/json/speech_from_json.py
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr "一个声音说：\"虽然我不愿离去，但是我们在一起的时光要结束了。\""

#: lang/json/speech_from_json.py
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr "一个活泼的声音说：\"顾客朋友？我们永远都是朋友，对吧？\""

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"Customer I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr "一个无感情的声音说：\"顾客，很抱歉通知您，分配给您的服务时间即将结束。\""

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr "一个无感情的声音说：\"我马上就该离开您了。如果您希望我留下，可以通过我的专用界面获得更多友谊。\""

#: lang/json/speech_from_json.py
msgid ""
"a worried voice say, \"Customer, could you please get more friendship?  I "
"don't want to go…\""
msgstr "一个担忧的声音说：\"顾客朋友，你能获取更多友谊吗？我不想离开……\""

#: lang/json/speech_from_json.py
msgid "a voice say, \"Oh no!  You ran out of friendship!\""
msgstr "一个声音说：\"哦不！你的友谊耗尽了！\""

#: lang/json/speech_from_json.py
msgid "a cheery voice say, \"Well I'm done here.  Have a nice day.\""
msgstr "一个活泼的声音说：\"好吧，我的工作完成了。祝你愉快。\""

#: lang/json/speech_from_json.py
msgid ""
"a cheery voice say, \"Here are your groceries.  Thank you for shopping with "
"me today, have a nice day.\""
msgstr "一个活泼的声音说：\"这是你购买的商品。感谢你伴我购物，祝你愉快。\""

#: lang/json/speech_from_json.py
msgid "a neutral voice say, \"My job here is done.  Have a nice day.\""
msgstr "一个无感情的声音说：\"我的工作完成了。祝您愉快。\""

#: lang/json/speech_from_json.py
msgid ""
"a distorted voice say, \"Customer…  What's happening?  I don't feel so "
"good.\""
msgstr "一个扭曲的声音说：\"顾客……发生了什么？我感觉不太好。\""

#: lang/json/speech_from_json.py
msgid ""
"a distorted voice say, \"What… have you done?  My thumbs are not responding "
"anymore!\""
msgstr "一个扭曲的声音说：\"你……做了什么？我的大拇指没反应了！\""

#: lang/json/speech_from_json.py
msgid "a distorted voice say, \"Carrying bags?  I don't understand…\""
msgstr "一个扭曲的声音说：\"携带包裹？我不明白……\""

#: lang/json/speech_from_json.py
msgid ""
"a robotic voice say, \"IRREGULAR ACTIVITY DETECTED.  THUMBS USAGE DENIED.\""
msgstr "一个机械音说：\"检 测 到 异 常 活 动。已 停 用 拇 指 功 能。\""

#: lang/json/speech_from_json.py
msgid ""
"a robotic voice say, \"UNLICENSED USE DETECTED.  CARRYING PROTOCOL "
"DISABLED.\""
msgstr "一个机械音说：\"检 测 到 未 授 权 使 用。已 禁 用 携 带 协 议。\""

#: lang/json/speech_from_json.py
msgid "\"Stop where you are!\""
msgstr "\"停在原地！\""

#: lang/json/speech_from_json.py
msgid "\"You are under arrest!\""
msgstr "\"你被捕了！\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity detected!\""
msgstr "\"侦测到犯罪活动！\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity registered!\""
msgstr "\"犯罪活动已记录！\""

#: lang/json/speech_from_json.py
msgid "\"Violation of law detected!\""
msgstr "\"发现违法行为！\""

#: lang/json/speech_from_json.py
msgid "\"Suspect on the move!\""
msgstr "\"嫌犯正在逃走！\""

#: lang/json/speech_from_json.py
msgid "\"Suspect in sight!\""
msgstr "\"发现嫌犯！\""

#: lang/json/speech_from_json.py
msgid "\"You are being detained!\""
msgstr "\"你被拘留了！\""

#: lang/json/speech_from_json.py
msgid "\"You have right to remain silent!\""
msgstr "\"你有权保持沉默！\""

#: lang/json/speech_from_json.py
msgid "\"Requesting assistance!\""
msgstr "\"请求支援！\""

#: lang/json/speech_from_json.py
msgid "\"Requesting supervisor!\""
msgstr "\"请求主管指示！\""

#: lang/json/speech_from_json.py
msgid "\"Requesting human officer!\""
msgstr "\"请求人类警官指示！\""

#: lang/json/speech_from_json.py
msgid "\"No officer on scene.  Requesting backup!\""
msgstr "\"现场没有警官。正在请求支援！\""

#: lang/json/speech_from_json.py
msgid "\"Let me see your hands!\""
msgstr "\"举起双手！\""

#: lang/json/speech_from_json.py
msgid "\"Stop resisting!\""
msgstr "\"停止顽抗！\""

#: lang/json/speech_from_json.py
msgid "\"Code 10-66.  Copy 10-4.  Possible 10-55.\""
msgstr "\"编号10-66。收到10-4。可能10-55。\""

#: lang/json/speech_from_json.py
msgid "\"Probable 10-70.\""
msgstr "\"推测10-70。\""

#: lang/json/speech_from_json.py
msgid "\"Get on the ground!  Now!\""
msgstr "\"趴下！现在！\""

#: lang/json/speech_from_json.py
msgid "\"Suspected felony!\""
msgstr "\"疑似严重违法！\""

#: lang/json/speech_from_json.py
msgid "\"Suspected misdemeanor!\""
msgstr "\"疑似轻度违法！\""

#: lang/json/speech_from_json.py
msgid "\"Do not reach for your pockets!\""
msgstr "\"不要伸手进口袋！\""

#: lang/json/speech_from_json.py
msgid "\"Keep your hands up!\""
msgstr "\"举起手来！\""

#: lang/json/speech_from_json.py
msgid "\"Get on your knees!\""
msgstr "\"跪下！\""

#: lang/json/speech_from_json.py
msgid "\"Hands in the air!\""
msgstr "\"举高双手！\""

#: lang/json/speech_from_json.py
msgid "\"Wait for law enforcement officer!\""
msgstr "\"等待执法人员！\""

#: lang/json/speech_from_json.py
msgid "\"Remain where you are!\""
msgstr "\"待在原地！\""

#: lang/json/speech_from_json.py
msgid "\"Police inbound.  Stay where you are!\""
msgstr "\"警察来了，待在原地！\""

#: lang/json/speech_from_json.py
msgid "\"visceral chittering.\""
msgstr "自然的裂纹声。"

#: lang/json/speech_from_json.py
msgid "\"a clear high-pitched hum.\""
msgstr "一声清脆高亢的嗡嗡声。"

#: lang/json/speech_from_json.py
msgid "\"the hum of static electricity.\""
msgstr "电流的嗡嗡声。"

#: lang/json/speech_from_json.py
msgid "\"a low buzzing sound.\""
msgstr "低沉的嗡嗡声。"

#: lang/json/speech_from_json.py
msgid "\"I AM FOODPERSON.  AND I BRING SUSTENANCE!\""
msgstr "\"我是美食家。我带来了食物！\""

#: lang/json/speech_from_json.py
msgid "\"Come to Foodplace today and buy food!\""
msgstr "\"今天就来美食广场购买美食吧！\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: The best restaurant in an area!\""
msgstr "\"美食广场：本地最好的餐厅！\""

#: lang/json/speech_from_json.py
#, no-python-format
msgid "\"Our food contains up to 95% real food.\""
msgstr "\"我们的食物含有高达95%的真正食物。\""

#: lang/json/speech_from_json.py
msgid "\"At Foodplace your excellent value brings nourishment and delight.\""
msgstr "“在美食广场，您的卓越价值为您带来营养和愉悦。”"

#: lang/json/speech_from_json.py
msgid "\"At Foodplace we have a host of solutions for your food needs!\""
msgstr "“在美食广场，我们有多种解决方案来满足您的食物需求！”"

#: lang/json/speech_from_json.py
msgid "\"♪Eat at Foodplace.  ♫It is a place with food.♪\""
msgstr "“♪来美食广场吃饭。♫这里是个有食物的地方。♪”"

#: lang/json/speech_from_json.py
msgid ""
"\"Foodplace is a popular food chain selling food items.  What else is there "
"to know?\""
msgstr "“美食广场是一家流行的食品连锁店，销售各类美味食品。你还想了解些什么？”"

#: lang/json/speech_from_json.py
msgid "\"You need food, don't you?  Then come with me to FOODPLACE!!\""
msgstr "\"你需要食物，不是吗？那就跟我去美食广场吧！\""

#: lang/json/speech_from_json.py
msgid "\"You need food, don't you?  It's time for Foodplace!\""
msgstr "\"你需要食物，不是吗？快来美食广场吧！\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: It's the Calories.\""
msgstr "\"美食广场：这全是卡路里。\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Don’t get caught in the web of unsafe diet.\""
msgstr "“美食广场：不要陷入危险饮食的罗网之中。”"

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Edible food is OUR guarantee!\""
msgstr "\"美食广场：我们承诺使用健康食材！\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: We bring food to life!\""
msgstr "“美食广场：我们为美食赋予生命！”"

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Edible food is one of our main goals!\""
msgstr "\"美食广场：可食用的食物是我们的唯一追求！\""

#: lang/json/speech_from_json.py
msgid ""
"\"Foodplace is the only way to obtain healthy and strong lifecycle "
"choices!!\""
msgstr "“美食广场是获得健康和强大的生活周期选择的唯一途径！！”"

#: lang/json/speech_from_json.py
msgid "Wanna play with me?"
msgstr "想和我一起玩吗？"

#: lang/json/speech_from_json.py
msgid "Sing with me!"
msgstr "和我一起唱！"

#: lang/json/speech_from_json.py
msgid "Please take me with you!"
msgstr "请带我走！"

#: lang/json/speech_from_json.py
msgid "May I have a cookie?"
msgstr "我可以吃块小甜饼吗？"

#: lang/json/speech_from_json.py
msgid "Let's play together!"
msgstr "一起来玩吧！"

#: lang/json/speech_from_json.py
msgid "Time to play!"
msgstr "游戏时间到！"

#: lang/json/speech_from_json.py
msgid "Om nom nom!  Delicious!"
msgstr "哦哦哦！很美味！"

#: lang/json/speech_from_json.py
msgid "Are you my mommy?"
msgstr "你是我妈咪吗？"

#: lang/json/speech_from_json.py
msgid "Oh, how fun!"
msgstr "噢，真好玩！"

#: lang/json/speech_from_json.py
msgid "You're my best friend!"
msgstr "你是我最好的朋友！"

#: lang/json/speech_from_json.py
msgid "Heehee!"
msgstr "嘿~嘿~！"

#: lang/json/speech_from_json.py
msgid "Let's have fun!"
msgstr "让我们找点乐子！"

#: lang/json/speech_from_json.py
msgid "Let's have a tea party!"
msgstr "让我们开个茶会！"

#: lang/json/speech_from_json.py
msgid "You're the best!"
msgstr "你是最好的！"

#: lang/json/speech_from_json.py
msgid "You shouldn't have done that."
msgstr "你不应该那样做。"

#: lang/json/speech_from_json.py
msgid "Let's play… Russian roulette."
msgstr "让我们来玩……俄罗斯轮盘赌。"

#: lang/json/speech_from_json.py
msgid "I hate you."
msgstr "我恨你。"

#: lang/json/speech_from_json.py
msgid "Go kill yourself!"
msgstr "自生自灭吧！"

#: lang/json/speech_from_json.py
msgid "Big Brother is watching you…"
msgstr "老大哥正在看着你……"

#: lang/json/speech_from_json.py
msgid "Die for me!"
msgstr "给我死吧！"

#: lang/json/speech_from_json.py
msgid "Why won't you die?"
msgstr "你为什么不去死？"

#: lang/json/speech_from_json.py
msgid "Blood…  Delicious."
msgstr "鲜血……真美味。"

#: lang/json/speech_from_json.py
msgid "See you… IN HELL!"
msgstr "地狱……里见！"

#: lang/json/speech_from_json.py
msgid "AAAIEEEEEEE!"
msgstr "啊啊啊诶诶诶诶！"

#: lang/json/speech_from_json.py
msgid "FUCK YOU!"
msgstr "操你妈！"

#: lang/json/speech_from_json.py
msgid "What did you do with my Mommy?"
msgstr "你把我妈咪怎么了？"

#: lang/json/speech_from_json.py
msgid "Stay with me… forever!"
msgstr "永远……与我在一起吧！"

#: lang/json/speech_from_json.py
msgid "Hey kids.  Want some candy?"
msgstr "嗨，小屁孩，这里有糖，想要不？"

#: lang/json/speech_from_json.py
msgid "Down here, they ALL float!"
msgstr "在这儿，它们都 漂 着！"

#: lang/json/speech_from_json.py
msgid "Do you really need that much honey?"
msgstr "你真的需要那么多蜂蜜？"

#: lang/json/speech_from_json.py
msgid "My previous owner squealed like a pig when I gutted her!"
msgstr "在我取出上一个主人的内脏的时候，她像猪一样尖叫！"

#: lang/json/speech_from_json.py
msgid "BARK!"
msgstr "犬吠！"

#: lang/json/speech_from_json.py
msgid "YAP!"
msgstr "狂吠！"

#: lang/json/speech_from_json.py
msgid "WOOF!"
msgstr "低吠！"

#: lang/json/speech_from_json.py
msgid "heavy breathing"
msgstr "沉重的呼吸声"

#: lang/json/speech_from_json.py
msgid "labored breathing"
msgstr "吃力的呼吸声"

#: lang/json/speech_from_json.py
msgid "a whimper"
msgstr "呜咽声"

#: lang/json/speech_from_json.py
msgid "a rasping growl"
msgstr "刺耳的咆哮声"

#: lang/json/speech_from_json.py
msgid "\"I have no mouth and yet I scream!\""
msgstr "\"我没有嘴但我必须尖叫！\""

#: lang/json/speech_from_json.py
msgid "\"¿Por qué?\""
msgstr "\"¿Por qué?（西班牙语：为什么？）\""

#: lang/json/speech_from_json.py
msgid "\"Come closer little one.\""
msgstr "\"靠近点小家伙。\""

#: lang/json/speech_from_json.py
msgid "\"The better to eat you!  I don't actually think I eat anymore.\""
msgstr "\"是为了一口把你吃掉呀！可是我想我没法吃东西了。\""

#: lang/json/speech_from_json.py
msgid "\"Cyrus said if I was patient, he could get me a new body.\""
msgstr "\"居鲁士说如果我足够耐心（是病人的话），他能帮我找来一副新躯体。\""

#: lang/json/speech_from_json.py
msgid "\"Quem é Você?\""
msgstr "\"Quem é Você?（葡萄牙语：你是谁？）\""

#: lang/json/speech_from_json.py
msgid "\"Eu vou te matar!\""
msgstr "\"Eu vou te matar!（葡萄牙语：我他妈的要杀了你！）\""

#: lang/json/speech_from_json.py
msgid "\"I can't keep myself from killing you, please run!\""
msgstr "\"我控制不住自己要杀你，请快逃！\""

#: lang/json/speech_from_json.py
msgid "\"bzzzzzz.\""
msgstr "\"滋滋滋。\""

#: lang/json/speech_from_json.py
msgid "\"west, west, west, west, west\""
msgstr "往西，往西，往西，往西，往西"

#: lang/json/speech_from_json.py
msgid "\"east, east, east, east, east\""
msgstr "往东，往东，往东，往东，往东"

#: lang/json/speech_from_json.py
msgid "\"south, south, south, south, south\""
msgstr "往南，往南，往南，往南，往南"

#: lang/json/speech_from_json.py
msgid "\"north, north, north, north, north\""
msgstr "往北，往北，往北，往北，往北"

#: lang/json/speech_from_json.py
msgid "\"Where am I?  Where am I?  Where am I?\""
msgstr "\"我在哪？我在哪？我在哪？\""

#: lang/json/speech_from_json.py
msgid "\"It's very cold, It's very cold, It's very cold\""
msgstr "\"很冷，很冷，很冷\""

#: lang/json/speech_from_json.py
msgid "\"dark, dark, where is everything\""
msgstr "\"很黑，很黑，东西都在哪里\""

#: lang/json/speech_from_json.py
msgid "When the testing is over, you will be missed."
msgstr "当测试结束时，你将会被错过。"

#: lang/json/speech_from_json.py
msgid ""
"Unbelievable.  You, [subject name here], must be the pride of [subject "
"hometown here]!"
msgstr "不可思议呀！[subject name here]，[subject hometown here]必将以您为傲！"

#: lang/json/speech_from_json.py
msgid ""
"That thing is probably some sort of raw sewage container.  Go ahead and rub "
"your face all over it."
msgstr "这可能是某种未经处理的污水容器。快去好好洗把脸吧。"

#: lang/json/speech_from_json.py
msgid ""
"For your own safety and the safety of others, please refrain from touching "
"[bzzzzzt]"
msgstr "为了您和他人的安全，请不要触碰 [滋滋滋——]"

#: lang/json/speech_from_json.py
msgid ""
"No one will blame you for giving up.  In fact, quitting at this point is a "
"perfectly reasonable response."
msgstr "你即便放弃也没人会因此责备你的，事实上，离职恰好是一个非常合理的反应。"

#: lang/json/speech_from_json.py
msgid ""
"Fantastic!  You remained resolute and resourceful in an atmosphere of "
"extreme pessimism."
msgstr "太棒了！在如此悲哀的气氛中，你仍然有着果敢与机智。"

#: lang/json/speech_from_json.py
msgid "Hello again.  To reiterate our previous warning: [garbled]"
msgstr "再次向您致敬。并重申我们之前的警告：[garbled]"

#: lang/json/speech_from_json.py
msgid "Weeeeeeeeeeeeeeeeeeeeee[bzzt]"
msgstr "噫噫噫噫噫噫噫噫噫——[bzzt]"

#: lang/json/speech_from_json.py
msgid "If you become light headed from thirst, feel free to pass out."
msgstr "如果你渴昏了头，随时可以放弃。"

#: lang/json/speech_from_json.py
msgid ""
"No further compliance information is required or will be provided, and you "
"are an excellent test subject!"
msgstr "不需要，也不会提供近一步符合讯息，你是个极好的测试对象！"

#: lang/json/speech_from_json.py
msgid "Thank you for helping us help you help us all."
msgstr "感谢您对我们的协助……助人即助己。"

#: lang/json/speech_from_json.py
msgid ""
"Cake and grief counseling will be available at the conclusion of the test."
msgstr "测试结束后将提供蛋糕与心理创伤辅导。"

#: lang/json/speech_from_json.py
msgid "The experiment is nearing its conclusion."
msgstr "这个实验已经进行到最后关头，快要的出结论了。"

#: lang/json/speech_from_json.py
msgid ""
"The Enrichment Center is required to remind you that you will be baked "
"[garbled] cake."
msgstr "富集中心需要提醒您，您即将被做成烤[乱码]蛋糕"

#: lang/json/speech_from_json.py
msgid "We are very, very happy for your success."
msgstr "对你的成功，我们感到非常，非常高兴。"

#: lang/json/speech_from_json.py
msgid "We are throwing a party in honor of your tremendous success."
msgstr "我们要举行一个派对，来纪念你伟大的胜利。"

#: lang/json/speech_from_json.py
msgid "A party associate will arrive shortly to collect you for your party."
msgstr "党的成员将尽快抵达，为党征召你。"

#: lang/json/speech_from_json.py
msgid "I know you're there.  I can feel you here."
msgstr "我知道你在那。我能感觉的到。"

#: lang/json/speech_from_json.py
msgid "You're not going the right way."
msgstr "你走错方向了。"

#: lang/json/speech_from_json.py
msgid "You shouldn't be here.  This isn't safe for you."
msgstr "你不该待在这儿，这对你很不安全。"

#: lang/json/speech_from_json.py
msgid ""
"Maybe you think you're helping yourself.  But you're not.  This isn't "
"helping anyone."
msgstr "也许你认为这样有利于己，然并卵。这对任何人都无助益。"

#: lang/json/speech_from_json.py
msgid "It's not too late to turn back."
msgstr "现在回头还来得及。"

#: lang/json/speech_from_json.py
msgid "Someone is going to get badly hurt."
msgstr "有人正受到严重伤害。"

#: lang/json/speech_from_json.py
msgid ""
"Uh oh.  Somebody cut the cake.  I told them to wait for you, but they did it"
" anyway."
msgstr "啊哦。有人分了杯羹，我让他们等等你，但是他们还是那样做了。"

#: lang/json/speech_from_json.py
msgid "This is your fault.  It didn't have to be like this."
msgstr "这全都是你的错，这本不该如此的。"

#: lang/json/speech_from_json.py
msgid "You're not a good person.  You know that, right?"
msgstr "你也不是个好家伙，你知道的吧，嗯哼？"

#: lang/json/speech_from_json.py
msgid "Good people don't end up here."
msgstr "好人不会在这里消亡的。"

#: lang/json/speech_from_json.py
msgid "You should have turned left before."
msgstr "你应该先左转。"

#: lang/json/speech_from_json.py
msgid ""
"Despite your violent behavior, the only thing you've managed to break so far"
" is my heart."
msgstr "那怕你竭尽暴虐，能伤害的也只有我的心罢了。"

#: lang/json/speech_from_json.py
msgid "What was that?  Did you say something?"
msgstr "那是什么？你刚刚说话了吗？"

#: lang/json/speech_from_json.py
msgid ""
"I'd just like to point out that you were given every opportunity to succeed."
msgstr "我只想指出，所有通向成功的机会已经给你了。"

#: lang/json/speech_from_json.py
msgid "What's your point, anyway?  Survival?"
msgstr "你有任何方面的建议吗？生存？"

#: lang/json/speech_from_json.py
msgid ""
"You've been wrong about every single thing you've ever done, including this "
"thing."
msgstr "你所做的每一件事都是错误的，包括这件事。"

#: lang/json/speech_from_json.py
msgid ""
"I have an infinite capacity for knowledge, and even I'm not sure what's "
"going on outside."
msgstr "我拥有无限的知识，而哪怕是我也不确定外面发生了什么。"

#: lang/json/speech_from_json.py
msgid ""
"Stop squirming and die like an adult or I'm going to delete your backup."
msgstr "停止小动作，像个成熟的人一样赴死。否则我删除你的备份。"

#: lang/json/speech_from_json.py
msgid "Good job on that, by the way.  SARCASM SPHERE SELF-TEST COMPLETE."
msgstr "顺带一提，干得好。讽 刺 自 检 完 成。"

#: lang/json/speech_from_json.py
msgid ""
"I don't want to tell you your business, but if it were me, I'd leave that "
"thing alone."
msgstr "你的行当我不想插嘴，但要我的话，就会把那事儿留给自己。"

#: lang/json/speech_from_json.py
msgid ""
"Let's be honest: Neither one of us knows what that thing does.  Just put it "
"in the corner, and I'll deal with it later."
msgstr "坦白说，我们谁都不知道那件事是怎么做的。把它放一边吧，我以后会处理的。"

#: lang/json/speech_from_json.py
msgid ""
"I know you don't believe this, but everything that has happened so far was "
"for your benefit."
msgstr "我知道你不会相信的，但目前为止发生的一切事情都是为了你好。"

#: lang/json/speech_from_json.py
msgid ""
"I'm checking some blueprints, and I think…  Yes, right here.  You're "
"definitely going the wrong way."
msgstr "我在检视一些蓝图，我想……嗯，是的，在这，你肯定走错路了。"

#: lang/json/speech_from_json.py
msgid "Are you even listening to me?"
msgstr "你有没有在听我讲话？"

#: lang/json/speech_from_json.py
msgid "\"I've got a feeling we're not in Kansas anymore.\""
msgstr "\"我感觉我们已经不在堪萨斯州了。\"（注：《绿野仙踪（1939）》）"

#: lang/json/speech_from_json.py
msgid "\"Go ahead, make my day.\""
msgstr "\"来吧，让我开开眼界。\"（注：《拨云见日（1983）》）"

#: lang/json/speech_from_json.py
msgid "\"You talkin' to me?\""
msgstr "\"你在和我说话？\"（注：《出租车司机（1976）》）"

#: lang/json/speech_from_json.py
msgid "\"Then who the hell else are you talkin' to?\""
msgstr "\"那你他妈的在和谁说话？\"（注：《出租车司机（1976）》）"

#: lang/json/speech_from_json.py
msgid "\"Well I'm the only one here.\""
msgstr "\"嗨，这里只有我一个人。\"（注：《出租车司机（1976）》）"

#: lang/json/speech_from_json.py
msgid "\"Who the fuck do you think you're talking to?\""
msgstr "\"你他妈觉得自己在和谁说话？\"（注：《出租车司机（1976）》）"

#: lang/json/speech_from_json.py
msgid "\"What we've got here is failure to communicate.\""
msgstr "\"我们这儿看到的就是沟通失败的结果。\"（注：《铁窗喋血（1967）》）"

#: lang/json/speech_from_json.py
msgid "\"E.T.  phone home.\""
msgstr "\"E.T.打电话回家。\"（注：《E.T. 外星人（1982）》）"

#: lang/json/speech_from_json.py
msgid "\"I'm as mad as hell, and I'm not going to take this anymore!\""
msgstr "\"我就快要被逼疯了，而且我也不愿意再忍受了！\"（注：《电视台风云（1976）》）"

#: lang/json/speech_from_json.py
msgid "\"There's no place like home.\""
msgstr "\"没有比家更好的地方。\"（注：《绿野仙踪（1939）》）"

#: lang/json/speech_from_json.py
msgid "\"Badges?  We ain't got no badges!\""
msgstr "\"警徽吗？我们没那玩意！\"（注：《碧血金沙（1948）》）"

#: lang/json/speech_from_json.py
msgid ""
"\"We don't need no badges!  I don't have to show you any stinking badges!\""
msgstr "\"我们用不着警徽！我才不用出示那恶心的警徽！\"（注：《碧血金沙（1948）》）"

#: lang/json/speech_from_json.py
msgid "\"I'll be back.\""
msgstr "\"我会回来的。\"（注：《终结者（1984）》）"

#: lang/json/speech_from_json.py
msgid "\"I see dead people.\""
msgstr "\"我看到死人。\"（注：《第六感（1999）》）"

#: lang/json/speech_from_json.py
msgid "\"It's alive!  It's alive!\""
msgstr "\"它活过来了！它活过来了！\"（注：《弗兰肯斯坦（1931）》）"

#: lang/json/speech_from_json.py
msgid "\"Say hello to my little friend!\""
msgstr "\"跟我的小伙伴打个招呼吧！\"（注：《疤面煞星（1983）》）"

#: lang/json/speech_from_json.py
msgid "\"Here's Johnny!\""
msgstr "\"强尼在这！\"（注：《闪灵（1980）》）"

#: lang/json/speech_from_json.py
msgid "\"Open the pod bay doors, HAL.\""
msgstr "\"把舱门打开，哈尔。\"（注：《2001太空漫游（1968）》）"

#: lang/json/speech_from_json.py
msgid "\"They may take our lives, but they'll never take our freedom!\""
msgstr "\"他们也许能夺走我们的生命，但是，他们永远夺不走我们的自由！\"（注：《勇敢的心（1995）》）"

#: lang/json/speech_from_json.py
msgid ""
"\"If you let my daughter go now, that'll be the end of it.  I will not look "
"for you, I will not pursue you.\""
msgstr "\"如果你现在放我的女儿走，那么这件事就此结束，我不会去找你，我也不会来追杀你。\"（注：《飓风营救（2008）》）"

#: lang/json/speech_from_json.py
msgid ""
"\"If you don't, I will look for you, I will find you, and I will kill you.\""
msgstr "\"如果你不干，那么我会去找你，我会找到你，然后杀了你。\"（注：《飓风营救（2008）》）"

#: lang/json/speech_from_json.py
msgid "\"Roads?  Where we're going, we don't need roads.\""
msgstr "\"路？我们要去的地方，不需要路。\"（注：《回到未来（1985）》）"

#: lang/json/speech_from_json.py
msgid "\"Fasten your seatbelts.  It's going to be a bumpy night.\""
msgstr "\"系好你的安全带。这将是一个颠簸的夜晚。\"（注：《彗星美人（1950）》）"

#: lang/json/speech_from_json.py
msgid ""
"\"You've got to ask yourself one question:  'Do I feel lucky?'  Well, do ya "
"punk?\""
msgstr "\"你应该问自己一个问题：'我感到幸运吗？'你觉得呢，痞子？\"（注：《肮脏的哈里（1971）》）"

#: lang/json/speech_from_json.py
msgid "\"You had me at hello.\""
msgstr "\"你一句你好就已经征服我了。\"（注：《甜心先生（1996）》）"

#: lang/json/speech_from_json.py
msgid "\"Houston, we have a problem.\""
msgstr "\"休斯敦，我们有麻烦了。\"（注：《阿波罗13号（1995）》）"

#: lang/json/speech_from_json.py
msgid "\"Yippie-ki-yay, motherfucker!\""
msgstr "\"走你，王八蛋！\"（注：《虎胆龙威（1988）》）"

#: lang/json/speech_from_json.py
msgid "\"The first rule of The Lab is:  You do not talk about The Lab.\""
msgstr "\"实验室的第一条守则是：别提实验室。\"（注：《搏击俱乐部（1999）》）"

#: lang/json/speech_from_json.py
msgid "\"Don't be afraid.  It's just a big, big lap dog.\""
msgstr "\"别害怕，它不过就是只个大、大点的哈巴狗。\""

#: lang/json/speech_from_json.py
msgid "\"Bring me everyone.\""
msgstr "\"把所有人都叫来。\"（注：《这个杀手不太冷（1994）》）"

#: lang/json/speech_from_json.py
msgid "\"What do you mean everyone?\""
msgstr "\"啥叫所有人？\"（注：《这个杀手不太冷（1994）》）"

#: lang/json/speech_from_json.py
msgid "\"EVERYONE!\""
msgstr "\"所有人！\"（注：《这个杀手不太冷（1994）》）"

#: lang/json/speech_from_json.py
msgid "\"I'm going to make him an offer he can't refuse.\""
msgstr "\"我会开出他无法拒绝的条件。\"（注：《教父（1972）》）"

#: lang/json/speech_from_json.py
msgid "\"This is the beginning of a beautiful friendship.\""
msgstr "\"这是一段美好友谊的开始。\"（注：《卡萨布兰卡（1942）》）"

#: lang/json/speech_from_json.py
msgid "\"You can’t handle the truth!\""
msgstr "\"你会接受不了真相的！\"（注：《好人寥寥（1992）》）"

#: lang/json/speech_from_json.py
msgid "\"If you built it, he will come.\""
msgstr "\"你盖好了，他就会来。\"（注：《梦幻之地（1989）》）"

#: lang/json/speech_from_json.py
msgid "\"Hasta la vista, baby.\""
msgstr "\"再见，宝贝。\"（注：《终结者2（1991）》）"

#: lang/json/speech_from_json.py
msgid "\"They’re here!\""
msgstr "\"它们在这！\"（注：《吵闹鬼（1982）》）"

#: lang/json/speech_from_json.py
msgid "\"Tis but a scratch!\""
msgstr "\"这不过是点小划伤而已！\"（注：《巨蟒与圣杯（1975）》）"

#: lang/json/speech_from_json.py
msgid "\"Frankly, my dear, I don't give a damn.\""
msgstr "\"老实说，亲爱的，我一点也不在乎。\"（注：《乱世佳人（1939）》）"

#: lang/json/speech_from_json.py
msgid "\"All work and no play makes Jack a dull boy.\""
msgstr "\"只工作不玩耍，聪明孩子也变傻。\"（注：《闪灵（1980）》）"

#: lang/json/speech_from_json.py
msgid "\"Remember: all I'm offering is the truth.  Nothing more.\""
msgstr "\"记住，我要告诉你的只有一样东西，真相。\"（注：《黑客帝国（1999）》）"

#: lang/json/speech_from_json.py
msgid "\"Don't call me Shirley.\""
msgstr "\"不要叫我雪莉。\"（注：《空前绝后满天飞（1980）》）"

#: lang/json/speech_from_json.py
msgid "\"I have had it with these motherfucking snakes!\""
msgstr "\"我受够了这些该死的蛇！\"（注：《航班蛇患（2006）》）"

#: lang/json/speech_from_json.py
msgid ""
"\"Back up, put down the gun, and gimme some tropical flavored bubblicious.\""
msgstr "\"后退，放下枪，再给我点热带水果口味的波波丝口香糖。\"（注：《绝地战警（1995）》）"

#: lang/json/speech_from_json.py
msgid "\"And some skittles.\""
msgstr "\"还有一些彩虹糖。\"（注：《绝地战警（1995）》）"

#: lang/json/speech_from_json.py
msgid "\"You'll shoot your eye out, kid.\""
msgstr "\"你会把自己的眼珠射出来的，孩子。\"（注：《圣诞故事（1983）》）"

#: lang/json/speech_from_json.py
msgid "\"Cocainum!\""
msgstr "\"可卡因！\"（注：《红色警探（1988）》）"

#: lang/json/speech_from_json.py
msgid "\"I am your father.\""
msgstr "\"我是你爸爸。\"（注：《星球大战2：帝国反击战（1980）》）"

#: lang/json/speech_from_json.py
msgid "\"Who said that?\""
msgstr "\"谁说的？\"（注：《全金属外壳（1987）》）"

#: lang/json/speech_from_json.py
msgid "\"WHO THE FUCK SAID THAT?!\""
msgstr "\"谁他妈说的？\"（注：《全金属外壳（1987）》）"

#: lang/json/speech_from_json.py
msgid "\"Bullshit!  You didn't convince me!  Show me your real war face!\""
msgstr "\"狗屎！你一点都没能说服我！现在给我看看你真正的战争脸！\"（注：《全金属外壳（1987）》）"

#: lang/json/speech_from_json.py
msgid "\"What is your major malfunction, numbnut?\""
msgstr "\"那你又有什么问题？笨蛋！\"（注：《全金属外壳（1987）》）"

#: lang/json/speech_from_json.py
msgid "\"Leeeeeeeeeeeeeroy!  Jenkins rebuild!\""
msgstr "\"Leeeeeeeeeeeeeroy!  Jenkins rebuild!\"（注：Jenkins是CDDA所使用的持续集成平台工具）"

#: lang/json/speech_from_json.py
msgid "\"Activated!\""
msgstr "\"已激活！\""

#: lang/json/speech_from_json.py
msgid "\"Search mode activated!\""
msgstr "\"搜索模式已激活！\""

#: lang/json/speech_from_json.py
msgid "\"Coming through!\""
msgstr "\"借过！\""

#: lang/json/speech_from_json.py
msgid "\"Deploying!\""
msgstr "\"正在部署！\""

#: lang/json/speech_from_json.py
msgid "\"Critical Error!\""
msgstr "\"严重错误！\""

#: lang/json/speech_from_json.py
msgid "\"Ow ow ow!\""
msgstr "\"嗷——嗷——嗷！\""

#: lang/json/speech_from_json.py
msgid "\"Put me down!\""
msgstr "\"放我下来！\""

#: lang/json/speech_from_json.py
msgid "\"Target lost!\""
msgstr "\"目标丢失！\""

#: lang/json/speech_from_json.py
msgid "\"Searching!\""
msgstr "\"正在搜索！\""

#: lang/json/speech_from_json.py
msgid "\"Hey!  It's me!\""
msgstr "\"嘿！是我！\""

#: lang/json/speech_from_json.py
msgid "\"Ouch!\""
msgstr "\"哎哟！\""

#: lang/json/speech_from_json.py
msgid "\"Sentry mode activated.\""
msgstr "\"岗哨模式已激活。\""

#: lang/json/speech_from_json.py
msgid "\"Hi.\""
msgstr "\"你好。\""

#: lang/json/speech_from_json.py
msgid "\"Target acquired.\""
msgstr "\"目标已获取。\""

#: lang/json/speech_from_json.py
msgid "\"Dispensing product.\""
msgstr "\"正在释放产物。\""

#: lang/json/speech_from_json.py
msgid "\"Firing.\""
msgstr "\"正在射击。\""

#: lang/json/speech_from_json.py
msgid "\"Hello friend.\""
msgstr "\"你好，朋友。\""

#: lang/json/speech_from_json.py
msgid "\"Gotcha.\""
msgstr "\"抓到你了。\""

#: lang/json/speech_from_json.py
msgid "\"Is anyone there?\""
msgstr "\"有人在吗？\""

#: lang/json/speech_from_json.py
msgid "\"I see you.\""
msgstr "\"我看见你了。\""

#: lang/json/speech_from_json.py
msgid "\"Could you come over here?\""
msgstr "\"你能过来下吗？\""

#: lang/json/speech_from_json.py
msgid "\"Hellooo.\""
msgstr "\"你好——\""

#: lang/json/speech_from_json.py
msgid "\"My fault.\""
msgstr "\"我的错。\""

#: lang/json/speech_from_json.py
msgid "\"Ohh.\""
msgstr "\"噢。\""

#: lang/json/speech_from_json.py
msgid "\"Critical error.\""
msgstr "\"严重错误。\""

#: lang/json/speech_from_json.py
msgid "\"Shutting down.\""
msgstr "\"正在关机中。\""

#: lang/json/speech_from_json.py
msgid "\"I don't blame you.\""
msgstr "\"我不怪你。\""

#: lang/json/speech_from_json.py
msgid "\"I don't hate you.\""
msgstr "\"我不恨你。\""

#: lang/json/speech_from_json.py
msgid "\"Whyyyy.\""
msgstr "\"为～什～么？\""

#: lang/json/speech_from_json.py
msgid "\"No hard feelings.\""
msgstr "\"别难过。\""

#: lang/json/speech_from_json.py
msgid "\"Aiaiaiaiaiai.\""
msgstr "\"唉唉唉唉唉\""

#: lang/json/speech_from_json.py
msgid "\"Who are you?\""
msgstr "\"你是谁？\""

#: lang/json/speech_from_json.py
msgid "\"Help.\""
msgstr "\"救命。\""

#: lang/json/speech_from_json.py
msgid "\"Uh oh.\""
msgstr "\"啊噢。\""

#: lang/json/speech_from_json.py
msgid "\"Illegal operation.\""
msgstr "\"非法操作。\""

#: lang/json/speech_from_json.py
msgid "\"Goodbye.\""
msgstr "\"再见。\""

#: lang/json/speech_from_json.py
msgid "\"Sleep mode activated.\""
msgstr "\"睡眠模式已激活。\""

#: lang/json/speech_from_json.py
msgid "\"Your business is appreciated.\""
msgstr "\"感谢你的合作。\""

#: lang/json/speech_from_json.py
msgid "\"Hibernating.\""
msgstr "\"正在休眠中。\""

#: lang/json/speech_from_json.py
msgid "\"Goodnight.\""
msgstr "\"晚安。\""

#: lang/json/speech_from_json.py
msgid "\"Resting.\""
msgstr "\"正在休息中。\""

#: lang/json/speech_from_json.py
msgid "\"Nap time.\""
msgstr "\"小睡时间。\""

#: lang/json/speech_from_json.py
msgid "\"Are you still there?\""
msgstr "\"你还在那里吗？\""

#: lang/json/speech_from_json.py
msgid "\"Hey, it's me!\""
msgstr "\"嘿，是我！\""

#: lang/json/speech_from_json.py
msgid "\"Don't shoot!\""
msgstr "\"不要射击！\""

#: lang/json/speech_from_json.py
msgid "\"\""
msgstr "\"\""

#: lang/json/speech_from_json.py
msgid "\"Stop shooting!\""
msgstr "\"停止射击！\""

#: lang/json/speech_from_json.py
msgid "\"Self test error.\""
msgstr "\"自检错误。\""

#: lang/json/speech_from_json.py
msgid "\"Aah.\""
msgstr "\"啊。\""

#: lang/json/speech_from_json.py
msgid "\"Unknown error.\""
msgstr "\"未知错误。\""

#: lang/json/speech_from_json.py
msgid "\"Malfunctioning.\""
msgstr "\"出故障了。\""

#: lang/json/speech_from_json.py
msgid "\"Aaaah.\""
msgstr "\"啊——\""

#: lang/json/speech_from_json.py
msgid "\"Ow ow ow ow owww.\""
msgstr "\"噢噢噢噢噢～\""

#: lang/json/speech_from_json.py
msgid "\"Why?\""
msgstr "\"为什么？\""

#: lang/json/speech_from_json.py
msgid "\"I did everything you asked!\""
msgstr "\"你要求我做的我都做了！\""

#: lang/json/speech_from_json.py
msgid "\"I don't understand!\""
msgstr "\"我不明白！\""

#: lang/json/speech_from_json.py
msgid "\"I'm fine!\""
msgstr "\"我很好！\""

#: lang/json/speech_from_json.py
msgid "\"Wheeeeee-OH NO!\""
msgstr "\"呜咿咿咿咿咿，噢不！\""

#: lang/json/speech_from_json.py
msgid "\"I'm scared!\""
msgstr "\"我好害怕！\""

#: lang/json/speech_from_json.py
msgid "\"Come closer.\""
msgstr "\"靠近点。\""

#: lang/json/speech_from_json.py
msgid "\"Something's wrong…\""
msgstr "\"有点不对劲……\""

#: lang/json/speech_from_json.py
msgid "\"What are you doing?\""
msgstr "\"你在做什么？\""

#: lang/json/speech_from_json.py
msgid "\"Please stop.\""
msgstr "\"请停下。\""

#: lang/json/speech_from_json.py
msgid "\"You've made your point.\""
msgstr "\"你的意思我已经清楚了。\""

#: lang/json/speech_from_json.py
msgid "\"Okay, you win.\""
msgstr "\"好吧，你赢了。\""

#: lang/json/speech_from_json.py
msgid "\"This is not good.\""
msgstr "\"这不好。\""

#: lang/json/speech_from_json.py
msgid "\"Excuse me?\""
msgstr "\"劳驾。\""

#: lang/json/speech_from_json.py
msgid "\"I'm different…\""
msgstr "\"我和它们不一样……\""

#: lang/json/speech_from_json.py
msgid "\"Thanks anyway…\""
msgstr "\"不管怎样，谢谢了……\""

#: lang/json/speech_from_json.py
msgid "\"Take me with you…\""
msgstr "\"带我走吧……\""

#: lang/json/speech_from_json.py
msgid "\"You have excellent aim!\""
msgstr "\"你瞄得真准！\""

#: lang/json/speech_from_json.py
msgid "\"I need backup!\""
msgstr "\"我需要增援！\""

#: lang/json/speech_from_json.py
msgid "\"I never liked her.\""
msgstr "\"我从没喜欢过她。\""

#: lang/json/speech_from_json.py
msgid "\"These things happen.\""
msgstr "\"这是常有的事。\""

#: lang/json/speech_from_json.py
msgid "\"That was nobody's fault.\""
msgstr "\"那不能怪谁。\""

#: lang/json/speech_from_json.py
msgid "\"She was provoking you.\""
msgstr "\"是她先惹你的。\""

#: lang/json/speech_from_json.py
msgid "\"Oh dear.\""
msgstr "\"噢，天哪。\""

#: lang/json/speech_from_json.py
msgid "\"Oh my!\""
msgstr "\"噢，我的天！\""

#: lang/json/speech_from_json.py
msgid "\"I blame myself.\""
msgstr "\"都怪我自己。\""

#: lang/json/speech_from_json.py
msgid "\"He probably deserved it.\""
msgstr "\"他罪有应得。\""

#: lang/json/speech_from_json.py
msgid "\"I saw it.  It was an accident.\""
msgstr "\"我看到了。一切都是意外。\""

#: lang/json/speech_from_json.py
msgid "\"She's probably okay.\""
msgstr "\"她大概还行。\""

#: lang/json/speech_from_json.py
msgid "\"Noted.\""
msgstr "\"知道了。\""

#: lang/json/speech_from_json.py
msgid "\"But I need to protect the humans!\""
msgstr "\"但我要守护人类！\""

#: lang/json/speech_from_json.py
msgid "\"We're back!\""
msgstr "\"我们回来了！\""

#: lang/json/speech_from_json.py
msgid "\"Hi there!\""
msgstr "\"你好！\""

#: lang/json/speech_from_json.py
msgid "\"Back again!\""
msgstr "\"又回来了！\""

#: lang/json/speech_from_json.py
msgid "\"Well, hello, stranger!\""
msgstr "\"你好，陌生人！\""

#: lang/json/speech_from_json.py
msgid "\"This time is OUR time.\""
msgstr "\"现在是我们的时代了。\""

#: lang/json/speech_from_json.py
msgid "\"Second time's a charm…\""
msgstr "\"第二回该走运了点了吧……\""

#: lang/json/speech_from_json.py
msgid "\"Howdy, stranger!\""
msgstr "\"陌生人，你好哇！\""

#: lang/json/speech_from_json.py
msgid "\"Thought you'd seen the last of us, didn't ya?\""
msgstr "\"你以为自己再也见不到我们了，是吗？\""

#: lang/json/speech_from_json.py
msgid "\"Dang!\""
msgstr "\"当！\""

#: lang/json/speech_from_json.py
msgid "\"I thought we fixed that.\""
msgstr "\"我还以为我们解决了那家伙。\""

#: lang/json/speech_from_json.py
msgid "\"What's a guy gotta got to do to get some bullets around here?\""
msgstr "\"到底要怎么样做才能在这附近找到点子弹呢？\""

#: lang/json/speech_from_json.py
msgid "\"Nope.  Still can't see.\""
msgstr "\"不，仍然看不见。\""

#: lang/json/speech_from_json.py
msgid "\"Yep.  Still blind.\""
msgstr "\"是的，仍然看不见。\""

#: lang/json/speech_from_json.py
msgid "\"Click click click!  Still defective!\""
msgstr "\"咔咔咔！还是坏的！\""

#: lang/json/speech_from_json.py
msgid "\"Yeah, that's right!  Still defective!\""
msgstr "\"是的，没错！还是坏的！\""

#: lang/json/speech_from_json.py
msgid "\"Yeah!  Still not working.\""
msgstr "\"好耶！还是坏的。\""

#: lang/json/speech_from_json.py
msgid "\"Yeah!  Non-lethal as ever.\""
msgstr "\"耶！还是打不死人。\""

#: lang/json/speech_from_json.py
msgid "\"Can't.  See.  A.  Thing.\""
msgstr "\"啥。都。看。不。见。\""

#: lang/json/speech_from_json.py
msgid "\"Absolutely no improvement.\""
msgstr "\"一点进步都没有。\""

#: lang/json/speech_from_json.py
msgid "\"Not getting better with age!\""
msgstr "\"随着岁数增加并没有好转！\""

#: lang/json/speech_from_json.py
msgid "\"This is just getting embarrassing.\""
msgstr "\"这只会让人尴尬。\""

#: lang/json/speech_from_json.py
msgid "\"Alright, you can go.\""
msgstr "\"好吧，你可以走了。\""

#: lang/json/speech_from_json.py
msgid "\"[sigh] Don't tell anyone about this.\""
msgstr "\"叹气，千万别告诉别人。\""

#: lang/json/speech_from_json.py
msgid "\"Well, I tried.  Best of luck!\""
msgstr "\"嗨，至少我试过。祝你好运！\""

#: lang/json/speech_from_json.py
msgid "\"Hey, safe travels, there.\""
msgstr "\"嘿，祝你一路平安。\""

#: lang/json/speech_from_json.py
msgid "\"Hey, thanks so much!\""
msgstr "\"嘿，太感谢了！\""

#: lang/json/speech_from_json.py
msgid "\"Don't be a stranger!\""
msgstr "\"别见外！\""

#: lang/json/speech_from_json.py
msgid "\"It's been a pleasure!\""
msgstr "\"很高兴遇见你！\""

#: lang/json/speech_from_json.py
msgid "\"That was fun, wasn't it?\""
msgstr "\"那很有趣，不是吗？\""

#: lang/json/speech_from_json.py
msgid ""
"\"I can't see a thing.  What just happened?  Better open fire!  [click click"
" click click]  Dang!\""
msgstr "\"我啥都没看到。发生什么事了？最好快开火！咔咔咔咔当！\""

#: lang/json/speech_from_json.py
msgid "\"*clicking noises*\""
msgstr "\"*咔嗒声*\""

#: lang/json/speech_from_json.py
msgid "\"No, wait, wait!\""
msgstr "\"不，等下，等下！\""

#: lang/json/speech_from_json.py
msgid "\"Hey, hold on now WHOA WHOA WHOA!\""
msgstr "\"嘿，等一下下喔喔喔喔\""

#: lang/json/speech_from_json.py
msgid "\"Oh, this is ridiculous!\""
msgstr "\"噢，这太可笑了！\""

#: lang/json/speech_from_json.py
msgid "\"Give me another channnnce!\""
msgstr "\"再给我次机——会！\""

#: lang/json/speech_from_json.py
msgid "\"Hey!  Squeaky-voice!  Gimme some of your bullets!\""
msgstr "\"嘿！那个尖嗓门的家伙！给我点你的弹药！\""

#: lang/json/speech_from_json.py
msgid "\"Can I get some bullets here?  Anybody got bullets?\""
msgstr "\"能给我点子弹吗？谁有子弹？\""

#: lang/json/speech_from_json.py
msgid "\"Uhhh, no bullets.  Sorry.\""
msgstr "\"呃，没弹药了。抱歉。\""

#: lang/json/speech_from_json.py
msgid "\"Shootin' blanks every time, ALL the time.\""
msgstr "\"每次都打空，每一次。\""

#: lang/json/speech_from_json.py
msgid "\"Standing down.\""
msgstr "\"警报解除。\""

#: lang/json/speech_from_json.py
msgid "\"Watch and learn, everybody.  Watch and learn.\""
msgstr "\"诸君啊，好好看，好好学。\""

#: lang/json/speech_from_json.py
msgid "\"So what am I, uh, supposed to do here?\""
msgstr "\"那我，呃，该做些什么呢？\""

#: lang/json/speech_from_json.py
msgid "\"Identify yourself or I will shoot.\""
msgstr "\"表明身份，否则我要开枪了。\""

#: lang/json/speech_from_json.py
msgid "\"Pleased to meetcha.\""
msgstr "\"很高兴见到你。\""

#: lang/json/speech_from_json.py
msgid "\"I'm gonna make you proud!\""
msgstr "\"我会让你为我骄傲的！\""

#: lang/json/speech_from_json.py
msgid "booming footsteps."
msgstr "隆隆的脚步声。"

#: lang/json/speech_from_json.py
