msgid_plural "sheet metal"
msgstr[0] "薄钢板"

#. ~ Description for {'str_sp': 'sheet metal'}
#: lang/json/GENERIC_from_json.py
msgid "A thin sheet of metal."
msgstr "薄薄的一片金属板。"

#: lang/json/GENERIC_from_json.py
msgid "wired sheet metal"
