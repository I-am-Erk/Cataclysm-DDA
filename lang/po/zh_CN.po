msgstr "\"明天会下雨吗？\""

#: lang/json/speech_from_json.py
msgid "\"Okay.\""
msgstr "\"好的。\""

#: lang/json/speech_from_json.py
msgid "\"Good.\""
msgstr "\"好。\""

#: lang/json/speech_from_json.py
msgid "\"Great.\""
msgstr "\"好极了。\""

#: lang/json/speech_from_json.py
msgid "\"Fantastic.\""
msgstr "\"太棒了。\""

#: lang/json/speech_from_json.py
msgid "\"God damn it.\""
msgstr "\"见鬼。\""

#: lang/json/speech_from_json.py
msgid "\"God damn it!\""
msgstr "\"见鬼！\""

#: lang/json/speech_from_json.py
msgid "\"Damn it.\""
msgstr "\"妈的。\""

#: lang/json/speech_from_json.py
msgid "\"Damn it!\""
msgstr "\"妈的！\""

#: lang/json/speech_from_json.py
msgid "\"Fuck.\""
msgstr "\"操。\""

#: lang/json/speech_from_json.py
msgid "\"Shit.\""
msgstr "\"我去。\""

#: lang/json/speech_from_json.py
msgid "\"Fuck!\""
msgstr "\"干！\""

#: lang/json/speech_from_json.py
msgid "\"Shit!\""
msgstr "\"狗屎！\""

#: lang/json/speech_from_json.py
msgid "\"Fuckin' piece of garbage.\""
msgstr "\"该死的废物。\""

#: lang/json/speech_from_json.py
msgid "\"I need a new lab coat.\""
msgstr "\"我需要一件新实验服。\""

#: lang/json/speech_from_json.py
msgid "\"Excellent.\""
msgstr "\"好极了。\""

#: lang/json/speech_from_json.py
msgid "\"Excuse me.\""
msgstr "\"抱歉。\""

#: lang/json/speech_from_json.py
msgid "\"Good morning.\""
msgstr "\"早上好。\""

#: lang/json/speech_from_json.py
msgid "\"Good afternoon.\""
msgstr "\"下午好。\""

#: lang/json/speech_from_json.py
