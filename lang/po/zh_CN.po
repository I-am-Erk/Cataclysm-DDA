msgid_plural ".30-06 Springfield tracer, black powder"
msgstr[0] ".30-06 春田曳光弹（黑火药）"

#: lang/json/AMMO_from_json.py
msgid ".30-06 Springfield M2 AP, black powder"
msgid_plural ".30-06 Springfield M2 AP, black powder"
msgstr[0] ".30-06 M2 穿甲弹（黑火药）"

#: lang/json/AMMO_from_json.py
