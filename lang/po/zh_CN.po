msgstr "*将100%能量留给防御型或实用型生化插件。"

#: lang/json/talk_topic_from_json.py
#, no-python-format
msgid "*will reserve 75% of CBM power for defense or utility CBMs."
msgstr "*将75%能量留给防御型或实用型生化插件。"

#: lang/json/talk_topic_from_json.py
#, no-python-format
