msgid "\"Are you hungry?\""
msgstr "\"你饿吗？\""

#: lang/json/speech_from_json.py
msgid "\"I'm hungry.\""
msgstr "\"我饿了。\""

#: lang/json/speech_from_json.py
msgid "\"Go ahead.\""
msgstr "\"继续。\""

#: lang/json/speech_from_json.py
