msgstr "一颗光滑圆润的蛋白石。"

#: lang/json/GENERIC_from_json.py
msgid "tourmaline"
msgid_plural "tourmalines"
msgstr[0] "电气石"

#. ~ Description for tourmaline
#: lang/json/GENERIC_from_json.py
