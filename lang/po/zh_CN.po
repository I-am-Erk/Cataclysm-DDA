"Add a note to the map.  For a custom GLYPH or COLOR follow the examples "
"below.  Default GLYPH and COLOR looks like this: <color_yellow>N</color>"
msgstr "在地图上添加注释。对于自定义字形或颜色，请遵循以下示例。默认的字形和颜色如下所示：<color_yellow>N</color>"

#: src/overmap_ui.cpp
msgid "Color codes: "
msgstr "颜色代码："

#: src/overmap_ui.cpp
msgid "Type GLYPH<color_yellow>:</color>TEXT to set a custom glyph."
msgstr "输入\"符号<color_yellow>:</color>文本\"可自定义符号。"

#: src/overmap_ui.cpp
msgid "Type COLOR<color_yellow>;</color>TEXT to set a custom color."
msgstr "输入\"颜色<color_yellow>;</color>文本\"可自定义颜色。"

#: src/overmap_ui.cpp
