msgstr[0] "接线薄钢板"

#. ~ Description for {'str_sp': 'wired sheet metal'}
#: lang/json/GENERIC_from_json.py
msgid "Sheet metal that has had housing for lights wired into it."
msgstr "内置遮光罩和线路的薄钢板。"

#: lang/json/GENERIC_from_json.py
msgid "wooden armor kit"
msgid_plural "wooden armor kits"
msgstr[0] "木制装甲板套件"

#. ~ Description for wooden armor kit
#: lang/json/GENERIC_from_json.py
msgid "A bundle of planks prepared to be used as vehicle armor."
msgstr "一块由木板拼装成的木制装甲板。"

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
