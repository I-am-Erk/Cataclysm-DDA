#: lang/json/vehicle_part_from_json.py
msgid "mounted M2010 ESR"
msgstr "车载 M2010 增强型狙击步枪"

#: lang/json/vehicle_part_from_json.py
msgid "mounted .50 caliber"
msgstr "车载 .50 口径步枪"

#: lang/json/vehicle_part_from_json.py
msgid "mounted M320"
msgstr "车载 M320 榴弹发射器"

#: lang/json/vehicle_part_from_json.py
msgid "mounted M79"
msgstr "车载 M79 机枪"

#: lang/json/vehicle_part_from_json.py
