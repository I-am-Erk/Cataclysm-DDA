msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "bronze medal"
msgid_plural "bronze medals"
msgstr[0] ""

#. ~ Description for bronze medal
#: lang/json/ARMOR_from_json.py
msgid ""
