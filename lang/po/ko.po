#: lang/json/COMESTIBLE_from_json.py
msgid "potato chips"
msgid_plural "potato chips"
msgstr[0] "감자칩"

#. ~ Description for {'str_sp': 'potato chips'}
#: lang/json/COMESTIBLE_from_json.py
msgid "Some plain, salted potato chips."
msgstr "짭잘한 감자칩."

