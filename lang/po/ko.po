#. ~ Use action activation_message for aspirin.
#: lang/json/COMESTIBLE_from_json.py
msgid "You take some aspirin."
msgstr "아스피린을 복용했다."

#. ~ Description for aspirin
#: lang/json/COMESTIBLE_from_json.py
