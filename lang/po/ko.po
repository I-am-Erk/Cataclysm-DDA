"A balanced cable used for sending audio signal.  The connectors have three "
"prongs."
msgstr ""

#: lang/json/GENERIC_from_json.py
msgid "speaker cable"
msgid_plural "speaker cables"
msgstr[0] ""

#. ~ Description for speaker cable
#: lang/json/GENERIC_from_json.py
