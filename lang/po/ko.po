msgstr ""

#: lang/json/GENERIC_from_json.py
msgid "sieve"
msgid_plural "sieves"
msgstr[0] ""

#. ~ Description for sieve
#: lang/json/GENERIC_from_json.py
msgid ""
"This is no mere strainer for noodles; it's a sieve used to separate "
"particles of certain sizes.  You could use this to do a really good job "
